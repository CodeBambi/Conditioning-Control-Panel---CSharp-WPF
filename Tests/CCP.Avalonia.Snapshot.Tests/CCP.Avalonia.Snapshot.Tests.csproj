<Project Sdk="Microsoft.NET.Sdk">
  <!-- Own testhost on purpose: Avalonia's headless platform is fixed by the first test in a process
       (PLAYBOOK P48), and CCP.Avalonia.Tests shards set it up with varying builders. Snapshots must
       always render through RenderProof.EnsureSetUp - the app's own builder with the bundled Inter
       font, Skia, real drawing - the same path as render-all and the reference-render CI. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
    <IsTestProject>true</IsTestProject>
    <AssemblyName>CCP.Avalonia.Snapshot.Tests</AssemblyName>
    <RootNamespace>CCP.Avalonia.Snapshot.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.10.0" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageReference Include="Avalonia.Headless" Version="12.1.2" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.2" />
    <!-- 32.0.1 is the newest Verify.XunitV3 built against xunit.v3 3.2.2 (33.x needs xunit.v3 4.x). -->
    <PackageReference Include="Verify.XunitV3" Version="32.0.1" />
    <PackageReference Include="Verify.Avalonia" Version="1.4.1" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\AvaloniaTestDispatcher.cs" Link="AvaloniaTestDispatcher.cs" />
    <ProjectReference Include="..\..\CCP.Avalonia\CCP.Avalonia.csproj" />
  </ItemGroup>
</Project>
