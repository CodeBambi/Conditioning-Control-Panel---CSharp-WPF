<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
    <AssemblyName>CCP.Avalonia.Tests</AssemblyName>
    <RootNamespace>CCP.Avalonia.Tests</RootNamespace>
  </PropertyGroup>

  <!-- The head's WinRT projection (Awareness lane): a plain Reference does not reach this host through the ProjectReference. -->
  <Import Project="..\..\WinRtProjection.props" />

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.10.0" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageReference Include="Avalonia.Headless" Version="12.1.2" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.2" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\AvaloniaTestDispatcher.cs" Link="AvaloniaTestDispatcher.cs" />
    <Compile Include="..\Shared\FakeContentServer.cs" Link="FakeContentServer.cs" />
    <ProjectReference Include="..\..\CCP.Avalonia\CCP.Avalonia.csproj" />
    <!-- 2 s 96x64 h264 clip (3 KB) so the bubble-count game test never depends on ffmpeg. -->
    <None Include="Assets\bubblecount-2s.mp4" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
