<Window x:Class="ConditioningControlPanel.WhatMovedCard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:ConditioningControlPanel.Helpers"
        xmlns:loc="clr-namespace:ConditioningControlPanel.Localization"
        Title="What moved"
        Width="520" SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI"
        PreviewKeyDown="Window_PreviewKeyDown">

    <!-- The one-time "What moved" card (nav rework, 2026-10-06). Non-modal on purpose: it reaches
         the screen through StartupPresenter.PresentOrInbox, never over a session, and it never
         blocks the page it points at. Launcher glass: the launcher's dark violet ground, a pink
         hairline, one row per move with a Show me button. -->

    <Border x:Name="CardRoot" CornerRadius="16" BorderThickness="1" Margin="18"
            BorderBrush="{DynamicResource PinkBrush}">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0.4,1">
                <GradientStop Color="#FF2C1450" Offset="0"/>
                <GradientStop Color="#FF1C1233" Offset="0.45"/>
                <GradientStop Color="#FF100A1E" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="4" Opacity="0.6"/>
        </Border.Effect>

        <StackPanel Margin="26,22,26,22">
            <Grid>
                <TextBlock Text="{loc:Str whatmoved_title}" FontSize="24" FontWeight="ExtraBold"
                           Foreground="{DynamicResource PinkBrush}"/>
                <Button x:Name="BtnX" Content="✕" Click="BtnClose_Click" HorizontalAlignment="Right"
                        VerticalAlignment="Top" Background="Transparent" Foreground="#99FFFFFF"
                        BorderThickness="0" FontSize="13" Cursor="Hand" Padding="4,0"/>
            </Grid>
            <TextBlock Text="{loc:Str whatmoved_intro}" Margin="0,6,0,16" FontSize="13"
                       Foreground="#CCFFFFFF" TextWrapping="Wrap"/>

            <ItemsControl x:Name="Rows">
                <!-- Each row reads as its sentence in the UIA tree, never as the record. -->
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="AutomationProperties.Name" Value="{Binding Text}"/>
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,8" Padding="12,9" CornerRadius="10"
                                Background="#1FFFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid Width="22" Height="22" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <Image Source="{Binding Glyph, Converter={StaticResource EmojiToImageSource}}"
                                           Stretch="Uniform"/>
                                    <TextBlock Text="{Binding Glyph}" FontSize="16" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="{Binding Glyph, Converter={StaticResource EmojiFallbackVisibility}}"/>
                                </Grid>
                                <TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="14" FontWeight="SemiBold"
                                           Foreground="White" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                <Button Grid.Column="2" Margin="12,0,0,0" Padding="12,5" FontSize="12"
                                        Click="ShowMe_Click" Tag="{Binding}" Cursor="Hand"
                                        AutomationProperties.Name="{Binding ShowMeName}"
                                        Style="{StaticResource PinkButton}"
                                        Content="{loc:Str whatmoved_show}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button x:Name="BtnDone" Content="{loc:Str whatmoved_close}" Click="BtnClose_Click"
                    Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right"
                    Padding="18,7" Margin="0,8,0,0"/>
        </StackPanel>
    </Border>
</Window>
