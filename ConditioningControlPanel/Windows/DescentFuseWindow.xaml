<Window x:Class="ConditioningControlPanel.DescentFuseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="The Descent"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="#FF0A0514"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">

    <!--
      THE FUSE AT ZERO (CONTRACT-FUSE-0816 §2.3/§2.4) - the crack, the bloom, and the Year One
      ignition. The show itself is drawn by DescentFuseStageVisual, added to StageHost from the
      code-behind; everything in this file is the room it is drawn in.

      Deliberately NOT AllowsTransparency, for the same reason DescentCeremonyWindow is not: a
      layered fullscreen window created while other layered surfaces are animating can wedge the
      shared WPF render thread. This window is opaque by design anyway - the whole point of the
      beat is that the room goes away.

      Backdrop is the ceremony's recipe verbatim (#241041 -> #1A1A2E -> #0A0514, then a vignette),
      so when the fuse hands off, the ceremony window that replaces it is already the same room.
      It starts dim and comes up with the bloom; see BackdropLayer in the code-behind.

      No offers. No prices. No tiers. CONTRACTS §0.6 - and this is the most-watched surface of
      the release, so it is the last place it could ever be negotiable.
    -->

    <Grid>
        <Border x:Name="BackdropLayer" Opacity="0.28">
            <Border.Background>
                <RadialGradientBrush GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.85" RadiusY="0.9">
                    <GradientStop Color="#FF241041" Offset="0"/>
                    <GradientStop Color="#FF1A1A2E" Offset="0.55"/>
                    <GradientStop Color="#FF0A0514" Offset="1"/>
                </RadialGradientBrush>
            </Border.Background>
        </Border>

        <!-- The drawn show. Populated in code so no xmlns import is needed for one element. -->
        <Grid x:Name="StageHost"/>

        <Border>
            <Border.Background>
                <RadialGradientBrush GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.75" RadiusY="0.75">
                    <GradientStop Color="#00000000" Offset="0.45"/>
                    <GradientStop Color="#99000000" Offset="1"/>
                </RadialGradientBrush>
            </Border.Background>
        </Border>

        <!--
          The show's only words. Two sentences exist for it (DescentFuseCopy.ShowAwaits and
          .IgnitionLine) and it is invisible unless one of them is due.
        -->
        <TextBlock x:Name="ShowLine"
                   Opacity="0"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Bottom"
                   Margin="40,0,40,120"
                   MaxWidth="900"
                   FontSize="26"
                   FontWeight="Light"
                   Foreground="#FFF2ECF7"
                   TextAlignment="Center"
                   TextWrapping="Wrap"/>
    </Grid>
</Window>
