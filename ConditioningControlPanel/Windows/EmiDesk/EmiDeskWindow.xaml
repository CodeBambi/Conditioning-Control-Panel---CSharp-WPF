<Window x:Class="ConditioningControlPanel.EmiDeskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:emi="clr-namespace:ConditioningControlPanel.Services.EmiDesk"
        Title="EMI"

        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowActivated="False"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="Manual"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Topmost="True"
        Focusable="False"
        Visibility="Hidden"
        Width="460" Height="458">

    <!--
        THE WIDGET SURFACE.

        The window is deliberately BIGGER than EMI: `OverlayPad` DIPs of fully transparent air on
        every side, so the summon smoke, the sparkle scatter and (later) her speech bubble have
        room to fly outside her silhouette without a second window. Empty air is `Background`-less
        (`{x:Null}`), which WPF does not hit-test, so a click on the padding falls through to
        whatever is behind her, exactly like the avatar tube's bubble region.

        Layer order, bottom to top:
          BodyRoot    her silhouette; the ONLY hit-testable region (Background="Transparent")
            BodyImage the pose PNG
            FaceLayer the face canvas and, over it, the glass (chunk B3 paints into GlassHost)
            OutfitOverImage the garment's own art, ABOVE the face and the glass (THE SKIN LAW)
            PropImage the thing she is holding, nearer the camera than the garment
            BtnClose  the hover x
            BtnGear   the hover gear (opens her options; her cards live in there too)
            BtnHelp   the hover ?, directly under the gear (opens her book)
            ResizeGrip the corner handle
          OverlayHost the summon/dismiss FX, and whatever chunk B2 wants over her
          BubbleHost  chunk B3's speech bubble

        Every size in here is a placeholder: EmiDeskWindow.ApplyWidth() drives the real numbers off
        the body PNG's 859 x 869 aspect and the glass rect from emi.css.
    -->
    <Grid x:Name="Root" Background="{x:Null}">

        <Grid x:Name="BodyRoot"
              HorizontalAlignment="Center" VerticalAlignment="Center"
              Background="Transparent"
              RenderTransformOrigin="0.5,0.55">
            <!-- Four slots, authored together so no animation has to re-parent another and none of
                 them can stamp on another's value:
                   CrtScale     the summon / dismiss power-on and the bounce / thud pulses
                   SquashScale  the click squash-and-stretch (EmiDeskWindow.React.cs)
                   WobbleRotate the drag sway and its release pendulum. Its centre is set in
                                ApplyBodyWidth so she swings from the HEAD, not the middle
                   MoveShift    the nod / droop / shiver offsets
                 The rotate sits above the scales on purpose: a squash applied after a rotation
                 would shear her rather than squash her. -->
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="CrtScale" ScaleX="1" ScaleY="1"/>
                    <ScaleTransform x:Name="SquashScale" ScaleX="1" ScaleY="1"/>
                    <RotateTransform x:Name="WobbleRotate" Angle="0"/>
                    <TranslateTransform x:Name="MoveShift"/>
                </TransformGroup>
            </Grid.RenderTransform>

            <Image x:Name="BodyImage"
                   Stretch="Fill"
                   IsHitTestVisible="False"
                   RenderOptions.BitmapScalingMode="NearestNeighbor"/>

            <!-- The glass. Positioned in code from the emi.css fractions; nothing in here is
                 hit-testable, because a glass click is resolved geometrically in the body's own
                 mouse-up handler (a hit-testable overlay would eat the drag). -->
            <Canvas x:Name="FaceLayer" IsHitTestVisible="False" ClipToBounds="False">
                <!-- THE GAZE LEAN (ALIVE wave A). The face glyph slides up to three DIPs toward
                     the cursor on its own transform, so the lean composes with the body's CRT
                     scale, click squash and drag wobble instead of fighting them, and the locked
                     renderer underneath is never touched. Driven by EmiDeskWindow.Alive.cs. -->
                <emi:EmiFace x:Name="FaceView">
                    <emi:EmiFace.RenderTransform>
                        <TranslateTransform x:Name="GazeShift"/>
                    </emi:EmiFace.RenderTransform>
                </emi:EmiFace>
                <Canvas x:Name="GlassCanvas" IsHitTestVisible="False"/>
            </Canvas>

            <!-- THE OUTFIT OVERLAY. THE SKIN LAW, and the reason this node is HERE and not one
                 line higher: the outfit/skin layer is the TOPMOST thing in EMI's composition,
                 above the face canvas and above the glass. Face art may never paint over a
                 garment - a collar buried under her screen is the bug this slot exists to make
                 impossible (owner, 2026-08-30). The web twin is `.emi-over` at z-index 2 in
                 Resources/web/arcademy/emi/widget.css; this is the same layer in WPF.

                 It is a sibling of BodyImage inside BodyRoot on purpose, so it inherits every
                 transform the body gets - the CRT squash, the click squash, the drag wobble, the
                 move offsets - exactly as BodyImage does, and needs no geometry of its own
                 (Stretch="Fill" over a Grid whose Width/Height ApplyBodyWidth already sets). The
                 web gets the same inheritance from `inset:0` inside `.emi`.

                 It costs NOTHING at rest: no Source, Collapsed, never hit-tested. Only
                 EmiDeskWindow.SetOutfit puts art on it, and only after EmiChains has found the
                 file on disk once. See the OUTFIT OVERLAY block in Services/EmiDesk/EmiChains.cs.

                 The three chrome affordances below draw OVER it. They are window chrome, not art:
                 a hover x hidden under a hat is a widget nobody can close. -->
            <Image x:Name="OutfitOverImage"
                   Stretch="Fill"
                   Visibility="Collapsed"
                   IsHitTestVisible="False"
                   RenderOptions.BitmapScalingMode="NearestNeighbor"/>

            <!-- THE THING SHE IS HOLDING (idle beat). One plate at her right hand - a phone, a
                 clipboard, a punch card - shown for a couple of seconds by a fidget and taken
                 straight back off. See Services/EmiDesk/EmiProps.cs for the anchor, the sizes and
                 why the plates are drawn from BEHIND.

                 IT DRAWS OVER THE GARMENT, and that is not a breach of THE SKIN LAW. The law says
                 no face art may bury a skin; a held object is not face art and it is not a skin -
                 it is nearer the camera than she is, so a clipboard held up in front of a labcoat
                 covers the labcoat exactly as it should. The chrome below still draws over it.

                 Sibling of BodyImage inside BodyRoot, so the CRT squash, the click squash, the drag
                 wobble and the move offsets carry it for free. Its own two transforms are private
                 to it: PropTilt is the few degrees of hold (about the bottom-right corner, which is
                 the hand - hence RenderTransformOrigin="1,1"), PropRise is the slide up out from
                 behind her. Geometry comes from EmiDeskWindow.LayoutProp; nothing here is real. -->
            <Image x:Name="PropImage"
                   HorizontalAlignment="Right" VerticalAlignment="Bottom"
                   Stretch="Fill"
                   Visibility="Collapsed"
                   IsHitTestVisible="False"
                   RenderTransformOrigin="1,1"
                   RenderOptions.BitmapScalingMode="NearestNeighbor">
                <Image.RenderTransform>
                    <TransformGroup>
                        <RotateTransform x:Name="PropTilt" Angle="0"/>
                        <TranslateTransform x:Name="PropRise"/>
                    </TransformGroup>
                </Image.RenderTransform>
            </Image>

            <!-- THE TWO CHIPS, and why each one is now a chip inside a bigger button.

                 Owner report, 2026-08-30: "I gotta hover EMI and be fast enough to catch those
                 buttons before they disappear." Half of that is the fade, which is a hover REGION
                 with a grace timer now (EmiChromeHover); the other half is that an 18 DIP round
                 target tucked into a corner is a small thing to land on, and every miss costs a
                 trip back across her.

                 So each button is `chip + 2 x ChipPad` DIPs of Background="Transparent" HIT AREA
                 with the drawn chip inset inside it by the button's Padding - exactly the split
                 ResizeGrip already had between its 22 DIP handle and its 12 DIP glyph. THE DRAWN
                 GLYPH DID NOT GROW; only the air around it did.

                 ApplyBodyWidth computes that padding ASYMMETRICALLY so the hit area never sticks
                 out past BodyRoot: the outward sides get at most the inset that is actually there
                 and the inward sides get the rest. That is not tidiness - the pad around her is
                 Background="{x:Null}" precisely so clicks fall THROUGH her to whatever is behind,
                 and a chip overhanging into that air would turn her transparent corner into a click
                 trap. For the same reason both buttons are hit-testable only while the chrome is
                 lit (see FadeChrome): at rest the whole silhouette pats her, corners included,
                 which is the gesture wave 3 exists to protect. -->

            <!-- The hover x. 18 DIP of drawn chip, top right of the silhouette, invisible until the
                 pointer is on her. No double-click dismiss anywhere: it would delay the ring click. -->
            <Button x:Name="BtnClose"
                    Width="18" Height="18" Padding="0"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Opacity="0" Cursor="Hand"
                    Focusable="False"
                    ToolTip="Send her away">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Grid Margin="{TemplateBinding Padding}">
                                <Ellipse Fill="#E60E0E1C" Stroke="#FF69B4" StrokeThickness="1.5"/>
                                <Path Data="M 5,5 L 13,13 M 13,5 L 5,13"
                                      Stroke="#FF69B4" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Grid>
                        </Grid>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- HER GEAR: 18 DIP of drawn chip, top LEFT, the mirror of the x and on the same hover
                 fade.

                 It replaces the six-dot cards glyph wave 3 put here. The owner read the dots as a
                 move handle ("the three dots to move emi - not needed, we drag her") and asked for
                 a gear that opens her options instead, so this chip opens EmiOptionsWindow - which
                 carries "Open her cards" as its first action, because the dots were the only
                 VISIBLE way into the ring and nothing on a desktop advertises a right click.
                 Right-click on her body still opens the ring directly; that gesture is unchanged.

                 The gear is eight axis-aligned rectangles on a 16 x 16 grid - a hollow square hub
                 and four teeth - and never a circle: she is a pixel CRT mascot and a smooth
                 anti-aliased cog beside her reads as somebody else's icon set. EdgeMode Aliased
                 keeps the rectangle edges hard when Stretch scales them, and it is set on the Path
                 alone so the chip's Ellipse still draws round. The subpaths deliberately do not
                 overlap, so the EvenOdd default leaves the hub's centre empty instead of filling it
                 back in. -->
            <Button x:Name="BtnGear"
                    Width="18" Height="18" Padding="0"
                    HorizontalAlignment="Left" VerticalAlignment="Top"
                    Opacity="0" Cursor="Hand"
                    Focusable="False"
                    ToolTip="Her options">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Grid Margin="{TemplateBinding Padding}">
                                <Ellipse Fill="#E60E0E1C" Stroke="#FF69B4" StrokeThickness="1.5"/>
                                <Path Fill="#FF69B4" Stretch="Uniform" Margin="4"
                                      RenderOptions.EdgeMode="Aliased"
                                      Data="M 2,2 h12 v4 h-12 z  M 2,10 h12 v4 h-12 z
                                            M 2,6 h4 v4 h-4 z    M 10,6 h4 v4 h-4 z
                                            M 6,0 h4 v2 h-4 z    M 6,14 h4 v2 h-4 z
                                            M 0,6 h2 v4 h-2 z    M 14,6 h2 v4 h-2 z"/>
                            </Grid>
                        </Grid>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- HER BOOK: the third chip, 18 DIP, top left and directly UNDER the gear.

                 The owner could not find the book at all (2026-08-30): it existed only as the
                 seventh entry on a ring nothing advertises and as an offer she makes once. A
                 manual you cannot reach is not a manual, so it gets the one glyph every piece of
                 software on earth has trained people to read as help.

                 It sits UNDER the gear rather than beside it because both top corners are already
                 spoken for and a third chip on a corner would crowd her face. Stacked down the
                 left edge the column reads as one group of controls, and ApplyBodyWidth offsets it
                 by exactly the gear's full hit height, so the two hit areas cannot overlap at any
                 body width.

                 The ? is a Path on the same 16 x 16 aliased grid as the gear, not a TextBlock: a
                 glyph from whatever font resolved would be the one smooth anti-aliased shape on a
                 pixel mascot. Five rectangles for the hook, a sixth for the dot, hard-edged at
                 every scale. -->
            <Button x:Name="BtnHelp"
                    Width="18" Height="18" Padding="0"
                    HorizontalAlignment="Left" VerticalAlignment="Top"
                    Opacity="0" Cursor="Hand"
                    Focusable="False"
                    ToolTip="Her book">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Grid Margin="{TemplateBinding Padding}">
                                <Ellipse Fill="#E60E0E1C" Stroke="#FF69B4" StrokeThickness="1.5"/>
                                <Path Fill="#FF69B4" Stretch="Uniform" Margin="4"
                                      RenderOptions.EdgeMode="Aliased"
                                      Data="M 4,0 h8 v2 h-8 z   M 4,2 h2 v2 h-2 z
                                            M 10,2 h2 v4 h-2 z  M 6,6 h6 v2 h-6 z
                                            M 6,8 h2 v3 h-2 z   M 6,13 h2 v2 h-2 z"/>
                            </Grid>
                        </Grid>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- The corner resize handle: 152 to 420 DIP, aspect locked.

                 Unlike the hover x this one is ALWAYS faintly lit while she is out (owner call,
                 QA 2026-08-29): a grip at Opacity=0 is a grip nobody can find, and she is the only
                 widget on the desktop with no window chrome to hint at a corner. It rests at
                 GripRestOpacity and goes solid when the pointer is on her (FadeChrome). The Border
                 is the HIT AREA (22 DIP and up, scaled in ApplyBodyWidth); the glyph inside stays a
                 12 DIP pixel corner so a bigger target does not mean a bigger drawing. -->
            <Border x:Name="ResizeGrip"
                    Width="22" Height="22"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Background="Transparent"
                    Opacity="0.35"
                    Cursor="SizeNWSE"
                    ToolTip="Drag to resize">
                <Path x:Name="ResizeGlyph"
                      HorizontalAlignment="Right" VerticalAlignment="Bottom"
                      Width="12" Height="12"
                      Stretch="None"
                      Data="M 1,11 L 11,1 M 5,11 L 11,5 M 9,11 L 11,9"
                      Stroke="#FF69B4" StrokeThickness="1.5"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            </Border>
        </Grid>

        <Canvas x:Name="OverlayCanvas" IsHitTestVisible="False" ClipToBounds="False"/>
        <Canvas x:Name="BubbleCanvas" IsHitTestVisible="False" ClipToBounds="False"/>
    </Grid>
</Window>
