<Window x:Class="ConditioningControlPanel.FirstRunWizard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hover="clr-namespace:ConditioningControlPanel.Behaviors"
        Title="Welcome"
        Height="680" Width="900"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        PreviewKeyDown="Window_PreviewKeyDown">

    <!-- The first run, in two steps: Welcome (language, your own content, the 18+ gate) and
         Flavour (which mod to run). Nothing else. The seven-doors step and its "Take the tour"
         button are gone - EMI offers the one walk there is, once, from her chip, after this
         window closes.

         The age check IS this window's primary button, not a MessageBox in front of it: Enter
         stays disabled until the box is ticked, and closing step 1 without ticking hands the
         first run back and shuts the app down, exactly as the old MessageBox "No" did.

         Card visuals are driven by plain INPC properties on FirstRunModCard (Visibility included)
         rather than value converters - a converter declared in the wrong resource scope inside a
         DataTemplate is one of this codebase's recurring WPF traps. Same discipline as
         ModPickerDialog, which this screen's flavour step is modelled on.

         Every string is assigned in code-behind through the Str() fallback helper, so a missing
         fr8_ key renders its English draft instead of the raw key. -->
    <Window.Resources>
        <Style x:Key="FrCardShell" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelBgBrush}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- One quiet row on the Welcome step: language, content folder, the age tick. -->
        <Style x:Key="FrWelcomeRow" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelBgBrush}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="FrRowLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="FrRowHint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>

        <!-- PinkButton has no disabled look of its own, and this button spends most of step 1
             disabled, so the gate has to be visible rather than merely enforced. -->
        <Style x:Key="FrPrimaryButton" TargetType="Button" BasedOn="{StaticResource PinkButton}">
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource DarkerBgBrush}" CornerRadius="12"
            BorderBrush="{DynamicResource PinkBrush}" BorderThickness="2">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ================= title bar ================= -->
            <Border Grid.Row="0" Background="{DynamicResource PanelBgBrush}" CornerRadius="12,12,0,0"
                    Padding="20,12" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="TxtWizardTitle" Grid.Column="0"
                               Foreground="{DynamicResource PinkBrush}"
                               FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>

                    <TextBlock x:Name="TxtStepCounter" Grid.Column="1" Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="12" VerticalAlignment="Center" Margin="0,0,14,0"/>

                    <Button x:Name="BtnCloseX" Grid.Column="2" Content="X" Click="BtnClose_Click"
                            Background="Transparent" Foreground="{DynamicResource TextMutedBrush}" FontSize="16" FontWeight="Bold"
                            BorderThickness="0" Cursor="Hand" Padding="8,2" Width="30" Height="30"/>
                </Grid>
            </Border>

            <!-- ================= body ================= -->
            <Grid Grid.Row="1" x:Name="StepHost" Margin="0">

                <!-- ========== step 1: welcome, and the one gate ========== -->
                <Grid x:Name="Step1" Visibility="Visible" Margin="34,22,34,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center"
                                Margin="0,0,0,12">
                        <Image x:Name="ImgWelcomeLogo" Width="46" Height="46" Margin="0,0,14,0"
                               VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="TxtAppTitle" Foreground="White"
                                       FontSize="20" FontWeight="Bold"/>
                            <TextBlock x:Name="TxtWelcomeHeading" Foreground="{DynamicResource PinkBrush}"
                                       FontSize="15" FontWeight="SemiBold" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock x:Name="TxtWelcomeBody" Grid.Row="1" Foreground="#E0E0E0" FontSize="13.5"
                               TextWrapping="Wrap" LineHeight="22" TextAlignment="Center"
                               Margin="30,0,30,20"/>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                        <StackPanel>

                            <!-- language -->
                            <Border Style="{StaticResource FrWelcomeRow}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock x:Name="TxtLanguageLabel" Style="{StaticResource FrRowLabel}"/>
                                        <TextBlock x:Name="TxtLanguageHint" Style="{StaticResource FrRowHint}"/>
                                    </StackPanel>
                                    <ComboBox x:Name="CmbWizardLanguage" Grid.Column="1" Width="200"
                                              VerticalAlignment="Center"
                                              SelectionChanged="CmbWizardLanguage_SelectionChanged"/>
                                </Grid>
                            </Border>

                            <!-- your own content -->
                            <Border Style="{StaticResource FrWelcomeRow}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock x:Name="TxtFolderLabel" Style="{StaticResource FrRowLabel}"/>
                                        <TextBlock x:Name="TxtFolderHint" Style="{StaticResource FrRowHint}"/>
                                    </StackPanel>
                                    <Button x:Name="BtnPickFolder" Grid.Column="1" Click="BtnPickFolder_Click"
                                            Style="{StaticResource OutlineButton}" FontSize="12"
                                            Padding="16,8" VerticalAlignment="Center" Cursor="Hand"/>
                                </Grid>
                            </Border>

                            <!-- the gate -->
                            <Border x:Name="AgeRow" Style="{StaticResource FrWelcomeRow}"
                                    BorderBrush="{DynamicResource PinkBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <CheckBox x:Name="ChkAgeConfirm" Grid.Column="0"
                                              Style="{StaticResource ItemCheckBox}"
                                              VerticalAlignment="Top" Margin="0,1,14,0"
                                              Checked="AgeConfirm_Changed" Unchecked="AgeConfirm_Changed"/>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock x:Name="TxtAgeConfirm" Foreground="White" FontSize="13.5"
                                                   TextWrapping="Wrap" LineHeight="20" Cursor="Hand"
                                                   MouseLeftButtonUp="AgeConfirmLabel_Click"/>
                                        <TextBlock Margin="0,6,0,0" FontSize="12.5">
                                            <Hyperlink x:Name="LnkContentPolicy" Click="LnkContentPolicy_Click"
                                                       Foreground="{DynamicResource PinkBrush}">
                                                <Run x:Name="RunContentPolicy"/>
                                            </Hyperlink>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- ========== step 2: flavour ========== -->
                <Grid x:Name="Step2" Visibility="Collapsed" Margin="26,18,26,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="TxtModHeading" Grid.Row="0" Foreground="White"
                               FontSize="17" FontWeight="Bold"/>
                    <TextBlock x:Name="TxtModSub" Grid.Row="1" Foreground="#C0C0C0" FontSize="12.5"
                               TextWrapping="Wrap" Margin="0,6,0,12"/>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                        <ItemsControl x:Name="ModCardsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource FrCardShell}"
                                            BorderBrush="{Binding CardBorderBrush}"
                                            BorderThickness="{Binding CardBorderThickness}"
                                            MouseLeftButtonUp="ModCard_Click">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{Binding SelectMark}"
                                                       Foreground="{Binding AccentBrush}" FontSize="16"
                                                       VerticalAlignment="Center" Margin="2,0,12,0"/>

                                            <!-- ClipToBounds added with the hover pop: without it the
                                                 1.06 zoom paints the art over the accent border. -->
                                            <Border Grid.Column="1" Width="72" Height="72" CornerRadius="8"
                                                    BorderBrush="{Binding AccentBrush}" BorderThickness="2"
                                                    ClipToBounds="True"
                                                    Background="#1A1A2E" Margin="0,0,14,0">
                                                <Image Source="{Binding ArtUri}" Stretch="UniformToFill"
                                                       RenderOptions.BitmapScalingMode="HighQuality"
                                                       hover:HoverPop.IsEnabled="True"/>
                                            </Border>

                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" Foreground="White"
                                                           FontSize="15" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding Description}" Foreground="#C0C0C0"
                                                           FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                                <TextBlock Text="{Binding Note}" Visibility="{Binding NoteVisibility}"
                                                           Foreground="#FFB347" FontSize="11" TextWrapping="Wrap"
                                                           Margin="0,5,0,0"/>

                                                <Grid Visibility="{Binding ProgressVisibility}" Margin="0,7,0,0">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <ProgressBar Grid.Row="0" Height="6" Minimum="0" Maximum="100"
                                                                 Value="{Binding Percent, Mode=OneWay}"
                                                                 Background="#252542" Foreground="{Binding AccentBrush}"
                                                                 BorderThickness="0"/>
                                                    <TextBlock Grid.Row="1" Text="{Binding StatusText}"
                                                               Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,4,0,0"/>
                                                </Grid>

                                                <TextBlock Text="{Binding StatusText}"
                                                           Visibility="{Binding StatusOnlyVisibility}"
                                                           Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,7,0,0"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="3" VerticalAlignment="Center"
                                                        HorizontalAlignment="Right" Margin="14,0,2,0">
                                                <Border Background="{DynamicResource PanelAccentBrush}" CornerRadius="10"
                                                        Padding="10,4" HorizontalAlignment="Right"
                                                        Visibility="{Binding SizeVisibility}">
                                                    <TextBlock Text="{Binding SizeText}" Foreground="#E0E0E0"
                                                               FontSize="12" FontWeight="SemiBold"/>
                                                </Border>
                                                <TextBlock Text="{Binding InstalledText}"
                                                           Visibility="{Binding InstalledVisibility}"
                                                           Foreground="#4CAF50" FontSize="12" FontWeight="SemiBold"
                                                           HorizontalAlignment="Right" Margin="0,6,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock x:Name="TxtModHint" Grid.Row="3" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"
                               TextWrapping="Wrap" Margin="0,8,0,0"/>
                </Grid>
            </Grid>

            <!-- ================= footer ================= -->
            <Border Grid.Row="2" Background="{DynamicResource PanelBgBrush}" CornerRadius="0,0,12,12"
                    Padding="20,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="BtnSkip" Grid.Column="1" Click="BtnSkip_Click"
                                Style="{StaticResource OutlineButton}" FontSize="12" Padding="18,10"
                                Margin="0,0,12,0" Cursor="Hand"/>

                        <Button x:Name="BtnNext" Grid.Column="2" Click="BtnNext_Click"
                                Style="{StaticResource FrPrimaryButton}" Cursor="Hand"/>
                    </Grid>

                    <TextBlock x:Name="TxtCloseHint" Grid.Row="1" HorizontalAlignment="Right"
                               Foreground="{DynamicResource TextMutedBrush}" FontSize="11.5"
                               Margin="0,9,2,0" TextWrapping="Wrap" TextAlignment="Right"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
