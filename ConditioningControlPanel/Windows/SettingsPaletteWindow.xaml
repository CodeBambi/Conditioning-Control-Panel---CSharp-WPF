<Window x:Class="ConditioningControlPanel.SettingsPaletteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:ConditioningControlPanel.Helpers"
        xmlns:loc="clr-namespace:ConditioningControlPanel.Localization"
        Title="Command Palette"
        Width="620" Height="470"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI"
        Foreground="{DynamicResource TextLightBrush}"
        Deactivated="Window_Deactivated"
        PreviewKeyDown="Window_PreviewKeyDown"
        Loaded="Window_Loaded">

    <!-- A borderless owned window rather than an overlay inside MainWindow's RootGrid: the
         Settings-door phase has several agents editing MainWindow.xaml at once, and a popup
         window needs no markup in there at all. It also sits above the WebView2 browser card,
         which an in-canvas overlay would lose an airspace fight with. -->

    <Window.Resources>
        <!-- Local, because the palette is the only consumer. Everything colour-wise resolves
             from Resources/Theme/Brushes.xaml so a mod/theme swap carries. -->
        <Style x:Key="PaletteRowStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="6,1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <!-- Screen readers hear the row (caption, then where it goes), never the type name. -->
            <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}"/>
            <!-- Single click activates: a palette row is a destination, not a selection. -->
            <EventSetter Event="PreviewMouseLeftButtonUp" Handler="Item_Click"/>
            <!-- Right-click pins or unpins the row to the dashboard's Favourites, the same verb as
                 right-clicking a rail entry. The only pin door for games and rack modules whose
                 cards carry no x:Name. -->
            <EventSetter Event="PreviewMouseRightButtonUp" Handler="Item_RightClick"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="rowBorder" Background="Transparent" CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="rowBorder" Property="Background"
                                        Value="{DynamicResource AccentTintedBgBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="rowBorder" Property="Background"
                                        Value="{DynamicResource AccentTintedBgHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource DarkerBgBrush}" CornerRadius="12"
            BorderBrush="{DynamicResource PinkBrush}" BorderThickness="1" Margin="14">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="26" ShadowDepth="4" Opacity="0.55"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Search field -->
            <Border Grid.Row="0" Background="{DynamicResource SurfaceBgBrush}"
                    CornerRadius="12,12,0,0" Padding="14,11"
                    BorderBrush="#2A2A46" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <helpers:EmojiTextBlock Grid.Column="0" Text="🔎" FontSize="15" VerticalAlignment="Center"
                               Margin="0,0,10,0"/>
                    <Grid Grid.Column="1">
                        <TextBox x:Name="TxtQuery" Background="Transparent" BorderThickness="0"
                                 Foreground="{DynamicResource TextLightBrush}"
                                 CaretBrush="{DynamicResource PinkBrush}"
                                 FontSize="16" VerticalContentAlignment="Center"
                                 TextChanged="TxtQuery_TextChanged"/>
                        <TextBlock x:Name="TxtPlaceholder" IsHitTestVisible="False"
                                   Text="{loc:Str nav_search_placeholder}"
                                   Foreground="{DynamicResource TextDimBrush}"
                                   FontSize="16" VerticalAlignment="Center"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- Results -->
            <ListBox x:Name="ListResults" Grid.Row="1" Background="Transparent" BorderThickness="0"
                     Margin="0,6,0,6"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ItemContainerStyle="{StaticResource PaletteRowStyle}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- Colour Twemoji; a glyph with no asset falls back to light text (a bare
                                 TextBlock would paint an emoji as a black silhouette). -->
                            <Grid Grid.Column="0" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,11,0">
                                <Image Source="{Binding Glyph, Converter={StaticResource EmojiToImageSource}}"
                                       Stretch="Uniform"/>
                                <TextBlock Text="{Binding Glyph}" FontSize="15"
                                           Foreground="{DynamicResource TextLightBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding Glyph, Converter={StaticResource EmojiFallbackVisibility}}"/>
                            </Grid>
                            <StackPanel Grid.Column="1">
                                <!-- Caption, then the retired name it was found under ("(was Premium)"). -->
                                <TextBlock FontSize="13" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextLightBrush}">
                                    <Run Text="{Binding Label, Mode=OneWay}"/>
                                    <Run Text="{Binding WasHint, Mode=OneWay}" FontSize="11"
                                         Foreground="{DynamicResource TextDimBrush}"/>
                                </TextBlock>
                                <TextBlock Text="{Binding Context}" FontSize="11"
                                           Foreground="{DynamicResource TextDimBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding ContextVisibility}"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Empty state (shown instead of the list when nothing matches): what was typed, the
                 nearest thing it might have meant as a clickable row, and a way to see every page. -->
            <StackPanel x:Name="PanelEmpty" Grid.Row="1" Visibility="Collapsed"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="TxtEmpty" Text="{loc:Str set2_palette_no_results}"
                           Foreground="{DynamicResource TextDimBrush}" FontSize="13"
                           HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="520"/>
                <Button x:Name="BtnTry" Click="BtnTry_Click" Margin="0,12,0,0" Cursor="Hand"
                        HorizontalAlignment="Center" Visibility="Collapsed"
                        Background="{DynamicResource AccentTintedBgBrush}"
                        Foreground="{DynamicResource TextLightBrush}" BorderThickness="0"
                        Padding="14,7" FontSize="13">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="7"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="Background"
                                            Value="{DynamicResource AccentTintedBgHoverBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <TextBlock x:Name="TxtTry" Foreground="{DynamicResource TextLightBrush}"/>
                </Button>
                <Button x:Name="BtnAll" Click="BtnAll_Click" Margin="0,8,0,0" Cursor="Hand"
                        HorizontalAlignment="Center" Background="Transparent" BorderThickness="0"
                        Padding="10,5" FontSize="12">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <TextBlock Text="{loc:Str nav_search_all}" TextDecorations="Underline"
                               Foreground="{DynamicResource PinkBrush}"/>
                </Button>
            </StackPanel>

            <!-- Footer hint -->
            <Border Grid.Row="2" Background="{DynamicResource SurfaceBgBrush}"
                    CornerRadius="0,0,12,12" Padding="14,7"
                    BorderBrush="#2A2A46" BorderThickness="0,1,0,0">
                <TextBlock x:Name="TxtHint" Text="{loc:Str set2_palette_hint}"
                           Foreground="{DynamicResource TextDimBrush}" FontSize="11"/>
            </Border>
        </Grid>
    </Border>
</Window>
