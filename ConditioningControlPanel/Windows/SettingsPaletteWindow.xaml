<Window x:Class="ConditioningControlPanel.SettingsPaletteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ConditioningControlPanel.Localization"
        Title="Command Palette"
        Width="620" Height="470"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI"
        Foreground="{DynamicResource TextLightBrush}"
        Deactivated="Window_Deactivated"
        PreviewKeyDown="Window_PreviewKeyDown"
        Loaded="Window_Loaded">

    <!-- A borderless owned window rather than an overlay inside MainWindow's RootGrid: the
         Settings-door phase has several agents editing MainWindow.xaml at once, and a popup
         window needs no markup in there at all. It also sits above the WebView2 browser card,
         which an in-canvas overlay would lose an airspace fight with. -->

    <Window.Resources>
        <!-- Local, because the palette is the only consumer. Everything colour-wise resolves
             from Resources/Theme/Brushes.xaml so a mod/theme swap carries. -->
        <Style x:Key="PaletteRowStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="6,1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <!-- Single click activates: a palette row is a destination, not a selection. -->
            <EventSetter Event="PreviewMouseLeftButtonUp" Handler="Item_Click"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="rowBorder" Background="Transparent" CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="rowBorder" Property="Background"
                                        Value="{DynamicResource AccentTintedBgBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="rowBorder" Property="Background"
                                        Value="{DynamicResource AccentTintedBgHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource DarkerBgBrush}" CornerRadius="12"
            BorderBrush="{DynamicResource PinkBrush}" BorderThickness="1" Margin="14">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="26" ShadowDepth="4" Opacity="0.55"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Search field -->
            <Border Grid.Row="0" Background="{DynamicResource SurfaceBgBrush}"
                    CornerRadius="12,12,0,0" Padding="14,11"
                    BorderBrush="#2A2A46" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="🔎" FontSize="15" VerticalAlignment="Center"
                               Margin="0,0,10,0"/>
                    <Grid Grid.Column="1">
                        <TextBox x:Name="TxtQuery" Background="Transparent" BorderThickness="0"
                                 Foreground="{DynamicResource TextLightBrush}"
                                 CaretBrush="{DynamicResource PinkBrush}"
                                 FontSize="16" VerticalContentAlignment="Center"
                                 TextChanged="TxtQuery_TextChanged"/>
                        <TextBlock x:Name="TxtPlaceholder" IsHitTestVisible="False"
                                   Text="{loc:Str set2_palette_placeholder}"
                                   Foreground="{DynamicResource TextDimBrush}"
                                   FontSize="16" VerticalAlignment="Center"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- Results -->
            <ListBox x:Name="ListResults" Grid.Row="1" Background="Transparent" BorderThickness="0"
                     Margin="0,6,0,6"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ItemContainerStyle="{StaticResource PaletteRowStyle}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Glyph}" FontSize="15"
                                       VerticalAlignment="Center" Margin="0,0,11,0"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Label}" FontSize="13"
                                           Foreground="{DynamicResource TextLightBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Context}" FontSize="11"
                                           Foreground="{DynamicResource TextDimBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding ContextVisibility}"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Empty state (shown instead of the list when nothing matches) -->
            <TextBlock x:Name="TxtEmpty" Grid.Row="1" Visibility="Collapsed"
                       Text="{loc:Str set2_palette_no_results}"
                       Foreground="{DynamicResource TextDimBrush}" FontSize="13"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>

            <!-- Footer hint -->
            <Border Grid.Row="2" Background="{DynamicResource SurfaceBgBrush}"
                    CornerRadius="0,0,12,12" Padding="14,7"
                    BorderBrush="#2A2A46" BorderThickness="0,1,0,0">
                <TextBlock x:Name="TxtHint" Text="{loc:Str set2_palette_hint}"
                           Foreground="{DynamicResource TextDimBrush}" FontSize="11"/>
            </Border>
        </Grid>
    </Border>
</Window>
