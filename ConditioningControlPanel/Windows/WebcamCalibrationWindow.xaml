<Window x:Class="ConditioningControlPanel.WebcamCalibrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Webcam Calibration"
        Background="#000000"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        KeyDown="Window_KeyDown"
        Loaded="Window_Loaded"
        Closed="Window_Closed">
    <Grid>
        <Canvas x:Name="DotCanvas">
            <!-- Background ring: faint full circle so the user always sees the
                 progress track. -->
            <Ellipse x:Name="DotRingBg" Width="84" Height="84"
                     Stroke="#33FFFFFF" StrokeThickness="3"/>
            <!-- Foreground ring: fills clockwise from 12 o'clock as samples
                 accumulate. Drawn via StrokeDashArray (visible/gap) so we can
                 update the fill amount per-frame from code-behind. -->
            <Ellipse x:Name="DotRingFg" Width="84" Height="84"
                     Stroke="#FFFF69B4" StrokeThickness="4"
                     StrokeDashArray="0 10000" StrokeDashCap="Round"
                     RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <TransformGroup>
                        <RotateTransform Angle="-90"/>
                        <ScaleTransform x:Name="DotRingScale" ScaleX="1" ScaleY="1"/>
                    </TransformGroup>
                </Ellipse.RenderTransform>
                <Ellipse.Effect>
                    <DropShadowEffect Color="#FF69B4" BlurRadius="14" ShadowDepth="0" Opacity="0.7"/>
                </Ellipse.Effect>
            </Ellipse>
            <Ellipse x:Name="Dot" Width="44" Height="44">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#FFFFB6E1" Offset="0"/>
                        <GradientStop Color="#FFFF69B4" Offset="0.6"/>
                        <GradientStop Color="#FFC71585" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.Effect>
                    <DropShadowEffect Color="#FF69B4" BlurRadius="30" ShadowDepth="0" Opacity="0.9"/>
                </Ellipse.Effect>
            </Ellipse>
        </Canvas>

        <!-- Discoverability hint for the global 6-blink recalibrate gesture.
             Shown on the intro + verify panels (toggled from code-behind), hidden
             during the dot grid so it never overlaps the top-row dots. -->
        <Border x:Name="ShortcutHintBanner" Visibility="Collapsed"
                VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,12,0,0"
                Background="#22FF69B4" BorderBrush="#55FF69B4" BorderThickness="1"
                CornerRadius="10" Padding="16,7" Panel.ZIndex="100">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="👁" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Foreground="#FFE3F0" FontSize="12" VerticalAlignment="Center"
                           Text="Tip: blink fast 6 times in a row, anytime, to stop everything and jump straight back here to recalibrate."/>
            </StackPanel>
        </Border>

        <StackPanel x:Name="StatusPanel" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock x:Name="TxtTitle" Text="Webcam Calibration" Foreground="White"
                           FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
                <!-- Inline "?" (HelpButtonStyle lives only in MainWindow, not reachable
                     from this top-level Window). Always visible, even when gated/locked. -->
                <Button x:Name="BtnCalibrationHelp" Content="?" Click="BtnCalibrationHelp_Click"
                        Width="24" Height="24" Margin="12,0,0,0" VerticalAlignment="Center"
                        Cursor="Help" Foreground="White" Background="Transparent"
                        BorderBrush="#FF69B4" BorderThickness="1" FontWeight="Bold" FontSize="12"
                        ToolTip="Calibration help">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#FF69B4"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
            <TextBlock x:Name="TxtStatus" Text="Look at the pink dot. Press ESC to cancel."
                       Foreground="#AAAAAA" FontSize="14" Margin="0,8,0,0" HorizontalAlignment="Center"/>
            <TextBlock x:Name="TxtProgress" Text="" Foreground="#FF69B4" FontSize="13"
                       Margin="0,4,0,0" HorizontalAlignment="Center" FontFamily="Consolas"/>
        </StackPanel>

        <!-- Step 0 (skippable): lighting picker. One-sided room light skews
             tracking toward the lit side — the calibration fit and the
             runtime clamp compensate for the declared shadow side. Each tile
             is a mini infographic: the user's face as the webcam sees it,
             shaded away from the sun. -->
        <Border x:Name="LightSourcePanel" Visibility="Collapsed"
                Background="#181820" BorderBrush="#FF69B4" BorderThickness="2"
                CornerRadius="14" Padding="36,28,36,28"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                MaxWidth="860">
            <StackPanel>
                <TextBlock Text="Before we start — your lighting" Foreground="#FFFFFF"
                           FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <TextBlock Foreground="#CCCCCC" FontSize="14" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,14"
                           Text="Where is your main light (window or lamp) coming from? Light from one side makes eye tracking stronger on that side and weaker on the other — telling us lets calibration compensate."/>
                <UniformGrid Columns="5" HorizontalAlignment="Center" Margin="0,4,0,10">
                    <Button x:Name="BtnLightLeft" Tag="left" Click="BtnLightPick_Click" Margin="6" Padding="0"
                            Background="#22252E" BorderBrush="#3A3A55" BorderThickness="2" Cursor="Hand">
                        <StackPanel Margin="10,10,10,12">
                            <Grid Width="96" Height="70">
                                <Ellipse Width="24" Height="24" HorizontalAlignment="Left" VerticalAlignment="Center" Fill="#FFD94A"/>
                                <Ellipse Width="40" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Ellipse.Fill>
                                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                            <GradientStop Color="#FFE3C0" Offset="0.3"/>
                                            <GradientStop Color="#584A62" Offset="0.9"/>
                                        </LinearGradientBrush>
                                    </Ellipse.Fill>
                                </Ellipse>
                            </Grid>
                            <TextBlock Text="From my left" Foreground="#EEEEEE" FontSize="12"
                                       HorizontalAlignment="Center" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnLightRight" Tag="right" Click="BtnLightPick_Click" Margin="6" Padding="0"
                            Background="#22252E" BorderBrush="#3A3A55" BorderThickness="2" Cursor="Hand">
                        <StackPanel Margin="10,10,10,12">
                            <Grid Width="96" Height="70">
                                <Ellipse Width="24" Height="24" HorizontalAlignment="Right" VerticalAlignment="Center" Fill="#FFD94A"/>
                                <Ellipse Width="40" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Ellipse.Fill>
                                        <LinearGradientBrush StartPoint="1,0.5" EndPoint="0,0.5">
                                            <GradientStop Color="#FFE3C0" Offset="0.3"/>
                                            <GradientStop Color="#584A62" Offset="0.9"/>
                                        </LinearGradientBrush>
                                    </Ellipse.Fill>
                                </Ellipse>
                            </Grid>
                            <TextBlock Text="From my right" Foreground="#EEEEEE" FontSize="12"
                                       HorizontalAlignment="Center" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnLightTop" Tag="top" Click="BtnLightPick_Click" Margin="6" Padding="0"
                            Background="#22252E" BorderBrush="#3A3A55" BorderThickness="2" Cursor="Hand">
                        <StackPanel Margin="10,10,10,12">
                            <Grid Width="96" Height="70">
                                <Ellipse Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Top" Fill="#FFD94A"/>
                                <Ellipse Width="40" Height="48" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-4">
                                    <Ellipse.Fill>
                                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                            <GradientStop Color="#FFE3C0" Offset="0.25"/>
                                            <GradientStop Color="#584A62" Offset="0.9"/>
                                        </LinearGradientBrush>
                                    </Ellipse.Fill>
                                </Ellipse>
                            </Grid>
                            <TextBlock Text="From above" Foreground="#EEEEEE" FontSize="12"
                                       HorizontalAlignment="Center" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnLightFront" Tag="front" Click="BtnLightPick_Click" Margin="6" Padding="0"
                            Background="#22252E" BorderBrush="#3A3A55" BorderThickness="2" Cursor="Hand">
                        <StackPanel Margin="10,10,10,12">
                            <Grid Width="96" Height="70">
                                <Ellipse Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,2,0,0" Fill="#FFD94A" Opacity="0.85"/>
                                <Ellipse Width="40" Height="48" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-4" Fill="#FFE3C0"/>
                            </Grid>
                            <TextBlock Text="In front / even" Foreground="#EEEEEE" FontSize="12"
                                       HorizontalAlignment="Center" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnLightBack" Tag="back" Click="BtnLightPick_Click" Margin="6" Padding="0"
                            Background="#22252E" BorderBrush="#3A3A55" BorderThickness="2" Cursor="Hand">
                        <StackPanel Margin="10,10,10,12">
                            <Grid Width="96" Height="70">
                                <Ellipse Width="52" Height="52" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="#FFD94A" Opacity="0.55"/>
                                <Ellipse Width="40" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="#3B3344"/>
                            </Grid>
                            <TextBlock Text="Behind me" Foreground="#EEEEEE" FontSize="12"
                                       HorizontalAlignment="Center" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Button>
                </UniformGrid>
                <TextBlock Foreground="#888888" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,14"
                           Text="Backlight (window behind you) is the hardest for the camera — if you can, face the light instead."/>
                <Button x:Name="BtnLightSkip" Content="Skip — not sure / it changes"
                        Padding="24,8" Background="#33334A" Foreground="#DDDDDD"
                        BorderThickness="0" FontSize="13"
                        Cursor="Hand" HorizontalAlignment="Center"
                        Click="BtnLightSkip_Click"/>
            </StackPanel>
        </Border>

        <Border x:Name="IntroPanel" Visibility="Collapsed"
                Background="#181820" BorderBrush="#FF69B4" BorderThickness="2"
                CornerRadius="14" Padding="36,28,36,28"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                MaxWidth="640">
            <StackPanel>
                <TextBlock Text="Webcam Calibration"
                           Foreground="#FFFFFF" FontSize="26" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,0,0,4"/>
                <TextBlock Text="Two short phases — under a minute total."
                           Foreground="#FFB6E1" FontSize="14"
                           HorizontalAlignment="Center" Margin="0,0,0,22"/>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="1." Foreground="#FF69B4"
                               FontSize="15" FontWeight="Bold" VerticalAlignment="Top"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Dot grid (16 dots)" Foreground="#FFFFFF"
                                   FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="A pink dot moves around the screen. Look at it and hold your gaze until the ring around it fills up."
                                   Foreground="#CCCCCC" FontSize="13" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="2." Foreground="#FF69B4"
                               FontSize="15" FontWeight="Bold" VerticalAlignment="Top"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Quick checks" Foreground="#FFFFFF"
                                   FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="Two quick prompts to warm up tracking: blink, then open your mouth wide."
                                   Foreground="#CCCCCC" FontSize="13" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>

                <TextBlock Foreground="#888888" FontSize="12"
                           HorizontalAlignment="Center" TextAlignment="Center"
                           TextWrapping="Wrap" Margin="0,0,0,18">
                    Sit comfortably, with even lighting on your face. ESC cancels at any time.
                </TextBlock>

                <Button x:Name="BtnIntroContinue" Content="Continue"
                        Padding="32,10" Background="#FF69B4" Foreground="Black"
                        BorderThickness="0" FontWeight="Bold" FontSize="15"
                        Cursor="Hand" HorizontalAlignment="Center"
                        Click="BtnIntroContinue_Click"/>
            </StackPanel>
        </Border>

        <Grid x:Name="ValidationPanel" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="TxtValidationCue" Text="" Foreground="#FF69B4"
                           FontSize="160" FontWeight="Bold" HorizontalAlignment="Center"
                           Margin="0,0,0,20">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#FF69B4" BlurRadius="40" ShadowDepth="0" Opacity="0.7"/>
                    </TextBlock.Effect>
                </TextBlock>
                <TextBlock x:Name="TxtValidationPrompt" Text="" Foreground="White"
                           FontSize="32" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock x:Name="TxtValidationDetail" Text="" Foreground="#AAAAAA"
                           FontSize="16" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                <TextBlock x:Name="TxtValidationAttempt" Text="" Foreground="#FF69B4"
                           FontSize="13" FontFamily="Consolas" HorizontalAlignment="Center"
                           Margin="0,16,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Bubble accuracy test: optional post-calibration minigame launched
             from the verify panel. One bubble at a time; the user pops it by
             holding their gaze cursor on it (~0.7s dwell). Residuals feed a
             drift fine-tune — see RunBubbleTestAsync. -->
        <Grid x:Name="BubbleTestPanel" Visibility="Collapsed">
            <Canvas x:Name="BubbleTestCanvas">
                <Ellipse x:Name="TestBubbleRingBg" Width="176" Height="176"
                         Stroke="#33FFFFFF" StrokeThickness="4" Visibility="Collapsed"/>
                <Ellipse x:Name="TestBubbleRingFg" Width="176" Height="176"
                         Stroke="#FFFF69B4" StrokeThickness="5"
                         StrokeDashArray="0 10000" StrokeDashCap="Round"
                         RenderTransformOrigin="0.5,0.5" Visibility="Collapsed">
                    <Ellipse.RenderTransform>
                        <RotateTransform Angle="-90"/>
                    </Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse x:Name="TestBubble" Width="128" Height="128"
                         RenderTransformOrigin="0.5,0.5" Visibility="Collapsed">
                    <Ellipse.RenderTransform>
                        <ScaleTransform x:Name="TestBubbleScale" ScaleX="1" ScaleY="1"/>
                    </Ellipse.RenderTransform>
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#66FFFFFF" Offset="0"/>
                            <GradientStop Color="#99FF9BD0" Offset="0.7"/>
                            <GradientStop Color="#CCFF69B4" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.Effect>
                        <DropShadowEffect Color="#FF69B4" BlurRadius="24" ShadowDepth="0" Opacity="0.8"/>
                    </Ellipse.Effect>
                </Ellipse>
            </Canvas>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,0">
                <TextBlock Text="Accuracy test" Foreground="White" FontSize="22" FontWeight="Bold"
                           HorizontalAlignment="Center"/>
                <TextBlock x:Name="TxtBubbleTestStatus"
                           Text="Look at each bubble — hold your gaze on it to pop it. ESC cancels."
                           Foreground="#AAAAAA" FontSize="14" Margin="0,8,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <Border x:Name="ErrorPanel" Visibility="Collapsed"
                Background="#221A1A" BorderBrush="#FF4040" BorderThickness="2"
                CornerRadius="10" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                MaxWidth="520">
            <StackPanel>
                <TextBlock Text="Calibration failed" Foreground="#FF8080" FontSize="18"
                           FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock x:Name="TxtErrorDetail" Text="" Foreground="White" FontSize="13"
                           Margin="0,12,0,16" TextWrapping="Wrap" HorizontalAlignment="Center"/>
                <Button x:Name="BtnErrorClose" Content="Close" Padding="20,8"
                        Background="#FF69B4" Foreground="Black" BorderThickness="0"
                        FontWeight="Bold" Cursor="Hand" Click="BtnErrorClose_Click"
                        HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Verify panel: shown after successful calibration. Replaces the
             old 2.5s auto-close so the user can sanity-check accuracy via
             the debug cursor before committing. Placeholder copy — voice-pass
             at ship time. -->
        <Border x:Name="VerifyPanel" Visibility="Collapsed"
                Background="#1A1A2E" BorderBrush="#FF69B4" BorderThickness="2"
                CornerRadius="10" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center"
                MaxWidth="560">
            <StackPanel>
                <TextBlock Text="Calibration verified" Foreground="#FF69B4" FontSize="22"
                           FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Text="Calibration complete. Blink and mouth tracking warmed up — you're all set."
                           Foreground="#CCCCCC" FontSize="13" Margin="0,8,0,0"
                           TextWrapping="Wrap" HorizontalAlignment="Center"/>
                <TextBlock x:Name="TxtVerifyStatus" Text="Preview accuracy with a live gaze cursor, or pop a few bubbles with your eyes to test (and auto fine-tune) precision."
                           Foreground="#AAAAAA" FontSize="12" Margin="0,16,0,20"
                           TextWrapping="Wrap" HorizontalAlignment="Center" MaxWidth="440"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="BtnVerifyAccuracy" Content="Verify accuracy" Padding="20,10"
                            Background="#33333A" Foreground="White" BorderBrush="#FF69B4"
                            BorderThickness="1" FontWeight="SemiBold" Cursor="Hand"
                            Margin="0,0,8,0" Click="BtnVerifyAccuracy_Click"/>
                    <Button x:Name="BtnVerifyBubbleTest" Content="Bubble test" Padding="20,10"
                            Background="#33333A" Foreground="White" BorderBrush="#FF69B4"
                            BorderThickness="1" FontWeight="SemiBold" Cursor="Hand"
                            Margin="0,0,8,0" Click="BtnVerifyBubbleTest_Click"/>
                    <Button x:Name="BtnVerifyRecalibrate" Content="Recalibrate" Padding="20,10"
                            Background="#33333A" Foreground="White" BorderThickness="0"
                            Cursor="Hand" Margin="0,0,8,0" Click="BtnVerifyRecalibrate_Click"/>
                    <Button x:Name="BtnVerifyDone" Content="Done" Padding="20,10"
                            Background="#FF69B4" Foreground="Black" BorderThickness="0"
                            FontWeight="Bold" Cursor="Hand" Click="BtnVerifyDone_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
