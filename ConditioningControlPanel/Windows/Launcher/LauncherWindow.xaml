<Window x:Class="ConditioningControlPanel.Launcher.LauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ConditioningControlPanel.Localization"
        xmlns:fx="clr-namespace:ConditioningControlPanel.Controls"
        xmlns:emi="clr-namespace:ConditioningControlPanel.Services.EmiDesk"
        Title="CC Labs"
        Icon="pack://application:,,,/Resources/app.ico"
        Height="800" Width="1280"
        MinHeight="680" MinWidth="1000"
        Background="{DynamicResource DarkerBgBrush}"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="CanResize"
        ShowInTaskbar="True"
        UseLayoutRounding="True"
        FontFamily="Segoe UI">

    <!-- The CC Labs launcher: one screen, dark ground, one accent. The panel on the left, the
         games on the right, links along the bottom. Same shell as MainWindow: no OS chrome, our
         own title bar, and never AllowsTransparency (the render-thread hang family). -->

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="5" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- A text link: no box, underline on hover. -->
        <Style x:Key="LauncherLink" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <TextBlock x:Name="Txt" Text="{TemplateBinding Content}"
                                       Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Txt" Property="TextDecorations" Value="Underline"/>
                                <Setter TargetName="Txt" Property="Foreground" Value="{DynamicResource TextLightBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The one big call to action. -->
        <Style x:Key="LauncherCta" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentGradientBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="/Fonts/#Fredoka, Segoe UI"/>
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="56"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.92"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The round icon buttons in the title bar chip and on the tiles. -->
        <Style x:Key="LauncherIconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource ElevatedSurfaceBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A tile's Play: outline at rest, and on hover the tile's own colour floods in behind
             white text. The tile sets Background (the fill), BorderBrush and Foreground. -->
        <Style x:Key="LauncherPlay" TargetType="Button">
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Fill" Background="{TemplateBinding Background}" CornerRadius="10" Opacity="0"/>
                            <Border x:Name="Rim" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10"/>
                            <ContentPresenter x:Name="Cp" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Cp" Property="TextElement.Foreground" Value="White"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Fill" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14"/>
                                            <DoubleAnimation Storyboard.TargetName="Rim" Storyboard.TargetProperty="Opacity" To="0.35" Duration="0:0:0.14"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Fill" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.22"/>
                                            <DoubleAnimation Storyboard.TargetName="Rim" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.22"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LauncherStatNumber" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="/Fonts/#Fredoka, Segoe UI"/>
            <Setter Property="FontSize" Value="30"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextLightBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>

        <Style x:Key="LauncherEyebrow" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <!-- Backdrop: radial base -> two spiral watermarks -> mod-tinted glow -> vignette (the
             ceremony recipe with the brand drawn into it), then the ambient canvas (fog, dust,
             embers, aurora) behind everything. Every layer here carries a TranslateTransform the
             Backdrop partial nudges with the cursor for depth, and the moving ones bleed past the
             window edge (negative margins) so a nudge never uncovers a seam. All of it parks with
             the window. -->
        <Border>
            <Border.Background>
                <RadialGradientBrush GradientOrigin="0.28,0.22" Center="0.28,0.22" RadiusX="0.98" RadiusY="0.92">
                    <GradientStop Color="#FF2C1450" Offset="0"/>
                    <GradientStop Color="#FF1C1233" Offset="0.42"/>
                    <GradientStop Color="#FF100A1E" Offset="0.72"/>
                    <GradientStop Color="#FF06030E" Offset="1"/>
                </RadialGradientBrush>
            </Border.Background>
        </Border>

        <!-- The big spiral: an Archimedean curve built in code (SpiralPath.Data), sitting behind
             the panel card and turning once every 90 s. Cached to a bitmap so the rotation is a
             texture spin, not a re-tessellation of a seven-turn stroke at 10 fps. -->
        <Grid x:Name="SpiralLayer" Width="900" Height="900" HorizontalAlignment="Left" VerticalAlignment="Center"
              Margin="-230,0,0,0" Opacity="0.11" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
            <Grid.CacheMode>
                <BitmapCache/>
            </Grid.CacheMode>
            <Grid.RenderTransform>
                <TransformGroup>
                    <RotateTransform x:Name="SpiralTurn"/>
                    <TranslateTransform x:Name="SpiralShift"/>
                </TransformGroup>
            </Grid.RenderTransform>
            <Path x:Name="SpiralPath" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                <Path.Stroke>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="{DynamicResource FxGlowColor}" Offset="0"/>
                        <GradientStop Color="{DynamicResource FxParticleColor}" Offset="1"/>
                    </LinearGradientBrush>
                </Path.Stroke>
            </Path>
        </Grid>
        <!-- A smaller one under the tiles, counter-turning, fainter. -->
        <Grid x:Name="SpiralSmall" Width="560" Height="560" HorizontalAlignment="Right" VerticalAlignment="Bottom"
              Margin="0,0,-120,-170" Opacity="0.065" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
            <Grid.CacheMode>
                <BitmapCache/>
            </Grid.CacheMode>
            <Grid.RenderTransform>
                <TransformGroup>
                    <RotateTransform x:Name="SpiralSmallTurn"/>
                    <TranslateTransform x:Name="SpiralSmallShift"/>
                </TransformGroup>
            </Grid.RenderTransform>
            <Path x:Name="SpiralSmallPath" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                <Path.Stroke>
                    <LinearGradientBrush StartPoint="1,0" EndPoint="0,1">
                        <GradientStop Color="{DynamicResource FxParticleColor}" Offset="0"/>
                        <GradientStop Color="{DynamicResource FxGlowColor}" Offset="1"/>
                    </LinearGradientBrush>
                </Path.Stroke>
            </Path>
        </Grid>

        <Border x:Name="GlowLayer" Opacity="0.36" Margin="-28">
            <Border.RenderTransform>
                <TranslateTransform x:Name="GlowShift"/>
            </Border.RenderTransform>
            <Border.Background>
                <RadialGradientBrush GradientOrigin="0.72,0.18" Center="0.72,0.18" RadiusX="0.58" RadiusY="0.52">
                    <GradientStop Color="{DynamicResource FxGlowColor}" Offset="0"/>
                    <GradientStop Color="#00000000" Offset="1"/>
                </RadialGradientBrush>
            </Border.Background>
        </Border>
        <!-- A second, cooler pool low on the left, so the panel card sits in its own light. -->
        <Border Opacity="0.22" Margin="-28" IsHitTestVisible="False">
            <Border.RenderTransform>
                <TranslateTransform x:Name="PoolShift"/>
            </Border.RenderTransform>
            <Border.Background>
                <RadialGradientBrush GradientOrigin="0.16,0.82" Center="0.16,0.82" RadiusX="0.48" RadiusY="0.46">
                    <GradientStop Color="{DynamicResource FxParticleColor}" Offset="0"/>
                    <GradientStop Color="#00000000" Offset="1"/>
                </RadialGradientBrush>
            </Border.Background>
        </Border>
        <Border IsHitTestVisible="False">
            <Border.Background>
                <RadialGradientBrush GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.82" RadiusY="0.82">
                    <GradientStop Color="#00000000" Offset="0.42"/>
                    <GradientStop Color="#66000000" Offset="0.78"/>
                    <GradientStop Color="#C4000000" Offset="1"/>
                </RadialGradientBrush>
            </Border.Background>
        </Border>
        <fx:AmbientFxCanvas x:Name="Ambient" Margin="-12">
            <fx:AmbientFxCanvas.RenderTransform>
                <TranslateTransform x:Name="AmbientShift"/>
            </fx:AmbientFxCanvas.RenderTransform>
        </fx:AmbientFxCanvas>

        <Grid x:Name="ContentRoot">
            <!-- The shake on Play and on the CTA moves the whole content, never the backdrop. -->
            <Grid.RenderTransform>
                <TranslateTransform x:Name="ShakeSlide"/>
            </Grid.RenderTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="52"/>
            </Grid.RowDefinitions>

            <!-- ================= top bar ================= -->
            <Border x:Name="TitleBar" Grid.Row="0" Background="Transparent"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Grid x:Name="Wordmark" Margin="18,0,0,0" VerticalAlignment="Center" ClipToBounds="True">
                        <StackPanel Orientation="Horizontal">
                            <Image x:Name="WordmarkImage" Source="pack://application:,,,/Resources/logo2.png"
                                   Height="28" RenderOptions.BitmapScalingMode="HighQuality"
                                   RenderTransformOrigin="0.5,0.5">
                                <Image.RenderTransform>
                                    <ScaleTransform x:Name="WordmarkScale"/>
                                </Image.RenderTransform>
                            </Image>
                            <TextBlock Text="{loc:Str launcher_window_title}" Margin="10,0,0,0"
                                       FontFamily="/Fonts/#Fredoka, Segoe UI" FontSize="18" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextLightBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <!-- One light pass over the wordmark every 25-40 s (a timer, never a loop).
                             Opacity 0 at rest, so it costs nothing between passes. -->
                        <Rectangle x:Name="WordmarkSheen" Width="70" HorizontalAlignment="Left"
                                   IsHitTestVisible="False" Opacity="0">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="Transparent" Offset="0"/>
                                    <GradientStop Color="{DynamicResource FxGlowColor}" Offset="0.5"/>
                                    <GradientStop Color="Transparent" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                            <Rectangle.RenderTransform>
                                <TransformGroup>
                                    <SkewTransform AngleX="-18"/>
                                    <TranslateTransform x:Name="WordmarkSheenSlide" X="-90"/>
                                </TransformGroup>
                            </Rectangle.RenderTransform>
                        </Rectangle>
                    </Grid>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- account chip -->
                        <Border x:Name="AccountChip" Background="{DynamicResource SurfaceBgBrush}"
                                BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1"
                                CornerRadius="18" Height="34" Padding="4,0,12,0" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="26" Height="26" CornerRadius="13"
                                        Background="{DynamicResource AccentGradientBrush}">
                                    <TextBlock x:Name="AvatarInitial" Text="-" Foreground="White"
                                               FontFamily="/Fonts/#Fredoka, Segoe UI" FontSize="13" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="AccountName" Text="-" Margin="8,0,0,0" FontSize="13"
                                           Foreground="{DynamicResource TextLightBrush}" VerticalAlignment="Center"
                                           MaxWidth="180" TextTrimming="CharacterEllipsis"/>
                                <Image x:Name="TierBadge" Height="18" Margin="6,0,0,0" Visibility="Collapsed"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                <!-- Sparkle Points, counted up by the odometer on every show. -->
                                <StackPanel x:Name="SpChip" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                                    <Border Width="1" Height="14" Margin="10,0,8,0" Background="{DynamicResource GlassBorderBrush}"/>
                                    <TextBlock Text="&#x25C6;" FontSize="10" Foreground="{DynamicResource PanelAccentBrush}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="SpReadout" Text="0" Margin="5,0,0,0" FontSize="13" FontWeight="SemiBold"
                                               FontFamily="/Fonts/#Fredoka, Segoe UI" Foreground="{DynamicResource TextLightBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Button x:Name="BtnGear" Content="⚙" Style="{StaticResource LauncherIconButton}"
                                Click="BtnGear_Click" Margin="0,0,8,0"/>
                        <Button x:Name="BtnMinimize" Content="─" Width="46" Height="36"
                                Click="BtnMinimize_Click" Style="{StaticResource WindowControlButton}"/>
                        <Button x:Name="BtnClose" Content="✕" Width="46" Height="36"
                                Click="BtnClose_Click" Style="{StaticResource WindowCloseButton}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ================= body ================= -->
            <Grid Grid.Row="1" Margin="28,14,28,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="440"/>
                    <ColumnDefinition Width="28"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- the panel card -->
                <Border x:Name="PanelCard" Background="{DynamicResource SurfaceBgBrush}"
                        BorderBrush="{DynamicResource PanelAccentBrush}" BorderThickness="1"
                        CornerRadius="20" Padding="32,30" VerticalAlignment="Stretch">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <!-- The emblem, barely there, tucked into the card's lower corner. -->
                        <Image Grid.RowSpan="3" Source="pack://application:,,,/Resources/logo2.png" Opacity="0.06"
                               Width="250" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                               Margin="0,0,-14,-12" IsHitTestVisible="False"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <StackPanel>
                            <TextBlock x:Name="PanelEyebrow" Text="{loc:Str launcher_section_panel}" Style="{StaticResource LauncherEyebrow}"/>
                            <TextBlock Text="{loc:Str launcher_panel_title}" Margin="0,10,0,0" TextWrapping="Wrap"
                                       FontFamily="/Fonts/#Fredoka, Segoe UI" FontSize="34" FontWeight="SemiBold"
                                       LineHeight="38" Foreground="{DynamicResource TextLightBrush}"/>
                            <TextBlock Text="{loc:Str launcher_panel_blurb}" Margin="0,14,0,0" TextWrapping="Wrap"
                                       FontSize="14" LineHeight="21" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                                <Ellipse x:Name="RunningDot" Width="8" Height="8" Fill="#4CAF50" Opacity="0.35"
                                         VerticalAlignment="Center"/>
                                <TextBlock x:Name="StatusText" Text="{loc:Str launcher_panel_idle}" Margin="10,0,0,0"
                                           FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <Button x:Name="StopLink" Content="{loc:Str launcher_panel_stop}" Style="{StaticResource LauncherLink}"
                                        Margin="6,0,0,0" Visibility="Collapsed" Click="StopLink_Click"/>
                            </StackPanel>
                        </StackPanel>
                        <!-- Three live numbers and a slim XP bar: what the panel is worth to you
                             today, read from the same settings the panel's own chips use. -->
                        <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,18,0,18">
                            <UniformGrid Columns="3">
                                <StackPanel>
                                    <TextBlock x:Name="StatLevel" Text="1" Style="{StaticResource LauncherStatNumber}"/>
                                    <TextBlock Text="{loc:Str launcher_stat_level}" Style="{StaticResource LauncherEyebrow}" Margin="1,2,0,0"/>
                                </StackPanel>
                                <StackPanel Margin="12,0,0,0">
                                    <TextBlock x:Name="StatSparkles" Text="0" Style="{StaticResource LauncherStatNumber}"/>
                                    <TextBlock Text="{loc:Str launcher_stat_sparkles}" Style="{StaticResource LauncherEyebrow}" Margin="1,2,0,0"/>
                                </StackPanel>
                                <StackPanel Margin="12,0,0,0">
                                    <TextBlock x:Name="StatTime" Text="0m" Style="{StaticResource LauncherStatNumber}"/>
                                    <TextBlock Text="{loc:Str launcher_stat_time}" Style="{StaticResource LauncherEyebrow}" Margin="1,2,0,0"/>
                                </StackPanel>
                            </UniformGrid>
                            <Border x:Name="XpTrack" Height="6" CornerRadius="3" Margin="0,22,0,0"
                                    Background="{DynamicResource GlassBorderBrush}">
                                <Border x:Name="XpFill" Width="0" HorizontalAlignment="Left" CornerRadius="3"
                                        Background="{DynamicResource AccentGradientBrush}"/>
                            </Border>
                            <TextBlock x:Name="XpCaption" Text="" Margin="0,8,0,0" FontSize="11" HorizontalAlignment="Right"
                                       Foreground="{DynamicResource TextMutedBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2">
                            <Button x:Name="PanelCta" Content="{loc:Str launcher_panel_launch}" Style="{StaticResource LauncherCta}"
                                    Click="PanelCta_Click" PreviewMouseLeftButtonDown="Press_Down" PreviewMouseLeftButtonUp="Press_Up"/>
                            <Button x:Name="ShortcutLink" Content="{loc:Str launcher_add_shortcut}" Style="{StaticResource LauncherLink}"
                                    HorizontalAlignment="Center" Margin="0,12,0,0" Click="ShortcutLink_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- the games -->
                <Grid x:Name="GamesColumn" Grid.Column="2" ClipToBounds="True">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="GamesEyebrow" Text="{loc:Str launcher_section_games}" Style="{StaticResource LauncherEyebrow}" Margin="9,0,0,4"/>
                    <!-- The croupier Emi from the prize counter, peeking in under the tiles (the
                         column clips her). Body, then the waving arm, then the face: the same three
                         layers as SparkleWallet, in the same order. Behind the grid in z, so a full
                         third row of tiles simply covers her. -->
                    <Viewbox x:Name="Mascot" Grid.Row="1" Height="180" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                             Margin="0,0,14,-52" IsHitTestVisible="False" Opacity="0.96">
                        <Viewbox.RenderTransform>
                            <TransformGroup>
                                <TranslateTransform x:Name="MascotSlide"/>
                                <TranslateTransform x:Name="MascotShift"/>
                            </TransformGroup>
                        </Viewbox.RenderTransform>
                        <Grid Width="954" Height="995">
                            <Image Source="pack://application:,,,/Resources/emi/wallet_croupier_body.png"
                                   Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <Image Source="pack://application:,,,/Resources/emi/wallet_croupier_arm.png"
                                   Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"
                                   RenderTransformOrigin="0.848,0.676">
                                <Image.RenderTransform><RotateTransform x:Name="MascotArmTurn"/></Image.RenderTransform>
                            </Image>
                            <emi:EmiFace x:Name="MascotFace" HorizontalAlignment="Left" VerticalAlignment="Top"
                                         Margin="320,297,0,0" Width="389" Height="349"/>
                        </Grid>
                    </Viewbox>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  PanningMode="VerticalOnly">
                        <UniformGrid x:Name="GamesGrid" Columns="2" VerticalAlignment="Top"/>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- ================= bottom row ================= -->
            <Border Grid.Row="2" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="0,1,0,0"
                    Margin="28,0,28,0" Padding="0,0,0,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <Button Content="{loc:Str launcher_link_account}" Style="{StaticResource LauncherLink}" Tag="settings" Click="PanelLink_Click"/>
                        <Button Content="{loc:Str launcher_link_mods}" Style="{StaticResource LauncherLink}" Tag="exclusives" Click="PanelLink_Click" Margin="14,0,0,0"/>
                        <Button Content="{loc:Str launcher_link_library}" Style="{StaticResource LauncherLink}" Tag="assets" Click="PanelLink_Click" Margin="14,0,0,0"/>
                        <Button Content="{loc:Str launcher_link_whats_new}" Style="{StaticResource LauncherLink}" Click="WhatsNew_Click" Margin="14,0,0,0"/>
                    </StackPanel>
                    <CheckBox x:Name="SkipToPanel" Content="{loc:Str launcher_skip_to_panel}" HorizontalAlignment="Right"
                              VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                              IsChecked="{Binding LauncherSkipToPanel, Mode=TwoWay}" Click="SkipToPanel_Click"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Event layers over the content, under the veil: the shockwave rings, the cursor's
             sparkle trail (a handful of ellipses and the odd star, not a sim) and the burst canvas
             every Play and the CTA fire into. -->
        <Canvas x:Name="ShockwaveCanvas" IsHitTestVisible="False" ClipToBounds="True"/>
        <Canvas x:Name="TrailCanvas" IsHitTestVisible="False"/>
        <fx:AmbientFxCanvas x:Name="BurstLayer" IsHitTestVisible="False"/>

        <!-- Lockdown veil: the launcher waits, it never argues. The vignette breathes red. -->
        <Border x:Name="LockdownVeil" Background="#D9070310" Visibility="Collapsed">
            <Grid>
                <Border x:Name="LockdownVignette" IsHitTestVisible="False"/>
                <TextBlock x:Name="LockdownText" Text="{loc:Str launcher_lockdown_veil}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontFamily="/Fonts/#Fredoka, Segoe UI" FontSize="22" Foreground="{DynamicResource TextLightBrush}"
                           TextWrapping="Wrap" MaxWidth="520" TextAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
