<Window x:Class="ConditioningControlPanel.Launcher.LauncherMediaDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ConditioningControlPanel.Localization"
        Title="{loc:Str launcher_media_title}"
        Width="560" Height="720"
        Background="{DynamicResource DarkerBgBrush}"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        FontFamily="Segoe UI">

    <!-- "Media and sound": the launcher's gear. One source, one niche list, every room follows,
         and the app-wide master volume. Same shell as the launcher: no OS chrome, our own close
         button, never AllowsTransparency. -->

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- A selectable chip. Sized for the dialog's 14px copy; the panel's filter chip is 11px. -->
        <Style x:Key="MediaChip" TargetType="ToggleButton">
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource TextLightBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#1AFFFFFF"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Chip" CornerRadius="15" Padding="14,6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource ElevatedSurfaceBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="#335EC8F2"/>
                                <Setter TargetName="Chip" Property="BorderBrush" Value="#5EC8F2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MediaEyebrow" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="MediaCopy" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- title bar: drag handle and the close button -->
            <Border x:Name="TitleBar" Grid.Row="0" Background="Transparent"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <TextBlock Text="{loc:Str launcher_media_title}" Margin="20,0,0,0"
                               FontFamily="/Fonts/#Fredoka, Segoe UI" FontSize="18" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextLightBrush}" VerticalAlignment="Center"/>
                    <Button x:Name="BtnClose" Content="✕" Width="46" Height="36" HorizontalAlignment="Right"
                            Click="BtnClose_Click" Style="{StaticResource WindowCloseButton}"/>
                </Grid>
            </Border>

            <!-- the card -->
            <Border Grid.Row="1" Background="{DynamicResource SurfaceBgBrush}" CornerRadius="14"
                    Margin="20,4,20,0" Padding="22,20">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="{loc:Str launcher_media_blurb}" Style="{StaticResource MediaCopy}"/>

                        <TextBlock Text="{loc:Str launcher_media_source}" Style="{StaticResource MediaEyebrow}" Margin="0,22,0,10"/>
                        <WrapPanel x:Name="SourceChips"/>
                        <TextBlock x:Name="SourceHint" Style="{StaticResource MediaCopy}" FontSize="13" Margin="0,2,0,0"/>

                        <!-- mixed only: how much of the pool is online -->
                        <Grid x:Name="RatioRow" Margin="0,14,0,0" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="RatioSlider" Minimum="5" Maximum="95" TickFrequency="5" IsSnapToTickEnabled="True"
                                    VerticalAlignment="Center" ValueChanged="RatioSlider_Changed"/>
                            <TextBlock x:Name="RatioLabel" Grid.Column="1" Margin="14,0,0,0" MinWidth="90"
                                       Style="{StaticResource MediaCopy}" FontSize="13" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- which niches: always live, so the list can be set before going online -->
                        <StackPanel x:Name="NicheBlock" Margin="0,22,0,0">
                            <TextBlock Text="{loc:Str launcher_media_niches}" Style="{StaticResource MediaEyebrow}" Margin="0,0,0,10"/>
                            <WrapPanel x:Name="NicheChips"/>
                            <TextBlock Text="{loc:Str launcher_media_niches_hint}" Style="{StaticResource MediaCopy}" FontSize="13" Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- sound: the app-wide master volume, every game included -->
                        <TextBlock Text="{loc:Str launcher_media_sound}" Style="{StaticResource MediaEyebrow}" Margin="0,22,0,10"/>
                        <TextBlock Text="{loc:Str launcher_media_master}" Style="{StaticResource MediaCopy}" FontSize="13"/>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="MasterSlider" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                                    VerticalAlignment="Center" ValueChanged="MasterSlider_Changed"
                                    PreviewMouseLeftButtonUp="MasterSlider_Released"/>
                            <TextBlock x:Name="MasterLabel" Grid.Column="1" Margin="14,0,0,0" MinWidth="48"
                                       Style="{StaticResource MediaCopy}" FontSize="13" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="{loc:Str launcher_media_master_hint}" Style="{StaticResource MediaCopy}" FontSize="13" Margin="0,2,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- footnote and Done -->
            <Grid Grid.Row="2" Margin="20,14,20,18">
                <TextBlock Text="{loc:Str launcher_media_footnote}" Style="{StaticResource MediaCopy}" FontSize="12"
                           Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="4,0,120,0"/>
                <Button x:Name="BtnDone" Content="{loc:Str launcher_media_done}" Click="BtnDone_Click"
                        HorizontalAlignment="Right" Width="104" Height="38" FontSize="14" FontWeight="SemiBold"
                        Foreground="White" Background="{DynamicResource AccentGradientBrush}"
                        BorderThickness="0" Cursor="Hand" FocusVisualStyle="{x:Null}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Opacity" Value="0.92"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
