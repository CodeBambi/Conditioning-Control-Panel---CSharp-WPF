<UserControl x:Class="ConditioningControlPanel.Features.SplitFeatureCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Cursor="Hand"
             MouseLeftButtonUp="OnLeftClick"
             MouseRightButtonUp="OnRightClick"
             MouseMove="OnHalfHoverMove">

    <!-- ==================================================================
         DIAGONAL SPLIT TILE (owner design, 2026-08-11): one mosaic cell,
         TWO features. Half A owns the TOP-LEFT triangle, half B the
         BOTTOM-RIGHT, split on the "/" diagonal (bottom-left to top-right).

         Chrome deliberately clones Features/FeatureCard.xaml - RootBorder
         register, FxGlow-driven active ring + breath, hover lift + rim -
         so a split cell reads as a sibling of the single cells, not a
         different species. The triangle Clip geometries CANNOT live in
         markup: they depend on ActualWidth/Height and are rebuilt in
         code on SizeChanged.

         Per-half hit-testing is positional (x/W + y/H vs the seam's
         CURRENT position), so there are no per-half input elements and the
         whole card stays one hit surface - same reason FeatureCard keeps
         one handler for the help-button carve-out.

         HOVER FILL (owner, 2026-08-13): hovering a half sweeps the seam
         across the card until that half owns nearly the whole square and
         its title is the only label left; leaving sweeps it back. One
         number drives it (SplitProgress in the code-behind) - clips,
         washes, seam, rings and the hit test are all functions of it, so
         the half genuinely FILLS rather than two stacked layers
         cross-fading.

         CORNER PEEK (Rosalyn, 2026-08-18): the fill used to run the seam
         clean off the card, which left the other half with nothing on
         screen - you had to leave the tile entirely and come back in
         through the other side, and new users never learned the other
         half was there at all. The fill now stops a fixed fraction short
         (SplitPeekFraction), so the opposing half keeps a dog-eared
         corner wedge: its own art, its active ring if it is on, and a
         hit region, all still there. Because the hit test is a function
         of the same seam parameter, that wedge is genuinely clickable -
         left-click opens the other half, right-click toggles it, and
         moving onto it flips the fill the other way without leaving the
         card. Nothing about the RESTING tile changes: every piece of the
         peek chrome below is at zero until the fill starts running. -->

    <Border x:Name="RootBorder"
            Background="{DynamicResource ElevatedSurfaceBrush}"
            BorderBrush="{DynamicResource GlassBorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            ClipToBounds="True"
            Margin="6"
            RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1"/>
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect x:Name="ActiveGlow"
                              Color="{DynamicResource FxGlowColor}"
                              BlurRadius="18"
                              ShadowDepth="0"
                              Opacity="0"/>
        </Border.Effect>

        <Grid x:Name="ContentRoot" SizeChanged="OnContentSizeChanged">
            <!-- The two art halves. Full-bleed brushes, triangle-clipped in code. -->
            <Border x:Name="HalfHostA" CornerRadius="11"
                    RenderOptions.BitmapScalingMode="HighQuality"/>
            <Border x:Name="HalfHostB" CornerRadius="11"
                    RenderOptions.BitmapScalingMode="HighQuality"/>

            <!-- Per-half hover wash: opacity flips on MouseMove, and the geometry rides
                 the same seam parameter as the clips, so the wash fills with its half. -->
            <Path x:Name="HoverWashA" Fill="#14FFFFFF" Opacity="0" IsHitTestVisible="False"/>
            <Path x:Name="HoverWashB" Fill="#14FFFFFF" Opacity="0" IsHitTestVisible="False"/>

            <!-- Peek scrim: the half that is NOT filling gets its surviving corner
                 wedge darkened as the fill runs, so the filled half reads as a card
                 laid ON TOP and the wedge as the one underneath. That depth cue is
                 what makes the wedge read as "the other choice, still here" rather
                 than as a stray sliver of art. Both sit at Opacity 0 at rest and the
                 code only ever raises the one belonging to the receding half. -->
            <Path x:Name="PeekScrimA" Fill="Black" Opacity="0" IsHitTestVisible="False"/>
            <Path x:Name="PeekScrimB" Fill="Black" Opacity="0" IsHitTestVisible="False"/>

            <!-- The seam. Drawn over the art so the split is legible even when the
                 two artworks share a palette - and over the scrim, because while a
                 half is filled the seam IS the answer to "which half will this click
                 hit". Stroke is the FULL-fill white; the code-behind parks its Opacity
                 at SeamRestOpacity so the resting seam still renders as the ~#66 hair
                 line it always was, then brightens and thickens it as the fill runs.
                 Opacity rather than a swapped brush: no per-frame allocation. -->
            <Path x:Name="SeamLine" Stroke="#B3FFFFFF" StrokeThickness="1.2"
                  Opacity="0.6" IsHitTestVisible="False"/>

            <!-- Per-half active rings: triangle outlines in the mod glow colour,
                 the split card's equivalent of FeatureCard's ActiveBorder. -->
            <Path x:Name="ActiveRingA" Stroke="{DynamicResource FxGlowBrush}"
                  StrokeThickness="3" Fill="#12FF69B4"
                  Visibility="Collapsed" IsHitTestVisible="False"/>
            <Path x:Name="ActiveRingB" Stroke="{DynamicResource FxGlowBrush}"
                  StrokeThickness="3" Fill="#12FF69B4"
                  Visibility="Collapsed" IsHitTestVisible="False"/>

            <!-- Half titles: A pinned to its top-left corner, B to its bottom-right,
                 each on a dark pill so they survive busy art.

                 TextTrimming, not TextWrapping: a pill in a triangle's corner has one line
                 of room, and the longer localised titles (fr/de/ru run half again as long
                 as en) were running into the root border's ClipToBounds and being cut
                 mid-glyph with nothing to say they had been. An ellipsis at least admits
                 it. No ToolTip to carry the full string: both pills are
                 IsHitTestVisible="False" so the whole card stays ONE hit surface for the
                 positional per-half test, and a tooltip on an unhittable element never
                 opens.

                 Each pill render-scales up when its half fills the card, anchored to its
                 own corner (RenderTransformOrigin 0,0 / 1,1) so it grows into the tile
                 instead of sliding across it. A render scale is measured at 1.0, so the
                 code-behind caps the TextBlock's MaxWidth while grown - otherwise the
                 long localised titles would grow straight under ClipToBounds. -->

            <Border x:Name="TitlePillA"
                    HorizontalAlignment="Left" VerticalAlignment="Top"
                    Margin="8,8,0,0" CornerRadius="7" Background="#B01A1A2E"
                    Padding="7,2,8,3" IsHitTestVisible="False"
                    RenderTransformOrigin="0,0">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="TitleScaleA" ScaleX="1" ScaleY="1"/>
                </Border.RenderTransform>
                <TextBlock x:Name="TxtTitleA" Text="A" Foreground="White"
                           TextTrimming="CharacterEllipsis"
                           FontSize="11" FontWeight="SemiBold"/>
            </Border>
            <Border x:Name="TitlePillB"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0,0,8,8" CornerRadius="7" Background="#B01A1A2E"
                    Padding="7,2,8,3" IsHitTestVisible="False"
                    RenderTransformOrigin="1,1">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="TitleScaleB" ScaleX="1" ScaleY="1"/>
                </Border.RenderTransform>
                <TextBlock x:Name="TxtTitleB" Text="B" Foreground="White"
                           TextTrimming="CharacterEllipsis"
                           FontSize="11" FontWeight="SemiBold"/>
            </Border>

            <!-- Hover rim-light, same register as FeatureCard's. -->
            <Border x:Name="RimLight"
                    BorderBrush="{DynamicResource FxGlowBrush}"
                    BorderThickness="1.5"
                    CornerRadius="12"
                    IsHitTestVisible="False"
                    Opacity="0"/>
        </Grid>
    </Border>
</UserControl>
