<UserControl x:Class="ConditioningControlPanel.Features.VideoFeatureControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:ConditioningControlPanel.Localization"
             xmlns:helpers="clr-namespace:ConditioningControlPanel.Helpers"
             xmlns:feat="clr-namespace:ConditioningControlPanel.Features">

    <StackPanel>
        <!-- Master enable -->
        <Border Background="{DynamicResource SurfaceBgBrush}"
                BorderBrush="{DynamicResource GlassBorderBrush}"
                BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{loc:Str btn_enable}" Foreground="White" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock Text="{loc:Str tooltip_turn_mandatory_videos_on_or_off}"
                               Foreground="{DynamicResource TextMutedBrush}" FontSize="11"
                               TextWrapping="Wrap" Margin="0,2,0,0"/>
                </StackPanel>
                <CheckBox Grid.Column="1" x:Name="ChkEnable" feat:SessionLock.Owned="True"
                          Style="{StaticResource ToggleStyle}" VerticalAlignment="Center"
                          Checked="ChkEnable_Changed" Unchecked="ChkEnable_Changed"/>
            </Grid>
        </Border>

        <!-- Per hour -->
        <Border Background="{DynamicResource SurfaceBgBrush}"
                BorderBrush="{DynamicResource GlassBorderBrush}"
                BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,0,0,10">
            <StackPanel>
                <Grid Margin="0,0,0,6">
                    <TextBlock Text="{loc:Str setting_per_hour}" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TxtPerHour" Text="2" HorizontalAlignment="Right"
                               Foreground="{DynamicResource PinkBrush}" FontSize="13" FontWeight="SemiBold"/>
                </Grid>
                <Slider x:Name="SliderPerHour" Minimum="1" Maximum="20" Value="2" feat:SessionLock.Owned="True"
                        ValueChanged="SliderPerHour_Changed"/>
                <TextBlock Text="{loc:Str tooltip_videos_per_hour}"
                           Foreground="{DynamicResource TextMutedBrush}" FontSize="10"
                           TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Strict lock -->
        <Border Background="{DynamicResource SurfaceBgBrush}"
                BorderBrush="{DynamicResource GlassBorderBrush}"
                BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <helpers:EmojiTextBlock Text="{loc:Str setting_strict}" Foreground="#FFB347" FontSize="13" FontWeight="SemiBold"/>
                    <TextBlock Text="{loc:Str tooltip_strict_mode_videos_cannot_be_skipped_must_wat}"
                               Foreground="{DynamicResource TextMutedBrush}" FontSize="11"
                               TextWrapping="Wrap" Margin="0,2,0,0"/>
                </StackPanel>
                <CheckBox Grid.Column="1" x:Name="ChkStrict"
                          Style="{StaticResource ToggleStyle}" VerticalAlignment="Center"
                          Checked="ChkStrict_Changed" Unchecked="ChkStrict_Changed"/>
            </Grid>
        </Border>

        <!-- Duration filter -->
        <Border Background="{DynamicResource SurfaceBgBrush}"
                BorderBrush="{DynamicResource GlassBorderBrush}"
                BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Duration filter" Foreground="White" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/>

                <Grid Margin="0,0,0,4">
                    <TextBlock Text="Min length" Foreground="White" FontSize="12"/>
                    <TextBlock x:Name="TxtVideoMinDur" Text="off" HorizontalAlignment="Right"
                               Foreground="{DynamicResource PinkBrush}" FontSize="12" FontWeight="SemiBold"/>
                </Grid>
                <!-- Owned despite being an asset-eligibility filter rather than a rate: total
                     exposure is rate x length, so clamping max length to 10s guts a locked
                     "2 videos per hour" prescription by ~90% without touching the locked rate.
                     That is the opt-out this lock exists to stop. -->
                <Slider x:Name="SliderVideoMinDur" Minimum="0" Maximum="600" Value="0"
                        feat:SessionLock.Owned="True"
                        ValueChanged="SliderVideoMinDur_Changed" Margin="0,0,0,10"/>

                <Grid Margin="0,0,0,4">
                    <TextBlock Text="Max length" Foreground="White" FontSize="12"/>
                    <TextBlock x:Name="TxtVideoMaxDur" Text="off" HorizontalAlignment="Right"
                               Foreground="{DynamicResource PinkBrush}" FontSize="12" FontWeight="SemiBold"/>
                </Grid>
                <Slider x:Name="SliderVideoMaxDur" Minimum="0" Maximum="1800" Value="0"
                        feat:SessionLock.Owned="True"
                        ValueChanged="SliderVideoMaxDur_Changed" Margin="0,0,0,4"/>

                <TextBlock Text="Filter videos by length. 0 = no limit."
                           Foreground="{DynamicResource TextMutedBrush}" FontSize="10"
                           TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Mini game subsection -->
        <Border Background="{DynamicResource SurfaceBgBrush}"
                BorderBrush="{DynamicResource GlassBorderBrush}"
                BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,0,0,10">
            <StackPanel>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <helpers:EmojiTextBlock Text="{loc:Str label_mini_game}" Foreground="{DynamicResource PinkBrush}" FontSize="14" FontWeight="Bold"/>
                        <TextBlock Text="{loc:Str tooltip_enable_attention_check_targets}"
                                   Foreground="{DynamicResource TextMutedBrush}" FontSize="11"
                                   TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                    <CheckBox Grid.Column="1" x:Name="ChkMiniGame" Style="{StaticResource ToggleStyle}"
                              feat:SessionLock.Owned="True"
                              HorizontalAlignment="Right" VerticalAlignment="Center"
                              ToolTip="{loc:Str tooltip_enable_attention_check_targets}"
                              Checked="ChkMiniGame_Changed" Unchecked="ChkMiniGame_Changed"/>
                </Grid>

                <!-- Targets -->
                <Grid Margin="0,0,0,8" ToolTip="{loc:Str tooltip_number_of_targets_to_click_per_video}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock Text="{loc:Str label_targets}" Foreground="White" FontSize="12"/>
                        <CheckBox x:Name="ChkRandomize" Margin="8,0,0,0" VerticalAlignment="Center" feat:SessionLock.Owned="True"
                                  Checked="ChkRandomize_Changed" Unchecked="ChkRandomize_Changed"
                                  ToolTip="{loc:Str tooltip_randomize_target_count_1_to_max}">
                            <Image Width="12" Height="12"
                                   Source="{Binding Source='🎲', Converter={StaticResource EmojiToImageSource}}"/>
                        </CheckBox>
                    </StackPanel>
                    <TextBlock x:Name="TxtTargets" Grid.Column="1" Text="3"
                               Foreground="{DynamicResource PinkBrush}" FontSize="12" FontWeight="SemiBold"/>
                </Grid>
                <Slider x:Name="SliderTargets" Minimum="1" Maximum="10" Value="3"
                        feat:SessionLock.Owned="True"
                        ToolTip="{loc:Str tooltip_number_of_targets_to_click_per_video}"
                        ValueChanged="SliderTargets_Changed" Margin="0,0,0,10"/>

                <!-- Duration -->
                <Grid Margin="0,0,0,2" ToolTip="{loc:Str tooltip_seconds_each_target_stays_visible}">
                    <TextBlock Text="{loc:Str setting_duration}" Foreground="White" FontSize="12"/>
                    <TextBlock x:Name="TxtDuration" Text="5" HorizontalAlignment="Right"
                               Foreground="{DynamicResource PinkBrush}" FontSize="12" FontWeight="SemiBold"/>
                </Grid>
                <Slider x:Name="SliderDuration" Minimum="1" Maximum="15" Value="5"
                        feat:SessionLock.Owned="True"
                        ToolTip="{loc:Str tooltip_seconds_each_target_stays_visible}"
                        ValueChanged="SliderDuration_Changed" Margin="0,0,0,10"/>

                <!-- Target size -->
                <Grid Margin="0,0,0,2" ToolTip="{loc:Str tooltip_target_button_size_in_pixels}">
                    <TextBlock Text="{loc:Str setting_size}" Foreground="White" FontSize="12"/>
                    <TextBlock x:Name="TxtTargetSize" Text="70" HorizontalAlignment="Right"
                               Foreground="{DynamicResource PinkBrush}" FontSize="12" FontWeight="SemiBold"/>
                </Grid>
                <Slider x:Name="SliderTargetSize" Minimum="30" Maximum="150" Value="70"
                        feat:SessionLock.Owned="True"
                        ToolTip="{loc:Str tooltip_target_button_size_in_pixels}"
                        ValueChanged="SliderTargetSize_Changed" Margin="0,0,0,12"/>

                <!-- Phase 3 placeholder copy — voice-pass at ship. -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Stare to click" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock Text="Look at a target for ~1s instead of clicking. Same hit, same reward."
                                   Foreground="{DynamicResource TextMutedBrush}" FontSize="10"
                                   TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                    <CheckBox Grid.Column="1" x:Name="ChkVideoGazeClick"
                              Style="{StaticResource ToggleStyle}" VerticalAlignment="Center"
                              Checked="ChkVideoGazeClick_Changed" Unchecked="ChkVideoGazeClick_Changed"/>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="{loc:Str btn_phrases}"
                            ToolTip="{loc:Str tooltip_edit_attention_check_phrases}"
                            Style="{DynamicResource OutlineButton}" Click="BtnManageAttention_Click"/>
                    <Button Grid.Column="2" Content="{loc:Str btn_style}"
                            ToolTip="{loc:Str tooltip_customize_target_appearance_colors_border_fon}"
                            Style="{DynamicResource OutlineButton}" Click="BtnAttentionStyle_Click"/>
                </Grid>
            </StackPanel>
        </Border>

        <Button Content="{loc:Str btn_test_2}" Style="{DynamicResource OutlineButton}"
                Click="BtnTestVideo_Click"/>
    </StackPanel>
</UserControl>
