<UserControl x:Class="ConditioningControlPanel.Features.PinkFilterFeatureControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:ConditioningControlPanel.Localization"
             xmlns:feat="clr-namespace:ConditioningControlPanel.Features">

    <Grid>
        <StackPanel>
            <Border Background="{DynamicResource SurfaceBgBrush}"
                    BorderBrush="{DynamicResource GlassBorderBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{loc:Str btn_enable}" Foreground="White" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:Str tooltip_apply_pink_color_filter_to_all_monitors}"
                                   Foreground="{DynamicResource TextMutedBrush}" FontSize="11"
                                   TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                    <CheckBox Grid.Column="1" x:Name="ChkEnable"
                              feat:SessionLock.Owned="True"
                              Style="{StaticResource ToggleStyle}" VerticalAlignment="Center"
                              Checked="ChkEnable_Changed" Unchecked="ChkEnable_Changed"/>
                </Grid>
            </Border>

            <Border Background="{DynamicResource SurfaceBgBrush}"
                    BorderBrush="{DynamicResource GlassBorderBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="16,14">
                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <TextBlock Text="{loc:Str setting_opacity}" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtOpacity" Text="10%" HorizontalAlignment="Right"
                                   Foreground="{DynamicResource PinkBrush}" FontSize="13" FontWeight="SemiBold"/>
                    </Grid>
                    <Slider x:Name="SliderOpacity" Minimum="5" Maximum="50" Value="10"
                            feat:SessionLock.Owned="True"
                            ValueChanged="SliderOpacity_Changed"/>
                    <TextBlock Text="{loc:Str tooltip_filter_opacity_5_50}"
                               Foreground="{DynamicResource TextMutedBrush}" FontSize="10"
                               TextWrapping="Wrap" Margin="0,4,0,0"/>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Str setting_filter_color}" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:Str tooltip_pink_filter_color}"
                                       Foreground="{DynamicResource TextMutedBrush}" FontSize="10"
                                       TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="ColorSwatch" Width="30" Height="30" CornerRadius="6"
                                    BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1"
                                    Background="#FF69B4" Margin="0,0,8,0"/>
                            <Button x:Name="BtnChooseColor" Content="{loc:Str btn_choose_color}"
                                    Style="{StaticResource SmallPinkButton}" Click="BtnChooseColor_Click"/>
                            <Button x:Name="BtnResetColor" Content="{loc:Str btn_reset}"
                                    Style="{StaticResource SmallPinkButton}" Click="BtnResetColor_Click"
                                    Margin="6,0,0,0"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Display monitor picker (#639): per-effect screen target -->
            <Border Background="{DynamicResource SurfaceBgBrush}"
                    BorderBrush="{DynamicResource GlassBorderBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,10,0,0">
                <StackPanel>
                    <TextBlock Text="{loc:Str setting_effect_monitor}" Foreground="White"
                               FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <ComboBox x:Name="CmbMonitor"
                              Style="{DynamicResource DarkComboBoxStyle}"
                              DropDownOpened="CmbMonitor_DropDownOpened"
                              SelectionChanged="CmbMonitor_Changed"/>
                    <TextBlock Text="{loc:Str tooltip_effect_monitor}"
                               Foreground="{DynamicResource TextMutedBrush}" FontSize="10"
                               TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
