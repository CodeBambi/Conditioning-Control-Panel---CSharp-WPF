<UserControl x:Class="ConditioningControlPanel.Features.FeatureCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Cursor="Hand"
             MouseLeftButtonUp="OnClick"
             MouseRightButtonUp="OnRightClick">

    <Border x:Name="RootBorder"
            Background="{DynamicResource ElevatedSurfaceBrush}"
            BorderBrush="{DynamicResource GlassBorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            ClipToBounds="True"
            Margin="6"
            RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1"/>
        </Border.RenderTransform>
        <!-- The card's glow. Colour comes from FxTheme (FxGlowColor is rewritten on every mod
             switch) rather than PinkColor, so an active tile is the mod's colour, not Bambi's.
             Opacity is driven entirely from code (ApplyActiveState / StartActiveBreath): the
             active state is a slow 3.5s breath at MotionLevel.Full and a static hold otherwise. -->
        <Border.Effect>
            <DropShadowEffect x:Name="ActiveGlow"
                              Color="{DynamicResource FxGlowColor}"
                              BlurRadius="18"
                              ShadowDepth="0"
                              Opacity="0"/>
        </Border.Effect>
        <!-- Hover motion used to be two EventTrigger storyboards here. It moved to code-behind
             (OnCardMouseEnter / MotionFx.HoverLift) so it honours the reduced-motion setting -
             a XAML EventTrigger has no way to ask. -->

        <Grid x:Name="ContentRoot">
            <!-- Full-bleed background image via ImageBrush (respects parent CornerRadius) -->
            <Border x:Name="ImgIconHost" CornerRadius="11"
                    RenderOptions.BitmapScalingMode="HighQuality"/>

            <!-- Glyph fallback (for cards without an image) -->
            <Border x:Name="GlyphHost"
                    Width="68" Height="68"
                    CornerRadius="34"
                    Background="{DynamicResource TransparentPinkBrush}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="Collapsed">
                <TextBlock x:Name="TxtGlyph"
                           FontSize="32"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource PinkBrush}"/>
            </Border>

            <!-- Bottom gradient + title overlay -->
            <Border CornerRadius="0,0,11,11"
                    VerticalAlignment="Bottom"
                    IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="Transparent" Offset="0"/>
                        <GradientStop Color="#60000000" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <TextBlock x:Name="TxtTitle"
                           Text="Feature"
                           Margin="8,14,8,8"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Foreground="White"
                           FontSize="12"
                           FontWeight="SemiBold"/>
            </Border>

            <!-- Hover rim-light. A separate 1.5px ring rather than a brush swap on RootBorder:
                 the root border brush is a DynamicResource and animating it would mean cloning
                 the brush per card. Opacity-only, 150ms, driven from code-behind. -->
            <Border x:Name="RimLight"
                    BorderBrush="{DynamicResource FxGlowBrush}"
                    BorderThickness="1.5"
                    CornerRadius="12"
                    IsHitTestVisible="False"
                    Opacity="0"/>

            <!-- Active overlay: mod-tinted ring when the underlying feature is enabled.
                 Thicker stroke makes the "on" state read at a glance; right-click
                 a card to toggle the feature on/off. The ring BREATHES with the glow
                 (opacity 0.55 to 1.0, 3.5s) instead of sitting at a flat 3.5px stroke -
                 the stroke width is unchanged, so peak weight is exactly what shipped. -->
            <Border x:Name="ActiveBorder"
                    BorderBrush="{DynamicResource FxGlowBrush}"
                    BorderThickness="3.5"
                    CornerRadius="12"
                    IsHitTestVisible="False"
                    Visibility="Collapsed"/>

            <!-- Locked overlay -->
            <Border x:Name="LockedOverlay"
                    Background="#C0000000"
                    CornerRadius="12"
                    Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Image Width="30" Height="30"
                           HorizontalAlignment="Center"
                           Source="{Binding Source='🔒', Converter={StaticResource EmojiToImageSource}}"/>
                    <TextBlock x:Name="TxtLockLabel"
                               Text="Lvl 10"
                               Margin="0,4,0,0"
                               HorizontalAlignment="Center"
                               Foreground="White"
                               FontSize="11"
                               FontWeight="SemiBold"/>
                </StackPanel>
            </Border>

            <!-- Tier badge (top-left). A price tag, NOT the LockedOverlay veil above.
                 The veil is right for an XP-gated card - there is nothing to sell, you
                 just have not levelled yet - but the mosaic's eight destination tiles are
                 advertisements as much as doors, and the Play door already settled this
                 argument for the whole app: dimming, never disabling, because "a dead ad
                 is a worse ad" (MainWindow.PlayTab.cs:107-108). So the art stays bright
                 and the badge names the price.

                 IsHitTestVisible=False on purpose, same as the Play door's lockbands: a
                 locked click still lands on the real handler, which is what raises the
                 TierGate "See tiers" toast. The badge is presentation; TierGate is
                 enforcement, and they read the same verdict.

                 Text only, no emoji: WPF cannot draw COLR/CPAL colour-emoji fonts, and
                 the app-wide workaround (EmojiToImageSource) would put a bitmap inside a
                 9px pill. "TIER 1" says it without one. -->
            <Border x:Name="TierBadgeHost"
                    HorizontalAlignment="Left" VerticalAlignment="Top"
                    Margin="8,8,0,0" Padding="6,2,7,3"
                    CornerRadius="7"
                    Background="#D91A1A2E"
                    BorderBrush="{DynamicResource PinkBrush}"
                    BorderThickness="1"
                    IsHitTestVisible="False"
                    Panel.ZIndex="11"
                    Visibility="Collapsed">
                <TextBlock x:Name="TxtTierBadge"
                           Text="TIER 1"
                           Foreground="{DynamicResource PinkBrush}"
                           FontSize="9"
                           FontWeight="Bold"/>
            </Border>

            <!-- Help icon overlay (top-right corner) -->
            <Button x:Name="BtnHelp"
                    Style="{DynamicResource HelpButtonStyle}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,8,8,0"
                    Panel.ZIndex="10"
                    Visibility="Collapsed"/>
        </Grid>
    </Border>
</UserControl>
