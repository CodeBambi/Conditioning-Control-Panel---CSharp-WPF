<UserControl x:Class="ConditioningControlPanel.Features.SystemFeatureControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:ConditioningControlPanel.Localization"
             xmlns:helpers="clr-namespace:ConditioningControlPanel.Helpers">

    <StackPanel>
        <!-- Toggle grid -->
        <Border Background="{DynamicResource SurfaceBgBrush}"
                BorderBrush="{DynamicResource GlassBorderBrush}"
                BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="0,0,0,10">
            <StackPanel>
                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{loc:Str setting_multi_mon}" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:Str tooltip_show_content_on_all_connected_monitors_2_3_or}"
                                   Foreground="{DynamicResource TextMutedBrush}" FontSize="11"
                                   TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                    <CheckBox Grid.Column="1" x:Name="ChkMultiMon"
                              Style="{StaticResource ToggleStyle}" VerticalAlignment="Center"
                              Checked="ChkMultiMon_Changed" Unchecked="ChkMultiMon_Changed"/>
                </Grid>
                <Grid Margin="16,4,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{loc:Str setting_fill_all_monitors_video}" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:Str tooltip_fill_all_monitors_video}"
                                   Foreground="{DynamicResource TextMutedBrush}" FontSize="11"
                                   TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                    <CheckBox Grid.Column="1" x:Name="ChkFillAllMon"
                              Style="{StaticResource ToggleStyle}" VerticalAlignment="Center"
                              Checked="ChkFillAllMon_Changed" Unchecked="ChkFillAllMon_Changed"/>
                </Grid>
                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Force video GPU decode" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Text="Play mandatory videos on the GPU. Off by default (software decode) to dodge a white-screen bug on some PCs. Turn ON if a video only plays on one of your screens, keeps swapping screens, or freezes when it starts."
                                   Foreground="{DynamicResource TextMutedBrush}" FontSize="11"
                                   TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                    <CheckBox Grid.Column="1" x:Name="ChkVideoGpuDecode"
                              Style="{StaticResource ToggleStyle}" VerticalAlignment="Center"
                              Checked="ChkVideoGpuDecode_Changed" Unchecked="ChkVideoGpuDecode_Changed"/>
                </Grid>
                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Blurred video background" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Text="Fill the empty bars around a video that doesn't fit the screen (e.g. a vertical clip on a widescreen monitor) with a blurred, zoomed copy of the video, like TikTok. Turn OFF for plain black bars."
                                   Foreground="{DynamicResource TextMutedBrush}" FontSize="11"
                                   TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                    <CheckBox Grid.Column="1" x:Name="ChkVideoBlurBg"
                              Style="{StaticResource ToggleStyle}" VerticalAlignment="Center"
                              Checked="ChkVideoBlurBg_Changed" Unchecked="ChkVideoBlurBg_Changed"/>
                </Grid>
                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{loc:Str setting_browser_video_engine}" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:Str tooltip_browser_video_engine}"
                                   Foreground="{DynamicResource TextMutedBrush}" FontSize="11"
                                   TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                    <CheckBox Grid.Column="1" x:Name="ChkBrowserVideoEngine"
                              Style="{StaticResource ToggleStyle}" VerticalAlignment="Center"
                              Checked="ChkBrowserVideoEngine_Changed" Unchecked="ChkBrowserVideoEngine_Changed"/>
                </Grid>
                <!-- Read-only since Phase 2 of the UX restructure. The startup group (launch with
                     Windows / video on launch / auto-start engine / start minimized) had two live
                     editors: this popup and the dashboard copy that MainWindow's LoadSettings,
                     SaveSettings, ChkWinStart_Click and RequestToggleWindowsStartup addressed by
                     name. Settings → General owns them now; this is a read-out that
                     LoadFromSettings keeps painted, plus a way to get there. -->
                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{loc:Str set2_general_startup_title}" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtStartupGroupState" Text=""
                                   Foreground="{DynamicResource TextMutedBrush}" FontSize="11"
                                   TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" x:Name="BtnOpenGeneralSettings"
                            Style="{DynamicResource OutlineButton}" Padding="10,5" FontSize="11"
                            VerticalAlignment="Center"
                            Content="{loc:Str set2_configure_in_settings}"
                            Click="BtnOpenGeneralSettings_Click"/>
                </Grid>
                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- Read-only since Phase 2 of the UX restructure. Settings → Devices owns the
                         panic key: there used to be two live toggles for PanicKeyEnabled (this one
                         and the dashboard's), and the double-confirm plus the keyboard-hook
                         start/stop had to be spelled twice to keep them honest. This is a mirror of
                         the current state now — LoadFromSettings still paints it, and the settings
                         PropertyChanged subscription still keeps it fresh while the popup is open. -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <helpers:EmojiTextBlock Text="{loc:Str setting_no_panic}" Foreground="#FF6B6B" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtNoPanicState"
                                   Text="{loc:Str set2_chip_off}"
                                   Foreground="{DynamicResource TextMutedBrush}" FontSize="11"
                                   TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" x:Name="BtnOpenDeviceSettingsNoPanic"
                            Style="{DynamicResource OutlineButton}" Padding="10,5" FontSize="11"
                            VerticalAlignment="Center"
                            Content="{loc:Str set2_configure_in_settings}"
                            Click="BtnOpenDeviceSettings_Click"/>
                </Grid>
                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- Read-only since Phase 2. Settings → Data owns OfflineMode: three MainWindow
                         methods drive that checkbox by name so the two-way sync (network
                         disconnect, login greying, banner) runs exactly once, and a second live
                         toggle here meant that flow was written twice. -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{loc:Str setting_offline_mode}" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtOfflineModeState" Text="{loc:Str set2_chip_off}"
                                   Foreground="{DynamicResource TextMutedBrush}" FontSize="11"
                                   TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" x:Name="BtnOpenDataSettings"
                            Style="{DynamicResource OutlineButton}" Padding="10,5" FontSize="11"
                            VerticalAlignment="Center"
                            Content="{loc:Str set2_configure_in_settings}"
                            Click="BtnOpenDataSettings_Click"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Startup video: read-only since Phase 2, picker lives in Settings → General. -->
        <Border Background="{DynamicResource SurfaceBgBrush}"
                BorderBrush="{DynamicResource GlassBorderBrush}"
                BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{loc:Str label_startup_video}" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TxtStartupVideo"
                               Text="{loc:Str label_random}"
                               Foreground="{DynamicResource PinkBrush}" FontSize="12"
                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" x:Name="BtnOpenGeneralSettingsVideo"
                        Style="{DynamicResource OutlineButton}" Padding="10,5" FontSize="11"
                        VerticalAlignment="Center"
                        Content="{loc:Str set2_configure_in_settings}"
                        Click="BtnOpenGeneralSettings_Click"/>
            </Grid>
        </Border>

        <!-- Assets folder -->
        <Border Background="{DynamicResource SurfaceBgBrush}"
                BorderBrush="{DynamicResource GlassBorderBrush}"
                BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="📁 Pick Folder"
                        Style="{DynamicResource OutlineButton}"
                        Click="BtnPickAssets_Click"
                        ToolTip="{loc:Str tooltip_set_custom_assets_folder}"/>
                <Button Grid.Column="2" Content="{loc:Str btn_assets}"
                        Style="{DynamicResource OutlineButton}"
                        Click="BtnOpenAssets_Click"
                        ToolTip="{loc:Str tooltip_open_assets_folder_images_videos_sounds}"/>
            </Grid>
        </Border>

        <!-- Panic key -->
        <Border Background="{DynamicResource SurfaceBgBrush}"
                BorderBrush="{DynamicResource GlassBorderBrush}"
                BorderThickness="1" CornerRadius="10" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- Read-only. The rebind lives in Settings → Devices (Phase 2): the capture ladder
                     itself was always MainWindow's, but two buttons drove it and each carried its
                     own "Press any key…" state machine. This one just shows the binding. -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <helpers:EmojiTextBlock Text="{loc:Str btn_escape}" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                    <TextBlock Text="{loc:Str set2_panic_change_in_settings}"
                               Foreground="{DynamicResource TextMutedBrush}" FontSize="11"
                               TextWrapping="Wrap" Margin="0,2,0,0"/>
                </StackPanel>
                <TextBlock Grid.Column="1" x:Name="TxtPanicKeyState" Text="🔑 —"
                           Foreground="{DynamicResource PinkBrush}" FontSize="13" FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
