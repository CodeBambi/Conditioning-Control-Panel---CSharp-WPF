<UserControl x:Class="ConditioningControlPanel.Features.SystemFeatureControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:ConditioningControlPanel.Localization"
             xmlns:helpers="clr-namespace:ConditioningControlPanel.Helpers">

    <!-- This control hangs off the Settings door, not the Studio rack, so it gets NO hero
         strip - just the dense row grammar. Every description that used to sit under a
         control is now that row's ToolTip; the read-out rows (startup group, no-panic,
         offline mode, startup video, panic key) keep their state TextBlocks VISIBLE because
         code-behind writes the current value into them - that text IS the row's value. -->
    <StackPanel>

        <Border Style="{StaticResource SettingCardStyle}">
            <Grid>
                <Border Background="{StaticResource SectionHueStudioWashBrush}" CornerRadius="11"/>
                <Border Width="3" HorizontalAlignment="Left" Margin="0,10" CornerRadius="0,2,2,0"
                        Background="{StaticResource SectionHueStudioBrush}"/>
                <StackPanel Margin="16,8,16,8">

                    <!-- Multi-monitor -->
                    <Grid Height="34" ToolTip="{loc:Str tooltip_show_content_on_all_connected_monitors_2_3_or}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{loc:Str setting_multi_mon}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextLightBrush}" VerticalAlignment="Center"/>
                        <CheckBox Grid.Column="1" x:Name="ChkMultiMon"
                                  Style="{StaticResource ToggleStyle}" VerticalAlignment="Center"
                                  Checked="ChkMultiMon_Changed" Unchecked="ChkMultiMon_Changed"/>
                    </Grid>

                    <!-- Depends on the row above, so it stays indented. -->
                    <Grid Height="34" Margin="16,0,0,0" ToolTip="{loc:Str tooltip_fill_all_monitors_video}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{loc:Str setting_fill_all_monitors_video}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextLightBrush}" VerticalAlignment="Center"/>
                        <CheckBox Grid.Column="1" x:Name="ChkFillAllMon"
                                  Style="{StaticResource ToggleStyle}" VerticalAlignment="Center"
                                  Checked="ChkFillAllMon_Changed" Unchecked="ChkFillAllMon_Changed"/>
                    </Grid>

                    <!-- GPU decode -->
                    <Grid Height="34" ToolTip="Play mandatory videos on the GPU. Off by default (software decode) to dodge a white-screen bug on some PCs. Turn ON if a video only plays on one of your screens, keeps swapping screens, or freezes when it starts.">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Force video GPU decode" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextLightBrush}" VerticalAlignment="Center"/>
                        <CheckBox Grid.Column="1" x:Name="ChkVideoGpuDecode"
                                  Style="{StaticResource ToggleStyle}" VerticalAlignment="Center"
                                  Checked="ChkVideoGpuDecode_Changed" Unchecked="ChkVideoGpuDecode_Changed"/>
                    </Grid>

                    <!-- Blurred video background -->
                    <Grid Height="34" ToolTip="Fill the empty bars around a video that doesn't fit the screen (e.g. a vertical clip on a widescreen monitor) with a blurred, zoomed copy of the video, like TikTok. Turn OFF for plain black bars.">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Blurred video background" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextLightBrush}" VerticalAlignment="Center"/>
                        <CheckBox Grid.Column="1" x:Name="ChkVideoBlurBg"
                                  Style="{StaticResource ToggleStyle}" VerticalAlignment="Center"
                                  Checked="ChkVideoBlurBg_Changed" Unchecked="ChkVideoBlurBg_Changed"/>
                    </Grid>

                    <!-- Browser video engine -->
                    <Grid Height="34" ToolTip="{loc:Str tooltip_browser_video_engine}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{loc:Str setting_browser_video_engine}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextLightBrush}" VerticalAlignment="Center"/>
                        <CheckBox Grid.Column="1" x:Name="ChkBrowserVideoEngine"
                                  Style="{StaticResource ToggleStyle}" VerticalAlignment="Center"
                                  Checked="ChkBrowserVideoEngine_Changed" Unchecked="ChkBrowserVideoEngine_Changed"/>
                    </Grid>

                    <Border Height="1" Margin="0,6" Background="{DynamicResource GlassBorderBrush}"/>

                    <!-- Read-only since Phase 2 of the UX restructure. The startup group (launch with
                         Windows / video on launch / auto-start engine / start minimized) had two live
                         editors: this popup and the dashboard copy that MainWindow's LoadSettings,
                         SaveSettings, ChkWinStart_Click and RequestToggleWindowsStartup addressed by
                         name. Settings → General owns them now; this is a read-out that
                         LoadFromSettings keeps painted, plus a way to get there. -->
                    <Grid Height="38">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{loc:Str set2_general_startup_title}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextLightBrush}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" x:Name="TxtStartupGroupState" Text=""
                                   Foreground="{StaticResource TextMutedBrush}" FontSize="11"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                   HorizontalAlignment="Right" Margin="10,0,10,0"/>
                        <Button Grid.Column="2" x:Name="BtnOpenGeneralSettings"
                                Style="{DynamicResource OutlineButton}" Padding="10,4" FontSize="11"
                                VerticalAlignment="Center"
                                Content="{loc:Str set2_configure_in_settings}"
                                Click="BtnOpenGeneralSettings_Click"/>
                    </Grid>

                    <!-- Read-only since Phase 2. Settings → Devices owns the panic key: there used to
                         be two live toggles for PanicKeyEnabled (this one and the dashboard's), and
                         the double-confirm plus the keyboard-hook start/stop had to be spelled twice
                         to keep them honest. This is a mirror of the current state now. -->
                    <Grid Height="38">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <helpers:EmojiTextBlock Grid.Column="0" Text="{loc:Str setting_no_panic}" Foreground="#FF6B6B"
                                                FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" x:Name="TxtNoPanicState" Text="{loc:Str set2_chip_off}"
                                   Foreground="{StaticResource TextMutedBrush}" FontSize="11"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                   HorizontalAlignment="Right" Margin="10,0,10,0"/>
                        <Button Grid.Column="2" x:Name="BtnOpenDeviceSettingsNoPanic"
                                Style="{DynamicResource OutlineButton}" Padding="10,4" FontSize="11"
                                VerticalAlignment="Center"
                                Content="{loc:Str set2_configure_in_settings}"
                                Click="BtnOpenDeviceSettings_Click"/>
                    </Grid>

                    <!-- Read-only since Phase 2. Settings → Data owns OfflineMode: three MainWindow
                         methods drive that checkbox by name so the two-way sync (network disconnect,
                         login greying, banner) runs exactly once, and a second live toggle here meant
                         that flow was written twice. -->
                    <Grid Height="38">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{loc:Str setting_offline_mode}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextLightBrush}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" x:Name="TxtOfflineModeState" Text="{loc:Str set2_chip_off}"
                                   Foreground="{StaticResource TextMutedBrush}" FontSize="11"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                   HorizontalAlignment="Right" Margin="10,0,10,0"/>
                        <Button Grid.Column="2" x:Name="BtnOpenDataSettings"
                                Style="{DynamicResource OutlineButton}" Padding="10,4" FontSize="11"
                                VerticalAlignment="Center"
                                Content="{loc:Str set2_configure_in_settings}"
                                Click="BtnOpenDataSettings_Click"/>
                    </Grid>

                    <!-- Startup video: read-only since Phase 2, picker lives in Settings → General. -->
                    <Grid Height="38">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{loc:Str label_startup_video}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextLightBrush}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" x:Name="TxtStartupVideo" Text="{loc:Str label_random}"
                                   Foreground="{DynamicResource PinkBrush}" FontSize="12"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                   HorizontalAlignment="Right" Margin="10,0,10,0"/>
                        <Button Grid.Column="2" x:Name="BtnOpenGeneralSettingsVideo"
                                Style="{DynamicResource OutlineButton}" Padding="10,4" FontSize="11"
                                VerticalAlignment="Center"
                                Content="{loc:Str set2_configure_in_settings}"
                                Click="BtnOpenGeneralSettings_Click"/>
                    </Grid>

                    <!-- Panic key. Read-only: the rebind lives in Settings → Devices (Phase 2). The
                         capture ladder itself was always MainWindow's, but two buttons drove it and
                         each carried its own "Press any key…" state machine. This one just shows the
                         binding. -->
                    <Grid Height="34" ToolTip="{loc:Str set2_panic_change_in_settings}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <helpers:EmojiTextBlock Grid.Column="0" Text="{loc:Str btn_escape}"
                                                Foreground="{StaticResource TextLightBrush}"
                                                FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" x:Name="TxtPanicKeyState" Text="🔑 —"
                                   Foreground="{DynamicResource PinkBrush}" FontSize="13" FontWeight="Bold"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                </StackPanel>
            </Grid>
        </Border>

        <!-- Assets folder: buttons live below the card, as everywhere else in this kit. -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="📁 Pick Folder"
                    Style="{DynamicResource OutlineButton}"
                    Click="BtnPickAssets_Click"
                    ToolTip="{loc:Str tooltip_set_custom_assets_folder}"/>
            <Button Grid.Column="2" Content="{loc:Str btn_assets}"
                    Style="{DynamicResource OutlineButton}"
                    Click="BtnOpenAssets_Click"
                    ToolTip="{loc:Str tooltip_open_assets_folder_images_videos_sounds}"/>
        </Grid>
    </StackPanel>
</UserControl>
