<UserControl x:Class="ConditioningControlPanel.Features.MercyRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:ConditioningControlPanel.Localization">

    <!-- ccp-bugs #1145. One row shared by the Bubble Count and Video panels: both edit the same
         MercySystemEnabled / MercyAfterFails settings, so each copy follows the other through
         PropertyChanged. The picker only shows while Mercy is on. -->
    <Grid Height="34" Background="Transparent" ToolTip="{loc:Str tooltip_mercy}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="{loc:Str setting_mercy}" FontSize="13" FontWeight="SemiBold"
                   Foreground="{StaticResource TextLightBrush}" VerticalAlignment="Center"/>
        <ComboBox Grid.Column="1" x:Name="CmbAfter" Width="130" Margin="0,0,10,0"
                  VerticalAlignment="Center"
                  Style="{DynamicResource DarkComboBoxStyle}"
                  SelectionChanged="CmbAfter_Changed"/>
        <CheckBox Grid.Column="2" x:Name="ChkMercy"
                  Style="{StaticResource ToggleStyle}" VerticalAlignment="Center"
                  Checked="ChkMercy_Changed" Unchecked="ChkMercy_Changed"/>
    </Grid>
</UserControl>
