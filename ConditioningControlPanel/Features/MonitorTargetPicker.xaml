<UserControl x:Class="ConditioningControlPanel.Features.MonitorTargetPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:ConditioningControlPanel.Localization">

    <!-- The app-wide "which screen(s) does content cover" picker. One control, embedded in BOTH
         places the answer was reachable from (Settings > General and the System popup on Home), so
         the two can never disagree: each instance writes the same two settings and repaints from
         AppSettings.PropertyChanged. Row grammar matches the dense settings rows around it. -->
    <Grid MinHeight="34" Background="Transparent" ToolTip="{loc:Str tooltip_content_monitor}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="{loc:Str setting_content_monitor}"
                   FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource TextLightBrush}" VerticalAlignment="Center"
                   Margin="0,0,12,0"/>
        <ComboBox Grid.Column="1" x:Name="CmbContentMonitor" x:FieldModifier="internal"
                  Width="200" MinHeight="28" VerticalAlignment="Center" FontSize="11"
                  Style="{DynamicResource DarkComboBoxStyle}"
                  DropDownOpened="CmbContentMonitor_DropDownOpened"
                  SelectionChanged="CmbContentMonitor_Changed"/>
    </Grid>
</UserControl>
