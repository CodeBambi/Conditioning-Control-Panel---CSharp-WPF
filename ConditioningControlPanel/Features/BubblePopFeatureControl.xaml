<UserControl x:Class="ConditioningControlPanel.Features.BubblePopFeatureControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:ConditioningControlPanel.Localization"
             xmlns:helpers="clr-namespace:ConditioningControlPanel.Helpers"
             xmlns:feat="clr-namespace:ConditioningControlPanel.Features">

    <!-- Velvet Kit 2 density pass. The root IS the StackPanel (the old Grid wrapper is gone):
         MainWindow.SessionFeatureLock.cs inserts the session-lock banner at index 0 of
         content.Content, and into a Grid that banner would have overlapped the settings. -->
    <StackPanel>

        <!-- HERO -->
        <Border Height="72" CornerRadius="16" Background="{DynamicResource SurfaceBgBrush}"
                BorderBrush="{StaticResource SectionHueStudioBorderBrush}" BorderThickness="2" Margin="0,0,0,10">
            <Grid>
                <Border CornerRadius="0,16,16,0" Width="240" HorizontalAlignment="Right">
                    <Border.Background>
                        <ImageBrush x:Name="HeroArtBrush" Stretch="UniformToFill" AlignmentX="Right" Opacity="0.9">
                            <ImageBrush.ImageSource>
                                <BitmapImage UriSource="pack://application:,,,/Resources/features/Bubble_pop.png" DecodePixelWidth="480"/>
                            </ImageBrush.ImageSource>
                        </ImageBrush>
                    </Border.Background>
                    <Border.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#00000000" Offset="0"/>
                            <GradientStop Color="#E6000000" Offset="0.55"/>
                        </LinearGradientBrush>
                    </Border.OpacityMask>
                </Border>
                <StackPanel VerticalAlignment="Center" Margin="18,0,0,0">
                    <helpers:EmojiTextBlock Text="{loc:Str label_bubble_pop}" FontSize="17" FontWeight="Bold"
                                            Foreground="{StaticResource TextLightBrush}"/>
                    <TextBlock Text="{loc:Str tooltip_pop_bubbles_to_earn_xp}" FontSize="11.5"
                               Foreground="{StaticResource TextMutedBrush}" Margin="0,1,0,0"/>
                    <!-- #1019/#1026: ambient-pop XP has a 300/day ceiling. It used to be entirely
                         invisible, so a dry bucket read as "XP is broken". Text is set in code
                         (LoadFromSettings + the service's budget event). -->
                    <TextBlock x:Name="TxtAmbientXpBudget" FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}" Opacity="0.85" Margin="0,2,0,0"/>
                </StackPanel>
                <Border HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0" CornerRadius="99"
                        Background="#8C131320" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" Padding="12,5,8,5">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{loc:Str btn_enable}" FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <CheckBox x:Name="ChkEnable" feat:SessionLock.Owned="True"
                                  Style="{StaticResource ToggleStyle}" VerticalAlignment="Center"
                                  Checked="ChkEnable_Changed" Unchecked="ChkEnable_Changed"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- VELVET KIT 2 · ROUND 3 · DENSITY. The settings column is capped (3*, MaxWidth 780) so a
             slider stops being a ~1200px runway in the wide Studio detail pane, and the width that
             buys back becomes ONE big art card instead of dead margin. Everything below column 0 is
             the previous page contents moved verbatim - same names, handlers, lock markers and loc
             keys. Below 700px (the 520px feature popup) the art column collapses to zero and the
             settings retake the full width: Features/AdaptiveSideArt.cs. -->
        <Grid feat:AdaptiveSideArt.CollapseBelow="700">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MaxWidth="780"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <!-- ONE dense card -->
                <Border Style="{StaticResource SettingCardStyle}">
                    <Grid>
                        <Border Background="{StaticResource SectionHueStudioWashBrush}" CornerRadius="11"/>
                        <Border Width="3" HorizontalAlignment="Left" Margin="0,10" CornerRadius="0,2,2,0"
                                Background="{StaticResource SectionHueStudioBrush}"/>
                        <StackPanel Margin="16,8,16,8">

                            <Grid Height="36" Background="Transparent" ToolTip="{loc:Str tooltip_bubble_spawn_rate}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="120"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto" MinWidth="56"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{loc:Str label_per_min}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextLightBrush}" VerticalAlignment="Center"/>
                                <Slider Grid.Column="1" x:Name="SliderFreq" Minimum="1" Maximum="60" Value="5"
                                        feat:SessionLock.Owned="True" VerticalAlignment="Center" Margin="14,0"
                                        ValueChanged="SliderFreq_Changed"/>
                                <TextBlock Grid.Column="2" x:Name="TxtFreq" Text="5" HorizontalAlignment="Right"
                                           VerticalAlignment="Center" Foreground="{DynamicResource PinkBrush}"
                                           FontSize="13" FontWeight="Bold"/>
                            </Grid>

                            <Grid Height="36" Background="Transparent" ToolTip="How fast bubbles travel across the screen">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="120"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto" MinWidth="56"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Speed" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextLightBrush}" VerticalAlignment="Center"/>
                                <Slider Grid.Column="1" x:Name="SliderSpeed" Minimum="0" Maximum="500" Value="0"
                                        feat:SessionLock.Owned="True" VerticalAlignment="Center" Margin="14,0"
                                        ValueChanged="SliderSpeed_Changed"/>
                                <TextBlock Grid.Column="2" x:Name="TxtSpeed" Text="+0%" HorizontalAlignment="Right"
                                           VerticalAlignment="Center" Foreground="{DynamicResource PinkBrush}"
                                           FontSize="13" FontWeight="Bold"/>
                            </Grid>

                            <!-- Size. Sits with Per Min / Speed rather than under an advanced
                                 header because "these are too big" is a first-minute reaction, and
                                 the row it belongs next to is the one the user is already dragging.
                                 Reuses the existing label_size key for the label: no new key needed
                                 in nine files for a word that is already there. The tooltip does
                                 need one, though - every sibling row in this card is localised, so
                                 an English literal here reads as a bug in the other 8 languages. -->
                            <Grid Height="36" Background="Transparent" ToolTip="{loc:Str tooltip_bubble_size}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="120"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto" MinWidth="56"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{loc:Str label_size}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextLightBrush}" VerticalAlignment="Center"/>
                                <Slider Grid.Column="1" x:Name="SliderSize" Minimum="50" Maximum="150" Value="100"
                                        SmallChange="5" LargeChange="10" TickFrequency="5" IsSnapToTickEnabled="True"
                                        VerticalAlignment="Center" Margin="14,0"
                                        ValueChanged="SliderSize_Changed"/>
                                <TextBlock Grid.Column="2" x:Name="TxtSize" Text="100%" HorizontalAlignment="Right"
                                           VerticalAlignment="Center" Foreground="{DynamicResource PinkBrush}"
                                           FontSize="13" FontWeight="Bold"/>
                            </Grid>

                            <Grid Height="36" Background="Transparent" ToolTip="{loc:Str tooltip_bubble_pop_sound_volume}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="120"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto" MinWidth="56"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{loc:Str setting_volume}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextLightBrush}" VerticalAlignment="Center"/>
                                <Slider Grid.Column="1" x:Name="SliderVolume" Minimum="0" Maximum="100" Value="50"
                                        VerticalAlignment="Center" Margin="14,0"
                                        ValueChanged="SliderVolume_Changed"/>
                                <TextBlock Grid.Column="2" x:Name="TxtVolume" Text="50%" HorizontalAlignment="Right"
                                           VerticalAlignment="Center" Foreground="{DynamicResource PinkBrush}"
                                           FontSize="13" FontWeight="Bold"/>
                            </Grid>

                            <Border Height="1" Background="{DynamicResource GlassBorderBrush}" Margin="0,6"/>

                            <!-- Solid mode: render all bubbles on one shared host (the DTRH/Chaos path) for
                                 stability under a dense field (high spawn rate / many on screen at once). -->
                            <Grid Height="34" Background="Transparent" ToolTip="Uses the Rabbit Hole's optimized renderer so the field stays smooth with lots of bubbles. Lifts the on-screen cap. Turn off to use the classic one-window-per-bubble mode. Takes effect when bubbles restart.">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Solid mode (many bubbles)" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextLightBrush}" VerticalAlignment="Center"/>
                                <CheckBox Grid.Column="1" x:Name="ChkSolidMode"
                                          Style="{StaticResource ToggleStyle}" VerticalAlignment="Center"
                                          Checked="ChkSolidMode_Changed" Unchecked="ChkSolidMode_Changed"/>
                            </Grid>

                            <!-- Trigger Bubbles: a share of bubbles fire a Chaos effect when popped.
                                 The egg hint stays VISIBLE (and keeps its x:Name - the code-behind
                                 rewrites it with the active persona's name): it is the warning that this
                                 switch hands the wheel to Chaos, not a description of a dial. -->
                            <Grid Height="34" Background="Transparent" ToolTip="Some bubbles fire an effect when popped (flash, video, overlays…)">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Trigger Bubbles" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextLightBrush}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtTriggerEggHint"
                                               Text="careful — Bambi loves these…"
                                               Foreground="{DynamicResource PinkBrush}" FontSize="10.5" FontStyle="Italic"
                                               VerticalAlignment="Center" Margin="8,1,0,0"/>
                                </StackPanel>
                                <CheckBox Grid.Column="1" x:Name="ChkTriggers"
                                          Style="{StaticResource ToggleStyle}" VerticalAlignment="Center"
                                          Checked="ChkTriggers_Changed" Unchecked="ChkTriggers_Changed"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Gaze interaction. Its own card, mirroring the Flashes page: a distinct
                     capability with its own hardware prerequisite, not another bubble dial.
                     Before v6.9.1 bubbles were the only gaze target with no switch of their
                     own - they rode the Play tab's "Focus Gaze" master - and users reported
                     "Stare to pop" as removed because this page never showed one. -->
                <Border Style="{StaticResource SettingCardStyle}">
                    <Grid>
                        <Border Background="{StaticResource SectionHueStudioWashBrush}" CornerRadius="11"/>
                        <Border Width="3" HorizontalAlignment="Left" Margin="0,10" CornerRadius="0,2,2,0"
                                Background="{StaticResource SectionHueStudioBrush}"/>
                        <StackPanel Margin="16,8,16,8">
                            <TextBlock Text="{loc:Str label_gaze_interaction}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextLightBrush}" Margin="0,2,0,4"/>

                            <Grid Height="34" Background="Transparent" ToolTip="{loc:Str tooltip_bubble_gaze_pop}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{loc:Str label_stare_to_pop}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextLightBrush}" VerticalAlignment="Center"/>
                                <CheckBox Grid.Column="1" x:Name="ChkBubbleGazePop"
                                          Style="{StaticResource ToggleStyle}" VerticalAlignment="Center"
                                          Checked="ChkBubbleGazePop_Changed" Unchecked="ChkBubbleGazePop_Changed"/>
                            </Grid>

                            <!-- Shown only while the camera cannot actually feed the dwell engine.
                                 The row above stays live either way: the toggle is a stored
                                 preference, not a "start the webcam" button. -->
                            <TextBlock x:Name="TxtBubbleGazeHint" Visibility="Collapsed"
                                       Text="{loc:Str label_gaze_needs_calibration}"
                                       Foreground="{DynamicResource PinkBrush}" FontSize="11" FontStyle="Italic"
                                       TextWrapping="Wrap" Margin="0,2,0,4"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Trigger options: own card, revealed by the switch above. -->
                <StackPanel x:Name="TriggerOptionsPanel" Visibility="Collapsed">
                    <Border Style="{StaticResource SettingCardStyle}">
                        <Grid>
                            <Border Background="{StaticResource SectionHueStudioWashBrush}" CornerRadius="11"/>
                            <Border Width="3" HorizontalAlignment="Left" Margin="0,10" CornerRadius="0,2,2,0"
                                    Background="{StaticResource SectionHueStudioBrush}"/>
                            <StackPanel Margin="16,8,16,10">

                                <Grid Height="36" Background="Transparent" ToolTip="How often a spawned bubble carries an effect">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="120"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto" MinWidth="56"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Trigger chance" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextLightBrush}" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" x:Name="SliderTriggerChance" Minimum="0" Maximum="50" Value="10"
                                            VerticalAlignment="Center" Margin="14,0"
                                            ValueChanged="SliderTriggerChance_Changed"/>
                                    <TextBlock Grid.Column="2" x:Name="TxtTriggerChance" Text="10%" HorizontalAlignment="Right"
                                               VerticalAlignment="Center" Foreground="{DynamicResource PinkBrush}"
                                               FontSize="13" FontWeight="Bold"/>
                                </Grid>

                                <Border Height="1" Background="{DynamicResource GlassBorderBrush}" Margin="0,6"/>

                                <TextBlock Text="Effect types" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextLightBrush}" Margin="0,2,0,8"/>
                                <WrapPanel Background="Transparent" ToolTip="Each ticked effect has an equal chance">
                                    <CheckBox x:Name="ChkTypeFlash"      Tag="flash"      Content="Flash"       Foreground="White" Margin="0,0,16,8" Checked="TriggerType_Changed" Unchecked="TriggerType_Changed"/>
                                    <CheckBox x:Name="ChkTypeSubliminal" Tag="subliminal" Content="Subliminal"  Foreground="White" Margin="0,0,16,8" Checked="TriggerType_Changed" Unchecked="TriggerType_Changed"/>
                                    <CheckBox x:Name="ChkTypePink"       Tag="pink"       Content="Pink Filter" Foreground="White" Margin="0,0,16,8" Checked="TriggerType_Changed" Unchecked="TriggerType_Changed"/>
                                    <CheckBox x:Name="ChkTypeSpiral"     Tag="spiral"     Content="Spiral"      Foreground="White" Margin="0,0,16,8" Checked="TriggerType_Changed" Unchecked="TriggerType_Changed"/>
                                    <CheckBox x:Name="ChkTypeGlitch"     Tag="glitch"     Content="Glitch"      Foreground="White" Margin="0,0,16,8" Checked="TriggerType_Changed" Unchecked="TriggerType_Changed"/>
                                    <CheckBox x:Name="ChkTypeCascade"    Tag="htlink"     Content="Cascade"     Foreground="White" Margin="0,0,16,8" Checked="TriggerType_Changed" Unchecked="TriggerType_Changed"/>
                                    <CheckBox x:Name="ChkTypeVideo"      Tag="video"      Content="Video"       Foreground="White" Margin="0,0,16,8" Checked="TriggerType_Changed" Unchecked="TriggerType_Changed"/>
                                </WrapPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </StackPanel>

            <!-- SIDE ART. The art is the Border's BACKGROUND, not a child Image: a Border clips its
                 Background to CornerRadius but does NOT clip child content, so a child Image would
                 square off the rounded corners (round-2 lesson). Same plate the hero uses. -->
            <Border Grid.Column="1" Margin="10,0,0,0" CornerRadius="14"
                    BorderThickness="2" BorderBrush="{StaticResource VelvetCardBorderBrush}"
                    VerticalAlignment="Stretch" MinHeight="200">
                <Border.Background>
                    <ImageBrush x:Name="SideArtBrush" Stretch="UniformToFill">
                        <ImageBrush.ImageSource>
                            <BitmapImage UriSource="pack://application:,,,/Resources/features/Bubble_pop.png"
                                         DecodePixelWidth="800"/>
                        </ImageBrush.ImageSource>
                    </ImageBrush>
                </Border.Background>
                <!-- Scrim so the plate sits under the page instead of fighting it. -->
                <Border CornerRadius="12">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                            <GradientStop Color="#66000000" Offset="0"/>
                            <GradientStop Color="#00000000" Offset="0.45"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
            </Border>
        </Grid>

    </StackPanel>
</UserControl>
