<UserControl x:Class="ConditioningControlPanel.Views.Tabs.PresetsTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:helpers="clr-namespace:ConditioningControlPanel.Helpers"
             xmlns:loc="clr-namespace:ConditioningControlPanel.Localization"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <!--
        ======================= THE SESSION DOOR (tab key "presets") =======================
        Restyled 2026-08-13 (Session Door Overhaul, phases 1-2). Same bones it always had -
        rack on the left, detail panel on the right, draggable splitter between - relaid out
        into the Play door's zone vocabulary so the two pages finally read as one app.

        WHAT CHANGED, and what deliberately did not:
          * Every literal hex is gone. The page was the last surface still painting itself
            #2A2A4A on #3A3A5A, which meant it was the only tab that did NOT re-tint when the
            active mod changed. Everything is a DynamicResource theme brush now.
          * Zone headers (tag + trailing hairline) replace the old SectionHeader rows, matching
            PlayTabView's PlayZoneTag / PlayZoneRule.
          * The two placeholder boxes at the bottom (a "Community Catalogue" card and a
            "Session Editor" card, together eating a ~120px band for two links) collapse into
            ONE compact strip. The band they gave back went to the session list.
            2026-08-16: that strip is gone too. The catalogue is now a chip at the right end
            of the Takeaway line, with the Export button and the import ticker beside it, and
            the page has no fixed bottom band left at all.
          * The detail panel's loose Duration/Reward text rows become a three-medallion row.
          * NOTHING was renamed. Every x:Name and every x:FieldModifier="internal" survives:
            MainWindow reaches into this view by name from four partials (Presets, SessionIO,
            PresetIO, TabFxPresetsQuestsAchievements) and a rename is a compile break at best
            and a silent null at worst. Same for the tab key "presets" - see MainWindow.NavRail,
            ChromeFxNav and the dashboard mosaic.

        THE CARD VOCABULARY BELOW IS SHARED WITH CODE-BUILT CARDS. Preset chips are built by
        MainWindow.Presets.CreatePresetCard and every session row by
        MainWindow.SessionIO.RepaintSessionRack - both reach these styles through
        PresetsTab.TryFindResource(...), which finds a UserControl-local resource because
        FrameworkElement.FindResource walks the element's OWN dictionary first. That is why
        these styles live here and not in Resources/Theme: a fresh cross-dictionary
        StaticResource in the theme is what broke BAML (and 181 tests) once already.

        SPOILERS STAY OPT-IN. The "mystery experience" veil and its explicit Reveal button are
        a product decision, not an oversight. Do not auto-expand SessionSpoilerPanel.
    -->
    <UserControl.Resources>

        <!-- ============================ zone furniture ============================ -->
        <!-- The tag + hairline pair PlayTabView established. Consolas because the whole app's
             structural labelling is Consolas; the rule fades to transparent so the header does
             not draw a box around content that is already in a panel. -->
        <Style x:Key="SdZoneTag" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PinkBrush}"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>
        <Style x:Key="SdZoneRule" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>
        <Style x:Key="SdZoneHint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>

        <!-- ============================ THE SESSION RACK ============================
             Session Rack, 2026-08-16. The list used to be four hard-coded 90px cards in this
             file plus a code-built "Your Sessions" annexe underneath, which meant three or four
             sessions on screen, a page-wide row that was half empty from the middle out, and
             two places to change whenever a row grew a field.

             It is now ONE list, 44px per row, built entirely in code from the session registry
             by MainWindow.SessionIO.RepaintSessionRack - built-in, custom and catalogue rows are
             the same object, told apart by a colour code rather than by which panel they sit in.
             Every style below is reached from there through TryFindTabStyle, which is why they
             live in this dictionary and not in Resources/Theme (see the header comment).

             The 5px bottom margin is hover headroom: LiftSessionRow raises a row 2px and a
             full-width row inside a ScrollViewer clips silently without it.
             ========================================================================= -->
        <Style x:Key="SdSessionRow" TargetType="Border">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PanelAccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <!-- Zero padding on purpose: the difficulty stripe is full-bleed to the row's left
                 edge, and a Padding would inset it into a grey gutter. -->
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ElevatedSurfaceBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource PinkBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- Selection. Accent-tinted fill plus the accent stroke, the same two moves
             SdPresetChipSelected makes, so a selected row and a selected preset chip read as
             the same state. It stays lit while hovered: the hover trigger below re-states the
             tint rather than letting the base style's hover fill overwrite it. -->
        <Style x:Key="SdSessionRowSelected" TargetType="Border" BasedOn="{StaticResource SdSessionRow}">
            <Setter Property="Background" Value="{DynamicResource TransparentPink20Brush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PinkBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource TransparentPink20Brush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource PinkBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- The session's own glyph. The old 52x38 art plate is gone - at 44px a plate ate a
             third of the row for a border around one emoji. -->
        <Style x:Key="SdRackIcon" TargetType="helpers:EmojiTextBlock">
            <Setter Property="Width" Value="28"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SdRowTitle" TargetType="helpers:EmojiTextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextLightBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <!-- The spoiler-free blurb, on the SAME line as the name now. Trimming is the
             TextBlock's job; the full text is on the row's ToolTip. -->
        <Style x:Key="SdRowBlurb" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <!-- Duration and reward. Consolas so the numbers form a column down the list instead of
             jittering with the proportional widths of 5 / 45 / 120. -->
        <Style x:Key="SdRackMeta" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
        </Style>

        <!-- The action buttons only exist on hover. Hidden rather than Collapsed so the row's
             right edge does not shuffle as the pointer crosses the list. -->
        <Style x:Key="SdRackActions" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Hidden"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ============================ pills and badges ============================ -->
        <!-- Difficulty pill and source badge. Both wear a colour that encodes MEANING, never
             brand: the eight SessionDiff* / SessionSrc* keys in Resources/Theme are static
             across mods so a drone-green build cannot paint EASY and EXTREME the same green.
             Foreground is the solid, Background the 13% wash sibling. -->
        <Style x:Key="SdPill" TargetType="Border">
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Padding" Value="7,1.5"/>
            <Setter Property="Margin" Value="9,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SdPillText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <!-- The provenance chip: BUILT-IN / YOURS / CAT. Consolas and uppercase because on this
             page mono means "structural label", never content. -->
        <Style x:Key="SdRackBadgeText" TargetType="TextBlock" BasedOn="{StaticResource SdPillText}">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="9"/>
        </Style>

        <!-- ============================ rack toolbar ============================ -->
        <!-- Source chips and difficulty dots. Same pill language as AchievementFilterChip (the
             app's filter chip, which the Assets tab's source and niche rows build from in code),
             restated here rather than BasedOn'd: that key lives in Resources/Theme/MainWindow.xaml
             and a fresh cross-dictionary StaticResource is exactly what took BAML - and 181 tests
             - down once already. Restated in theme brushes, so unlike the original these re-tint
             with the active mod. -->
        <Style x:Key="SdRackChip" TargetType="ToggleButton">
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Chip" CornerRadius="11" Padding="9,3"
                                Background="{DynamicResource SurfaceBgBrush}"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource PanelAccentBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource PinkBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource TransparentPink20Brush}"/>
                                <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource PinkBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextLightBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- A difficulty dot carries its OWN colour in Foreground (set per dot in code), so the
             checked state may not repaint it - it dims the whole button instead. -->
        <Style x:Key="SdRackDot" TargetType="ToggleButton">
            <Setter Property="Margin" Value="0,0,3,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MinWidth" Value="24"/>
            <Setter Property="Opacity" Value="0.32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Dot" CornerRadius="11" Padding="6,3"
                                Background="{DynamicResource SurfaceBgBrush}"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource PanelAccentBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Dot" Property="BorderBrush" Value="{DynamicResource PinkBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Opacity" Value="1"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- The line the list shows instead of rows when a filter has emptied it. -->
        <Style x:Key="SdRackEmpty" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,26,0,0"/>
        </Style>

        <!-- ============================ row actions ============================ -->
        <!-- Replaces the shared SessionActionButton / SessionDeleteButton. r7 instead of r4, and a
             stroke instead of a filled chip, so a resting row reads as one object rather than as a
             row with two grey squares stapled on.

             Those two theme keys (Resources/Theme/MainWindow.xaml) are now UNREFERENCED - this page
             was their only consumer. They are deliberately left in place: pulling keys out of the
             shared theme dictionary is a cleanup with its own blast radius, not part of a restyle,
             and a keyed style is only safe to delete after grepping every FindResource /
             TryFindResource call site as well as the XAML. Delete them in a pass of their own. -->
        <Style x:Key="SdRowAction" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="3,0,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="chrome" CornerRadius="7"
                                Background="{TemplateBinding Background}"
                                BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="chrome" Property="Background" Value="{DynamicResource TransparentPink20Brush}"/>
                                <Setter TargetName="chrome" Property="BorderBrush" Value="{DynamicResource PinkBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PinkBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Same shape, red hover. Destructive actions do not get the brand colour. -->
        <Style x:Key="SdRowActionDanger" TargetType="Button" BasedOn="{StaticResource SdRowAction}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="chrome" CornerRadius="7"
                                Background="{TemplateBinding Background}"
                                BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="chrome" Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================ THE PRESET CHIP RAIL ============================
             34px pills on a WrapPanel (2026-08-16, phase 2 of the compaction).

             What used to be here: 96x70 cards in a horizontally-scrolling strip. Three stacked
             rows each (name / feature glyphs / DEFAULT-CUSTOM), ~7 on screen at a time, and the
             eighth preset was behind a horizontal scrollbar that nobody drags. A user with a
             dozen presets could not see a dozen presets.

             What is here now: ONE line per chip - glyphs, name, provenance tag - at 34px with
             r17 corners, laid out by a WrapPanel so preset eleven lands on a second row instead
             of off the edge. Same styles keys as the cards had (CreatePresetCard reaches them
             through TryFindTabStyle), so nothing outside this file had to learn a new name.

             Selection is the RACK's language, not a fatter border: an accent-tinted fill plus a
             1px accent stroke, exactly what SdSessionRowSelected does. A 2px selected stroke on
             a pill re-flows its content by a pixel on every click, which reads as a twitch. -->
        <Style x:Key="SdPresetChip" TargetType="Border">
            <Setter Property="Height" Value="34"/>
            <Setter Property="CornerRadius" Value="17"/>
            <Setter Property="Padding" Value="11,0"/>
            <!-- Right AND bottom margin: on a WrapPanel the bottom one is the gap between wrapped
                 rows, and it doubles as headroom for the 1.02 hover lift. -->
            <Setter Property="Margin" Value="0,0,7,6"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PanelAccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource PinkBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- Stays lit while hovered: the hover trigger re-states the tint rather than letting the
             base style's hover overwrite it. Same move SdSessionRowSelected makes. -->
        <Style x:Key="SdPresetChipSelected" TargetType="Border" BasedOn="{StaticResource SdPresetChip}">
            <Setter Property="Background" Value="{DynamicResource TransparentPink20Brush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PinkBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource TransparentPink20Brush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource PinkBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- The fixed "new preset" chip at the end of the rail. Its own style rather than an
             implicit one in Border.Resources: an implicit style declared on an element applies to
             that element's CHILDREN, never to the element itself, so the hover trigger would
             simply never have fired. -->
        <Style x:Key="SdPresetChipNew" TargetType="Border" BasedOn="{StaticResource SdPresetChip}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource TransparentPink40Brush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource PinkBrush}"/>
                    <Setter Property="Background" Value="{DynamicResource TransparentPink20Brush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- The preset's name, on the chip's one line. MaxWidth is set per chip in code - a Style
             cannot know how much room the glyphs in front of it took. -->
        <Style x:Key="SdPresetChipName" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextLightBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <!-- A tag pill sized for the inside of a 34px chip: SdPill's 7,1.5 padding and 9px lead
             are tuned for a 44px rack row and overflow a pill-in-a-pill. Same solid+wash colour
             contract though - MakeRackPill builds both. -->
        <Style x:Key="SdChipTag" TargetType="Border">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="5,1"/>
            <Setter Property="Margin" Value="7,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ==================== THE TAKEAWAY STRIP AND ITS TRAY ====================
             A receipt, not a launcher - clicking one replays the order in the Just Drop window
             and mints nothing (see the doctrine at the head of MainWindow.Takeaway.cs).

             Was: 158x74 cards in a horizontal ScrollViewer, up to twelve of them, eating ~90px of
             the page for a rack whose tail was months old. Now: ONE 32px line - the three newest
             drops, a "+n more" toggle, the shop door - with every remaining order in a scrollable
             tray that opens underneath. The strip NEVER wraps and never scrolls sideways; the
             tray is what makes the rest reachable, which is why the old twelve-card cap now
             applies only to the three pinned chips.

             r16 on a 32px chip, so these read as slightly smaller siblings of the preset rail's
             r17 pills rather than as another kind of object. -->
        <Style x:Key="SdTakeawayChip" TargetType="Border">
            <Setter Property="Height" Value="32"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="11,0"/>
            <Setter Property="Margin" Value="0,0,7,0"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PanelAccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource PinkBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- The "order a drop" door. Muted accent stroke on nothing, the same "dashed" reading
             SdPresetChipNew uses (a WPF Border cannot stroke a real dash), so the strip ends on
             an invitation rather than on a hard edge. -->
        <Style x:Key="SdTakeawayChipDoor" TargetType="Border" BasedOn="{StaticResource SdTakeawayChip}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource TransparentPink40Brush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource PinkBrush}"/>
                    <Setter Property="Background" Value="{DynamicResource TransparentPink20Brush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- The "+n more" toggle. Accent-tinted because it is the one chip on the strip that acts
             on the PAGE rather than on an order. -->
        <Style x:Key="SdTakeawayChipAccent" TargetType="Border" BasedOn="{StaticResource SdTakeawayChip}">
            <Setter Property="Background" Value="{DynamicResource TransparentPink20Brush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource TransparentPink40Brush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource PinkBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- The Community Catalogue door, violet. It wears the SessionSrcImported family the rack
             already spends on catalogue rows, so "violet means it came from / goes to the
             catalogue" holds across the whole page. Resting state is the wash with no visible
             stroke; the stroke is the hover. -->
        <Style x:Key="SdCatalogueChip" TargetType="Border" BasedOn="{StaticResource SdTakeawayChip}">
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="{DynamicResource SessionSrcImportedWashBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SessionSrcImportedWashBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource SessionSrcImportedBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SdTakeawayChipTitle" TargetType="helpers:EmojiTextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextLightBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="SdTakeawayChipMeta" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="9.5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>
        <!-- The copy-link chip. Deliberately quiet until hovered: the chip's whole job is "click
             to replay", and a second affordance shouting for attention would compete with it. It
             sits INSIDE the chip, so its handler marks the click handled - otherwise copying a
             link would also start playing the drop. -->
        <Style x:Key="SdTakeawayCopy" TargetType="Border">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Opacity" Value="0.55"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="1"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource TransparentPink40Brush}"/>
                    <Setter Property="Background" Value="{DynamicResource TransparentPink20Brush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ============================ the tray ============================ -->
        <!-- One 36px row per order, EVERY order the drawer returned. Squarer than the strip's
             pills (r8) because a stack of pills reads as a pile of buttons; these are list rows,
             the same thing the session rack's r10 rows are. -->
        <Style x:Key="SdTakeawayRow" TargetType="Border">
            <Setter Property="Height" Value="36"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="9,0"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PanelAccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ElevatedSurfaceBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource PinkBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SdTakeawayRowTitle" TargetType="helpers:EmojiTextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextLightBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <!-- Minutes and date. Consolas and right-aligned so they form columns down the tray, the
             same reason SdRackMeta is mono on a rack row. -->
        <Style x:Key="SdTakeawayRowMeta" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
        </Style>
        <Style x:Key="SdTakeawayRowAge" TargetType="TextBlock" BasedOn="{StaticResource SdTakeawayRowMeta}">
            <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}"/>
            <Setter Property="FontSize" Value="10"/>
        </Style>

        <!-- ============================ medallions ============================ -->
        <!-- The detail panel's stat triple. One shape, three instances: a stacked caption over a
             value, so duration / reward / grade scan as a row instead of as three sentences. -->
        <Style x:Key="SdMedallion" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PanelAccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="6,9"/>
        </Style>
        <Style x:Key="SdMedLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="9.5"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SdMedValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextLightBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <!-- ============================ detail chrome ============================ -->
        <Style x:Key="SdDetailLabel" TargetType="helpers:EmojiTextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextLightBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="SdDetailValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Margin" Value="0,0,0,13"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- =====================================================================
             HEADER BAND. New in the overhaul, and the home for the two actions
             that used to live inside the placeholder boxes at the bottom of the
             page. The wash is a one-way accent gradient rather than a filled bar:
             an opaque header on top of an already-panelled page reads as a second
             title bar. Same treatment the Profile tab's banner got on 08-13.

             The streak / last-run chips sketched in the proposal are NOT here.
             They need progression plumbing this phase does not have, and they
             belong next to the Takeaway shelf (phase 3) rather than up here.
             ===================================================================== -->
        <Border Grid.Row="0" Margin="5,5,5,0" CornerRadius="11" Padding="16,11"
                Background="{DynamicResource PanelBgBrush}"
                BorderThickness="1" BorderBrush="{DynamicResource GlassBorderBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- The accent wash is its OWN low-opacity layer rather than a gradient on the
                     Background above. Theme colours (PinkColor, NeonPurpleColor) are opaque and a
                     GradientStop cannot borrow an alpha from one, so painting the background
                     directly would give this band a solid pink left edge. Opacity on a separate
                     layer keeps it a tint AND keeps it mod-aware. The negative margin cancels this
                     Border's own Padding so the wash is full-bleed - the same trick
                     PlayCardArtPlate uses to reach its card's rounded edge. -->
                <Border Grid.Column="0" Grid.ColumnSpan="2" Panel.ZIndex="-1"
                        CornerRadius="11" Opacity="0.16" Margin="-16,-11">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="{DynamicResource PinkColor}" Offset="0"/>
                            <GradientStop Color="Transparent" Offset="0.7"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{loc:Str sd_page_title}" Foreground="{DynamicResource TextLightBrush}"
                               FontSize="16.5" FontWeight="Bold"/>
                    <TextBlock Text="{loc:Str sd_page_sub}" Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="11.5" Margin="0,3,0,0" TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Recent sessions. Moved up out of the Sessions zone header, where it was a
                         second competing action next to the zone tag. -->
                    <Button x:Name="BtnSessionHistory" Click="BtnSessionHistory_Click"
                            ToolTip="{loc:Str tooltip_recent_sessions}"
                            Style="{StaticResource OutlineButton}"
                            Padding="12,7" Margin="0,0,7,0" FontSize="11.5" Cursor="Hand">
                        <helpers:EmojiTextBlock Text="{loc:Str btn_recent_sessions}" FontWeight="SemiBold"/>
                    </Button>
                    <!-- Was the right-hand "Session Editor" placeholder box. -->
                    <Button x:Name="BtnCreateSession" Content="{loc:Str btn_create_new}"
                            Click="BtnCreateSession_Click"
                            Style="{StaticResource PinkButton}"
                            Padding="14,7" FontSize="11.5" FontWeight="SemiBold" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===================== MAIN CONTENT: rack | splitter | detail ===================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="430" MinWidth="300" MaxWidth="700"/>
            </Grid.ColumnDefinitions>

            <!-- ============================ LEFT: the rack ============================ -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- The rack takes every pixel the other two do not. It gained the whole
                         Catalogue banner row when that collapsed into the Takeaway strip
                         (2026-08-16) - a 56px strip for one link and one button was the last
                         fixed band on this page. -->
                    <RowDefinition Height="*"/>
                    <!-- Takeaway. Auto, so the strip costs the rack one 32px line, and the
                         overflow tray only costs it more while it is open. -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ============================ ZONE: PRESETS ============================ -->
                <Border Grid.Row="0" Style="{StaticResource SectionPanel}" Margin="5,8,5,0" Padding="14,12">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource SdZoneTag}" Text="{loc:Str sd_zone_presets}"/>
                            <Border Grid.Column="1" Style="{StaticResource SdZoneRule}">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="{DynamicResource PinkColor}" Offset="0"/>
                                        <GradientStop Color="Transparent" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Button Grid.Column="2" x:Name="HelpBtnPresets" x:FieldModifier="internal"
                                    Style="{StaticResource HelpButtonStyle}" Tag="Presets"/>
                        </Grid>

                        <!-- THE RAIL. A WrapPanel, not a horizontal ScrollViewer: presets wrap onto
                             a second line rather than paginate off the right edge, and the whole
                             set is visible at once. The scroller (and its
                             PacksScrollViewer_PreviewMouseWheel hook) is gone with it - there is
                             nothing left to scroll.

                             THE "+ NEW" CHIP IS A CHILD OF THIS PANEL, deliberately: it has to
                             wrap with the chips, and a sibling panel would strand it on the first
                             line. That makes RefreshPresetsList's rebuild surgical - it removes
                             only the Borders it tagged with a preset id and inserts ahead of this
                             one. Do NOT "simplify" that back to Children.Clear(). -->
                        <WrapPanel x:Name="PresetCardsPanel" x:FieldModifier="internal" Orientation="Horizontal">
                            <!-- Chips are built by MainWindow.Presets.CreatePresetCard against the
                                 SdPresetChip styles above and inserted before this one. -->
                            <Border Style="{StaticResource SdPresetChipNew}"
                                    MouseLeftButtonUp="BtnNewPreset_Click"
                                    ToolTip="{loc:Str tooltip_create_a_new_preset_from_current_settings}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="+" FontSize="15" FontWeight="Bold"
                                               VerticalAlignment="Center" Margin="0,0,6,0"
                                               Foreground="{DynamicResource PinkBrush}"/>
                                    <TextBlock Text="{loc:Str label_new}" FontSize="10" FontWeight="Bold"
                                               FontFamily="Consolas" VerticalAlignment="Center"
                                               Foreground="{DynamicResource PinkBrush}"/>
                                </StackPanel>
                            </Border>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- ============================ ZONE: SESSIONS ============================
                     THE SESSION RACK (2026-08-16). One list, one repaint, no XAML rows.

                     What used to be here: four hard-coded ~90px built-in cards (Morning Drift /
                     Gamer Girl / Distant Doll / Good Girls) written out longhand, then a second
                     code-built "Your Sessions" panel under a header of its own. Three or four
                     rows fit on screen, the split was invisible to the reader but load-bearing to
                     four call sites, and a fifth built-in meant hand-writing another 40 lines.

                     What is here now: a toolbar and ONE StackPanel. Every row - built-in, custom,
                     imported - is built by MainWindow.SessionIO.RepaintSessionRack from the
                     session registry, colour-coded by difficulty and provenance instead of by
                     which panel it landed in. Nothing in this file knows a session's name any
                     more, which is the point: the four cards' loc keys had drifted from the
                     .session.json files they were supposed to mirror.

                     Rows carry the session id in Tag. That is contractual - SessionCard_Click,
                     FindSelectedCard and RevealSessionInLibrary all match on it.
                     ======================================================================= -->
                <Border Grid.Row="1" Style="{StaticResource SectionPanel}" Margin="5,8,5,0" Padding="14,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource SdZoneTag}" Text="{loc:Str sd_zone_sessions}"/>
                            <Border Grid.Column="1" Style="{StaticResource SdZoneRule}">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="{DynamicResource PinkColor}" Offset="0"/>
                                        <GradientStop Color="Transparent" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <!-- The static "Built-in · Yours · Catalogue" caption that sat here is
                                 gone: the toolbar's source chips say the same thing and carry a
                                 live count each, so the caption was a legend for a colour code
                                 that did not exist yet. -->
                            <TextBlock Grid.Column="2" x:Name="TxtRackCount" x:FieldModifier="internal"
                                       Style="{StaticResource SdZoneHint}" Text=""/>
                            <Button Grid.Column="3" x:Name="HelpBtnSessions" x:FieldModifier="internal"
                                    Style="{StaticResource HelpButtonStyle}" Tag="Sessions"/>
                        </Grid>

                        <!-- ============================ THE RACK TOOLBAR ============================
                             28px, one line, and every control here is a VIEW over the same list -
                             none of them mutate a session. Source is single-select, difficulty is
                             four independent toggles, sort and search are free.

                             The chips are built in code (BuildSessionRackToolbar) for the same
                             reason the Assets tab builds its source chips there: each one carries a
                             live count, and a count in XAML is a binding to a view-model this page
                             deliberately does not have. Sort and search are declared here because
                             they are fixed furniture - their handlers are thin forwarders into
                             MainWindow like every other handler on this page.

                             Source filter and sort PERSIST (AppSettings.SessionRackSourceFilter /
                             SessionRackSort). The difficulty dots and the search box do NOT, on
                             purpose: a filter you cannot see the cause of, restored a week later,
                             reads as "my sessions are gone".
                             ==================================================================== -->
                        <Grid Grid.Row="1" Height="28" Margin="0,0,0,9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" x:Name="RackSourceChips" x:FieldModifier="internal"
                                        Orientation="Horizontal" VerticalAlignment="Center"/>

                            <StackPanel Grid.Column="1" x:Name="RackDifficultyChips" x:FieldModifier="internal"
                                        Orientation="Horizontal" VerticalAlignment="Center" Margin="9,0,0,0"/>

                            <ComboBox Grid.Column="3" x:Name="CmbRackSort" x:FieldModifier="internal"
                                      Width="128" Height="26" VerticalAlignment="Center" FontSize="11"
                                      Margin="8,0,7,0"
                                      ToolTip="{loc:Str tooltip_rack_sort}"
                                      SelectionChanged="CmbRackSort_SelectionChanged">
                                <!-- Tag is the persisted token; the face text is localized. Never
                                     key the sort off SelectedIndex - reordering this list would
                                     silently repoint every saved preference. -->
                                <ComboBoxItem Tag="recent" Content="{loc:Str rack_sort_recent}"/>
                                <ComboBoxItem Tag="name" Content="{loc:Str rack_sort_name}"/>
                                <ComboBoxItem Tag="easiest" Content="{loc:Str rack_sort_easiest}"/>
                                <ComboBoxItem Tag="hardest" Content="{loc:Str rack_sort_hardest}"/>
                                <ComboBoxItem Tag="shortest" Content="{loc:Str rack_sort_shortest}"/>
                                <ComboBoxItem Tag="xp" Content="{loc:Str rack_sort_xp}"/>
                            </ComboBox>

                            <!-- Watermark is a sibling TextBlock rather than the templated one in
                                 Resources/Theme: that template hangs off EmoteHelper's attached
                                 properties and a converter, which is a lot of machinery to borrow
                                 for one hint. RackSearch_TextChanged collapses it. -->
                            <Grid Grid.Column="4" Width="150" VerticalAlignment="Center">
                                <TextBox x:Name="TxtRackSearch" x:FieldModifier="internal"
                                         Height="26" FontSize="11" Padding="7,0"
                                         VerticalContentAlignment="Center"
                                         TextChanged="TxtRackSearch_TextChanged"/>
                                <TextBlock x:Name="TxtRackSearchHint" x:FieldModifier="internal"
                                           Text="{loc:Str rack_search_watermark}" IsHitTestVisible="False"
                                           Foreground="{DynamicResource TextDimBrush}" FontSize="11"
                                           Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </Grid>
                        </Grid>

                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <!-- ONE panel. RepaintSessionRack clears and refills it; nothing else
                                 may add a child, or the FX sweep in
                                 MainWindow.TabFxPresetsQuestsAchievements (which walks Borders
                                 here and matches the selected row by Tag) picks up a stranger. -->
                            <StackPanel x:Name="SessionRackPanel" x:FieldModifier="internal"/>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- ====================== ZONE: TAKEAWAY ======================
                     The Just Drop order drawer, rendered - not owned. Every chip is an order
                     the ACCOUNT already has; the desktop cannot create, price or delete one.
                     Clicking replays it in the Just Drop window (free - the XP grant is
                     deduplicated per order code), and the 🔗 element copies the public taste
                     link and nothing else. The full doctrine is at the head of
                     MainWindow.Takeaway.cs and it is load-bearing, not decoration.

                     ONE LINE (2026-08-16). Was a horizontal ScrollViewer of up to twelve
                     158x74 cards; is now a strip that never wraps and never scrolls sideways:
                     the three newest drops, a "+n more" toggle, the shop door, then - hard
                     right - the page's two remaining links. Everything else lives in the tray
                     the toggle opens, which is why the twelve-card cap now applies only to the
                     pinned chips and the tray renders every order the server returns.

                     THE ZONE NO LONGER HIDES ITSELF. It used to collapse when there were no
                     orders and no door; it now carries the Community Catalogue chip and the
                     session Export button, which must be reachable on a fresh install. Only
                     the order half hides - see PaintTakeawayShelf.
                     ============================================================= -->
                <Border Grid.Row="2" x:Name="TakeawayZone" x:FieldModifier="internal"
                        Style="{StaticResource SectionPanel}" Margin="5,8,5,5" Padding="14,12">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource SdZoneTag}" Text="{loc:Str sd_zone_takeaway}"/>
                            <Border Grid.Column="1" Style="{StaticResource SdZoneRule}">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="{DynamicResource PinkColor}" Offset="0"/>
                                        <GradientStop Color="Transparent" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <TextBlock Grid.Column="2" x:Name="TxtTakeawayCount" x:FieldModifier="internal"
                                       Style="{StaticResource SdZoneHint}" Text=""/>
                        </Grid>

                        <!-- THE STRIP. A DockPanel because the line needs a flexible middle: the
                             right-hand doors are docked and get their width FIRST, the order
                             chips take what is left. Docked children claim their edge in
                             declaration order, so the Catalogue chip is declared first to sit
                             furthest right.

                             That ordering is the whole point of the restructure: the catalogue
                             stays reachable when the shelf is full AND visible when it is empty,
                             which the old bottom-of-page banner could only manage by owning a
                             56px row of its own. -->
                        <DockPanel LastChildFill="True">
                            <Border DockPanel.Dock="Right"
                                    x:Name="SessionDropZone" x:FieldModifier="internal"
                                    Style="{StaticResource SdCatalogueChip}"
                                    ToolTip="{loc:Str tooltip_open_catalogue}"
                                    MouseLeftButtonUp="CatalogueCard_Click">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <helpers:EmojiTextBlock x:Name="DropZoneIcon" x:FieldModifier="internal"
                                                            Text="🌐" FontSize="13" VerticalAlignment="Center"
                                                            Margin="0,0,7,0"
                                                            Foreground="{DynamicResource SessionSrcImportedBrush}"/>
                                    <TextBlock Text="{loc:Str label_catalogue_card_title}"
                                               FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                                               Foreground="{DynamicResource SessionSrcImportedBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- Export of the SELECTED session. Rehomed from the catalogue banner
                                 with its handler and its enable-on-select contract intact
                                 (MainWindow.SessionIO.SelectSession flips IsEnabled). It sits on
                                 this strip rather than in the header band because it acts on the
                                 rack's selection, not on the page.

                                 #961: it says "Export session", not "Export". Sharing a strip with
                                 the Takeaway chips made a bare "Export" read as "export this
                                 takeaway" - which it can never do, because a takeaway is a JustDrop
                                 order code (replayed on click, shared with the link chip), not a
                                 session file. Naming the object is the whole fix. -->
                            <Button DockPanel.Dock="Right" x:Name="BtnExportSession" x:FieldModifier="internal"
                                    Content="{loc:Str btn_export_session}" Click="BtnExportSession_Click"
                                    IsEnabled="False" Style="{StaticResource OutlineButton}"
                                    Padding="12,5" FontSize="11" Margin="0,0,7,0" VerticalAlignment="Center"
                                    ToolTip="{loc:Str tooltip_export_session}"/>

                            <!-- Import ticker. Collapsed until ShowDropZoneStatus has something;
                                 it is the drag-drop system's only feedback surface, so it moved
                                 here rather than being dropped with the banner. -->
                            <TextBlock DockPanel.Dock="Right" x:Name="DropZoneStatus" x:FieldModifier="internal" Text=""
                                       FontSize="11" FontFamily="Consolas" VerticalAlignment="Center"
                                       MaxWidth="240" Margin="10,0,10,0" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource PinkBrush}" Visibility="Collapsed"/>

                            <!-- The fill. Clipped rather than wrapped or scrolled: on a narrow
                                 window the last pinned chip is cut, and everything is still one
                                 click away in the tray. A wrapping strip would push the rack
                                 down a line every time an order arrived. -->
                            <Grid ClipToBounds="True">
                                <StackPanel x:Name="TakeawayShelf" x:FieldModifier="internal"
                                            Orientation="Horizontal"/>
                            </Grid>
                        </DockPanel>

                        <!-- THE TRAY. Collapsed on every repaint (see PaintTakeawayShelf) - an
                             expander that remembers being open would push the rack down on every
                             tab visit. MaxHeight rather than Height so five orders do not reserve
                             the room for thirty. -->
                        <Border x:Name="TakeawayTrayHost" x:FieldModifier="internal"
                                Visibility="Collapsed" Margin="0,9,0,0" MaxHeight="150">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="TakeawayTray" x:FieldModifier="internal"/>
                            </ScrollViewer>
                        </Border>

                        <!-- Only ever seen when there are no orders AND the Just Drop door is
                             withheld, i.e. a fresh install or someone signed out. With the door
                             up, the door chip is the empty state and this stays collapsed. -->
                        <TextBlock x:Name="TxtTakeawayEmpty" x:FieldModifier="internal"
                                   Text="{loc:Str sd_takeaway_empty}" Visibility="Collapsed"
                                   Foreground="{DynamicResource TextDimBrush}" FontSize="11.5"
                                   Margin="2,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ============================ SPLITTER ============================ -->
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                          Background="{DynamicResource PanelAccentBrush}" Cursor="SizeWE"/>

            <!-- ============================ RIGHT: detail ============================ -->
            <Border Grid.Column="2" Style="{StaticResource SectionPanel}" Margin="5,8,5,5" Padding="0,0,0,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- ========================= HERO PLATE =========================
                         The three loose header TextBlocks, moved onto a gradient plate
                         so the panel opens on something rather than on an em dash.
                         The session glyph rides inside TxtDetailTitle's own string
                         ("{icon} {name}", set in SessionIO.SelectSession), so the plate
                         needs no new element and no code change to carry art.
                         Corner radius matches SectionPanel's 12 on the top two corners
                         only - it is flush to the panel's head. -->
                    <Border Grid.Row="0" CornerRadius="12,12,0,0" Padding="16,15,16,14"
                            Background="{DynamicResource PanelBgBrush}"
                            BorderThickness="0,0,0,1" BorderBrush="{DynamicResource PanelAccentBrush}">
                        <Grid>
                            <!-- Accent wash on its own layer, same reason as the header band's:
                                 an opaque theme colour cannot be a soft gradient stop. -->
                            <Border Panel.ZIndex="-1" CornerRadius="12,12,0,0" Opacity="0.20"
                                    Margin="-16,-15,-16,-14">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0.9,1">
                                        <GradientStop Color="{DynamicResource PinkColor}" Offset="0"/>
                                        <GradientStop Color="Transparent" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        <StackPanel>
                            <Grid>
                                <helpers:EmojiTextBlock x:Name="TxtDetailTitle" x:FieldModifier="internal"
                                                        Text="{loc:Str label_select_a_preset}"
                                                        Foreground="{DynamicResource TextLightBrush}"
                                                        FontSize="18" FontWeight="Bold" TextWrapping="Wrap"
                                                        Margin="0,0,26,0"/>
                                <Button x:Name="HelpBtnSessionDetails" x:FieldModifier="internal"
                                        Style="{StaticResource HelpButtonStyle}"
                                        HorizontalAlignment="Right" VerticalAlignment="Top" Tag="SessionDetails"/>
                            </Grid>
                            <TextBlock x:Name="TxtDetailSubtitle" x:FieldModifier="internal"
                                       Text="{loc:Str label_click_on_a_preset_or_session_to_see_details}"
                                       Foreground="{DynamicResource TextMutedBrush}" FontSize="11.5"
                                       TextWrapping="Wrap" Margin="0,6,0,0"/>
                            <!-- Catalogue share status badge (preset view) -->
                            <StackPanel x:Name="PresetShareStatusHost" x:FieldModifier="internal"
                                        Orientation="Horizontal" Margin="0,8,0,0"/>
                        </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ================== DETAIL: preset view ================== -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="16,14,16,0"
                                  x:Name="PresetDetailScroller" x:FieldModifier="internal">
                        <StackPanel x:Name="DetailContentPanel">
                            <helpers:EmojiTextBlock x:Name="TxtDetailFlashLabel" x:FieldModifier="internal"
                                                    Style="{StaticResource SdDetailLabel}" Text="{loc:Str section_flash_images}"/>
                            <TextBlock x:Name="TxtDetailFlash" x:FieldModifier="internal"
                                       Style="{StaticResource SdDetailValue}" Text="—"/>

                            <helpers:EmojiTextBlock x:Name="TxtDetailVideoLabel" x:FieldModifier="internal"
                                                    Style="{StaticResource SdDetailLabel}" Text="{loc:Str label_mandatory_videos}"/>
                            <TextBlock x:Name="TxtDetailVideo" x:FieldModifier="internal"
                                       Style="{StaticResource SdDetailValue}" Text="—"/>

                            <helpers:EmojiTextBlock x:Name="TxtDetailSubLabel" x:FieldModifier="internal"
                                                    Style="{StaticResource SdDetailLabel}" Text="{loc:Str section_subliminals_2}"/>
                            <TextBlock x:Name="TxtDetailSubliminal" x:FieldModifier="internal"
                                       Style="{StaticResource SdDetailValue}" Text="—"/>

                            <helpers:EmojiTextBlock Style="{StaticResource SdDetailLabel}" Text="{loc:Str section_audio}"/>
                            <TextBlock x:Name="TxtDetailAudio" x:FieldModifier="internal"
                                       Style="{StaticResource SdDetailValue}" Text="—"/>

                            <helpers:EmojiTextBlock Style="{StaticResource SdDetailLabel}" Text="{loc:Str label_overlays}"/>
                            <TextBlock x:Name="TxtDetailOverlays" x:FieldModifier="internal"
                                       Style="{StaticResource SdDetailValue}" Text="—"/>

                            <helpers:EmojiTextBlock Style="{StaticResource SdDetailLabel}" Text="{loc:Str label_advanced}"/>
                            <TextBlock x:Name="TxtDetailAdvanced" x:FieldModifier="internal"
                                       Style="{StaticResource SdDetailValue}" Text="—"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ================== DETAIL: session view (spoiler-free) ================== -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="16,14,16,0"
                                  x:Name="SessionDetailScroller" x:FieldModifier="internal" Visibility="Collapsed">
                        <StackPanel x:Name="SessionDetailPanel">

                            <!-- The medallion row. Was two centred text pairs in a box plus a
                                 separate difficulty badge floating below; three medallions read
                                 as one stat line instead of three separate statements. All three
                                 value elements keep their old names - SessionIO writes to them
                                 without knowing they moved. -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource SdMedallion}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SdMedLabel}" Text="{loc:Str label_duration}"/>
                                        <TextBlock x:Name="TxtSessionDuration" x:FieldModifier="internal"
                                                   Style="{StaticResource SdMedValue}" Text="{loc:Str label_30_minutes}"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Style="{StaticResource SdMedallion}">
                                    <StackPanel>
                                        <helpers:EmojiTextBlock Style="{StaticResource SdMedLabel}" Text="{loc:Str label_reward}"/>
                                        <TextBlock x:Name="TxtSessionXP" x:FieldModifier="internal"
                                                   Style="{StaticResource SdMedValue}" Text="{loc:Str label_50_xp}"
                                                   Foreground="#90EE90"/>
                                    </StackPanel>
                                </Border>

                                <!-- DifficultyBadge keeps its name: it is the element whose
                                     Background SessionIO retints per difficulty. -->
                                <Border Grid.Column="4" x:Name="DifficultyBadge" Style="{StaticResource SdMedallion}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SdMedLabel}" Text="{loc:Str sd_med_grade}"/>
                                        <TextBlock x:Name="TxtSessionDifficulty" x:FieldModifier="internal"
                                                   Style="{StaticResource SdMedValue}" Text="{loc:Str label_easy_2}"
                                                   FontSize="12.5" Foreground="#FFD700"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <TextBlock x:Name="TxtSessionDescription" x:FieldModifier="internal" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                                       LineHeight="20" Margin="0,0,0,16"
                                       Text="{loc:Str label_let_the_morning_carry_you_away}"/>

                            <!-- Corner GIF option (Gamer Girl) -->
                            <Border x:Name="CornerGifOptionPanel" x:FieldModifier="internal"
                                    Background="{DynamicResource SurfaceBgBrush}"
                                    BorderBrush="{DynamicResource PanelAccentBrush}" BorderThickness="1"
                                    CornerRadius="10" Padding="12" Margin="0,0,0,13" Visibility="Collapsed">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock x:Name="TxtFeatureCornerGif" x:FieldModifier="internal"
                                                   Text="{loc:Str label_corner_gif}" Foreground="{DynamicResource PinkBrush}"
                                                   FontWeight="Bold" FontSize="11.5"/>
                                        <CheckBox x:Name="ChkCornerGifEnabled" x:FieldModifier="internal"
                                                  Style="{StaticResource ToggleStyle}"
                                                  HorizontalAlignment="Right" Checked="ChkCornerGifEnabled_Changed"
                                                  Unchecked="ChkCornerGifEnabled_Changed"/>
                                    </Grid>
                                    <TextBlock x:Name="TxtCornerGifDesc" x:FieldModifier="internal"
                                               Text="{loc:Str label_place_a_subtle_gif_in_a_screen_corner}"
                                               Foreground="{DynamicResource TextMutedBrush}" FontSize="11"
                                               Margin="0,5,0,0" TextWrapping="Wrap"/>

                                    <StackPanel x:Name="CornerGifSettings" x:FieldModifier="internal"
                                                Visibility="Collapsed" Margin="0,10,0,0">
                                        <Button x:Name="BtnSelectCornerGif" x:FieldModifier="internal"
                                                Content="{loc:Str btn_select_gif}"
                                                Style="{StaticResource OutlineButton}" Padding="10,6" FontSize="10.5"
                                                Margin="0,0,0,10" Click="BtnSelectCornerGif_Click"/>
                                        <TextBlock Text="{loc:Str label_position}" Foreground="{DynamicResource TextMutedBrush}"
                                                   FontSize="11" Margin="0,0,0,5"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <RadioButton x:Name="RbCornerTL" x:FieldModifier="internal" Content="{loc:Str btn_top_left}"
                                                         Foreground="{DynamicResource TextLightBrush}"
                                                         GroupName="CornerPos" Margin="0,2" FontSize="10.5" Checked="RbCornerPos_Checked"/>
                                            <RadioButton x:Name="RbCornerTR" x:FieldModifier="internal" Grid.Column="1" Content="{loc:Str btn_top_right}"
                                                         Foreground="{DynamicResource TextLightBrush}"
                                                         GroupName="CornerPos" Margin="0,2" FontSize="10.5" Checked="RbCornerPos_Checked"/>
                                            <RadioButton x:Name="RbCornerBL" Grid.Row="1" Content="{loc:Str btn_bottom_left}"
                                                         Foreground="{DynamicResource TextLightBrush}"
                                                         GroupName="CornerPos" Margin="0,2" FontSize="10.5" IsChecked="True" Checked="RbCornerPos_Checked"/>
                                            <RadioButton x:Name="RbCornerBR" x:FieldModifier="internal" Grid.Row="1" Grid.Column="1" Content="{loc:Str btn_bottom_right}"
                                                         Foreground="{DynamicResource TextLightBrush}"
                                                         GroupName="CornerPos" Margin="0,2" FontSize="10.5" Checked="RbCornerPos_Checked"/>
                                        </Grid>

                                        <TextBlock Text="{loc:Str label_size}" Foreground="{DynamicResource TextMutedBrush}"
                                                   FontSize="11" Margin="0,10,0,4"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="50"/>
                                            </Grid.ColumnDefinitions>
                                            <Slider x:Name="SliderCornerGifSize" x:FieldModifier="internal" Minimum="100" Maximum="600" Value="300"
                                                    VerticalAlignment="Center" ValueChanged="SliderCornerGifSize_ValueChanged"/>
                                            <TextBlock x:Name="TxtCornerGifSize" x:FieldModifier="internal" Grid.Column="1" Text="{loc:Str label_300px}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" VerticalAlignment="Center"
                                                       HorizontalAlignment="Right"/>
                                        </Grid>

                                        <TextBlock Text="{loc:Str label_opacity}" Foreground="{DynamicResource TextMutedBrush}"
                                                   FontSize="11" Margin="0,10,0,4"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="50"/>
                                            </Grid.ColumnDefinitions>
                                            <Slider x:Name="SliderCornerGifOpacity" x:FieldModifier="internal" Minimum="5" Maximum="100" Value="20"
                                                    VerticalAlignment="Center" ValueChanged="SliderCornerGifOpacity_ValueChanged"/>
                                            <TextBlock x:Name="TxtCornerGifOpacity" x:FieldModifier="internal" Grid.Column="1" Text="20%"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" VerticalAlignment="Center"
                                                       HorizontalAlignment="Right"/>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- The veil. Diagonal weave rather than a flat plate: it should read
                                 as something drawn OVER the details, which is what it is. -->
                            <Border CornerRadius="10" Padding="13" Margin="0,0,0,13"
                                    Background="{DynamicResource SurfaceBgBrush}"
                                    BorderThickness="1" BorderBrush="{DynamicResource NeonPurpleTransparent20Brush}">
                                <Grid>
                                    <!-- Purple-to-pink wash on its own layer. Both stops are mod
                                         theme colours, so the veil re-tints with the active mod
                                         instead of staying Bambi purple on a drone build. -->
                                    <Border Panel.ZIndex="-1" CornerRadius="10" Opacity="0.22" Margin="-13">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="{DynamicResource NeonPurpleColor}" Offset="0"/>
                                                <GradientStop Color="Transparent" Offset="0.55"/>
                                                <GradientStop Color="{DynamicResource PinkColor}" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                <StackPanel>
                                    <TextBlock Text="{loc:Str label_mystery_experience}" Foreground="{DynamicResource TextLightBrush}"
                                               FontWeight="Bold" FontSize="12.5" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{loc:Str label_the_magic_works_best_when_you_don_t_know_what}"
                                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextAlignment="Center"
                                               TextWrapping="Wrap" Margin="0,6,0,0" FontStyle="Italic"/>
                                </StackPanel>
                                </Grid>
                            </Border>

                            <Button x:Name="BtnRevealSpoilers" x:FieldModifier="internal" Content="{loc:Str btn_reveal_details}"
                                    Style="{StaticResource OutlineButton}" Padding="12,8" FontSize="12"
                                    Click="BtnRevealSpoilers_Click" Margin="0,0,0,13"
                                    ToolTip="{loc:Str tooltip_this_will_show_all_session_settings_spoils_th}"/>

                            <!-- Spoiler content, hidden by default. -->
                            <StackPanel x:Name="SessionSpoilerPanel" x:FieldModifier="internal" Visibility="Collapsed">
                                <Border CornerRadius="8" Padding="10" Margin="0,0,0,13"
                                        Background="{DynamicResource SurfaceBgBrush}"
                                        BorderThickness="1" BorderBrush="{DynamicResource DangerBrush}">
                                    <TextBlock Text="{loc:Str label_spoilers_below}" Foreground="{DynamicResource DangerBrush}"
                                               FontFamily="Consolas" FontSize="11.5"
                                               FontWeight="Bold" HorizontalAlignment="Center"/>
                                </Border>

                                <helpers:EmojiTextBlock x:Name="TxtSessionFlashLabel" x:FieldModifier="internal"
                                                        Style="{StaticResource SdDetailLabel}" Text="{loc:Str section_flash_images}"/>
                                <TextBlock x:Name="TxtSessionFlash" x:FieldModifier="internal"
                                           Style="{StaticResource SdDetailValue}" Text="—"/>

                                <helpers:EmojiTextBlock x:Name="TxtSessionSubLabel" x:FieldModifier="internal"
                                                        Style="{StaticResource SdDetailLabel}" Text="{loc:Str section_subliminals_2}"/>
                                <TextBlock x:Name="TxtSessionSubliminal" x:FieldModifier="internal"
                                           Style="{StaticResource SdDetailValue}" Text="—"/>

                                <helpers:EmojiTextBlock Style="{StaticResource SdDetailLabel}" Text="{loc:Str section_audio}"/>
                                <TextBlock x:Name="TxtSessionAudio" x:FieldModifier="internal"
                                           Style="{StaticResource SdDetailValue}" Text="—"/>

                                <helpers:EmojiTextBlock Style="{StaticResource SdDetailLabel}" Text="{loc:Str label_overlays}"/>
                                <TextBlock x:Name="TxtSessionOverlays" x:FieldModifier="internal"
                                           Style="{StaticResource SdDetailValue}" Text="—"/>

                                <helpers:EmojiTextBlock Style="{StaticResource SdDetailLabel}" Text="{loc:Str label_extras}"/>
                                <TextBlock x:Name="TxtSessionExtras" x:FieldModifier="internal"
                                           Style="{StaticResource SdDetailValue}" Text="—"/>

                                <helpers:EmojiTextBlock Style="{StaticResource SdDetailLabel}" Text="{loc:Str label_timeline}"/>
                                <TextBlock x:Name="TxtSessionTimeline" x:FieldModifier="internal"
                                           Style="{StaticResource SdDetailValue}" Text="—"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ================== ACTION FLOOR ==================
                         Both action stacks live in the same row so the primary button
                         sits at the same height whichever mode the panel is in. -->
                    <StackPanel Grid.Row="2" x:Name="PresetButtonsPanel" x:FieldModifier="internal" Margin="16,12,16,0">
                        <Button x:Name="BtnLoadPreset" x:FieldModifier="internal" Content="{loc:Str btn_load_preset}"
                                Style="{StaticResource PinkButton}"
                                Margin="0,0,0,7" Padding="12,11" FontSize="13" Click="BtnLoadPreset_Click" IsEnabled="False"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BtnSaveOverPreset" x:FieldModifier="internal" Grid.Column="0" Content="{loc:Str btn_save_2}"
                                    Style="{StaticResource OutlineButton}" Margin="0,0,3,0" Padding="10,8"
                                    Click="BtnSaveOverPreset_Click" IsEnabled="False" FontSize="12"/>
                            <Button x:Name="BtnDeletePreset" x:FieldModifier="internal" Grid.Column="1" Content="{loc:Str btn_delete_2}"
                                    Style="{StaticResource OutlineButton}" Margin="3,0,0,0" Padding="10,8"
                                    Click="BtnDeletePreset_Click" IsEnabled="False" FontSize="12"/>
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BtnExportPreset" x:FieldModifier="internal" Grid.Column="0" Content="{loc:Str btn_export_preset}"
                                    Style="{StaticResource OutlineButton}" Margin="0,0,3,0" Padding="10,8"
                                    Click="BtnExportPreset_Click" IsEnabled="False" FontSize="12"/>
                            <Button x:Name="BtnSharePreset" x:FieldModifier="internal" Grid.Column="1" Content="{loc:Str btn_share_to_catalogue}"
                                    Style="{StaticResource OutlineButton}" Margin="3,0,0,0" Padding="10,8"
                                    Click="BtnSharePreset_Click" IsEnabled="False" FontSize="12"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Row="2" x:Name="SessionButtonsPanel" x:FieldModifier="internal"
                                Margin="16,12,16,0" Visibility="Collapsed">
                        <Button x:Name="BtnStartSession" x:FieldModifier="internal" Content="{loc:Str btn_start_session}"
                                Style="{StaticResource PinkButton}"
                                Padding="12,13" FontSize="14" Click="BtnStartSession_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
