<UserControl x:Class="ConditioningControlPanel.Views.Tabs.DiscordTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:helpers="clr-namespace:ConditioningControlPanel.Helpers"
             xmlns:ctrl="clr-namespace:ConditioningControlPanel.Views.Controls"
             xmlns:fx="clr-namespace:ConditioningControlPanel.Controls"
             xmlns:hover="clr-namespace:ConditioningControlPanel.Behaviors"
             xmlns:loc="clr-namespace:ConditioningControlPanel.Localization"
             mc:Ignorable="d"
             d:DesignHeight="620" d:DesignWidth="1460">

    <!-- ================================================================
         PROFILE — "The Trainer Card"  (redesign Phase 1, "Reclaim")

         Three strata, borrowing the Velvet Vault's room/scrim language:
           1. The room   — flat #12101F ground under a vertical scrim.
           2. The hero   — full-width Trainer Card: banner + 104px avatar
                           (OG ring untouched), identity, XP bar, gold
                           LEVEL/RANK plates, Customize + Privacy buttons.
           3. The shelf  — The Record (ledger) | Showcase (pins + all) |
                           Community rail (search, chips, teaser plates).

         Rules honoured here:
           • Every x:Name MainWindow's partials write to is preserved, and
             the whole sharing column moved verbatim into
             Views/Controls/ProfilePrivacyPanel.xaml — DiscordTabView
             re-exposes those controls as passthrough properties, so no
             MainWindow partial had to change.
           • De-blurple: #5865F2 survives ONLY on Discord-specific chips
             (the "Message on Discord" button here, the connection card and
             Join-server CTA in the privacy dialog).
           • The rotating OG border is left exactly as it shipped, clock and
             all (MainWindow.ProfileFx owns when it turns).
           • The Record + Showcase columns mirror ProfileCardWrapper's
             visibility via ElementName binding, so a cleared/failed search
             empties them without a line of code. The Community rail is
             deliberately OUTSIDE that group: the search box must stay
             reachable when no card is shown.
         ================================================================ -->

    <Border CornerRadius="12" ClipToBounds="True" Background="#12101F"
            BorderBrush="#33B478FF" BorderThickness="1">
        <Grid>
            <!-- 1. The room -->
            <Border>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#D91B1733" Offset="0"/>
                        <GradientStop Color="#A612101F" Offset="0.3"/>
                        <GradientStop Color="#C41A1430" Offset="0.7"/>
                        <GradientStop Color="#F012101F" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <!-- ProfileColumnStack is the entrance-stagger host (MainWindow.ProfileFx): its
                     direct children are the tab's cards. -->
                <StackPanel x:Name="ProfileColumnStack" x:FieldModifier="internal" Margin="22,18,22,20">

                    <!-- ===================== header ===================== -->
                    <Grid Margin="2,0,2,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{loc:Str profile_tab_heading}"
                                   FontFamily="/Fonts/#Fredoka, Segoe UI" FontWeight="SemiBold"
                                   FontSize="25" Foreground="White" VerticalAlignment="Center">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="#FF69B4" BlurRadius="18" ShadowDepth="0" Opacity="0.8"/>
                            </TextBlock.Effect>
                        </TextBlock>

                        <!-- "back to me" chip: only up while a searched profile is on screen -->
                        <Button x:Name="BtnProfileBackToMe" x:FieldModifier="internal" Grid.Column="1"
                                Visibility="Collapsed" Margin="14,2,0,0" Padding="12,4"
                                Background="#33B478FF" Foreground="#E7DEFF" BorderThickness="0"
                                FontSize="11" FontWeight="SemiBold" Cursor="Hand"
                                VerticalAlignment="Center"
                                Content="{loc:Str profile_back_to_me}"
                                ToolTip="{loc:Str profile_back_to_me_tip}"
                                Click="BtnViewMyProfile_Click"/>

                        <Button Grid.Column="3" x:Name="HelpBtnDiscordProfile" x:FieldModifier="internal"
                                Style="{StaticResource HelpButtonStyle}" HorizontalAlignment="Right"
                                Tag="DiscordProfile"/>
                    </Grid>

                    <!-- Link-your-account notice. Up only while no Discord is linked
                         (MainWindow.Browser.cs UpdateDiscordTabUI). The Privacy panel's own
                         "Not Connected" line cannot do this job: that panel lives inside the
                         Privacy DIALOG, so a logged-out user opening this tab never sees it -
                         which is how the only feedback they got was an unrelated Rich Presence
                         modal. Inline and quiet on purpose; the tab still shows the local card
                         underneath, so this informs rather than blocks. -->
                    <Border x:Name="ProfileLinkNotice" x:FieldModifier="internal" Visibility="Collapsed"
                            Background="#22212A44" BorderBrush="#5865F2" BorderThickness="1"
                            CornerRadius="10" Padding="14,11" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" VerticalAlignment="Center" TextWrapping="Wrap"
                                       Text="{loc:Str profile_link_discord_notice}"
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                            <Button Grid.Column="1" x:Name="BtnProfileLinkNotice" x:FieldModifier="internal"
                                    Content="{loc:Str btn_link_discord_2}" Background="#5865F2"
                                    Foreground="White" BorderThickness="0" Padding="15,8" Margin="12,0,0,0"
                                    FontWeight="Bold" FontSize="11" Cursor="Hand"
                                    Click="BtnDiscordTabLogin_Click"/>
                        </Grid>
                    </Border>

                    <!-- ===================== 2. the hero ===================== -->
                    <Grid x:Name="ProfileCardWrapper" x:FieldModifier="internal" Visibility="Collapsed"
                          Margin="0,0,0,14">

                        <!-- OG animated border (behind the card) — untouched from the original -->
                        <Border x:Name="OgBorderContainer" x:FieldModifier="internal" Visibility="Collapsed" Padding="0" CornerRadius="18">
                            <Border.Resources>
                                <Storyboard x:Key="OgBorderAnimation" RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetName="OgBorderRotation"
                                                     Storyboard.TargetProperty="Angle"
                                                     From="0" To="360" Duration="0:0:3"/>
                                </Storyboard>
                            </Border.Resources>
                            <Border.Background>
                                <LinearGradientBrush x:Name="OgBorderBrush" StartPoint="0,0" EndPoint="1,1">
                                    <LinearGradientBrush.RelativeTransform>
                                        <RotateTransform x:Name="OgBorderRotation" CenterX="0.5" CenterY="0.5" Angle="0"/>
                                    </LinearGradientBrush.RelativeTransform>
                                    <GradientStop Color="#FFD700" Offset="0"/>
                                    <GradientStop Color="#FFA500" Offset="0.25"/>
                                    <GradientStop Color="{DynamicResource PinkColor}" Offset="0.5"/>
                                    <GradientStop Color="#FFA500" Offset="0.75"/>
                                    <GradientStop Color="#FFD700" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <!-- The card itself -->
                        <!-- MinHeight/MaxHeight: the hero is a fixed-band strip like a Discord
                             profile header. Without the cap, the right column's stacked art
                             (tier banner + charm slots) could grow the card past 380px and the
                             banner ImageBrush then filled the whole page. Charms now live on
                             ProfileCharmLayer (overlay, out of layout) so they can never add
                             height again. -->
                        <!-- Band raised a quarter (220/290 -> 275/362) so the square banner art we
                             already ship gives up less of itself to the crop: at ~1390 DIP wide the
                             strip goes from ~6.1:1 to ~4.9:1, so a 1024x1024 banner shows ~20% of
                             its height instead of ~16%. Still inside the 380px ceiling above. The
                             banner keeps cropping from the TOP (AlignmentY.Top,
                             MainWindow.ProfileCosmetics.cs), and the wardrobe stage follows
                             automatically — WardrobeStageGeometry.ForCard reads the live card. -->
                        <Border x:Name="ProfileHeroCard" x:FieldModifier="internal" Margin="8"
                                CornerRadius="14" ClipToBounds="True"
                                MinHeight="275" MaxHeight="362"
                                Background="#EE1A1A2E" BorderBrush="#66FF69B4" BorderThickness="1">
                            <Grid>
                                <!-- Banner: gradient default now, cosmetic art in Phase 2
                                     (ProfileHeroBanner.Background is set to an ImageBrush by the
                                     customization kit).

                                     The art layer is a Border painted with an ImageBrush, NOT an
                                     Image: this Grid sits in a vertical StackPanel inside a
                                     ScrollViewer, so height is unconstrained at measure time and an
                                     Image with Stretch=UniformToFill reports a DesiredSize of
                                     sourceH * cardWidth / sourceW. The art — not the content —
                                     would then drive the card height (a 1024x1024 banner blew the
                                     hero to ~1383px at 1400px wide). A brush paints inside the
                                     arranged bounds and contributes nothing to measure. -->
                                <Border>
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#2A1E4D" Offset="0"/>
                                            <GradientStop Color="#3B2159" Offset="0.5"/>
                                            <GradientStop Color="#1E1E3F" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <Border x:Name="ProfileHeroBanner" x:FieldModifier="internal"
                                        Opacity="0.85" IsHitTestVisible="False"/>
                                <!-- left-dark scrim so identity copy always reads over the banner -->
                                <Border IsHitTestVisible="False">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#F51A1A2E" Offset="0"/>
                                            <GradientStop Color="#D91A1A2E" Offset="0.45"/>
                                            <GradientStop Color="#A61A1A2E" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>

                                <Grid Margin="18,16,18,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- ==== avatar (104px) + presence dot + decoration ====
                                         AdornedAvatar owns all three layers; the avatar brush and
                                         presence dot are re-exposed by the code-behind under their
                                         original names, so MainWindow's ~16 call sites are unchanged.
                                         An equipped decoration is drawn at 104/0.70 = 148px, centred
                                         and unclipped - the 6px margin buys back the room a hat
                                         needs above the head before the hero card's clip. -->
                                    <!-- ==== THE VAT bay ====
                                         The daily-XP meter encases the portrait: a glass specimen
                                         jar whose mod-coloured liquid is today's server-banked XP
                                         (planning/one-descent — the vat is the frame now).

                                         ZERO FOOTPRINT WHEN DARK, and that is the safety property,
                                         not a nicety. The server withholds the `descent` block from
                                         every account outside the rollout dial, and with the jar and
                                         the readout Collapsed this bay measures to exactly the
                                         104px avatar + its 6px margin — the hero renders pixel-for-
                                         pixel as it did before. MainWindow.ProfileVat.cs arms it,
                                         and arming is the ONLY thing that resizes the avatar. -->
                                    <Grid x:Name="ProfileVatBay" x:FieldModifier="internal" Grid.Column="0"
                                          HorizontalAlignment="Left" VerticalAlignment="Top">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0">
                                            <!-- Hover pop on the whole AdornedAvatar, not on its ring:
                                                 the decoration layer is stacked 1:1 over the portrait,
                                                 so scaling the ring alone would slide a hat off the
                                                 head. The control deliberately does not clip, which is
                                                 what lets the 1.06 read at all on a 104px portrait. -->
                                            <ctrl:AdornedAvatar x:Name="ProfileHeroAvatar" x:FieldModifier="internal"
                                                                AvatarSize="104"
                                                                HorizontalAlignment="Left" VerticalAlignment="Top"
                                                                hover:HoverPop.IsEnabled="True"
                                                                Margin="6,6,0,0"/>

                                            <!-- The glass goes OVER the portrait: liquid is 48%
                                                 translucent, so the avatar reads through it exactly
                                                 as the web surface reads through its canvas. -->
                                            <fx:VatGlassCanvas x:Name="ProfileVatGlass" x:FieldModifier="internal"
                                                               Visibility="Collapsed"
                                                               HorizontalAlignment="Left" VerticalAlignment="Top"/>

                                            <!-- THE FAUCET (owner sketch 2026-08-13): a small tap
                                                 perched on the vat's TOP-LEFT lip, spout aimed into
                                                 the jar. It is the Trainer Card's XP hold — earned
                                                 XP waits here (the faucet wobbles) until clicked,
                                                 which pours the whole held delta into the glass.
                                                 MainWindow.ProfileFaucet.cs owns every behavior:
                                                 position (derived from the jar ratios in ArmVat),
                                                 wobble/tilt/hover animations, tooltip text, sfx and
                                                 haptics. Drawn in XAML (no bitmap): metallic grays
                                                 with the app's pink accent on the handle.
                                                 ZIndex -1 tucks it BEHIND the glass (owner call
                                                 2026-08-13) — safe because the canvas is hit-test
                                                 invisible, so hover/click still reach the tap. -->
                                            <Grid x:Name="ProfileVatFaucet" x:FieldModifier="internal"
                                                  Panel.ZIndex="3" Focusable="True"
                                                  Width="40" Height="42" HorizontalAlignment="Left"
                                                  VerticalAlignment="Top" Visibility="Collapsed"
                                                  Cursor="Hand" Background="Transparent"
                                                  RenderTransformOrigin="0.30,0.88">
                                                <!-- IN FRONT OF THE GLASS (pitch "The tap holds",
                                                     2026-08-30), reversing the 2026-08-13 ZIndex -1.
                                                     The tap is now the only way XP reaches the jar,
                                                     so it may not read as scenery tucked behind it.
                                                     Focusable so the CHARGE-HOLD has a keyboard: the
                                                     press-and-hold is the whole gesture, and a
                                                     gesture only a mouse can make is not an
                                                     affordance, it is a wall. -->
                                                <Grid.RenderTransform>
                                                    <TransformGroup>
                                                        <!-- Shiver first: the x-jitter of a charge
                                                             released early must not be rotated by
                                                             the pour tilt. -->
                                                        <TranslateTransform x:Name="ProfileVatFaucetShake" x:FieldModifier="internal"/>
                                                        <ScaleTransform x:Name="ProfileVatFaucetScale" x:FieldModifier="internal"/>
                                                        <RotateTransform x:Name="ProfileVatFaucetTilt" x:FieldModifier="internal"/>
                                                    </TransformGroup>
                                                </Grid.RenderTransform>
                                                <Grid.Resources>
                                                    <LinearGradientBrush x:Key="FaucetMetal" StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#C6CAD6" Offset="0"/>
                                                        <GradientStop Color="#8E93A6" Offset="0.45"/>
                                                        <GradientStop Color="#62677C" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Grid.Resources>

                                                <!-- base flange sitting on the glass lip -->
                                                <Rectangle Width="17" Height="4" RadiusX="1.5" RadiusY="1.5"
                                                           HorizontalAlignment="Left" VerticalAlignment="Top"
                                                           Margin="3,36,0,0" Fill="{StaticResource FaucetMetal}"
                                                           Stroke="#3A2A3E" StrokeThickness="0.6"/>
                                                <!-- riser -->
                                                <Rectangle Width="8" Height="24" RadiusX="2" RadiusY="2"
                                                           HorizontalAlignment="Left" VerticalAlignment="Top"
                                                           Margin="7,13,0,0" Fill="{StaticResource FaucetMetal}"
                                                           Stroke="#3A2A3E" StrokeThickness="0.6"/>
                                                <!-- arm bending right over the jar -->
                                                <Rectangle Width="22" Height="8" RadiusX="3" RadiusY="3"
                                                           HorizontalAlignment="Left" VerticalAlignment="Top"
                                                           Margin="7,9,0,0" Fill="{StaticResource FaucetMetal}"
                                                           Stroke="#3A2A3E" StrokeThickness="0.6"/>
                                                <!-- spout, mouth pointing down into the jar -->
                                                <Path HorizontalAlignment="Left" VerticalAlignment="Top"
                                                      Fill="{StaticResource FaucetMetal}"
                                                      Stroke="#3A2A3E" StrokeThickness="0.6"
                                                      Data="M 23,10 L 31,10 L 31,17 L 29,22 L 25,22 L 23,17 Z"/>
                                                <!-- handle: accent tee on top. DynamicResource, not
                                                     the #FF69B4 literal it was authored with:
                                                     PinkBrush is the mod accent and is rewritten in
                                                     Application.Resources on every mod switch
                                                     (MainWindow.RefreshThemeAwareElements), so the
                                                     one coloured part of the faucet follows the mod
                                                     instead of staying pink under a blue one.
                                                     Its value is #FF69B4 by default (Colors.xaml),
                                                     so the CCP Default look is unchanged. -->
                                                <!-- THE THUD lands on the HANDLE, so both handle parts ride one
                                                     scale together (house book: the thing you pressed
                                                     is the thing that answers). Origin is the tee's
                                                     centre inside this 40x14 strip. -->
                                                <Grid x:Name="ProfileVatHandle" x:FieldModifier="internal"
                                                      Width="40" Height="14" HorizontalAlignment="Left"
                                                      VerticalAlignment="Top" RenderTransformOrigin="0.375,0.29">
                                                    <Grid.RenderTransform>
                                                        <ScaleTransform x:Name="ProfileVatHandleScale" x:FieldModifier="internal"/>
                                                    </Grid.RenderTransform>
                                                    <Rectangle Width="4" Height="7" HorizontalAlignment="Left"
                                                               VerticalAlignment="Top" Margin="13,4,0,0"
                                                               Fill="{StaticResource FaucetMetal}"
                                                               Stroke="#3A2A3E" StrokeThickness="0.5"/>
                                                    <Rectangle Width="13" Height="4.5" RadiusX="2" RadiusY="2"
                                                               HorizontalAlignment="Left" VerticalAlignment="Top"
                                                               Margin="8.5,1,0,0" Fill="{DynamicResource PinkBrush}"
                                                               Stroke="#B44780" StrokeThickness="0.6"/>
                                                </Grid>

                                                <!-- droplet sparkle at the spout while XP is waiting
                                                     (ambient — code gates it on AllowAmbientLoops +
                                                     AllowGlow and animates opacity/translate) -->
                                                <Ellipse x:Name="ProfileVatFaucetDrop" x:FieldModifier="internal"
                                                         Width="4" Height="6" HorizontalAlignment="Left"
                                                         VerticalAlignment="Top" Margin="25,23,0,0"
                                                         Fill="#C8FF9CCF" Opacity="0">
                                                    <Ellipse.RenderTransform>
                                                        <TranslateTransform x:Name="ProfileVatFaucetDropFall" x:FieldModifier="internal"/>
                                                    </Ellipse.RenderTransform>
                                                </Ellipse>

                                                <!-- reduced-motion badge: a still dot saying "XP is
                                                     waiting" when the wobble is not allowed to -->
                                                <Ellipse x:Name="ProfileVatFaucetBadge" x:FieldModifier="internal"
                                                         Width="8" Height="8" HorizontalAlignment="Left"
                                                         VerticalAlignment="Top" Margin="28,2,0,0"
                                                         Fill="#FF69B4" Stroke="#FFF0F7" StrokeThickness="1"
                                                         Visibility="Collapsed"/>
                                            </Grid>

                                            <!-- THE CHARGE RING (pitch "The tap holds", 2026-08-30).
                                                 Press-and-hold fills it around the tap head over
                                                 700ms + held/4 (cap 1400ms) - the budget scales with
                                                 what is waiting, so a big day is worth a longer
                                                 press. Geometry is written per frame by
                                                 MainWindow.ProfileFaucet.BuildChargeArc; under
                                                 reduced motion the arc is replaced by a 120ms
                                                 opacity fade of the full circle (house book law VI:
                                                 collapse the motion, keep the beat). -->
                                            <Grid x:Name="ProfileVatChargeRing" x:FieldModifier="internal"
                                                  Width="34" Height="34" Opacity="0"
                                                  HorizontalAlignment="Left" VerticalAlignment="Top"
                                                  Visibility="Collapsed" IsHitTestVisible="False">
                                                <Ellipse Width="30" Height="30" Stroke="#40FFFFFF" StrokeThickness="2.2"/>
                                                <Path x:Name="ProfileVatChargeArc" x:FieldModifier="internal"
                                                      Stroke="{DynamicResource PinkBrush}" StrokeThickness="2.6"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                            </Grid>

                                            <!-- THE SPARKLE BURST's host: 5-9 motes thrown from the
                                                 spout within 50ms of the thud, then removed. Empty
                                                 and hit-test invisible the rest of the time. -->
                                            <Canvas x:Name="ProfileVatSparks" x:FieldModifier="internal"
                                                    HorizontalAlignment="Left" VerticalAlignment="Top"
                                                    IsHitTestVisible="False"/>

                                            <!-- THE TICK LEGEND: three glyphs sitting on the meter's
                                                 own tick lines, replacing the "?" badge that used to
                                                 be the only words the vat had. A moon on the 20 line
                                                 (the jar empties at midnight), a mortarboard on CAP
                                                 (the cap grows with your level) and a crown on MAX
                                                 (past the lip it is lifetime XP). Positioned by
                                                 MainWindow.ProfileFaucet.PositionVatTickGlyphs from
                                                 the canvas's OWN tick maths, so they cannot drift
                                                 off the lines if the jar is ever retuned. -->
                                            <Path x:Name="ProfileVatTickDrain" x:FieldModifier="internal"
                                                  Width="11" Height="11" Visibility="Collapsed"
                                                  HorizontalAlignment="Left" VerticalAlignment="Top"
                                                  Fill="#B3FFFFFF" Stretch="Uniform" Cursor="Help"
                                                  ToolTipService.InitialShowDelay="150"
                                                  ToolTip="{loc:Str profile_vat_tick_drain}"
                                                  Data="M 7,0.6 A 5,5 0 1 0 7,9.4 A 4,4 0 1 1 7,0.6 Z"/>
                                            <Path x:Name="ProfileVatTickCap" x:FieldModifier="internal"
                                                  Width="12" Height="10" Visibility="Collapsed"
                                                  HorizontalAlignment="Left" VerticalAlignment="Top"
                                                  Fill="#B3FFFFFF" Stretch="Uniform" Cursor="Help"
                                                  ToolTipService.InitialShowDelay="150"
                                                  ToolTip="{loc:Str profile_vat_tick_cap}"
                                                  Data="M 0,3.4 L 6,0.7 L 12,3.4 L 6,6.1 Z M 2.8,4.9 L 2.8,8.2 L 9.2,8.2 L 9.2,4.9 L 6,6.4 Z"/>
                                            <Path x:Name="ProfileVatTickMax" x:FieldModifier="internal"
                                                  Width="12" Height="10" Visibility="Collapsed"
                                                  HorizontalAlignment="Left" VerticalAlignment="Top"
                                                  Fill="#B3FFFFFF" Stretch="Uniform" Cursor="Help"
                                                  ToolTipService.InitialShowDelay="150"
                                                  ToolTip="{loc:Str profile_vat_tick_max}"
                                                  Data="M 0,8.4 L 1,1.4 L 4,5 L 6,0.7 L 8,5 L 11,1.4 L 12,8.4 Z"/>

                                            <!-- THE CHIP - the screen's ONE breather (house book law
                                                 III) and the vat's primary explainer now that the
                                                 "?" badge is gone. Gold, so it reads as "something is
                                                 owed to you" rather than as chrome; it is on screen
                                                 only while XP is actually waiting, which is what
                                                 makes a slow 2.8s breath on it a signal instead of
                                                 noise. Ambient-gated: under reduced motion it simply
                                                 sits there, and it still says the number. -->
                                            <Border x:Name="ProfileVatChip" x:FieldModifier="internal"
                                                    Visibility="Collapsed" CornerRadius="8"
                                                    HorizontalAlignment="Center" VerticalAlignment="Top"
                                                    Padding="7,2,7,2.5" Cursor="Help"
                                                    BorderBrush="#FFF3D0" BorderThickness="1"
                                                    RenderTransformOrigin="0.5,0.5"
                                                    ToolTipService.InitialShowDelay="150"
                                                    ToolTipService.ShowDuration="60000">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="#FFE49A" Offset="0"/>
                                                        <GradientStop Color="#E9A93B" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <Border.RenderTransform>
                                                    <ScaleTransform x:Name="ProfileVatChipScale" x:FieldModifier="internal"/>
                                                </Border.RenderTransform>
                                                <Border.Effect>
                                                    <DropShadowEffect Color="#000000" BlurRadius="6" ShadowDepth="1" Opacity="0.45"/>
                                                </Border.Effect>
                                                <TextBlock x:Name="ProfileVatChipText" x:FieldModifier="internal"
                                                           Foreground="#3B2A08" FontSize="9.5" FontWeight="Bold"
                                                           VerticalAlignment="Center"/>
                                                <Border.ToolTip>
                                                    <ToolTip MaxWidth="340">
                                                        <TextBlock Text="{loc:Str profile_vat_help_tip}"
                                                                   TextWrapping="Wrap" MaxWidth="320"/>
                                                    </ToolTip>
                                                </Border.ToolTip>
                                            </Border>
                                        </Grid>

                                        <!-- Banked XP, the total that fills today's jar, and the
                                             percent. Owner ask 2026-08-16: the cap
                                             is level scaled, so a percent on its own never says how
                                             big today's jar actually is. Both halves are written by
                                             MainWindow.ProfileVat.UpdateVatReadout from the DRAWN
                                             fill, so the number walks up with the pour instead of
                                             jumping ahead of it. Deliberately ONE line: the bay's
                                             height budget (see VatJarHeight) has no room for a
                                             second, and the tooltip carries the "XP to fill" wording.
                                             Text is set from code; the Width is set by ArmVat. -->
                                        <TextBlock x:Name="ProfileVatReadout" x:FieldModifier="internal" Grid.Row="1"
                                                   Visibility="Collapsed" HorizontalAlignment="Center"
                                                   TextAlignment="Center"
                                                   Margin="0,3,0,0" FontFamily="Consolas, Courier New" FontSize="10"
                                                   FontWeight="Bold" Foreground="{DynamicResource PinkBrush}"
                                                   ToolTipService.InitialShowDelay="200"
                                                   ToolTipService.ShowDuration="20000"/>
                                    </Grid>

                                    <!-- ==== identity ==== -->
                                    <StackPanel Grid.Column="1" Margin="16,0,14,0" VerticalAlignment="Top">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="TxtProfileViewerName" x:FieldModifier="internal" Text="{loc:Str login_display_name}"
                                                       FontFamily="/Fonts/#Fredoka, Segoe UI" FontWeight="SemiBold"
                                                       Foreground="White" FontSize="23" TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"/>
                                            <Button x:Name="BtnChangeDisplayName" x:FieldModifier="internal" Visibility="Collapsed"
                                                    Width="24" Height="24" Margin="8,2,0,0"
                                                    Background="Transparent" BorderThickness="0"
                                                    Cursor="Hand" VerticalAlignment="Center"
                                                    ToolTip="{loc:Str tooltip_change_display_name}"
                                                    Click="BtnChangeDisplayName_Click">
                                                <helpers:EmojiTextBlock Text="{loc:Str label_text}" Foreground="#B9B0D6" FontSize="14" VerticalAlignment="Center"/>
                                            </Button>
                                            <Button x:Name="BtnDeleteProfile" x:FieldModifier="internal" Visibility="Collapsed"
                                                    Width="24" Height="24" Margin="2,2,0,0"
                                                    Background="Transparent" BorderThickness="0"
                                                    Cursor="Hand" VerticalAlignment="Center"
                                                    ToolTip="{loc:Str tooltip_delete_your_profile}"
                                                    Click="BtnDeleteProfile_Click">
                                                <helpers:EmojiTextBlock Text="{loc:Str label_text_2}" Foreground="#FF5C7A" FontSize="13" VerticalAlignment="Center"/>
                                            </Button>
                                        </StackPanel>

                                        <!-- earned badges: OG banner + Patreon plates -->
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <Border x:Name="OgBannerBadge" x:FieldModifier="internal" Visibility="Collapsed"
                                                    Padding="8,3" CornerRadius="9" VerticalAlignment="Center" Margin="0,0,8,0">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="#FFD700" Offset="0"/>
                                                        <GradientStop Color="#FFA500" Offset="0.5"/>
                                                        <GradientStop Color="{DynamicResource PinkColor}" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <TextBlock Text="{loc:Str label_og_good_girl}" Foreground="{DynamicResource DarkerBgBrush}" FontSize="10" FontWeight="ExtraBold"
                                                           FontFamily="Segoe UI" VerticalAlignment="Center"/>
                                            </Border>
                                            <!-- STAFF: dark pill, crimson->gold gradient border (inverse of the
                                                 OG pill's gradient-fill look so the two never read as one). -->
                                            <Border x:Name="StaffBadge" x:FieldModifier="internal" Visibility="Collapsed"
                                                    Padding="8,3" CornerRadius="9" BorderThickness="1.5"
                                                    Background="#CC1A1226" VerticalAlignment="Center" Margin="0,0,8,0">
                                                <Border.BorderBrush>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#FF5C7A" Offset="0"/>
                                                        <GradientStop Color="#FFD700" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.BorderBrush>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="🛠" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                    <TextBlock x:Name="StaffBadgeLabel" x:FieldModifier="internal"
                                                               Text="{loc:Str label_badge_staff}" Foreground="#FFB3C2" FontSize="10"
                                                               FontWeight="ExtraBold" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <!-- WHITELISTED: dark pill, cyan->pink gradient border. -->
                                            <Border x:Name="WhitelistBadge" x:FieldModifier="internal" Visibility="Collapsed"
                                                    Padding="8,3" CornerRadius="9" BorderThickness="1.5"
                                                    Background="#CC0F1A26" VerticalAlignment="Center" Margin="0,0,8,0">
                                                <Border.BorderBrush>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#5EC8F2" Offset="0"/>
                                                        <GradientStop Color="{DynamicResource PinkColor}" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.BorderBrush>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="⚗" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                    <TextBlock Text="{loc:Str label_badge_whitelist}" Foreground="#A9E4FF" FontSize="10"
                                                               FontWeight="ExtraBold" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <Image x:Name="ProfilePatreonTierBadge" x:FieldModifier="internal" Height="30" Width="30"
                                                   Margin="0,0,6,0" VerticalAlignment="Center" Visibility="Collapsed" Stretch="Uniform"/>
                                            <Image x:Name="ProfilePatreonBadge" x:FieldModifier="internal" Height="26"
                                                   VerticalAlignment="Center" Visibility="Collapsed" Stretch="Uniform"/>
                                        </StackPanel>

                                        <!-- equipped title (Phase 2 cosmetics; an unlocked achievement's name) -->
                                        <TextBlock x:Name="TxtProfileEquippedTitle" x:FieldModifier="internal"
                                                   Visibility="Collapsed" Foreground="#FFD700" FontSize="12"
                                                   FontWeight="SemiBold" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>

                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <Ellipse Width="7" Height="7" Fill="#43B581" VerticalAlignment="Center" Margin="0,1,6,0"/>
                                            <TextBlock x:Name="TxtProfileViewerOnline" x:FieldModifier="internal" Text="{loc:Str label_online}"
                                                       Foreground="#43B581" FontSize="11" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <!-- Discord-specific chip: blurple is allowed here. -->
                                        <Button x:Name="BtnProfileDiscord" x:FieldModifier="internal" Visibility="Collapsed"
                                                Background="#5865F2" Foreground="White" BorderThickness="0"
                                                Padding="10,5" Margin="0,10,0,0" Cursor="Hand"
                                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                                Click="BtnProfileDiscord_Click"
                                                ToolTip="{loc:Str tooltip_open_discord_profile}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <StackPanel Orientation="Horizontal">
                                                <Image Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center"
                                                       Source="{Binding Source='💬', Converter={StaticResource EmojiToImageSource}}"/>
                                                <TextBlock x:Name="TxtProfileDiscordId" x:FieldModifier="internal" Text="{loc:Str label_message_on_discord}"
                                                           Foreground="White" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- XP bar. The fill is a star-width column, so it needs no
                                             ActualWidth maths and survives any resize. -->
                                        <Grid Margin="0,14,0,0" MaxWidth="420" HorizontalAlignment="Left" Width="380">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Border Grid.Row="0" Height="10" CornerRadius="5" Background="#33FFFFFF">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition x:Name="ProfileXpFillCol" x:FieldModifier="internal" Width="0*"/>
                                                        <ColumnDefinition x:Name="ProfileXpRestCol" x:FieldModifier="internal" Width="1*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" CornerRadius="5">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                <GradientStop Color="#FF69B4" Offset="0"/>
                                                                <GradientStop Color="#B478FF" Offset="1"/>
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                            <StackPanel Grid.Row="1" Orientation="Horizontal">
                                                <TextBlock x:Name="TxtProfileXpProgress" x:FieldModifier="internal"
                                                           Text="0 / 0 XP" Foreground="#B8B1CC" FontSize="11" Margin="0,5,0,0"
                                                           VerticalAlignment="Center"/>

                                                <!-- THE DESCENT RECEIPT (v6.9.1). The migration
                                                     ceremony asks an irreversible question once and
                                                     then closes; this is the only place the answer
                                                     is ever shown again, which is the bug it exists
                                                     to close. Dark pill with a gradient border - the
                                                     WHITELISTED badge's build, because it is a mark
                                                     and not a button, and it must not compete with
                                                     the two gold plates across the card.

                                                     YOUR CARD ONLY, and only after the server has
                                                     acked a choice. Everything about it is painted by
                                                     MainWindow.ProfileCard.RefreshProfileDescentReceipt,
                                                     which runs off SetProfileViewingSelf so a searched
                                                     card can never wear your ceremony. -->
                                                <Border x:Name="ProfileDescentReceipt" x:FieldModifier="internal"
                                                        Visibility="Collapsed" Cursor="Help"
                                                        Padding="8,2,8,2.5" CornerRadius="8" BorderThickness="1"
                                                        Background="#CC1A1226" Margin="10,5,0,0"
                                                        VerticalAlignment="Center"
                                                        ToolTipService.InitialShowDelay="150"
                                                        ToolTipService.ShowDuration="30000">
                                                    <Border.BorderBrush>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                            <GradientStop Color="{DynamicResource PinkColor}" Offset="0"/>
                                                            <GradientStop Color="#B478FF" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.BorderBrush>
                                                    <TextBlock x:Name="ProfileDescentReceiptText" x:FieldModifier="internal"
                                                               Foreground="#E7DEFF" FontSize="9.5" FontWeight="Bold"
                                                               FontFamily="Segoe UI" VerticalAlignment="Center"/>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>

                                    <!-- ==== plates + card actions ==== -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Top" HorizontalAlignment="Right">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <!-- SHARE PROFILE (owner ask 2026-08-16): the prominent door to
                                                 the public profile page the web shipped. Theme PinkButton, so
                                                 it is the one ringed pink CTA in the row and follows the mod
                                                 accent; FontSize/Padding are pulled down to the row's scale.

                                                 IT OPENS THE DASHBOARD'S SHARING PAGE, NOT /u/&lt;slug&gt;, and that
                                                 is deliberate: the desktop app holds no slug at all (see
                                                 MainWindow.TabNavigation.ProfileSharingUrl), so the web page
                                                 that already owns "here is your link, copy it, open it, rotate
                                                 it" is the only honest destination. Disabled while signed out,
                                                 with a tooltip that says why, exactly like the rest of the
                                                 account gated UI on this tab. -->
                                            <Button x:Name="BtnProfileShare" x:FieldModifier="internal"
                                                    Style="{StaticResource PinkButton}"
                                                    FontSize="11" Padding="14,6" BorderThickness="1"
                                                    Margin="0,0,8,0" VerticalAlignment="Center"
                                                    ToolTipService.ShowOnDisabled="True"
                                                    ToolTip="{loc:Str profile_btn_share_tip}"
                                                    Click="BtnProfileShare_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <Image Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center"
                                                           Source="{Binding Source='🔗', Converter={StaticResource EmojiToImageSource}}"/>
                                                    <TextBlock Text="{loc:Str profile_btn_share}" Foreground="White"
                                                               FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>

                                            <!-- Phase 2: opens the customization kit, which always edits YOUR
                                                 loadout. Both this and Privacy below are therefore self-only -
                                                 SetProfileViewingSelf (MainWindow.ProfileCard.cs) collapses the
                                                 pair while somebody else's card is on screen, so neither can
                                                 read as an offer to edit a stranger's profile (bug #1113). -->
                                            <Button x:Name="BtnProfileCustomize" x:FieldModifier="internal"
                                                    Content="{loc:Str profile_btn_customize}"
                                                    Background="#33B478FF" Foreground="#E7DEFF" BorderThickness="0"
                                                    Padding="14,6" Margin="0,0,8,0" FontSize="11" FontWeight="SemiBold"
                                                    Cursor="Hand" ToolTip="{loc:Str profile_btn_customize_tip}"
                                                    Click="BtnProfileCustomize_Click"/>
                                            <Button x:Name="BtnProfilePrivacy" x:FieldModifier="internal"
                                                    Content="{loc:Str profile_btn_privacy}"
                                                    Background="#FF69B4" Foreground="#1A1A2E" BorderThickness="0"
                                                    Padding="14,6" FontSize="11" FontWeight="Bold" Cursor="Hand"
                                                    ToolTip="{loc:Str profile_btn_privacy_tip}"
                                                    Click="BtnProfilePrivacy_Click"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                                            <Border CornerRadius="10" Padding="16,6" Margin="0,0,8,0"
                                                    Background="#26FFD700" BorderBrush="#59FFD700" BorderThickness="1">
                                                <StackPanel>
                                                    <TextBlock Text="{loc:Str label_level_2}" Foreground="#D8C88A" FontSize="9" FontWeight="Bold"
                                                               HorizontalAlignment="Center"/>
                                                    <TextBlock x:Name="TxtProfileViewerLevel" x:FieldModifier="internal" Text="1"
                                                               Foreground="#FFD700" FontSize="30" FontWeight="ExtraBold"
                                                               HorizontalAlignment="Center" Margin="0,-4,0,0"/>
                                                </StackPanel>
                                            </Border>
                                            <Border CornerRadius="10" Padding="16,6"
                                                    Background="#26FFD700" BorderBrush="#59FFD700" BorderThickness="1">
                                                <StackPanel>
                                                    <TextBlock Text="{loc:Str label_rank}" Foreground="#D8C88A" FontSize="9" FontWeight="Bold"
                                                               HorizontalAlignment="Center"/>
                                                    <TextBlock x:Name="TxtProfileViewerRank" x:FieldModifier="internal" Text="#-"
                                                               Foreground="#FFD700" FontSize="30" FontWeight="ExtraBold"
                                                               HorizontalAlignment="Center" Margin="0,-4,0,0"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- ==== THE SPIRAL plate ====
                                                 The Descent's door on the Trainer Card, beside the two
                                                 gold plates but deliberately NOT gold: LEVEL and RANK are
                                                 the leaderboard's currency, the spiral is the descent's,
                                                 so it wears the mod accent (DynamicResource - it repaints
                                                 on a mod switch, and so does the glyph inside it).

                                                 ZERO FOOTPRINT WHEN DARK, the same safety property the
                                                 vat bay above carries: the server withholds the `descent`
                                                 block from every account outside the rollout dial, and
                                                 Collapsed means the plate row measures exactly as it did
                                                 before this existed. MainWindow.ProfileSpiral.cs is the
                                                 only thing that ever shows it, and it shows it only for
                                                 a real block on YOUR OWN card - a searched profile's
                                                 descent is not ours to draw. -->
                                            <Border x:Name="ProfileSpiralPlate" x:FieldModifier="internal"
                                                    Visibility="Collapsed" CornerRadius="10" Padding="14,6"
                                                    Margin="8,0,0,0" Cursor="Hand"
                                                    Background="{DynamicResource TransparentPink20Brush}"
                                                    BorderBrush="{DynamicResource PinkSoftBrush}" BorderThickness="1"
                                                    ToolTip="{loc:Str profile_spiral_plate_tip}"
                                                    MouseLeftButtonUp="ProfileSpiralPlate_Click">
                                                <StackPanel>
                                                    <TextBlock Text="{loc:Str profile_spiral_plate}"
                                                               Foreground="{DynamicResource PinkSoftBrush}" FontSize="9"
                                                               FontWeight="Bold" HorizontalAlignment="Center"/>
                                                    <fx:SpiralGlyph x:Name="ProfileSpiralGlyph" x:FieldModifier="internal"
                                                                    Width="44" Height="44" Margin="0,1,0,0"
                                                                    HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <!-- Patreon tier art (Pink filter / Prime subject) -->
                                        <Border x:Name="ProfilePatreonTierBanner" x:FieldModifier="internal" Visibility="Collapsed"
                                                Width="146" Height="84" CornerRadius="8" Margin="0,12,0,0"
                                                HorizontalAlignment="Right" ClipToBounds="True">
                                            <!-- The host's ClipToBounds is the point: the zoom happens
                                                 INSIDE the 146x84 plate, so the art crops rather than
                                                 growing past the card edge. -->
                                            <Image x:Name="ImgPatreonTierBanner" x:FieldModifier="internal" Stretch="Uniform"
                                                   hover:HoverPop.IsEnabled="True"/>
                                        </Border>

                                    </StackPanel>
                                </Grid>

                                <!-- Phase 3 charm layer (max 2, full card only). A Canvas overlay:
                                     charms are free-floating props placed by normalized (x,y)
                                     card-fraction coordinates with the wearer's saved transform
                                     (drag/scale/rotate/flip from the wardrobe editor), so they
                                     never contribute to the card's measured height. Positioned in
                                     code (MainWindow.ProfileWardrobe.cs) on apply and on resize. -->
                                <Canvas x:Name="ProfileCharmLayer" x:FieldModifier="internal"
                                        IsHitTestVisible="False">
                                    <Image x:Name="ProfileCharmSlot1" x:FieldModifier="internal"
                                           Stretch="Uniform" Visibility="Collapsed"
                                           RenderTransformOrigin="0.5,0.5"/>
                                    <Image x:Name="ProfileCharmSlot2" x:FieldModifier="internal"
                                           Stretch="Uniform" Visibility="Collapsed"
                                           RenderTransformOrigin="0.5,0.5"/>
                                </Canvas>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- No profile selected / not found -->
                    <Border x:Name="NoProfileSelected" x:FieldModifier="internal"
                            Background="#B3252542" CornerRadius="12" Padding="30" Margin="0,0,0,14"
                            BorderBrush="#33B478FF" BorderThickness="1">
                        <StackPanel HorizontalAlignment="Center">
                            <Image Width="44" Height="44" HorizontalAlignment="Center" Margin="0,0,0,10"
                                   Source="{Binding Source='👤', Converter={StaticResource EmojiToImageSource}}"/>
                            <TextBlock Text="{loc:Str label_search_for_a_user}" Foreground="{DynamicResource TextMutedBrush}" FontSize="14" HorizontalAlignment="Center"/>
                            <TextBlock Text="{loc:Str label_or_click_my_profile}" Foreground="#8079A3" FontSize="12" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- ===================== 3. the shelf ===================== -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="250"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="258"/>
                        </Grid.ColumnDefinitions>

                        <!-- ========== The Record (ledger) ========== -->
                        <Border Grid.Column="0" x:Name="ProfileShelfRecord" x:FieldModifier="internal"
                                Visibility="{Binding Visibility, ElementName=ProfileCardWrapper}"
                                VerticalAlignment="Top" CornerRadius="12" Padding="14,12,14,10"
                                Background="#B3252542" BorderBrush="#33FF69B4" BorderThickness="1">
                            <StackPanel>
                                <!-- Column headers carry the equipped accent (Phase 2). -->
                                <TextBlock x:Name="TxtProfileRecordHeader" x:FieldModifier="internal"
                                           Text="{loc:Str profile_record_title}"
                                           FontFamily="/Fonts/#Fredoka, Segoe UI" FontWeight="Medium"
                                           FontSize="15" Foreground="White" Margin="0,0,0,10"/>

                                <!-- XP -->
                                <Grid Margin="0,0,0,9">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="34" Height="34" CornerRadius="7" Background="{DynamicResource PanelAccentBrush}">
                                        <Image x:Name="ImgStatXp" x:FieldModifier="internal"
                                               Source="pack://application:,,,/Resources/achievements/lv_10.png" Stretch="Uniform" Margin="2"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{loc:Str label_xp}" Foreground="#B8B1CC" FontSize="11"
                                               VerticalAlignment="Center" Margin="10,0,8,0" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="2" x:Name="TxtProfileViewerXp" x:FieldModifier="internal" Text="0"
                                               Foreground="White" FontSize="15" FontWeight="Bold" FontFamily="Consolas, Courier New"
                                               VerticalAlignment="Center" TextAlignment="Right"/>
                                </Grid>

                                <!-- Bubbles -->
                                <Grid Margin="0,0,0,9">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="34" Height="34" CornerRadius="7" Background="{DynamicResource PanelAccentBrush}">
                                        <Image x:Name="ImgStatBubbles" x:FieldModifier="internal"
                                               Source="pack://application:,,,/Resources/achievements/pop_the_Thought.png" Stretch="Uniform" Margin="2"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{loc:Str label_bubbles_2}" Foreground="#B8B1CC" FontSize="11"
                                               VerticalAlignment="Center" Margin="10,0,8,0" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="2" x:Name="TxtProfileViewerBubbles" x:FieldModifier="internal" Text="0"
                                               Foreground="White" FontSize="15" FontWeight="Bold" FontFamily="Consolas, Courier New"
                                               VerticalAlignment="Center" TextAlignment="Right"/>
                                </Grid>

                                <!-- Video time -->
                                <Grid Margin="0,0,0,9">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="34" Height="34" CornerRadius="7" Background="{DynamicResource PanelAccentBrush}">
                                        <Image x:Name="ImgStatVideos" x:FieldModifier="internal"
                                               Source="pack://application:,,,/Resources/achievements/10_hours_pink.png" Stretch="Uniform" Margin="2"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{loc:Str label_videos}" Foreground="#B8B1CC" FontSize="11"
                                               VerticalAlignment="Center" Margin="10,0,8,0" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="2" x:Name="TxtProfileViewerVideos" x:FieldModifier="internal" Text="{loc:Str label_0h}"
                                               Foreground="White" FontSize="15" FontWeight="Bold" FontFamily="Consolas, Courier New"
                                               VerticalAlignment="Center" TextAlignment="Right"/>
                                </Grid>

                                <!-- Flashes -->
                                <Grid Margin="0,0,0,9">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="34" Height="34" CornerRadius="7" Background="{DynamicResource PanelAccentBrush}">
                                        <Image x:Name="ImgStatGifs" x:FieldModifier="internal"
                                               Source="pack://application:,,,/Resources/achievements/retinal_burn.png" Stretch="Uniform" Margin="2"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{loc:Str label_flashes}" Foreground="#B8B1CC" FontSize="11"
                                               VerticalAlignment="Center" Margin="10,0,8,0" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="2" x:Name="TxtProfileViewerGifs" x:FieldModifier="internal" Text="0"
                                               Foreground="White" FontSize="15" FontWeight="Bold" FontFamily="Consolas, Courier New"
                                               VerticalAlignment="Center" TextAlignment="Right"/>
                                </Grid>

                                <!-- Lock cards -->
                                <Grid Margin="0,0,0,9">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="34" Height="34" CornerRadius="7" Background="{DynamicResource PanelAccentBrush}">
                                        <Image x:Name="ImgStatLockCards" x:FieldModifier="internal"
                                               Source="pack://application:,,,/Resources/achievements/total_lockdown.png" Stretch="Uniform" Margin="2"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{loc:Str label_lock_cards_2}" Foreground="#B8B1CC" FontSize="11"
                                               VerticalAlignment="Center" Margin="10,0,8,0" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="2" x:Name="TxtProfileViewerLockCards" x:FieldModifier="internal" Text="0"
                                               Foreground="White" FontSize="15" FontWeight="Bold" FontFamily="Consolas, Courier New"
                                               VerticalAlignment="Center" TextAlignment="Right"/>
                                </Grid>

                                <!-- Achievements -->
                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="34" Height="34" CornerRadius="7" Background="{DynamicResource PanelAccentBrush}">
                                        <Image x:Name="ImgStatAchievements" x:FieldModifier="internal"
                                               Source="pack://application:,,,/Resources/achievements/spiral_eyes.png" Stretch="Uniform" Margin="2"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{loc:Str label_achievements}" Foreground="#B8B1CC" FontSize="11"
                                               VerticalAlignment="Center" Margin="10,0,8,0" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="2" x:Name="TxtProfileViewerAchievements" x:FieldModifier="internal" Text="0"
                                               Foreground="White" FontSize="15" FontWeight="Bold" FontFamily="Consolas, Courier New"
                                               VerticalAlignment="Center" TextAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ========== Showcase ========== -->
                        <Border Grid.Column="2" x:Name="ProfileShelfShowcase" x:FieldModifier="internal"
                                Visibility="{Binding Visibility, ElementName=ProfileCardWrapper}"
                                VerticalAlignment="Top" CornerRadius="12" Padding="16,12,16,14"
                                Background="#B3252542" BorderBrush="#33B478FF" BorderThickness="1">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <TextBlock x:Name="TxtProfileShowcaseHeader" x:FieldModifier="internal"
                                               Text="{loc:Str profile_showcase_title}"
                                               FontFamily="/Fonts/#Fredoka, Segoe UI" FontWeight="Medium"
                                               FontSize="15" Foreground="White"/>
                                    <TextBlock Text="{loc:Str profile_showcase_hint}" Foreground="#8079A3" FontSize="11"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Up to 4 pinned achievements at full size. Phase 2's customization
                                     kit sets the ItemsSource from cosmetics.pinned_achievements. -->
                                <ItemsControl x:Name="ProfilePinnedShowcase" x:FieldModifier="internal">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <!-- Left-click = unpin (own card only; quick path
                                                 beside the Customize dialog's pin picker). -->
                                            <Grid Width="88" Height="88" Margin="0,0,10,10"
                                                  Background="Transparent" Cursor="Hand"
                                                  MouseLeftButtonUp="ProfileAchievementTile_Click">
                                                <Border CornerRadius="10" Background="{DynamicResource PanelAccentBrush}"
                                                        BorderBrush="#59FFD700" BorderThickness="1" ToolTip="{Binding Name}">
                                                    <!-- The 7px margin is the pop's headroom: 6% of a
                                                         74px badge is ~4px, so the zoom stays inside
                                                         the rounded plate without needing a clip. -->
                                                    <Image Source="{Binding Image}" Stretch="Uniform" Margin="7"
                                                           hover:HoverPop.IsEnabled="True"/>
                                                </Border>
                                                <TextBlock Text="★" Foreground="#FFD700" FontSize="14"
                                                           HorizontalAlignment="Right" VerticalAlignment="Top"
                                                           Margin="0,3,6,0"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Empty pin slots, shown until something is pinned -->
                                <StackPanel x:Name="ProfilePinnedPlaceholders" x:FieldModifier="internal" Orientation="Horizontal">
                                    <Border Width="88" Height="88" Margin="0,0,10,10" CornerRadius="10"
                                            Background="#26FFFFFF" BorderBrush="#33FFD700" BorderThickness="1">
                                        <TextBlock Text="☆" Foreground="#59FFD700" FontSize="26"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Border Width="88" Height="88" Margin="0,0,10,10" CornerRadius="10"
                                            Background="#26FFFFFF" BorderBrush="#33FFD700" BorderThickness="1">
                                        <TextBlock Text="☆" Foreground="#59FFD700" FontSize="26"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Border Width="88" Height="88" Margin="0,0,10,10" CornerRadius="10"
                                            Background="#26FFFFFF" BorderBrush="#33FFD700" BorderThickness="1">
                                        <TextBlock Text="☆" Foreground="#59FFD700" FontSize="26"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Border Width="88" Height="88" Margin="0,0,10,10" CornerRadius="10"
                                            Background="#26FFFFFF" BorderBrush="#33FFD700" BorderThickness="1">
                                        <TextBlock Text="☆" Foreground="#59FFD700" FontSize="26"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="{loc:Str profile_showcase_pins_empty}" Foreground="#8079A3"
                                               FontSize="11" FontStyle="Italic" VerticalAlignment="Center"
                                               TextWrapping="Wrap" Margin="4,0,0,10" MaxWidth="180"/>
                                </StackPanel>

                                <!-- Everything else, folded away -->
                                <Expander x:Name="ProfileAllAchievementsExpander" x:FieldModifier="internal"
                                          Style="{StaticResource CollapsibleCard}" IsExpanded="False"
                                          Margin="0,2,0,0">
                                    <Expander.Header>
                                        <TextBlock x:Name="TxtProfileAllAchievementsHeader" x:FieldModifier="internal"
                                                   Text="{loc:Str profile_showcase_all}" Foreground="White"
                                                   FontSize="12" FontWeight="SemiBold"/>
                                    </Expander.Header>
                                    <StackPanel Margin="12,0,12,12">
                                        <ItemsControl x:Name="ProfileAchievementGrid" x:FieldModifier="internal">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <!-- Left-click = pin/unpin (this grid only ever
                                                         shows the viewer's own unlocks). -->
                                                    <Border Width="46" Height="46" Margin="3" CornerRadius="7"
                                                            Background="{DynamicResource PanelAccentBrush}" ToolTip="{Binding Name}"
                                                            Cursor="Hand"
                                                            MouseLeftButtonUp="ProfileAchievementTile_Click">
                                                        <Image Source="{Binding Image}" Stretch="Uniform" Margin="3"
                                                               hover:HoverPop.IsEnabled="True"/>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock x:Name="TxtNoAchievements" x:FieldModifier="internal" Text="{loc:Str label_no_achievements_yet}"
                                                   Foreground="#8079A3" FontSize="11" FontStyle="Italic"
                                                   HorizontalAlignment="Center" Visibility="Collapsed"/>
                                    </StackPanel>
                                </Expander>

                                <!-- Unlock progress + what is next -->
                                <Border Height="8" CornerRadius="4" Background="#33FFFFFF" Margin="0,8,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition x:Name="ProfileUnlockFillCol" x:FieldModifier="internal" Width="0*"/>
                                            <ColumnDefinition x:Name="ProfileUnlockRestCol" x:FieldModifier="internal" Width="1*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" CornerRadius="4">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#B478FF" Offset="0"/>
                                                    <GradientStop Color="#FFD700" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                    </Grid>
                                </Border>
                                <Grid Margin="0,6,0,0">
                                    <TextBlock x:Name="TxtProfileUnlockSummary" x:FieldModifier="internal"
                                               Foreground="#B8B1CC" FontSize="11"/>
                                    <TextBlock x:Name="TxtProfileNextUp" x:FieldModifier="internal"
                                               Foreground="#8079A3" FontSize="11" HorizontalAlignment="Right"
                                               TextTrimming="CharacterEllipsis" MaxWidth="320"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ========== Community rail ========== -->
                        <Border Grid.Column="4" VerticalAlignment="Top" CornerRadius="12" Padding="14,12,14,12"
                                Background="#B3252542" BorderBrush="#33FF69B4" BorderThickness="1">
                            <StackPanel>
                                <TextBlock x:Name="TxtProfileCommunityHeader" x:FieldModifier="internal"
                                           Text="{loc:Str profile_community_title}"
                                           FontFamily="/Fonts/#Fredoka, Segoe UI" FontWeight="Medium"
                                           FontSize="15" Foreground="White" Margin="0,0,0,10"/>

                                <!-- Search. The 1px border is transparent at rest and brightens on
                                     focus (MainWindow.ProfileFx owns the brush). -->
                                <Border x:Name="ProfileSearchBox" x:FieldModifier="internal"
                                        Background="{DynamicResource SurfaceBgBrush}" CornerRadius="8"
                                        BorderThickness="1" Padding="8" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="TxtProfileSearch" x:FieldModifier="internal" Background="Transparent" BorderThickness="0" Foreground="White"
                                                 FontSize="12" VerticalAlignment="Center" KeyDown="TxtProfileSearch_KeyDown">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox">
                                                    <Style.Triggers>
                                                        <Trigger Property="Text" Value="">
                                                            <Setter Property="Background">
                                                                <Setter.Value>
                                                                    <VisualBrush Stretch="None" AlignmentX="Left">
                                                                        <VisualBrush.Visual>
                                                                            <TextBlock Text="{loc:Str label_search_by_display_name}" Foreground="#6C6590" FontSize="12" Margin="2,0,0,0"/>
                                                                        </VisualBrush.Visual>
                                                                    </VisualBrush>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                        <Button Grid.Column="1" Content="🔍" Background="Transparent" BorderThickness="0"
                                                Foreground="#FF69B4" FontSize="14" Cursor="Hand" Click="BtnProfileSearch_Click"
                                                ToolTip="{loc:Str tooltip_search_profile}"/>
                                    </Grid>
                                </Border>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <Button Content="{loc:Str btn_my_profile}" Background="#33FF69B4" Foreground="#FFD7EB"
                                            BorderThickness="0" Padding="10,4" Margin="0,0,6,0" FontSize="11"
                                            FontWeight="SemiBold" Cursor="Hand" Click="BtnViewMyProfile_Click"/>
                                    <Button Content="{loc:Str btn_clear}" Background="#26FFFFFF" Foreground="#B8B1CC"
                                            BorderThickness="0" Padding="10,4" FontSize="11" Cursor="Hand"
                                            Click="BtnClearProfile_Click"/>
                                </StackPanel>

                                <!-- Friends: teaser plates only. No backend ships in this phase —
                                     the Vault's coming-soon pattern, so the rail never reads as
                                     broken. -->
                                <TextBlock Text="{loc:Str profile_friends_title}" Foreground="#B478FF"
                                           FontSize="12" FontWeight="Bold" Margin="0,0,0,8"/>
                                <Border Height="46" CornerRadius="9" Margin="0,0,0,7"
                                        Background="#1FFFFFFF" BorderBrush="#1FB478FF" BorderThickness="1">
                                    <Grid Margin="9,0,9,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Grid.Column="0" Width="28" Height="28" Fill="#33B478FF" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                            <Border Height="8" Width="96" CornerRadius="4" Background="#26FFFFFF" HorizontalAlignment="Left"/>
                                            <Border Height="6" Width="62" CornerRadius="3" Background="#1AFFFFFF" HorizontalAlignment="Left" Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Height="46" CornerRadius="9" Margin="0,0,0,7"
                                        Background="#1AFFFFFF" BorderBrush="#1FB478FF" BorderThickness="1">
                                    <Grid Margin="9,0,9,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Grid.Column="0" Width="28" Height="28" Fill="#2BFF69B4" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                            <Border Height="8" Width="78" CornerRadius="4" Background="#22FFFFFF" HorizontalAlignment="Left"/>
                                            <Border Height="6" Width="50" CornerRadius="3" Background="#17FFFFFF" HorizontalAlignment="Left" Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Height="46" CornerRadius="9" Margin="0,0,0,10"
                                        Background="#14FFFFFF" BorderBrush="#1FB478FF" BorderThickness="1">
                                    <Grid Margin="9,0,9,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Grid.Column="0" Width="28" Height="28" Fill="#26FFD700" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                            <Border Height="8" Width="88" CornerRadius="4" Background="#1FFFFFFF" HorizontalAlignment="Left"/>
                                            <Border Height="6" Width="42" CornerRadius="3" Background="#14FFFFFF" HorizontalAlignment="Left" Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border CornerRadius="9" Padding="10,7" Margin="0,0,0,14"
                                        Background="#1FB478FF" BorderBrush="#33B478FF" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Str profile_friends_soon_title}" Foreground="#E7DEFF"
                                                   FontSize="11" FontWeight="Bold"/>
                                        <TextBlock Text="{loc:Str profile_friends_soon_body}" Foreground="#9A93B8"
                                                   FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Sharing footer -->
                                <Rectangle Height="1" Fill="#1FFFFFFF" Margin="0,0,0,9"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" x:Name="TxtProfileSharingSummary" x:FieldModifier="internal"
                                               Foreground="#9A93B8" FontSize="11" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                    <Button Grid.Column="1" x:Name="BtnProfilePrivacyGear" x:FieldModifier="internal"
                                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                                            Padding="6,2" ToolTip="{loc:Str profile_btn_privacy_tip}"
                                            Click="BtnProfilePrivacy_Click">
                                        <Image Width="16" Height="16"
                                               Source="{Binding Source='⚙️', Converter={StaticResource EmojiToImageSource}}"/>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
