<UserControl x:Class="ConditioningControlPanel.Views.Tabs.QuestsTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:helpers="clr-namespace:ConditioningControlPanel.Helpers"
             xmlns:hover="clr-namespace:ConditioningControlPanel.Behaviors"
             xmlns:ctrl="clr-namespace:ConditioningControlPanel.Views.Controls"
             xmlns:loc="clr-namespace:ConditioningControlPanel.Localization"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
        <Grid>
        <Border Style="{StaticResource SectionPanel}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="15">
                    <!-- Sub-tab Navigation -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <Button x:Name="BtnQuestSubDaily" x:FieldModifier="internal" Content="{loc:Str btn_daily_weekly}"
                                Style="{StaticResource TabButtonActive}"
                                Click="BtnQuestSubDaily_Click" Width="120"/>
                        <Button x:Name="BtnQuestSubRoadmap" x:FieldModifier="internal" Content="{loc:Str btn_bimbo_journal}"
                                Style="{StaticResource TabButton}"
                                Click="BtnQuestSubRoadmap_Click" Margin="10,0,0,0" Width="150"/>
                    </StackPanel>
    
                    <!-- Daily/Weekly Quests Panel -->
                    <StackPanel x:Name="DailyWeeklyPanel" x:FieldModifier="internal">
                        <!-- Season Title Banner -->
                        <!-- The Text below is only ever the pre-first-paint placeholder: RefreshQuestUI
                             overwrites it with QuestDefinitionService.SeasonTitle (server title, else the
                             local month name). It must stay season-NEUTRAL - it used to hardcode
                             "Airhead April", so any lost first-paint race showed a long-dead season.
                             Mirrors the same neutral fallback LeaderboardTabView uses. -->
                        <Border Background="{DynamicResource DarkerBgBrush}" CornerRadius="12" Padding="20,14" Margin="0,0,0,18"
                                BorderThickness="1" BorderBrush="#3D3D60">
                            <TextBlock x:Name="TxtSeasonTitle" x:FieldModifier="internal" Text="{loc:Str section_seasons}"
                                       FontSize="28" FontWeight="ExtraBold" FontStyle="Italic"
                                       HorizontalAlignment="Center" TextAlignment="Center">
                                <TextBlock.Foreground>
                                    <LinearGradientBrush x:Name="SeasonTitleBrush" x:FieldModifier="internal" StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop x:Name="SeasonGrad1" Color="{DynamicResource PinkColor}" Offset="0.0"/>
                                        <GradientStop x:Name="SeasonGrad2" Color="#DA70D6" Offset="0.25"/>
                                        <GradientStop x:Name="SeasonGrad3" Color="{DynamicResource DarkPink}" Offset="0.5"/>
                                        <GradientStop x:Name="SeasonGrad4" Color="#DA70D6" Offset="0.75"/>
                                        <GradientStop x:Name="SeasonGrad5" Color="{DynamicResource PinkColor}" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </TextBlock.Foreground>
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="{DynamicResource PinkColor}" BlurRadius="15" ShadowDepth="0" Opacity="0.6"/>
                                </TextBlock.Effect>
                                <!-- Season title shimmer managed in code-behind (StartSeasonTitleShimmer/StopSeasonTitleShimmer) -->
                            </TextBlock>
                        </Border>
    
                        <!-- Header -->
                        <Grid Margin="0,0,0,20">
                            <StackPanel Orientation="Horizontal">
                                <helpers:EmojiTextBlock Text="{loc:Str label_quests}" Foreground="{DynamicResource PinkBrush}" FontSize="18" FontWeight="Bold"/>
                                <Button x:Name="HelpBtnQuests" x:FieldModifier="internal" Style="{StaticResource HelpButtonStyle}" Tag="Quests"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtQuestStats" x:FieldModifier="internal" Text="{loc:Str label_0_completed_this_week}"
                                       Foreground="{DynamicResource TextMutedBrush}" FontSize="12" HorizontalAlignment="Right"
                                       VerticalAlignment="Center"/>
                        </Grid>
    
                        <!-- THE DAILY BOARD.

                             Until 2026-08-27 this row was two columns - one daily card, one weekly
                             card - and the day's three daily quests arrived one after another in
                             that single seat. All three are dealt at once now, so the daily panel
                             takes the full width and holds three cards side by side, and the
                             weekly gets its own full-width panel underneath instead of competing
                             with them for half the row. -->
                        <!-- THE BOARD ROW: three dailies and the weekly, side by side.

                             They were stacked before, and stacked did not survive the dailies going
                             three-up: the daily panel got tall enough that the weekly panel started
                             below the fold, so the tab opened on a screen with no weekly quest on
                             it at all. Nothing was broken and nothing said so - it was simply out of
                             sight, which is the same thing as missing.

                             Side by side, the whole board - 3 + 1, the same 3 + 1 the header stamps
                             show - is on screen at once with no scrolling. The weekly keeps its own
                             panel, its own purple, and its own header; it just stands up vertically
                             now instead of lying down, because a card in a 300px column cannot put
                             its art beside its text. -->
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                        <ContentControl Grid.Column="0" Style="{StaticResource AnimatedGradientPanel}"
                                        BorderThickness="2" BorderBrush="#FFD700">
                            <StackPanel>
                                <!-- Card Header -->
                                <Grid Margin="0,0,0,12">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Width="22" Height="22"
                                               Source="{Binding Source='&#x2600;&#xFE0F;', Converter={StaticResource EmojiToImageSource}}"/>
                                        <TextBlock Text="{loc:Str label_daily_quest}" Foreground="#FFD700"
                                                   FontSize="16" FontWeight="Bold" Margin="8,0,0,0"
                                                   VerticalAlignment="Center"/>
                                        <!-- Daily quest counter badge. Depth wave 10: a RAISED coin
                                             (bevel + sheen over its own colour, a drop band under it,
                                             RaisedPx down). The drop band is hue-tinted by PaintDepthQuests. -->
                                        <Grid Margin="8,0,0,0" VerticalAlignment="Center">
                                            <Border x:Name="DailyCounterDrop" x:FieldModifier="internal" CornerRadius="8"
                                                    Margin="1,3,1,-3" IsHitTestVisible="False"
                                                    Background="{StaticResource DepthDropBand}"/>
                                            <Border x:Name="DailyQuestCounterBadge" x:FieldModifier="internal" Background="#3D3D60" CornerRadius="8"
                                                    BorderBrush="{StaticResource DepthRaisedBevel}" BorderThickness="1">
                                                <Grid>
                                                    <Border CornerRadius="7" IsHitTestVisible="False"
                                                            Background="{StaticResource DepthRaisedSheen}"/>
                                                    <TextBlock x:Name="TxtDailyQuestCounter" x:FieldModifier="internal" Text="0/3"
                                                               Foreground="#FFD700" FontSize="11" FontWeight="Bold" Margin="6,2"/>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                    <TextBlock Text="{loc:Str label_resets_at_midnight}" Foreground="{DynamicResource TextMutedBrush}"
                                               FontSize="11" HorizontalAlignment="Right"
                                               VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Daily Progress Segments. Kept even though three cards now show
                                     their own state each: the segments are the one place that says
                                     "the DAY is 2 of 3 done" rather than "this card is done".

                                     The 14px gutters are NOT a spacing choice - they are the same
                                     gutters DailyCardsGrid uses, so each segment sits exactly over
                                     the seat it is counting. Three equal bars floating across a
                                     panel this wide would read as a stray rule; three bars capping
                                     three columns read as a scoreboard. Same MaxWidth for the same
                                     reason. -->
                                <Grid Margin="0,0,0,4" MaxWidth="800" HorizontalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="DailySegment1" x:FieldModifier="internal" Grid.Column="0" Background="#3D3D60"
                                            CornerRadius="3" Height="6"/>
                                    <Border x:Name="DailySegment2" x:FieldModifier="internal" Grid.Column="2" Background="#3D3D60"
                                            CornerRadius="3" Height="6"/>
                                    <Border x:Name="DailySegment3" x:FieldModifier="internal" Grid.Column="4" Background="#3D3D60"
                                            CornerRadius="3" Height="6"/>
                                </Grid>
                                <TextBlock Text="{loc:Str label_complete_3_daily_quests_1_weekly_quest}"
                                           Foreground="{DynamicResource TextMutedBrush}" FontSize="11"
                                           HorizontalAlignment="Center" Margin="0,0,0,12"/>

                                <!-- The three seats. Painted by MainWindow.RefreshQuestUI; each
                                     card owns its own art, bar, hover FX and reroll button.

                                     CAPPED AT 800 (3 x ~257 + 2 gutters). The panel is as wide as
                                     the tab, and letting three cards stretch into it turns each
                                     quest's square 256x256 art into a letterbox slot that shows a
                                     third of the picture. At the cap each card is ~257 wide against
                                     a 240-tall frame, so the art is very nearly uncropped AND the
                                     whole card - reroll button included - still clears the tab's
                                     viewport without scrolling. A wider cap means a taller square
                                     means a button below the fold; 1020 was tried and did exactly
                                     that. It still shrinks below the cap on a narrow window, where
                                     the columns are what is scarce and the crop is the lesser
                                     problem. -->
                                <!-- Depth wave 10: the seats sit in a SUNKEN well (floor + the
                                     three inner bands, drawn first so the cards float over them),
                                     and each seat is a FLOATING card with its float band under it.
                                     The bottom padding is the room that band takes. A finished
                                     seat drops into the well (QuestsTabView.ApplySeatDone). -->
                                <Border x:Name="DailyWell" x:FieldModifier="internal" CornerRadius="12"
                                        Padding="8,8,8,12" MaxWidth="816" HorizontalAlignment="Center"
                                        Background="{StaticResource DepthWellFloorBrush}">
                                    <Grid>
                                        <Border Height="9" VerticalAlignment="Top" Margin="-8,-8,-8,0" CornerRadius="12,12,0,0"
                                                IsHitTestVisible="False" Background="{StaticResource DepthWellTop}"/>
                                        <Border Width="6" HorizontalAlignment="Left" Margin="-8,-8,0,-12" CornerRadius="12,0,0,12"
                                                IsHitTestVisible="False" Background="{StaticResource DepthWellLeft}"/>
                                        <Rectangle Height="1" VerticalAlignment="Bottom" Margin="4,0,4,-12"
                                                   IsHitTestVisible="False" Fill="{StaticResource DepthWellFoot}"/>
                                <Grid x:Name="DailyCardsGrid" x:FieldModifier="internal"
                                      MaxWidth="800" HorizontalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid x:Name="DailySeat0" x:FieldModifier="internal" Grid.Column="0">
                                        <Border x:Name="DailySeatBand0" x:FieldModifier="internal" Height="12"
                                                VerticalAlignment="Bottom" Margin="6,0,6,-8" CornerRadius="6"
                                                IsHitTestVisible="False" Background="{StaticResource DepthFloatBand}"/>
                                        <ctrl:DailyQuestCard x:Name="DailyCard0" x:FieldModifier="internal"/>
                                    </Grid>
                                    <Grid x:Name="DailySeat1" x:FieldModifier="internal" Grid.Column="2">
                                        <Border x:Name="DailySeatBand1" x:FieldModifier="internal" Height="12"
                                                VerticalAlignment="Bottom" Margin="6,0,6,-8" CornerRadius="6"
                                                IsHitTestVisible="False" Background="{StaticResource DepthFloatBand}"/>
                                        <ctrl:DailyQuestCard x:Name="DailyCard1" x:FieldModifier="internal"/>
                                    </Grid>
                                    <Grid x:Name="DailySeat2" x:FieldModifier="internal" Grid.Column="4">
                                        <Border x:Name="DailySeatBand2" x:FieldModifier="internal" Height="12"
                                                VerticalAlignment="Bottom" Margin="6,0,6,-8" CornerRadius="6"
                                                IsHitTestVisible="False" Background="{StaticResource DepthFloatBand}"/>
                                        <ctrl:DailyQuestCard x:Name="DailyCard2" x:FieldModifier="internal"/>
                                    </Grid>
                                </Grid>
                                    </Grid>
                                </Border>

                                <!-- All Daily Quests Completed Message. A ribbon under the finished
                                     board now, not a card that replaces it - three stamped cards
                                     are worth looking at. -->
                                <Border x:Name="DailyAllCompletedMessage" x:FieldModifier="internal" Background="#2D4A2D" CornerRadius="10"
                                        Padding="15,12" Margin="0,14,0,0" Visibility="Collapsed">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Image Width="34" Height="34" HorizontalAlignment="Center" Margin="0,0,0,6"
                                               Source="{Binding Source='&#x2705;', Converter={StaticResource EmojiToImageSource}}"/>
                                        <TextBlock Text="{loc:Str label_all_daily_quests_completed}" Foreground="#00E676"
                                                   FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"
                                                   Margin="0,0,0,5"/>
                                        <TextBlock Text="{loc:Str label_check_back_tomorrow_for_new_quests}" Foreground="{DynamicResource TextMutedBrush}"
                                                   FontSize="12" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- One shared reroll pool across all three seats, said once here
                                     rather than three times on the buttons. -->
                                <TextBlock x:Name="TxtDailyRerollPool" x:FieldModifier="internal" Text=""
                                           Foreground="{DynamicResource TextMutedBrush}" FontSize="11"
                                           HorizontalAlignment="Center" Margin="0,12,0,0"/>
                            </StackPanel>
                        </ContentControl>

                        <!-- THE WEEKLY, STOOD UP.

                             Same content as before, same x:Names - the paint code in
                             MainWindow.QuestsTab.cs and the bar hook in
                             MainWindow.TabFxPresetsQuestsAchievements.cs both address this by name
                             and neither knows the layout changed. What changed is the axis: art on
                             top with the name and the ask printed on it, then the bar, then the
                             reroll. That is deliberately the same shape as a DailyQuestCard, so the
                             row reads as four quests rather than as three quests and a widget.

                             Fixed 300 wide. It is the sidebar of this row; letting it stretch would
                             take the width back off the dailies, which are the ones that need it. -->
                        <ContentControl Grid.Column="2" Width="300"
                                        Style="{StaticResource AnimatedGradientPanel}"
                                        BorderThickness="2" BorderBrush="#9370DB"
                                        VerticalAlignment="Top">
                            <StackPanel>
                                <!-- Panel header. Stacked, not a two-column Grid: at 300 wide the
                                     title and the reset note will not share a line. -->
                                <StackPanel Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Width="20" Height="20"
                                               Source="{Binding Source='&#x1F319;', Converter={StaticResource EmojiToImageSource}}"/>
                                        <TextBlock Text="{loc:Str label_weekly_quest}" Foreground="#9370DB"
                                                   FontSize="15" FontWeight="Bold" Margin="8,0,0,0"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="{loc:Str label_resets_sunday}" Foreground="{DynamicResource TextMutedBrush}"
                                               FontSize="11" Margin="0,3,0,0"/>
                                </StackPanel>

                                <!-- Quest Content. Depth wave 10: a FLOATING card (float rim + the
                                     float band under it). Done = it DROPS: no band, ActiveSinkPx
                                     down, the pressed bevel (QuestsTabView.ApplyWeeklyDone). -->
                                <Grid x:Name="WeeklySeat" x:FieldModifier="internal">
                                <Border x:Name="WeeklyFloatBand" x:FieldModifier="internal" Height="12"
                                        VerticalAlignment="Bottom" Margin="6,0,6,-8" CornerRadius="6"
                                        IsHitTestVisible="False" Background="{StaticResource DepthFloatBand}"/>
                                <Border x:Name="WeeklyQuestCard" x:FieldModifier="internal" Background="{DynamicResource PanelBgBrush}"
                                        CornerRadius="10" ClipToBounds="True"
                                        BorderBrush="{StaticResource DepthFloatRim}" BorderThickness="1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- ART. Square, like the daily frames and for the same
                                             reason: every file in Resources/quests is 256x256, and
                                             the old 150x150 thumbnail beside the text was the one
                                             part of this card that was already showing the picture
                                             properly. It just showed it small. -->
                                        <Border Grid.Row="0" Height="256" Background="{DynamicResource DarkerBgBrush}"
                                                CornerRadius="9,9,0,0" ClipToBounds="True">
                                            <Grid>
                                                <Image x:Name="ImgWeeklyQuest" x:FieldModifier="internal" Stretch="UniformToFill"
                                                       hover:HoverPop.IsEnabled="True"/>

                                                <!-- Scrim, ramped to near-opaque at the bottom for
                                                     the same reason as the daily cards: the shipped
                                                     art has the quest's name set into that band, and
                                                     it would print underneath this caption. -->
                                                <Border Height="112" VerticalAlignment="Bottom" IsHitTestVisible="False">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                            <GradientStop Color="#00000000" Offset="0"/>
                                                            <GradientStop Color="#8A000000" Offset="0.28"/>
                                                            <GradientStop Color="#FC000000" Offset="0.52"/>
                                                            <GradientStop Color="#FF000000" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>

                                                <!-- Completed. Under the caption, so a finished
                                                     weekly still says which weekly it was. -->
                                                <Border x:Name="WeeklyCompletedOverlay" x:FieldModifier="internal" Background="#992D4A2D"
                                                        Visibility="Collapsed">
                                                    <!-- Depth wave 10: the STAMP. A mint-outlined plate
                                                         rotated -6 degrees, pressed into the art (inner
                                                         shade at its top), static: no animation. Reuses
                                                         btn_done, no new key. -->
                                                    <Grid x:Name="WeeklyDoneStamp" x:FieldModifier="internal"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          Margin="0,0,0,38" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                                                        <Grid.RenderTransform>
                                                            <RotateTransform Angle="-6"/>
                                                        </Grid.RenderTransform>
                                                        <Border CornerRadius="9" BorderBrush="#00E676" BorderThickness="3" Background="#D90B1A12"/>
                                                        <Border CornerRadius="6" Margin="3" IsHitTestVisible="False"
                                                                Background="{StaticResource DepthPressedShade}"/>
                                                        <Border CornerRadius="6" Margin="5" BorderBrush="#6600E676" BorderThickness="1"/>
                                                        <StackPanel Orientation="Horizontal" Margin="18,6,20,8">
                                                            <TextBlock Text="&#x2713;" Foreground="#00E676" FontSize="34"
                                                                       FontFamily="Segoe MDL2 Assets, Segoe UI Symbol, Segoe UI"
                                                                       FontWeight="Bold" VerticalAlignment="Center">
                                                                <TextBlock.Effect>
                                                                    <DropShadowEffect Color="Black" BlurRadius="8" ShadowDepth="2"/>
                                                                </TextBlock.Effect>
                                                            </TextBlock>
                                                            <TextBlock Text="{loc:Str btn_done}" Foreground="#00E676" FontSize="26"
                                                                       FontWeight="ExtraBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>

                                                <!-- XP, on the art. The daily cards put the price
                                                     tag in the same corner. -->
                                                <!-- Depth wave 10: the reward chip is a RAISED coin. -->
                                                <Grid Margin="8" HorizontalAlignment="Right"
                                                      VerticalAlignment="Top" IsHitTestVisible="False">
                                                <Border x:Name="WeeklyXpDrop" x:FieldModifier="internal" CornerRadius="9"
                                                        Margin="1,3,1,-3" Background="{StaticResource DepthDropBand}"/>
                                                <Border x:Name="WeeklyXpChip" x:FieldModifier="internal" Background="#B01A1A2E" CornerRadius="9"
                                                        BorderBrush="{StaticResource DepthRaisedBevel}" BorderThickness="1">
                                                    <Grid>
                                                    <Border CornerRadius="8" Background="{StaticResource DepthRaisedSheen}"/>
                                                    <StackPanel Orientation="Horizontal" Margin="7,2">
                                                        <TextBlock x:Name="TxtWeeklyXP" x:FieldModifier="internal" Text="{loc:Str label_0_xp}"
                                                                   Foreground="{DynamicResource PinkBrush}" FontSize="11"
                                                                   FontWeight="Bold" VerticalAlignment="Center"/>
                                                        <TextBlock x:Name="TxtWeeklyStreakBonus" x:FieldModifier="internal" Text=""
                                                                   Foreground="#FFB347" FontSize="10"
                                                                   FontWeight="Bold" Margin="4,0,0,0"
                                                                   VerticalAlignment="Center"
                                                                   FontFamily="Segoe UI Emoji, Segoe UI Symbol, Segoe UI"
                                                                   Visibility="Collapsed"/>
                                                        <TextBlock x:Name="TxtWeeklyRerollBonus" x:FieldModifier="internal" Text=""
                                                                   Foreground="#7BC8F6" FontSize="10"
                                                                   FontWeight="Bold" Margin="4,0,0,0"
                                                                   VerticalAlignment="Center"
                                                                   Visibility="Collapsed"/>
                                                    </StackPanel>
                                                    </Grid>
                                                </Border>
                                                </Grid>

                                                <!-- CAPTION -->
                                                <StackPanel VerticalAlignment="Bottom" Margin="11,0,11,9" IsHitTestVisible="False">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                        <helpers:EmojiTextBlock x:Name="TxtWeeklyQuestIcon" x:FieldModifier="internal" Text=""
                                                                                FontSize="15" VerticalAlignment="Center"
                                                                                Margin="0,0,6,0" Visibility="Collapsed"/>
                                                        <TextBlock x:Name="TxtWeeklyQuestName" x:FieldModifier="internal" Text="{loc:Str label_loading_2}"
                                                                   Foreground="White" FontSize="14" FontWeight="Bold"
                                                                   TextWrapping="Wrap" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <TextBlock x:Name="TxtWeeklyQuestDesc" x:FieldModifier="internal" Text=""
                                                               Foreground="#D6D6E8" FontSize="11"
                                                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                                               MaxHeight="31"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- BODY: the bar and its count on one line, same as a
                                             daily card. -->
                                        <Grid Grid.Row="1" Margin="11,9,11,11">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <!-- Depth wave 10: a SUNKEN groove (well floor, a top and
                                                 a left inner band under the fill, a lit foot line) and
                                                 a TUBE fill (DepthTubeGloss over the fill colour, a
                                                 DepthTubeBead riding its leading edge). The track's
                                                 width is still the whole fill span: the fill tween in
                                                 MainWindow.TabFxPresetsQuestsAchievements reads it. -->
                                            <Border x:Name="WeeklyProgressTrack" x:FieldModifier="internal" Grid.Column="0"
                                                    Background="{StaticResource DepthWellFloorBrush}" CornerRadius="4"
                                                    Height="10" VerticalAlignment="Center" Margin="0,0,10,0">
                                                <Grid>
                                                    <Border x:Name="WeeklyGrooveTop" x:FieldModifier="internal" Height="4"
                                                            VerticalAlignment="Top" CornerRadius="4,4,0,0" IsHitTestVisible="False"
                                                            Background="{StaticResource DepthWellTop}"/>
                                                    <Border Width="3" HorizontalAlignment="Left" CornerRadius="4,0,0,4"
                                                            IsHitTestVisible="False" Background="{StaticResource DepthWellLeft}"/>
                                                    <Border x:Name="WeeklyProgressFill" x:FieldModifier="internal" Background="#9370DB"
                                                            CornerRadius="4" HorizontalAlignment="Left" Width="0"
                                                            SizeChanged="WeeklyProgressFill_SizeChanged">
                                                        <Grid>
                                                            <Border x:Name="WeeklyTubeGloss" x:FieldModifier="internal" CornerRadius="4"
                                                                    IsHitTestVisible="False" Background="{StaticResource DepthTubeGloss}"/>
                                                            <Ellipse x:Name="WeeklyTubeBead" x:FieldModifier="internal" Width="8" Height="8"
                                                                     HorizontalAlignment="Right" Margin="0,0,1,0" Visibility="Collapsed"
                                                                     IsHitTestVisible="False" Fill="{StaticResource DepthTubeBead}"/>
                                                        </Grid>
                                                    </Border>
                                                    <Rectangle Height="1" VerticalAlignment="Bottom" Margin="3,0,3,0"
                                                               IsHitTestVisible="False" Fill="{StaticResource DepthWellFoot}"/>
                                                </Grid>
                                            </Border>
                                            <TextBlock x:Name="TxtWeeklyProgress" x:FieldModifier="internal" Grid.Column="1" Text="0 / 0"
                                                       Foreground="#9370DB" FontSize="12" FontWeight="Bold"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                                </Grid>

                                <!-- Reroll Button. Stretched, because at 300 wide a left-aligned
                                     button leaves a lopsided gap the dailies do not have. -->
                                <!-- Depth wave 10: a RAISED plank (drop band under it, the bevel
                                     and sheen laid over the button's own outline) that presses:
                                     QuestsTabView.WirePlank moves the face. -->
                                <Grid Margin="0,10,0,0">
                                    <Border x:Name="WeeklyRerollDrop" x:FieldModifier="internal" CornerRadius="8"
                                            Margin="1,3,1,-3" IsHitTestVisible="False"
                                            Background="{StaticResource DepthDropBand}"/>
                                    <Grid x:Name="WeeklyRerollFace" x:FieldModifier="internal">
                                        <Button x:Name="BtnRerollWeekly" x:FieldModifier="internal" Content="{loc:Str btn_reroll}"
                                                Style="{StaticResource OutlineButton}" FontSize="11" Padding="8,4"
                                                HorizontalAlignment="Stretch" Click="BtnRerollWeekly_Click"
                                                ToolTipService.ShowOnDisabled="True"
                                                ToolTip="{loc:Str tooltip_reroll_for_a_different_quest_once_per_week}"/>
                                        <Border x:Name="WeeklyRerollBevel" x:FieldModifier="internal" CornerRadius="8"
                                                BorderThickness="1" IsHitTestVisible="False"
                                                BorderBrush="{StaticResource DepthRaisedBevel}"
                                                Background="{StaticResource DepthRaisedSheen}"/>
                                    </Grid>
                                </Grid>
                            </StackPanel>
                        </ContentControl>
                        </Grid>

                        <!-- Quest Complete Banner (shown briefly when quest completes) -->
                        <Border x:Name="QuestCompleteBanner" x:FieldModifier="internal" Background="#2D4A2D" CornerRadius="10"
                                Padding="15" Margin="0,20,0,0" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Image Width="26" Height="26" Source="{Binding Source='✨', Converter={StaticResource EmojiToImageSource}}"/>
                                <TextBlock x:Name="TxtQuestComplete" x:FieldModifier="internal" Text="{loc:Str label_quest_complete}"
                                           Foreground="#00E676" FontSize="18" FontWeight="Bold"
                                           Margin="10,0" VerticalAlignment="Center"/>
                                <Image Width="26" Height="26" Source="{Binding Source='✨', Converter={StaticResource EmojiToImageSource}}"/>
                            </StackPanel>
                        </Border>
    
                        <!-- Intake Punch Card
                             Eight holes, two rows of four, earned by the Graded Intake. Deliberately
                             wearing the same DarkerBg/10/15,12 shell as the streak calendar below it:
                             both are "here is your long-running progress" strips and they should read
                             as one family, not two competing widgets.

                             The holes themselves are drawn in code-behind (MainWindow.RefreshPunchCard)
                             rather than bound. This tab has no ViewModel and the repo has no
                             bool-to-brush converter, so the DataTrigger idiom used on the leaderboard
                             would mean inventing both before a single circle appeared on screen. The
                             streak calendar directly below already paints itself from code on the same
                             refresh pass - matching it is the smaller, more honest change. -->
                        <Border x:Name="PunchCardPanel" x:FieldModifier="internal" Visibility="Collapsed"
                                Background="{DynamicResource DarkerBgBrush}" CornerRadius="10" Padding="15,12" Margin="0,20,0,0">
                            <StackPanel>
                                <!-- Header: ticket + title on the left, "3 of 8" on the right, mirroring
                                     the streak calendar's title/count header. -->
                                <Grid Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal">
                                        <!-- WPF can't render colour-emoji fonts here, so every emoji on this
                                             tab goes through EmojiToImageSource as an Image. -->
                                        <Image Width="18" Height="18" VerticalAlignment="Center"
                                               Source="{Binding Source='🎟', Converter={StaticResource EmojiToImageSource}}"/>
                                        <TextBlock Text="{loc:Str label_intake_punch_card}" Foreground="White"
                                                   FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock x:Name="TxtPunchCardProgress" x:FieldModifier="internal" Text=""
                                               Foreground="{DynamicResource PinkBrush}" FontSize="13" FontWeight="SemiBold"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- The eight holes, filled row-major by RefreshPunchCard. Rows/Columns are
                                     pinned rather than left to wrap so the card keeps the same footprint at
                                     one hole and at eight - a strip that grows as you fill it loses the
                                     "look how much is left" read that makes a punch card work. -->
                                <UniformGrid x:Name="PunchCardHoles" x:FieldModifier="internal" Rows="2" Columns="4"
                                             HorizontalAlignment="Center" Margin="0,2,0,0"/>

                                <!-- Status line. Does double duty: the half-stamp nudge ("run the session
                                     you drafted"), which is the whole point of the Pending state, and the
                                     card-full note. Hidden the rest of the time so the panel stays quiet
                                     while there is nothing to act on. -->
                                <TextBlock x:Name="TxtPunchCardStatus" x:FieldModifier="internal" Text="" Visibility="Collapsed"
                                           Foreground="#FFD700" FontSize="12" FontWeight="SemiBold"
                                           TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,0"/>

                                <!-- The rules, one sentence. Never names the prize - it is still TBD, and a
                                     promise made here is a promise we would have to keep. -->
                                <TextBlock x:Name="TxtPunchCardRules" x:FieldModifier="internal" Text=""
                                           Foreground="{DynamicResource TextMutedBrush}" FontSize="11"
                                           TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Quest Streak Calendar -->
                        <Border Background="{DynamicResource DarkerBgBrush}" CornerRadius="10" Padding="15,12" Margin="0,20,0,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <helpers:EmojiTextBlock Grid.Column="0" Text="{loc:Str label_quest_streak}" Foreground="White" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtQuestStreakCount" x:FieldModifier="internal" Grid.Column="1" Text="" Foreground="#FFD700"
                                               FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <Grid Grid.Column="2" VerticalAlignment="Center">
                                        <Border x:Name="FixStreakDrop" x:FieldModifier="internal" CornerRadius="8"
                                                Margin="1,3,1,-3" IsHitTestVisible="False"
                                                Visibility="{Binding Visibility, ElementName=BtnFixStreak}"
                                                Background="{StaticResource DepthDropBand}"/>
                                        <Grid x:Name="FixStreakFace" x:FieldModifier="internal">
                                            <Button x:Name="BtnFixStreak" x:FieldModifier="internal" Content="{loc:Str btn_fix_day}"
                                                    Style="{StaticResource OutlineButton}" Padding="8,3" FontSize="11"
                                                    Click="BtnFixStreak_Click" Visibility="Collapsed"
                                                    ToolTipService.ShowOnDisabled="True"/>
                                            <Border x:Name="FixStreakBevel" x:FieldModifier="internal" CornerRadius="8"
                                                    BorderThickness="1" IsHitTestVisible="False"
                                                    Visibility="{Binding Visibility, ElementName=BtnFixStreak}"
                                                    BorderBrush="{StaticResource DepthRaisedBevel}"
                                                    Background="{StaticResource DepthRaisedSheen}"/>
                                        </Grid>
                                    </Grid>
                                </Grid>
                                <Canvas x:Name="StreakCalendarCanvas" x:FieldModifier="internal" Height="50" ClipToBounds="True"
                                       SizeChanged="StreakCalendarCanvas_SizeChanged"/>
                                <helpers:EmojiTextBlock x:Name="TxtFixStreakStatus" x:FieldModifier="internal" Text="" Foreground="{DynamicResource PinkBrush}" FontSize="11"
                                           TextAlignment="Center" Margin="0,5,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>
    
                        <!-- Quest Statistics Section -->
                        <Border Background="{DynamicResource SurfaceBgBrush}" CornerRadius="10" Padding="15" Margin="0,20,0,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,15">
                                    <TextBlock Text="{loc:Str label_quest_statistics}" Foreground="White"
                                               FontSize="14" FontWeight="Bold"/>
                                    <Button x:Name="HelpBtnQuestStats" x:FieldModifier="internal" Style="{StaticResource HelpButtonStyle}" HorizontalAlignment="Right" Tag="QuestStats"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                        <TextBlock x:Name="TxtTotalDailyCompleted" x:FieldModifier="internal" Text="0"
                                                   Foreground="#FFD700" FontSize="24" FontWeight="Bold"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="{loc:Str label_daily_completed}" Foreground="{DynamicResource TextMutedBrush}"
                                                   FontSize="11" HorizontalAlignment="Center" TextAlignment="Center"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                        <TextBlock x:Name="TxtTotalWeeklyCompleted" x:FieldModifier="internal" Text="0"
                                                   Foreground="#9370DB" FontSize="24" FontWeight="Bold"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="{loc:Str label_weekly_completed}" Foreground="{DynamicResource TextMutedBrush}"
                                                   FontSize="11" HorizontalAlignment="Center" TextAlignment="Center"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                        <TextBlock x:Name="TxtTotalQuestXP" x:FieldModifier="internal" Text="0"
                                                   Foreground="{DynamicResource PinkBrush}" FontSize="24" FontWeight="Bold"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="{loc:Str label_total_xp_earned}" Foreground="{DynamicResource TextMutedBrush}"
                                                   FontSize="11" HorizontalAlignment="Center" TextAlignment="Center"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                                        <TextBlock x:Name="TxtStreakFixCharges" x:FieldModifier="internal" Text="0"
                                                   Foreground="#4FC3F7" FontSize="24" FontWeight="Bold"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="{loc:Str label_streak_fixes}" Foreground="{DynamicResource TextMutedBrush}"
                                                   FontSize="11" HorizontalAlignment="Center" TextAlignment="Center"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <!-- End Daily/Weekly Panel -->
    
                    <!-- Bimbo Journal Panel -->
                    <StackPanel x:Name="RoadmapPanel" x:FieldModifier="internal" Visibility="Collapsed">
                        <!-- Journal Header -->
                        <TextBlock Text="{loc:Str label_look_how_far_you_ve_come_sweetie}"
                                   FontSize="26" FontStyle="Italic" FontWeight="Light"
                                   Foreground="#CC88AACC" HorizontalAlignment="Center"
                                   Margin="0,0,0,8" TextAlignment="Center"/>
    
                        <!-- Journal Info Box -->
                        <Border Background="#30FFD700" BorderBrush="#AAFFD700" BorderThickness="1.5"
                                CornerRadius="6" Padding="14,10" Margin="20,0,20,14" MaxWidth="700"
                                HorizontalAlignment="Center">
                            <StackPanel>
                                <helpers:EmojiTextBlock Text="{loc:Str label_what_is_the_bimbo_journal}" Foreground="#FFD700" FontSize="14" FontWeight="Bold" Margin="0,0,0,6"/>
                                <TextBlock TextWrapping="Wrap" Foreground="#DDFFFFFF" FontSize="12" LineHeight="18">
                                    <Run Text="{loc:Str label_each_track_has_steps_that_ask_you_to_take_a_p}"/>
                                    <LineBreak/>
                                    <Run Text="{loc:Str label_click_a_step_take_the_pic_and_upload_it_to_ma}"/>
                                    <LineBreak/>
                                    <Run Text="{loc:Str label_complete_all_steps_in_a_track_to_unlock_the_n}"/>
                                </TextBlock>
                                <TextBlock Foreground="#AAFFD700" FontSize="11" FontStyle="Italic" Margin="0,8,0,0"
                                           Text="{loc:Str label_all_photos_are_stored_locally_on_your_pc_only}"/>
                            </StackPanel>
                        </Border>
    
                        <!-- Track Selector Tabs -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <Button x:Name="BtnTrack1" x:FieldModifier="internal" Content="{loc:Str btn_the_empty_doll}"
                                    Style="{StaticResource TabButtonActive}"
                                    Click="BtnTrack_Click" Tag="EmptyDoll" Width="130"/>
                            <Button x:Name="BtnTrack2" x:FieldModifier="internal" Content="{loc:Str btn_the_obedient_puppet}"
                                    Style="{StaticResource TabButton}"
                                    Click="BtnTrack_Click" Tag="ObedientPuppet" Margin="10,0,0,0" Width="150"/>
                            <Button x:Name="BtnTrack3" x:FieldModifier="internal" Content="{loc:Str btn_the_slutty_blowdoll}"
                                    Style="{StaticResource TabButton}"
                                    Click="BtnTrack_Click" Tag="SluttyBlowdoll" Margin="10,0,0,0" Width="150"/>
                        </StackPanel>
    
                        <!-- Track Info Header -->
                        <Border Background="{DynamicResource SurfaceBgBrush}" CornerRadius="10" Padding="15" Margin="0,0,0,15">
                            <Grid>
                                <Button x:Name="HelpBtnRoadmap" x:FieldModifier="internal" Style="{StaticResource HelpButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Top" Tag="Roadmap"/>
                                <StackPanel>
                                    <TextBlock x:Name="TxtRoadmapTrackName" x:FieldModifier="internal" Text="{loc:Str btn_the_empty_doll}"
                                               Foreground="{DynamicResource PinkBrush}" FontSize="20" FontWeight="Bold"/>
                                    <TextBlock x:Name="TxtRoadmapTrackSubtitle" x:FieldModifier="internal" Text="{loc:Str label_gateway_phase}"
                                               Foreground="{DynamicResource TextMutedBrush}" FontSize="14"/>
                                    <TextBlock x:Name="TxtRoadmapTrackProgress" x:FieldModifier="internal" Text="{loc:Str label_0_7_steps_completed}"
                                               Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,5,0,0"/>
                                </StackPanel>
                                <!-- Badge indicator for final track -->
                                <StackPanel x:Name="BadgeIndicator" x:FieldModifier="internal" Orientation="Horizontal"
                                            HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Visibility="Collapsed">
                                    <Image Width="26" Height="26"
                                           Source="{Binding Source='🏆', Converter={StaticResource EmojiToImageSource}}"/>
                                    <TextBlock Text="{loc:Str label_badge_earned}" Foreground="#FFD700" FontSize="14"
                                               FontWeight="Bold" VerticalAlignment="Center" Margin="5,0,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
    
                        <!-- Locked Track Overlay -->
                        <Border x:Name="TrackLockedOverlay" x:FieldModifier="internal" Background="#CC1A1A2E" CornerRadius="10"
                                Padding="40" Visibility="Collapsed">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Image Width="52" Height="52" HorizontalAlignment="Center" Source="{Binding Source='🔒', Converter={StaticResource EmojiToImageSource}}"/>
                                <TextBlock x:Name="TxtLockReason" x:FieldModifier="internal" Text="{loc:Str label_complete_the_previous_track_to_unlock}"
                                           Foreground="White" FontSize="16" Margin="0,15,0,0"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
    
                        <!-- Horizontal Scrolling Roadmap -->
                        <ContentControl x:Name="RoadmapScrollContainer" x:FieldModifier="internal" Style="{StaticResource AnimatedGradientPanelWide}"
                                MinHeight="220">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                          PreviewMouseWheel="HorizontalScrollViewer_PreviewMouseWheel">
                                <StackPanel x:Name="RoadmapNodesPanel" x:FieldModifier="internal" Orientation="Horizontal" Margin="10,15"/>
                            </ScrollViewer>
                        </ContentControl>
    
                        <!-- Roadmap Statistics -->
                        <Border Background="{DynamicResource SurfaceBgBrush}" CornerRadius="10" Padding="15" Margin="0,15,0,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,15">
                                    <TextBlock Text="{loc:Str label_transformation_progress}" Foreground="White"
                                               FontSize="14" FontWeight="Bold"/>
                                    <Button x:Name="HelpBtnRoadmapStats" x:FieldModifier="internal" Style="{StaticResource HelpButtonStyle}" HorizontalAlignment="Right" Tag="RoadmapStats"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                        <TextBlock x:Name="TxtRoadmapTotalSteps" x:FieldModifier="internal" Text="0 / 21"
                                                   Foreground="{DynamicResource PinkBrush}" FontSize="24" FontWeight="Bold"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="{loc:Str label_steps_completed}" Foreground="{DynamicResource TextMutedBrush}"
                                                   FontSize="11" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                        <TextBlock x:Name="TxtRoadmapPhotos" x:FieldModifier="internal" Text="0"
                                                   Foreground="#9370DB" FontSize="24" FontWeight="Bold"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="{loc:Str label_photos_submitted}" Foreground="{DynamicResource TextMutedBrush}"
                                                   FontSize="11" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                        <TextBlock x:Name="TxtRoadmapJourneyDays" x:FieldModifier="internal" Text="--"
                                                   Foreground="#FFD700" FontSize="24" FontWeight="Bold"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="{loc:Str label_days_on_journey}" Foreground="{DynamicResource TextMutedBrush}"
                                                   FontSize="11" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <!-- End Roadmap Panel -->
                </StackPanel>
            </ScrollViewer>
        </Border>
    
        <!-- Login Required Overlay -->
        <Border x:Name="QuestsLoginOverlay" x:FieldModifier="internal" Background="#E6151528" CornerRadius="12" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40">
                <Image Width="52" Height="52" HorizontalAlignment="Center" Margin="0,0,0,15" Source="{Binding Source='🔒', Converter={StaticResource EmojiToImageSource}}"/>
                <TextBlock Text="{loc:Str label_login_required}" Foreground="{DynamicResource PinkBrush}" FontSize="22" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <TextBlock Text="{loc:Str label_log_in_with_discord_or_patreon_to_access_ques}"
                           Foreground="#AA99AA" FontSize="14" HorizontalAlignment="Center"
                           TextAlignment="Center" TextWrapping="Wrap" MaxWidth="350"/>
            </StackPanel>
        </Border>
        </Grid>
</UserControl>
