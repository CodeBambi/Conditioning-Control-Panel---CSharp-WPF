<UserControl x:Class="ConditioningControlPanel.Views.Tabs.LockdownTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:helpers="clr-namespace:ConditioningControlPanel.Helpers"
             xmlns:hover="clr-namespace:ConditioningControlPanel.Behaviors"
             xmlns:feat="clr-namespace:ConditioningControlPanel.Features"
             xmlns:loc="clr-namespace:ConditioningControlPanel.Localization"
             xmlns:poss="clr-namespace:ConditioningControlPanel.Services.Possession"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">

    <!-- Velvet Kit 2 · round 4. Lockdown's hue is burnt orange: the page is a timed cage, not a
         toy, so it reads warm-but-warning rather than house pink. LOCAL literals only - a fresh
         cross-dictionary StaticResource inserted into Resources/Theme/* trips WPF's deferred-BAML
         EndOfStreamException and takes every styled control down with it. -->
    <UserControl.Resources>
        <SolidColorBrush x:Key="TabHueBrush" Color="#FF8A5C"/>
        <SolidColorBrush x:Key="TabHueBorderBrush" Color="#40FF8A5C"/>
        <LinearGradientBrush x:Key="TabHueWashBrush" StartPoint="0,0" EndPoint="0.9,0.7">
            <GradientStop Color="#14FF8A5C" Offset="0"/>
            <GradientStop Color="#00000000" Offset="0.55"/>
        </LinearGradientBrush>

        <!-- Intensity pills. LOCAL literals only (see the header note): the ember hex is spelled out
             here rather than pulled from a theme dictionary, because a fresh cross-dictionary
             StaticResource is the BAML EndOfStream trap this file already carries a warning about. -->
        <Style x:Key="LockdownPillStyle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFC7A8"/>
            <Setter Property="BorderBrush" Value="#40FF8A5C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,5"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextBlock.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#26FF8A5C"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#FF8A5C"/>
                                <Setter Property="Foreground" Value="#FF8A5C"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#FF8A5C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== EMERGENCY EXIT ================================================================
             The one honest affordance on a haunted page, so it is DRAWN rather than themed: a
             tiled hazard border around a crimson mushroom-button slab. LOCAL literals only, same
             reason as everything else in this dictionary (see the header note).

             The tile is 20x20 and the two figures are each other's wrap, so the diagonal band runs
             unbroken across a border of any thickness or length. -->
        <DrawingBrush x:Key="EEHazardBrush" TileMode="Tile" Stretch="None"
                      Viewport="0,0,20,20" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#1C0810">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,20,20"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#FF8A5C">
                        <GeometryDrawing.Geometry>
                            <PathGeometry Figures="M 0,20 L 20,0 L 20,10 L 10,20 Z"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#FF8A5C">
                        <GeometryDrawing.Geometry>
                            <PathGeometry Figures="M 0,0 L 10,0 L 0,10 Z"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="36,28,36,28">
            <!-- Root grid. LockdownGate is its LAST sibling on purpose: the gate has to cover the
                 hero AND both columns, and RefreshPremiumGate(LockdownTab.LockdownGate) only ever
                 flips its Visibility. -->
            <Grid MaxWidth="1100" HorizontalAlignment="Center" VerticalAlignment="Top">

                <StackPanel>

                    <!-- HERO. Replaces the 44px-emoji header row; the art strip is bound to
                         ImgLockdownFeature.Source (NOT a second hardcoded pack:// URI) so the
                         per-mod art swap in MainWindow.xaml.cs's descImageMap repaints the hero
                         too, from the one assignment it already makes. -->
                    <Border Height="72" CornerRadius="16" Background="{DynamicResource SurfaceBgBrush}"
                            BorderBrush="{StaticResource TabHueBorderBrush}" BorderThickness="2" Margin="0,0,0,10">
                        <Grid>
                            <Border CornerRadius="0,16,16,0" Width="240" HorizontalAlignment="Right">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding Source, ElementName=ImgLockdownFeature}"
                                                Stretch="UniformToFill" AlignmentX="Right" Opacity="0.9"/>
                                </Border.Background>
                                <Border.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#00000000" Offset="0"/>
                                        <GradientStop Color="#E6000000" Offset="0.55"/>
                                    </LinearGradientBrush>
                                </Border.OpacityMask>
                            </Border>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,252,0">
                                <Image Width="30" Height="30" VerticalAlignment="Center" Margin="0,0,12,0"
                                       Source="{Binding Source='🔒', Converter={StaticResource EmojiToImageSource}}"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{loc:Str tab_lockdown_mode}" FontSize="17" FontWeight="Bold"
                                               Foreground="{StaticResource TextLightBrush}"/>
                                    <TextBlock Text="{loc:Str label_lock_yourself_into_a_timed_conditioning_sessi}"
                                               Foreground="{StaticResource TextMutedBrush}" FontSize="11.5"
                                               Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Round-3 capped column + side art. Below 1000px the art column goes to zero
                         and the controls retake the full width: Features/AdaptiveSideArt.cs. -->
                    <Grid feat:AdaptiveSideArt.CollapseBelow="1000">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*" MaxWidth="780"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">

                            <!-- The lockdown card. Its Background AND BorderBrush are code-owned:
                                 ApplyLockdownTheme paints both crimson while a lockdown is running
                                 and RestoreLockdownTheme rebuilds the mod-accent gradient below when
                                 it ends (MainWindow.Lab.cs). So this card deliberately does NOT take
                                 SettingCardStyle - the style's velvet border would survive exactly
                                 one lockdown cycle. The XAML values match what Restore writes. -->
                            <Border x:Name="LockdownCardBorder" x:FieldModifier="internal" CornerRadius="12"
                                    poss:Possession.Role="Card" poss:Possession.Name="the lockdown card"
                                    Padding="0" Margin="0,0,0,10" BorderThickness="2">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#1A1A32" Offset="0"/>
                                        <GradientStop Color="#201A38" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.BorderBrush>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="{DynamicResource PinkColor}" Offset="0"/>
                                        <GradientStop Color="{DynamicResource PatreonPurple}" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.BorderBrush>
                                <Grid>
                                    <Border Background="{StaticResource TabHueWashBrush}" CornerRadius="11"/>
                                    <Border Width="3" HorizontalAlignment="Left" Margin="0,10" CornerRadius="0,2,2,0"
                                            Background="{StaticResource TabHueBrush}"/>
                                    <StackPanel Margin="16,10,16,12">

                                        <!-- Setup Panel (visible when lockdown is NOT active) -->
                                        <StackPanel x:Name="LockdownSetupPanel" x:FieldModifier="internal">
                                            <Grid Height="36" Background="Transparent">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{loc:Str label_duration_2}" FontSize="13"
                                                           FontWeight="SemiBold" Foreground="{StaticResource TextLightBrush}"
                                                           VerticalAlignment="Center"/>
                                                <ComboBox Grid.Column="1" x:Name="CmbLockdownDuration" x:FieldModifier="internal"
                                                          Width="160" SelectedIndex="1" VerticalAlignment="Center" FontSize="13"
                                                          Style="{DynamicResource DarkComboBoxStyle}">
                                                    <ComboBoxItem Content="{loc:Str btn_5_minutes}" Tag="5"/>
                                                    <ComboBoxItem Content="{loc:Str btn_10_minutes}" Tag="10"/>
                                                    <ComboBoxItem Content="{loc:Str btn_15_minutes}" Tag="15"/>
                                                    <ComboBoxItem Content="{loc:Str label_30_minutes}" Tag="30"/>
                                                    <ComboBoxItem Content="{loc:Str btn_60_minutes}" Tag="60"/>
                                                    <ComboBoxItem Content="{loc:Str btn_2_hours}" Tag="120"/>
                                                    <ComboBoxItem Content="{loc:Str btn_4_hours}" Tag="240"/>
                                                </ComboBox>
                                            </Grid>

                                            <Border Height="1" Background="{DynamicResource GlassBorderBrush}" Margin="0,6"/>

                                            <!-- ===== POSSESSION =====================================================
                                                 The haunt itself (Services/Possession/POSSESSION.md). It sits ABOVE the
                                                 Safeties block on purpose: Possession is what Lockdown IS now, and the old
                                                 cage is the quiet fine print underneath it.

                                                 The master switch greys the block rather than collapsing it: someone who
                                                 turned the haunt off still has to be able to see WHAT they turned off, or
                                                 the card reads as if the feature vanished. -->
                                            <Grid Height="32" Background="Transparent">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{loc:Str lockdown_poss_title}" FontSize="13"
                                                           FontWeight="SemiBold" Foreground="{StaticResource TextLightBrush}"
                                                           VerticalAlignment="Center"/>
                                                <CheckBox Grid.Column="1" x:Name="ChkPossessionEnabled" x:FieldModifier="internal"
                                                          Style="{StaticResource ToggleStyle}" VerticalAlignment="Center"
                                                          poss:Possession.Role="Toggle" poss:Possession.Name="the Possession switch"
                                                          ToolTip="{loc:Str lockdown_poss_on}"
                                                          Checked="ChkPossessionEnabled_Changed" Unchecked="ChkPossessionEnabled_Changed"/>
                                            </Grid>

                                            <StackPanel x:Name="PossessionBlock" x:FieldModifier="internal">
                                                <TextBlock Text="{loc:Str lockdown_poss_blurb}" FontSize="11.5"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           TextWrapping="Wrap" Margin="0,0,0,8"/>

                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                    <TextBlock Text="{loc:Str lockdown_poss_intensity_label}" FontSize="11.5"
                                                               Foreground="{StaticResource TextMutedBrush}"
                                                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                    <ToggleButton x:Name="BtnPossGentle" x:FieldModifier="internal"
                                                                  Style="{StaticResource LockdownPillStyle}"
                                                                  Content="{loc:Str lockdown_poss_intensity_gentle}"
                                                                  Tag="0" Click="PossIntensity_Click"/>
                                                    <ToggleButton x:Name="BtnPossEerie" x:FieldModifier="internal"
                                                                  Style="{StaticResource LockdownPillStyle}"
                                                                  Content="{loc:Str lockdown_poss_intensity_eerie}"
                                                                  Tag="1" Click="PossIntensity_Click"/>
                                                    <ToggleButton x:Name="BtnPossFullDoki" x:FieldModifier="internal"
                                                                  Style="{StaticResource LockdownPillStyle}"
                                                                  Content="{loc:Str lockdown_poss_intensity_fulldoki}"
                                                                  Tag="2" Click="PossIntensity_Click"/>
                                                </StackPanel>
                                                <TextBlock Text="{loc:Str lockdown_poss_fulldoki_hint}" FontSize="10.5"
                                                           Foreground="#B38A6E" TextWrapping="Wrap" Margin="0,0,0,6"/>

                                                <Grid Height="40" Background="Transparent">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <TextBlock Text="{loc:Str lockdown_poss_tripwires}" FontSize="12.5"
                                                                   Foreground="{StaticResource TextLightBrush}"/>
                                                        <TextBlock Text="{loc:Str lockdown_poss_tripwires_hint}" FontSize="10.5"
                                                                   Foreground="{StaticResource TextMutedBrush}"/>
                                                    </StackPanel>
                                                    <CheckBox Grid.Column="1" x:Name="ChkPossTripwires" x:FieldModifier="internal"
                                                              Style="{StaticResource ToggleStyle}" VerticalAlignment="Center"
                                                              poss:Possession.Role="Toggle" poss:Possession.Name="the tripwires toggle"
                                                              Checked="ChkPossTripwires_Changed" Unchecked="ChkPossTripwires_Changed"/>
                                                </Grid>

                                                <Grid Height="40" Background="Transparent">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <TextBlock Text="{loc:Str lockdown_poss_warden}" FontSize="12.5"
                                                                   Foreground="{StaticResource TextLightBrush}"/>
                                                        <TextBlock Text="{loc:Str lockdown_poss_warden_hint}" FontSize="10.5"
                                                                   Foreground="{StaticResource TextMutedBrush}"/>
                                                    </StackPanel>
                                                    <CheckBox Grid.Column="1" x:Name="ChkPossWarden" x:FieldModifier="internal"
                                                              Style="{StaticResource ToggleStyle}" VerticalAlignment="Center"
                                                              poss:Possession.Role="Toggle" poss:Possession.Name="the warden toggle"
                                                              Checked="ChkPossWarden_Changed" Unchecked="ChkPossWarden_Changed"/>
                                                </Grid>

                                                <Grid Height="40" Background="Transparent">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <TextBlock Text="{loc:Str lockdown_poss_photosafe}" FontSize="12.5"
                                                                   Foreground="{StaticResource TextLightBrush}"/>
                                                        <TextBlock Text="{loc:Str lockdown_poss_photosafe_hint}" FontSize="10.5"
                                                                   Foreground="{StaticResource TextMutedBrush}"/>
                                                    </StackPanel>
                                                    <CheckBox Grid.Column="1" x:Name="ChkPossPhotosafe" x:FieldModifier="internal"
                                                              Style="{StaticResource ToggleStyle}" VerticalAlignment="Center"
                                                              poss:Possession.Role="Toggle" poss:Possession.Name="the photosensitive-safe toggle"
                                                              Checked="ChkPossPhotosafe_Changed" Unchecked="ChkPossPhotosafe_Changed"/>
                                                </Grid>
                                            </StackPanel>

                                            <Border Height="1" Background="{DynamicResource GlassBorderBrush}" Margin="0,6"/>

                                            <!-- ===== SAFETIES ======================================================
                                                 The original Lockdown, demoted to fine print. Smaller and muted because
                                                 they are defaults nobody should have to think about, but they stay
                                                 REACHABLE and honest: OnLockdownActivated reads each one instead of
                                                 forcing all three, so an unticked box here really does mean the cage
                                                 leaves that one door open. -->
                                            <TextBlock Text="{loc:Str lockdown_poss_safeties_title}" FontSize="11.5"
                                                       FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"
                                                       Margin="0,0,0,2"/>

                                            <Grid Height="28" Background="Transparent"
                                                  ToolTip="{loc:Str tooltip_lockdown_force_strict_lock}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{loc:Str lockdown_poss_safety_strict}" FontSize="11.5"
                                                           Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                                <CheckBox Grid.Column="1" x:Name="ChkLockdownStrict" x:FieldModifier="internal"
                                                          ToolTip="{loc:Str tooltip_lockdown_force_strict_lock}"
                                                          Style="{StaticResource ToggleStyle}" VerticalAlignment="Center"
                                                          poss:Possession.Role="Toggle" poss:Possession.Name="the Strict Lock safety"
                                                          Checked="ChkLockdownSafety_Changed" Unchecked="ChkLockdownSafety_Changed"/>
                                            </Grid>

                                            <Grid Height="28" Background="Transparent">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{loc:Str lockdown_poss_safety_panic}" FontSize="11.5"
                                                           Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                                <CheckBox Grid.Column="1" x:Name="ChkLockdownNoPanic" x:FieldModifier="internal"
                                                          Style="{StaticResource ToggleStyle}" VerticalAlignment="Center"
                                                          poss:Possession.Role="Toggle" poss:Possession.Name="the panic key safety"
                                                          Checked="ChkLockdownSafety_Changed" Unchecked="ChkLockdownSafety_Changed"/>
                                            </Grid>

                                            <Grid Height="28" Background="Transparent">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{loc:Str lockdown_poss_safety_syskeys}" FontSize="11.5"
                                                           Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <CheckBox Grid.Column="1" x:Name="ChkLockdownSysKeys" x:FieldModifier="internal"
                                                          Style="{StaticResource ToggleStyle}" VerticalAlignment="Center"
                                                          poss:Possession.Role="Toggle" poss:Possession.Name="the system keys safety"
                                                          Checked="ChkLockdownSafety_Changed" Unchecked="ChkLockdownSafety_Changed"/>
                                            </Grid>

                                            <Grid Height="28" Background="Transparent"
                                                  ToolTip="{loc:Str lockdown_poss_safety_dose_tip}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{loc:Str lockdown_poss_safety_dose}" FontSize="11.5"
                                                           Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <CheckBox Grid.Column="1" x:Name="ChkLockdownDose" x:FieldModifier="internal"
                                                          Style="{StaticResource ToggleStyle}" VerticalAlignment="Center"
                                                          poss:Possession.Role="Toggle" poss:Possession.Name="the dose safety"
                                                          Checked="ChkLockdownSafety_Changed" Unchecked="ChkLockdownSafety_Changed"/>
                                            </Grid>

                                            <TextBlock Text="{loc:Str lockdown_poss_safeties_note}" FontSize="10.5"
                                                       Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"
                                                       Opacity="0.85" Margin="0,2,0,0"/>

                                            <Border Height="1" Background="{DynamicResource GlassBorderBrush}" Margin="0,6"/>

                                            <Button x:Name="BtnActivateLockdown" Content="{loc:Str btn_activate}" Cursor="Hand"
                                                    Background="{DynamicResource PinkBrush}" Foreground="White" FontWeight="Bold" FontSize="13"
                                                    BorderThickness="0" Padding="16,10" HorizontalAlignment="Left" Margin="0,6,0,0"
                                                    Click="BtnActivateLockdown_Click">
                                                <Button.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="8"/>
                                                    </Style>
                                                </Button.Resources>
                                            </Button>
                                        </StackPanel>

                                        <!-- Active Panel (visible when lockdown IS active) -->
                                        <StackPanel x:Name="LockdownActivePanel" x:FieldModifier="internal" Visibility="Collapsed">
                                            <TextBlock Text="{loc:Str label_lockdown_active}" Foreground="#DC143C" FontWeight="Bold" FontSize="16" Margin="0,0,0,8"/>
                                            <TextBlock x:Name="TxtLockdownTimer" x:FieldModifier="internal" Text="00:00" Foreground="#DC143C" FontWeight="Bold" FontSize="36"
                                                       poss:Possession.Role="Timer" poss:Possession.Name="the timer"
                                                       Margin="0,0,0,8" Cursor="Hand" MouseLeftButtonDown="TxtLockdownTimer_Click"/>

                                            <!-- Rung readout. The digits above are never allowed to lie
                                                 (POSSESSION.md), so THIS is where "how haunted is it right
                                                 now" gets to be legible: a word plus five pips, driven from
                                                 OnLockdownActivated / RungChanged in MainWindow.Lab.cs. -->
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <TextBlock x:Name="TxtPossessionRung" x:FieldModifier="internal"
                                                           Text="" FontSize="11.5" FontWeight="SemiBold"
                                                           Foreground="#FF8A5C" VerticalAlignment="Center"
                                                           Margin="0,0,10,0"/>
                                                <StackPanel x:Name="PossessionPips" x:FieldModifier="internal"
                                                            Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Width="8" Height="8" CornerRadius="4" Margin="0,0,5,0" Background="#33FF8A5C"/>
                                                    <Border Width="8" Height="8" CornerRadius="4" Margin="0,0,5,0" Background="#33FF8A5C"/>
                                                    <Border Width="8" Height="8" CornerRadius="4" Margin="0,0,5,0" Background="#33FF8A5C"/>
                                                    <Border Width="8" Height="8" CornerRadius="4" Margin="0,0,5,0" Background="#33FF8A5C"/>
                                                    <Border Width="8" Height="8" CornerRadius="4" Margin="0,0,5,0" Background="#33FF8A5C"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <!-- ===== THE HUGE BUTTON ==========================
                                                 Comically large on purpose: while the room is
                                                 misbehaving, the way out must be the single
                                                 loudest object on the page, readable from across
                                                 the room, and impossible to mistake for one of
                                                 the ghosts. Hence poss:Possession.Exclude - it
                                                 inherits, so nothing inside this button can ever
                                                 be auto-tagged into the deck by Wave 2's
                                                 type-based tagger.

                                                 Template is a bare ContentPresenter so the named
                                                 visuals below live in the UserControl's own
                                                 namescope and the code-behind can animate them.
                                                 The press and idle animations are in
                                                 LockdownTabView.xaml.cs (the idle pulse is
                                                 suppressed under LockdownPhotosafe).

                                                 The art is the mushroom dome ONLY, deliberately
                                                 cropped clear of any baked-in lettering, so the
                                                 words stay a loc key. If the resource is missing
                                                 the Image renders nothing and the crimson slab
                                                 alone still reads as the button. -->
                                            <Button x:Name="BtnEmergencyExit" x:FieldModifier="internal"
                                                    poss:Possession.Exclude="True"
                                                    Cursor="Hand" Background="Transparent" BorderThickness="0"
                                                    Padding="0" Margin="0,16,0,2" MinHeight="150"
                                                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                                    ToolTip="{loc:Str lockdown_ee_tooltip}"
                                                    Click="BtnEmergencyExit_Click"
                                                    PreviewMouseLeftButtonDown="BtnEmergencyExit_Down"
                                                    PreviewMouseLeftButtonUp="BtnEmergencyExit_Up"
                                                    MouseLeave="BtnEmergencyExit_Up">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <ContentPresenter/>
                                                    </ControlTemplate>
                                                </Button.Template>

                                                <Grid x:Name="EERoot" x:FieldModifier="internal" RenderTransformOrigin="0.5,0.5">
                                                    <Grid.RenderTransform>
                                                        <ScaleTransform x:Name="EEScale" x:FieldModifier="internal" ScaleX="1" ScaleY="1"/>
                                                    </Grid.RenderTransform>

                                                    <!-- Hazard plate -->
                                                    <Border CornerRadius="20" BorderThickness="7" Background="#160810"
                                                            BorderBrush="{StaticResource EEHazardBrush}">
                                                        <Border.Effect>
                                                            <DropShadowEffect x:Name="EEGlow" x:FieldModifier="internal"
                                                                              Color="#FF8A5C" BlurRadius="28"
                                                                              ShadowDepth="0" Opacity="0.32"/>
                                                        </Border.Effect>

                                                        <Border x:Name="EESlab" x:FieldModifier="internal"
                                                                CornerRadius="13" Margin="7" ClipToBounds="True">
                                                            <Border.Background>
                                                                <RadialGradientBrush GradientOrigin="0.42,0.2" Center="0.42,0.3"
                                                                                     RadiusX="1.05" RadiusY="1.25">
                                                                    <GradientStop Color="#FF3E5C" Offset="0"/>
                                                                    <GradientStop Color="#DC143C" Offset="0.5"/>
                                                                    <GradientStop Color="#780A1E" Offset="1"/>
                                                                </RadialGradientBrush>
                                                            </Border.Background>

                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>

                                                                <!-- An ImageBrush on a rounded Border rather than an
                                                                     Image: Border does not clip its children, so the only
                                                                     way to get the art's own corners rounded is to make it
                                                                     the background. Reads as an inset plate instead of a
                                                                     square pasted onto the slab. -->
                                                                <Border Grid.Column="0" x:Name="EEFacePlate" x:FieldModifier="internal"
                                                                        Width="128" Margin="14,10,8,10" CornerRadius="10"
                                                                        BorderBrush="#4D000000" BorderThickness="1">
                                                                    <Border.Background>
                                                                        <ImageBrush Stretch="UniformToFill"
                                                                                    RenderOptions.BitmapScalingMode="HighQuality"
                                                                                    ImageSource="pack://application:,,,/Resources/lockdown/emergency_exit.png"/>
                                                                    </Border.Background>
                                                                </Border>

                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                                                            HorizontalAlignment="Center" Margin="4,0,18,0">
                                                                    <TextBlock Text="{loc:Str lockdown_ee_button}"
                                                                               FontSize="40" FontWeight="Bold" Foreground="White"
                                                                               TextAlignment="Center" TextWrapping="Wrap"
                                                                               LineHeight="42">
                                                                        <TextBlock.Effect>
                                                                            <DropShadowEffect Color="#99000000" BlurRadius="10"
                                                                                              ShadowDepth="2" Direction="270" Opacity="0.9"/>
                                                                        </TextBlock.Effect>
                                                                    </TextBlock>
                                                                    <TextBlock Text="{loc:Str lockdown_ee_sub}"
                                                                               FontSize="12.5" Foreground="#FFDCE2"
                                                                               TextAlignment="Center" TextWrapping="Wrap"
                                                                               Opacity="0.9" Margin="0,4,0,0"/>
                                                                </StackPanel>

                                                                <!-- Gloss last so it lies over art AND text. -->
                                                                <Border Grid.Column="0" Grid.ColumnSpan="2" CornerRadius="13"
                                                                        IsHitTestVisible="False">
                                                                    <Border.Background>
                                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                            <GradientStop Color="#3DFFFFFF" Offset="0"/>
                                                                            <GradientStop Color="#00FFFFFF" Offset="0.42"/>
                                                                            <GradientStop Color="#00000000" Offset="0.6"/>
                                                                            <GradientStop Color="#3D000000" Offset="1"/>
                                                                        </LinearGradientBrush>
                                                                    </Border.Background>
                                                                </Border>
                                                            </Grid>
                                                        </Border>
                                                    </Border>
                                                </Grid>
                                            </Button>

                                            <TextBox x:Name="TxtLockdownExit" x:FieldModifier="internal" Visibility="Collapsed"
                                                     poss:Possession.Exclude="True"
                                                     Background="#1A0A0A" Foreground="#DC143C" BorderBrush="#DC143C" BorderThickness="1"
                                                     FontSize="13" Padding="8,6" Margin="0,8,0,0"
                                                     KeyDown="TxtLockdownExit_KeyDown"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- SIDE ART = the lockdown plate, moved out of the card body. It keeps its
                             own pink pulsing border instead of the velvet outline because
                             StartLockdownPulse animates LockdownImageBorderBrush and
                             LockdownImageGlow directly (MainWindow.Animations.cs), and it keeps the
                             Image child (not an ImageBrush) because descImageMap swaps
                             ImgLockdownFeature.Source per mod. Pop stays on the Image, not the
                             host: the host owns the ClipToBounds, and scaling a clipping element
                             takes its clip with it. -->
                        <Border Grid.Column="1" x:Name="LockdownImageBorder" Margin="10,0,0,10" CornerRadius="12"
                                BorderThickness="2" ClipToBounds="True"
                                VerticalAlignment="Stretch" MinHeight="200" MaxHeight="520">
                            <Border.Background>
                                <SolidColorBrush Color="#12FFFFFF"/>
                            </Border.Background>
                            <Border.BorderBrush>
                                <SolidColorBrush x:Name="LockdownImageBorderBrush" x:FieldModifier="internal" Color="#FF1493"/>
                            </Border.BorderBrush>
                            <Border.Effect>
                                <DropShadowEffect x:Name="LockdownImageGlow" x:FieldModifier="internal" Color="#FF1493" BlurRadius="14" ShadowDepth="0" Opacity="0.7"/>
                            </Border.Effect>
                            <!-- Lockdown pulse managed in code-behind (StartLockdownPulse/StopLockdownPulse) -->
                            <Image x:Name="ImgLockdownFeature" x:FieldModifier="internal"
                                   Source="pack://application:,,,/Resources/lockdown_icon.png" Stretch="Uniform"
                                   Margin="10"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   hover:HoverPop.IsEnabled="True"/>
                        </Border>
                    </Grid>
                </StackPanel>

                <!-- Translucent gating overlay (only for free users) -->
                <Border x:Name="LockdownGate" x:FieldModifier="internal" Visibility="Collapsed"
                        Background="#99000010" BorderBrush="{DynamicResource FxGlowBrush}" BorderThickness="2"
                        CornerRadius="16" IsHitTestVisible="True">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image Width="52" Height="52" HorizontalAlignment="Center" Source="{Binding Source='🔒', Converter={StaticResource EmojiToImageSource}}"/>
                        <TextBlock Text="{loc:Str gate_premium_locked}" FontSize="22"
                                   FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                        <TextBlock Text="{loc:Str gate_premium_subtitle}" FontSize="14"
                                   Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,12"/>
                        <Button Click="BtnGateUnlock_Click" Padding="20,8" Background="{DynamicResource FxGlowBrush}"
                                Foreground="White" FontWeight="Bold" Cursor="Hand" BorderThickness="0">
                            <helpers:EmojiTextBlock Text="{loc:Str gate_unlock_with_patreon}"/>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
