<UserControl x:Class="ConditioningControlPanel.Views.Tabs.AppSettingsTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="clr-namespace:ConditioningControlPanel.Localization"
             xmlns:appset="clr-namespace:ConditioningControlPanel.Views.Controls.AppSettingsSections"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1100">

    <!-- ========================================================================
         THE SETTINGS DOOR (UX restructure, Phase 2 · tab key "appsettings")

         One vertical page, eight sections, one editor per setting. The left
         mini-rail is a table of contents, not a tab strip: every section is
         always instantiated and always in the scroll, so Ctrl+F-style hunting
         works and a pill click is a scroll, never a swap. That is why nothing
         here is lazy and nothing here is a TabControl.

         SECTION CONTRACT (binding for the eight section agents):
           · one UserControl per section under Views/Controls/AppSettings/
           · every x:Name a MainWindow partial reads/writes is re-exposed as a
             passthrough property, Workshop-cell style
           · passthroughs live in per-section PARTIAL files of this class
             (Views/Tabs/AppSettingsTabView.<Section>.cs) so eight agents never
             edit one file — see the header of AppSettingsTabView.xaml.cs
           · resources come from Resources/Theme/*.xaml only. A UserControl's
             XAML is parsed before it is attached to MainWindow, so a
             StaticResource that lives in MainWindow.xaml's own Resources (e.g.
             NavRailButton) will NOT resolve here. App-level or local only.

         QUIET SURFACE (PLAN §2.7, ground rule 8): no ambient loop is registered
         for this view and none may be. The only motion is the shared tab-in
         choreography, which MotionFx already gates.
         ======================================================================== -->

    <UserControl.Resources>

        <!-- Mini-rail pill. A RadioButton so the group gives us single-selection
             for free: the scroll-spy re-checks the pill the reader is looking at,
             and a click scrolls. Deliberately calm - opacity and a 3px bar, the
             same visual grammar as the nav rail's active indicator, no clock. -->
        <Style x:Key="SectionPill" TargetType="RadioButton">
            <Setter Property="GroupName" Value="AppSettingsSections"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <Border x:Name="PillFill" CornerRadius="8" Opacity="0"
                                    Background="{DynamicResource TransparentPink20Brush}"/>
                            <Border x:Name="PillBar" Width="3" CornerRadius="2" Margin="0,5"
                                    HorizontalAlignment="Left" Visibility="Collapsed"
                                    Background="{DynamicResource PinkBrush}"/>
                            <ContentPresenter Margin="14,7,10,7" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PillFill" Property="Opacity" Value="0.5"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextLightBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="PillFill" Property="Opacity" Value="1"/>
                                <Setter TargetName="PillBar" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextLightBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ============================ page header ============================ -->
        <Grid Grid.Row="0" Margin="4,2,4,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Image Grid.Column="0" Width="34" Height="34" Margin="0,0,14,0" VerticalAlignment="Center"
                   Source="{Binding Source='⚙️', Converter={StaticResource EmojiToImageSource}}"/>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="TxtAppSettingsTitle" Text="{loc:Str set2_settings_title}"
                           Foreground="White" FontSize="22" FontWeight="Bold"/>
                <TextBlock Text="{loc:Str set2_settings_subtitle}"
                           Foreground="{DynamicResource TextMutedBrush}" FontSize="13"/>
            </StackPanel>
        </Grid>

        <!-- ====================== mini-rail + scrolling body ==================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Table of contents. Fixed width, does not scroll with the body. -->
            <Border Grid.Column="0" Width="186" Margin="0,0,16,0" VerticalAlignment="Top"
                    Background="{DynamicResource SurfaceBgBrush}" BorderBrush="#2A2A46"
                    BorderThickness="1" CornerRadius="12" Padding="8,10">
                <StackPanel>
                    <TextBlock Text="{loc:Str set2_rail_hint}" Margin="14,0,10,8"
                               Foreground="{DynamicResource TextDimBrush}" FontSize="10"
                               FontWeight="Bold" Opacity="0.85"/>

                    <RadioButton x:Name="SectionPillGeneral" Tag="general" IsChecked="True"
                                 Style="{StaticResource SectionPill}" Click="SectionPill_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center"
                                   Source="{Binding Source='🎀', Converter={StaticResource EmojiToImageSource}}"/>
                            <TextBlock Text="{loc:Str set2_section_general}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="SectionPillAudio" Tag="audio"
                                 Style="{StaticResource SectionPill}" Click="SectionPill_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center"
                                   Source="{Binding Source='🔊', Converter={StaticResource EmojiToImageSource}}"/>
                            <TextBlock Text="{loc:Str set2_section_audio}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="SectionPillDevices" Tag="devices"
                                 Style="{StaticResource SectionPill}" Click="SectionPill_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center"
                                   Source="{Binding Source='📷', Converter={StaticResource EmojiToImageSource}}"/>
                            <TextBlock Text="{loc:Str set2_section_devices}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="SectionPillPerformance" Tag="performance"
                                 Style="{StaticResource SectionPill}" Click="SectionPill_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center"
                                   Source="{Binding Source='⚡', Converter={StaticResource EmojiToImageSource}}"/>
                            <TextBlock Text="{loc:Str set2_section_performance}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="SectionPillNotifications" Tag="notifications"
                                 Style="{StaticResource SectionPill}" Click="SectionPill_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center"
                                   Source="{Binding Source='🔔', Converter={StaticResource EmojiToImageSource}}"/>
                            <TextBlock Text="{loc:Str set2_section_notifications}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <Border Height="1" Background="#2A2A46" Margin="10,7,10,7"/>

                    <RadioButton x:Name="SectionPillAccount" Tag="account"
                                 Style="{StaticResource SectionPill}" Click="SectionPill_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center"
                                   Source="{Binding Source='💖', Converter={StaticResource EmojiToImageSource}}"/>
                            <TextBlock Text="{loc:Str set2_section_account}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="SectionPillData" Tag="data"
                                 Style="{StaticResource SectionPill}" Click="SectionPill_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center"
                                   Source="{Binding Source='💾', Converter={StaticResource EmojiToImageSource}}"/>
                            <TextBlock Text="{loc:Str set2_section_data}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="SectionPillUpdates" Tag="updates"
                                 Style="{StaticResource SectionPill}" Click="SectionPill_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center"
                                   Source="{Binding Source='⬆️', Converter={StaticResource EmojiToImageSource}}"/>
                            <TextBlock Text="{loc:Str set2_section_updates}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </Border>

            <!-- The page itself. Sections are always instantiated (ground rule §2.3)
                 and always in this stack, in rail order. -->
            <ScrollViewer x:Name="SectionScroll" Grid.Column="1"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          ScrollChanged="SectionScroll_ScrollChanged" Padding="0,0,10,0">
                <StackPanel x:Name="SectionStack">
                    <appset:GeneralSettingsSection       x:Name="SectionGeneral"       Margin="0,0,0,16"/>
                    <appset:AudioSettingsSection         x:Name="SectionAudio"         Margin="0,0,0,16"/>
                    <appset:DevicesSettingsSection       x:Name="SectionDevices"       Margin="0,0,0,16"/>
                    <appset:PerformanceSettingsSection   x:Name="SectionPerformance"   Margin="0,0,0,16"/>
                    <appset:NotificationsSettingsSection x:Name="SectionNotifications" Margin="0,0,0,16"/>
                    <appset:AccountSettingsSection       x:Name="SectionAccount"       Margin="0,0,0,16"/>
                    <appset:DataSettingsSection          x:Name="SectionData"          Margin="0,0,0,16"/>
                    <appset:UpdatesSettingsSection       x:Name="SectionUpdates"       Margin="0,0,0,16"/>

                    <!-- Tail room so the last section can actually reach the top of the
                         viewport when its pill is clicked. Without it "Updates" scrolls
                         to wherever the content ends and the pill lies about where you are. -->
                    <Border x:Name="SectionTailSpacer" Height="260" Background="Transparent"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
