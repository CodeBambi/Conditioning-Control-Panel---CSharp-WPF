<UserControl x:Class="ConditioningControlPanel.Views.Tabs.ChasterTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="clr-namespace:ConditioningControlPanel.Localization"
             xmlns:ctrl="clr-namespace:ConditioningControlPanel.Controls"
             mc:Ignorable="d"
             d:DesignHeight="1400" d:DesignWidth="1000">
    <!-- CIRCE'S TAB, the lock-themed page (owner-approved mockup, 2026-09-22, "the mockup is
         decent"). The launcher's ground and glass, and on it, top to bottom:

           1. the LOCK hero: the countdown in big digits, when it opens, a state pill or two, the
              neon art bleeding in from the right, and a PAPER TAG hanging off the lock with what is
              on the tab and an UNPAID stamp;
           2. a CHAIN, one link a day until the lock opens: tonight's link glows red and carries
              the tab as a small bobbing tag, the last link is dashed gold, the one that opens;
           3. three stat cards, each with one muted line under its figure;
           4. four KEYS (Gentle, Strict, Circe's choice, Custom): a key lights the rows it opens;
           5. THE MENU, always in view, two boards side by side: what she adds time for (red) and
              what she takes it back for (mint). A row is a picture, a short name, where it happens,
              a tier sign when the feature needs one, and the price on a stamp. Hovering a row opens
              its TRAILER: the picture on a slow drift, the floating figure the app itself throws
              when a price lands, one line of flavour and one plain line of what it does.
              The jackpot sits across both boards in gold. Under it, four facts.

         Unlinked, it is the hero with one big call to action and three fact tiles.

         Every rule lives in Services/Chaster; this view reads ChasterService and writes four
         settings (ChasterTabEnabled, ChasterConsentSeen, ChasterLockId, ChasterPrices). The copy
         for every row is TabMenuCopy. All the motion is in ChasterTabView.Fx.cs, gated on MotionFx. -->
    <UserControl.Resources>
        <!-- A glass card, the launcher tile's body. -->
        <Style x:Key="CirceCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="20,16"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        </Style>

        <Style x:Key="CirceEyebrow" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- The one muted line under a figure. -->
        <Style x:Key="CirceSub" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Opacity" Value="0.8"/>
            <Setter Property="Margin" Value="1,4,0,0"/>
        </Style>

        <!-- The big numbers: the launcher's stat figure. -->
        <Style x:Key="CirceFigure" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="/Fonts/#Fredoka, Segoe UI"/>
            <Setter Property="FontSize" Value="38"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextLightBrush}"/>
            <Setter Property="RenderTransformOrigin" Value="0,1"/>
        </Style>

        <!-- The one big call to action, the launcher's CTA at page height. -->
        <Style x:Key="CirceCta" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentGradientBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="/Fonts/#Fredoka, Segoe UI"/>
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="56"/>
            <Setter Property="Padding" Value="28,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A text link: no box, underline on hover. -->
        <Style x:Key="CirceLink" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <TextBlock x:Name="Txt" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Txt" Property="TextDecorations" Value="Underline"/>
                                <Setter TargetName="Txt" Property="Foreground" Value="{DynamicResource TextLightBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A KEY: a key glyph in its hue and a name. Outline at rest, the hue floods in when it is
             the set that is on. The code hands each key its Background (fill) and BorderBrush (rim). -->
        <Style x:Key="CirceKey" TargetType="ToggleButton">
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextLightBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="MinHeight" Value="76"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="Fill" Background="{TemplateBinding Background}" CornerRadius="16" Opacity="0"/>
                            <Border x:Name="Rim" Background="{DynamicResource SurfaceBgBrush}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="16" Opacity="0.55"/>
                            <Grid Margin="16,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- the key: a ring for a head, a shaft with two teeth -->
                                <Path x:Name="Key" Grid.Column="0" Width="42" Height="18" Stretch="Uniform" Opacity="0.7"
                                      Fill="{TemplateBinding BorderBrush}" VerticalAlignment="Center" Margin="0,0,12,0"
                                      RenderTransformOrigin="0.5,0.5"
                                      Data="M 8,0 A 8,8 0 1 0 8,16 A 8,8 0 1 0 8,0 Z M 8,4.5 A 3.5,3.5 0 1 0 8,11.5 A 3.5,3.5 0 1 0 8,4.5 Z M 15,5.5 H 42 V 11 H 38.5 V 8.5 H 34.5 V 12.5 H 30.5 V 8.5 H 15 Z">
                                    <Path.RenderTransform>
                                        <RotateTransform Angle="0"/>
                                    </Path.RenderTransform>
                                </Path>
                                <ContentPresenter x:Name="Cp" Grid.Column="1" VerticalAlignment="Center"/>
                            </Grid>
                            <!-- the tick that means "this is the one" -->
                            <Border x:Name="Tick" Width="20" Height="20" CornerRadius="10" Opacity="0"
                                    Background="{TemplateBinding BorderBrush}"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0">
                                <TextBlock Text="&#x2713;" FontSize="11" FontWeight="Bold" Foreground="#FF14101E"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Rim" Property="Opacity" Value="1"/>
                                <Setter TargetName="Key" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Rim" Property="Opacity" Value="1"/>
                                <Setter TargetName="Rim" Property="Background" Value="Transparent"/>
                                <Setter TargetName="Fill" Property="Opacity" Value="0.22"/>
                                <Setter TargetName="Key" Property="Opacity" Value="1"/>
                                <Setter TargetName="Tick" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A MENU ROW: a glass strip that lights in its board's colour when the price is on. The
             content (picture, name, where, sign, stamp) is built in code; the code also dims the
             picture when the row is off, since a template cannot reach into content. -->
        <Style x:Key="CirceRow" TargetType="ToggleButton">
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource TextLightBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="Fill" Background="{TemplateBinding Background}" CornerRadius="12" Opacity="0"/>
                            <Border x:Name="Rim" Background="#12FFFFFF" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Opacity="0.35"/>
                            <ContentPresenter x:Name="Cp" Margin="8,7,10,7" Opacity="0.72"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Rim" Property="Opacity" Value="0.9"/>
                                <Setter TargetName="Cp" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Rim" Property="Opacity" Value="1"/>
                                <Setter TargetName="Fill" Property="Opacity" Value="0.16"/>
                                <Setter TargetName="Cp" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A fact tile: one glyph, a few words. -->
        <Style x:Key="CirceFact" TargetType="Border">
            <Setter Property="Background" Value="#14FFFFFF"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <Style x:Key="CirceFactGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="/Fonts/#Fredoka, Segoe UI"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextLightBrush}"/>
            <Setter Property="Opacity" Value="0.9"/>
        </Style>
        <Style x:Key="CirceFactText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        </Style>

        <!-- The footer facts: a glyph and a few words in one line. -->
        <Style x:Key="CirceFoot" TargetType="Border">
            <Setter Property="Background" Value="#10FFFFFF"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="PageRoot" ClipToBounds="True">
        <!-- ================= the ground (the launcher's backdrop) ================= -->
        <Border CornerRadius="18">
            <Border.Background>
                <RadialGradientBrush GradientOrigin="0.22,0.18" Center="0.22,0.18" RadiusX="1.0" RadiusY="0.95">
                    <GradientStop Color="#FF2C1450" Offset="0"/>
                    <GradientStop Color="#FF1C1233" Offset="0.42"/>
                    <GradientStop Color="#FF100A1E" Offset="0.74"/>
                    <GradientStop Color="#FF07040F" Offset="1"/>
                </RadialGradientBrush>
            </Border.Background>
        </Border>
        <!-- The spiral watermark, turning once every 90 s under the hero. -->
        <Grid x:Name="SpiralLayer" Width="760" Height="760" HorizontalAlignment="Right" VerticalAlignment="Top"
              Margin="0,-300,-260,0" Opacity="0.1" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
            <Grid.CacheMode>
                <BitmapCache/>
            </Grid.CacheMode>
            <Grid.RenderTransform>
                <RotateTransform x:Name="SpiralTurn"/>
            </Grid.RenderTransform>
            <Path x:Name="SpiralPath" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                <Path.Stroke>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="{DynamicResource FxGlowColor}" Offset="0"/>
                        <GradientStop Color="{DynamicResource FxParticleColor}" Offset="1"/>
                    </LinearGradientBrush>
                </Path.Stroke>
            </Path>
        </Grid>
        <Border x:Name="GlowLayer" Opacity="0.3" IsHitTestVisible="False" CornerRadius="18">
            <Border.Background>
                <RadialGradientBrush GradientOrigin="0.78,0.12" Center="0.78,0.12" RadiusX="0.5" RadiusY="0.55">
                    <GradientStop Color="{DynamicResource FxGlowColor}" Offset="0"/>
                    <GradientStop Color="#00000000" Offset="1"/>
                </RadialGradientBrush>
            </Border.Background>
        </Border>
        <Border IsHitTestVisible="False" CornerRadius="18">
            <Border.Background>
                <RadialGradientBrush GradientOrigin="0.5,0.45" Center="0.5,0.45" RadiusX="0.85" RadiusY="0.85">
                    <GradientStop Color="#00000000" Offset="0.45"/>
                    <GradientStop Color="#55000000" Offset="0.8"/>
                    <GradientStop Color="#B0000000" Offset="1"/>
                </RadialGradientBrush>
            </Border.Background>
        </Border>
        <ctrl:AmbientFxCanvas x:Name="Ambient" x:FieldModifier="internal" IsHitTestVisible="False"/>

        <!-- ================= the page ================= -->
        <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
            <Grid Margin="26,22,26,20" MaxWidth="1080" HorizontalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- header: the name, and the switch -->
                <Grid Grid.Row="0" Margin="4,0,4,14">
                    <TextBlock Text="{loc:Str chaster_title}" FontFamily="/Fonts/#Fredoka, Segoe UI" FontSize="28"
                               FontWeight="SemiBold" Foreground="{DynamicResource TextLightBrush}" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- The account, in plain view: linked, which lock, and the way out. -->
                    <Border x:Name="AccountStrip" VerticalAlignment="Center" Visibility="Collapsed" Margin="0,0,10,0"
                            Background="{DynamicResource SurfaceBgBrush}" BorderBrush="{DynamicResource GlassBorderBrush}"
                            BorderThickness="1.5" CornerRadius="19" Height="38" Padding="6,0,6,0"
                            ToolTip="{loc:Str chaster_account_strip_tip}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Whose account: the Chaster picture and username (letter + "Chaster" until they arrive). -->
                            <ctrl:ChasterAccountBadge x:Name="AccountBadge" AvatarSize="24" VerticalAlignment="Center"
                                                      TextElement.FontFamily="/Fonts/#Fredoka, Segoe UI" TextElement.FontSize="13" TextElement.FontWeight="Bold"
                                                      TextElement.Foreground="{DynamicResource TextLightBrush}"/>
                            <TextBlock Text="{loc:Str chaster_account_linked}" FontSize="12" Margin="6,0,0,0"
                                       Foreground="#5FFFD0" VerticalAlignment="Center"/>
                            <Rectangle Width="1" Height="16" Fill="{DynamicResource GlassBorderBrush}" Margin="10,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtAccountLock" FontSize="12" MaxWidth="220" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            <Border BorderBrush="#99FF6B8A" BorderThickness="1" CornerRadius="13" Height="26" Margin="10,0,0,0"
                                    VerticalAlignment="Center">
                                <Button x:Name="BtnAccountUnlink" Style="{StaticResource CirceLink}" Content="{loc:Str chaster_unlink}"
                                        Foreground="#FF8FA3" FontWeight="SemiBold" Padding="10,2" VerticalAlignment="Center"
                                        Click="BtnUnlink_Click"/>
                            </Border>
                        </StackPanel>
                    </Border>
                    <!-- Pause: nothing books, nothing is pushed, until it is pressed again. Instant both ways. -->
                    <Border x:Name="PausePill" VerticalAlignment="Center" Visibility="Collapsed" Margin="0,0,10,0"
                            Background="{DynamicResource SurfaceBgBrush}" BorderBrush="{DynamicResource GlassBorderBrush}"
                            BorderThickness="1.5" CornerRadius="19" Height="38" ToolTip="{loc:Str chaster_pause_tip}">
                        <Button x:Name="BtnPause" Style="{StaticResource CirceLink}" Padding="14,0" VerticalAlignment="Center"
                                Click="BtnPause_Click">
                            <TextBlock x:Name="TxtPause" FontFamily="/Fonts/#Fredoka, Segoe UI" FontSize="13" FontWeight="Bold"
                                       Foreground="{DynamicResource TextLightBrush}" Text="{loc:Str chaster_pause}"/>
                        </Button>
                    </Border>
                    <!-- The master switch as a glass pill. Its rim takes the tab's red while it runs. -->
                    <Border x:Name="SwitchPill" VerticalAlignment="Center" Visibility="Collapsed"
                            Background="{DynamicResource SurfaceBgBrush}" BorderBrush="{DynamicResource GlassBorderBrush}"
                            BorderThickness="1.5" CornerRadius="19" Height="38" Padding="16,0,6,0" RenderTransformOrigin="0.5,0.5">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Str chaster_tab_switch}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextLightBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtSwitchState" FontFamily="/Fonts/#Fredoka, Segoe UI" FontSize="13" FontWeight="Bold"
                                       Margin="8,0,10,0" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}"/>
                            <CheckBox x:Name="ChkTab" Style="{StaticResource ToggleStyle}" VerticalAlignment="Center"
                                      Checked="ChkTab_Changed" Unchecked="ChkTab_Changed"/>
                        </StackPanel>
                    </Border>
                    </StackPanel>
                </Grid>

                <!-- ================= 1. THE LOCK ================= -->
                <Border x:Name="HeroCard" Grid.Row="1" Style="{StaticResource CirceCard}" Padding="0" Height="368"
                        BorderBrush="{DynamicResource PanelAccentBrush}" Margin="0,0,0,10">
                    <Grid x:Name="HeroBody">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <!-- the neon art, bleeding in from the right and fading into the card -->
                        <Grid x:Name="HeroArtPlate" Grid.Column="1" Width="380" ClipToBounds="True" SizeChanged="HeroArtPlate_SizeChanged">
                            <Image x:Name="HeroArt" Source="pack://application:,,,/Resources/features/Phrase_Lock.png"
                                   Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" Opacity="0.85"
                                   RenderTransformOrigin="0.5,0.5">
                                <Image.RenderTransform>
                                    <ScaleTransform x:Name="HeroArtScale"/>
                                </Image.RenderTransform>
                            </Image>
                            <Border x:Name="HeroArtFade" IsHitTestVisible="False"/>
                        </Grid>

                        <!-- THE PAPER TAG, hanging off the lock: what is on the tab, when it lands, UNPAID. -->
                        <Grid x:Name="PaperTag" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-8,0,0,14"
                              Panel.ZIndex="5" RenderTransformOrigin="0.5,0" Visibility="Collapsed" Cursor="Hand"
                              MouseLeftButtonUp="StatRun_Click">
                            <Grid.RenderTransform>
                                <TransformGroup>
                                    <RotateTransform x:Name="TagSwing" Angle="-6"/>
                                    <TranslateTransform/>
                                </TransformGroup>
                            </Grid.RenderTransform>
                            <!-- the string up to the lock -->
                            <Line X1="0" Y1="0" X2="0" Y2="26" Stroke="#B0F3EAD9" StrokeThickness="1.4" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                            <Border Width="164" Margin="0,24,0,0" Background="#FFF3EAD9" CornerRadius="4" Padding="12,10,12,10">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" BlurRadius="14" ShadowDepth="4" Opacity="0.45"/>
                                </Border.Effect>
                                <Grid>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="9" Height="9" Stroke="#FF241A2E" StrokeThickness="1.4" Fill="#FF1A1230" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{loc:Str chaster_tag_eyebrow}" FontFamily="Consolas, Courier New" FontSize="10"
                                                       FontWeight="Bold" Foreground="#FF241A2E" Opacity="0.7" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock x:Name="TxtTagAmount" Text="0:00" FontFamily="/Fonts/#Fredoka, Segoe UI" FontSize="30"
                                                   FontWeight="Bold" Foreground="#FFC8244A" Margin="0,2,0,0" RenderTransformOrigin="0,1"/>
                                        <TextBlock x:Name="TxtTagLands" FontFamily="Consolas, Courier New" FontSize="9.5" Foreground="#FF241A2E"
                                                   Opacity="0.75" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <!-- the rubber stamp -->
                                    <Border x:Name="TagStamp" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-6,-2"
                                            BorderBrush="#FFC8244A" BorderThickness="2" CornerRadius="3" Padding="5,1" Opacity="0.85"
                                            RenderTransformOrigin="0.5,0.5">
                                        <Border.RenderTransform>
                                            <RotateTransform Angle="-14"/>
                                        </Border.RenderTransform>
                                        <TextBlock x:Name="TxtTagStamp" Text="UNPAID" FontFamily="Consolas, Courier New" FontSize="12"
                                                   FontWeight="Bold" Foreground="#FFC8244A"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- the words and the digits, over the art's fade -->
                        <StackPanel Grid.Column="0" Grid.ColumnSpan="2" Margin="26,14,26,14" VerticalAlignment="Center">
                            <!-- the lock's name, big and candy, every o a padlock -->
                            <ctrl:LockTitle x:Name="HeroTitle" FontSize="112" HorizontalAlignment="Center" Margin="0,-26,0,4"
                                            Visibility="Collapsed"/>
                            <!-- under it: the calendar, one square a day, and the countdown beside it -->
                            <Grid x:Name="HeroLower">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid x:Name="CalendarRow" Grid.Column="0" Visibility="Collapsed" VerticalAlignment="Top" Margin="0,2,18,0">
                                    <!-- a torn-off wall-calendar sheet in the tag's paper, pinned a little crooked -->
                                    <Grid x:Name="Sheet" RenderTransformOrigin="0.5,0" MouseEnter="Sheet_MouseEnter" Margin="0,0,0,6">
                                        <Grid.RenderTransform>
                                            <TransformGroup>
                                                <RotateTransform x:Name="SheetTilt" Angle="-1.5"/>
                                                <TranslateTransform x:Name="SheetNudge"/>
                                            </TransformGroup>
                                        </Grid.RenderTransform>
                                        <StackPanel x:Name="SheetBody">
                                            <StackPanel.Effect>
                                                <DropShadowEffect Color="#000000" BlurRadius="14" ShadowDepth="4" Opacity="0.45"/>
                                            </StackPanel.Effect>
                                            <!-- the torn top edge -->
                                            <Path x:Name="TornEdge" Fill="#FFF3EAD9" Stretch="Fill" Height="9" Margin="0,0,0,-1"
                                                  Data="M 0,9 L 0,5 L 6,2 L 12,6 L 18,1 L 25,5 L 31,2 L 38,6 L 44,0 L 51,5 L 57,2 L 64,6 L 70,1 L 77,5 L 83,3 L 90,6 L 96,1 L 100,4 L 100,9 Z"/>
                                            <Border Background="#FFF3EAD9" Padding="10,12,10,10">
                                                <!-- thin ink rules: the sheet's grid -->
                                                <Border x:Name="GridLines" BorderBrush="#38241A2E" BorderThickness="1,1,0,0" HorizontalAlignment="Left">
                                                    <UniformGrid x:Name="Calendar" Columns="8" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                                </Border>
                                            </Border>
                                        </StackPanel>
                                        <!-- the punched hole, and the pin through it -->
                                        <Ellipse Width="9" Height="9" Fill="#FF1A1230" Stroke="#66241A2E" StrokeThickness="1"
                                                 HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,8,0,0"/>
                                        <Ellipse Width="11" Height="11" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="2,3,0,0"
                                                 Stroke="#FF8A1830" StrokeThickness="1">
                                            <Ellipse.Fill>
                                                <RadialGradientBrush GradientOrigin="0.35,0.3">
                                                    <GradientStop Color="#FFFF8FA8" Offset="0"/>
                                                    <GradientStop Color="#FFC8244A" Offset="1"/>
                                                </RadialGradientBrush>
                                            </Ellipse.Fill>
                                        </Ellipse>
                                    </Grid>
                                    <!-- tonight's tag, parked under today's square by the code -->
                                    <Border x:Name="CalendarTag" HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed"
                                            Panel.ZIndex="5" Background="#E6120C1F" BorderBrush="#FF6B8A" BorderThickness="1"
                                            CornerRadius="5" Padding="5,1" ToolTip="{loc:Str chaster_chain_tonight}" RenderTransformOrigin="0.5,0">
                                        <Border.RenderTransform>
                                            <TranslateTransform x:Name="CalendarTagBob"/>
                                        </Border.RenderTransform>
                                        <TextBlock x:Name="TxtCalendarTag" Text="+0:00" FontFamily="Consolas, Courier New" FontSize="11"
                                                   FontWeight="Bold" Foreground="#FF6B8A"/>
                                    </Border>
                                </Grid>
                                <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                    <!-- the countdown: number, unit, number, unit, built in code -->
                                    <StackPanel x:Name="HeroClockRow" Orientation="Horizontal" Margin="0,-6,0,0" Visibility="Collapsed"
                                                RenderTransformOrigin="0,1">
                                        <StackPanel x:Name="HeroClock" Orientation="Horizontal"/>
                                        <TextBlock Text="{loc:Str chaster_lock_lead}" FontSize="13" VerticalAlignment="Bottom"
                                                   Margin="12,0,0,12" Foreground="{DynamicResource TextMutedBrush}"/>
                                    </StackPanel>
                                    <TextBlock x:Name="TxtHeroEnds" FontSize="13" Margin="0,2,0,0" Visibility="Collapsed"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <!-- the state pills: test lock, frozen, hidden, offline, no lock, on hold -->
                                    <WrapPanel x:Name="HeroPills" Margin="0,10,0,0"/>
                                    <!-- The pick. Nothing is pushed to a lock the player did not pick, so this
                                         shows whenever no pick matches an active lock; with one lock it is one tap. -->
                                    <Grid x:Name="LockRow" Margin="0,8,0,0" Visibility="Collapsed" HorizontalAlignment="Left">
                                        <ComboBox x:Name="CmbLock" Style="{StaticResource DarkComboBoxStyle}" FontSize="12"
                                                  Foreground="{DynamicResource TextLightBrush}" Width="240" MinHeight="30"
                                                  SelectionChanged="CmbLock_SelectionChanged"/>
                                        <Border x:Name="UseLockPill" Visibility="Collapsed" BorderBrush="#99E0B052" BorderThickness="1.5"
                                                CornerRadius="15" Height="30" Background="#26E0B052" ToolTip="{loc:Str chaster_lock_use_tip}">
                                            <Button x:Name="BtnUseLock" Style="{StaticResource CirceLink}" Padding="14,0"
                                                    VerticalAlignment="Center" Click="BtnUseLock_Click">
                                                <TextBlock x:Name="TxtUseLock" FontSize="12" FontWeight="SemiBold" Foreground="#E0B052"/>
                                            </Button>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <!-- NOT LINKED: the same hero, one ask. -->
                            <StackPanel x:Name="UnlinkedPanel" Visibility="Collapsed">
                                <TextBlock Text="{loc:Str chaster_intro_1}" TextWrapping="Wrap" FontSize="14" MaxWidth="460"
                                           HorizontalAlignment="Left" LineHeight="21"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,18"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="BtnLink" Style="{StaticResource CirceCta}" Content="{loc:Str chaster_link}"
                                            MinWidth="220" Click="BtnLink_Click"
                                            ToolTip="{loc:Str chaster_link_test_hint}"/>
                                    <StackPanel x:Name="LinkingRow" Orientation="Horizontal" Visibility="Collapsed" Margin="16,0,0,0"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{loc:Str chaster_linking}" VerticalAlignment="Center" FontSize="13"
                                                   Foreground="{DynamicResource TextLightBrush}" Margin="0,0,10,0"/>
                                        <Button Style="{StaticResource CirceLink}" Content="{loc:Str chaster_cancel}" Click="BtnCancelLink_Click"/>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Text="{loc:Str chaster_link_browser_hint}" TextWrapping="Wrap" FontSize="11" MaxWidth="460"
                                           HorizontalAlignment="Left" Foreground="{DynamicResource TextMutedBrush}" Margin="2,10,0,0"/>
                                <TextBlock x:Name="TxtLinkNote" Visibility="Collapsed" TextWrapping="Wrap" FontSize="12"
                                           Foreground="#FFC98A" Margin="2,8,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="2">
                    <!-- Unlinked: three facts, no paragraphs. -->
                    <UniformGrid x:Name="FactRow" Columns="3" Visibility="Collapsed" Margin="0,4,-10,0">
                        <Border Style="{StaticResource CirceFact}">
                            <StackPanel>
                                <TextBlock x:Name="TxtFactCap1" Text="3:00:00" Style="{StaticResource CirceFactGlyph}"/>
                                <TextBlock Text="{loc:Str chaster_fact_cap}" Style="{StaticResource CirceFactText}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CirceFact}">
                            <StackPanel>
                                <TextBlock Text="&#x21BA;" Style="{StaticResource CirceFactGlyph}"/>
                                <TextBlock Text="{loc:Str chaster_fact_floor}" Style="{StaticResource CirceFactText}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CirceFact}">
                            <StackPanel>
                                <TextBlock Text="PANIC" Style="{StaticResource CirceFactGlyph}" Foreground="#FF6B8A"/>
                                <TextBlock Text="{loc:Str chaster_fact_panic}" Style="{StaticResource CirceFactText}"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- LINKED -->
                    <StackPanel x:Name="LinkedPanel" Visibility="Collapsed">

                        <!-- ================= 3. THREE NUMBERS ================= -->
                        <UniformGrid Columns="3" Margin="0,0,-12,14">
                            <Border x:Name="StatTab" Style="{StaticResource CirceCard}" Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock x:Name="TxtBalance" Text="0:00" Style="{StaticResource CirceFigure}"/>
                                    <TextBlock x:Name="TxtBalanceCaption" Text="{loc:Str chaster_balance_caption}"
                                               Style="{StaticResource CirceEyebrow}" Margin="1,2,0,0"/>
                                    <TextBlock Text="{loc:Str chaster_stat_tab_sub}" Style="{StaticResource CirceSub}"/>
                                </StackPanel>
                            </Border>
                            <Border x:Name="StatToday" Style="{StaticResource CirceCard}" Margin="0,0,12,0"
                                    ToolTip="{loc:Str chaster_settle_line}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="TxtToday" Text="0:00" Style="{StaticResource CirceFigure}"/>
                                        <TextBlock x:Name="TxtTodayCap" Text="/ 60:00" FontFamily="/Fonts/#Fredoka, Segoe UI" FontSize="15"
                                                   Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Bottom" Margin="8,0,0,8"/>
                                    </StackPanel>
                                    <TextBlock Text="{loc:Str chaster_stat_today}" Style="{StaticResource CirceEyebrow}" Margin="1,2,0,0"/>
                                    <TextBlock x:Name="TxtTodaySub" Style="{StaticResource CirceSub}"/>
                                    <!-- the cap meter: a track, a fill the code widens, a bloom at the tip -->
                                    <Grid x:Name="CapTrack" Height="6" Margin="0,10,0,0" SizeChanged="CapTrack_SizeChanged">
                                        <Border Background="#22FFFFFF" CornerRadius="3"/>
                                        <Border x:Name="CapFill" Width="0" HorizontalAlignment="Left" CornerRadius="3" Background="#FF6B8A"/>
                                        <Border x:Name="CapBloom" Width="0" HorizontalAlignment="Left" CornerRadius="3" Background="#FFFFC0CB" Opacity="0"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <!-- Click: the bill on paper. -->
                            <Border x:Name="StatRun" Style="{StaticResource CirceCard}" Margin="0,0,12,0" Cursor="Hand"
                                    MouseLeftButtonUp="StatRun_Click">
                                <Grid>
                                    <StackPanel>
                                        <TextBlock x:Name="TxtRun" Text="0:00" Style="{StaticResource CirceFigure}"/>
                                        <TextBlock Text="{loc:Str chaster_stat_run}" Style="{StaticResource CirceEyebrow}" Margin="1,2,0,0"/>
                                        <TextBlock Text="{loc:Str chaster_stat_run_sub}" Style="{StaticResource CirceSub}"/>
                                    </StackPanel>
                                    <TextBlock x:Name="TxtRunChevron" Text="&#x25BE;" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Top"
                                               Foreground="{DynamicResource TextMutedBrush}" RenderTransformOrigin="0.5,0.5"/>
                                </Grid>
                            </Border>
                        </UniformGrid>

                        <!-- the receipt, unfolded under the numbers -->
                        <Border x:Name="ReceiptHost" Visibility="Collapsed" Margin="0,0,0,14" HorizontalAlignment="Left" VerticalAlignment="Top" ClipToBounds="True">
                            <ctrl:ChasterReceiptView x:Name="Receipt" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                        </Border>

                        <!-- ================= THE HEADS-UP CLOCK: what CCP added, and the raffle card =================
                             Added only, lifetime, as this PC counted it. Hover the clock (or click to pin) and the
                             player's own Locktober raffle card unrolls under it; its days and total are read off
                             Chaster by the server, never off this number. All the code is in ChasterTabView.Ladder.cs.
                             Beside it, pinned: the month's top ten on a torn scrap (owner, 2026-09-26: "the raffle
                             AND the ladder", "brag rights only"), always in view, drawn in ChasterTabView.Scrap.cs. -->
                        <Grid x:Name="AddedRow" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                        <!-- the scrap: the calendar's paper, torn top, a red pin through a punched hole, tilted the other way -->
                        <Grid x:Name="LadderScrap" Grid.Column="1" Width="236" Margin="18,2,6,4" VerticalAlignment="Top"
                              RenderTransformOrigin="0.5,0" MouseEnter="LadderScrap_MouseEnter">
                            <Grid.RenderTransform>
                                <TransformGroup>
                                    <RotateTransform x:Name="LadderScrapTilt" Angle="2.5"/>
                                    <TranslateTransform x:Name="LadderScrapDrop"/>
                                </TransformGroup>
                            </Grid.RenderTransform>
                            <StackPanel>
                                <StackPanel.Effect>
                                    <DropShadowEffect Color="#000000" BlurRadius="14" ShadowDepth="4" Opacity="0.45"/>
                                </StackPanel.Effect>
                                <Path Fill="#FFF3EAD9" Stretch="Fill" Height="9" Margin="0,0,0,-1"
                                      Data="M 0,9 L 0,4 L 7,1 L 13,5 L 20,2 L 26,6 L 33,1 L 39,4 L 46,0 L 52,5 L 59,2 L 66,6 L 72,2 L 79,5 L 85,1 L 92,5 L 100,3 L 100,9 Z"/>
                                <Border Background="#FFF3EAD9" Padding="12,14,12,10">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Str chaster_ladder_title}" FontFamily="/Fonts/#Fredoka, Segoe UI" FontSize="15"
                                                   FontWeight="SemiBold" Foreground="#FF241A2E"/>
                                        <!-- a rubber stamp in red ink, a little crooked -->
                                        <Border BorderBrush="#CCC8244A" BorderThickness="1.5" CornerRadius="3" Padding="6,1,6,1"
                                                HorizontalAlignment="Left" Margin="1,4,0,8" RenderTransformOrigin="0.5,0.5">
                                            <Border.RenderTransform>
                                                <RotateTransform Angle="-4"/>
                                            </Border.RenderTransform>
                                            <TextBlock Text="{loc:Str chaster_ladder_brag}" FontFamily="Consolas, Courier New" FontSize="10"
                                                       FontWeight="Bold" Foreground="#CCC8244A"/>
                                        </Border>
                                        <StackPanel x:Name="LadderScrapRows"/>
                                        <TextBlock x:Name="TxtLadderScrapState" FontSize="12" FontStyle="Italic" Foreground="#99241A2E"
                                                   TextWrapping="Wrap" Margin="0,2,0,2" Visibility="Collapsed"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <!-- the punched hole, and the pin through it -->
                            <Ellipse Width="9" Height="9" Fill="#FF1A1230" Stroke="#66241A2E" StrokeThickness="1"
                                     HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,8,0,0"/>
                            <Ellipse Width="11" Height="11" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="2,3,0,0"
                                     Stroke="#FF8A1830" StrokeThickness="1">
                                <Ellipse.Fill>
                                    <RadialGradientBrush GradientOrigin="0.35,0.3">
                                        <GradientStop Color="#FFFF8FA8" Offset="0"/>
                                        <GradientStop Color="#FFC8244A" Offset="1"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                        </Grid>
                        <Border x:Name="AddedCard" Grid.Column="0" Style="{StaticResource CirceCard}" VerticalAlignment="Top">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="AddedClock" Grid.Column="0" Cursor="Hand" Background="#22FF6B8A" BorderBrush="#88FF6B8A"
                                        BorderThickness="1.5" CornerRadius="14" Padding="14,6,12,6" RenderTransformOrigin="0.5,0.5"
                                        VerticalAlignment="Center" ToolTip="{loc:Str chaster_added_hint}"
                                        MouseEnter="AddedClock_MouseEnter" MouseLeave="AddedClock_MouseLeave"
                                        MouseLeftButtonUp="AddedClock_Click">
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="AddedClockScale"/>
                                    </Border.RenderTransform>
                                    <StackPanel Orientation="Horizontal">
                                        <!-- a stopwatch: ring, crown, one hand the code turns -->
                                        <Grid Width="26" Height="30" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <Rectangle Width="8" Height="4" RadiusX="1.5" RadiusY="1.5" Fill="#FFFF6B8A" VerticalAlignment="Top" HorizontalAlignment="Center"/>
                                            <Ellipse Width="24" Height="24" Stroke="#FFFF6B8A" StrokeThickness="2.5" VerticalAlignment="Bottom"/>
                                            <Rectangle Width="2.5" Height="9" RadiusX="1" RadiusY="1" Fill="#FFFFC0CB" VerticalAlignment="Bottom"
                                                       HorizontalAlignment="Center" Margin="0,0,0,12" RenderTransformOrigin="0.5,1">
                                                <Rectangle.RenderTransform>
                                                    <RotateTransform x:Name="AddedClockHand"/>
                                                </Rectangle.RenderTransform>
                                            </Rectangle>
                                        </Grid>
                                        <TextBlock x:Name="TxtAddedClock" Text="0:00:00" FontFamily="Consolas, Courier New" FontSize="30"
                                                   FontWeight="Bold" Foreground="#FFFF6B8A" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtAddedChevron" Text="&#x25BE;" FontSize="14" Margin="10,0,0,0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextMutedBrush}" RenderTransformOrigin="0.5,0.5"/>
                                    </StackPanel>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="16,0,12,0" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:Str chaster_added_title}" Style="{StaticResource CirceEyebrow}"/>
                                    <TextBlock x:Name="TxtAddedMonth" FontFamily="/Fonts/#Fredoka, Segoe UI" FontSize="15" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextLightBrush}" Margin="0,2,0,0"/>
                                    <TextBlock Text="{loc:Str chaster_added_note}" Style="{StaticResource CirceSub}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Grid Grid.Column="2" VerticalAlignment="Center">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{loc:Str chaster_raffle_post_days}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"
                                               HorizontalAlignment="Right" Foreground="{DynamicResource TextSecondaryBrush}"
                                               ToolTip="{loc:Str chaster_raffle_post_days_tip}"/>
                                    <CheckBox x:Name="ChkRafflePost" Grid.Column="1" Style="{StaticResource ToggleStyle}" VerticalAlignment="Center"
                                              ToolTip="{loc:Str chaster_raffle_post_days_tip}"
                                              Checked="ChkRafflePost_Changed" Unchecked="ChkRafflePost_Changed"/>
                                    <TextBlock Grid.Row="1" Text="{loc:Str chaster_ladder_show_name}" FontSize="12" VerticalAlignment="Center"
                                               Margin="0,8,8,0" HorizontalAlignment="Right" Foreground="{DynamicResource TextSecondaryBrush}"
                                               ToolTip="{loc:Str chaster_ladder_show_name_tip}"/>
                                    <CheckBox x:Name="ChkLadderName" Grid.Row="1" Grid.Column="1" Style="{StaticResource ToggleStyle}"
                                              VerticalAlignment="Center" Margin="0,8,0,0" ToolTip="{loc:Str chaster_ladder_show_name_tip}"
                                              Checked="ChkLadderName_Changed" Unchecked="ChkLadderName_Changed"/>
                                </Grid>
                            </Grid>
                        </Border>
                        </Grid>

                        <!-- The first switch-on, and only the first: four facts, one button. -->
                        <Border x:Name="ConsentCard" Visibility="Collapsed" Style="{StaticResource CirceCard}"
                                BorderBrush="#FF6B8A" BorderThickness="1.5" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="{loc:Str chaster_consent_title}" FontFamily="/Fonts/#Fredoka, Segoe UI" FontSize="18"
                                           FontWeight="SemiBold" Foreground="{DynamicResource TextLightBrush}" Margin="0,0,0,12"/>
                                <UniformGrid Columns="4" Margin="0,0,-10,0">
                                    <Border Style="{StaticResource CirceFact}">
                                        <StackPanel>
                                            <TextBlock x:Name="TxtFactCap2" Text="3:00:00" Style="{StaticResource CirceFactGlyph}"/>
                                            <TextBlock Text="{loc:Str chaster_fact_cap}" Style="{StaticResource CirceFactText}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource CirceFact}">
                                        <StackPanel>
                                            <TextBlock Text="&#x21BA;" Style="{StaticResource CirceFactGlyph}"/>
                                            <TextBlock Text="{loc:Str chaster_fact_floor}" Style="{StaticResource CirceFactText}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource CirceFact}">
                                        <StackPanel>
                                            <TextBlock Text="PANIC" Style="{StaticResource CirceFactGlyph}" Foreground="#FF6B8A"/>
                                            <TextBlock Text="{loc:Str chaster_fact_panic}" Style="{StaticResource CirceFactText}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource CirceFact}">
                                        <StackPanel>
                                            <TextBlock Text="LIVE" Style="{StaticResource CirceFactGlyph}"/>
                                            <TextBlock Text="{loc:Str chaster_fact_push}" Style="{StaticResource CirceFactText}"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>
                                <Button x:Name="BtnConsentOk" Style="{StaticResource CirceCta}" Content="{loc:Str chaster_consent_ok}"
                                        HorizontalAlignment="Left" Height="46" FontSize="16" Margin="0,14,0,0" Click="BtnConsentOk_Click"/>
                            </StackPanel>
                        </Border>

                        <!-- ================= 4. THE KEYS ================= -->
                        <TextBlock x:Name="PricesHeader" Text="{loc:Str chaster_keys_eyebrow}" Style="{StaticResource CirceEyebrow}" Margin="4,4,0,8"/>
                        <UniformGrid x:Name="PresetRow" Columns="4" Margin="0,0,-12,0">
                            <ToggleButton x:Name="BtnPresetGentle" Style="{StaticResource CirceKey}" Tag="gentle" Click="Preset_Click"
                                          ToolTip="{loc:Str chaster_preset_gentle_hint}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="{loc:Str chaster_preset_gentle}" FontFamily="/Fonts/#Fredoka, Segoe UI" FontSize="17" FontWeight="SemiBold"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="TxtStakesGentle" FontFamily="/Fonts/#Fredoka, Segoe UI" FontSize="12" Opacity="0.7"
                                               HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton x:Name="BtnPresetStrict" Style="{StaticResource CirceKey}" Tag="strict" Click="Preset_Click"
                                          ToolTip="{loc:Str chaster_preset_strict_hint}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="{loc:Str chaster_preset_strict}" FontFamily="/Fonts/#Fredoka, Segoe UI" FontSize="17" FontWeight="SemiBold"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="TxtStakesStrict" FontFamily="/Fonts/#Fredoka, Segoe UI" FontSize="12" Opacity="0.7"
                                               HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton x:Name="BtnPresetCirce" Style="{StaticResource CirceKey}" Tag="circe" Click="Preset_Click"
                                          ToolTip="{loc:Str chaster_preset_circe_hint}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="{loc:Str chaster_preset_circe}" FontFamily="/Fonts/#Fredoka, Segoe UI" FontSize="17" FontWeight="SemiBold"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="TxtStakesCirce" FontFamily="/Fonts/#Fredoka, Segoe UI" FontSize="12" Opacity="0.7"
                                               HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </ToggleButton>
                            <!-- The fourth key is the player's own mix: it lights whenever the boards match no
                                 preset, and pressing it changes nothing. -->
                            <ToggleButton x:Name="BtnPresetCustom" Style="{StaticResource CirceKey}" Tag="custom" Click="Preset_Click"
                                          ToolTip="{loc:Str chaster_key_custom_hint}">
                                <TextBlock Text="{loc:Str chaster_preset_custom}" FontFamily="/Fonts/#Fredoka, Segoe UI" FontSize="17" FontWeight="SemiBold"/>
                            </ToggleButton>
                        </UniformGrid>

                        <!-- ================= 5. THE MENU: two boards, always in view ================= -->
                        <TextBlock Text="{loc:Str chaster_menu_eyebrow}" Style="{StaticResource CirceEyebrow}" Margin="4,18,0,8"/>
                        <Grid x:Name="Boards">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="CostBoard" Grid.Column="0" Style="{StaticResource CirceCard}" Padding="14,12,6,6"
                                    BorderBrush="#66FF6B8A">
                                <StackPanel>
                                    <TextBlock Text="{loc:Str chaster_board_costs}" FontFamily="/Fonts/#Fredoka, Segoe UI" FontSize="15"
                                               FontWeight="SemiBold" Foreground="#FF8FA3" Margin="2,0,0,10"/>
                                    <UniformGrid x:Name="CostRows" Columns="2"/>
                                </StackPanel>
                            </Border>
                            <Border x:Name="EarnBoard" Grid.Column="2" Style="{StaticResource CirceCard}" Padding="14,12,6,6"
                                    BorderBrush="#665FFFD0">
                                <StackPanel>
                                    <TextBlock Text="{loc:Str chaster_board_earns}" FontFamily="/Fonts/#Fredoka, Segoe UI" FontSize="15"
                                               FontWeight="SemiBold" Foreground="#5FFFD0" Margin="2,0,0,10"/>
                                    <UniformGrid x:Name="EarnRows" Columns="2"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- The jackpot, across both boards: gold, dashed, not a switch. -->
                        <Grid x:Name="JackpotRow" Margin="0,12,0,0" Cursor="Help">
                            <Rectangle Stroke="#E0B052" StrokeThickness="1.2" StrokeDashArray="5 3" RadiusX="12" RadiusY="12" Fill="#12E0B052" Opacity="0.9"/>
                            <Grid Margin="12,9,14,9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="JackpotThumb" Grid.Column="0" Width="44" Height="44" CornerRadius="8" ClipToBounds="True" Margin="0,0,12,0">
                                    <Image Source="pack://application:,,,/Resources/features/backroom.png" Stretch="UniformToFill"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:Str chaster_short_jackpot}" FontFamily="/Fonts/#Fredoka, Segoe UI" FontSize="15"
                                               FontWeight="SemiBold" Foreground="#E0B052"/>
                                    <TextBlock Text="{loc:Str chaster_flavour_jackpot}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="0:00" FontFamily="Consolas, Courier New" FontSize="15" FontWeight="Bold"
                                           Foreground="#E0B052" VerticalAlignment="Center"/>
                            </Grid>
                        </Grid>

                        <!-- the footer facts -->
                        <WrapPanel x:Name="FootRow" Margin="0,14,-8,0">
                            <Border Style="{StaticResource CirceFoot}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="PANIC" FontFamily="/Fonts/#Fredoka, Segoe UI" FontSize="11" FontWeight="Bold" Foreground="#FF6B8A" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{loc:Str chaster_fact_panic}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CirceFoot}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="LIVE" FontFamily="/Fonts/#Fredoka, Segoe UI" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextLightBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{loc:Str chaster_fact_push_launch}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CirceFoot}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#x21BA;" FontFamily="/Fonts/#Fredoka, Segoe UI" FontSize="12" FontWeight="Bold" Foreground="#5FFFD0" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{loc:Str chaster_fact_floor_long}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CirceFoot}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#x2298;" FontFamily="/Fonts/#Fredoka, Segoe UI" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{loc:Str chaster_fact_unlink}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </WrapPanel>

                        <!-- the two limits, behind one link: most players never touch them -->
                        <Grid Margin="0,10,0,0">
                            <Button x:Name="BtnLimits" Style="{StaticResource CirceLink}" Content="{loc:Str chaster_limits}"
                                    HorizontalAlignment="Left" Click="BtnLimits_Click"/>
                        </Grid>
                        <Border x:Name="LimitsCard" Visibility="Collapsed" Style="{StaticResource CirceCard}" Margin="0,10,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto" MinWidth="90"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="{loc:Str chaster_limit_day}" FontSize="13" Foreground="{DynamicResource TextLightBrush}"
                                           VerticalAlignment="Center" Margin="0,0,16,0"/>
                                <Slider x:Name="SliderDayLimit" Grid.Column="1" Minimum="15" Maximum="720" TickFrequency="15"
                                        IsSnapToTickEnabled="True" SmallChange="15" LargeChange="60" VerticalAlignment="Center"
                                        ValueChanged="LimitSlider_ValueChanged"/>
                                <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0">
                                    <TextBlock x:Name="TxtDayLimit" FontFamily="Consolas, Courier New" FontSize="15" FontWeight="Bold"
                                               Foreground="#FF6B8A" HorizontalAlignment="Right"/>
                                    <!-- a raise waits a day: the figure it goes to, and when -->
                                    <TextBlock x:Name="TxtDayPending" FontFamily="Consolas, Courier New" FontSize="10.5" HorizontalAlignment="Right"
                                               Foreground="#E0B052" Visibility="Collapsed" ToolTip="{loc:Str chaster_limit_pending_tip}"/>
                                </StackPanel>
                                <TextBlock Grid.Row="1" Text="{loc:Str chaster_limit_backlog}" FontSize="13" Foreground="{DynamicResource TextLightBrush}"
                                           VerticalAlignment="Center" Margin="0,12,16,0" ToolTip="{loc:Str chaster_limit_backlog_hint}"/>
                                <Slider x:Name="SliderBacklogLimit" Grid.Row="1" Grid.Column="1" Minimum="60" Maximum="2880" TickFrequency="60"
                                        IsSnapToTickEnabled="True" SmallChange="60" LargeChange="360" VerticalAlignment="Center" Margin="0,12,0,0"
                                        ValueChanged="LimitSlider_ValueChanged" ToolTip="{loc:Str chaster_limit_backlog_hint}"/>
                                <StackPanel Grid.Row="1" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,12,0,0">
                                    <TextBlock x:Name="TxtBacklogLimit" FontFamily="Consolas, Courier New" FontSize="15"
                                               FontWeight="Bold" Foreground="#FF6B8A" HorizontalAlignment="Right"/>
                                    <TextBlock x:Name="TxtBacklogPending" FontFamily="Consolas, Courier New" FontSize="10.5" HorizontalAlignment="Right"
                                               Foreground="#E0B052" Visibility="Collapsed" ToolTip="{loc:Str chaster_limit_pending_tip}"/>
                                </StackPanel>
                                <CheckBox x:Name="ChkRelock" Grid.Row="2" Grid.ColumnSpan="3" Margin="0,14,0,0"
                                          Content="{loc:Str chaster_relock}" ToolTip="{loc:Str chaster_relock_hint}"
                                          Foreground="{DynamicResource TextLightBrush}" FontSize="13"
                                          Checked="ChkRelock_Changed" Unchecked="ChkRelock_Changed"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- ================= THE TRAILER: one popup, re-aimed at whichever row is hovered =================
             The scene is the saved mockup's vignette engine in a WebView2 (ChasterTrailerView),
             created once and reused for every row. A WebView2 is a native child HWND and does not
             paint under AllowsTransparency, so this popup is OPAQUE and square; the still picture
             sits under the browser as its loading frame and as the fallback when there is no
             runtime. The figure, the badge and the two lines live BELOW the plate, where the
             browser's airspace cannot swallow them. -->
        <Popup x:Name="Trailer" AllowsTransparency="False" Placement="Bottom" VerticalOffset="6" PopupAnimation="None"
               StaysOpen="True" MouseEnter="Trailer_MouseEnter" MouseLeave="Trailer_MouseLeave">
            <Border x:Name="TrailerCard" Width="320" Background="#FF1A1230" BorderBrush="{DynamicResource GlassBorderBrush}"
                    BorderThickness="1" Padding="8">
                <AdornerDecorator>
                    <StackPanel>
                        <!-- the scene: 320x200 logical, so the plate keeps that aspect -->
                        <Grid x:Name="TrailerPlate" Height="190" ClipToBounds="True">
                            <Border Background="#FF120C1F">
                                <Image x:Name="TrailerArt" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"
                                       RenderTransformOrigin="0.5,0.5">
                                    <Image.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform x:Name="TrailerArtScale"/>
                                            <TranslateTransform x:Name="TrailerArtPan"/>
                                        </TransformGroup>
                                    </Image.RenderTransform>
                                </Image>
                            </Border>
                            <ctrl:ChasterTrailerView x:Name="TrailerWeb" Visibility="Collapsed"/>
                        </Grid>
                        <Grid Margin="6,8,6,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TxtTrailerFlavour" Grid.Column="0" FontFamily="/Fonts/#Fredoka, Segoe UI" FontSize="14" FontWeight="Medium"
                                       Foreground="{DynamicResource TextLightBrush}" TextWrapping="Wrap"/>
                            <Border x:Name="TrailerBadgeHost" Grid.Column="1" VerticalAlignment="Top" Margin="8,0,0,0"/>
                        </Grid>
                        <Grid Margin="6,4,6,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TxtTrailerWhy" Grid.Column="0" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.85"
                                       TextWrapping="Wrap"/>
                            <!-- the figure floats up off this, the way it floats off the padlock -->
                            <Border x:Name="TrailerFigureAnchor" Grid.Column="1" Width="56" Height="22" VerticalAlignment="Bottom" Margin="8,0,0,0"/>
                        </Grid>
                    </StackPanel>
                </AdornerDecorator>
            </Border>
        </Popup>

        <!-- ================= THE RAFFLE CARD: unrolls under the heads-up clock =================
             The player's own card, never anyone else's (owner, 2026-09-26: a raffle, not a board).
             Hover opens it (StaysOpen, no mouse capture), a click on the clock pins it, a click
             anywhere else or the app losing focus closes a pinned one. Drawn in ChasterTabView.Ladder.cs. -->
        <Popup x:Name="LadderPopup" AllowsTransparency="True" Placement="Bottom" VerticalOffset="8" PopupAnimation="None"
               StaysOpen="True" MouseEnter="LadderPopup_MouseEnter" MouseLeave="LadderPopup_MouseLeave" Opened="LadderPopup_Opened">
            <Border x:Name="LadderCard" Width="360" Background="#F7201636" BorderBrush="#88FF6B8A" BorderThickness="1.5"
                    CornerRadius="16" Padding="14,12,14,12" RenderTransformOrigin="0.5,0">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="LadderUnroll"/>
                </Border.RenderTransform>
                <StackPanel>
                    <Grid Margin="2,0,0,8">
                        <TextBlock Text="{loc:Str chaster_raffle_title}" FontFamily="/Fonts/#Fredoka, Segoe UI" FontSize="17" FontWeight="SemiBold"
                                   Foreground="#FFF3EAF7"/>
                        <TextBlock x:Name="TxtRaffleDay" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12"
                                   FontWeight="SemiBold" Foreground="#FFC9B8D8"/>
                    </Grid>
                    <StackPanel x:Name="LadderRows">
                        <!-- one pip a day of the month: lit = a day CCP's add counted -->
                        <WrapPanel x:Name="RafflePips" Margin="0,0,0,10"/>
                        <Grid Margin="0,0,0,2">
                            <TextBlock x:Name="TxtRaffleDays" FontSize="13" Foreground="#FFF3EAF7"/>
                            <TextBlock x:Name="TxtRaffleTotal" HorizontalAlignment="Right" FontFamily="Consolas, Courier New" FontSize="13"
                                       FontWeight="Bold" Foreground="#FFFF6B8A"/>
                        </Grid>
                        <Border x:Name="RaffleStatusChip" CornerRadius="10" Padding="10,5,10,5" Margin="0,8,0,0" HorizontalAlignment="Left">
                            <TextBlock x:Name="TxtRaffleStatus" FontFamily="/Fonts/#Fredoka, Segoe UI" FontSize="14" FontWeight="SemiBold"/>
                        </Border>
                        <TextBlock x:Name="TxtRaffleTicketOn" FontSize="12" Foreground="#FFC9B8D8" Margin="2,4,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtLadderState" FontSize="12" Foreground="#FFC9B8D8" Margin="2,6,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                    <TextBlock Text="{loc:Str chaster_added_note}" FontSize="11" Foreground="#FFA898B8" Margin="2,10,0,0" TextWrapping="Wrap"/>
                    <Grid Margin="2,2,0,0">
                        <TextBlock Text="{loc:Str chaster_raffle_rule}" FontSize="11" Foreground="#FFA898B8" TextWrapping="Wrap" Margin="0,0,48,0"/>
                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Bottom" FontSize="11">
                            <Hyperlink x:Name="LnkRaffleRules" Foreground="#FFFF9BB0" Click="LnkRaffleRules_Click">
                                <Run Text="{loc:Str chaster_raffle_rules}"/>
                            </Hyperlink>
                        </TextBlock>
                    </Grid>
                </StackPanel>
            </Border>
        </Popup>

        <!-- ================= event layers over the page ================= -->
        <Canvas x:Name="ShockwaveCanvas" IsHitTestVisible="False" ClipToBounds="True"/>
        <!-- The spark canvas is SMALL and moves to the anchor: a burst's travel and dot size scale
             with its canvas, and one spanning the page threw sparks the size of a card. -->
        <Canvas x:Name="BurstHost" IsHitTestVisible="False" ClipToBounds="True">
            <ctrl:AmbientFxCanvas x:Name="BurstLayer" x:FieldModifier="internal" Width="560" Height="560" IsHitTestVisible="False"/>
        </Canvas>
        <!-- the page's edge, the launcher's window edge at card weight -->
        <Border BorderBrush="{DynamicResource PanelAccentBrush}" BorderThickness="1.5" CornerRadius="18" Opacity="0.45" IsHitTestVisible="False"/>
    </Grid>
</UserControl>
