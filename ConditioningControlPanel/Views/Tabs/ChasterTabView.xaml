<UserControl x:Class="ConditioningControlPanel.Views.Tabs.ChasterTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="clr-namespace:ConditioningControlPanel.Localization"
             xmlns:ctrl="clr-namespace:ConditioningControlPanel.Controls"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">
    <!-- CIRCE'S TAB. Two states and nothing else: not linked (what it is, one button) and linked.
         The linked page reads top to bottom as the lock's story: the LOCK first (it is the thing
         the player actually cares about, not a running total), then TODAY (how much of the daily
         60:00 is spent and when the next push is), then the balance and the master switch, then
         prices and this run's bill behind expanders.
         All logic is in Services/Chaster; this view only reads ChasterService and writes four
         settings (ChasterTabEnabled, ChasterConsentSeen, ChasterLockId, ChasterPrices). -->
    <Border Style="{StaticResource SectionPanel}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="640" HorizontalAlignment="Left" Margin="0,0,12,0">
                <TextBlock Style="{StaticResource SectionHeader}" Text="{loc:Str chaster_title}" Margin="0"/>
                <TextBlock Text="{loc:Str chaster_subtitle}" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,4,0,16"/>

                <!-- NOT LINKED -->
                <StackPanel x:Name="UnlinkedPanel">
                    <TextBlock Text="{loc:Str chaster_intro_1}" TextWrapping="Wrap" FontSize="13"
                               Foreground="{DynamicResource TextLightBrush}" Margin="0,0,0,8"/>
                    <TextBlock Text="{loc:Str chaster_intro_2}" TextWrapping="Wrap" FontSize="13"
                               Foreground="{DynamicResource TextLightBrush}" Margin="0,0,0,8"/>
                    <TextBlock Text="{loc:Str chaster_intro_3}" TextWrapping="Wrap" FontSize="13"
                               Foreground="{DynamicResource TextLightBrush}" Margin="0,0,0,16"/>
                    <Button x:Name="BtnLink" Style="{StaticResource PinkButton}" Content="{loc:Str chaster_link}"
                            HorizontalAlignment="Left" Padding="18,8" Click="BtnLink_Click"/>
                    <!-- What pressing it actually does, and the cheapest way to try the whole thing. -->
                    <TextBlock Text="{loc:Str chaster_link_browser_hint}" TextWrapping="Wrap" FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,10,0,0"/>
                    <TextBlock Text="{loc:Str chaster_link_test_hint}" TextWrapping="Wrap" FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0"/>
                    <StackPanel x:Name="LinkingRow" Orientation="Horizontal" Visibility="Collapsed" Margin="0,10,0,0">
                        <TextBlock Text="{loc:Str chaster_linking}" VerticalAlignment="Center" FontSize="13"
                                   Foreground="{DynamicResource TextLightBrush}" Margin="0,0,14,0"/>
                        <Button Style="{StaticResource SecondaryButton}" Content="{loc:Str chaster_cancel}"
                                Padding="14,6" Click="BtnCancelLink_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtLinkNote" Visibility="Collapsed" TextWrapping="Wrap" FontSize="12"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,12,0,0"/>
                </StackPanel>

                <!-- LINKED -->
                <StackPanel x:Name="LinkedPanel" Visibility="Collapsed">

                    <!-- 1. THE LOCK. The hero, because it is the one number the player cannot move. -->
                    <Border x:Name="HeroCard" Background="{DynamicResource SurfaceBgBrush}" CornerRadius="10"
                            Padding="16,14,16,14" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock x:Name="TxtHeroTitle" FontSize="12" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextMutedBrush}" Visibility="Collapsed"/>
                            <StackPanel x:Name="HeroClockRow" Orientation="Horizontal" Margin="0,2,0,0"
                                        Visibility="Collapsed">
                                <TextBlock x:Name="TxtHeroClock" FontSize="32" FontWeight="Bold"
                                           FontFamily="Consolas, Courier New"
                                           Foreground="{DynamicResource TextLightBrush}"/>
                                <TextBlock Text="{loc:Str chaster_hero_caption}" FontSize="12" VerticalAlignment="Bottom"
                                           Margin="10,0,0,6" Foreground="{DynamicResource TextMutedBrush}"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtHeroEnds" FontSize="12" Margin="0,4,0,0" Visibility="Collapsed"
                                       Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock x:Name="TxtHeroState" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Visibility="Collapsed" Foreground="#FFC98A"/>

                            <Grid x:Name="LockRow" Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{loc:Str chaster_lock_label}" Style="{StaticResource SettingLabel}"
                                           FontSize="13" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtLock" Grid.Column="1" FontSize="12" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextMutedBrush}"/>
                                <ComboBox x:Name="CmbLock" Grid.Column="1" Visibility="Collapsed"
                                          Style="{StaticResource DarkComboBoxStyle}" FontSize="11"
                                          Foreground="{DynamicResource TextLightBrush}"
                                          Width="220" MinHeight="28" VerticalAlignment="Center"
                                          SelectionChanged="CmbLock_SelectionChanged"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 2. TODAY. The cap is the safety rail, so it is drawn, not described. -->
                    <StackPanel Margin="0,0,0,16">
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="{loc:Str chaster_day_header}" Style="{StaticResource SettingLabel}" FontSize="13"/>
                            <TextBlock x:Name="TxtToday" HorizontalAlignment="Right" FontSize="12"
                                       FontFamily="Consolas, Courier New"
                                       Foreground="{DynamicResource TextMutedBrush}"/>
                        </Grid>
                        <Grid Height="6">
                            <Border Background="#22FFFFFF" CornerRadius="3"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <!-- The meter is laid out, never measured: two star columns the code
                                         weighs by the fraction, so it is right at any width with no
                                         ActualWidth read and no SizeChanged handler. -->
                                    <ColumnDefinition x:Name="CapFilled" Width="0*"/>
                                    <ColumnDefinition x:Name="CapRest" Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="CapFill" Background="#FF6B8A" CornerRadius="3"/>
                            </Grid>
                        </Grid>
                        <TextBlock Text="{loc:Str chaster_settle_line}" TextWrapping="Wrap" FontSize="11"
                                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,8,0,0"/>
                        <TextBlock x:Name="TxtHold" TextWrapping="Wrap" FontSize="11" Visibility="Collapsed"
                                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- 3. THE BALANCE AND THE SWITCH -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                            <TextBlock x:Name="TxtBalance" Text="0:00" FontSize="36" FontWeight="Bold"
                                       FontFamily="Consolas, Courier New" Foreground="{DynamicResource TextLightBrush}"/>
                            <TextBlock x:Name="TxtBalanceCaption" Text="{loc:Str chaster_balance_caption}" FontSize="13"
                                       VerticalAlignment="Bottom" Margin="10,0,0,7"
                                       Foreground="{DynamicResource TextMutedBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,8">
                            <TextBlock Text="{loc:Str chaster_tab_switch}" Style="{StaticResource SettingLabel}"
                                       FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <CheckBox x:Name="ChkTab" Style="{StaticResource ToggleStyle}"
                                      VerticalAlignment="Center" Checked="ChkTab_Changed" Unchecked="ChkTab_Changed"/>
                        </StackPanel>
                    </Grid>

                    <!-- The first switch-on, and only the first: four facts, inline, no modal. -->
                    <Border x:Name="ConsentCard" Visibility="Collapsed" Margin="0,0,0,14"
                            Background="{DynamicResource SurfaceBgBrush}" BorderBrush="#FF8FA3"
                            BorderThickness="1" CornerRadius="10" Padding="14,12,14,12">
                        <StackPanel>
                            <TextBlock Text="{loc:Str chaster_consent_title}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextLightBrush}" Margin="0,0,0,8"/>
                            <TextBlock Text="{loc:Str chaster_consent_1}" TextWrapping="Wrap" FontSize="12"
                                       Foreground="{DynamicResource TextLightBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="{loc:Str chaster_consent_2}" TextWrapping="Wrap" FontSize="12"
                                       Foreground="{DynamicResource TextLightBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="{loc:Str chaster_consent_3}" TextWrapping="Wrap" FontSize="12"
                                       Foreground="{DynamicResource TextLightBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="{loc:Str chaster_consent_4}" TextWrapping="Wrap" FontSize="12"
                                       Foreground="{DynamicResource TextLightBrush}" Margin="0,0,0,4"/>
                            <Button x:Name="BtnConsentOk" Style="{StaticResource PinkButton}"
                                    Content="{loc:Str chaster_consent_ok}" HorizontalAlignment="Left"
                                    Padding="16,6" Margin="0,10,0,0" Click="BtnConsentOk_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- 4. PRICES. Presets lead; the twenty-two switches live behind Customize. -->
                    <Expander x:Name="PricesExpander" Header="{loc:Str chaster_prices_header}"
                              Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" Margin="0,0,0,8">
                        <StackPanel Margin="4,8,0,4">
                            <TextBlock Text="{loc:Str chaster_preset_header}" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,8"/>
                            <WrapPanel x:Name="PresetRow">
                                <Button x:Name="BtnPresetGentle" Style="{StaticResource OutlineButton}" Tag="gentle"
                                        Content="{loc:Str chaster_preset_gentle}" FontSize="12" Padding="14,5"
                                        Margin="0,0,8,8" Click="Preset_Click"/>
                                <Button x:Name="BtnPresetStrict" Style="{StaticResource OutlineButton}" Tag="strict"
                                        Content="{loc:Str chaster_preset_strict}" FontSize="12" Padding="14,5"
                                        Margin="0,0,8,8" Click="Preset_Click"/>
                                <Button x:Name="BtnPresetCirce" Style="{StaticResource OutlineButton}" Tag="circe"
                                        Content="{loc:Str chaster_preset_circe}" FontSize="12" Padding="14,5"
                                        Margin="0,0,8,8" Click="Preset_Click"/>
                                <!-- Not a button you press: the chip that lights when the set is the
                                     player's own. It sits with the presets because that is where they
                                     look to find out which one they are on. -->
                                <Button x:Name="BtnPresetCustom" Style="{StaticResource OutlineButton}" Tag="custom"
                                        Content="{loc:Str chaster_preset_custom}" FontSize="12" Padding="14,5"
                                        Margin="0,0,8,8" IsHitTestVisible="False" Focusable="False"
                                        Visibility="Collapsed"/>
                                <Button x:Name="BtnCustomize" Style="{StaticResource SecondaryButton}"
                                        Content="{loc:Str chaster_preset_customize}" FontSize="12" Padding="14,5"
                                        Margin="0,0,8,8" Click="BtnCustomize_Click"/>
                            </WrapPanel>
                            <TextBlock x:Name="TxtPresetHint" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4"
                                       Foreground="{DynamicResource TextMutedBrush}"/>

                            <StackPanel x:Name="CustomizeHost" Visibility="Collapsed" Margin="0,8,0,0">
                                <TextBlock Text="{loc:Str chaster_prices_hint}" FontSize="12" Margin="0,0,0,8"
                                           Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock Text="{loc:Str chaster_costs_header}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="#FF8FA3" Margin="0,4,0,4"/>
                                <StackPanel x:Name="CostRows"/>
                                <TextBlock Text="{loc:Str chaster_earns_header}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="#5FFFD0" Margin="0,12,0,4"/>
                                <StackPanel x:Name="EarnRows"/>
                            </StackPanel>
                        </StackPanel>
                    </Expander>

                    <!-- 5. THE BILL, on paper. -->
                    <Expander Header="{loc:Str chaster_bill_header}" Expanded="BillExpander_Expanded"
                              Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" Margin="0,0,0,14">
                        <ctrl:ChasterReceiptView x:Name="Receipt" HorizontalAlignment="Left" Margin="4,8,0,4"/>
                    </Expander>

                    <TextBlock Text="{loc:Str chaster_intro_3}" TextWrapping="Wrap" FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,12"/>
                    <Button Style="{StaticResource SecondaryButton}" Content="{loc:Str chaster_unlink}"
                            HorizontalAlignment="Left" Padding="14,6" Click="BtnUnlink_Click"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
