<UserControl x:Class="ConditioningControlPanel.Views.Tabs.LeashTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:ConditioningControlPanel.Localization">
    <!-- Social > Leash (nav rework 2026-10-06). Hosts LeashDrawerSection, the same cards the
         friends drawer pins on top: offers, your own card (with the cut, never priced) and one
         card per account you hold. The "?" explainer sits top right. The punishment gate is a
         panel overlay above every page (MainWindow.Leash.cs), so this page cannot route round it. -->
    <Grid Margin="32,20,32,20" MaxWidth="660">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border x:Name="HelpHost" x:FieldModifier="internal" Grid.Row="0" HorizontalAlignment="Right"
                Margin="0,0,0,8"/>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <StackPanel x:Name="SectionHost" x:FieldModifier="internal"/>
                <StackPanel x:Name="EmptyPanel" x:FieldModifier="internal" HorizontalAlignment="Center"
                            Margin="18,40,18,28">
                    <TextBlock Text="{loc:Str social_leash_empty}" Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="13" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,12"/>
                    <Border x:Name="EmptyButtonHost" x:FieldModifier="internal" HorizontalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
