<UserControl x:Class="ConditioningControlPanel.Views.Tabs.GradedIntakeTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="clr-namespace:ConditioningControlPanel.Localization"
             xmlns:helpers="clr-namespace:ConditioningControlPanel.Helpers"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="36,28,36,28">
            <StackPanel MaxWidth="960" HorizontalAlignment="Center">

                <!-- Hero banner. Same artwork the Lab card used; still an ImageBrush (not an
                     Image) so the mod resource resolver can swap it - see the labHeroMap in
                     MainWindow.xaml.cs, which drone mods override with a green variant. -->
                <Border CornerRadius="14" Margin="0,0,0,24" Height="260" ClipToBounds="True"
                        BorderBrush="{DynamicResource PinkBrush}" BorderThickness="1">
                    <Grid>
                        <Border CornerRadius="14">
                            <Border.Background>
                                <ImageBrush x:Name="GradedIntakeHeroBrush" x:FieldModifier="internal"
                                            ImageSource="pack://application:,,,/Resources/features/lab_quiz_hero.png"
                                            Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>
                        <Border CornerRadius="14">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                    <GradientStop Color="{DynamicResource SurfaceBg}" Offset="0"/>
                                    <GradientStop Color="Transparent" Offset="0.9"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </Grid>
                </Border>

                <!-- ═══ HEADER ZONE ═══ -->
                <Grid Margin="0,0,0,22">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="44" Height="44" CornerRadius="12" Margin="0,0,14,0"
                                Background="{DynamicResource AccentTintedBgBrush}"
                                BorderBrush="{DynamicResource PanelAccentBrush}" BorderThickness="1">
                            <Image Width="24" Height="24" Source="{Binding Source='❓', Converter={StaticResource EmojiToImageSource}}"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <!-- Literal, not a loc key: the intake's own page content is
                                     English-only, and the launch button beside it has always been
                                     a literal too. Localise both together when the page localises. -->
                                <TextBlock Text="Graded Intake" Foreground="White" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
                                <Border Background="{DynamicResource TransparentPink20Brush}" BorderBrush="{DynamicResource PinkBrush}" BorderThickness="1"
                                        CornerRadius="6" Padding="6,2" Margin="11,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:Str label_beta_2}" Foreground="{DynamicResource PinkBrush}" FontFamily="Consolas" FontWeight="Bold" FontSize="9.5"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="A banded descent that reads how you answer - and how long you take - and drafts a personalised session from it."
                                       Foreground="{DynamicResource TextMutedBrush}" FontSize="12.5" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <Button x:Name="HelpBtnQuiz" x:FieldModifier="internal" Style="{StaticResource HelpButtonStyle}"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Tag="Quiz"/>
                </Grid>

                <!-- ═══ INTAKE ZONE (t1 gated) ═══
                     Wrapped in a Grid so GradedIntakeGate can sit over just this section:
                     Pop Quiz below is NOT premium and stays reachable for everyone, exactly
                     as it was in the Lab. -->
                <Grid Margin="0,0,0,10">
                    <Border x:Name="GradedIntakeGatedContent" x:FieldModifier="internal"
                            Background="{DynamicResource SurfaceBgBrush}" BorderBrush="{DynamicResource PinkBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="20,18" MinHeight="150">
                        <StackPanel>
                            <TextBlock Text="Begin a run" Foreground="White" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,4"/>
                            <TextBlock Text="Each intake runs in its own window. Answer honestly - the pacing of your answers counts as much as the answers themselves."
                                       Foreground="{DynamicResource TextMutedBrush}" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,14"/>

                            <!-- HIDDEN (pending removal): classic-quiz launch options. Still read by
                                 BtnStartQuiz_Click, so the fallback keeps its last-set values. -->
                            <CheckBox x:Name="ChkQuizFullscreen" x:FieldModifier="internal" Content="{loc:Str btn_fullscreen}" IsChecked="True" Visibility="Collapsed"
                                      Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,0,0,4"/>
                            <CheckBox x:Name="ChkQuizDrone" x:FieldModifier="internal" Content="{loc:Str setting_play_drone_in_background}" IsChecked="False" Visibility="Collapsed"
                                      Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,0,0,10"/>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <!-- HIDDEN (pending removal): the classic AI quiz. Handler left intact
                                     so it can be re-shown by deleting one attribute if the intake regresses. -->
                                <Button x:Name="BtnStartQuiz" x:FieldModifier="internal" Content="{loc:Str btn_start_quiz}" Cursor="Hand" Visibility="Collapsed"
                                        Background="{DynamicResource SecondaryBrush}" Foreground="White" FontWeight="Bold" FontSize="12"
                                        BorderThickness="0" Padding="12,8"
                                        Click="BtnStartQuiz_Click">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="8"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                                <!-- "Graded Intake": hosted in WebView2, drafts a themed session from a
                                     banded-descent run. The page's primary (and only visible) action. -->
                                <Button x:Name="BtnStartIntake" x:FieldModifier="internal" Content="✨ Begin Intake" Cursor="Hand"
                                        Background="{DynamicResource SecondaryBrush}" Foreground="White" FontWeight="Bold" FontSize="13"
                                        BorderThickness="0" Padding="18,10"
                                        ToolTip="A banded descent that drafts a personalised session from how you answer (Beta)."
                                        Click="BtnStartIntake_Click">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="8"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </StackPanel>

                            <TextBlock Text="{loc:Str label_past_quizzes}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,14,0,4"
                                       x:Name="TxtPastQuizzesHeader" x:FieldModifier="internal" Visibility="Collapsed"/>
                            <Border MaxHeight="130" CornerRadius="6" x:Name="PastQuizzesPanel" x:FieldModifier="internal" Visibility="Collapsed"
                                    Background="#10FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="PastQuizzesList" x:FieldModifier="internal"/>
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Translucent gating overlay (free users) -->
                    <Border x:Name="GradedIntakeGate" x:FieldModifier="internal" Visibility="Collapsed"
                            Background="#99000010" BorderBrush="#FF69B4" BorderThickness="2"
                            CornerRadius="10" IsHitTestVisible="True">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Image Width="52" Height="52" HorizontalAlignment="Center" Source="{Binding Source='🔒', Converter={StaticResource EmojiToImageSource}}"/>
                            <TextBlock Text="Premium feature" FontSize="22"
                                       FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                            <TextBlock Text="Support to unlock the Graded Intake." FontSize="14"
                                       Foreground="#CCCCCC" HorizontalAlignment="Center" Margin="0,4,0,12"/>
                            <Button Click="BtnGI_GateUnlock_Click" Padding="20,8" Background="#FF69B4"
                                    Foreground="White" FontWeight="Bold" Cursor="Hand" BorderThickness="0">
                                <helpers:EmojiTextBlock Text="🔓 Unlock with Patreon"/>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ═══ POP QUIZ ZONE (not premium - unchanged from the Lab card) ═══ -->
                <Border Background="{DynamicResource SurfaceBgBrush}" BorderBrush="{DynamicResource GlassBorderBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="20,18" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="{loc:Str label_pop_quiz}" Foreground="White" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,2"/>
                        <TextBlock Text="{loc:Str label_reinforcement_questions_pop_up_during_session}"
                                   Foreground="{DynamicResource TextMutedBrush}" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,12"/>

                        <CheckBox x:Name="ChkPopQuizEnabled" x:FieldModifier="internal" Content="{loc:Str setting_enable_pop_up_questions}"
                                  Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,0,0,10"
                                  Checked="ChkPopQuizEnabled_Changed" Unchecked="ChkPopQuizEnabled_Changed"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="{loc:Str label_frequency}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Slider x:Name="SliderPopQuizFrequency" x:FieldModifier="internal" Minimum="1" Maximum="100" Width="160"
                                    VerticalAlignment="Center"
                                    ValueChanged="SliderPopQuizFrequency_ValueChanged"/>
                            <TextBlock x:Name="TxtPopQuizFrequency" x:FieldModifier="internal" Foreground="#B0B0C8" FontSize="12"
                                       VerticalAlignment="Center" Margin="8,0,0,0" Text="{loc:Str label_2_session_hr}"/>
                        </StackPanel>

                        <Button x:Name="BtnTestPopQuiz" Content="{loc:Str btn_test}" Cursor="Hand"
                                Background="{DynamicResource SecondaryBrush}" Foreground="White" FontWeight="Bold" FontSize="12"
                                BorderThickness="0" Padding="12,8" HorizontalAlignment="Left"
                                Click="BtnTestPopQuiz_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </Border>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
