                                <Slider x:Name="SliderSize" x:FieldModifier="internal" Minimum="50" Maximum="250" Value="100" Margin="0,1" ValueChanged="SliderSize_Changed"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" ToolTip="{loc:Str tooltip_transparency_of_flash_images_lower_more_see_t}">
                                <Grid><TextBlock Style="{StaticResource SettingLabel}" Text="{loc:Str setting_opacity}" FontSize="11"/><TextBlock x:Name="TxtOpacity" x:FieldModifier="internal" Style="{StaticResource ValueLabel}" Text="100%" HorizontalAlignment="Right"/></Grid>
                                <Slider x:Name="SliderOpacity" x:FieldModifier="internal" Minimum="10" Maximum="100" Value="100" Margin="0,1" ValueChanged="SliderOpacity_Changed"/>
