<UserControl x:Class="ConditioningControlPanel.Views.Tabs.SettingsTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:features="clr-namespace:ConditioningControlPanel.Features"
             xmlns:fx="clr-namespace:ConditioningControlPanel.Controls"
             xmlns:helpers="clr-namespace:ConditioningControlPanel.Helpers"
             xmlns:loc="clr-namespace:ConditioningControlPanel.Localization"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
        <Grid>
        <Grid.ColumnDefinitions>
            <!-- #860: 84 of rail + 8 reserved for the rail's scrollbar. The chips used to be
                 laid out against the full 84 and then squeezed the moment the ScrollViewer
                 decided it needed a bar (short windows, or the Programs "Today" card taking a
                 bite out of row 1), cropping the chip art and wrapping the captions. The gutter
                 is reserved here and the chip stack is pinned to its old width, so a scrollbar
                 costs the chips nothing.
                 8, not the 17 of an OS scrollbar: Resources/Theme/MainWindow.xaml restyles
                 every ScrollBar and sets Width=8 on the vertical one, so 17 over-reserved the
                 gutter by 9 and pushed the whole settings grid right.
                 Keep in sync with PremiumRailContent: 92 - 5 rail margin - 2 border
                 - 8 scrollbar - 8 stack margin = 69. -->
            <ColumnDefinition Width="92"/>
            <ColumnDefinition Width="640"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Training Programs "Today" card -->
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============================================================ -->
        <!-- TRAINING PROGRAMS - "TODAY" CARD (row 0, full width).         -->
        <!-- Collapsed entirely unless a program is running; painted from  -->
        <!-- MainWindow.ProgramsTab.cs (RefreshProgramTodayCard). Clicking -->
        <!-- it opens the Programs tab.                                    -->
        <!-- ============================================================ -->
        <Button x:Name="ProgramTodayCard" x:FieldModifier="internal"
                Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                Margin="5,5,5,0" Visibility="Collapsed" Cursor="Hand"
                HorizontalContentAlignment="Stretch"
                BorderBrush="{DynamicResource PinkBrush}"
                Loaded="ProgramTodayCard_Loaded" Click="ProgramTodayCard_Click">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Background" Value="{DynamicResource ElevatedSurfaceBrush}"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <!-- Padding lives on the content Grid below, NOT here: the banner art and
                                 FX layers are part of the content and have to reach the card's edges.
                                 Moving it costs nothing - 14,11 of Padding and 14,11 of Margin arrange
                                 to the same 58.92 box - and it keeps the whole card in one file. -->
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="cardBorder" CornerRadius="10"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}">
                                    <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="cardBorder" Property="Background"
                                                Value="{DynamicResource SurfaceBgBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Button.Style>
            <Grid>
                <!-- ============================================================ -->
                <!-- BANNER DECORATION (art + FX). Painted and animated entirely   -->
                <!-- from MainWindow.ProgramBanner.cs; Collapsed until             -->
                <!-- ApplyProgramBannerArt() runs, so with no wiring and no PNGs   -->
                <!-- the card renders exactly as it did before this layer existed. -->
                <!--                                                                -->
                <!-- Every child is empty here on purpose. Brushes are built from   -->
                <!-- the PROGRAM's accent, which is only known at refresh time, and -->
                <!-- a XAML placeholder brush would flash the wrong colour for one  -->
                <!-- frame on a mod switch.                                         -->
                <!--                                                                -->
                <!-- The host takes a rounded Clip (set in code from ActualWidth):  -->
                <!-- these layers are wider than the card and would otherwise paint -->
                <!-- into the four corner squares outside the border's radius.      -->
                <!-- IsHitTestVisible=False throughout - the whole card is a Button -->
                <!-- and decoration must never swallow the click.                   -->
                <!-- ============================================================ -->
                <Grid x:Name="ProgramTodayDecor" x:FieldModifier="internal"
                      Visibility="Collapsed" IsHitTestVisible="False">
                    <!-- Themed program art. Fill is an ImageBrush; null art leaves it
                         Collapsed and the card falls back to its flat look. -->
                    <!-- The negative margin is the hover parallax's headroom: the art overhangs the
                         card by 14 on each side, so nudging it never exposes a bare edge. The host's
                         Clip hides the overhang. -->
                    <Rectangle x:Name="ProgramTodayArt" x:FieldModifier="internal" Visibility="Collapsed"
                               Margin="-14,0,-14,0">
                        <Rectangle.RenderTransform>
                            <TranslateTransform x:Name="ProgramTodayArtSlide" x:FieldModifier="internal"/>
                        </Rectangle.RenderTransform>
                    </Rectangle>
                    <!-- Drifting accent fog. Wider than the card and slid back and forth. -->
                    <Rectangle x:Name="ProgramTodayFog" x:FieldModifier="internal"
                               HorizontalAlignment="Left" Visibility="Collapsed">
                        <Rectangle.RenderTransform>
                            <TranslateTransform x:Name="ProgramTodayFogSlide" x:FieldModifier="internal"/>
                        </Rectangle.RenderTransform>
                    </Rectangle>
                    <!-- Periodic sheen sweep. Same idiom as the Programs tab session row. -->
                    <Rectangle x:Name="ProgramTodaySheen" x:FieldModifier="internal"
                               Width="150" HorizontalAlignment="Left" Visibility="Collapsed">
                        <Rectangle.RenderTransform>
                            <TranslateTransform x:Name="ProgramTodaySheenSlide" x:FieldModifier="internal"/>
                        </Rectangle.RenderTransform>
                    </Rectangle>
                    <!-- Sparkles are added here in code: their positions are fractions of
                         the card's width, which XAML cannot express on a Canvas. -->
                    <Canvas x:Name="ProgramTodaySparkles" x:FieldModifier="internal"/>
                </Grid>

                <Grid Margin="14,11">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="ProgramTodayAccent" x:FieldModifier="internal" Grid.Column="0"
                            Width="4" CornerRadius="2" Margin="0,1,12,1"
                            Background="{DynamicResource PinkBrush}"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtProgramTodayTitle" x:FieldModifier="internal"
                                   Foreground="{DynamicResource PinkBrush}"
                                   FontSize="11" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="TxtProgramTodayLine" x:FieldModifier="internal"
                                   Foreground="{DynamicResource TextLightBrush}"
                                   FontSize="13" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="›" VerticalAlignment="Center" Margin="12,0,2,0"
                               Foreground="{DynamicResource TextMutedBrush}" FontSize="18"/>
                </Grid>
            </Grid>
        </Button>

        <!-- ============================================================ -->
        <!-- PREMIUM QUICK-TOGGLE RAIL (col 0). Quick on/off for gated     -->
        <!-- features. Greyed with a lock (doubles as an ad) when the      -->
        <!-- user is not a logged-in patron.                               -->
        <!-- ============================================================ -->
        <!-- VerticalAlignment=Top so the card hugs the chips instead of leaving a
             dead pocket at the foot: the rail's content is now short enough to fit
             the row whether or not the Programs "Today" card is on screen above it. -->
        <Border x:Name="PremiumRail" x:FieldModifier="internal" Grid.Column="0" Grid.Row="1" Margin="5,5,0,5"
                VerticalAlignment="Top"
                Background="{DynamicResource ElevatedSurfaceBrush}" BorderBrush="{DynamicResource GlassBorderBrush}"
                BorderThickness="1" CornerRadius="12">
            <Border.Resources>
                <!-- ============================================================ -->
                <!-- CHIP ART. The feature image is the chip's own Background, not  -->
                <!-- a child Image: a Border paints its Background inside the       -->
                <!-- CornerRadius for free (a child Image would need ClipToBounds), -->
                <!-- and only an ImageBrush can frame the source.                   -->
                <!--                                                                -->
                <!-- Every Viewbox below is deliberate. These files were drawn as    -->
                <!-- wide marquee art with the feature NAME burned into the pixels,  -->
                <!-- so shown whole they put a second, illegible word behind our     -->
                <!-- caption. The Viewbox frames the illustration and leaves the     -->
                <!-- wordmark outside the chip. Each rect is cut to roughly the      -->
                <!-- chip's own aspect (~1.7:1 for a chip, ~1.1:1 for the two taller -->
                <!-- launcher cards) so UniformToFill has almost nothing left to     -->
                <!-- crop and cannot decapitate the subject.                         -->
                <!--                                                                -->
                <!-- DecodePixelWidth caps the decode: these are 0.5 MB neon PNGs    -->
                <!-- and the rail only ever shows them ~170px wide (design canvas is -->
                <!-- 1489 wide, the root Viewbox scales up to ~2.6x on a 4K window). -->
                <!-- It is set against the FULL source, so the tighter the Viewbox   -->
                <!-- crop the larger it has to be.                                   -->
                <!-- ============================================================ -->
                <ImageBrush x:Key="ArtTakeover" Stretch="UniformToFill" Viewbox="0,0.06,1,0.54">
                    <ImageBrush.ImageSource>
                        <BitmapImage UriSource="pack://application:,,,/Resources/features/takeover.png" DecodePixelWidth="384"/>
                    </ImageBrush.ImageSource>
                </ImageBrush>
                <ImageBrush x:Key="ArtAwareness" Stretch="UniformToFill" Viewbox="0.02,0.05,0.40,0.43">
                    <ImageBrush.ImageSource>
                        <BitmapImage UriSource="pack://application:,,,/Resources/features/awareness.png" DecodePixelWidth="512"/>
                    </ImageBrush.ImageSource>
                </ImageBrush>
                <ImageBrush x:Key="ArtHaptics" Stretch="UniformToFill" Viewbox="0,0.07,1,0.61">
                    <ImageBrush.ImageSource>
                        <BitmapImage UriSource="pack://application:,,,/Resources/features/vibe.png" DecodePixelWidth="384"/>
                    </ImageBrush.ImageSource>
                </ImageBrush>
                <ImageBrush x:Key="ArtIntake" Stretch="UniformToFill" Viewbox="0.22,0.04,0.62,0.66">
                    <ImageBrush.ImageSource>
                        <BitmapImage UriSource="pack://application:,,,/Resources/features/lab_quiz_hero.png" DecodePixelWidth="512"/>
                    </ImageBrush.ImageSource>
                </ImageBrush>
                <ImageBrush x:Key="ArtRemote" Stretch="UniformToFill" Viewbox="0.60,0.03,0.35,0.62">
                    <ImageBrush.ImageSource>
                        <BitmapImage UriSource="pack://application:,,,/Resources/features/remote_control.png" DecodePixelWidth="768"/>
                    </ImageBrush.ImageSource>
                </ImageBrush>
                <ImageBrush x:Key="ArtBlink" Stretch="UniformToFill" Viewbox="0.05,0.06,0.44,0.72">
                    <ImageBrush.ImageSource>
                        <BitmapImage UriSource="pack://application:,,,/Resources/features/blink_trainer.png" DecodePixelWidth="512"/>
                    </ImageBrush.ImageSource>
                </ImageBrush>
                <!-- fyp.png is 1376x768 with NO wordmark burned in, so the crop is chosen
                     for subject rather than to dodge text: the phone plus the first stretch
                     of the feed ribbon spilling out of it. The rect is ~1.64:1, the chip's
                     own aspect, so UniformToFill has nothing left to shave. -->
                <ImageBrush x:Key="ArtFyp" Stretch="UniformToFill" Viewbox="0.20,0.33,0.50,0.545">
                    <ImageBrush.ImageSource>
                        <BitmapImage UriSource="pack://application:,,,/Resources/features/fyp.png" DecodePixelWidth="512"/>
                    </ImageBrush.ImageSource>
                </ImageBrush>
                <!-- lockdown_icon is a 4.45:1 banner: padlock left, "LOCKDOWN MODE"
                     right, empty smoke between. Only the padlock is framed, which is
                     a quarter of the width - hence the much larger decode. -->
                <ImageBrush x:Key="ArtLockdown" Stretch="UniformToFill" Viewbox="0.08,0,0.25,1">
                    <ImageBrush.ImageSource>
                        <BitmapImage UriSource="pack://application:,,,/Resources/lockdown_icon.png" DecodePixelWidth="1024"/>
                    </ImageBrush.ImageSource>
                </ImageBrush>
                <!-- She's Listening has no feature art (there is no mic PNG in
                     Resources/features), so this chip carries a gradient instead and
                     keeps the emoji glyph centred over it. -->
                <LinearGradientBrush x:Key="ArtVoice" StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FF3A1B4D" Offset="0"/>
                    <GradientStop Color="#FF6E2856" Offset="1"/>
                </LinearGradientBrush>

                <!-- Legibility scrim. The art is bright neon on near-black, so a text
                     shadow alone would not survive it; the caption sits in the dark
                     band at the foot of the chip instead. -->
                <LinearGradientBrush x:Key="ChipScrimBrush" StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#00000000" Offset="0.28"/>
                    <GradientStop Color="#73000000" Offset="0.62"/>
                    <GradientStop Color="#DE000000" Offset="1"/>
                </LinearGradientBrush>
                <!-- The Lockdown / Blink cards carry live controls over their whole
                     face, not just a caption at the foot, so they darken throughout. -->
                <LinearGradientBrush x:Key="CardScrimBrush" StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#59000000" Offset="0"/>
                    <GradientStop Color="#B8000000" Offset="0.42"/>
                    <GradientStop Color="#E6000000" Offset="1"/>
                </LinearGradientBrush>

                <Style x:Key="ChipCaption" TargetType="TextBlock">
                    <Setter Property="FontSize" Value="9"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="TextAlignment" Value="Center"/>
                    <Setter Property="TextWrapping" Value="Wrap"/>
                    <Setter Property="VerticalAlignment" Value="Bottom"/>
                    <Setter Property="Margin" Value="2,0,2,3"/>
                </Style>
                <!-- Status dot moved to the top-right corner: the caption now owns the
                     bottom of the chip. Fill is repainted by RefreshPremiumRail. -->
                <Style x:Key="ChipDot" TargetType="Ellipse">
                    <Setter Property="Width" Value="8"/>
                    <Setter Property="Height" Value="8"/>
                    <Setter Property="HorizontalAlignment" Value="Right"/>
                    <Setter Property="VerticalAlignment" Value="Top"/>
                    <Setter Property="Margin" Value="0,3,3,0"/>
                    <Setter Property="Fill" Value="#555555"/>
                    <Setter Property="Stroke" Value="#1A1A2E"/>
                    <Setter Property="StrokeThickness" Value="1"/>
                </Style>

                <Style x:Key="PremiumChipStyle" TargetType="Button">
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Margin" Value="0,0,0,4"/>
                    <Setter Property="Height" Value="42"/>
                    <Setter Property="Background" Value="{DynamicResource AccentTintedBgBrush}"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="cb" Background="{TemplateBinding Background}"
                                        BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1"
                                        CornerRadius="9" RenderOptions.BitmapScalingMode="HighQuality">
                                    <!-- CornerRadius 8 = the chip's 9 minus the 1px border, so the
                                         overlays follow the inner curve instead of squaring it off. -->
                                    <Grid>
                                        <Border CornerRadius="8" IsHitTestVisible="False"
                                                Background="{StaticResource ChipScrimBrush}"/>
                                        <!-- Hover/press wash. It is a separate layer rather than a
                                             Background swap because the Background is now the art. -->
                                        <Border x:Name="tint" CornerRadius="8" Opacity="0" IsHitTestVisible="False"
                                                Background="{DynamicResource TransparentPinkBrush}"/>
                                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="cb" Property="BorderBrush" Value="{DynamicResource PinkBrush}"/>
                                        <Setter TargetName="tint" Property="Opacity" Value="1"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="cb" Property="BorderBrush" Value="{DynamicResource PinkBrush}"/>
                                        <Setter TargetName="tint" Property="Opacity" Value="1"/>
                                        <Setter TargetName="cb" Property="Opacity" Value="0.82"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
                <Style x:Key="RailMiniBtn" TargetType="Button">
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="mb" Background="{DynamicResource AccentTintedBgBrush}"
                                        BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1"
                                        CornerRadius="5" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="mb" Property="Background" Value="{DynamicResource TransparentPinkBrush}"/>
                                        <Setter TargetName="mb" Property="BorderBrush" Value="{DynamicResource PinkBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <!-- ============================================================ -->
                <!-- LOCKBANDS - the rail is the app's standing ad, so a card the  -->
                <!-- account cannot use stays exactly where it is, art and all,    -->
                <!-- and wears a band instead of vanishing or greying out. One     -->
                <!-- band per card, shown from a TierGate verdict (RefreshRail-    -->
                <!-- Lockbands, MainWindow.PremiumRail.cs). This replaced the one  -->
                <!-- blanket overlay + IsEnabled=false that used to answer "no"    -->
                <!-- for eight different features with a single padlock.           -->
                <!--                                                                -->
                <!-- IsHitTestVisible=False is load-bearing. The card underneath    -->
                <!-- must stay live so its hover lift + art nudge still run (a dead -->
                <!-- ad is a worse ad) and so the click reaches the normal handler, -->
                <!-- which is where TierGate refuses and offers the tiers. A band   -->
                <!-- that swallowed the click would be the dead end the old blanket -->
                <!-- overlay was - cursor:hand, and nothing behind it.              -->
                <!--                                                                -->
                <!-- Tier language, deliberately CONSTANT across mods: gold padlock -->
                <!-- = tier 1, violet flask = tier 2. This is a price tag, not      -->
                <!-- decor, so it does not take its colour from the mod chain the   -->
                <!-- way the rest of the chrome does. A tier-2 card swaps two       -->
                <!-- attributes - BorderBrush/Foreground to RailLockT2Brush and the -->
                <!-- glyph to 🧪 - and calls TierGate.RequiresLab. Local to the     -->
                <!-- rail until the Play door adopts the same band, then they       -->
                <!-- belong in the theme.                                           -->
                <!-- ============================================================ -->
                <SolidColorBrush x:Key="RailLockT1Brush" Color="#FFF0C24B"/>
                <SolidColorBrush x:Key="RailLockT2Brush" Color="#FFB47BFF"/>
                <!-- A scrim, not a curtain: ~66% so the feature art still reads
                     through it. Seeing what you are missing is the entire job. -->
                <SolidColorBrush x:Key="RailLockScrimBrush" Color="#A8120A1E"/>
                <Style x:Key="RailLockBand" TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <!-- 8 = the chip's 9 minus its 1px border, the same inner
                         curve the scrim and hover tint follow. -->
                    <Setter Property="CornerRadius" Value="8"/>
                    <Setter Property="Background" Value="{StaticResource RailLockScrimBrush}"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="BorderBrush" Value="{StaticResource RailLockT1Brush}"/>
                    <Setter Property="IsHitTestVisible" Value="False"/>
                </Style>
                <!-- TargetType stays TextBlock so it applies to the EmojiTextBlock
                     (a TextBlock subclass) that renders the padlock in colour. -->
                <Style x:Key="RailLockGlyph" TargetType="TextBlock">
                    <Setter Property="FontSize" Value="11"/>
                    <Setter Property="HorizontalAlignment" Value="Center"/>
                    <Setter Property="VerticalAlignment" Value="Top"/>
                    <Setter Property="Margin" Value="0,3,0,0"/>
                </Style>
                <!-- One short line, centred in the gap between the glyph and the
                     caption band at the foot of the chip - 42px of chip and 69px
                     of rail leave room for a price tag, not a pitch. The pitch is
                     the toast the click raises, which carries the "See tiers"
                     button into the App Info popup. -->
                <Style x:Key="RailLockTeaser" TargetType="TextBlock">
                    <Setter Property="FontSize" Value="7.5"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Foreground" Value="{StaticResource RailLockT1Brush}"/>
                    <Setter Property="TextAlignment" Value="Center"/>
                    <Setter Property="TextWrapping" Value="NoWrap"/>
                    <!-- A longer translation than "Patron only" has to end in an ellipsis, not
                         spill past the chip: the TextBlock stretches to the band, so trimming
                         keeps it inside. Nothing clips it otherwise - a Border does not clip its
                         child without ClipToBounds, and the toast carries the full sentence. -->
                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="Margin" Value="1,5,1,0"/>
                </Style>
            </Border.Resources>
            <Grid>
                <!-- The rail is a plain stack in a fixed-height row, so anything past the
                     fold used to be cut off by WPF's layout clip with no scrollbar and no
                     other tell - that is how the Programs "Today" card (row 0, Auto) made
                     the last chip vanish outright. The ScrollViewer is the safety net: if
                     the rail ever outgrows the row again it scrolls instead of silently
                     eating a feature. It shows no chrome while everything fits. -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <!-- #860: fixed width + Center, so a scrollbar appearing shifts the chips
                     but never narrows them. 69 = the width the chips had before the column
                     reserved its scrollbar gutter (84 rail - 5 rail margin - 2 border
                     - 8 stack margin), and it is exactly what the 92px column leaves once
                     the theme's 8px scrollbar takes its share. If the rail column width
                     changes, change this too. -->
                <!-- MouseRightButtonUp on the STACK, not on each chip: right-button events bubble,
                     so one router (MainWindow.PremiumRail_RightClick) covers every chip and cannot
                     be forgotten when a chip is added. Left = open the feature's page, right =
                     turn it on with its existing settings. -->
                <StackPanel x:Name="PremiumRailContent" x:FieldModifier="internal" Margin="4,6,4,6"
                            MouseRightButtonUp="PremiumRailContent_RightClick"
                            Width="69" HorizontalAlignment="Center">
                    <TextBlock Text="PREMIUM" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource SecondaryBrush}"
                               TextAlignment="Center" Margin="0,0,0,6"/>
                    <Button x:Name="ChipTakeover" x:FieldModifier="internal" Style="{StaticResource PremiumChipStyle}"
                            Background="{StaticResource ArtTakeover}"
                            Click="ChipTakeover_Click" ToolTip="Takeover — the companion triggers effects on her own · left-click opens it, right-click turns it on">
                        <Grid>
                            <Ellipse x:Name="DotTakeover" x:FieldModifier="internal" Style="{StaticResource ChipDot}"/>
                            <TextBlock Text="Takeover" Style="{StaticResource ChipCaption}"/>
                            <!-- Last child = on top of the dot and the caption. -->
                            <Border x:Name="LockBandTakeover" x:FieldModifier="internal" Style="{StaticResource RailLockBand}">
                                <Grid>
                                    <helpers:EmojiTextBlock Text="🔒" Style="{StaticResource RailLockGlyph}"/>
                                    <TextBlock Text="{loc:Str hm3_rail_lock_t1}" Style="{StaticResource RailLockTeaser}"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Button>
                    <Button x:Name="ChipAwareness" x:FieldModifier="internal" Style="{StaticResource PremiumChipStyle}"
                            Background="{StaticResource ArtAwareness}"
                            Click="ChipAwareness_Click" ToolTip="Awareness — reacts to what's on your screen · left-click opens it, right-click turns it on">
                        <Grid>
                            <Ellipse x:Name="DotAwareness" x:FieldModifier="internal" Style="{StaticResource ChipDot}"/>
                            <TextBlock Text="Awareness" Style="{StaticResource ChipCaption}"/>
                            <Border x:Name="LockBandAwareness" x:FieldModifier="internal" Style="{StaticResource RailLockBand}">
                                <Grid>
                                    <helpers:EmojiTextBlock Text="🔒" Style="{StaticResource RailLockGlyph}"/>
                                    <TextBlock Text="{loc:Str hm3_rail_lock_t1}" Style="{StaticResource RailLockTeaser}"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Button>
                    <Button x:Name="ChipHaptics" x:FieldModifier="internal" Style="{StaticResource PremiumChipStyle}"
                            Background="{StaticResource ArtHaptics}"
                            Click="ChipHaptics_Click" ToolTip="Haptics — connect a toy · left-click opens it, right-click turns it on">
                        <Grid>
                            <Ellipse x:Name="DotHaptics" x:FieldModifier="internal" Style="{StaticResource ChipDot}"/>
                            <TextBlock Text="Haptics" Style="{StaticResource ChipCaption}"/>
                            <Border x:Name="LockBandHaptics" x:FieldModifier="internal" Style="{StaticResource RailLockBand}">
                                <Grid>
                                    <helpers:EmojiTextBlock Text="🔒" Style="{StaticResource RailLockGlyph}"/>
                                    <TextBlock Text="{loc:Str hm3_rail_lock_t1}" Style="{StaticResource RailLockTeaser}"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Button>
                    <!-- Graded Intake — a navigation shortcut, not a toggle: the intake runs in its
                         own window and is started from its page, so this chip just opens that page
                         (hence no state dot). -->
                    <Button x:Name="ChipGradedIntake" x:FieldModifier="internal" Style="{StaticResource PremiumChipStyle}"
                            Background="{StaticResource ArtIntake}"
                            Click="ChipGradedIntake_Click" ToolTip="Graded Intake — open the intake page · left- or right-click opens it">
                        <Grid>
                            <TextBlock Text="Intake" Style="{StaticResource ChipCaption}"/>
                            <!-- The one band that is not a tier question: a FREE account holding
                                 this week's pass may take the intake, and the pass is exactly what
                                 the logo tile's flip ceremony hands out. So this band follows
                                 IntakePassService.CanStartIntake - the same truth the intake
                                 page's four-state gate reads - and says "pass", not "patron". -->
                            <Border x:Name="LockBandIntake" x:FieldModifier="internal" Style="{StaticResource RailLockBand}">
                                <Grid>
                                    <helpers:EmojiTextBlock Text="🔒" Style="{StaticResource RailLockGlyph}"/>
                                    <TextBlock Text="{loc:Str hm3_rail_lock_pass}" Style="{StaticResource RailLockTeaser}"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Button>
                    <Button x:Name="ChipVoice" x:FieldModifier="internal" Style="{StaticResource PremiumChipStyle}"
                            Background="{StaticResource ArtVoice}"
                            Click="ChipVoice_Click" ToolTip="She's Listening — voice control (&quot;Hey Bambi&quot;) and the mic · left-click opens it, right-click turns it on">
                        <Grid>
                            <!-- No art file for this one - the glyph stays centred, lifted clear
                                 of the caption band at the foot of the chip. -->
                            <Image Source="{Binding Source='🎙️', Converter={StaticResource EmojiToImageSource}}"
                                   Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,8"/>
                            <Ellipse x:Name="DotVoice" x:FieldModifier="internal" Style="{StaticResource ChipDot}"/>
                            <TextBlock Text="Voice" Style="{StaticResource ChipCaption}"/>
                            <Border x:Name="LockBandVoice" x:FieldModifier="internal" Style="{StaticResource RailLockBand}">
                                <Grid>
                                    <helpers:EmojiTextBlock Text="🔒" Style="{StaticResource RailLockGlyph}"/>
                                    <TextBlock Text="{loc:Str hm3_rail_lock_t1}" Style="{StaticResource RailLockTeaser}"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Button>
                    <!-- For You — a navigation shortcut like Graded Intake, not a toggle: the feed
                         runs in its own WebView2 window. ShowTab("fyp") is intercepted by
                         MainWindow.TabNavigation and hands off to OpenFypFeed, which owns the
                         premium gate — the chip itself never blocks, exactly like its siblings.
                         No state dot for the same reason Intake has none. -->
                    <Button x:Name="ChipFyp" x:FieldModifier="internal" Style="{StaticResource PremiumChipStyle}"
                            Background="{StaticResource ArtFyp}"
                            Click="ChipFyp_Click" ToolTip="For You — an endless feed cut from your own library · left- or right-click opens it">
                        <Grid>
                            <TextBlock Text="{loc:Str tab_fyp}" Style="{StaticResource ChipCaption}"/>
                            <!-- Band on, click still through: OpenFypFeed owns this gate and
                                 already opens the App Info popup for a locked account, which is
                                 the same destination TierGate's toast offers. Two refusals for
                                 one click would be worse than the band plus the one it has. -->
                            <Border x:Name="LockBandFyp" x:FieldModifier="internal" Style="{StaticResource RailLockBand}">
                                <Grid>
                                    <helpers:EmojiTextBlock Text="🔒" Style="{StaticResource RailLockGlyph}"/>
                                    <TextBlock Text="{loc:Str hm3_rail_lock_t1}" Style="{StaticResource RailLockTeaser}"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Button>
                    <!-- Lockdown — launcher with +/- duration and a live countdown. Same
                         full-bleed art as the chips, but the caption and controls sit over it
                         instead of below a centred icon, which is what the icon block used to
                         cost this card in height. -->
                    <Border x:Name="CardLockdown" x:FieldModifier="internal"
                            Margin="0,0,0,4" Background="{StaticResource ArtLockdown}"
                            BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="9"
                            RenderOptions.BitmapScalingMode="HighQuality"
                            ToolTip="Lockdown — locks you in for the set time (panic key disabled)">
                        <Grid>
                            <Border CornerRadius="8" IsHitTestVisible="False" Background="{StaticResource CardScrimBrush}"/>
                            <StackPanel Margin="3,2,3,4">
                                <TextBlock Text="Lockdown" Style="{StaticResource ChipCaption}" VerticalAlignment="Top" Margin="0,0,0,0"/>
                                <Grid x:Name="LockdownSetRow" x:FieldModifier="internal" Margin="0,3,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" x:Name="BtnLockdownMinus" x:FieldModifier="internal" Style="{StaticResource RailMiniBtn}"
                                            Content="−" FontSize="13" Width="18" Height="18" Click="BtnLockdownMinus_Click"/>
                                    <TextBlock Grid.Column="1" x:Name="TxtLockdownMins" x:FieldModifier="internal" Text="15m" FontSize="10"
                                               Foreground="White" VerticalAlignment="Center" TextAlignment="Center"/>
                                    <Button Grid.Column="2" x:Name="BtnLockdownPlus" x:FieldModifier="internal" Style="{StaticResource RailMiniBtn}"
                                            Content="＋" FontSize="11" Width="18" Height="18" Click="BtnLockdownPlus_Click"/>
                                </Grid>
                                <Button x:Name="BtnLockdownGo" x:FieldModifier="internal" Style="{StaticResource RailMiniBtn}"
                                        Content="Lock in" FontSize="9" Height="16" Margin="0,3,0,0" Click="BtnLockdownGo_Click"/>
                                <TextBlock x:Name="TxtLockdownCountdown" x:FieldModifier="internal" Visibility="Collapsed"
                                           FontSize="12" FontWeight="Bold" Foreground="#FF6B6B" TextAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                            <!-- Outside the StackPanel so the band never fights SetLockdownActiveUi,
                                 which owns LockdownSetRow / BtnLockdownGo / TxtLockdownCountdown
                                 visibility while a lockdown runs. Two owners of one Visibility is
                                 how a countdown goes missing. -->
                            <Border x:Name="LockBandLockdown" x:FieldModifier="internal" Style="{StaticResource RailLockBand}">
                                <Grid>
                                    <helpers:EmojiTextBlock Text="🔒" Style="{StaticResource RailLockGlyph}"/>
                                    <TextBlock Text="{loc:Str hm3_rail_lock_t1}" Style="{StaticResource RailLockTeaser}"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                    <!-- Blink Trainer — launcher with +/- duration and countdown. Same
                         full-bleed treatment as Lockdown. -->
                    <Border x:Name="CardBlink" x:FieldModifier="internal"
                            Margin="0,0,0,4" Background="{StaticResource ArtBlink}"
                            BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="9"
                            RenderOptions.BitmapScalingMode="HighQuality"
                            ToolTip="Blink Trainer — webcam blink-gated visuals">
                        <Grid>
                            <Border CornerRadius="8" IsHitTestVisible="False" Background="{StaticResource CardScrimBrush}"/>
                            <StackPanel Margin="3,2,3,4">
                                <TextBlock Text="Blink" Style="{StaticResource ChipCaption}" VerticalAlignment="Top" Margin="0,0,0,0"/>
                                <Grid x:Name="BlinkSetRow" x:FieldModifier="internal" Margin="0,3,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" x:Name="BtnBlinkMinus" x:FieldModifier="internal" Style="{StaticResource RailMiniBtn}"
                                            Content="−" FontSize="13" Width="18" Height="18" Click="BtnBlinkMinus_Click"/>
                                    <TextBlock Grid.Column="1" x:Name="TxtBlinkMins" x:FieldModifier="internal" Text="10m" FontSize="10"
                                               Foreground="White" VerticalAlignment="Center" TextAlignment="Center"/>
                                    <Button Grid.Column="2" x:Name="BtnBlinkPlus" x:FieldModifier="internal" Style="{StaticResource RailMiniBtn}"
                                            Content="＋" FontSize="11" Width="18" Height="18" Click="BtnBlinkPlus_Click"/>
                                </Grid>
                                <Button x:Name="BtnBlinkGo" x:FieldModifier="internal" Style="{StaticResource RailMiniBtn}"
                                        Content="Start" FontSize="9" Height="16" Margin="0,3,0,0" Click="BtnBlinkGo_Click"/>
                                <TextBlock x:Name="TxtBlinkCountdown" x:FieldModifier="internal" Visibility="Collapsed"
                                           FontSize="12" FontWeight="Bold" Foreground="#7FD8FF" TextAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                            <!-- Sibling of the StackPanel for the same reason as Lockdown's:
                                 SetBlinkActiveUi owns BlinkSetRow / BtnBlinkGo / TxtBlinkCountdown. -->
                            <Border x:Name="LockBandBlink" x:FieldModifier="internal" Style="{StaticResource RailLockBand}">
                                <Grid>
                                    <helpers:EmojiTextBlock Text="🔒" Style="{StaticResource RailLockGlyph}"/>
                                    <TextBlock Text="{loc:Str hm3_rail_lock_t1}" Style="{StaticResource RailLockTeaser}"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                    <!-- Remote — opens a flyout to compose + start a remote session -->
                    <Button x:Name="ChipRemote" x:FieldModifier="internal" Style="{StaticResource PremiumChipStyle}"
                            Background="{StaticResource ArtRemote}"
                            Click="ChipRemote_Click" ToolTip="Remote Control — let someone drive your session">
                        <Grid>
                            <Ellipse x:Name="DotRemote" x:FieldModifier="internal" Style="{StaticResource ChipDot}"/>
                            <TextBlock Text="Remote" Style="{StaticResource ChipCaption}"/>
                            <Border x:Name="LockBandRemote" x:FieldModifier="internal" Style="{StaticResource RailLockBand}">
                                <Grid>
                                    <helpers:EmojiTextBlock Text="🔒" Style="{StaticResource RailLockGlyph}"/>
                                    <TextBlock Text="{loc:Str hm3_rail_lock_t1}" Style="{StaticResource RailLockTeaser}"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Button>
                    <!-- VerticalOffset lifts the flyout up: ChipRemote is the last rail item and
                         sits low on screen, so a top-aligned flyout otherwise clips the bottom
                         Start button against the taskbar / screen edge. The Start button is
                         docked to the bottom (always visible) and the form above it scrolls if
                         the popup ever runs out of vertical room. -->
                    <Popup x:Name="RemoteFlyout" x:FieldModifier="internal" PlacementTarget="{Binding ElementName=ChipRemote}"
                           Placement="Right" StaysOpen="False" AllowsTransparency="True" HorizontalOffset="4" VerticalOffset="-150">
                        <Border Background="{DynamicResource ElevatedSurfaceBrush}" BorderBrush="{DynamicResource PinkBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="10" Width="226">
                            <DockPanel>
                                <Button x:Name="BtnRemoteStart" x:FieldModifier="internal" DockPanel.Dock="Bottom" Content="Start Remote"
                                        Click="BtnRemoteStart_Click" Style="{StaticResource PinkButton}" Margin="0,8,0,0"
                                        Background="{DynamicResource AccentGradientBrush}" Height="30" FontSize="12"/>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="420">
                                    <StackPanel>
                                        <TextBlock Text="Go available" FontWeight="Bold" Foreground="White" FontSize="13" Margin="0,0,0,6"/>
                                        <TextBlock Text="Difficulty" Foreground="{DynamicResource SecondaryBrush}" FontSize="10"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,8">
                                            <RadioButton x:Name="RemoteDiffEasy" x:FieldModifier="internal" GroupName="RemoteDiff" Content="Easy" Foreground="White" Margin="0,0,10,0"/>
                                            <RadioButton x:Name="RemoteDiffMed" x:FieldModifier="internal" GroupName="RemoteDiff" Content="Medium" IsChecked="True" Foreground="White" Margin="0,0,10,0"/>
                                            <RadioButton x:Name="RemoteDiffHard" x:FieldModifier="internal" GroupName="RemoteDiff" Content="Hard" Foreground="White"/>
                                        </StackPanel>
                                        <CheckBox x:Name="RemoteShareCheck" x:FieldModifier="internal" Content="Share in Available Subjects"
                                                  Foreground="White" FontSize="11" Margin="0,0,0,6"/>
                                        <TextBlock Text="Message" Foreground="{DynamicResource SecondaryBrush}" FontSize="10"/>
                                        <TextBox x:Name="RemoteMessageBox" x:FieldModifier="internal" MaxLength="80" Height="40"
                                                 TextWrapping="Wrap" AcceptsReturn="True" Margin="0,2,0,6"/>
                                        <TextBlock Text="Tags (up to 5)" Foreground="{DynamicResource SecondaryBrush}" FontSize="10"/>
                                        <WrapPanel x:Name="RemoteTagPanel" x:FieldModifier="internal" Margin="0,2,0,0">
                                            <ToggleButton Content="Bimbo" FontSize="10" Padding="5,1" Margin="0,0,3,3"/>
                                            <ToggleButton Content="Drone" FontSize="10" Padding="5,1" Margin="0,0,3,3"/>
                                            <ToggleButton Content="Trance" FontSize="10" Padding="5,1" Margin="0,0,3,3"/>
                                            <ToggleButton Content="Fem" FontSize="10" Padding="5,1" Margin="0,0,3,3"/>
                                            <ToggleButton Content="Submission" FontSize="10" Padding="5,1" Margin="0,0,3,3"/>
                                            <ToggleButton Content="Degrade" FontSize="10" Padding="5,1" Margin="0,0,3,3"/>
                                            <ToggleButton Content="Audio OK" FontSize="10" Padding="5,1" Margin="0,0,3,3"/>
                                            <ToggleButton Content="Soft" FontSize="10" Padding="5,1" Margin="0,0,3,3"/>
                                            <ToggleButton Content="Lockdown OK" FontSize="10" Padding="5,1" Margin="0,0,3,3"/>
                                            <ToggleButton Content="Chastity" FontSize="10" Padding="5,1" Margin="0,0,3,3"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Popup>
                </StackPanel>
                </ScrollViewer>
                <!-- RETIRED (Phase 3) - the old blanket. One padlock over the whole rail, with
                     PremiumRailContent.IsEnabled=false underneath it, answered "no" for eight
                     different features at once and had nowhere to click: Cursor=Hand and no
                     handler behind it. The per-card lockbands above replaced it - each names its
                     own bar, keeps its art, and routes the click into TierGate's upsell toast.
                     RefreshPremiumRail force-collapses this so no stale state can revive it; the
                     element stays only because live code still reads the name and Phase 8 owns
                     deleting dead dashboard chrome. Do not re-show it. -->
                <Border x:Name="PremiumRailLock" x:FieldModifier="internal" Visibility="Collapsed"
                        Background="#B31A1A2E" CornerRadius="12" Cursor="Hand"
                        ToolTip="Premium features — unlock with Patreon">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <helpers:EmojiTextBlock Text="🔒" FontSize="20" HorizontalAlignment="Center"/>
                        <TextBlock Text="Patron" FontSize="10" Foreground="White" TextAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ============================================================ -->
        <!-- VELVET MOSAIC DASHBOARD - 3x3 destination grid (col 1)        -->
        <!--                                                              -->
        <!-- WAS a 4x4 of twelve FX tiles around a 2x2 logo. Every one of -->
        <!-- those tiles left-click-navigated to a Studio rack module      -->
        <!-- (Phase 3), so the app's best real estate held twelve          -->
        <!-- shortcuts into a list the Studio door already shows in full,  -->
        <!-- while DtRH, Goon, For You, the intake, Deeper and the Loom    -->
        <!-- had no dashboard presence at all. Owner call, 2026-08-11:     -->
        <!-- 3x3, logo in the middle, eight slots, four free and four      -->
        <!-- paid, and the FX keep their one real home in the Studio rack. -->
        <!--                                                              -->
        <!-- The free/paid split is diagonal rather than blocked so the    -->
        <!-- wall does not read as a paywall with a free corner:           -->
        <!--   DtRH(T2)  Goon(free)  For You(T1)                           -->
        <!--   Intake(*)  [ LOGO ]   Remote(T1)                            -->
        <!--   Loom(free) Deeper(free) Just Drop(T1)                       -->
        <!-- (*) the intake is free once a week - IntakePassService owns    -->
        <!-- the four states, and the centre logo still flips to the PASS   -->
        <!-- face when one is waiting.                                     -->
        <!--                                                              -->
        <!-- Every tile NAVIGATES to the one existing entry for its         -->
        <!-- feature; none of them launches anything itself. That is the    -->
        <!-- same rule the Play door's cards follow (PlayTabView.xaml:1165) -->
        <!-- and it is what keeps there being exactly one Loom editor, one  -->
        <!-- FYP window and one Deeper hub no matter how many front doors   -->
        <!-- point at them.                                                 -->
        <!-- ============================================================ -->
        <Grid Grid.Column="1" Grid.Row="1" x:Name="VelvetFeatureGrid" x:FieldModifier="internal" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ============================================================ -->
            <!-- AMBIENT LAYER - the one looping FX on the whole Dashboard.    -->
            <!-- Declared FIRST so it is the bottom of the grid's z-order: the -->
            <!-- tiles paint their own opaque surfaces on top, so the fog and  -->
            <!-- dust read through the gutters and through the near-           -->
            <!-- transparent centre logo tile, never over a card face.         -->
            <!--                                                                -->
            <!-- It is inside the root 1489x901 Viewbox and therefore bitmap-   -->
            <!-- scaled. That is fine and deliberate: soft fog and out-of-focus -->
            <!-- dust have no edges for the scale to soften. Crisp particles    -->
            <!-- would need to live outside the Viewbox - see the FX plan S2.   -->
            <!--                                                                -->
            <!-- AmbientFxCanvas is hit-test invisible by construction, runs a  -->
            <!-- self-stopping clock, and MainWindow.DashboardFx registers it   -->
            <!-- with RegisterTabFx so it parks on every tab switch.            -->
            <!-- ============================================================ -->
            <fx:AmbientFxCanvas x:Name="MosaicFx" x:FieldModifier="internal"
                                Grid.Row="0" Grid.RowSpan="3"
                                Grid.Column="0" Grid.ColumnSpan="3"/>

            <!-- The Title="" literals below are English design-time fallbacks only.
                 At runtime MainWindow.ApplyModFeatureNames() overwrites every card title
                 with the localized name. Two are deliberately NOT localized and not
                 mod-renamed - "Down the Rabbit Hole" and "Goon Game" are brand names,
                 identical in all nine language files, exactly as MainWindow.PlayTab.cs:84
                 already argues for the Descent's lockband.

                 A LEFT-click navigates to the feature's one existing entry. There is no
                 right-click quick-toggle on this wall any more: these eight are
                 destinations, not dose dials, and "turn Down the Rabbit Hole on" is not a
                 thing you can do to it. The gesture moved to the premium rail, where the
                 chips ARE toggles - see MainWindow.PremiumRail.cs. -->

            <!-- Row 1: the Descent, the lobby, the feed -->
            <features:FeatureCard Grid.Row="0" Grid.Column="0" x:Name="CardDtrh" x:FieldModifier="internal"
                                  Title="Down the Rabbit Hole"
                                  Glyph="🐇"
                                  Click="CardDtrh_Click"/>
            <features:FeatureCard Grid.Row="0" Grid.Column="1" x:Name="CardGoon" x:FieldModifier="internal"
                                  Title="Goon Game"
                                  Icon="pack://application:,,,/Resources/features/goon_game.png"
                                  Click="CardGoon_Click"/>
            <features:FeatureCard Grid.Row="0" Grid.Column="2" x:Name="CardFyp" x:FieldModifier="internal"
                                  Title="For You"
                                  Icon="pack://application:,,,/Resources/features/fyp.png"
                                  Click="CardFyp_Click"/>

            <!-- Row 2: left edge + centre logo + right edge -->
            <features:FeatureCard Grid.Row="1" Grid.Column="0" x:Name="CardIntake" x:FieldModifier="internal"
                                  Title="Graded Intake"
                                  Icon="pack://application:,,,/Resources/features/lab_quiz_hero.png"
                                  HelpSectionId="Quiz"
                                  Click="CardIntake_Click"/>

            <!-- Centre logo, now a single 1x1 cell (was 2x2 on the old 4x4 wall).
                 Doubles as the weekly Graded Intake pass card: when a free account has an
                 unspent run waiting, MainWindow.RefreshIntakePassTile() flips this tile on its
                 Y axis and leaves the PASS face showing until the run is used or the week rolls.
                 The tile is NOT a cutscene - the card face is a standing affordance, so someone
                 who was on another tab when the week rolled still finds it here.

                 The 3x3 rebuild shrank this cell from ~1/2 of the mosaic's width to ~1/3, so the
                 PASS face's type is stepped down to match below. The Graded Intake tile sits
                 directly to its left, which is deliberate reinforcement rather than duplication:
                 the tile is the standing door, the flip is the "there is one waiting" event. -->
            <Border x:Name="LogoBrandFrame" x:FieldModifier="internal"
                    Grid.Row="1" Grid.Column="1"
                    Background="#01000000" Margin="6"
                    Cursor="Hand" MouseLeftButtonDown="ImgLogo_MouseLeftButtonDown"
                    ToolTip="{loc:Str tooltip_click_me_rapidly}">

                <!-- Flip host. The spin transform lives HERE and not on ImgLogo on purpose:
                     ImgLogo_MouseLeftButtonDown owns ImgLogo.RenderTransform (it casts it to a
                     ScaleTransform, replaces it when the cast fails, and re-runs an AutoReverse
                     click pulse on ScaleX/ScaleY). A flip sharing that transform would get
                     snapped back to 1.0 by the pulse mid-animation. Separate host, separate
                     transform, no fight. -->
                <Grid x:Name="LogoFlipHost" x:FieldModifier="internal" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <TransformGroup>
                            <!-- ScaleX 1 -> 0 -> 1 is the standard WPF fake for a Y-axis turn;
                                 there is no PlaneProjection/Viewport3D anywhere in this app and
                                 this tile is not the place to introduce one. The SkewTransform
                                 only sells depth - it is cosmetic and always ends back at 0. -->
                            <ScaleTransform x:Name="LogoFlipScale" ScaleX="1" ScaleY="1"/>
                            <SkewTransform x:Name="LogoFlipSkew" AngleX="0" AngleY="0"/>
                        </TransformGroup>
                    </Grid.RenderTransform>

                    <!-- FACE A: the wordmark. Default face; the only face premium users and
                         spent-week users ever see, byte-for-byte what shipped before. -->
                    <!-- The Ken Burns drift (scale 1.00 -> 1.04 over 40s, MainWindow.DashboardFx)
                         lives on THIS border and not on ImgLogo or on LogoFlipHost, and that is
                         a correctness rule, not a preference: LogoFlipHost's TransformGroup is
                         owned by the intake flip ceremony, and ImgLogo's ScaleTransform is owned
                         by the rapid-click easter-egg pulse. Both would snap the drift back to
                         1.0 mid-animation. This border sits between them and is otherwise
                         untouched, so the three transforms compose instead of fighting. -->
                    <Border x:Name="LogoFaceLogo" x:FieldModifier="internal" CornerRadius="12" ClipToBounds="True"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="LogoDriftScale" ScaleX="1" ScaleY="1"/>
                        </Border.RenderTransform>
                        <Grid>
                            <Image x:Name="ImgLogo" x:FieldModifier="internal" Stretch="Uniform"
                                   HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <!-- Occasional light pass over the wordmark (one shot every 25-40s,
                                 fired by a timer in MainWindow.DashboardFx - never an idle loop).
                                 Opacity 0 at rest, so it costs nothing between passes. -->
                            <Rectangle x:Name="LogoSheen" x:FieldModifier="internal"
                                       Width="110" HorizontalAlignment="Left"
                                       IsHitTestVisible="False" Opacity="0">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="Transparent" Offset="0"/>
                                        <GradientStop Color="{DynamicResource FxFlashTintColor}" Offset="0.5"/>
                                        <GradientStop Color="Transparent" Offset="1"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                                <Rectangle.RenderTransform>
                                    <TransformGroup>
                                        <SkewTransform AngleX="-18"/>
                                        <TranslateTransform x:Name="LogoSheenSlide"/>
                                    </TransformGroup>
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </Grid>
                    </Border>

                    <!-- FACE B: the weekly pass card. Collapsed by default so nothing about the
                         Dashboard changes until RefreshIntakePassTile() decides otherwise.
                         Visual register deliberately matches Features/FeatureCard.xaml (elevated
                         surface, 1px glass border, 12px radius, pink drop glow) so it reads as a
                         sibling of the tiles around it rather than a popup that got stuck.

                         Every piece of copy on this face is state-dependent (available / signed
                         out / spent) and is written by MainWindow.ApplyIntakePassFaceState(); the
                         {loc:Str} values below are the available-state defaults, so the card
                         still reads correctly if it is ever shown before the first paint. -->
                    <Border x:Name="IntakePassFace" x:FieldModifier="internal"
                            Visibility="Collapsed"
                            Background="{DynamicResource ElevatedSurfaceBrush}"
                            BorderBrush="{DynamicResource GlassBorderBrush}"
                            BorderThickness="1" CornerRadius="12" ClipToBounds="True"
                            Cursor="Hand"
                            MouseLeftButtonDown="IntakePassFace_MouseLeftButtonDown"
                            ToolTip="{loc:Str tooltip_intake_pass_card}">
                        <Border.Effect>
                            <DropShadowEffect Color="{DynamicResource PinkColor}"
                                              BlurRadius="18" ShadowDepth="0" Opacity="0.55"/>
                        </Border.Effect>
                        <Grid>
                            <!-- LAYER 0: the per-niche card art (Resources/intake/pass_card_*.png,
                                 1024x1024). Painted as an ImageBrush BACKGROUND rather than as an
                                 Image child because Border.ClipToBounds clips to the rectangle and
                                 ignores CornerRadius - a background brush is the only fill that
                                 actually follows the rounded corners. UniformToFill crops the
                                 square evenly into the tile instead of letterboxing it, and the
                                 art's dark, uncluttered lower third is where the CTA lands.
                                 Collapsed until IntakeNiche.PassCardImage() returns a bitmap; when
                                 it returns null every art layer stays hidden and the vector block
                                 below carries the card on its own. -->
                            <Border x:Name="IntakePassArt" x:FieldModifier="internal"
                                    CornerRadius="11" Visibility="Collapsed">
                                <Border.Background>
                                    <!-- x:Name only, no x:FieldModifier - the generated field is
                                         already internal, and that is the pattern LogoFlipScale /
                                         LogoFlipSkew above are proven on. -->
                                    <ImageBrush x:Name="IntakePassArtBrush"
                                                Stretch="UniformToFill"
                                                AlignmentX="Center" AlignmentY="Center"/>
                                </Border.Background>
                            </Border>

                            <!-- LAYER 1: ticket sheen. Vector only, and kept OVER the art on
                                 purpose - at 22% alpha it tints the top of the card the same pink
                                 as its neighbours whether or not the PNG resolved, so the tile
                                 belongs to the mosaic in both modes. -->
                            <Border CornerRadius="11">
                                <Border.Background>
                                    <RadialGradientBrush Center="0.5,0.12" GradientOrigin="0.5,0.05"
                                                         RadiusX="0.95" RadiusY="0.85">
                                        <GradientStop Color="#38FF69B4" Offset="0"/>
                                        <GradientStop Color="#00FF69B4" Offset="1"/>
                                    </RadialGradientBrush>
                                </Border.Background>
                            </Border>

                            <!-- LAYER 2: legibility scrim. Only shown with art under it - without
                                 art the card is already a flat dark surface and the scrim would
                                 just be a smudge. Dark at the top (headline) and heavier at the
                                 bottom (CTA), transparent through the middle so the ticket itself
                                 is never veiled. -->
                            <Border x:Name="IntakePassScrim" x:FieldModifier="internal"
                                    CornerRadius="11" Visibility="Collapsed" IsHitTestVisible="False">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#B31A1A2E" Offset="0"/>
                                        <GradientStop Color="#001A1A2E" Offset="0.28"/>
                                        <GradientStop Color="#001A1A2E" Offset="0.56"/>
                                        <GradientStop Color="#CC12121F" Offset="0.82"/>
                                        <GradientStop Color="#F20D0D18" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

                            <!-- Headline. Always visible - it is the only thing naming the feature
                                 in art mode, and it sits on the art's dark top strip.

                                 Type on this face is stepped down ~15% from the digits it carried
                                 on the 4x4 wall: the 3x3 rebuild took the cell from ~1/2 the
                                 mosaic's width to ~1/3, and these strings are translated into nine
                                 languages, several of which run longer than the English. The old
                                 sizes did not overflow - they wrapped to a third line and crowded
                                 the CTA. -->
                            <TextBlock x:Name="IntakePassHeadline" x:FieldModifier="internal"
                                       Text="{loc:Str intake_pass_card_headline}"
                                       VerticalAlignment="Top" HorizontalAlignment="Center"
                                       Margin="10,7,10,0"
                                       Foreground="{DynamicResource PinkBrush}"
                                       FontSize="11" FontWeight="Bold"
                                       TextAlignment="Center" TextWrapping="Wrap"/>

                            <!-- Vector block: the pre-art card body. Collapsed whenever art is
                                 showing (it would sit straight on top of the ticket); shown when
                                 PassCardImage() returned null, which is the documented fallback. -->
                            <StackPanel x:Name="IntakePassVectorBody" x:FieldModifier="internal"
                                        VerticalAlignment="Center" HorizontalAlignment="Center"
                                        Margin="10,20,10,28">
                                <!-- WPF cannot draw COLR/CPAL color-emoji fonts, so every emoji in
                                     this app is an Image routed through EmojiToImageSource. -->
                                <Image Width="21" Height="21" HorizontalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       Source="{Binding Source='✨', Converter={StaticResource EmojiToImageSource}}"/>

                                <Border Height="1" Margin="16,7"
                                        Background="{DynamicResource GlassBorderBrush}"/>

                                <TextBlock x:Name="IntakePassBody" x:FieldModifier="internal"
                                           Text="{loc:Str intake_pass_card_body}"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           FontSize="9.5" LineHeight="13"
                                           TextAlignment="Center" TextWrapping="Wrap"/>

                                <TextBlock Text="{loc:Str intake_pass_card_footnote}"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           FontSize="8" Opacity="0.75"
                                           TextAlignment="Center" TextWrapping="Wrap"
                                           Margin="0,5,0,0"/>
                            </StackPanel>

                            <!-- Bottom bar: the pulsing call to action plus the "(?)" explainer.
                                 The breath animation is driven from MainWindow (BeginAnimation on
                                 IntakePassCtaScale / the TextBlock's Opacity) - a Storyboard would
                                 silently no-op across this UserControl's namescope. Only the text
                                 scales; the "(?)" is deliberately left still so it stays an easy
                                 18px target.

                                 A Grid, not a horizontal StackPanel: a StackPanel hands its child
                                 infinite width, so a long translation of the CTA would refuse to
                                 wrap and get clipped off BOTH edges of the card. The 26px spacer
                                 column mirrors the "(?)" (18px button + 8px gutter) so the text
                                 still lands optically centred. -->
                            <Grid VerticalAlignment="Bottom" Margin="8,0,8,9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="26"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="IntakePassCta" x:FieldModifier="internal"
                                           Grid.Column="1"
                                           Text="{loc:Str intake_pass_card_cta}"
                                           Foreground="White" FontSize="10.5" FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           TextAlignment="Center" TextWrapping="Wrap"
                                           RenderTransformOrigin="0.5,0.5">
                                    <TextBlock.RenderTransform>
                                        <ScaleTransform x:Name="IntakePassCtaScale" ScaleX="1" ScaleY="1"/>
                                    </TextBlock.RenderTransform>
                                </TextBlock>

                                <!-- Same interactive popover the feature tiles use; MainWindow
                                     attaches the content (Controls.HelpPopover.Attach). A Button
                                     marks MouseLeftButtonDown handled, so clicking the "?" cannot
                                     also launch the intake or poke the logo easter egg. -->
                                <Button x:Name="BtnIntakePassHelp" x:FieldModifier="internal"
                                        Grid.Column="2"
                                        Style="{DynamicResource HelpButtonStyle}"
                                        HorizontalAlignment="Left" VerticalAlignment="Center"
                                        Margin="8,0,0,0"/>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
    
            <features:FeatureCard Grid.Row="1" Grid.Column="2" x:Name="CardRemote" x:FieldModifier="internal"
                                  Title="Remote Control"
                                  Icon="pack://application:,,,/Resources/features/remote_control.png"
                                  HelpSectionId="RemoteControl"
                                  Click="CardRemote_Click"/>

            <!-- Row 3: the two makers and the placeholder -->
            <!-- Loom and Deeper have no art of their own anywhere in the app (asset audit §6 -
                 the Deeper tab is 100% emoji-typographic), so they carry the SAME glyphs their
                 Play door cards carry: 🧵 and 🕳. Inventing art for them here would put two
                 different faces on one feature. -->
            <features:FeatureCard Grid.Row="2" Grid.Column="0" x:Name="CardLoom" x:FieldModifier="internal"
                                  Title="The Loom"
                                  Glyph="🧵"
                                  Click="CardLoom_Click"/>
            <features:FeatureCard Grid.Row="2" Grid.Column="1" x:Name="CardDeeper" x:FieldModifier="internal"
                                  Title="Deeper"
                                  Glyph="🕳"
                                  Click="CardDeeper_Click"/>
            <!-- Just Drop: the session maker, not built yet (owner, 2026-08-11 - "placeholder for
                 now"). The tile ships locked with a SOON band rather than hidden, because the
                 point of putting it on the wall is to say it is coming. CardJustDrop_Click is
                 deliberately a toast and nothing else: there is no window to open, and a tile
                 that silently does nothing reads as broken. Wire it to the real launcher when
                 the feature lands and delete the toast - nothing else on this wall changes.
                 Placeholder name is a literal on purpose: naming it in nine language files
                 before the feature exists would be nine rows to re-translate when it is named
                 for real. -->
            <features:FeatureCard Grid.Row="2" Grid.Column="2" x:Name="CardJustDrop" x:FieldModifier="internal"
                                  Title="Just Drop"
                                  Glyph="🎚"
                                  Click="CardJustDrop_Click"/>

            <!-- ============================================================ -->
            <!-- PROGRAM FEATURE LOCK - the "why" pill. Shown only while a     -->
            <!-- Training Program session is running; painted and hidden from   -->
            <!-- MainWindow.ProgramLock.cs (ApplyProgramLockRibbon), which      -->
            <!-- DERIVES the state from live engine state rather than latching. -->
            <!--                                                                -->
            <!-- It is an OVERLAY, and that is load-bearing: RowSpan/ColumnSpan  -->
            <!-- cover the whole mosaic and VerticalAlignment=Top pins it to     -->
            <!-- the top edge, so it adds ZERO height to the fixed 1489x901      -->
            <!-- design canvas. Adding real height here is how the Remote chip   -->
            <!-- got eaten by WPF's silent layout clip - no scrollbar, no        -->
            <!-- warning, no binding error.                                      -->
            <!--                                                                -->
            <!-- IsHitTestVisible=False on purpose: being locked out of          -->
            <!-- CHANGING the day's feature mix is no reason to be locked out of -->
            <!-- reading it, so every tile underneath still opens its popup.     -->
            <!-- The refusal happens in code, not by swallowing clicks.          -->
            <!-- ============================================================ -->
            <Border x:Name="ProgramFeatureLockRibbon" x:FieldModifier="internal"
                    Grid.Row="0" Grid.RowSpan="3" Grid.Column="0" Grid.ColumnSpan="3"
                    Visibility="Collapsed" IsHitTestVisible="False" Panel.ZIndex="30"
                    VerticalAlignment="Top" HorizontalAlignment="Center"
                    MaxWidth="620" Margin="0,14,0,0" Padding="13,6,13,6"
                    Background="#F21A1A2E" BorderBrush="{DynamicResource PinkBrush}"
                    BorderThickness="1" CornerRadius="10">
                <Border.Effect>
                    <DropShadowEffect Color="{DynamicResource PinkColor}"
                                      BlurRadius="16" ShadowDepth="0" Opacity="0.6"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <!-- WPF cannot draw COLR/CPAL colour-emoji fonts; EmojiTextBlock is the
                         app-wide route for every emoji (same idiom as PremiumRailLock). -->
                    <helpers:EmojiTextBlock Text="🔒" FontSize="13" VerticalAlignment="Center"
                                            Margin="0,0,8,0"/>
                    <!-- Text is written by ApplyProgramLockRibbon. The literal here is a
                         design-time placeholder only - it is never shown, because the ribbon
                         is Collapsed until that method fills it in. -->
                    <TextBlock x:Name="TxtProgramFeatureLock" x:FieldModifier="internal"
                               Text="Program is running this"
                               Foreground="{DynamicResource PinkBrush}"
                               FontSize="11" FontWeight="SemiBold"
                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    
        <!-- ============================================================ -->
        <!-- LEGACY DASHBOARD HOST - DEMOLISHED (UX restructure, Phase 8). -->
        <!--                                                              -->
        <!-- 459 lines and ~65 x:Names that were Visibility="Collapsed"   -->
        <!-- forever, kept alive only so MainWindow's partials could keep  -->
        <!-- addressing them by name. Every control had a proven live      -->
        <!-- editor by Phase 4:                                            -->
        <!--   Flash / Visuals / Video / Subliminal dose dials             -->
        <!--       -> the Studio rack's Features/*FeatureControl panels    -->
        <!--          (Views/Tabs/StudioTabView.xaml:181-199)              -->
        <!--   ChkDualMon -> Features/SystemFeatureControl.ChkMultiMon,    -->
        <!--          reachable from the "System" quick-toggle pill below  -->
        <!--   Performance twins (ChkPerformanceMode, ChkAutoPerformance,  -->
        <!--          ChkVideoHwDecode, ChkUnifiedOverlay, CmbMotionLevel) -->
        <!--       -> Views/Controls/AppSettings/PerformanceSettingsSection-->
        <!--                                                               -->
        <!-- The read-backs in SaveSettings were provable identity ops      -->
        <!-- (SaveSettings opened by calling LoadSettings), except where a  -->
        <!-- twin slider's Min/Max clamped the value - the hazard the       -->
        <!-- range-matching comments in this markup used to ward off.       -->
        <!-- Deleting both halves removes the clamp permanently.            -->
        <!-- ============================================================ -->
    
        <!-- RIGHT HALF — col 2 (after premium rail + feature grid).
             Phase 3 layout: browser card (star) · companion strip (auto) · account strip (auto).
             The Audio card left in Phase 2 and the audio-sync sliders left in Phase 3; the old
             tall "Quick Links" card is compressed into the one-line account strip at the foot, so
             this column is SHORTER than it was and the browser card gains the difference. Nothing
             here may grow: every unit taken from row 0 comes off the WebView2's layout slot. -->
        <Grid Grid.Column="2" Grid.Row="1" Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Browser Section -->
            <!-- ClipToBounds is a backstop, not the fix: the WebView2 below is a native HWND
                 (an HwndHost), and WPF's layout clip does not reliably clip native children.
                 If this card is ever over-filled again the spill has to stop at the card's own
                 edge instead of painting over the account card and the helper-button row. -->
            <!-- AIRSPACE. The WebView2 inside this card is a native HWND: nothing WPF draws can
                 ever appear over it, and a RenderTransform on the card would leave the browser
                 behind. So this card's FX are on the FRAME and the HEADER only - a slow light
                 travelling around the border (animated gradient stops, driven and tier-gated
                 from MainWindow.DashboardFx) plus a pulse on the status text while it is still
                 loading. Nothing here paints over the web surface, and nothing here moves it. -->
            <Border x:Name="BrowserCardFrame" x:FieldModifier="internal"
                    Grid.Row="0" CornerRadius="12" Padding="9" Margin="0,0,0,5" ClipToBounds="True"
                    Background="{DynamicResource ElevatedSurfaceBrush}" BorderThickness="1">
                <Border.BorderBrush>
                    <!-- The resting offsets park the bright core entirely BEFORE the brush's 0
                         mark. LinearGradientBrush pads past its last stop, so at rest the whole
                         frame is flat GlassBorder - byte-for-byte the border that shipped. The
                         travelling band only exists while the loop is running. -->
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop x:Name="BrowserFrameStopLead" Color="{DynamicResource GlassBorder}" Offset="-0.30"/>
                        <GradientStop x:Name="BrowserFrameStopCore" Color="{DynamicResource FxGlowColor}" Offset="-0.15"/>
                        <GradientStop x:Name="BrowserFrameStopTail" Color="{DynamicResource GlassBorder}" Offset="0"/>
                    </LinearGradientBrush>
                </Border.BorderBrush>
                <!-- Grid, not StackPanel. A StackPanel hands each child its DESIRED height and
                     never shrinks it, so the browser box below (which used to carry a hard
                     Height="340") kept its old size when the Training Programs "Today" banner
                     took ~64 design units out of this column - and the native WebView2 painted
                     straight through the card's bottom edge. With Auto/* the browser box is
                     simply whatever is left after the header: it shrinks when the banner
                     appears, grows back when it goes, and follows window resize / DPI change
                     for free, because layout - not a constant - decides its height. -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <!-- Browser Header - single row with title, tabs, status, webcam toggle, pop out -->
                    <Grid Grid.Row="0" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <helpers:EmojiTextBlock Style="{StaticResource SectionHeader}" Text="{loc:Str section_browser}" Margin="0"/>
                            <Button x:Name="HelpBtnBrowser" x:FieldModifier="internal" Style="{StaticResource HelpButtonStyle}" Tag="Browser"/>
                        </StackPanel>
                        <!-- Site Toggle - inline -->
                        <Border Grid.Column="1" Background="{DynamicResource PanelAccentBrush}" CornerRadius="10" Padding="2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <!-- #867: Click, not Checked. A RadioButton raises Checked only when
                                     it CHANGES, so clicking the site you are already on did nothing -
                                     which is exactly what a user does to get back to the homepage
                                     from a video page. Click fires either way. It also means code
                                     that sets IsChecked (mod switch, external-link sync) no longer
                                     triggers a navigation it did not ask for. -->
                                <RadioButton x:Name="RbBambiCloud" x:FieldModifier="internal" Content="{loc:Str btn_bambicloud}" GroupName="BrowserSite"
                                             IsChecked="True" Click="BrowserSiteToggle_Click"
                                             Foreground="{DynamicResource TextLightBrush}" FontSize="10" Cursor="Hand" Margin="2,1">
                                    <RadioButton.Template>
                                        <ControlTemplate TargetType="RadioButton">
                                            <Border x:Name="border" Background="Transparent" CornerRadius="8" Padding="8,3">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="{DynamicResource PinkBrush}"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#353565"/>
                                            </Trigger>
                                            <MultiTrigger>
                                                <MultiTrigger.Conditions>
                                                    <Condition Property="IsChecked" Value="True"/>
                                                    <Condition Property="IsMouseOver" Value="True"/>
                                                </MultiTrigger.Conditions>
                                                <Setter TargetName="border" Property="Background" Value="{DynamicResource PinkButtonHoveredBrush}"/>
                                            </MultiTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </RadioButton.Template>
                            </RadioButton>
                            <RadioButton x:Name="RbHypnoTube" x:FieldModifier="internal" Content="{loc:Str btn_hypnotube}" GroupName="BrowserSite"
                                         Click="BrowserSiteToggle_Click"
                                         Foreground="{DynamicResource TextLightBrush}" FontSize="10" Cursor="Hand" Margin="2,1">
                                <RadioButton.Template>
                                    <ControlTemplate TargetType="RadioButton">
                                        <Border x:Name="border" Background="Transparent" CornerRadius="8" Padding="8,3">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="{DynamicResource PinkBrush}"/>
                                                <Setter Property="Foreground" Value="White"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#353565"/>
                                            </Trigger>
                                            <MultiTrigger>
                                                <MultiTrigger.Conditions>
                                                    <Condition Property="IsChecked" Value="True"/>
                                                    <Condition Property="IsMouseOver" Value="True"/>
                                                </MultiTrigger.Conditions>
                                                <Setter TargetName="border" Property="Background" Value="{DynamicResource PinkButtonHoveredBrush}"/>
                                            </MultiTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </RadioButton.Template>
                            </RadioButton>
                            </StackPanel>
                        </Border>
                        <!-- Reload / Home button - sits just right of the site toggle.
                             Reloads the current site's homepage; gives a way out of a
                             stuck/blank page (e.g. after a remote video is stopped), since
                             re-clicking an already-selected site radio won't reload. -->
                        <Button Grid.Column="2" x:Name="BtnReloadBrowser"
                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                Click="BtnReloadBrowser_Click"
                                ToolTip="{loc:Str tooltip_reload_browser}"
                                FontSize="11" Padding="6,3" Margin="8,0,0,0">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="{DynamicResource TransparentPinkBrush}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource PinkBrush}"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource TransparentPink50Brush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                            <helpers:EmojiTextBlock Text="🔄"/>
                        </Button>
                        <!-- Status indicator -->
                        <TextBlock Grid.Column="3" x:Name="TxtBrowserStatus" x:FieldModifier="internal" Text="{loc:Str label_loading}"
                                   Foreground="{DynamicResource PinkBrush}" FontSize="10"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <!-- Deeper auto-bind badge (Phase 9). Shows when an enhancement is active for the current page. -->
                        <Border Grid.Column="3" x:Name="DeeperBrowserBadge" x:FieldModifier="internal" Visibility="Collapsed"
                                Background="{DynamicResource DeeperAccentTransparent20Brush}"
                                BorderBrush="{DynamicResource DeeperAccentBrush}" BorderThickness="1"
                                CornerRadius="3" Padding="6,1" Margin="0,0,8,0"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                ToolTip="{Binding ElementName=DeeperBrowserBadge, Path=Tag}">
                            <TextBlock x:Name="TxtDeeperBrowserBadge" x:FieldModifier="internal"
                                       Text="🌊 Deeper"
                                       Foreground="{DynamicResource DeeperAccentBrush}"
                                       FontSize="9" FontWeight="SemiBold"/>
                        </Border>
                        <!-- Webcam Tracking toggle - inline, sits between status badge and pop-out.
                             Off: "📷 Webcam"  On: "📷 Webcam On" (label updated in code-behind
                             from OnTrackingStateChanged). Click runs the consent → calibrate →
                             start flow if needed; second click stops tracking. -->
                        <Button Grid.Column="4" x:Name="BtnWebcamTracking" x:FieldModifier="internal"
                                Click="BtnWebcamTracking_Click"
                                ToolTip="{loc:Str tooltip_browser_webcam_tracking_off}"
                                FontSize="9" Padding="6,3" Margin="0,0,6,0" VerticalAlignment="Center">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="{DynamicResource TransparentPinkBrush}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource PinkBrush}"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource TransparentPink50Brush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                            <helpers:EmojiTextBlock x:Name="TxtWebcamTracking" x:FieldModifier="internal" Text="{loc:Str btn_browser_webcam_tracking_off}"/>
                        </Button>
                        <!-- Mute browser audio toggle (BambiCloud / HypnoTube video) -->
                        <Button Grid.Column="5" x:Name="BtnMuteBrowser" x:FieldModifier="internal"
                                Click="BtnMuteBrowser_Click" Cursor="Hand"
                                ToolTip="Mute / unmute browser audio (BambiCloud / HypnoTube)"
                                Background="Transparent" BorderThickness="0" Padding="5,2" Margin="4,0,0,0"
                                VerticalAlignment="Center">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource TransparentPink50Brush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <helpers:EmojiTextBlock x:Name="TxtBrowserMute" x:FieldModifier="internal" Text="🔊" FontSize="13"/>
                        </Button>
                        <!-- Pop Out button -->
                        <Button Grid.Column="6" x:Name="BtnPopOutBrowser" x:FieldModifier="internal" Content="{loc:Str btn_pop_out}"
                                Click="BtnPopOutBrowser_Click"
                                ToolTip="{loc:Str tooltip_pop_out_browser_to_resizable_window}"
                                FontSize="9" Padding="6,3" VerticalAlignment="Center">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="{DynamicResource PinkBrush}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource PinkButtonHoveredBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter Property="Background" Value="#E05A9E"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
    
                    <!-- Browser Container. No fixed Height on purpose - see the Grid note above.
                         It fills the star row, so the WebView2's layout slot (and therefore its
                         native window) is always inside this card. -->
                    <Border Grid.Row="1" Background="{DynamicResource SurfaceBgBrush}" CornerRadius="6" ClipToBounds="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
    
                            <!-- Deeper "Enhance if possible" toggle (always visible) -->
                            <Border x:Name="BrowserEnhanceToolbar" Grid.Row="0"
                                    Background="{DynamicResource PanelBgBrush}" Padding="8,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox x:Name="ToggleEnhanceIfPossible" x:FieldModifier="internal" Grid.Column="0"
                                              Content="{loc:Str browser_enhance_label}"
                                              Foreground="{DynamicResource TextLightBrush}" FontSize="11"
                                              VerticalAlignment="Center" Cursor="Hand"
                                              Checked="ToggleEnhanceIfPossible_Changed"
                                              Unchecked="ToggleEnhanceIfPossible_Changed"
                                              ToolTip="{loc:Str browser_enhance_tooltip}"/>
                                    <TextBlock x:Name="TxtEnhanceMatchStatus" x:FieldModifier="internal" Grid.Column="1"
                                               Text="{loc:Str browser_enhance_match_none}"
                                               Foreground="{DynamicResource TextMutedBrush}" FontSize="10"
                                               VerticalAlignment="Center"
                                               Margin="12,0,0,0" TextTrimming="CharacterEllipsis"/>
                                    <!-- User override: reveal the BambiCloud site toggle even on mods
                                         whose manifest hides it (issue #596). -->
                                    <CheckBox x:Name="ChkForceShowBambiCloud" x:FieldModifier="internal" Grid.Column="2"
                                              Content="{loc:Str browser_show_bambicloud_label}"
                                              Foreground="{DynamicResource TextMutedBrush}" FontSize="10"
                                              VerticalAlignment="Center" Cursor="Hand" Margin="12,0,0,0"
                                              Checked="ChkForceShowBambiCloud_Changed"
                                              Unchecked="ChkForceShowBambiCloud_Changed"
                                              ToolTip="{loc:Str browser_show_bambicloud_tooltip}"/>
                                </Grid>
                            </Border>
    
                            <!-- MOVED to Settings/Audio (Phase 3): AudioSyncLatencyPanel with
                                 SliderAudioSyncLatency / TxtAudioSyncLatency /
                                 SliderAudioSyncIntensity / TxtAudioSyncIntensity. They now live
                                 verbatim in Views/Controls/AppSettings/AudioSettingsSection.xaml
                                 and are reached as AppSettingsTab.<Name> - the same passthrough
                                 pattern Phase 2 used for the rest of AudioSection.
                                 Grid.Row="1" is deliberately left EMPTY rather than renumbered:
                                 BrowserContainer keeps Grid.Row="2", so the browser's layout slot
                                 (and therefore the native WebView2's window) does not move a pixel.
                                 An Auto row with no child measures 0.

                                 2026-08-11: the row is empty no longer. The owner missed having
                                 audio on the dashboard ("was pretty handy to have it on screen"),
                                 so the two dials that actually get touched mid-session - master
                                 volume and ducking - come back HERE, in the slot their neighbours
                                 vacated. Deliberately NOT a second AudioSettingsSection: that
                                 control's children are re-published as AppSettingsTab.<Name> and
                                 written directly by MainWindow, so a second instance would render
                                 stale values and fight the canonical one. These two mirror the
                                 canonical controls through MainWindow.HomeAudio.cs instead, which
                                 is the same two-surface pattern SliderAudioSyncLatency already
                                 uses with the Haptics panel. -->

                            <Border Grid.Row="1" x:Name="HomeAudioCard" x:FieldModifier="internal"
                                    CornerRadius="10" Padding="10,7" Margin="0,0,0,5"
                                    Background="{DynamicResource ElevatedSurfaceBrush}"
                                    BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1">
                                <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <helpers:EmojiTextBlock Grid.Column="0" Text="{loc:Str section_audio}"
                                                            Foreground="{DynamicResource PinkBrush}"
                                                            FontSize="12" FontWeight="Bold"
                                                            VerticalAlignment="Center" Margin="0,0,10,0"/>

                                    <Slider Grid.Column="1" x:Name="HomeSliderMaster" x:FieldModifier="internal"
                                            Minimum="0" Maximum="100" VerticalAlignment="Center"
                                            ValueChanged="HomeSliderMaster_Changed"
                                            ToolTip="{loc:Str tooltip_master_volume_for_all_audio}"/>

                                    <TextBlock Grid.Column="2" x:Name="HomeTxtMaster" x:FieldModifier="internal"
                                               Text="50%" Foreground="{DynamicResource TextMutedBrush}"
                                               FontSize="11" VerticalAlignment="Center"
                                               Width="34" TextAlignment="Right" Margin="8,0,12,0"/>

                                    <CheckBox Grid.Column="3" x:Name="HomeChkAudioDuck" x:FieldModifier="internal"
                                              Content="{loc:Str label_duck}"
                                              Foreground="{DynamicResource TextMutedBrush}" FontSize="11"
                                              VerticalAlignment="Center" Cursor="Hand"
                                              Checked="HomeChkAudioDuck_Changed"
                                              Unchecked="HomeChkAudioDuck_Changed"
                                              ToolTip="{loc:Str tooltip_automatically_reduce_other_app_volumes_during}"/>

                                    <!-- The old dashboard's BtnAudioAdvanced disclosure, restored:
                                         master + duck stay on the face, everything else is one
                                         click away. Same rows, same order as before the
                                         restructure. -->
                                    <ToggleButton Grid.Column="4" x:Name="HomeBtnAudioAdvanced" x:FieldModifier="internal"
                                                  Margin="10,0,0,0" VerticalAlignment="Center" Cursor="Hand"
                                                  Checked="HomeBtnAudioAdvanced_Changed"
                                                  Unchecked="HomeBtnAudioAdvanced_Changed"
                                                  ToolTip="{loc:Str tooltip_show_advanced_audio_settings}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent" Padding="4,0">
                                                    <TextBlock x:Name="arrow" Text="&#x25BE;" FontSize="13"
                                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="arrow" Property="Text" Value="&#x25B4;"/>
                                                        <Setter TargetName="arrow" Property="Foreground"
                                                                Value="{DynamicResource PinkBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="arrow" Property="Foreground"
                                                                Value="{DynamicResource PinkBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                    </Grid>

                                    <!-- Advanced rows. Every control here MIRRORS its twin in
                                         Settings · Audio (MainWindow.HomeAudio.cs) - none of them
                                         owns state. -->
                                    <StackPanel x:Name="HomeAudioAdvanced" x:FieldModifier="internal"
                                                Visibility="Collapsed" Margin="0,8,0,0">

                                        <Grid Margin="0,0,0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{loc:Str setting_video}" FontSize="11"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       VerticalAlignment="Center"
                                                       ToolTip="{loc:Str tooltip_volume_for_mandatory_videos}"/>
                                            <Slider Grid.Column="1" x:Name="HomeSliderVideoVolume" x:FieldModifier="internal"
                                                    Minimum="0" Maximum="100" VerticalAlignment="Center"
                                                    ValueChanged="HomeSliderVideoVolume_Changed"
                                                    ToolTip="{loc:Str tooltip_separate_volume_control_for_videos}"/>
                                            <TextBlock Grid.Column="2" x:Name="HomeTxtVideoVolume" x:FieldModifier="internal"
                                                       Text="50%" FontSize="11" Width="34" TextAlignment="Right"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        </Grid>

                                        <Grid Margin="0,0,0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{loc:Str label_duck}" FontSize="11"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       VerticalAlignment="Center"
                                                       ToolTip="{loc:Str tooltip_how_much_to_reduce_other_audio}"/>
                                            <Slider Grid.Column="1" x:Name="HomeSliderDuck" x:FieldModifier="internal"
                                                    Minimum="0" Maximum="100" VerticalAlignment="Center"
                                                    ValueChanged="HomeSliderDuck_Changed"
                                                    ToolTip="{loc:Str tooltip_ducking_percentage_80_reduce_other_audio_to_2}"/>
                                            <TextBlock Grid.Column="2" x:Name="HomeTxtDuck" x:FieldModifier="internal"
                                                       Text="80%" FontSize="11" Width="34" TextAlignment="Right"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        </Grid>

                                        <Grid Margin="0,0,0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{loc:Str setting_output}" FontSize="11"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       VerticalAlignment="Center"
                                                       ToolTip="{loc:Str tooltip_audio_output_device}"/>
                                            <ComboBox Grid.Column="1" x:Name="HomeCmbAudioOutputDevice" x:FieldModifier="internal"
                                                      FontSize="11" VerticalAlignment="Center"
                                                      SelectionChanged="HomeCmbAudioOutputDevice_SelectionChanged"
                                                      ToolTip="{loc:Str tooltip_audio_output_device}"/>
                                            <Button Grid.Column="2" x:Name="HomeBtnAudioOutputRefresh" Content="↻"
                                                    FontSize="11" Margin="6,0,0,0" Padding="8,2" Cursor="Hand"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Click="HomeBtnAudioOutputRefresh_Click"
                                                    ToolTip="{loc:Str set2_tooltip_audio_output_refresh}"/>
                                        </Grid>

                                        <CheckBox x:Name="HomeChkExcludeBambiCloudDucking" x:FieldModifier="internal"
                                                  Content="{loc:Str setting_don_t_duck_browser}"
                                                  Foreground="{DynamicResource TextMutedBrush}" FontSize="11"
                                                  Cursor="Hand" Margin="0,0,0,6"
                                                  Checked="HomeChkExcludeBambiCloudDucking_Changed"
                                                  Unchecked="HomeChkExcludeBambiCloudDucking_Changed"
                                                  ToolTip="{loc:Str tooltip_when_enabled_audio_from_the_integrated_bambic}"/>

                                        <StackPanel Orientation="Horizontal">
                                            <Button x:Name="HomeBtnTestAudio" Content="{loc:Str set2_btn_test_audio}"
                                                    FontSize="11" Margin="0,0,8,0" Cursor="Hand"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Click="HomeBtnTestAudio_Click"
                                                    ToolTip="{loc:Str set2_tooltip_test_audio}"/>
                                            <Button x:Name="HomeBtnAudioLayers" Content="{loc:Str btn_audio_layers}"
                                                    FontSize="11" Cursor="Hand"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Click="HomeBtnAudioLayers_Click"
                                                    ToolTip="{loc:Str tooltip_audio_layers}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Grid x:Name="BrowserContainer" x:FieldModifier="internal" Grid.Row="2">
                                <!-- WebView2 will be added here programmatically -->
                                <TextBlock x:Name="BrowserLoadingText" x:FieldModifier="internal"
                                           Text="{loc:Str label_click_to_load_browser}"
                                           Foreground="{DynamicResource TextMutedBrush}" FontSize="12"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Cursor="Hand"
                                           MouseLeftButtonDown="BrowserLoadingText_Click"/>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
    
            <!-- ============================================================ -->
            <!-- COMPANION STRIP (Phase 3, new).                              -->
            <!--                                                              -->
            <!-- The Companion door owns her portrait, her status dots and    -->
            <!-- her breathe loop (CompanionHeroCard), and CompanionTheme.xaml -->
            <!-- budgets exactly ONE Forever storyboard for the companion     -->
            <!-- app-wide. A second breathing portrait here would spend that   -->
            <!-- budget twice and would need Start/Stop/RefreshAmbientState    -->
            <!-- wiring from the shell. So this is deliberately a QUIET strip: -->
            <!-- a standing affordance into her door, no art, no clock,        -->
            <!-- nothing for the motion kill-switch or the ShowTab teardown to -->
            <!-- have to reach. Give it a portrait later, with the loop.       -->
            <!-- ============================================================ -->
            <Border x:Name="CompanionStrip" x:FieldModifier="internal" Grid.Row="1"
                    CornerRadius="12" Padding="10,7" Margin="0,0,0,5"
                    Background="{DynamicResource ElevatedSurfaceBrush}"
                    BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1"
                    Cursor="Hand" MouseLeftButtonDown="CompanionStrip_Click"
                    ToolTip="{loc:Str tooltip_companion_settings}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- WPF cannot draw COLR/CPAL colour-emoji fonts, so every emoji in this app
                         is an Image routed through EmojiToImageSource. Same glyph as the sidebar's
                         Companion door, so the two read as one place. -->
                    <Image Grid.Column="0" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,9,0"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Source="{Binding Source='🤖', Converter={StaticResource EmojiToImageSource}}"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{loc:Str nav_door_companion}"
                                   Foreground="{DynamicResource PinkBrush}"
                                   FontSize="12" FontWeight="Bold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{loc:Str hm3_companion_strip_sub}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="10" Margin="0,1,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="›" VerticalAlignment="Center" Margin="12,0,2,0"
                               Foreground="{DynamicResource TextMutedBrush}" FontSize="18"/>
                </Grid>
            </Border>

            <!-- ============================================================ -->
            <!-- ACCOUNT STRIP (Phase 3) - the old "Quick Links" card,         -->
            <!-- compressed from a four-row tile into one line.                -->
            <!--                                                               -->
            <!-- Settings - Account has been the real account page since        -->
            <!-- Phase 2, so this is the glance-and-go surface, not the editor. -->
            <!-- It is NOT redundant markup: every x:Name below is written by   -->
            <!-- live code and none may be dropped before Phase 8 -             -->
            <!--   BtnUnifiedLogin ............ Login.cs:337, UiUpdates.cs      -->
            <!--                                offline gating (:3022)          -->
            <!--   LoggedInStatusPanel ........ Login.cs:338                    -->
            <!--   TxtLoggedInName ............ Login.cs:346/:351 (incl. the    -->
            <!--                                OG star prefix)                 -->
            <!--   ChkQuickDiscordRichPresence  AccountShell.cs:291/:302 mirror -->
            <!--                                + MainWindow.xaml.cs:2397 load  -->
            <!--   HelpBtnQuickLinks .......... Presets.cs:49 SetHelpContent    -->
            <!--                                ("QuickLinks")                  -->
            <!-- The card's old section_quick_links caption is gone with the    -->
            <!-- header row; the "?" popover still explains the strip.          -->
            <!-- ============================================================ -->
            <Border Grid.Row="2" CornerRadius="12" Padding="9,7"
                    Background="{DynamicResource ElevatedSurfaceBrush}"
                    BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- The logged-out and logged-in faces share ONE cell: MainWindow.Login.cs
                         flips exactly these two Visibilities against each other, so they must
                         never be able to claim two slots' worth of width between them. -->
                    <Grid Grid.Column="0">
                        <!-- Unified Login Button -->
                        <Button x:Name="BtnUnifiedLogin" x:FieldModifier="internal" Content="{loc:Str btn_login_2}"
                                Click="BtnUnifiedLogin_Click"
                                Padding="14,7" HorizontalAlignment="Left" VerticalAlignment="Center"
                                ToolTip="{loc:Str tooltip_login_with_discord_or_patreon}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="{DynamicResource PinkBrush}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#E055A0"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter Property="Background" Value="#C04888"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
    
                        <!-- Logged In Status (shown when logged in) -->
                        <Border x:Name="LoggedInStatusPanel" x:FieldModifier="internal" Visibility="Collapsed"
                                Background="{DynamicResource PanelBgBrush}" CornerRadius="6" Padding="9,4"
                                VerticalAlignment="Center"
                                BorderBrush="{DynamicResource PinkBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtLoggedInAs" Text="{loc:Str label_logged_in_as}"
                                               Foreground="{DynamicResource TextMutedBrush}" FontSize="10"/>
                                    <TextBlock x:Name="TxtLoggedInName" x:FieldModifier="internal" Text="{loc:Str label_username}"
                                               Foreground="White" FontWeight="Bold" FontSize="14" Margin="0,1,0,0"
                                               TextTrimming="CharacterEllipsis">
                                        <TextBlock.Effect>
                                            <DropShadowEffect Color="#FF69B4" BlurRadius="10" ShadowDepth="0" Opacity="0.65"/>
                                        </TextBlock.Effect>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="BtnLinkPhone" Content="📱 Link phone"
                                        Click="BtnLinkPhone_Click" Margin="0,0,6,0" VerticalAlignment="Center"
                                        ToolTip="Sign in to the CCP mobile app by scanning a QR code"
                                        Padding="8,3" Background="{DynamicResource AccentTintedBgBrush}" Foreground="{DynamicResource PinkBrush}"
                                        BorderThickness="0" FontSize="10" Cursor="Hand"/>
                                <!-- Prominent, high-contrast Logout button -->
                                <Button x:Name="BtnQuickLogout" Content="{loc:Str btn_logout}"
                                        Click="BtnQuickLogout_Click" VerticalAlignment="Center"
                                        Padding="12,4" FontSize="11" FontWeight="Bold" Cursor="Hand"
                                        ToolTip="{loc:Str btn_logout}">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="Background" Value="{DynamicResource PinkBrush}"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="lborder" Background="{TemplateBinding Background}"
                                                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="lborder" Property="Background" Value="#E055A0"/>
                                                            </Trigger>
                                                            <Trigger Property="IsPressed" Value="True">
                                                                <Setter TargetName="lborder" Property="Background" Value="#C04888"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Discord Join Button -->
                    <Button Grid.Column="1" Click="BtnDiscord_Click"
                            ToolTip="{loc:Str tooltip_join_the_discord_community}" Cursor="Hand"
                            VerticalAlignment="Center" Margin="10,0,0,0">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="border" Background="#5865F2" CornerRadius="5"
                                                            Padding="12,5" HorizontalAlignment="Stretch">
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                            <Image Width="13" Height="13" VerticalAlignment="Center"
                                                                   Source="{Binding Source='💬', Converter={StaticResource EmojiToImageSource}}"/>
                                                            <TextBlock Text="{loc:Str label_join_discord}" Foreground="White" FontSize="10" FontWeight="Bold"
                                                                       VerticalAlignment="Center" Margin="5,0,0,0"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="border" Property="Background" Value="#6C75F2"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                <StackPanel.ToolTip>
                                    <ToolTip Background="{DynamicResource SurfaceBgBrush}" BorderBrush="{DynamicResource PinkBrush}" BorderThickness="1" Padding="10">
                                        <StackPanel MaxWidth="280">
                                            <TextBlock Text="{loc:Str label_discord_rich_presence}" Foreground="{DynamicResource PinkBrush}" FontSize="12" FontWeight="Bold" Margin="0,0,0,6"/>
                                            <TextBlock Foreground="#CCCCCC" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8">
                                                Shows "Playing Conditioning Control Panel" in your Discord status, along with your current level and session time.
                                            </TextBlock>
                                            <TextBlock Text="{loc:Str label_who_can_see_this}" Foreground="{DynamicResource SecondaryBrush}" FontSize="11" FontWeight="Bold" Margin="0,0,0,4"/>
                                            <TextBlock Foreground="#AAAAAA" FontSize="10" TextWrapping="Wrap">
                                                Only people who can already see your Discord activity status (friends, server members if enabled in your Discord privacy settings). This does NOT send notifications - it simply updates your "Currently Playing" status like any other game.
                                            </TextBlock>
                                        </StackPanel>
                                    </ToolTip>
                                </StackPanel.ToolTip>
                                <CheckBox x:Name="ChkQuickDiscordRichPresence" x:FieldModifier="internal" Style="{StaticResource ToggleStyle}"
                                          Checked="ChkDiscordRichPresence_Changed" Unchecked="ChkDiscordRichPresence_Changed">
                                    <CheckBox.LayoutTransform>
                                        <ScaleTransform ScaleX="0.85" ScaleY="0.85"/>
                                    </CheckBox.LayoutTransform>
                                </CheckBox>
                                <TextBlock Text="{loc:Str label_rp}" Foreground="{DynamicResource TextMutedBrush}" FontSize="9"
                                           VerticalAlignment="Center" Margin="4,0,0,0"/>
                    </StackPanel>

                    <Button x:Name="HelpBtnQuickLinks" x:FieldModifier="internal" Grid.Column="3"
                            Style="{StaticResource HelpButtonStyle}" Tag="QuickLinks"
                            VerticalAlignment="Center" Margin="8,0,0,0"/>
                </Grid>
            </Border>
        </Grid>
    
        <!-- ============================================================ -->
        <!-- QUICK TOGGLES ROW - full width, under both the feature grid  -->
        <!-- AND the right half. (Historic x:Name VelvetHelperButtonRow.) -->
        <!--                                                               -->
        <!-- Phase 3 added the fifth pill: "System" used to be a mosaic    -->
        <!-- tile, but it is not a feature - it is the display/video       -->
        <!-- switches - so it traded its tile for Brain Drain and became a -->
        <!-- pill. Same handler, same popup, new caller. Keep this row at  -->
        <!-- Height=30: it sits between the mosaic and the marquee inside  -->
        <!-- the fixed 1489x901 canvas, and every unit it grows comes off  -->
        <!-- the mosaic's star row (WPF clips silently - #860).            -->
        <!-- ============================================================ -->
        <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" x:Name="VelvetHelperButtonRow"
              Height="30" Margin="5,4,5,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!-- Webcam card — surfaced from the Lab for discoverability.
                 Distinct Secondary (cyan) accent + tinted fill so it stands
                 out from the two neutral cards beside it. -->
            <Button Grid.Column="0" x:Name="VelvetBtnWebcam"
                    Click="VelvetBtnWebcam_Click"
                    Cursor="Hand" FontSize="12" FontWeight="Bold">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b"
                                Background="{DynamicResource AccentTintedBgBrush}"
                                BorderBrush="{DynamicResource SecondaryBrush}"
                                BorderThickness="1.5"
                                CornerRadius="14">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Image Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,8,0"
                                       Source="{Binding Source='📷', Converter={StaticResource EmojiToImageSource}}"/>
                                <TextBlock Text="Webcam &amp; Mic" Foreground="White" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource SecondaryBrush}"/>
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource TransparentPinkBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
    
            <!-- System — the display / video switches (multi-monitor, GPU decode, blurred
                 video background, browser video engine) plus the read-only jumps Phase 2 added
                 into Settings. It used to be the ⚙ mosaic tile; the tile went to Brain Drain
                 and the entry point came here. Phase 8 deleted the Collapsed tile, so this pill
                 is now the ONLY route to MainWindow.CardSystem_Click - the popup, its title, and
                 its NotifyFeatureOpened("System") bark are unchanged, but this button is the last
                 thing holding them: never retire it without moving the handler somewhere else. -->
            <Button Grid.Column="2" x:Name="VelvetBtnSystem"
                    Click="VelvetBtnSystem_Click"
                    Cursor="Hand" FontSize="12" FontWeight="Bold">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b"
                                Background="{DynamicResource ElevatedSurfaceBrush}"
                                BorderBrush="{DynamicResource GlassBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="14">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <!-- No separate cog image and no x:Name: section_system already
                                     starts with the gear glyph (same idiom as the Scheduler pill
                                     below), and a name inside a ControlTemplate belongs to the
                                     template's namescope, not the UserControl's, so it would
                                     generate no field and reach nothing. -->
                                <helpers:EmojiTextBlock Text="{loc:Str section_system}" Foreground="White" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource PinkBrush}"/>
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource TransparentPinkBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Button Grid.Column="8" x:Name="VelvetBtnAppInfo"
                    Click="VelvetBtnAppInfo_Click"
                    Cursor="Hand" FontSize="12" FontWeight="Bold">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b"
                                Background="{DynamicResource ElevatedSurfaceBrush}"
                                BorderBrush="{DynamicResource GlassBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="14">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="ℹ" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"
                                           Foreground="{DynamicResource PinkBrush}"/>
                                <TextBlock Text="{loc:Str label_app_info}" Foreground="White" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource PinkBrush}"/>
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource TransparentPinkBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
    
            <!-- Combined Scheduler + Intensity Ramp card. Label is two live-localized
                 strings joined by " + " so both halves stay translated.
                 Phase 3: this no longer opens a second popup around the old
                 SchedulerRampFeatureControl wrapper - Phase 4 gave both panels rack entries
                 ("scheduler" / "ramp") and Phase 8 deleted the wrapper, so the pill navigates
                 to the rack instead. One surface,
                 nothing lost: the rack fires the same single "SchedulerRamp"
                 NotifyFeatureOpened key the popup did (StudioTabView.xaml.cs:229-230). -->
            <Button Grid.Column="4" x:Name="VelvetBtnSchedulerRamp"
                    Click="VelvetBtnSchedulerRamp_Click"
                    Cursor="Hand" FontSize="12" FontWeight="Bold">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b"
                                Background="{DynamicResource ElevatedSurfaceBrush}"
                                BorderBrush="{DynamicResource GlassBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="14">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <!-- No separate 📅 image: section_scheduler already starts with the
                                     calendar emoji (matches the inline ⚡ on Intensity Ramp). -->
                                <helpers:EmojiTextBlock Text="{loc:Str section_scheduler}" Foreground="White" VerticalAlignment="Center"/>
                                <TextBlock Text=" + " Foreground="White" VerticalAlignment="Center"/>
                                <helpers:EmojiTextBlock Text="{loc:Str section_intensity_ramp}" Foreground="White" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource PinkBrush}"/>
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource TransparentPinkBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- CCP Catalogue card — opens the web catalogue to browse/share
                 community presets and sessions. Pink-tinted to flag it as the
                 community/social action of the row. -->
            <Button Grid.Column="6" x:Name="VelvetBtnCatalogue"
                    Click="VelvetBtnCatalogue_Click"
                    Cursor="Hand" FontSize="12" FontWeight="Bold"
                    ToolTip="Opens app.cclabs.app/catalogue in your browser">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b"
                                Background="{DynamicResource TransparentPinkBrush}"
                                BorderBrush="{DynamicResource PinkBrush}"
                                BorderThickness="1.5"
                                CornerRadius="14">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Image Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,8,0"
                                       Source="{Binding Source='📚', Converter={StaticResource EmojiToImageSource}}"/>
                                <TextBlock Text="CCP Catalogue" Foreground="White" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource SecondaryBrush}"/>
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource AccentTintedBgBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

        <!-- Scrolling Marquee Banner - row 3, spans all columns -->
        <Border x:Name="MarqueeBanner" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3"
                Background="#1A0A1A" BorderBrush="{DynamicResource DarkPinkBrush}" BorderThickness="2"
                CornerRadius="8" Height="48" Margin="5,5,5,0" ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect Color="{DynamicResource DarkPink}" BlurRadius="15" ShadowDepth="0" Opacity="0.5"/>
            </Border.Effect>
            <!-- Chrome FX edge fade (PR-1, fixed in PR-5). The mask CANNOT live on MarqueeCanvas:
                 a relative-mapped OpacityMask is stretched over the masked visual's own bounds,
                 and the canvas's bounds are its overflowing child - a marquee string thousands of
                 pixels wide. A 6% fade of THAT is hundreds of pixels off-screen, which is exactly
                 why the fade was invisible in the shipped build.

                 Two changes fix it for good: the mask moves onto this wrapper, whose only child
                 clips itself (so the wrapper's bounds really are the 48px viewport), and the brush
                 is rebuilt in code with MappingMode=Absolute (MarqueeFadeHost_SizeChanged) so the
                 fade is a genuine ~40px at each end regardless of any bounding box at all. -->
            <Grid x:Name="MarqueeFadeHost" ClipToBounds="True"
                  SizeChanged="MarqueeFadeHost_SizeChanged">
            <Canvas x:Name="MarqueeCanvas" x:FieldModifier="internal" ClipToBounds="True">
                <TextBlock x:Name="MarqueeText" x:FieldModifier="internal"
                           Text="{loc:Str label_v5_2_1_is_out_thanks_to_all_the_100_patreons}"
                           FontFamily="Impact" FontSize="28" FontWeight="Bold"
                           Foreground="{DynamicResource PinkBrush}" Canvas.Top="8">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="{DynamicResource DarkPink}" BlurRadius="8" ShadowDepth="0" Opacity="0.8"/>
                    </TextBlock.Effect>
                    <TextBlock.RenderTransform>
                        <TranslateTransform x:Name="MarqueeTransform"/>
                    </TextBlock.RenderTransform>
                </TextBlock>
            </Canvas>
            </Grid>
        </Border>
        </Grid>
</UserControl>
