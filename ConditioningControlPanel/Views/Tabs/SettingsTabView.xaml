                                          Checked="ChkVideoEnabled_Changed" Unchecked="ChkVideoEnabled_Changed"/>
                                <TextBlock Style="{StaticResource SettingLabel}" Text="{loc:Str btn_enable}" Margin="6,0,15,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" ToolTip="{loc:Str tooltip_strict_mode_videos_cannot_be_skipped_must_wat}">
                                <CheckBox x:Name="ChkStrictLock" x:FieldModifier="internal" Style="{StaticResource ToggleStyle}" Checked="ChkStrictLock_Changed" Unchecked="ChkStrictLock_Changed"/>
                                <helpers:EmojiTextBlock Style="{StaticResource SettingLabel}" Text="{loc:Str setting_strict}" Foreground="#FFB347" Margin="6,0,15,0"/>
                            </StackPanel>
                            <Slider Grid.Column="2" x:Name="SliderPerHour" x:FieldModifier="internal" Minimum="1" Maximum="20" Value="2" ValueChanged="SliderPerHour_Changed"
                                    ToolTip="{loc:Str tooltip_videos_per_hour}"/>
                            <TextBlock x:Name="TxtPerHour" x:FieldModifier="internal" Grid.Column="3" Style="{StaticResource ValueLabel}" Text="2" HorizontalAlignment="Right"/>
                        </Grid>
    
                        <!-- Mini-Game Sub-Section -->
                        <Border Background="{DynamicResource SurfaceBgBrush}" CornerRadius="6" Padding="10,7" Margin="0,7,0,0">
                            <StackPanel>
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <helpers:EmojiTextBlock Text="{loc:Str label_mini_game}" Foreground="{DynamicResource PinkBrush}" FontSize="12" FontWeight="Bold"/>
                                        <Button x:Name="HelpBtnMiniGame" x:FieldModifier="internal" Style="{StaticResource HelpButtonStyle}" Tag="MiniGame"/>
                                    </StackPanel>
                                    <CheckBox x:Name="ChkMiniGameEnabled" x:FieldModifier="internal" Style="{StaticResource ToggleStyle}" HorizontalAlignment="Right"
                                              Checked="ChkMiniGameEnabled_Changed" Unchecked="ChkMiniGameEnabled_Changed"
                                              ToolTip="{loc:Str tooltip_enable_attention_check_targets}"/>
                                </Grid>
    
                                <!-- Targets / Duration / Size -->
                                <Grid Margin="0,5,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,6,0" ToolTip="{loc:Str tooltip_number_of_targets_to_click_per_video}">
                                        <Grid>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{loc:Str label_targets}" FontSize="11" Foreground="#A0A0B0"/>
                                                <CheckBox x:Name="ChkRandomizeTargets" x:FieldModifier="internal" Margin="6,0,0,0" VerticalAlignment="Center"
                                                          ToolTip="{loc:Str tooltip_randomize_target_count_1_to_max}"
                                                          Checked="ChkRandomizeTargets_Changed" Unchecked="ChkRandomizeTargets_Changed">
                                                    <Image Width="11" Height="11" ToolTip="{loc:Str tooltip_randomize}"
                                                           Source="{Binding Source='🎲', Converter={StaticResource EmojiToImageSource}}"/>
                                                </CheckBox>
                                            </StackPanel>
                                            <TextBlock x:Name="TxtTargets" x:FieldModifier="internal" Text="3" FontSize="11" Foreground="{DynamicResource TextLightBrush}" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Slider x:Name="SliderTargets" x:FieldModifier="internal" Minimum="1" Maximum="10" Value="3" Margin="0,3,0,0" ValueChanged="SliderTargets_Changed"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="3,0" ToolTip="{loc:Str tooltip_seconds_each_target_stays_visible}">
                                        <Grid><TextBlock Text="{loc:Str setting_duration}" FontSize="11" Foreground="#A0A0B0"/><TextBlock x:Name="TxtDuration" x:FieldModifier="internal" Text="5" FontSize="11" Foreground="{DynamicResource TextLightBrush}" HorizontalAlignment="Right"/></Grid>
                                        <Slider x:Name="SliderDuration" x:FieldModifier="internal" Minimum="1" Maximum="15" Value="5" Margin="0,3,0,0" ValueChanged="SliderDuration_Changed"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="6,0,0,0" ToolTip="{loc:Str tooltip_target_button_size_in_pixels}">
                                        <Grid><TextBlock Text="{loc:Str setting_size}" FontSize="11" Foreground="#A0A0B0"/><TextBlock x:Name="TxtTargetSize" x:FieldModifier="internal" Text="70" FontSize="11" Foreground="{DynamicResource TextLightBrush}" HorizontalAlignment="Right"/></Grid>
                                        <Slider x:Name="SliderTargetSize" x:FieldModifier="internal" Minimum="30" Maximum="150" Value="70" Margin="0,3,0,0" ValueChanged="SliderTargetSize_Changed"/>
                                    </StackPanel>
                                </Grid>
    
                                <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                    <Button Content="{loc:Str btn_phrases}" Style="{StaticResource PinkButton}" Padding="8,5" Click="BtnManageAttention_Click"
                                            ToolTip="{loc:Str tooltip_edit_attention_check_phrases}"/>
                                    <Button Content="{loc:Str btn_style}" Style="{StaticResource OutlineButton}" Margin="8,0,0,0" Padding="8,5" Click="BtnAttentionStyle_Click"
                                            ToolTip="{loc:Str tooltip_customize_target_appearance_colors_border_fon}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
    
                <!-- Subliminals Section -->
                <Border x:Name="SubliminalSection" CornerRadius="12" Padding="10,7" Margin="0,0,0,6"
                        Background="{DynamicResource ElevatedSurfaceBrush}"
                        BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <Grid>
                            <helpers:EmojiTextBlock x:Name="TxtFeatureSubliminal" x:FieldModifier="internal" Style="{StaticResource SectionHeader}" Text="{loc:Str section_subliminals_2}"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="HelpBtnSubliminals" x:FieldModifier="internal" Style="{StaticResource HelpButtonStyle}" Tag="Subliminals" Margin="0,0,8,0"/>
                                <Button Content="📝" Style="{StaticResource OutlineButton}" Padding="6,3" Click="BtnManageMessages_Click" Margin="0,0,4,0"
                                        ToolTip="{loc:Str tooltip_edit_subliminal_messages}"/>
                                <Button Content="⚙" Style="{StaticResource OutlineButton}" Padding="6,3" Click="BtnSubliminalSettings_Click" Margin="0,0,8,0"
                                        ToolTip="{loc:Str tooltip_advanced_subliminal_visual_settings}"/>
                                <CheckBox x:Name="ChkSubliminalEnabled" x:FieldModifier="internal" Style="{StaticResource ToggleStyle}"
                                          Checked="ChkSubliminalEnabled_Changed" Unchecked="ChkSubliminalEnabled_Changed"
                                          ToolTip="{loc:Str tooltip_enable_disable_subliminal_messages}"/>
                            </StackPanel>
                        </Grid>
    
                        <!-- Per Min / Frames / Opacity in 3 columns -->
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,6,0" ToolTip="{loc:Str tooltip_messages_shown_per_minute}">
                                <Grid><TextBlock Text="{loc:Str label_per_min}" FontSize="11" Foreground="#A0A0B0"/><TextBlock x:Name="TxtSubPerMin" x:FieldModifier="internal" Text="5" FontSize="11" Foreground="{DynamicResource TextLightBrush}" HorizontalAlignment="Right"/></Grid>
                                <Slider x:Name="SliderSubPerMin" x:FieldModifier="internal" Minimum="1" Maximum="30" Value="5" Margin="0,3,0,0" ValueChanged="SliderSubPerMin_Changed"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="3,0" ToolTip="{loc:Str tooltip_display_duration_in_frames_lower_faster_flash}">
                                <Grid><TextBlock Text="{loc:Str label_frames}" FontSize="11" Foreground="#A0A0B0"/><TextBlock x:Name="TxtFrames" x:FieldModifier="internal" Text="2" FontSize="11" Foreground="{DynamicResource TextLightBrush}" HorizontalAlignment="Right"/></Grid>
                                <Slider x:Name="SliderFrames" x:FieldModifier="internal" Minimum="1" Maximum="10" Value="2" Margin="0,3,0,0" ValueChanged="SliderFrames_Changed"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="6,0,0,0" ToolTip="{loc:Str tooltip_text_visibility_lower_more_subtle}">
                                <Grid><TextBlock Text="{loc:Str setting_opacity}" FontSize="11" Foreground="#A0A0B0"/><TextBlock x:Name="TxtSubOpacity" x:FieldModifier="internal" Text="80%" FontSize="11" Foreground="{DynamicResource TextLightBrush}" HorizontalAlignment="Right"/></Grid>
                                <Slider x:Name="SliderSubOpacity" x:FieldModifier="internal" Minimum="10" Maximum="100" Value="80" Margin="0,3,0,0" ValueChanged="SliderSubOpacity_Changed"/>
                            </StackPanel>
                        </Grid>
    
                        <!-- Audio Whispers -->
                        <Grid Margin="0,6,0,0" ToolTip="{loc:Str tooltip_play_whispered_audio_when_subliminal_messages}">
                            <StackPanel Orientation="Horizontal">
                                <CheckBox x:Name="ChkAudioWhispers" x:FieldModifier="internal" Style="{StaticResource ToggleStyle}"
                                          Checked="ChkAudioWhispers_Changed" Unchecked="ChkAudioWhispers_Changed"/>
                                <helpers:EmojiTextBlock x:Name="TxtFeatureWhispers" x:FieldModifier="internal" Style="{StaticResource SettingLabel}" Text="{loc:Str setting_audio_whispers}" Margin="6,0,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Slider x:Name="SliderWhisperVol" x:FieldModifier="internal" Minimum="0" Maximum="100" Value="50" Width="100" ValueChanged="SliderWhisperVol_Changed"/>
                                <TextBlock x:Name="TxtWhisperVol" x:FieldModifier="internal" Style="{StaticResource ValueLabel}" Text="50%" Width="40"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
    
                <!-- System Section -->
                <Border x:Name="SystemSection" CornerRadius="12" Padding="10,7" Margin="0,0,0,6"
                        Background="{DynamicResource ElevatedSurfaceBrush}"
                        BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <Grid>
                            <helpers:EmojiTextBlock Style="{StaticResource SectionHeader}" Text="{loc:Str section_system}"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="HelpBtnSystem" x:FieldModifier="internal" Style="{StaticResource HelpButtonStyle}" Tag="System" Margin="0,0,8,0"/>
                                <Button Content="📁" Style="{StaticResource OutlineButton}"
                                        Padding="6,3" Click="BtnPickAssetsFolder_Click" Margin="0,0,4,0"
                                        ToolTip="{loc:Str tooltip_set_custom_assets_folder}"/>
                                <Button Content="{loc:Str btn_assets}" Style="{StaticResource OutlineButton}"
                                        Padding="8,3" Click="BtnOpenAssetsFolder_Click"
                                        ToolTip="{loc:Str tooltip_open_assets_folder_images_videos_sounds}"/>
                            </StackPanel>
                        </Grid>
    
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,3"
                                        ToolTip="{loc:Str tooltip_show_content_on_all_connected_monitors_2_3_or}">
                                <CheckBox x:Name="ChkDualMon" x:FieldModifier="internal" Style="{StaticResource ToggleStyle}"
                                          Checked="ChkDualMon_Changed" Unchecked="ChkDualMon_Changed"/>
                                <TextBlock Style="{StaticResource SettingLabel}" Text="{loc:Str setting_multi_mon}" Margin="6,0,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,3"
                                        ToolTip="{loc:Str tooltip_launch_automatically_when_windows_starts}">
                                <CheckBox x:Name="ChkWinStart" x:FieldModifier="internal" Style="{StaticResource ToggleStyle}" Click="ChkWinStart_Click"/>
                                <TextBlock Style="{StaticResource SettingLabel}" Text="{loc:Str setting_win_start}" Margin="6,0,0,0"/>
                            </StackPanel>
    
                            <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,3"
                                        ToolTip="{loc:Str tooltip_play_a_mandatory_video_when_app_opens}">
                                <CheckBox x:Name="ChkVidLaunch" x:FieldModifier="internal" Style="{StaticResource ToggleStyle}"/>
                                <TextBlock Style="{StaticResource SettingLabel}" Text="{loc:Str setting_vid_launch}" Margin="6,0,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,3"
                                        ToolTip="{loc:Str tooltip_start_the_engine_automatically_on_launch}">
                                <CheckBox x:Name="ChkAutoRun" x:FieldModifier="internal" Style="{StaticResource ToggleStyle}"/>
                                <TextBlock Style="{StaticResource SettingLabel}" Text="{loc:Str setting_auto_run}" Margin="6,0,0,0"/>
                            </StackPanel>
    
                            <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Margin="0,3"
                                        ToolTip="{loc:Str tooltip_start_minimized_to_system_tray}">
                                <CheckBox x:Name="ChkStartHidden" x:FieldModifier="internal" Style="{StaticResource ToggleStyle}" Click="ChkStartHidden_Click"/>
                                <TextBlock Style="{StaticResource SettingLabel}" Text="{loc:Str setting_start_hidden}" Margin="6,0,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,3"
                                        ToolTip="{loc:Str tooltip_danger_completely_disables_panic_key_you_won}">
                                <CheckBox x:Name="ChkNoPanic" x:FieldModifier="internal" Style="{StaticResource ToggleStyle}" Checked="ChkNoPanic_Changed" Unchecked="ChkNoPanic_Changed"/>
                                <helpers:EmojiTextBlock Style="{StaticResource SettingLabel}" Text="{loc:Str setting_no_panic}" Margin="6,0,0,0" Foreground="#FF6B6B"/>
                            </StackPanel>
    
                            <StackPanel Grid.Row="3" Grid.Column="0" Orientation="Horizontal" Margin="0,3"
                                        ToolTip="{loc:Str tooltip_disable_all_network_features_updates_ai_leade}">
                                <CheckBox x:Name="ChkOfflineMode" x:FieldModifier="internal" Style="{StaticResource ToggleStyle}"
                                          Checked="ChkOfflineMode_Changed" Unchecked="ChkOfflineMode_Changed"/>
                                <TextBlock Style="{StaticResource SettingLabel}" Text="{loc:Str setting_offline_mode}" Margin="6,0,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,3"
                                        ToolTip="Force the lightest rendering mode (smaller decoded images, no glow, cheaper blur). Use if the app stutters when many effects are on screen.">
                                <CheckBox x:Name="ChkPerformanceMode" x:FieldModifier="internal" Style="{StaticResource ToggleStyle}"
                                          Checked="ChkPerformanceMode_Changed" Unchecked="ChkPerformanceMode_Changed"/>
                                <TextBlock Style="{StaticResource SettingLabel}" Text="Performance mode" Margin="6,0,0,0"/>
                            </StackPanel>
    
                            <StackPanel Grid.Row="4" Grid.Column="0" Orientation="Horizontal" Margin="0,3"
                                        ToolTip="Automatically reduce rendering quality only while lots of elements (flashes/bubbles) are on screen, then restore it.">
                                <CheckBox x:Name="ChkAutoPerformance" x:FieldModifier="internal" Style="{StaticResource ToggleStyle}"
                                          Checked="ChkAutoPerformance_Changed" Unchecked="ChkAutoPerformance_Changed"/>
                                <TextBlock Style="{StaticResource SettingLabel}" Text="Auto performance" Margin="6,0,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,3"
                                        ToolTip="Force GPU hardware decoding for mandatory videos. Off by default — mandatory videos software-decode to avoid a white-screen bug on some Windows machines. Only turn this on if you want GPU decode and your videos play fine.">
                                <CheckBox x:Name="ChkVideoHwDecode" x:FieldModifier="internal" Style="{StaticResource ToggleStyle}"
                                          Checked="ChkVideoHwDecode_Changed" Unchecked="ChkVideoHwDecode_Changed"/>
                                <TextBlock Style="{StaticResource SettingLabel}" Text="Force video GPU decode" Margin="6,0,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Row="5" Grid.Column="0" Orientation="Horizontal" Margin="0,3"
                                        ToolTip="Render fullscreen effects (spiral, pink filter, flashes, bubbles...) in one shared overlay window per monitor. Smoother with many effects on screen. Turn off to fall back to the classic one-window-per-effect renderer if overlays misbehave.">
                                <CheckBox x:Name="ChkUnifiedOverlay" x:FieldModifier="internal" Style="{StaticResource ToggleStyle}"
                                          Checked="ChkUnifiedOverlay_Changed" Unchecked="ChkUnifiedOverlay_Changed"/>
                                <TextBlock Style="{StaticResource SettingLabel}" Text="Unified overlay renderer" Margin="6,0,0,0"/>
                            </StackPanel>

                            <!-- Weekly intake pass reminder. Row 5 column 1 was the one free cell in
                                 this grid, so no RowDefinition change was needed. Read at launch by
                                 MainWindow.Marquee.cs:CheckIntakePassNudge; no Changed handler because
                                 nothing needs to happen until the next launch. -->
                            <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="0,3"
                                        ToolTip="{loc:Str tooltip_intake_nudge_enabled}">
                                <CheckBox x:Name="ChkIntakeNudge" x:FieldModifier="internal" Style="{StaticResource ToggleStyle}" IsChecked="True"/>
                                <TextBlock Style="{StaticResource SettingLabel}" Text="{loc:Str label_intake_nudge_enabled}" Margin="6,0,0,0"/>
                            </StackPanel>

                            <!-- Reduced motion. Sits with the other rendering switches because it is
                                 one: Reduced/Off stop every ambient loop and particle field before
                                 they start (Services/MotionFx). Capped to Reduced automatically when
                                 Windows' own "Animation effects" flag is off. -->
                            <StackPanel Grid.Row="6" Grid.Column="0" Orientation="Horizontal" Margin="0,3"
                                        ToolTip="{loc:Str tooltip_motion_level}">
                                <TextBlock Style="{StaticResource SettingLabel}" Text="{loc:Str setting_motion_level}" VerticalAlignment="Center"/>
                                <ComboBox x:Name="CmbMotionLevel" x:FieldModifier="internal" Width="110" Margin="6,0,0,0"
                                          Foreground="Black" Background="White"
                                          ToolTip="{loc:Str tooltip_motion_level}"
                                          SelectionChanged="CmbMotionLevel_SelectionChanged">
                                    <ComboBoxItem Content="{loc:Str label_motion_full}"/>
                                    <ComboBoxItem Content="{loc:Str label_motion_reduced}"/>
                                    <ComboBoxItem Content="{loc:Str label_motion_off}"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
    
                        <!-- Startup Video Selection -->
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0"
                                    ToolTip="{loc:Str tooltip_select_a_specific_video_to_play_on_startup_wh}">
                            <TextBlock Text="{loc:Str label_startup_video}" Foreground="#B0B0B0" FontSize="10" VerticalAlignment="Center" Width="75"/>
                            <TextBlock x:Name="TxtStartupVideo" x:FieldModifier="internal" Text="{loc:Str label_random}" Foreground="{DynamicResource TextLightBrush}" FontSize="10"
                                       VerticalAlignment="Center" Width="90" TextTrimming="CharacterEllipsis"/>
                            <Button Content="📁" Background="#40FFFFFF" Foreground="White" BorderThickness="0"
                                    Padding="5,1" Margin="4,0,0,0" Cursor="Hand" Click="BtnSelectStartupVideo_Click"
                                    ToolTip="{loc:Str tooltip_browse_for_startup_video}"/>
                            <Button Content="✕" Background="#40FF6B6B" Foreground="White" BorderThickness="0"
                                    Padding="5,1" Margin="4,0,0,0" Cursor="Hand" Click="BtnClearStartupVideo_Click"
                                    ToolTip="{loc:Str tooltip_clear_selection_use_random}"/>
                        </StackPanel>
    
                        <!-- Phrase Backup (export/import all editable phrase pools) -->
                        <Grid Margin="0,6,0,0"
                              ToolTip="Save or restore your lock-card phrases, subliminals, mantras and other custom text. Use this to back up your phrases before an update or when moving to a new PC.">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Phrase backup" Foreground="#B0B0B0" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="📤 Export" Style="{StaticResource OutlineButton}" Padding="8,3" Margin="0,0,6,0"
                                        Click="BtnExportPhrases_Click"
                                        ToolTip="Save all your custom phrases to a backup file."/>
                                <Button Content="📥 Import" Style="{StaticResource OutlineButton}" Padding="8,3"
                                        Click="BtnImportPhrases_Click"
                                        ToolTip="Restore custom phrases from a backup file (replaces your current phrases)."/>
                            </StackPanel>
                        </Grid>

                        <!-- Gaming Tip -->
                        <Grid Margin="0,5,0,0">
                            <TextBlock Text="{loc:Str label_use_borderless_windowed_for_overlays}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" VerticalAlignment="Center"
                                       ToolTip="{loc:Str tooltip_exclusive_fullscreen_games_block_overlays_use}"/>
                            <Button x:Name="BtnPanicKey" x:FieldModifier="internal" Content="{loc:Str btn_escape}" Style="{StaticResource OutlineButton}"
                                    HorizontalAlignment="Right" Padding="10,4" Click="BtnPanicKey_Click" ToolTip="{loc:Str tooltip_click_to_change_panic_key}"/>
                        </Grid>
                    </StackPanel>
                </Border>
    
                <!-- Deeper Section -->
                <Border x:Name="DeeperSection" CornerRadius="12" Padding="10,7" Margin="0,0,0,6"
                        Background="{DynamicResource ElevatedSurfaceBrush}"
                        BorderBrush="{DynamicResource DeeperAccentTransparent40Brush}" BorderThickness="1">
                    <StackPanel>
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <Image Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"
                                       Source="{Binding Source='🌊', Converter={StaticResource EmojiToImageSource}}"/>
                                <TextBlock Style="{StaticResource SectionHeader}" Text="{loc:Str section_deeper}"
                                           Foreground="{DynamicResource DeeperAccentBrush}"/>
                            </StackPanel>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0"
                                    ToolTip="{loc:Str tooltip_deeper_enable}">
                            <CheckBox x:Name="ChkEnableDeeper" x:FieldModifier="internal" Style="{StaticResource ToggleStyle}"
                                      Checked="ChkEnableDeeper_Changed" Unchecked="ChkEnableDeeper_Changed"/>
                            <TextBlock Style="{StaticResource SettingLabel}" Text="{loc:Str setting_deeper_enable}" Margin="6,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        </Grid>
        <!-- /LegacyDashboardHost -->
    
        <!-- RIGHT HALF (Browser / Audio / Quick Links) — col 2 (after premium rail + feature grid) -->
        <Grid Grid.Column="2" Grid.Row="1" Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
    
            <!-- Browser Section -->
            <!-- ClipToBounds is a backstop, not the fix: the WebView2 below is a native HWND
                 (an HwndHost), and WPF's layout clip does not reliably clip native children.
                 If this card is ever over-filled again the spill has to stop at the card's own
                 edge instead of painting over the account card and the helper-button row. -->
            <Border Grid.Row="0" CornerRadius="12" Padding="9" Margin="0,0,0,5" ClipToBounds="True"
                    Background="{DynamicResource ElevatedSurfaceBrush}"
                    BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1">
                <!-- Grid, not StackPanel. A StackPanel hands each child its DESIRED height and
                     never shrinks it, so the browser box below (which used to carry a hard
                     Height="340") kept its old size when the Training Programs "Today" banner
                     took ~64 design units out of this column - and the native WebView2 painted
                     straight through the card's bottom edge. With Auto/* the browser box is
                     simply whatever is left after the header: it shrinks when the banner
                     appears, grows back when it goes, and follows window resize / DPI change
                     for free, because layout - not a constant - decides its height. -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <!-- Browser Header - single row with title, tabs, status, webcam toggle, pop out -->
                    <Grid Grid.Row="0" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <helpers:EmojiTextBlock Style="{StaticResource SectionHeader}" Text="{loc:Str section_browser}" Margin="0"/>
                            <Button x:Name="HelpBtnBrowser" x:FieldModifier="internal" Style="{StaticResource HelpButtonStyle}" Tag="Browser"/>
                        </StackPanel>
                        <!-- Site Toggle - inline -->
                        <Border Grid.Column="1" Background="{DynamicResource PanelAccentBrush}" CornerRadius="10" Padding="2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="RbBambiCloud" x:FieldModifier="internal" Content="{loc:Str btn_bambicloud}" GroupName="BrowserSite"
                                             IsChecked="True" Checked="BrowserSiteToggle_Changed"
                                             Foreground="{DynamicResource TextLightBrush}" FontSize="10" Cursor="Hand" Margin="2,1">
                                    <RadioButton.Template>
                                        <ControlTemplate TargetType="RadioButton">
                                            <Border x:Name="border" Background="Transparent" CornerRadius="8" Padding="8,3">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="{DynamicResource PinkBrush}"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#353565"/>
                                            </Trigger>
                                            <MultiTrigger>
                                                <MultiTrigger.Conditions>
                                                    <Condition Property="IsChecked" Value="True"/>
                                                    <Condition Property="IsMouseOver" Value="True"/>
                                                </MultiTrigger.Conditions>
                                                <Setter TargetName="border" Property="Background" Value="{DynamicResource PinkButtonHoveredBrush}"/>
                                            </MultiTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </RadioButton.Template>
                            </RadioButton>
                            <RadioButton x:Name="RbHypnoTube" x:FieldModifier="internal" Content="{loc:Str btn_hypnotube}" GroupName="BrowserSite"
                                         Checked="BrowserSiteToggle_Changed"
                                         Foreground="{DynamicResource TextLightBrush}" FontSize="10" Cursor="Hand" Margin="2,1">
                                <RadioButton.Template>
                                    <ControlTemplate TargetType="RadioButton">
                                        <Border x:Name="border" Background="Transparent" CornerRadius="8" Padding="8,3">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="{DynamicResource PinkBrush}"/>
                                                <Setter Property="Foreground" Value="White"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#353565"/>
                                            </Trigger>
                                            <MultiTrigger>
                                                <MultiTrigger.Conditions>
                                                    <Condition Property="IsChecked" Value="True"/>
                                                    <Condition Property="IsMouseOver" Value="True"/>
                                                </MultiTrigger.Conditions>
                                                <Setter TargetName="border" Property="Background" Value="{DynamicResource PinkButtonHoveredBrush}"/>
                                            </MultiTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </RadioButton.Template>
                            </RadioButton>
                            </StackPanel>
                        </Border>
                        <!-- Reload / Home button - sits just right of the site toggle.
                             Reloads the current site's homepage; gives a way out of a
                             stuck/blank page (e.g. after a remote video is stopped), since
                             re-clicking an already-selected site radio won't reload. -->
                        <Button Grid.Column="2" x:Name="BtnReloadBrowser"
                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                Click="BtnReloadBrowser_Click"
                                ToolTip="{loc:Str tooltip_reload_browser}"
                                FontSize="11" Padding="6,3" Margin="8,0,0,0">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#33FF69B4"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource PinkBrush}"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#55FF69B4"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                            <helpers:EmojiTextBlock Text="🔄"/>
                        </Button>
                        <!-- Status indicator -->
                        <TextBlock Grid.Column="3" x:Name="TxtBrowserStatus" x:FieldModifier="internal" Text="{loc:Str label_loading}"
                                   Foreground="{DynamicResource PinkBrush}" FontSize="10"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <!-- Deeper auto-bind badge (Phase 9). Shows when an enhancement is active for the current page. -->
                        <Border Grid.Column="3" x:Name="DeeperBrowserBadge" x:FieldModifier="internal" Visibility="Collapsed"
                                Background="{DynamicResource DeeperAccentTransparent20Brush}"
                                BorderBrush="{DynamicResource DeeperAccentBrush}" BorderThickness="1"
                                CornerRadius="3" Padding="6,1" Margin="0,0,8,0"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                ToolTip="{Binding ElementName=DeeperBrowserBadge, Path=Tag}">
                            <TextBlock x:Name="TxtDeeperBrowserBadge" x:FieldModifier="internal"
                                       Text="🌊 Deeper"
                                       Foreground="{DynamicResource DeeperAccentBrush}"
                                       FontSize="9" FontWeight="SemiBold"/>
                        </Border>
                        <!-- Webcam Tracking toggle - inline, sits between status badge and pop-out.
                             Off: "📷 Webcam"  On: "📷 Webcam On" (label updated in code-behind
                             from OnTrackingStateChanged). Click runs the consent → calibrate →
                             start flow if needed; second click stops tracking. -->
                        <Button Grid.Column="4" x:Name="BtnWebcamTracking" x:FieldModifier="internal"
                                Click="BtnWebcamTracking_Click"
                                ToolTip="{loc:Str tooltip_browser_webcam_tracking_off}"
                                FontSize="9" Padding="6,3" Margin="0,0,6,0" VerticalAlignment="Center">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#33FF69B4"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource PinkBrush}"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#55FF69B4"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                            <helpers:EmojiTextBlock x:Name="TxtWebcamTracking" x:FieldModifier="internal" Text="{loc:Str btn_browser_webcam_tracking_off}"/>
                        </Button>
                        <!-- Mute browser audio toggle (BambiCloud / HypnoTube video) -->
                        <Button Grid.Column="5" x:Name="BtnMuteBrowser" x:FieldModifier="internal"
                                Click="BtnMuteBrowser_Click" Cursor="Hand"
                                ToolTip="Mute / unmute browser audio (BambiCloud / HypnoTube)"
                                Background="Transparent" BorderThickness="0" Padding="5,2" Margin="4,0,0,0"
                                VerticalAlignment="Center">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#55FF69B4"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <helpers:EmojiTextBlock x:Name="TxtBrowserMute" x:FieldModifier="internal" Text="🔊" FontSize="13"/>
                        </Button>
                        <!-- Pop Out button -->
                        <Button Grid.Column="6" x:Name="BtnPopOutBrowser" x:FieldModifier="internal" Content="{loc:Str btn_pop_out}"
                                Click="BtnPopOutBrowser_Click"
                                ToolTip="{loc:Str tooltip_pop_out_browser_to_resizable_window}"
                                FontSize="9" Padding="6,3" VerticalAlignment="Center">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="{DynamicResource PinkBrush}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource PinkButtonHoveredBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter Property="Background" Value="#E05A9E"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
    
                    <!-- Browser Container. No fixed Height on purpose - see the Grid note above.
                         It fills the star row, so the WebView2's layout slot (and therefore its
                         native window) is always inside this card. -->
                    <Border Grid.Row="1" Background="{DynamicResource SurfaceBgBrush}" CornerRadius="6" ClipToBounds="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
    
                            <!-- Deeper "Enhance if possible" toggle (always visible) -->
                            <Border x:Name="BrowserEnhanceToolbar" Grid.Row="0"
                                    Background="{DynamicResource PanelBgBrush}" Padding="8,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox x:Name="ToggleEnhanceIfPossible" x:FieldModifier="internal" Grid.Column="0"
                                              Content="{loc:Str browser_enhance_label}"
                                              Foreground="{DynamicResource TextLightBrush}" FontSize="11"
                                              VerticalAlignment="Center" Cursor="Hand"
                                              Checked="ToggleEnhanceIfPossible_Changed"
                                              Unchecked="ToggleEnhanceIfPossible_Changed"
                                              ToolTip="{loc:Str browser_enhance_tooltip}"/>
                                    <TextBlock x:Name="TxtEnhanceMatchStatus" x:FieldModifier="internal" Grid.Column="1"
                                               Text="{loc:Str browser_enhance_match_none}"
                                               Foreground="{DynamicResource TextMutedBrush}" FontSize="10"
                                               VerticalAlignment="Center"
                                               Margin="12,0,0,0" TextTrimming="CharacterEllipsis"/>
                                    <!-- User override: reveal the BambiCloud site toggle even on mods
                                         whose manifest hides it (issue #596). -->
                                    <CheckBox x:Name="ChkForceShowBambiCloud" x:FieldModifier="internal" Grid.Column="2"
                                              Content="{loc:Str browser_show_bambicloud_label}"
                                              Foreground="{DynamicResource TextMutedBrush}" FontSize="10"
                                              VerticalAlignment="Center" Cursor="Hand" Margin="12,0,0,0"
                                              Checked="ChkForceShowBambiCloud_Changed"
                                              Unchecked="ChkForceShowBambiCloud_Changed"
                                              ToolTip="{loc:Str browser_show_bambicloud_tooltip}"/>
                                </Grid>
                            </Border>
    
                            <!-- Audio Sync Controls (shown when audio sync enabled) -->
                            <Border x:Name="AudioSyncLatencyPanel" x:FieldModifier="internal" Grid.Row="1" Background="{DynamicResource PanelBgBrush}" Padding="6,3" Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
    
                                    <!-- Delay Slider (left half) -->
                                    <Grid Grid.Column="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="40"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{loc:Str label_delay}" Foreground="#AAAAAA" FontSize="9" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <Slider x:Name="SliderAudioSyncLatency" x:FieldModifier="internal" Grid.Column="1" Minimum="-600" Maximum="600" Value="0"
                                                VerticalAlignment="Center" ValueChanged="SliderAudioSyncLatency_Changed"
                                                ToolTip="{loc:Str tooltip_adjust_haptic_timing_positive_earlier_negativ}"/>
                                        <TextBlock x:Name="TxtAudioSyncLatency" x:FieldModifier="internal" Grid.Column="2" Text="{loc:Str label_0ms}" Foreground="{DynamicResource PinkBrush}" FontSize="9"
                                                   VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    </Grid>
    
                                    <!-- Intensity Slider (right half) -->
                                    <Grid Grid.Column="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="32"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{loc:Str label_power}" Foreground="#AAAAAA" FontSize="9" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <Slider x:Name="SliderAudioSyncIntensity" x:FieldModifier="internal" Grid.Column="1" Minimum="0" Maximum="100" Value="100"
                                                VerticalAlignment="Center" ValueChanged="SliderAudioSyncIntensity_Changed"
                                                ToolTip="{loc:Str tooltip_live_intensity_control_reduce_if_vibration_is}"/>
                                        <TextBlock x:Name="TxtAudioSyncIntensity" x:FieldModifier="internal" Grid.Column="2" Text="100%" Foreground="{DynamicResource PinkBrush}" FontSize="9"
                                                   VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    </Grid>
                                </Grid>
                            </Border>
    
                            <Grid x:Name="BrowserContainer" x:FieldModifier="internal" Grid.Row="2">
                                <!-- WebView2 will be added here programmatically -->
                                <TextBlock x:Name="BrowserLoadingText" x:FieldModifier="internal"
                                           Text="{loc:Str label_click_to_load_browser}"
                                           Foreground="{DynamicResource TextMutedBrush}" FontSize="12"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Cursor="Hand"
                                           MouseLeftButtonDown="BrowserLoadingText_Click"/>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
    
            <!-- Audio Section + Quick Actions -->
            <Grid Grid.Row="1" Margin="0,5,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
    
                <!-- Audio Section (left half) -->
                <Border x:Name="AudioSection" Grid.Column="0" CornerRadius="12" Padding="9" Margin="0,0,0,6"
                        Background="{DynamicResource ElevatedSurfaceBrush}"
                        BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" VerticalAlignment="Stretch">
                    <StackPanel>
                        <Grid>
                            <helpers:EmojiTextBlock Style="{StaticResource SectionHeader}" Text="{loc:Str section_audio}" FontSize="12"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button x:Name="HelpBtnAudio" x:FieldModifier="internal" Style="{StaticResource HelpButtonStyle}" Tag="Audio" Margin="0,0,8,0"/>
                                <!-- Expand/collapse the advanced audio options -->
                                <ToggleButton x:Name="BtnAudioAdvanced" x:FieldModifier="internal"
                                              ToolTip="Show advanced audio options (video &amp; duck volume, output device, ducking)"
                                              Cursor="Hand" VerticalAlignment="Center">
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ToggleButton">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="6,1">
                                                            <TextBlock x:Name="arrow" Text="&#x25BE;" FontSize="13"
                                                                       Foreground="{DynamicResource PinkBrush}"
                                                                       RenderTransformOrigin="0.5,0.5"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsChecked" Value="True">
                                                                <Setter TargetName="arrow" Property="RenderTransform">
                                                                    <Setter.Value>
                                                                        <RotateTransform Angle="180"/>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Trigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="arrow" Property="Foreground" Value="White"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ToggleButton.Style>
                                </ToggleButton>
                            </StackPanel>
                        </Grid>

                        <!-- Master Volume (always visible) -->
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="45"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="32"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource SettingLabel}" Text="{loc:Str setting_master}" FontSize="10"
                                       ToolTip="{loc:Str tooltip_master_volume_for_all_audio}"/>
                            <Slider Grid.Column="1" x:Name="SliderMaster" x:FieldModifier="internal" Minimum="0" Maximum="100" Value="50"
                                    Margin="4,0" ValueChanged="SliderMaster_Changed"
                                    ToolTip="{loc:Str tooltip_overall_audio_volume_level}"/>
                            <TextBlock x:Name="TxtMaster" x:FieldModifier="internal" Grid.Column="2" Style="{StaticResource ValueLabel}" Text="50%" FontSize="10"/>
                        </Grid>

                        <!-- Advanced audio options (collapsed by default, toggled by the down arrow) -->
                        <StackPanel Visibility="{Binding IsChecked, ElementName=BtnAudioAdvanced, Converter={StaticResource BoolToVisibility}}">

                        <!-- Auto-duck toggle -->
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:Str label_duck}" Style="{StaticResource SettingLabel}" FontSize="10" VerticalAlignment="Center"
                                       ToolTip="{loc:Str tooltip_automatically_reduce_other_app_volumes_during}"/>
                            <CheckBox Grid.Column="1" x:Name="ChkAudioDuck" x:FieldModifier="internal" Style="{StaticResource ToggleStyle}"
                                      IsChecked="True"
                                      Checked="ChkAudioDuck_Changed" Unchecked="ChkAudioDuck_Changed"
                                      ToolTip="{loc:Str tooltip_automatically_reduce_other_app_volumes_during}"/>
                        </Grid>

                        <!-- Video Volume -->
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="45"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="32"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource SettingLabel}" Text="{loc:Str setting_video}" FontSize="10"
                                       ToolTip="{loc:Str tooltip_volume_for_mandatory_videos}"/>
                            <Slider Grid.Column="1" x:Name="SliderVideoVolume" x:FieldModifier="internal" Minimum="0" Maximum="100" Value="50"
                                    Margin="4,0" ValueChanged="SliderVideoVolume_Changed"
                                    ToolTip="{loc:Str tooltip_separate_volume_control_for_videos}"/>
                            <TextBlock x:Name="TxtVideoVolume" x:FieldModifier="internal" Grid.Column="2" Style="{StaticResource ValueLabel}" Text="50%" FontSize="10"/>
                        </Grid>
    
                        <!-- Duck % -->
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="45"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="32"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource SettingLabel}" Text="{loc:Str label_duck}" FontSize="10"
                                       ToolTip="{loc:Str tooltip_how_much_to_reduce_other_audio}"/>
                            <Slider Grid.Column="1" x:Name="SliderDuck" x:FieldModifier="internal" Minimum="0" Maximum="100" Value="80"
                                    Margin="4,0" ValueChanged="SliderDuck_Changed"
                                    ToolTip="{loc:Str tooltip_ducking_percentage_80_reduce_other_audio_to_2}"/>
                            <TextBlock x:Name="TxtDuck" x:FieldModifier="internal" Grid.Column="2" Style="{StaticResource ValueLabel}" Text="80%" FontSize="10"/>
                        </Grid>
    
                        <!-- Audio Output device picker — route CCP audio to a chosen device
                             (e.g. private headset) so streamers can use the program without
                             their viewers hearing the audio on the system default endpoint. -->
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="45"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource SettingLabel}" Text="{loc:Str setting_output}" FontSize="10"
                                       ToolTip="{loc:Str tooltip_audio_output_device}"/>
                            <ComboBox Grid.Column="1" x:Name="CmbAudioOutputDevice" x:FieldModifier="internal"
                                      Margin="4,0,4,0" Foreground="Black" Background="White"
                                      ToolTip="{loc:Str tooltip_audio_output_device}"
                                      SelectionChanged="CmbAudioOutputDevice_SelectionChanged"/>
                            <Button Grid.Column="2" x:Name="BtnAudioOutputRefresh" Content="↻"
                                    Click="BtnAudioOutputRefresh_Click"
                                    ToolTip="Re-scan playback devices."
                                    Padding="8,2" Background="#33FF69B4" Foreground="White" FontSize="10"
                                    BorderBrush="{DynamicResource PinkBrush}" BorderThickness="1" Cursor="Hand"/>
                        </Grid>
    
                        <!-- Don't-duck-browser toggle + Audio Test on the same row -->
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0"
                                      x:Name="ChkExcludeBambiCloudDucking" x:FieldModifier="internal"
                                      VerticalAlignment="Center"
                                      Content="{loc:Str setting_don_t_duck_browser}"
                                      IsChecked="True"
                                      Checked="ChkExcludeBambiCloudDucking_Changed"
                                      Unchecked="ChkExcludeBambiCloudDucking_Changed"
                                      ToolTip="{loc:Str tooltip_when_enabled_audio_from_the_integrated_bambic}"
                                      Foreground="{DynamicResource PinkBrush}" FontSize="9"/>
                            <Button Grid.Column="1"
                                    x:Name="BtnTestAudio" Content="Test Audio"
                                    Click="BtnTestAudio_Click"
                                    ToolTip="Play a test sound and show audio diagnostics. Use this if audio isn't working."
                                    Background="#33FF69B4" Foreground="White" FontSize="9" Padding="8,3"
                                    BorderBrush="{DynamicResource PinkBrush}" BorderThickness="1" Cursor="Hand"
                                    VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Audio Layers (#659) — looping background tracks mixed through one device -->
                        <Button x:Name="BtnAudioLayers" Content="{loc:Str btn_audio_layers}"
                                Click="BtnAudioLayers_Click"
                                ToolTip="{loc:Str tooltip_audio_layers}"
                                Margin="0,8,0,0" HorizontalAlignment="Left"
                                Background="#33FF69B4" Foreground="White" FontSize="10" Padding="10,4"
                                BorderBrush="{DynamicResource PinkBrush}" BorderThickness="1" Cursor="Hand"/>
                        </StackPanel>
                        <!-- /Advanced audio options -->
                    </StackPanel>
                </Border>

                <!-- Quick Actions (right half) -->
                <Border Grid.Column="2" CornerRadius="12" Padding="9" Margin="0,0,0,6"
                        Background="{DynamicResource ElevatedSurfaceBrush}"
                        BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" VerticalAlignment="Stretch">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <helpers:EmojiTextBlock Style="{StaticResource SectionHeader}" Text="{loc:Str section_quick_links}" FontSize="12" Margin="0"/>
                            <Button x:Name="HelpBtnQuickLinks" x:FieldModifier="internal" Style="{StaticResource HelpButtonStyle}" HorizontalAlignment="Right" Tag="QuickLinks"/>
                        </Grid>
    
                        <!-- Unified Login Button -->
                        <Button x:Name="BtnUnifiedLogin" x:FieldModifier="internal" Content="{loc:Str btn_login_2}"
                                Click="BtnUnifiedLogin_Click"
                                Padding="8,12" Margin="0,0,0,6"
                                ToolTip="{loc:Str tooltip_login_with_discord_or_patreon}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="{DynamicResource PinkBrush}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#E055A0"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter Property="Background" Value="#C04888"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
    
                        <!-- Logged In Status (shown when logged in) -->
                        <Border x:Name="LoggedInStatusPanel" x:FieldModifier="internal" Visibility="Collapsed"
                                Background="{DynamicResource PanelBgBrush}" CornerRadius="6" Padding="12,10" Margin="0,0,0,6"
                                BorderBrush="{DynamicResource PinkBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtLoggedInAs" Text="{loc:Str label_logged_in_as}"
                                               Foreground="{DynamicResource TextMutedBrush}" FontSize="10"/>
                                    <TextBlock x:Name="TxtLoggedInName" x:FieldModifier="internal" Text="{loc:Str label_username}"
                                               Foreground="White" FontWeight="Bold" FontSize="17" Margin="0,1,0,0">
                                        <TextBlock.Effect>
                                            <DropShadowEffect Color="#FF69B4" BlurRadius="10" ShadowDepth="0" Opacity="0.65"/>
                                        </TextBlock.Effect>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="BtnLinkPhone" Content="📱 Link phone"
                                        Click="BtnLinkPhone_Click" Margin="0,0,6,0" VerticalAlignment="Center"
                                        ToolTip="Sign in to the CCP mobile app by scanning a QR code"
                                        Padding="10,5" Background="{DynamicResource AccentTintedBgBrush}" Foreground="{DynamicResource PinkBrush}"
                                        BorderThickness="0" FontSize="10" Cursor="Hand"/>
                                <!-- Prominent, high-contrast Logout button -->
                                <Button x:Name="BtnQuickLogout" Content="{loc:Str btn_logout}"
                                        Click="BtnQuickLogout_Click" VerticalAlignment="Center"
                                        Padding="16,7" FontSize="12" FontWeight="Bold" Cursor="Hand"
                                        ToolTip="{loc:Str btn_logout}">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="Background" Value="{DynamicResource PinkBrush}"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="lborder" Background="{TemplateBinding Background}"
                                                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="lborder" Property="Background" Value="#E055A0"/>
                                                            </Trigger>
                                                            <Trigger Property="IsPressed" Value="True">
                                                                <Setter TargetName="lborder" Property="Background" Value="#C04888"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
    
                        <!-- Discord Join Button + Rich Presence -->
                        <Grid Margin="0,4,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Click="BtnDiscord_Click"
                                    ToolTip="{loc:Str tooltip_join_the_discord_community}" Cursor="Hand"
                                    HorizontalAlignment="Stretch">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="border" Background="#5865F2" CornerRadius="5"
                                                            Padding="0,4" HorizontalAlignment="Stretch">
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                            <Image Width="13" Height="13" VerticalAlignment="Center"
                                                                   Source="{Binding Source='💬', Converter={StaticResource EmojiToImageSource}}"/>
                                                            <TextBlock Text="{loc:Str label_join_discord}" Foreground="White" FontSize="10" FontWeight="Bold"
                                                                       VerticalAlignment="Center" Margin="5,0,0,0"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="border" Property="Background" Value="#6C75F2"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                                <StackPanel.ToolTip>
                                    <ToolTip Background="{DynamicResource SurfaceBgBrush}" BorderBrush="{DynamicResource PinkBrush}" BorderThickness="1" Padding="10">
                                        <StackPanel MaxWidth="280">
                                            <TextBlock Text="{loc:Str label_discord_rich_presence}" Foreground="{DynamicResource PinkBrush}" FontSize="12" FontWeight="Bold" Margin="0,0,0,6"/>
                                            <TextBlock Foreground="#CCCCCC" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8">
                                                Shows "Playing Conditioning Control Panel" in your Discord status, along with your current level and session time.
                                            </TextBlock>
                                            <TextBlock Text="{loc:Str label_who_can_see_this}" Foreground="{DynamicResource SecondaryBrush}" FontSize="11" FontWeight="Bold" Margin="0,0,0,4"/>
                                            <TextBlock Foreground="#AAAAAA" FontSize="10" TextWrapping="Wrap">
                                                Only people who can already see your Discord activity status (friends, server members if enabled in your Discord privacy settings). This does NOT send notifications - it simply updates your "Currently Playing" status like any other game.
                                            </TextBlock>
                                        </StackPanel>
                                    </ToolTip>
                                </StackPanel.ToolTip>
                                <CheckBox x:Name="ChkQuickDiscordRichPresence" x:FieldModifier="internal" Style="{StaticResource ToggleStyle}"
                                          Checked="ChkDiscordRichPresence_Changed" Unchecked="ChkDiscordRichPresence_Changed">
                                    <CheckBox.LayoutTransform>
                                        <ScaleTransform ScaleX="0.85" ScaleY="0.85"/>
                                    </CheckBox.LayoutTransform>
                                </CheckBox>
                                <TextBlock Text="{loc:Str label_rp}" Foreground="{DynamicResource TextMutedBrush}" FontSize="9"
                                           VerticalAlignment="Center" Margin="4,0,0,0"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    
        <!-- ============================================================ -->
        <!-- VELVET MOSAIC HELPER BUTTON ROW - full width, under both     -->
        <!-- the feature grid AND the right half.                         -->
        <!-- ============================================================ -->
        <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" x:Name="VelvetHelperButtonRow"
              Height="30" Margin="5,4,5,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!-- Webcam card — surfaced from the Lab for discoverability.
                 Distinct Secondary (cyan) accent + tinted fill so it stands
                 out from the two neutral cards beside it. -->
            <Button Grid.Column="0" x:Name="VelvetBtnWebcam"
                    Click="VelvetBtnWebcam_Click"
                    Cursor="Hand" FontSize="12" FontWeight="Bold">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b"
                                Background="{DynamicResource AccentTintedBgBrush}"
                                BorderBrush="{DynamicResource SecondaryBrush}"
                                BorderThickness="1.5"
                                CornerRadius="14">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Image Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,8,0"
                                       Source="{Binding Source='📷', Converter={StaticResource EmojiToImageSource}}"/>
                                <TextBlock Text="Webcam &amp; Mic" Foreground="White" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource SecondaryBrush}"/>
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource TransparentPinkBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
    
            <Button Grid.Column="2" x:Name="VelvetBtnAppInfo"
                    Click="VelvetBtnAppInfo_Click"
                    Cursor="Hand" FontSize="12" FontWeight="Bold">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b"
                                Background="{DynamicResource ElevatedSurfaceBrush}"
                                BorderBrush="{DynamicResource GlassBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="14">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="ℹ" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"
                                           Foreground="{DynamicResource PinkBrush}"/>
                                <TextBlock Text="{loc:Str label_app_info}" Foreground="White" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource PinkBrush}"/>
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource TransparentPinkBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
    
            <!-- Combined Scheduler + Intensity Ramp card. Opens one popup
                 holding both panels. Label is two live-localized strings
                 joined by " + " so both halves stay translated. -->
            <Button Grid.Column="4" x:Name="VelvetBtnSchedulerRamp"
                    Click="VelvetBtnSchedulerRamp_Click"
                    Cursor="Hand" FontSize="12" FontWeight="Bold">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b"
                                Background="{DynamicResource ElevatedSurfaceBrush}"
                                BorderBrush="{DynamicResource GlassBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="14">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <!-- No separate 📅 image: section_scheduler already starts with the
                                     calendar emoji (matches the inline ⚡ on Intensity Ramp). -->
                                <helpers:EmojiTextBlock Text="{loc:Str section_scheduler}" Foreground="White" VerticalAlignment="Center"/>
                                <TextBlock Text=" + " Foreground="White" VerticalAlignment="Center"/>
                                <helpers:EmojiTextBlock Text="{loc:Str section_intensity_ramp}" Foreground="White" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource PinkBrush}"/>
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource TransparentPinkBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- CCP Catalogue card — opens the web catalogue to browse/share
                 community presets and sessions. Pink-tinted to flag it as the
                 community/social action of the row. -->
            <Button Grid.Column="6" x:Name="VelvetBtnCatalogue"
                    Click="VelvetBtnCatalogue_Click"
                    Cursor="Hand" FontSize="12" FontWeight="Bold"
                    ToolTip="Opens app.cclabs.app/catalogue in your browser">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b"
                                Background="{DynamicResource TransparentPinkBrush}"
                                BorderBrush="{DynamicResource PinkBrush}"
                                BorderThickness="1.5"
                                CornerRadius="14">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Image Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,8,0"
                                       Source="{Binding Source='📚', Converter={StaticResource EmojiToImageSource}}"/>
                                <TextBlock Text="CCP Catalogue" Foreground="White" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource SecondaryBrush}"/>
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource AccentTintedBgBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

        <!-- Scrolling Marquee Banner - row 3, spans all columns -->
        <Border x:Name="MarqueeBanner" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3"
                Background="#1A0A1A" BorderBrush="{DynamicResource DarkPinkBrush}" BorderThickness="2"
                CornerRadius="8" Height="48" Margin="5,5,5,0" ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect Color="{DynamicResource DarkPink}" BlurRadius="15" ShadowDepth="0" Opacity="0.5"/>
            </Border.Effect>
            <Canvas x:Name="MarqueeCanvas" x:FieldModifier="internal" ClipToBounds="True">
                <!-- Chrome FX (PR-1): edge-fade masks so the scrolling text dissolves into the
                     card instead of being guillotined at the clip. Static brush - zero runtime
                     cost, and it stays correct when the marquee is parked (Performance tier /
                     reduced motion) because nothing animates it. -->
                <Canvas.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Offset="0.00" Color="#00000000"/>
                        <GradientStop Offset="0.06" Color="#FF000000"/>
                        <GradientStop Offset="0.94" Color="#FF000000"/>
                        <GradientStop Offset="1.00" Color="#00000000"/>
                    </LinearGradientBrush>
                </Canvas.OpacityMask>
                <TextBlock x:Name="MarqueeText" x:FieldModifier="internal"
                           Text="{loc:Str label_v5_2_1_is_out_thanks_to_all_the_100_patreons}"
                           FontFamily="Impact" FontSize="28" FontWeight="Bold"
                           Foreground="{DynamicResource PinkBrush}" Canvas.Top="8">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="{DynamicResource DarkPink}" BlurRadius="8" ShadowDepth="0" Opacity="0.8"/>
                    </TextBlock.Effect>
                    <TextBlock.RenderTransform>
                        <TranslateTransform x:Name="MarqueeTransform"/>
                    </TextBlock.RenderTransform>
                </TextBlock>
            </Canvas>
        </Border>
        </Grid>
</UserControl>
