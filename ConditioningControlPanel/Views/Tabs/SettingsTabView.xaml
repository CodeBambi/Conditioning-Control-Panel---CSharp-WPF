                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" ToolTip="{loc:Str tooltip_fade_in_out_animation_speed_0_instant_appear}">
                                <Grid><TextBlock Style="{StaticResource SettingLabel}" Text="{loc:Str setting_fade}" FontSize="11"/><TextBlock x:Name="TxtFade" x:FieldModifier="internal" Style="{StaticResource ValueLabel}" Text="50%" HorizontalAlignment="Right"/></Grid>
                                <Slider x:Name="SliderFade" x:FieldModifier="internal" Minimum="0" Maximum="100" Value="50" Margin="0,1" ValueChanged="SliderFade_Changed"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" ToolTip="{loc:Str tooltip_how_long_images_stay_on_screen_only_used_when}">
                                <Grid><TextBlock Style="{StaticResource SettingLabel}" Text="{loc:Str setting_duration}" FontSize="11"/><TextBlock x:Name="TxtFlashDuration" x:FieldModifier="internal" Style="{StaticResource ValueLabel}" Text="{loc:Str setting_5s}" HorizontalAlignment="Right"/></Grid>
                                <Slider x:Name="SliderFlashDuration" x:FieldModifier="internal" Minimum="1" Maximum="30" Value="5" Margin="0,1" ValueChanged="SliderFlashDuration_Changed"/>
                            </StackPanel>
                        </Grid>
                        
                        <!-- Link to Audio -->
