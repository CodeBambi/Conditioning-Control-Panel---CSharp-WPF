<UserControl x:Class="ConditioningControlPanel.Views.Tabs.SettingsTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:features="clr-namespace:ConditioningControlPanel.Features"
             xmlns:fx="clr-namespace:ConditioningControlPanel.Controls"
             xmlns:helpers="clr-namespace:ConditioningControlPanel.Helpers"
             xmlns:loc="clr-namespace:ConditioningControlPanel.Localization"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <!-- Account strip (nav polish wave 5): a thin dot of a divider between the line's
             groups (name + phone + logout | Discord + status | the five bubbles). -->
        <Style x:Key="AccountStripDividerStyle" TargetType="Border">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Margin" Value="12,0,4,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="#40FFFFFF"/>
        </Style>
        <!-- Polish wave 10 (depth): Home's raised things throw their shadow through these two keys.
             They start as copies of the neutral DepthDropBand / DepthDropDisc ink; SettingsTabView.PaintDepthHome(hue) swaps in a
             shadow pulled toward the section hue (DepthRules.ShadowColor). -->
        <LinearGradientBrush x:Key="HomeDepthDropBand" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0.0" Color="#9E06020F"/>
            <GradientStop Offset="1.0" Color="#0006020F"/>
        </LinearGradientBrush>
        <RadialGradientBrush x:Key="HomeDepthDropDisc" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
            <GradientStop Offset="0.0" Color="#9E06020F"/>
            <GradientStop Offset="0.6" Color="#5C06020F"/>
            <GradientStop Offset="1.0" Color="#0006020F"/>
        </RadialGradientBrush>
    </UserControl.Resources>
        <Grid>
        <Grid.ColumnDefinitions>
            <!-- Nav polish wave 3 (owner, 2026-10-06: "move the favourite rail on the other side,
                 and make it collapsable ... we click to open it and to close as a drawer, same
                 layout"). Column 0 held the FAVORITES + RECENT column at 92 px, right beside the
                 section rail; it is 0 now and kept only so every Grid.Column index below stays
                 put. The column lives in the FAVORITES DRAWER at the right edge (column 3, Auto):
                 a 22 px handle that is always there plus a body that opens to the same 92 px
                 (the arithmetic is written on FavoritesDrawerBody). The drawer PUSHES column 2
                 rather than floating over the browser, and column 1 is a fixed 640, so the
                 mosaic never moves when it opens or closes. -->
            <ColumnDefinition Width="0"/>
            <ColumnDefinition Width="640"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Training Programs "Today" card -->
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============================================================ -->
        <!-- TRAINING PROGRAMS - "TODAY" CARD (row 0, full width).         -->
        <!-- Collapsed entirely unless a program is running; painted from  -->
        <!-- MainWindow.ProgramsTab.cs (RefreshProgramTodayCard). Clicking -->
        <!-- it opens the Programs tab.                                    -->
        <!-- ============================================================ -->
        <Button x:Name="ProgramTodayCard" x:FieldModifier="internal"
                Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4"
                Margin="5,5,5,0" Visibility="Collapsed" Cursor="Hand"
                HorizontalContentAlignment="Stretch"
                BorderBrush="{DynamicResource PinkBrush}"
                Loaded="ProgramTodayCard_Loaded" Click="ProgramTodayCard_Click">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Background" Value="{DynamicResource ElevatedSurfaceBrush}"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <!-- Padding lives on the content Grid below, NOT here: the banner art and
                                 FX layers are part of the content and have to reach the card's edges.
                                 Moving it costs nothing - 14,11 of Padding and 14,11 of Margin arrange
                                 to the same 58.92 box - and it keeps the whole card in one file. -->
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="cardBorder" CornerRadius="10"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}">
                                    <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="cardBorder" Property="Background"
                                                Value="{DynamicResource SurfaceBgBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Button.Style>
            <Grid>
                <!-- ============================================================ -->
                <!-- BANNER DECORATION (art + FX). Painted and animated entirely   -->
                <!-- from MainWindow.ProgramBanner.cs; Collapsed until             -->
                <!-- ApplyProgramBannerArt() runs, so with no wiring and no PNGs   -->
                <!-- the card renders exactly as it did before this layer existed. -->
                <!--                                                                -->
                <!-- Every child is empty here on purpose. Brushes are built from   -->
                <!-- the PROGRAM's accent, which is only known at refresh time, and -->
                <!-- a XAML placeholder brush would flash the wrong colour for one  -->
                <!-- frame on a mod switch.                                         -->
                <!--                                                                -->
                <!-- The host takes a rounded Clip (set in code from ActualWidth):  -->
                <!-- these layers are wider than the card and would otherwise paint -->
                <!-- into the four corner squares outside the border's radius.      -->
                <!-- IsHitTestVisible=False throughout - the whole card is a Button -->
                <!-- and decoration must never swallow the click.                   -->
                <!-- ============================================================ -->
                <Grid x:Name="ProgramTodayDecor" x:FieldModifier="internal"
                      Visibility="Collapsed" IsHitTestVisible="False">
                    <!-- Themed program art. Fill is an ImageBrush; null art leaves it
                         Collapsed and the card falls back to its flat look. -->
                    <!-- The negative margin is the hover parallax's headroom: the art overhangs the
                         card by 14 on each side, so nudging it never exposes a bare edge. The host's
                         Clip hides the overhang. -->
                    <Rectangle x:Name="ProgramTodayArt" x:FieldModifier="internal" Visibility="Collapsed"
                               Margin="-14,0,-14,0">
                        <Rectangle.RenderTransform>
                            <TranslateTransform x:Name="ProgramTodayArtSlide" x:FieldModifier="internal"/>
                        </Rectangle.RenderTransform>
                    </Rectangle>
                    <!-- Drifting accent fog. Wider than the card and slid back and forth. -->
                    <Rectangle x:Name="ProgramTodayFog" x:FieldModifier="internal"
                               HorizontalAlignment="Left" Visibility="Collapsed">
                        <Rectangle.RenderTransform>
                            <TranslateTransform x:Name="ProgramTodayFogSlide" x:FieldModifier="internal"/>
                        </Rectangle.RenderTransform>
                    </Rectangle>
                    <!-- Periodic sheen sweep. Same idiom as the Programs tab session row. -->
                    <Rectangle x:Name="ProgramTodaySheen" x:FieldModifier="internal"
                               Width="150" HorizontalAlignment="Left" Visibility="Collapsed">
                        <Rectangle.RenderTransform>
                            <TranslateTransform x:Name="ProgramTodaySheenSlide" x:FieldModifier="internal"/>
                        </Rectangle.RenderTransform>
                    </Rectangle>
                    <!-- Sparkles are added here in code: their positions are fractions of
                         the card's width, which XAML cannot express on a Canvas. -->
                    <Canvas x:Name="ProgramTodaySparkles" x:FieldModifier="internal"/>
                </Grid>

                <Grid Margin="14,11">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="ProgramTodayAccent" x:FieldModifier="internal" Grid.Column="0"
                            Width="4" CornerRadius="2" Margin="0,1,12,1"
                            Background="{DynamicResource PinkBrush}"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtProgramTodayTitle" x:FieldModifier="internal"
                                   Foreground="{DynamicResource PinkBrush}"
                                   FontSize="11" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="TxtProgramTodayLine" x:FieldModifier="internal"
                                   Foreground="{DynamicResource TextLightBrush}"
                                   FontSize="13" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="›" VerticalAlignment="Center" Margin="12,0,2,0"
                               Foreground="{DynamicResource TextMutedBrush}" FontSize="18"/>
                </Grid>
            </Grid>
        </Button>

        <!-- ============================================================ -->
        <!-- FAVORITES + RECENT RAIL (drawer body, col 3). Owner call, Discord "New UI  -->
        <!-- Feedback", 2026-09-11: the premium quick-toggle rail that sat  -->
        <!-- here is gone. The column remembers where the user goes instead -->
        <!-- - pinned destinations on top, the last seven opened below. The -->
        <!-- chips are built in code (MainWindow.FavoritesRail.cs) from the -->
        <!-- Ctrl+K palette rows, so this file owns the frame and the       -->
        <!-- styles only. The gated features those chips toggled are still  -->
        <!-- switched on from their own cards and pages.                    -->
        <!--                                                                -->
        <!-- 2026-09-12, owner: the chips wear the FEATURE'S OWN PICTURE     -->
        <!-- (Services/FavoritesRailArt.cs), the palette emoji only when no  -->
        <!-- picture resolves, and RECENT grew from five boxes to seven.     -->
        <!-- ============================================================ -->
        <!-- Stretches the full row since 2026-09-12 (was VerticalAlignment="Top", which let the
             card hug the chips). The owner asked for the space under the rail to carry the
             gesture line, so the card owns the column and the line is docked at its foot: the
             lists scroll inside the row above it, and the line stays put however many chips are
             pinned. Nothing is hidden by count. -->
        <!-- THE FAVORITES DRAWER (nav polish wave 3). Column 3 is Auto and holds two things:
             the HANDLE (22 px, always visible, a real Button) and the BODY, whose Width is the
             only thing that moves: 0 closed, 92 open, animated over 200 ms by
             SettingsTabView.SetFavoritesDrawer (instant under Motion Off). Closed by default;
             the state is AppSettings.FavoritesDrawerOpen and only the handle writes it. A pin
             while it is closed opens it for 2.5 s with the glow ring on the new chip
             (MainWindow.TogglePinned -> PeekFavoritesDrawer) and writes nothing.
             The body PUSHES column 2 (the browser column gives up 92 px), it never floats over
             it, and the mosaic in column 1 does not move. -->
        <Grid x:Name="FavoritesDrawer" x:FieldModifier="internal" Grid.Column="3" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="22"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <!-- THE MOD'S COLOUR (owner, 2026-10-06): the handle and the rail border wear the
                 active mod's glow colour, not Home's lilac. The six keys below are defaults
                 only; SettingsTabView.PaintFavoritesDrawer overwrites them from FxTheme at
                 start and on every mod change, and every DynamicResource repaints. -->
            <Grid.Resources>
                <SolidColorBrush x:Key="FavHandleFill" Color="#1FB79CFF"/>
                <SolidColorBrush x:Key="FavHandleBorder" Color="#66B79CFF"/>
                <SolidColorBrush x:Key="FavHandleFillHover" Color="#40B79CFF"/>
                <SolidColorBrush x:Key="FavHandleBorderHover" Color="#FFB79CFF"/>
                <SolidColorBrush x:Key="FavHandleText" Color="#FFB79CFF"/>
                <SolidColorBrush x:Key="FavHandleTextHover" Color="#FFE4DAFF"/>
            </Grid.Resources>
            <!-- The star sits at the top, the word runs up the bar, the chevron at the foot says
                 which way a click goes (set in code). The juice (a breathing glow, the star's
                 twinkle, the motes and the burst on a click) is all code: SettingsTabView.xaml.cs,
                 "the favorites drawer" region, gated on MotionFx. -->
            <Button x:Name="FavoritesDrawerHandle" x:FieldModifier="internal" Grid.Column="0"
                    Margin="2,5,2,5" Cursor="Hand" Click="FavoritesDrawerHandle_Click"
                    AutomationProperties.Name="{loc:Str rail_favorites_drawer}"
                    AutomationProperties.HelpText="{loc:Str tooltip_rail_favorites_drawer}"
                    ToolTip="{loc:Str tooltip_rail_favorites_drawer}">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Foreground" Value="{DynamicResource FavHandleText}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="hb" CornerRadius="9" BorderThickness="1.5"
                                            Background="{DynamicResource FavHandleFill}" BorderBrush="{DynamicResource FavHandleBorder}">
                                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="hb" Property="Background" Value="{DynamicResource FavHandleFillHover}"/>
                                            <Setter TargetName="hb" Property="BorderBrush" Value="{DynamicResource FavHandleBorderHover}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource FavHandleTextHover}"/>
                                        </Trigger>
                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                            <Setter TargetName="hb" Property="BorderBrush" Value="{DynamicResource FavHandleBorderHover}"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="hb" Property="Opacity" Value="0.82"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="FavoritesDrawerStar" x:FieldModifier="internal" Grid.Row="0" Text="&#x2605;" FontSize="13" Margin="0,9,0,0"
                               HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                        <TextBlock.RenderTransform>
                            <ScaleTransform/>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                    <TextBlock Grid.Row="1" Text="{loc:Str rail_favorites_drawer}" FontSize="12" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                        <TextBlock.LayoutTransform>
                            <RotateTransform Angle="-90"/>
                        </TextBlock.LayoutTransform>
                    </TextBlock>
                    <TextBlock x:Name="FavoritesDrawerChevron" x:FieldModifier="internal" Grid.Row="2"
                               Text="&#x2039;" FontSize="16" FontWeight="Bold" Margin="0,0,0,7"
                               HorizontalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Grid>
            </Button>
            <!-- THE BODY. Width 92 open = the old column 0, so the chip arithmetic is unchanged:
                 92 - 5 rail margin - 2 border - 8 scrollbar - 8 stack margin = 69, the chip
                 stack's Width below (#860: 8 of scrollbar gutter, not the 17 of an OS bar,
                 because Resources/Theme/MainWindow.xaml restyles every vertical ScrollBar to
                 Width 8). The rail is pinned at 92 - 5 = 87 and right-aligned, so while the body
                 is narrower it slides in from the edge instead of squeezing the chips.
                 FavoritesRailArtTests re-does this sum from this file. -->
            <Grid x:Name="FavoritesDrawerBody" x:FieldModifier="internal" Grid.Column="1"
                  Width="0" ClipToBounds="True">
        <Border x:Name="FavoritesRail" x:FieldModifier="internal" Width="87" HorizontalAlignment="Right" Margin="0,5,5,5"
                Background="{DynamicResource ElevatedSurfaceBrush}" BorderBrush="{DynamicResource FavHandleBorder}"
                BorderThickness="1" CornerRadius="12">
            <Border.Resources>
                <Style x:Key="RailSectionCaption" TargetType="TextBlock">
                    <Setter Property="FontSize" Value="9"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Foreground" Value="{DynamicResource SecondaryBrush}"/>
                    <Setter Property="TextAlignment" Value="Center"/>
                    <Setter Property="Margin" Value="0,0,0,3"/>
                </Style>
                <Style x:Key="RailEmptyText" TargetType="TextBlock">
                    <Setter Property="FontSize" Value="8"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                    <Setter Property="Opacity" Value="0.85"/>
                    <Setter Property="TextAlignment" Value="Center"/>
                    <Setter Property="TextWrapping" Value="Wrap"/>
                    <Setter Property="Margin" Value="0,0,0,6"/>
                </Style>
                <!-- The gesture line at the foot of the column. 10, a step ABOVE the FAVORITES /
                     RECENT captions, on the owner's word after the desk run ("bigger text here
                     pls"): it shipped at 7.5 and read as a footnote you had to lean into. Muted
                     rather than pink, at full opacity - it explains the column, it does not head
                     a section, and a third pink caption down there would read as a third list,
                     but at this size it no longer needs dimming to stay out of the way.

                     LineHeight is pinned at 13 to match, because a sentence wraps to eight or so
                     lines in a 69px column and the default leading makes that a slab. It may take
                     as many lines as it needs: the rail fills the row now, so the vertical room
                     is there, and the line owns its own Auto row so those lines come out of the
                     lists' scroll area rather than off the bottom of the card. -->
                <Style x:Key="RailGestureHint" TargetType="TextBlock">
                    <Setter Property="FontSize" Value="10"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                    <Setter Property="TextAlignment" Value="Center"/>
                    <Setter Property="TextWrapping" Value="Wrap"/>
                    <Setter Property="LineHeight" Value="13"/>
                    <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
                </Style>
                <!-- Legibility scrim, added to EVERY chip in code: the art is bright neon on
                     near-black and a text shadow would not survive it, so the caption sits in a
                     dark band at the foot instead. Every chip, including one whose art failed to
                     resolve, because that band is what makes the column read as one set of
                     pictures rather than two kinds of chip. Same stops the premium rail's
                     ChipScrimBrush used, and ModArtFramingRegistry calls this surface FootBand
                     so the mod editor's preview paints the same band. -->
                <LinearGradientBrush x:Key="RailChipScrim" StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#00000000" Offset="0.28"/>
                    <GradientStop Color="#73000000" Offset="0.62"/>
                    <GradientStop Color="#DE000000" Offset="1"/>
                </LinearGradientBrush>
                <!-- Caption at the foot of a chip; the picture (or the palette glyph) sits above. -->
                <Style x:Key="RailChipCaption" TargetType="TextBlock">
                    <Setter Property="FontSize" Value="8.5"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="TextAlignment" Value="Center"/>
                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                    <Setter Property="VerticalAlignment" Value="Bottom"/>
                    <Setter Property="Margin" Value="2,0,2,3"/>
                </Style>
                <!-- 69x36 on a 3px gap - a 39 pitch. THE COLUMN ARITHMETIC, because two more
                     RECENT boxes have to come out of a row whose height nobody may change.
                     THE SCROLLING PART, both lists full:

                       stack margin           6 + 6            =  12
                       FAVORITES caption      9pt bold + 3     =  15
                       8 favorite chips       8 x (36 + 3)     = 312
                       RECENT caption         4 + 9pt bold + 3 =  19
                       7 recent chips         7 x (36 + 3)     = 273
                                                                 ===
                       scrolling part                            631

                     The chips were 69x42 on a 4px gap (a 46 pitch) while RECENT held five, which
                     is 644. So eight favorites and SEVEN recent now cost 13 DIP LESS than eight
                     and five did, and it fits two more boxes. The 6 DIP the chip gave up is paid
                     for by the art - a picture reads at 36 where an emoji plus a caption wanted
                     the 42.

                     BELOW that, outside the scroller, the gesture line is docked in its own Auto
                     row: a 1px rule, 5 of padding, the wrapped line, 7 of padding. Its height is
                     TEXT-DRIVEN and therefore language-driven - three sentences at 10pt on a 13
                     leading is a dozen or so lines at 69 wide in English and more in German - so
                     there is no number to put here, and there is no need for one: it is a row of
                     its own, so it cannot overflow and cannot be pushed out. What it does do is
                     take its height off the lists' visible area, which is exactly what the
                     ScrollViewer above is for, and it is why the caps are worth the arithmetic
                     above rather than being left to sort themselves out.

                     Keep this block, RailChipStyle and FavoritesRailRule's two caps in step;
                     FavoritesRailArtTests re-does the sum from this file.

                     A locked destination swaps BorderBrush for the gold tier livery in code. -->
                <Style x:Key="RailChipStyle" TargetType="Button">
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Margin" Value="0,0,0,3"/>
                    <Setter Property="Height" Value="36"/>
                    <Setter Property="Background" Value="{DynamicResource AccentTintedBgBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}"/>
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <!-- The Background is the ART on a chip that has a picture (an
                                     ImageBrush written from code), so the rounded face comes for
                                     free: a Border paints its Background inside its CornerRadius
                                     where a child Image would need its own clip. -->
                                <Border x:Name="cb" Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                        CornerRadius="9" RenderOptions.BitmapScalingMode="HighQuality">
                                    <Grid>
                                        <Border x:Name="tint" CornerRadius="8" Opacity="0" IsHitTestVisible="False"
                                                Background="{DynamicResource TransparentPinkBrush}"/>
                                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="cb" Property="BorderBrush" Value="{DynamicResource PinkBrush}"/>
                                        <Setter TargetName="tint" Property="Opacity" Value="1"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="cb" Property="Opacity" Value="0.82"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Border.Resources>
            <!-- A ScrollViewer for the reason the old rail had one: the row is fixed-height and
                 WPF's layout clip would eat the last chip silently. Width 69 = what the 92px
                 column leaves once the theme's scrollbar takes its share (#860). -->
            <Grid>
                <Grid.RowDefinitions>
                    <!-- The lists take whatever is left after the gesture line has been paid for,
                         and scroll inside it. Star above Auto, not the other way round: an Auto
                         row for the lists would let a full column push the line off the bottom,
                         which is the one thing it must never do. -->
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="4,10,4,10" Width="69" HorizontalAlignment="Center">
                        <TextBlock Text="{loc:Str rail_favorites_caption}" Style="{StaticResource RailSectionCaption}"/>
                        <StackPanel x:Name="FavoritesList" x:FieldModifier="internal"/>
                        <TextBlock x:Name="FavoritesEmpty" x:FieldModifier="internal"
                                   Text="{loc:Str rail_favorites_empty}" Style="{StaticResource RailEmptyText}"/>
                        <TextBlock Text="{loc:Str rail_recent_caption}" Style="{StaticResource RailSectionCaption}" Margin="0,8,0,6"/>
                        <StackPanel x:Name="RecentList" x:FieldModifier="internal"/>
                        <TextBlock x:Name="RecentEmpty" x:FieldModifier="internal"
                                   Text="{loc:Str rail_recent_empty}" Style="{StaticResource RailEmptyText}"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- THE GESTURE LINE (owner, 2026-09-12: "we can use the space under the
                     favourite rail to explain what they can do here", then "we gotta also say
                     that they can also quickly activate and deactivate features with the right
                     click"). Three sentences, because RIGHT-CLICK MEANS TWO THINGS on this page
                     and one sentence covering both would muddle them:

                       left-click            opens, everywhere (chip.Click -> OpenDestination)
                       right-click a TILE    switches the feature on or off
                                             (FeatureCard.OnRightClick -> ToggleRequestedEvent,
                                             which is what dash_toggle_hint says on the logo face)
                       right-click a CHIP    pins or unpins - here, and on every nav rail row,
                       or a RAIL ROW         door header and Play card AttachPinMenu reaches
                                             (WireFavoritePinMenus)

                     It says what the CODE does, which is the other way round from how the owner
                     first phrased it ("right click to open, left click to activate or pin").
                     FavoritesRailArtTests holds all three sentences against those three call
                     sites, so a line that drifts back to the ask fails.

                     Docked, never hidden: it sits outside the ScrollViewer in its own Auto row,
                     so a full column scrolls the chips past it and the line stays. The rule is a
                     1px top border rather than a Separator so it stops short of the card's
                     rounded corners. No scrollbar gutter here - the line is outside the scroller
                     and may use the full width, which is why its margins are 8 and the chip
                     stack's are 4. -->
                <Border Grid.Row="1" Margin="8,0,8,0" Padding="0,5,0,7"
                        BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="0,1,0,0">
                    <Grid>
                        <Button x:Name="ClickChoiceAnchor"
                                FontSize="11" FontWeight="SemiBold" Padding="2,8" Cursor="Hand"
                                Background="Transparent" Foreground="{DynamicResource TextLightBrush}"
                                BorderThickness="0" Click="OpenClickChoice" MouseEnter="HoverClickChoice"
                                MouseLeave="ScheduleClickChoiceClose">
                            <TextBlock Text="{loc:Str dash_click_choice}" TextWrapping="Wrap" TextAlignment="Center"/>
                        </Button>
                        <Popup x:Name="ClickChoicePopup" PlacementTarget="{Binding ElementName=ClickChoiceAnchor}"
                               Placement="Left" HorizontalOffset="-6" StaysOpen="True" Closed="ClickChoiceClosed"
                               AllowsTransparency="True" PopupAnimation="None">
                            <Border x:Name="ClickChoiceBody" Width="290" Padding="18" CornerRadius="12"
                                    Background="#FF1B1B30" BorderBrush="{DynamicResource SecondaryBrush}" BorderThickness="1"
                                    MouseEnter="KeepClickChoiceOpen" MouseLeave="ScheduleClickChoiceClose"
                                    PreviewKeyDown="ClickChoiceKeyDown">
                                <StackPanel>
                                    <TextBlock Text="{loc:Str dash_click_choice}" FontSize="17" FontWeight="Bold"
                                               Foreground="{DynamicResource PinkBrush}" Margin="0,0,0,10"/>
                                    <TextBlock x:Name="ClickChoiceDescription" FontSize="13" LineHeight="20"
                                               Foreground="White" TextWrapping="Wrap" Margin="0,0,0,14"/>
                                    <CheckBox x:Name="InvertDashboardClicks" Content="{loc:Str dash_click_invert}"
                                              Foreground="White" FontSize="13" Cursor="Hand"
                                              Checked="ClickChoiceChanged" Unchecked="ClickChoiceChanged"/>
                                    <TextBlock Text="{loc:Str dash_click_pages_pin}" FontSize="12" LineHeight="18"
                                               Foreground="#CCCCDF" TextWrapping="Wrap" Margin="0,14,0,0"/>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>
                </Border>
            </Grid>
        </Border>
            </Grid>
            <!-- THE MOTES. Embers rising along the handle and a few dust sprites, in the mod's
                 particle colour (AmbientFxCanvas reads FxTheme itself), plus the burst a click
                 and a new pin fire at the handle. Drawn last so it sits over the handle, hit-test
                 off, and 36 px wider to the left so a burst can spill over the page. Registered
                 against the dashboard tab beside MosaicFx so ShowTab parks it. -->
            <fx:AmbientFxCanvas x:Name="FavoritesDrawerFx" x:FieldModifier="internal" Grid.Column="0" Grid.ColumnSpan="2"
                                Margin="-36,0,0,0" IsHitTestVisible="False"/>
        </Grid>

        <!-- ============================================================ -->
        <!-- VELVET MOSAIC DASHBOARD - 4x4 hybrid wall (col 1)             -->
        <!--                                                              -->
        <!-- Third shape in two days, all owner calls, each one learning   -->
        <!-- from the last: the original 4x4 was twelve FX shortcuts (the  -->
        <!-- Studio rack shows the same list better); the one-day 3x3 was  -->
        <!-- eight destinations (which starved the wall of the quick        -->
        <!-- toggles people actually flip mid-session). This wall is the   -->
        <!-- synthesis, owner-designed 2026-08-11:                          -->
        <!--                                                              -->
        <!--   Flash      | Video/BubbleCount | Subliminals | BouncingText -->
        <!--   Just Drop  | [ LOGO 2x2                    ] | Spiral/Pink  -->
        <!--   ? BOX      | [                              ] | Wipe/Drain  -->
        <!--   VAULT (2w) |                   | Bubble Pop  | Lock Card    -->
        <!--                                                              -->
        <!-- * The three DIAGONAL tiles carry two features each (the       -->
        <!--   Features/SplitFeatureCard control). The owner named two      -->
        <!--   merges (Video+BubbleCount, Spiral+PinkFilter); MindWipe+     -->
        <!--   BrainDrain is the build's own third, because the toggleable  -->
        <!--   FX count is 11, not the 10 the brief assumed, and the two    -->
        <!--   immersion brain-effects are the pair the first two merges    -->
        <!--   would have chosen. GESTURE: left-click on a half opens that  -->
        <!--   half's Studio module, right-click toggles it - the same      -->
        <!--   grammar as the rail chips and the single FX tiles.           -->
        <!-- * ? BOX = the daily free feature (DailyFreeService): one       -->
        <!--   premium feature, rotated per-day from a curated pool,        -->
        <!--   server-overridable, genuinely usable free for that day.      -->
        <!-- * VAULT = the Exclusives/Velvet Vault storefront, double-wide. -->
        <!-- * The seven destination tiles of the 3x3 went back behind the  -->
        <!--   Play door (their cards there never left); their art stays in -->
        <!--   Resources/features for that door's own glow-up.              -->
        <!-- Navigation tiles still navigate to the ONE existing entry per  -->
        <!-- feature (PlayTabView.xaml:1165 rule); FX toggles mirror the    -->
        <!-- popup side effects and respect the session dose lock.          -->
        <!-- ============================================================ -->
        <!-- Clip the entire section, including ambient artwork and card glows. -->
        <Grid Grid.Column="1" Grid.Row="1" Margin="10,5,16,5"
              SizeChanged="FeatureSection_SizeChanged">
            <fx:AmbientFxCanvas x:Name="MosaicFx" x:FieldModifier="internal"/>
        <Grid x:Name="VelvetFeatureGrid" x:FieldModifier="internal" Margin="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- The Title="" literals below are English design-time fallbacks only.
                 At runtime MainWindow.ApplyModFeatureNames() overwrites every FX title
                 with the mod-aware localized name (same keys as the Studio rack rows).
                 One tile is runtime-owned outright instead: the ? box, where
                 RefreshMysteryTile() writes today's feature name over it on every repaint. -->

            <!-- Row 1: flash, the video pair, subliminals, bouncing text -->
            <features:FeatureCard DashboardDepth="True" Grid.Row="0" Grid.Column="0" x:Name="CardFlash" x:FieldModifier="internal"
                                  Title="Flash Images"
                                  Icon="pack://application:,,,/Resources/features/flash.png"
                                  HelpSectionId="FlashImages"
                                  Click="CardFlash_Click"
                                  DimWhenInactive="True"
                                  ToggleRequested="CardFlash_Toggle"/>
            <features:SplitFeatureCard DashboardDepth="True" Grid.Row="0" Grid.Column="1" x:Name="ComboVideoBubble" x:FieldModifier="internal"
                                       TitleA="Mandatory Video" TitleB="Bubble Count" HelpSectionIdA="Video" HelpSectionIdB="BubbleCount"
                                       IconA="pack://application:,,,/Resources/features/mandatory_videos.png"
                                       IconB="pack://application:,,,/Resources/features/Bubble_count.png"
                                       ClickA="ComboVideoBubble_ClickA" ClickB="ComboVideoBubble_ClickB"
                                       ToggleA="ComboVideoBubble_ToggleA" ToggleB="ComboVideoBubble_ToggleB"/>
            <features:FeatureCard DashboardDepth="True" Grid.Row="0" Grid.Column="2" x:Name="CardSubliminal" x:FieldModifier="internal"
                                  Title="Subliminals"
                                  Icon="pack://application:,,,/Resources/features/subliminal.png"
                                  HelpSectionId="Subliminals"
                                  Click="CardSubliminal_Click"
                                  DimWhenInactive="True"
                                  ToggleRequested="CardSubliminal_Toggle"/>
            <features:FeatureCard DashboardDepth="True" Grid.Row="0" Grid.Column="3" x:Name="CardBouncingText" x:FieldModifier="internal"
                                  Title="Bouncing Text"
                                  Icon="pack://application:,,,/Resources/features/bouncing_text.png"
                                  HelpSectionId="BouncingText"
                                  Click="CardBouncingText_Click"
                                  DimWhenInactive="True"
                                  ToggleRequested="CardBouncingText_Toggle"/>

            <!-- Row 2: the Deeper editor (far left) + centre logo + spiral pair -->
            <!-- THE DEEPER EDITOR TILE (owner, 2026-09-12: "get rid of the just drop tile, put
                 there the Deeper editor"). It took the slot off the nameless tease tile, which
                 was Just Drop's last dashboard surface; Just Drop itself did not move and still
                 sits on the Studio rail row, on the Exclusives shelf and in Ctrl+K.

                 A DOOR to a tool, not a feature, and the tile is shaped by that in three places:

                 * No ToggleRequested handler. Right-click still raises the card's toggle event
                   (FeatureCard.OnRightClick raises it unconditionally) and nothing is listening,
                   so the gesture does nothing here. An editor has no on/off to quick-toggle, and
                   wiring one would have to invent a state it does not have.
                 * No DimWhenInactive, so CardMuteRule.ShouldMute answers false for this tile
                   whatever else is going on - there is no "off" colour to drain.
                 * No price tag. The Deeper page carries no ExclusiveFeature roster row, so it is
                   not sold and IsNavEntryLocked answers false for it; RefreshMosaicTierBadges
                   therefore leaves this tile alone and the page is exactly as open from here as
                   it is from the rail. If Deeper is ever gated, gate both in the same change.

                 The click is ShowTab("deeper") and nothing else - the library, the editor and the
                 player are all on that page. The first cut opened the editor on a blank
                 enhancement and the owner corrected it on the desk run, 2026-09-12: "the deeper
                 editor should link and open the deeper page, not the editor". The wall's
                 "navigate, never launch" rule, which this tile is now back inside. -->
            <features:FeatureCard DashboardDepth="True" Grid.Row="1" Grid.Column="0" x:Name="CardDeeperEditor" x:FieldModifier="internal"
                                  Title="{loc:Str dash_deeper_editor_title}"
                                  Icon="pack://application:,,,/Resources/features/deeper_editor.png"
                                  Click="CardDeeperEditor_Click">
                <features:FeatureCard.ToolTip>
                    <StackPanel MaxWidth="280">
                        <TextBlock Text="{loc:Str dash_deeper_editor_blurb}" TextWrapping="Wrap"/>
                        <TextBlock Text="{loc:Str dash_deeper_editor_tip}" TextWrapping="Wrap"
                                   Opacity="0.7" Margin="0,4,0,0"/>
                    </StackPanel>
                </features:FeatureCard.ToolTip>
            </features:FeatureCard>

            <!-- Centre logo, back at 2x2 (the 3x3 interlude had it 1x1).
                 Doubles as the weekly Graded Intake pass card: when a free account has an
                 unspent run waiting, MainWindow.RefreshIntakePassTile() flips this tile on its
                 Y axis and leaves the PASS face showing until the run is used or the week rolls.
                 The tile is NOT a cutscene - the card face is a standing affordance, so someone
                 who was on another tab when the week rolled still finds it here. The PASS face
                 type below is restored to its 4x4-era sizes now the cell is big again. -->
            <Border x:Name="LogoBrandFrame" x:FieldModifier="internal"
                    Grid.Row="1" Grid.RowSpan="2" Grid.Column="1" Grid.ColumnSpan="2"
                    Background="#01000000" Margin="6"
                    Cursor="Hand" MouseLeftButtonDown="ImgLogo_MouseLeftButtonDown"
                    ToolTip="{loc:Str tooltip_click_me_rapidly}">

                <!-- Flip host. The spin transform lives HERE and not on ImgLogo on purpose:
                     ImgLogo_MouseLeftButtonDown owns ImgLogo.RenderTransform (it casts it to a
                     ScaleTransform, replaces it when the cast fails, and re-runs an AutoReverse
                     click pulse on ScaleX/ScaleY). A flip sharing that transform would get
                     snapped back to 1.0 by the pulse mid-animation. Separate host, separate
                     transform, no fight. -->
                <Grid x:Name="LogoFlipHost" x:FieldModifier="internal" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <TransformGroup>
                            <!-- ScaleX 1 -> 0 -> 1 is the standard WPF fake for a Y-axis turn;
                                 there is no PlaneProjection/Viewport3D anywhere in this app and
                                 this tile is not the place to introduce one. The SkewTransform
                                 only sells depth - it is cosmetic and always ends back at 0. -->
                            <ScaleTransform x:Name="LogoFlipScale" ScaleX="1" ScaleY="1"/>
                            <SkewTransform x:Name="LogoFlipSkew" AngleX="0" AngleY="0"/>
                        </TransformGroup>
                    </Grid.RenderTransform>

                    <!-- FACE A: the wordmark. Default face; the only face premium users and
                         spent-week users see, inset to leave space around the mark. -->
                    <!-- The Ken Burns drift (scale 1.00 -> 1.04 over 40s, MainWindow.DashboardFx)
                         lives on THIS border and not on ImgLogo or on LogoFlipHost, and that is
                         a correctness rule, not a preference: LogoFlipHost's TransformGroup is
                         owned by the intake flip ceremony, and ImgLogo's ScaleTransform is owned
                         by the rapid-click easter-egg pulse. Both would snap the drift back to
                         1.0 mid-animation. This border sits between them and is otherwise
                         untouched, so the three transforms compose instead of fighting. -->
                    <Border x:Name="LogoFaceLogo" x:FieldModifier="internal" CornerRadius="12" ClipToBounds="True" Margin="24"
                            RenderTransformOrigin="0.5,0.5"
                            Background="{DynamicResource DepthWellFloorBrush}"
                            BorderBrush="{DynamicResource DepthPressedBevel}" BorderThickness="1">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="LogoDriftScale" ScaleX="1" ScaleY="1"/>
                        </Border.RenderTransform>
                        <Grid>
                            <!-- The deepest WELL on the page (polish wave 10): the plate is sunk, its
                                 top band runs half again as deep as any other well and the lit foot
                                 catches the lamp. Hit-test off; the wordmark sits in it. -->
                            <Rectangle x:Name="LogoWellTop" x:FieldModifier="internal" Fill="{DynamicResource DepthWellTop}"
                                       Height="14" VerticalAlignment="Top" IsHitTestVisible="False"/>
                            <Rectangle x:Name="LogoWellLeft" x:FieldModifier="internal" Fill="{DynamicResource DepthWellLeft}"
                                       Width="9" HorizontalAlignment="Left" IsHitTestVisible="False"/>
                            <Rectangle Fill="{DynamicResource DepthWellFoot}" Height="1" VerticalAlignment="Bottom" IsHitTestVisible="False"/>
                            <fx:AnimatedLogoImage x:Name="ImgLogo" x:FieldModifier="internal" Stretch="Uniform"
                                   HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <!-- Occasional light pass over the wordmark (one shot every 25-40s,
                                 fired by a timer in MainWindow.DashboardFx - never an idle loop).
                                 Opacity 0 at rest, so it costs nothing between passes. -->
                            <Rectangle x:Name="LogoSheen" x:FieldModifier="internal"
                                       Width="110" HorizontalAlignment="Left"
                                       IsHitTestVisible="False" Opacity="0">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="Transparent" Offset="0"/>
                                        <GradientStop Color="{DynamicResource FxFlashTintColor}" Offset="0.5"/>
                                        <GradientStop Color="Transparent" Offset="1"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                                <Rectangle.RenderTransform>
                                    <TransformGroup>
                                        <SkewTransform AngleX="-18"/>
                                        <TranslateTransform x:Name="LogoSheenSlide"/>
                                    </TransformGroup>
                                </Rectangle.RenderTransform>
                            </Rectangle>
                            <!-- The gesture hint. On the logo face, not on a tile: this is the one
                                 cell every eye crosses that is not itself a feature, so the line
                                 reads as a caption for the whole wall. Hit-test invisible - the
                                 logo's own click (the easter egg) keeps the whole face. Retired by
                                 MainWindow.RefreshDashboardToggleHint after three right-click
                                 toggles (Services/DashboardToggleHintRule). -->
                            <TextBlock x:Name="DashToggleHint" x:FieldModifier="internal"
                                       Text="{loc:Str dash_toggle_hint}"
                                       VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                       Margin="12,0,12,8" FontSize="10"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       TextAlignment="Center" TextWrapping="Wrap"
                                       IsHitTestVisible="False"/>
                        </Grid>
                    </Border>

                    <!-- FACE B: the weekly pass card. Collapsed by default so nothing about the
                         Dashboard changes until RefreshIntakePassTile() decides otherwise.
                         Visual register deliberately matches Features/FeatureCard.xaml (elevated
                         surface, 1px glass border, 12px radius, pink drop glow) so it reads as a
                         sibling of the tiles around it rather than a popup that got stuck.

                         Every piece of copy on this face is state-dependent (available / signed
                         out / spent) and is written by MainWindow.ApplyIntakePassFaceState(); the
                         {loc:Str} values below are the available-state defaults, so the card
                         still reads correctly if it is ever shown before the first paint. -->
                    <Border x:Name="IntakePassFace" x:FieldModifier="internal"
                            Visibility="Collapsed"
                            Background="{DynamicResource ElevatedSurfaceBrush}"
                            BorderBrush="{DynamicResource GlassBorderBrush}"
                            BorderThickness="1" CornerRadius="12" ClipToBounds="True"
                            Cursor="Hand"
                            MouseLeftButtonDown="IntakePassFace_MouseLeftButtonDown"
                            ToolTip="{loc:Str tooltip_intake_pass_card}">
                        <Border.Effect>
                            <DropShadowEffect Color="{DynamicResource PinkColor}"
                                              BlurRadius="18" ShadowDepth="0" Opacity="0.55"/>
                        </Border.Effect>
                        <Grid>
                            <!-- LAYER 0: the per-niche card art (Resources/intake/pass_card_*.png,
                                 1024x1024). Painted as an ImageBrush BACKGROUND rather than as an
                                 Image child because Border.ClipToBounds clips to the rectangle and
                                 ignores CornerRadius - a background brush is the only fill that
                                 actually follows the rounded corners. UniformToFill crops the
                                 square evenly into the tile instead of letterboxing it, and the
                                 art's dark, uncluttered lower third is where the CTA lands.
                                 Collapsed until IntakeNiche.PassCardImage() returns a bitmap; when
                                 it returns null every art layer stays hidden and the vector block
                                 below carries the card on its own. -->
                            <Border x:Name="IntakePassArt" x:FieldModifier="internal"
                                    CornerRadius="11" Visibility="Collapsed">
                                <Border.Background>
                                    <!-- x:Name only, no x:FieldModifier - the generated field is
                                         already internal, and that is the pattern LogoFlipScale /
                                         LogoFlipSkew above are proven on. -->
                                    <ImageBrush x:Name="IntakePassArtBrush"
                                                Stretch="UniformToFill"
                                                AlignmentX="Center" AlignmentY="Center"/>
                                </Border.Background>
                            </Border>

                            <!-- LAYER 1: ticket sheen. Vector only, and kept OVER the art on
                                 purpose - at 22% alpha it tints the top of the card the same pink
                                 as its neighbours whether or not the PNG resolved, so the tile
                                 belongs to the mosaic in both modes. -->
                            <Border CornerRadius="11">
                                <Border.Background>
                                    <RadialGradientBrush Center="0.5,0.12" GradientOrigin="0.5,0.05"
                                                         RadiusX="0.95" RadiusY="0.85">
                                        <GradientStop Color="#38FF69B4" Offset="0"/>
                                        <GradientStop Color="#00FF69B4" Offset="1"/>
                                    </RadialGradientBrush>
                                </Border.Background>
                            </Border>

                            <!-- LAYER 2: legibility scrim. Only shown with art under it - without
                                 art the card is already a flat dark surface and the scrim would
                                 just be a smudge. Dark at the top (headline) and heavier at the
                                 bottom (CTA), transparent through the middle so the ticket itself
                                 is never veiled. -->
                            <Border x:Name="IntakePassScrim" x:FieldModifier="internal"
                                    CornerRadius="11" Visibility="Collapsed" IsHitTestVisible="False">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#B31A1A2E" Offset="0"/>
                                        <GradientStop Color="#001A1A2E" Offset="0.28"/>
                                        <GradientStop Color="#001A1A2E" Offset="0.56"/>
                                        <GradientStop Color="#CC12121F" Offset="0.82"/>
                                        <GradientStop Color="#F20D0D18" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

                            <!-- Headline. Always visible - it is the only thing naming the feature
                                 in art mode, and it sits on the art's dark top strip.

                                 Type restored to the 4x4-era sizes (13/11/12/9): the 2x2 cell is
                                 back, so the ~15% step-down the 3x3 interlude needed would now
                                 just look timid. -->
                            <TextBlock x:Name="IntakePassHeadline" x:FieldModifier="internal"
                                       Text="{loc:Str intake_pass_card_headline}"
                                       VerticalAlignment="Top" HorizontalAlignment="Center"
                                       Margin="10,8,10,0"
                                       Foreground="{DynamicResource PinkBrush}"
                                       FontSize="13" FontWeight="Bold"
                                       TextAlignment="Center" TextWrapping="Wrap"/>

                            <!-- Vector block: the pre-art card body. Collapsed whenever art is
                                 showing (it would sit straight on top of the ticket); shown when
                                 PassCardImage() returned null, which is the documented fallback. -->
                            <StackPanel x:Name="IntakePassVectorBody" x:FieldModifier="internal"
                                        VerticalAlignment="Center" HorizontalAlignment="Center"
                                        Margin="10,20,10,28">
                                <!-- WPF cannot draw COLR/CPAL color-emoji fonts, so every emoji in
                                     this app is an Image routed through EmojiToImageSource. -->
                                <Image Width="21" Height="21" HorizontalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       Source="{Binding Source='✨', Converter={StaticResource EmojiToImageSource}}"/>

                                <Border Height="1" Margin="16,7"
                                        Background="{DynamicResource GlassBorderBrush}"/>

                                <TextBlock x:Name="IntakePassBody" x:FieldModifier="internal"
                                           Text="{loc:Str intake_pass_card_body}"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           FontSize="11" LineHeight="15"
                                           TextAlignment="Center" TextWrapping="Wrap"/>

                                <TextBlock Text="{loc:Str intake_pass_card_footnote}"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           FontSize="9"
                                           TextAlignment="Center" TextWrapping="Wrap"
                                           Margin="0,6,0,0"/>
                            </StackPanel>

                            <!-- Bottom bar: the pulsing call to action plus the "(?)" explainer.
                                 The breath animation is driven from MainWindow (BeginAnimation on
                                 IntakePassCtaScale / the TextBlock's Opacity) - a Storyboard would
                                 silently no-op across this UserControl's namescope. Only the text
                                 scales; the "(?)" is deliberately left still so it stays an easy
                                 18px target.

                                 A Grid, not a horizontal StackPanel: a StackPanel hands its child
                                 infinite width, so a long translation of the CTA would refuse to
                                 wrap and get clipped off BOTH edges of the card. The 26px spacer
                                 column mirrors the "(?)" (18px button + 8px gutter) so the text
                                 still lands optically centred. -->
                            <Grid VerticalAlignment="Bottom" Margin="8,0,8,9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="26"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="IntakePassCta" x:FieldModifier="internal"
                                           Grid.Column="1"
                                           Text="{loc:Str intake_pass_card_cta}"
                                           Foreground="White" FontSize="12" FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           TextAlignment="Center" TextWrapping="Wrap"
                                           RenderTransformOrigin="0.5,0.5">
                                    <TextBlock.RenderTransform>
                                        <ScaleTransform x:Name="IntakePassCtaScale" ScaleX="1" ScaleY="1"/>
                                    </TextBlock.RenderTransform>
                                </TextBlock>

                                <!-- Same interactive popover the feature tiles use; MainWindow
                                     attaches the content (Controls.HelpPopover.Attach). A Button
                                     marks MouseLeftButtonDown handled, so clicking the "?" cannot
                                     also launch the intake or poke the logo easter egg. -->
                                <Button x:Name="BtnIntakePassHelp" x:FieldModifier="internal"
                                        Grid.Column="2"
                                        Style="{DynamicResource HelpButtonStyle}"
                                        HorizontalAlignment="Left" VerticalAlignment="Center"
                                        Margin="8,0,0,0"/>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
    
            <features:SplitFeatureCard DashboardDepth="True" Grid.Row="1" Grid.Column="3" x:Name="ComboSpiralPink" x:FieldModifier="internal"
                                       TitleA="Spiral Overlay" TitleB="Pink Filter" HelpSectionIdA="SpiralOverlay" HelpSectionIdB="PinkFilter"
                                       IconA="pack://application:,,,/Resources/features/spiral_overlay.png"
                                       IconB="pack://application:,,,/Resources/features/Pink_filter.png"
                                       ClickA="ComboSpiralPink_ClickA" ClickB="ComboSpiralPink_ClickB"
                                       ToggleA="ComboSpiralPink_ToggleA" ToggleB="ComboSpiralPink_ToggleB"/>

            <!-- Row 3: the ? box + the immersion pair -->
            <!-- The ? BOX: today's premium feature, free for the day (DailyFreeService).
                 The title is painted by MainWindow.RefreshMysteryTile() on every rail repaint
                 and is ALWAYS the offer ("FREE TODAY"), never the day's feature - naming it on
                 this face would spend the reveal below before the plate ever turned. The literal
                 is a design-time fallback. Click navigates to today's feature - the tile never
                 launches anything itself.

                 The tile is a TWO-SIDED PLATE (owner spec 2026-08-11 #2, revised): HOVER turns
                 it - same ScaleX fake-spin as the intake pass card on the logo tile, one quick
                 half-turn - onto today's feature (art + name), and unhovering turns it back to
                 the box. The flip transform lives on THIS host so both faces share it, and the
                 MouseEnter/MouseLeave hooks are on the host too (the faces swap Visibility
                 mid-turn, so a handler on a face would see leaves the pointer never made). The
                 turn itself is MainWindow.DashboardFx.cs region 2c, never a Storyboard
                 (SetTargetName no-ops across this UserControl's namescope). -->
            <Grid Grid.Row="2" Grid.Column="0" x:Name="MysteryFlipHost" x:FieldModifier="internal"
                  RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="MysteryFlipScale" x:FieldModifier="internal" ScaleX="1" ScaleY="1"/>
                        <SkewTransform x:Name="MysteryFlipSkew" x:FieldModifier="internal" AngleY="0"/>
                    </TransformGroup>
                </Grid.RenderTransform>

                <features:FeatureCard DashboardDepth="True" x:Name="CardMystery" x:FieldModifier="internal"
                                      Title="FREE TODAY"
                                      Icon="pack://application:,,,/Resources/features/mysterybox.png"
                                      Click="CardMystery_Click"/>

                <!-- The reveal face: today's feature, full-bleed. Art + name are painted by
                     RefreshMysteryTile; clicking it is clicking the box (same navigation). The
                     6px margin mirrors FeatureCard's own RootBorder margin so the two faces are
                     the same plate, not two sizes of plate. -->
                <Border x:Name="MysteryRevealFace" x:FieldModifier="internal"
                        Visibility="Collapsed" Margin="6" CornerRadius="12" ClipToBounds="True"
                        Background="{DynamicResource ElevatedSurfaceBrush}"
                        BorderBrush="#FFD54A" BorderThickness="1.5"
                        Cursor="Hand" MouseLeftButtonUp="MysteryRevealFace_Click">
                    <Grid>
                        <Border CornerRadius="11" RenderOptions.BitmapScalingMode="HighQuality">
                            <Border.Background>
                                <ImageBrush x:Name="MysteryRevealArtBrush" x:FieldModifier="internal"
                                            Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>
                        <Border CornerRadius="0,0,11,11" VerticalAlignment="Bottom" IsHitTestVisible="False">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="Transparent" Offset="0"/>
                                    <GradientStop Color="#B3000000" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel Margin="8,20,8,8">
                                <TextBlock Text="{loc:Str mosaic_daily_gift}"
                                           HorizontalAlignment="Center" TextAlignment="Center"
                                           Foreground="#FFD54A" FontSize="9" FontWeight="Bold"/>
                                <TextBlock x:Name="MysteryRevealName" x:FieldModifier="internal"
                                           Text="Feature"
                                           HorizontalAlignment="Center" TextAlignment="Center"
                                           TextWrapping="Wrap" Foreground="White"
                                           FontSize="15" FontWeight="Black"/>
                            </StackPanel>
                        </Border>

                        <!-- The gift's price, re-stamped. On the REVEAL face only: this is the
                             side that names today's feature, so it is the side that can say what
                             the feature normally costs and that today it does not. The ? box face
                             carries no sign of any kind, only its gold ring and its FREE TODAY
                             title - putting a tier sign on the unopened box would price a gift
                             nobody has looked at yet.
                             Painted by RefreshMysteryTile; collapsed for premium accounts, who own
                             the whole pool and are not being given anything. -->
                        <fx:TierBadge x:Name="MysteryRevealBadge" x:FieldModifier="internal"
                                      HorizontalAlignment="Right" VerticalAlignment="Top"
                                      Margin="0,-4,-4,0" Panel.ZIndex="9"/>
                    </Grid>
                </Border>

                <!-- The gold highlight ring (owner spec: "an highlight around it so it pops...
                     probably in yelloish"). Inside the flip host so it turns with the plate.
                     Opacity is the animated property - MainWindow.DashboardFx breathes it for
                     as long as today's gift is unopened, and rests it at the value below once
                     the user hovers the tile. Gold on purpose: everything else on this wall glows in the
                     mod's Fx colour, so the one gold ring cannot be mistaken for an active
                     state. -->
                <Border x:Name="MysteryGlow" x:FieldModifier="internal"
                        Margin="6" CornerRadius="12" IsHitTestVisible="False"
                        BorderBrush="#FFD54A" BorderThickness="2.5" Opacity="0.55">
                    <Border.Effect>
                        <DropShadowEffect Color="#FFD54A" BlurRadius="16" ShadowDepth="0" Opacity="0.8"/>
                    </Border.Effect>
                </Border>
            </Grid>

            <!-- The badge sits OUTSIDE the flip host so it stays legible while the plate is
                 edge-on mid-turn. Top-right because the FREE TODAY price tag (TierBadge) owns
                 the card's top-left. Breath is driven by MainWindow.DashboardFx alongside the
                 ring above, and stops with it on the day's first hover. -->
            <Border x:Name="MysteryBadge" x:FieldModifier="internal"
                    Grid.Row="2" Grid.Column="0" Panel.ZIndex="12" IsHitTestVisible="False"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,2,2,0" Padding="8,3,8,4" CornerRadius="8"
                    RenderTransformOrigin="0.5,0.5">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FFE082" Offset="0"/>
                        <GradientStop Color="#FFB300" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="MysteryBadgeScale" x:FieldModifier="internal" ScaleX="1" ScaleY="1"/>
                        <RotateTransform Angle="8"/>
                    </TransformGroup>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect Color="#FFD54A" BlurRadius="10" ShadowDepth="0" Opacity="0.85"/>
                </Border.Effect>
                <TextBlock Text="{loc:Str mosaic_new_today}"
                           Foreground="#3A2A00" FontSize="10" FontWeight="Black"/>
            </Border>
            <features:SplitFeatureCard DashboardDepth="True" Grid.Row="2" Grid.Column="3" x:Name="ComboMindDrain" x:FieldModifier="internal"
                                       TitleA="Mind Wipe" TitleB="Brain Drain" HelpSectionIdA="MindWipe" HelpSectionIdB="BrainDrain"
                                       IconA="pack://application:,,,/Resources/features/Mind_Wipers.png"
                                       IconB="pack://application:,,,/Resources/features/brain_drain.png"
                                       ClickA="ComboMindDrain_ClickA" ClickB="ComboMindDrain_ClickB"
                                       ToggleA="ComboMindDrain_ToggleA" ToggleB="ComboMindDrain_ToggleB"/>

            <!-- Row 4: the vault (double-wide) + the two games -->
            <!-- THE VAULT: the Exclusives storefront (Velvet Vault + the premium T2 shelf).
                 Double-wide because it is a billboard as much as a door. Navigates to the
                 Exclusives tab through the SAME handler the rail's Patreon row uses. -->
            <features:FeatureCard DashboardDepth="True" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" x:Name="CardVault" x:FieldModifier="internal"
                                  Title="The Vault"
                                  Icon="pack://application:,,,/Resources/features/vault.png"
                                  Click="CardVault_Click"/>
            <!-- The vault's animated CTA (owner spec 2026-08-11): big, slightly diagonal,
                 breathing. Overlaid on the CELL rather than inside FeatureCard so the card
                 control stays generic. IsHitTestVisible=False - clicks land on the card.
                 The breath (VaultCtaScale) is driven from MainWindow.DashboardFx under the
                 same MotionFx gates as the intake CTA pulse (IntakePassCtaScale precedent:
                 a Storyboard would no-op across the UserControl namescope). Glow colour is
                 FxGlowBrush, so a mod switch re-themes the CTA with zero code. -->
            <TextBlock x:Name="VaultCta" x:FieldModifier="internal"
                       Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                       Text="{loc:Str mosaic_vault_cta}"
                       IsHitTestVisible="False" Panel.ZIndex="12"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextAlignment="Center" TextWrapping="Wrap" MaxWidth="330"
                       Foreground="White" FontSize="17" FontWeight="Black"
                       RenderTransformOrigin="0.5,0.5">
                <TextBlock.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="VaultCtaScale" ScaleX="1" ScaleY="1"/>
                        <RotateTransform Angle="-7"/>
                    </TransformGroup>
                </TextBlock.RenderTransform>
                <TextBlock.Effect>
                    <DropShadowEffect Color="{DynamicResource FxGlowColor}"
                                      BlurRadius="14" ShadowDepth="0" Opacity="0.95"/>
                </TextBlock.Effect>
            </TextBlock>
            <features:FeatureCard DashboardDepth="True" Grid.Row="3" Grid.Column="2" x:Name="CardBubblePop" x:FieldModifier="internal"
                                  Title="Bubble Pop"
                                  Icon="pack://application:,,,/Resources/features/Bubble_pop.png"
                                  HelpSectionId="BubblePop"
                                  Click="CardBubblePop_Click"
                                  DimWhenInactive="True"
                                  ToggleRequested="CardBubblePop_Toggle"/>
            <features:FeatureCard DashboardDepth="True" Grid.Row="3" Grid.Column="3" x:Name="CardLockCard" x:FieldModifier="internal"
                                  Title="Lock Card"
                                  Icon="pack://application:,,,/Resources/features/Phrase_Lock.png"
                                  HelpSectionId="LockCard"
                                  Click="CardLockCard_Click"
                                  DimWhenInactive="True"
                                  ToggleRequested="CardLockCard_Toggle"/>

            <!-- ============================================================ -->
            <!-- PROGRAM FEATURE LOCK - the "why" pill. Shown only while a     -->
            <!-- Training Program session is running; painted and hidden from   -->
            <!-- MainWindow.ProgramLock.cs (ApplyProgramLockRibbon), which      -->
            <!-- DERIVES the state from live engine state rather than latching. -->
            <!--                                                                -->
            <!-- It is an OVERLAY, and that is load-bearing: RowSpan/ColumnSpan  -->
            <!-- cover the whole mosaic and VerticalAlignment=Top pins it to     -->
            <!-- the top edge, so it adds ZERO height to the fixed 1489x901      -->
            <!-- design canvas. Adding real height here is how the Remote chip   -->
            <!-- got eaten by WPF's silent layout clip - no scrollbar, no        -->
            <!-- warning, no binding error.                                      -->
            <!--                                                                -->
            <!-- IsHitTestVisible=False on purpose: being locked out of          -->
            <!-- CHANGING the day's feature mix is no reason to be locked out of -->
            <!-- reading it, so every tile underneath still opens its popup.     -->
            <!-- The refusal happens in code, not by swallowing clicks.          -->
            <!-- ============================================================ -->
            <Border x:Name="ProgramFeatureLockRibbon" x:FieldModifier="internal"
                    Grid.Row="0" Grid.RowSpan="4" Grid.Column="0" Grid.ColumnSpan="4"
                    Visibility="Collapsed" IsHitTestVisible="False" Panel.ZIndex="30"
                    VerticalAlignment="Top" HorizontalAlignment="Center"
                    MaxWidth="620" Margin="0,14,0,0" Padding="13,6,13,6"
                    Background="#F21A1A2E" BorderBrush="{DynamicResource PinkBrush}"
                    BorderThickness="1" CornerRadius="10">
                <Border.Effect>
                    <DropShadowEffect Color="{DynamicResource PinkColor}"
                                      BlurRadius="16" ShadowDepth="0" Opacity="0.6"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <!-- WPF cannot draw COLR/CPAL colour-emoji fonts; EmojiTextBlock is the
                         app-wide route for every emoji. -->
                    <helpers:EmojiTextBlock Text="🔒" FontSize="13" VerticalAlignment="Center"
                                            Margin="0,0,8,0"/>
                    <!-- Text is written by ApplyProgramLockRibbon. The literal here is a
                         design-time placeholder only - it is never shown, because the ribbon
                         is Collapsed until that method fills it in. -->
                    <TextBlock x:Name="TxtProgramFeatureLock" x:FieldModifier="internal"
                               Text="Program is running this"
                               Foreground="{DynamicResource PinkBrush}"
                               FontSize="11" FontWeight="SemiBold"
                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
        </Grid>
    
        <!-- ============================================================ -->
        <!-- LEGACY DASHBOARD HOST - DEMOLISHED (UX restructure, Phase 8). -->
        <!--                                                              -->
        <!-- 459 lines and ~65 x:Names that were Visibility="Collapsed"   -->
        <!-- forever, kept alive only so MainWindow's partials could keep  -->
        <!-- addressing them by name. Every control had a proven live      -->
        <!-- editor by Phase 4:                                            -->
        <!--   Flash / Visuals / Video / Subliminal dose dials             -->
        <!--       -> the Studio rack's Features/*FeatureControl panels    -->
        <!--          (Views/Tabs/StudioTabView.xaml:181-199)              -->
        <!--   ChkDualMon -> Features/SystemFeatureControl.ChkMultiMon,    -->
        <!--          reachable from the "System" quick-toggle pill below  -->
        <!--   Performance twins (ChkPerformanceMode, ChkAutoPerformance,  -->
        <!--          ChkVideoHwDecode, ChkUnifiedOverlay, CmbMotionLevel) -->
        <!--       -> Views/Controls/AppSettings/PerformanceSettingsSection-->
        <!--                                                               -->
        <!-- The read-backs in SaveSettings were provable identity ops      -->
        <!-- (SaveSettings opened by calling LoadSettings), except where a  -->
        <!-- twin slider's Min/Max clamped the value - the hazard the       -->
        <!-- range-matching comments in this markup used to ward off.       -->
        <!-- Deleting both halves removes the clamp permanently.            -->
        <!-- ============================================================ -->
    
        <!-- RIGHT HALF — col 2 (after premium rail + feature grid).
             Phase 3 layout: browser card (star) · companion strip (auto) · account strip (auto).
             The Audio card left in Phase 2 and the audio-sync sliders left in Phase 3; the old
             tall "Quick Links" card is compressed into the one-line account strip at the foot, so
             this column is SHORTER than it was and the browser card gains the difference. Nothing
             here may grow: every unit taken from row 0 comes off the WebView2's layout slot. -->
        <Grid Grid.Column="2" Grid.Row="1" Margin="5">
            <!-- The fold (2026-09-12). Row 0 is the browser card and row 1 is the space it gives
                 back when it is folded shut; the two trade places and nothing else in this column
                 moves. Expanded: card "*", fold row 0 - byte-for-byte the shipped arithmetic, so
                 the WebView2's layout slot is unchanged. Collapsed: card Auto (the header strip
                 only), fold row "*". MainWindow.DashboardFold.cs owns the swap. -->
            <Grid.RowDefinitions>
                <RowDefinition x:Name="BrowserCardRow" x:FieldModifier="internal" Height="*"/>
                <RowDefinition x:Name="BrowserFoldRow" x:FieldModifier="internal" Height="0"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Browser Section -->
            <!-- ClipToBounds is a backstop, not the fix: the WebView2 below is a native HWND
                 (an HwndHost), and WPF's layout clip does not reliably clip native children.
                 If this card is ever over-filled again the spill has to stop at the card's own
                 edge instead of painting over the account card and the helper-button row. -->
            <!-- AIRSPACE. The WebView2 inside this card is a native HWND: nothing WPF draws can
                 ever appear over it, and a RenderTransform on the card would leave the browser
                 behind. So this card's FX are on the FRAME and the HEADER only - a slow light
                 travelling around the border (animated gradient stops, driven and tier-gated
                 from MainWindow.DashboardFx) plus a pulse on the status text while it is still
                 loading. Nothing here paints over the web surface, and nothing here moves it. -->
            <Border x:Name="BrowserCardFrame" x:FieldModifier="internal"
                    Grid.Row="0" CornerRadius="12" Padding="9" Margin="0,0,0,10" ClipToBounds="True"
                    Background="{DynamicResource ElevatedSurfaceBrush}" BorderThickness="1">
                <Border.BorderBrush>
                    <!-- The resting offsets park the bright core entirely BEFORE the brush's 0
                         mark. LinearGradientBrush pads past its last stop, so at rest the whole
                         frame is flat GlassBorder - byte-for-byte the border that shipped. The
                         travelling band only exists while the loop is running. -->
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop x:Name="BrowserFrameStopLead" Color="{DynamicResource GlassBorder}" Offset="-0.30"/>
                        <GradientStop x:Name="BrowserFrameStopCore" Color="{DynamicResource FxGlowColor}" Offset="-0.15"/>
                        <GradientStop x:Name="BrowserFrameStopTail" Color="{DynamicResource GlassBorder}" Offset="0"/>
                    </LinearGradientBrush>
                </Border.BorderBrush>
                <!-- Grid, not StackPanel. A StackPanel hands each child its DESIRED height and
                     never shrinks it, so the browser box below (which used to carry a hard
                     Height="340") kept its old size when the Training Programs "Today" banner
                     took ~64 design units out of this column - and the native WebView2 painted
                     straight through the card's bottom edge. With Auto/* the browser box is
                     simply whatever is left after the header: it shrinks when the banner
                     appears, grows back when it goes, and follows window resize / DPI change
                     for free, because layout - not a constant - decides its height. -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <!-- Browser Header - single row with title, tabs, status, webcam toggle, pop out,
                         and the fold chevron at the right end. The header is the one strip that
                         survives a fold, so everything in it has to make sense with no page under
                         it: the site radios still pick a site, Pop Out still pops the page into its
                         own window, mute still mutes audio the hidden page is playing. Nothing here
                         is hidden on fold - the controls keep their own Visibility owners
                         (DeeperBrowserBadge, the webcam label) and a second writer would fight them. -->
                    <!-- The bezel's LIP (polish wave 10): a raised strip behind the header row,
                         lit top edge and shaded foot. Behind the controls, hit-test off. -->
                    <Border x:Name="BrowserLip" x:FieldModifier="internal" Grid.Row="0" Margin="-4,-4,-4,1"
                            CornerRadius="9" BorderThickness="1" IsHitTestVisible="False"
                            BorderBrush="{DynamicResource DepthRaisedBevel}" Background="{DynamicResource DepthRaisedSheen}"/>
                    <Grid Grid.Row="0" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <helpers:EmojiTextBlock Style="{StaticResource SectionHeader}" Text="{loc:Str section_browser}" Margin="0"/>
                            <Button x:Name="HelpBtnBrowser" x:FieldModifier="internal" Style="{StaticResource HelpButtonStyle}" Tag="Browser"/>
                        </StackPanel>
                        <!-- Site Toggle - inline -->
                        <Border Grid.Column="1" Background="{DynamicResource PanelAccentBrush}" CornerRadius="10" Padding="1" Margin="10,0,0,0" VerticalAlignment="Center"
                                BorderBrush="{DynamicResource DepthPressedBevel}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <!-- #867: Click, not Checked. A RadioButton raises Checked only when
                                     it CHANGES, so clicking the site you are already on did nothing -
                                     which is exactly what a user does to get back to the homepage
                                     from a video page. Click fires either way. It also means code
                                     that sets IsChecked (mod switch, external-link sync) no longer
                                     triggers a navigation it did not ask for. -->
                                <RadioButton x:Name="RbBambiCloud" x:FieldModifier="internal" Content="{loc:Str btn_bambicloud}" GroupName="BrowserSite"
                                             IsChecked="True" Click="BrowserSiteToggle_Click"
                                             Foreground="{DynamicResource TextLightBrush}" FontSize="10" Cursor="Hand" Margin="2,1">
                                    <RadioButton.Template>
                                        <ControlTemplate TargetType="RadioButton">
                                    <!-- Polish wave 10: a raised pill (bevel + sheen) that sits PRESSED IN
                                         (ActiveSinkPx, pressed bevel and shade) while it is the site. -->
                                    <Border x:Name="border" Background="Transparent" CornerRadius="8"
                                            BorderBrush="{DynamicResource DepthRaisedBevel}" BorderThickness="1">
                                        <Border.RenderTransform>
                                            <TranslateTransform/>
                                        </Border.RenderTransform>
                                        <Border x:Name="face" CornerRadius="7" Padding="7,2" Background="{DynamicResource DepthRaisedSheen}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="RenderTransform"><Setter.Value><TranslateTransform Y="-1"/></Setter.Value></Setter>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="{DynamicResource PinkBrush}"/>
                                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource DepthPressedBevel}"/>
                                            <Setter TargetName="face" Property="Background" Value="{DynamicResource DepthPressedShade}"/>
                                            <Setter TargetName="border" Property="RenderTransform"><Setter.Value><TranslateTransform Y="1"/></Setter.Value></Setter>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="border" Property="RenderTransform"><Setter.Value><TranslateTransform Y="2"/></Setter.Value></Setter>
                                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource DepthPressedBevel}"/>
                                        </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#353565"/>
                                            </Trigger>
                                            <MultiTrigger>
                                                <MultiTrigger.Conditions>
                                                    <Condition Property="IsChecked" Value="True"/>
                                                    <Condition Property="IsMouseOver" Value="True"/>
                                                </MultiTrigger.Conditions>
                                                <Setter TargetName="border" Property="Background" Value="{DynamicResource PinkButtonHoveredBrush}"/>
                                            </MultiTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </RadioButton.Template>
                            </RadioButton>
                            <RadioButton x:Name="RbHypnoTube" x:FieldModifier="internal" Content="{loc:Str btn_hypnotube}" GroupName="BrowserSite"
                                         Click="BrowserSiteToggle_Click"
                                         Foreground="{DynamicResource TextLightBrush}" FontSize="10" Cursor="Hand" Margin="2,1">
                                <RadioButton.Template>
                                    <ControlTemplate TargetType="RadioButton">
                                        <!-- Polish wave 10: a raised pill (bevel + sheen) that sits PRESSED IN
                                             (ActiveSinkPx, pressed bevel and shade) while it is the site. -->
                                        <Border x:Name="border" Background="Transparent" CornerRadius="8"
                                                BorderBrush="{DynamicResource DepthRaisedBevel}" BorderThickness="1">
                                            <Border.RenderTransform>
                                                <TranslateTransform/>
                                            </Border.RenderTransform>
                                            <Border x:Name="face" CornerRadius="7" Padding="7,2" Background="{DynamicResource DepthRaisedSheen}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="RenderTransform"><Setter.Value><TranslateTransform Y="-1"/></Setter.Value></Setter>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="{DynamicResource PinkBrush}"/>
                                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource DepthPressedBevel}"/>
                                                <Setter TargetName="face" Property="Background" Value="{DynamicResource DepthPressedShade}"/>
                                                <Setter TargetName="border" Property="RenderTransform"><Setter.Value><TranslateTransform Y="1"/></Setter.Value></Setter>
                                                <Setter Property="Foreground" Value="White"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="border" Property="RenderTransform"><Setter.Value><TranslateTransform Y="2"/></Setter.Value></Setter>
                                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource DepthPressedBevel}"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#353565"/>
                                            </Trigger>
                                            <MultiTrigger>
                                                <MultiTrigger.Conditions>
                                                    <Condition Property="IsChecked" Value="True"/>
                                                    <Condition Property="IsMouseOver" Value="True"/>
                                                </MultiTrigger.Conditions>
                                                <Setter TargetName="border" Property="Background" Value="{DynamicResource PinkButtonHoveredBrush}"/>
                                            </MultiTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </RadioButton.Template>
                            </RadioButton>
                            </StackPanel>
                        </Border>
                        <!-- Reload / Home button - sits just right of the site toggle.
                             Reloads the current site's homepage; gives a way out of a
                             stuck/blank page (e.g. after a remote video is stopped), since
                             re-clicking an already-selected site radio won't reload. -->
                        <Button Grid.Column="2" x:Name="BtnReloadBrowser"
                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                Click="BtnReloadBrowser_Click"
                                ToolTip="{loc:Str tooltip_reload_browser}"
                                FontSize="11" Padding="6,3" Margin="8,0,0,0">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="{DynamicResource TransparentPinkBrush}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource PinkBrush}"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource TransparentPink50Brush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                            <helpers:EmojiTextBlock Text="🔄"/>
                        </Button>
                        <!-- The fold arrow (owner, 2026-10-06: "put an unmissable dropdown arrow here on
                             top of the browser, the little grey icon we got is basically invisible").
                             It lives in the header's empty middle, the star column the reload button
                             only uses the left edge of; the left margin keeps it clear of that button.
                             Down arrow + "Show browser" = the card is shut and this opens it, up arrow +
                             "Hide browser" = it is open and this shuts it. The hue, the label, the
                             tooltip and the breathing glow while folded are all painted by
                             SettingsTabView.PaintFoldArrow from MainWindow.DashboardFold.cs, because the
                             setting (AppSettings.DashboardBrowserCollapsed), not this button, is the
                             truth. The values below are only the first paint: Home's lilac at 24% fill,
                             a 70% border, 40% fill on hover (Tag carries the hover brush). -->
                        <Button Grid.Column="2" x:Name="BtnFoldBrowser" x:FieldModifier="internal"
                                Click="BtnFoldBrowser_Click" Cursor="Hand"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                MinWidth="120" Height="26" Padding="12,0" Margin="48,0,8,0"
                                Background="#3DB79CFF" BorderBrush="#B3B79CFF" BorderThickness="1.5"
                                ToolTip="{loc:Str tooltip_browser_unfold}"
                                AutomationProperties.Name="{loc:Str btn_browser_fold_show}">
                            <Button.Tag>
                                <SolidColorBrush Color="#66B79CFF"/>
                            </Button.Tag>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="FoldPlate" Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="13" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="FoldPlate" Property="Background"
                                                    Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="TxtFoldBrowser" x:FieldModifier="internal"
                                           Text="&#xE70D;" FontSize="16"
                                           FontFamily="Segoe MDL2 Assets, Segoe UI Symbol, Segoe UI"
                                           Foreground="White" VerticalAlignment="Center" Margin="0,1,8,0"/>
                                <TextBlock x:Name="TxtFoldBrowserLabel" x:FieldModifier="internal"
                                           Text="{loc:Str btn_browser_fold_show}"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="White" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <!-- Status indicator -->
                        <TextBlock Grid.Column="3" x:Name="TxtBrowserStatus" x:FieldModifier="internal" Text="{loc:Str label_loading}"
                                   Foreground="{DynamicResource PinkBrush}" FontSize="10"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <!-- Deeper auto-bind badge (Phase 9). Shows when an enhancement is active for the current page. -->
                        <Border Grid.Column="3" x:Name="DeeperBrowserBadge" x:FieldModifier="internal" Visibility="Collapsed"
                                Background="{DynamicResource DeeperAccentTransparent20Brush}"
                                BorderBrush="{DynamicResource DeeperAccentBrush}" BorderThickness="1"
                                CornerRadius="3" Padding="6,1" Margin="0,0,8,0"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                ToolTip="{Binding ElementName=DeeperBrowserBadge, Path=Tag}">
                            <helpers:EmojiTextBlock x:Name="TxtDeeperBrowserBadge" x:FieldModifier="internal"
                                       Text="🌊 Deeper"
                                       Foreground="{DynamicResource DeeperAccentBrush}"
                                       FontSize="9" FontWeight="SemiBold"/>
                        </Border>
                        <!-- Webcam Tracking toggle - inline, sits between status badge and pop-out.
                             Off: "📷 Webcam"  On: "📷 Webcam On" (label updated in code-behind
                             from OnTrackingStateChanged). Click runs the consent → calibrate →
                             start flow if needed; second click stops tracking. -->
                        <Button Grid.Column="4" x:Name="BtnWebcamTracking" x:FieldModifier="internal"
                                Click="BtnWebcamTracking_Click"
                                ToolTip="{loc:Str tooltip_browser_webcam_tracking_off}"
                                FontSize="9" Padding="6,3" Margin="0,0,6,0" VerticalAlignment="Center">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="{DynamicResource TransparentPinkBrush}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource PinkBrush}"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource TransparentPink50Brush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                            <helpers:EmojiTextBlock x:Name="TxtWebcamTracking" x:FieldModifier="internal" Text="{loc:Str btn_browser_webcam_tracking_off}"/>
                        </Button>
                        <!-- Mute browser audio toggle (BambiCloud / HypnoTube video) -->
                        <Button Grid.Column="5" x:Name="BtnMuteBrowser" x:FieldModifier="internal"
                                Click="BtnMuteBrowser_Click" Cursor="Hand"
                                ToolTip="Mute / unmute browser audio (BambiCloud / HypnoTube)"
                                Background="Transparent" BorderThickness="0" Padding="5,2" Margin="4,0,0,0"
                                VerticalAlignment="Center">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource TransparentPink50Brush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <helpers:EmojiTextBlock x:Name="TxtBrowserMute" x:FieldModifier="internal" Text="🔊" FontSize="13"/>
                        </Button>
                        <!-- Pop Out button -->
                        <Button Grid.Column="6" x:Name="BtnPopOutBrowser" x:FieldModifier="internal" Content="{loc:Str btn_pop_out}"
                                Click="BtnPopOutBrowser_Click"
                                ToolTip="{loc:Str tooltip_pop_out_browser_to_resizable_window}"
                                FontSize="9" Padding="6,3" VerticalAlignment="Center">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="{DynamicResource PinkBrush}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource PinkButtonHoveredBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter Property="Background" Value="#E05A9E"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>

                    <!-- Browser Container. No fixed Height on purpose - see the Grid note above.
                         It fills the star row, so the WebView2's layout slot (and therefore its
                         native window) is always inside this card.
                         BrowserFoldBody is the whole of the card below the header, and the fold
                         collapses THIS element rather than BrowserContainer inside it. Two reasons.
                         One: BrowserContainer.Visibility already has owners (session start/stop,
                         the remote-control takeover, MainWindow.Settings) and a second writer would
                         fight them - a folded card must not un-hide a browser a running session hid.
                         Two: a Collapsed ancestor drives IsVisible=false on the WebView2's HwndHost,
                         which hides the native window itself; the control is never re-parented and
                         never disposed, so the page, its audio pipeline and the pop-out flow all
                         survive a fold and re-expanding shows the same page with no reload. -->
                    <!-- THE BEZEL (polish wave 10). The screen below is inset 5 px into a SUNKEN
                         ring; the ring wears the well bands. Airspace: the bands are declared
                         BEFORE the screen and live in the ring, so nothing is drawn over the
                         WebView2 rect. Follows the fold, so a folded card stays header-only. -->
                    <Border x:Name="BrowserBezel" x:FieldModifier="internal" Grid.Row="1"
                            Visibility="{Binding Visibility, ElementName=BrowserFoldBody}"
                            CornerRadius="9" ClipToBounds="True" IsHitTestVisible="False"
                            Background="{DynamicResource DepthWellFloorBrush}"
                            BorderBrush="{DynamicResource DepthPressedBevel}" BorderThickness="1">
                        <Grid>
                            <Rectangle Fill="{DynamicResource DepthWellTop}" Height="9" VerticalAlignment="Top"/>
                            <Rectangle Fill="{DynamicResource DepthWellLeft}" Width="6" HorizontalAlignment="Left"/>
                            <Rectangle Fill="{DynamicResource DepthWellFoot}" Height="1" VerticalAlignment="Bottom"/>
                        </Grid>
                    </Border>
                    <Border x:Name="BrowserFoldBody" x:FieldModifier="internal" Margin="5"
                            Grid.Row="1" Background="{DynamicResource SurfaceBgBrush}" CornerRadius="6" ClipToBounds="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
    
                            <!-- Deeper "Enhance if possible" toggle (always visible) -->
                            <Border x:Name="BrowserEnhanceToolbar" Grid.Row="0"
                                    Background="{DynamicResource PanelBgBrush}" Padding="8,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox x:Name="ToggleEnhanceIfPossible" x:FieldModifier="internal" Grid.Column="0"
                                              Content="{loc:Str browser_enhance_label}"
                                              Foreground="{DynamicResource TextLightBrush}" FontSize="11"
                                              VerticalAlignment="Center" Cursor="Hand"
                                              Checked="ToggleEnhanceIfPossible_Changed"
                                              Unchecked="ToggleEnhanceIfPossible_Changed"
                                              ToolTip="{loc:Str browser_enhance_tooltip}"/>
                                    <TextBlock x:Name="TxtEnhanceMatchStatus" x:FieldModifier="internal" Grid.Column="1"
                                               Text="{loc:Str browser_enhance_match_none}"
                                               Foreground="{DynamicResource TextMutedBrush}" FontSize="11"
                                               VerticalAlignment="Center"
                                               Margin="12,0,0,0" TextTrimming="CharacterEllipsis"/>
                                    <!-- User override: reveal the BambiCloud site toggle even on mods
                                         whose manifest hides it (issue #596). -->
                                    <CheckBox x:Name="ChkForceShowBambiCloud" x:FieldModifier="internal" Grid.Column="2"
                                              Content="{loc:Str browser_show_bambicloud_label}"
                                              Foreground="{DynamicResource TextMutedBrush}" FontSize="11"
                                              VerticalAlignment="Center" Cursor="Hand" Margin="12,0,0,0"
                                              Checked="ChkForceShowBambiCloud_Changed"
                                              Unchecked="ChkForceShowBambiCloud_Changed"
                                              ToolTip="{loc:Str browser_show_bambicloud_tooltip}"/>
                                </Grid>
                            </Border>
    
                            <!-- MOVED to Settings/Audio (Phase 3): AudioSyncLatencyPanel with
                                 SliderAudioSyncLatency / TxtAudioSyncLatency /
                                 SliderAudioSyncIntensity / TxtAudioSyncIntensity. They now live
                                 verbatim in Views/Controls/AppSettings/AudioSettingsSection.xaml
                                 and are reached as AppSettingsTab.<Name> - the same passthrough
                                 pattern Phase 2 used for the rest of AudioSection.
                                 Grid.Row="1" is deliberately left EMPTY rather than renumbered:
                                 BrowserContainer keeps Grid.Row="2", so the browser's layout slot
                                 (and therefore the native WebView2's window) does not move a pixel.
                                 An Auto row with no child measures 0.

                                 2026-08-11: the row is empty no longer. The owner missed having
                                 audio on the dashboard ("was pretty handy to have it on screen"),
                                 so the two dials that actually get touched mid-session - master
                                 volume and ducking - come back HERE, in the slot their neighbours
                                 vacated. Deliberately NOT a second AudioSettingsSection: that
                                 control's children are re-published as AppSettingsTab.<Name> and
                                 written directly by MainWindow, so a second instance would render
                                 stale values and fight the canonical one. These two mirror the
                                 canonical controls through MainWindow.HomeAudio.cs instead, which
                                 is the same two-surface pattern SliderAudioSyncLatency already
                                 uses with the Haptics panel. -->

                            <Border Grid.Row="1" x:Name="HomeAudioCard" x:FieldModifier="internal"
                                    CornerRadius="10" Padding="10,9" Margin="0,0,0,12"
                                    Background="{DynamicResource ElevatedSurfaceBrush}"
                                    BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1">
                                <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <helpers:EmojiTextBlock Grid.Column="0" Text="{loc:Str section_audio}"
                                                            Foreground="{DynamicResource PinkBrush}"
                                                            FontSize="12" FontWeight="Bold"
                                                            VerticalAlignment="Center" Margin="0,0,10,0"/>

                                    <Slider Grid.Column="1" x:Name="HomeSliderMaster" x:FieldModifier="internal"
                                            Minimum="0" Maximum="100" VerticalAlignment="Center"
                                            ValueChanged="HomeSliderMaster_Changed"
                                            ToolTip="{loc:Str tooltip_master_volume_for_all_audio}"/>

                                    <TextBlock Grid.Column="2" x:Name="HomeTxtMaster" x:FieldModifier="internal"
                                               Text="50%" Foreground="{DynamicResource TextMutedBrush}"
                                               FontSize="11" VerticalAlignment="Center"
                                               Width="34" TextAlignment="Right" Margin="8,0,12,0"/>

                                    <CheckBox Grid.Column="3" x:Name="HomeChkAudioDuck" x:FieldModifier="internal"
                                              Content="{loc:Str label_duck}"
                                              Foreground="{DynamicResource TextMutedBrush}" FontSize="11"
                                              VerticalAlignment="Center" Cursor="Hand"
                                              Checked="HomeChkAudioDuck_Changed"
                                              Unchecked="HomeChkAudioDuck_Changed"
                                              ToolTip="{loc:Str tooltip_automatically_reduce_other_app_volumes_during}"/>

                                    <!-- The old dashboard's BtnAudioAdvanced disclosure, restored:
                                         master + duck stay on the face, everything else is one
                                         click away. Same rows, same order as before the
                                         restructure. -->
                                    <ToggleButton Grid.Column="4" x:Name="HomeBtnAudioAdvanced" x:FieldModifier="internal"
                                                  Margin="10,0,0,0" VerticalAlignment="Center" Cursor="Hand"
                                                  Checked="HomeBtnAudioAdvanced_Changed"
                                                  Unchecked="HomeBtnAudioAdvanced_Changed"
                                                  ToolTip="{loc:Str tooltip_show_advanced_audio_settings}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent" Padding="4,0">
                                                    <TextBlock x:Name="arrow" Text="&#x25BE;" FontSize="13"
                                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="arrow" Property="Text" Value="&#x25B4;"/>
                                                        <Setter TargetName="arrow" Property="Foreground"
                                                                Value="{DynamicResource PinkBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="arrow" Property="Foreground"
                                                                Value="{DynamicResource PinkBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                    </Grid>

                                    <!-- Advanced rows. Every control here MIRRORS its twin in
                                         Settings · Audio (MainWindow.HomeAudio.cs) - none of them
                                         owns state. -->
                                    <StackPanel x:Name="HomeAudioAdvanced" x:FieldModifier="internal"
                                                Visibility="Collapsed" Margin="0,8,0,0">

                                        <Grid Margin="0,0,0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{loc:Str setting_video}" FontSize="11"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       VerticalAlignment="Center"
                                                       ToolTip="{loc:Str tooltip_volume_for_mandatory_videos}"/>
                                            <Slider Grid.Column="1" x:Name="HomeSliderVideoVolume" x:FieldModifier="internal"
                                                    Minimum="0" Maximum="100" VerticalAlignment="Center"
                                                    ValueChanged="HomeSliderVideoVolume_Changed"
                                                    ToolTip="{loc:Str tooltip_separate_volume_control_for_videos}"/>
                                            <TextBlock Grid.Column="2" x:Name="HomeTxtVideoVolume" x:FieldModifier="internal"
                                                       Text="50%" FontSize="11" Width="34" TextAlignment="Right"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        </Grid>

                                        <Grid Margin="0,0,0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{loc:Str label_duck}" FontSize="11"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       VerticalAlignment="Center"
                                                       ToolTip="{loc:Str tooltip_how_much_to_reduce_other_audio}"/>
                                            <Slider Grid.Column="1" x:Name="HomeSliderDuck" x:FieldModifier="internal"
                                                    Minimum="0" Maximum="100" VerticalAlignment="Center"
                                                    ValueChanged="HomeSliderDuck_Changed"
                                                    ToolTip="{loc:Str tooltip_ducking_percentage_80_reduce_other_audio_to_2}"/>
                                            <TextBlock Grid.Column="2" x:Name="HomeTxtDuck" x:FieldModifier="internal"
                                                       Text="80%" FontSize="11" Width="34" TextAlignment="Right"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        </Grid>

                                        <Grid Margin="0,0,0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{loc:Str setting_output}" FontSize="11"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       VerticalAlignment="Center"
                                                       ToolTip="{loc:Str tooltip_audio_output_device}"/>
                                            <ComboBox Grid.Column="1" x:Name="HomeCmbAudioOutputDevice" x:FieldModifier="internal"
                                                      FontSize="11" VerticalAlignment="Center"
                                                      SelectionChanged="HomeCmbAudioOutputDevice_SelectionChanged"
                                                      ToolTip="{loc:Str tooltip_audio_output_device}"/>
                                            <Button Grid.Column="2" x:Name="HomeBtnAudioOutputRefresh" Content="↻"
                                                    FontSize="11" Margin="6,0,0,0" Padding="8,2" Cursor="Hand"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Click="HomeBtnAudioOutputRefresh_Click"
                                                    ToolTip="{loc:Str set2_tooltip_audio_output_refresh}"/>
                                        </Grid>

                                        <CheckBox x:Name="HomeChkExcludeBambiCloudDucking" x:FieldModifier="internal"
                                                  Content="{loc:Str setting_don_t_duck_browser}"
                                                  Foreground="{DynamicResource TextMutedBrush}" FontSize="11"
                                                  Cursor="Hand" Margin="0,0,0,6"
                                                  Checked="HomeChkExcludeBambiCloudDucking_Changed"
                                                  Unchecked="HomeChkExcludeBambiCloudDucking_Changed"
                                                  ToolTip="{loc:Str tooltip_when_enabled_audio_from_the_integrated_bambic}"/>

                                        <StackPanel Orientation="Horizontal">
                                            <Button x:Name="HomeBtnTestAudio" Content="{loc:Str set2_btn_test_audio}"
                                                    FontSize="11" Margin="0,0,8,0" Cursor="Hand"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Click="HomeBtnTestAudio_Click"
                                                    ToolTip="{loc:Str set2_tooltip_test_audio}"/>
                                            <Button x:Name="HomeBtnAudioLayers" Content="{loc:Str btn_audio_layers}"
                                                    FontSize="11" Cursor="Hand"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Click="HomeBtnAudioLayers_Click"
                                                    ToolTip="{loc:Str tooltip_audio_layers}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Grid x:Name="BrowserContainer" x:FieldModifier="internal" Grid.Row="2">
                                <!-- WebView2 will be added here programmatically -->
                                <helpers:EmojiTextBlock x:Name="BrowserLoadingText" x:FieldModifier="internal"
                                           Text="{loc:Str label_click_to_load_browser}"
                                           Foreground="{DynamicResource TextMutedBrush}" FontSize="12"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Cursor="Hand"
                                           MouseLeftButtonDown="BrowserLoadingText_Click"/>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- ============================================================ -->
            <!-- THE TONIGHT BOARD (2026-10-07). What sits in the row the     -->
            <!-- folded browser gives back: a deck of cards ranked Live,      -->
            <!-- Board, Waiting, Resume, Event, Showcase/Tip, House, one at a -->
            <!-- time, with labelled chips under it. The card host is code   -->
            <!-- (Controls/Billboard/BillboardCardHost), dropped into         -->
            <!-- BillboardHostSlot by MainWindow.DashboardBillboard.cs, so it -->
            <!-- carries no namescope of its own.                             -->
            <!-- ============================================================ -->
            <Border x:Name="DashBillboard" x:FieldModifier="internal" Grid.Row="1"
                    Visibility="Collapsed" Margin="0,0,0,12"
                    CornerRadius="12" ClipToBounds="True"
                    Background="{DynamicResource DepthWellFloorBrush}"
                    BorderBrush="{DynamicResource DepthPressedBevel}" BorderThickness="1">
                <Grid>
                    <Grid x:Name="BillboardHostSlot" x:FieldModifier="internal" Margin="8,8,8,4"/>
                    <!-- The billboard is a SUNKEN well (polish wave 10): the bands lie over the
                         card's rim, under nothing that is pressed. -->
                    <Rectangle x:Name="BillboardWellTop" x:FieldModifier="internal" Fill="{DynamicResource DepthWellTop}"
                               Height="9" VerticalAlignment="Top" IsHitTestVisible="False"/>
                    <Rectangle Fill="{DynamicResource DepthWellLeft}" Width="6" HorizontalAlignment="Left" IsHitTestVisible="False"/>
                    <Rectangle Fill="{DynamicResource DepthWellFoot}" Height="1" VerticalAlignment="Bottom" IsHitTestVisible="False"/>
                </Grid>
            </Border>

            <!-- ============================================================ -->
            <!-- ACCOUNT STRIP (Phase 3, one line since nav polish wave 5).    -->
            <!--                                                               -->
            <!-- Owner, 2026-10-06, after the wave-4 build: compact the strip  -->
            <!-- and the bubble row under it into ONE line. Left to right:     -->
            <!-- the starred name alone (the "Logged in as" caption is its     -->
            <!-- tooltip now, the pink card around it is gone: the line is the -->
            <!-- card), Link phone and Logout as glass bubbles (Logout keeps a -->
            <!-- pink fill: it is the dangerous one), a divider, the Discord   -->
            <!-- pill (the one call to action a newcomer should see without    -->
            <!-- hovering, so it keeps its label), the Rich Presence switch as -->
            <!-- a status bubble (lit when on; nobody read "RP"), a divider,   -->
            <!-- the five quick bubbles, and the "?" at the end. One           -->
            <!-- HoverBubbleBar dresses every glyph button so one label opens  -->
            <!-- at a time and the idle pulse walks the whole line. The row    -->
            <!-- the bubbles used to take (40 px) went back to the mosaic.     -->
            <!--                                                               -->
            <!-- Settings - Account has been the real account page since        -->
            <!-- Phase 2, so this is the glance-and-go surface, not the editor. -->
            <!-- It is NOT redundant markup: every x:Name below is written by   -->
            <!-- live code and none may be dropped before Phase 8 -             -->
            <!--   BtnUnifiedLogin ............ Login.cs:337, UiUpdates.cs      -->
            <!--                                offline gating (:3022)          -->
            <!--   LoggedInStatusPanel ........ Login.cs:338 (Link phone and    -->
            <!--                                Logout follow its Visibility)   -->
            <!--   TxtLoggedInName ............ Login.cs:346/:351 (incl. the    -->
            <!--                                OG star prefix)                 -->
            <!--   ChkQuickDiscordRichPresence  AccountShell.cs:291/:302 mirror -->
            <!--                                + MainWindow.xaml.cs:2397 load  -->
            <!--   HelpBtnQuickLinks .......... Presets.cs:49 SetHelpContent    -->
            <!--                                ("QuickLinks")                  -->
            <!--   VelvetBtnSystem is the ONLY route to MainWindow.CardSystem_  -->
            <!--   Click (the System popup, its mod-aware title, Notify-        -->
            <!--   FeatureOpened "System"): never retire it without moving the  -->
            <!--   handler. VelvetBtnSchedulerRamp navigates to the Studio rack;-->
            <!--   VelvetBtnCatalogue opens app.cclabs.app/catalogue.           -->
            <!-- The "?" popover still explains the strip.                      -->
            <!-- ============================================================ -->
            <!-- THE LEDGE (polish wave 10): the strip throws LedgeUpPx of shadow up onto what
                 sits above it (in the card's bottom margin, clear of the WebView2 rect) and a
                 RaisedPx drop band onto the sheet below it. Both hit-test off. -->
            <Rectangle x:Name="AccountLedgeUp" x:FieldModifier="internal" Grid.Row="2" Height="14"
                       VerticalAlignment="Top" Margin="8,-14,8,0" IsHitTestVisible="False"
                       Fill="{DynamicResource DepthLedgeUp}"/>
            <Rectangle x:Name="AccountStripDrop" x:FieldModifier="internal" Grid.Row="2" Height="3"
                       VerticalAlignment="Bottom" Margin="6,0,6,-3" IsHitTestVisible="False"
                       RadiusX="3" RadiusY="3" Fill="{DynamicResource HomeDepthDropBand}"/>
            <Border x:Name="AccountStrip" x:FieldModifier="internal" Grid.Row="2" CornerRadius="12" Padding="9,6"
                    Background="{DynamicResource ElevatedSurfaceBrush}"
                    BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- The ledge's lit top (polish wave 10): the raised sheen, under every control. -->
                    <Border x:Name="AccountStripSheen" x:FieldModifier="internal" Grid.ColumnSpan="3" Margin="-9,-6"
                            CornerRadius="11" IsHitTestVisible="False" Background="{DynamicResource DepthRaisedSheen}"/>

                    <!-- The logged-out and logged-in faces share ONE cell: MainWindow.Login.cs
                         flips exactly these two Visibilities against each other, so they must
                         never be able to claim two slots' worth of width between them. -->
                    <Grid Grid.Column="0" Margin="0,0,10,0">
                        <!-- Unified Login Button -->
                        <Button x:Name="BtnUnifiedLogin" x:FieldModifier="internal" Content="{loc:Str btn_login_2}"
                                Click="BtnUnifiedLogin_Click"
                                Padding="14,7" HorizontalAlignment="Left" VerticalAlignment="Center"
                                ToolTip="{loc:Str tooltip_login_with_discord_or_patreon}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="{DynamicResource PinkBrush}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#E055A0"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter Property="Background" Value="#C04888"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- Logged In Status (shown when logged in): the name alone. No caption,
                             no card; the "Logged in as" line is the name's tooltip. -->
                        <Border x:Name="LoggedInStatusPanel" x:FieldModifier="internal" Visibility="Collapsed"
                                Background="Transparent" Padding="4,0" HorizontalAlignment="Left"
                                VerticalAlignment="Center" ToolTip="{loc:Str label_logged_in_as}">
                            <TextBlock x:Name="TxtLoggedInName" x:FieldModifier="internal" Text="{loc:Str label_username}"
                                       Foreground="White" FontWeight="Bold" FontSize="15" MaxWidth="220"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="#FF69B4" BlurRadius="10" ShadowDepth="0" Opacity="0.65"/>
                                </TextBlock.Effect>
                            </TextBlock>
                        </Border>
                    </Grid>

                    <!-- The line: every button with a Glyph is a 34 px bubble (HoverBubbleBar
                         dresses them); the Discord pill and the dividers carry no Glyph and are
                         left alone. Link phone, Logout and their divider follow the logged-in
                         face's Visibility, so a signed-out strip reads Login | Discord | ... -->
                    <fx:HoverBubbleBar x:Name="HomeBubbleBar" x:FieldModifier="internal" Grid.Column="1"
                                       HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="BtnLinkPhone" x:FieldModifier="internal"
                                Click="BtnLinkPhone_Click"
                                Visibility="{Binding Visibility, ElementName=LoggedInStatusPanel}"
                                ToolTip="Sign in to the CCP mobile app by scanning a QR code"
                                fx:HoverBubbleBar.Glyph="&#xE8EA;"
                                fx:HoverBubbleBar.LabelKeys="btn_home_link_phone"/>
                        <!-- Logout keeps the pink fill: still the dangerous one at a glance. -->
                        <Button x:Name="BtnQuickLogout" x:FieldModifier="internal"
                                Click="BtnQuickLogout_Click"
                                Visibility="{Binding Visibility, ElementName=LoggedInStatusPanel}"
                                ToolTip="{loc:Str btn_logout}"
                                fx:HoverBubbleBar.Glyph="&#xE7E8;"
                                fx:HoverBubbleBar.Fill="#FF69B4"
                                fx:HoverBubbleBar.LabelKeys="btn_logout"/>
                        <Border x:Name="AccountStripDivider" x:FieldModifier="internal" Style="{StaticResource AccountStripDividerStyle}"
                                Visibility="{Binding Visibility, ElementName=LoggedInStatusPanel}"/>

                        <!-- Discord Join Button: the one labelled pill on the line. -->
                        <Button x:Name="BtnJoinDiscord" x:FieldModifier="internal" Click="BtnDiscord_Click"
                                ToolTip="{loc:Str tooltip_join_the_discord_community}" Cursor="Hand"
                                VerticalAlignment="Center">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="border" Background="#5865F2" CornerRadius="17" Height="34"
                                                        Padding="14,0" HorizontalAlignment="Stretch">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Image Width="13" Height="13" VerticalAlignment="Center"
                                                               Source="{Binding Source='💬', Converter={StaticResource EmojiToImageSource}}"/>
                                                        <TextBlock Text="{loc:Str label_join_discord}" Foreground="White" FontSize="11" FontWeight="Bold"
                                                                   VerticalAlignment="Center" Margin="6,0,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="border" Property="Background" Value="#6C75F2"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- Rich Presence as a status bubble: lit when on. Still the CheckBox the
                             AccountShell mirror writes (IsChecked), just dressed by the bar. -->
                        <CheckBox x:Name="ChkQuickDiscordRichPresence" x:FieldModifier="internal"
                                  Checked="ChkDiscordRichPresence_Changed" Unchecked="ChkDiscordRichPresence_Changed"
                                  fx:HoverBubbleBar.Glyph="&#xE7FC;"
                                  fx:HoverBubbleBar.LabelKeys="btn_home_discord_status">
                            <CheckBox.ToolTip>
                                <ToolTip Background="{DynamicResource SurfaceBgBrush}" BorderBrush="{DynamicResource PinkBrush}" BorderThickness="1" Padding="10">
                                    <StackPanel MaxWidth="280">
                                        <TextBlock Text="{loc:Str label_discord_rich_presence}" Foreground="{DynamicResource PinkBrush}" FontSize="12" FontWeight="Bold" Margin="0,0,0,6"/>
                                        <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8">
                                            Shows "Playing Conditioning Control Panel" in your Discord status, along with your current level and session time.
                                        </TextBlock>
                                        <TextBlock Text="{loc:Str label_who_can_see_this}" Foreground="{DynamicResource SecondaryBrush}" FontSize="11" FontWeight="Bold" Margin="0,0,0,4"/>
                                        <TextBlock Foreground="{DynamicResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap">
                                            Only people who can already see your Discord activity status (friends, server members if enabled in your Discord privacy settings). This does NOT send notifications - it simply updates your "Currently Playing" status like any other game.
                                        </TextBlock>
                                    </StackPanel>
                                </ToolTip>
                            </CheckBox.ToolTip>
                        </CheckBox>
                        <Border Style="{StaticResource AccountStripDividerStyle}"/>

                        <!-- The five quick bubbles (nav polish wave 4). -->
                        <Button x:Name="VelvetBtnWebcam" x:FieldModifier="internal"
                                Click="VelvetBtnWebcam_Click"
                                fx:HoverBubbleBar.Glyph="&#xE722;"
                                fx:HoverBubbleBar.LabelKeys="btn_home_webcam_mic"/>
                        <Button x:Name="VelvetBtnSystem" x:FieldModifier="internal"
                                Click="VelvetBtnSystem_Click"
                                fx:HoverBubbleBar.Glyph="&#xE713;"
                                fx:HoverBubbleBar.LabelKeys="section_system"/>
                        <Button x:Name="VelvetBtnSchedulerRamp" x:FieldModifier="internal"
                                Click="VelvetBtnSchedulerRamp_Click"
                                fx:HoverBubbleBar.Glyph="&#xE787;"
                                fx:HoverBubbleBar.LabelKeys="section_scheduler+section_intensity_ramp"/>
                        <Button x:Name="VelvetBtnCatalogue" x:FieldModifier="internal"
                                Click="VelvetBtnCatalogue_Click"
                                ToolTip="Opens app.cclabs.app/catalogue in your browser"
                                fx:HoverBubbleBar.Glyph="&#xE8F1;"
                                fx:HoverBubbleBar.LabelKeys="btn_home_catalogue"/>
                        <Button x:Name="VelvetBtnAppInfo" x:FieldModifier="internal"
                                Click="VelvetBtnAppInfo_Click"
                                fx:HoverBubbleBar.Glyph="&#xE946;"
                                fx:HoverBubbleBar.LabelKeys="label_app_info"/>
                    </fx:HoverBubbleBar>

                    <Button x:Name="HelpBtnQuickLinks" x:FieldModifier="internal" Grid.Column="2"
                            Style="{StaticResource HelpButtonStyle}" Tag="QuickLinks"
                            VerticalAlignment="Center" Margin="10,0,0,0"/>
                </Grid>
            </Border>
        </Grid>
    
        <!-- Row 2 (Auto) is empty since nav polish wave 5: the five quick bubbles that sat here
             after wave 4 live on the account strip's one line now (see ACCOUNT STRIP above), and
             the 40 px went back to the mosaic. -->

        <!-- Scrolling Marquee Banner - row 3, spans all columns -->
        <Border x:Name="MarqueeBanner" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="4"
                Background="#1A0A1A" BorderBrush="{DynamicResource DarkPinkBrush}" BorderThickness="2"
                CornerRadius="8" Height="48" Margin="5,10,5,0" ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect Color="{DynamicResource DarkPink}" BlurRadius="15" ShadowDepth="0" Opacity="0.5"/>
            </Border.Effect>
            <!-- Chrome FX edge fade (PR-1, fixed in PR-5). The mask CANNOT live on MarqueeCanvas:
                 a relative-mapped OpacityMask is stretched over the masked visual's own bounds,
                 and the canvas's bounds are its overflowing child - a marquee string thousands of
                 pixels wide. A 6% fade of THAT is hundreds of pixels off-screen, which is exactly
                 why the fade was invisible in the shipped build.

                 Two changes fix it for good: the mask moves onto this wrapper, whose only child
                 clips itself (so the wrapper's bounds really are the 48px viewport), and the brush
                 is rebuilt in code with MappingMode=Absolute (MarqueeFadeHost_SizeChanged) so the
                 fade is a genuine ~40px at each end regardless of any bounding box at all. -->
            <Grid x:Name="MarqueeFadeHost" ClipToBounds="True"
                  SizeChanged="MarqueeFadeHost_SizeChanged">
            <Canvas x:Name="MarqueeCanvas" x:FieldModifier="internal" ClipToBounds="True">
                <TextBlock x:Name="MarqueeText" x:FieldModifier="internal"
                           Text="{loc:Str label_v5_2_1_is_out_thanks_to_all_the_100_patreons}"
                           FontFamily="Impact, Arial Black, Segoe UI" FontSize="28" FontWeight="Bold"
                           Foreground="{DynamicResource PinkBrush}" Canvas.Top="8">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="{DynamicResource DarkPink}" BlurRadius="8" ShadowDepth="0" Opacity="0.8"/>
                    </TextBlock.Effect>
                    <TextBlock.RenderTransform>
                        <TranslateTransform x:Name="MarqueeTransform"/>
                    </TextBlock.RenderTransform>
                </TextBlock>
            </Canvas>

            <!-- The interlude stage. A sibling of the canvas INSIDE the fade host, so a read is
                 clipped and edge-faded by exactly the same mask as the ticker and needs no
                 geometry of its own. Empty and invisible until MainWindow.MarqueeReads.cs takes
                 the ticker off stage; the acts build their own strip into it and clear it after.
                 Not hit-testable: nothing here is ever a target. -->
            <Grid x:Name="MarqueeRead" x:FieldModifier="internal" Opacity="0"
                  IsHitTestVisible="False" ClipToBounds="True">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="MarqueeReadTransform" x:FieldModifier="internal"/>
                </Grid.RenderTransform>
            </Grid>
            </Grid>
        </Border>
        </Grid>
</UserControl>
