<UserControl x:Class="ConditioningControlPanel.Views.Tabs.AvailableSubjectsTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:fx="clr-namespace:ConditioningControlPanel.Controls"
             xmlns:loc="clr-namespace:ConditioningControlPanel.Localization"
             mc:Ignorable="d"
             d:DesignHeight="640" d:DesignWidth="900">
    <!-- THE LOBBY (2026-10-02). Was the Available Subjects directory; the tab key, rail entry
         and palette row stay "availablesubjects". Three lists by state: open tables (Join),
         playing now (no button until a game can be watched), friends' tables. Rows come from
         App.Lobby (LobbyService); the host bar respects each game's own gate. -->
    <UserControl.Resources>
        <Style x:Key="LobbyPill" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{DynamicResource TransparentPink20Brush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderHoverBrush}"/>
            <Setter Property="FontFamily" Value="/Fonts/#Fredoka, Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="18" BorderThickness="1"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource TransparentPink40Brush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LobbyJoin" TargetType="Button">
            <Setter Property="Foreground" Value="#2A0618"/>
            <Setter Property="Background" Value="{DynamicResource PinkVibrantBrush}"/>
            <Setter Property="FontFamily" Value="/Fonts/#Fredoka, Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="18,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="14" Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.88"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LobbyEyebrow" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="/Fonts/#Fredoka, Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource PinkSoftBrush}"/>
            <Setter Property="Margin" Value="4,18,0,8"/>
        </Style>
        <DataTemplate x:Key="LobbyRowTemplate">
            <Border Margin="0,0,0,8" Padding="14,10" CornerRadius="14"
                    Background="#14FFFFFF" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Image Width="26" Height="26" Margin="0,0,12,0" VerticalAlignment="Center"
                           Source="{Binding GameIcon, Converter={StaticResource EmojiToImageSource}}"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextLightBrush}"
                                       FontFamily="/Fonts/#Fredoka, Segoe UI" FontSize="15" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"/>
                            <Ellipse Width="7" Height="7" Margin="8,2,0,0" VerticalAlignment="Center"
                                     Fill="#5FFFD0" ToolTip="{loc:Str lobby_friend_tip}"
                                     Visibility="{Binding Friend, Converter={StaticResource BoolToVisibility}}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding HasSummary, Converter={StaticResource BoolToVisibility}}"/>
                    </StackPanel>
                    <Border Grid.Column="2" Margin="12,0" VerticalAlignment="Center" CornerRadius="10" Padding="9,3"
                            Background="{DynamicResource TransparentPink20Brush}">
                        <TextBlock Text="{Binding GameLabel}" Foreground="{DynamicResource PinkSoftBrush}"
                                   FontSize="11" FontWeight="SemiBold"/>
                    </Border>
                    <Button Grid.Column="3" Style="{StaticResource LobbyJoin}" MinWidth="78"
                            Content="{Binding ButtonText}" Opacity="{Binding ButtonOpacity}"
                            Visibility="{Binding HasButton, Converter={StaticResource BoolToVisibility}}"
                            Click="BtnLobbyRow_Click"/>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="36,28,36,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- The tab's one looping FX, under everything (MainWindow.SubjectsFx registers it). -->
        <fx:AmbientFxCanvas x:Name="SubjectsAmbientFx" x:FieldModifier="internal" Grid.Row="0" Grid.RowSpan="3"/>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="{loc:Str tab_available_subjects}" Foreground="{DynamicResource TextLightBrush}"
                       FontFamily="/Fonts/#Fredoka, Segoe UI" FontSize="30" FontWeight="SemiBold"/>
            <TextBlock x:Name="TxtLobbyCount" x:FieldModifier="internal" Text="{loc:Str desc_available_subjects}"
                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Host bar: one pill per game. Locked pills stay visible with a lock; a click goes to the gate. -->
        <StackPanel Grid.Row="1" Orientation="Vertical">
            <WrapPanel Orientation="Horizontal">
                <Button x:Name="BtnHostChess" x:FieldModifier="internal" Style="{StaticResource LobbyPill}"
                        Content="{loc:Str lobby_host_chess}" Click="BtnHostChess_Click"/>
                <Button x:Name="BtnHostGoon" x:FieldModifier="internal" Style="{StaticResource LobbyPill}"
                        Content="{loc:Str lobby_host_goon}" Click="BtnHostGoon_Click"/>
                <Button x:Name="BtnBecomeASubject" x:FieldModifier="internal" Style="{StaticResource LobbyPill}"
                        Content="{loc:Str lobby_host_remote}" ToolTip="{loc:Str desc_optin_directory_consent}"
                        Click="BtnBecomeASubject_Click"/>
            </WrapPanel>
            <TextBlock x:Name="TxtBecomeASubjectSubtitle" x:FieldModifier="internal"
                       Text="{loc:Str desc_become_a_subject_locked}" Foreground="{DynamicResource TextDimBrush}"
                       FontSize="11" Margin="4,6,0,0" Visibility="Collapsed"/>
        </StackPanel>

        <ScrollViewer Grid.Row="2" x:Name="LobbyScroller" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Margin="0,6,0,0">
            <StackPanel MaxWidth="860" HorizontalAlignment="Stretch">
                <!-- Error: one line, the poll keeps trying behind it -->
                <Border x:Name="AvailableSubjectsErrorPanel" x:FieldModifier="internal" Visibility="Collapsed"
                        Margin="0,14,0,0" Padding="16,10" CornerRadius="12"
                        Background="#14FFFFFF" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1">
                    <TextBlock Text="{loc:Str lobby_error}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13"/>
                </Border>

                <!-- (1) Open tables -->
                <TextBlock Text="{loc:Str lobby_list_open}" Style="{StaticResource LobbyEyebrow}"/>
                <Border x:Name="AvailableSubjectsEmptyPanel" x:FieldModifier="internal" Visibility="Collapsed"
                        Padding="16,12" CornerRadius="12" Background="#0DFFFFFF"
                        BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1">
                    <TextBlock x:Name="TxtLobbyEmpty" x:FieldModifier="internal" Text="{loc:Str lobby_empty_open}"
                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13"/>
                </Border>
                <ItemsControl x:Name="AvailableSubjectsList" x:FieldModifier="internal"
                              ItemTemplate="{StaticResource LobbyRowTemplate}"/>

                <!-- (2) Playing now: hidden while empty -->
                <StackPanel x:Name="LobbyPlayingSection" x:FieldModifier="internal" Visibility="Collapsed">
                    <TextBlock Text="{loc:Str lobby_list_playing}" Style="{StaticResource LobbyEyebrow}"/>
                    <ItemsControl x:Name="LobbyPlayingList" x:FieldModifier="internal"
                                  ItemTemplate="{StaticResource LobbyRowTemplate}"/>
                </StackPanel>

                <!-- (3) Friends' tables: hidden while empty -->
                <StackPanel x:Name="LobbyFriendsSection" x:FieldModifier="internal" Visibility="Collapsed">
                    <TextBlock Text="{loc:Str lobby_list_friends}" Style="{StaticResource LobbyEyebrow}"/>
                    <ItemsControl x:Name="LobbyFriendsList" x:FieldModifier="internal"
                                  ItemTemplate="{StaticResource LobbyRowTemplate}"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
