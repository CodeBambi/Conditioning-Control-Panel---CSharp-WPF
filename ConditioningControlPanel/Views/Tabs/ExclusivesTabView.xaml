<UserControl x:Class="ConditioningControlPanel.Views.Tabs.ExclusivesTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:fx="clr-namespace:ConditioningControlPanel.Controls"
             xmlns:loc="clr-namespace:ConditioningControlPanel.Localization"
             mc:Ignorable="d"
             d:DesignHeight="620" d:DesignWidth="1460">

    <!-- ================================================================
         EXCLUSIVES — "The Velvet Vault"
         A living gallery replacing the old launcher popup. Three strata:
           1. The room  — painted backdrop under a dark scrim, with an
                          AmbientFxCanvas (fog + dust + aurora) breathing
                          over it. Backdrop is set in code-behind (disk
                          asset with a gradient fallback).
           2. The header — nebula ribbon band + Fredoka title + tier plates.
           3. The shelf  — spotlight hero (newest exclusive) + the card
                          grid, built from ExclusiveFeature.All by
                          MainWindow.Exclusives.cs. Cards never block
                          navigation; destination tabs own the real gates.
         ================================================================ -->
    <Border CornerRadius="12" ClipToBounds="True" Background="#12101F"
            BorderBrush="#33B478FF" BorderThickness="1">
        <Grid>
            <!-- 1. The room -->
            <Image x:Name="VaultBackdrop" x:FieldModifier="internal"
                   Stretch="UniformToFill" StretchDirection="Both" Opacity="0.9"/>
            <!-- scrim so content always reads over the painting -->
            <Border>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#D912101F" Offset="0"/>
                        <GradientStop Color="#9912101F" Offset="0.25"/>
                        <GradientStop Color="#C41A1430" Offset="0.62"/>
                        <GradientStop Color="#F012101F" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <fx:AmbientFxCanvas x:Name="ExclusivesAmbientFx" x:FieldModifier="internal"/>

            <!-- 2 + 3. Content -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="26,20,26,22">

                    <!-- Header: ribbon band + title + tier plates -->
                    <Border Height="58" CornerRadius="10" Margin="0,0,0,20"
                            BorderBrush="#59B478FF" BorderThickness="1" ClipToBounds="True">
                        <Border.Background>
                            <ImageBrush ImageSource="/Resources/programs/banner_default.png"
                                        Stretch="UniformToFill" AlignmentX="Right"/>
                        </Border.Background>
                        <Grid>
                            <!-- darken the band's left side so the title pops -->
                            <Border>
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#F21A1A2E" Offset="0"/>
                                        <GradientStop Color="#8C1A1A2E" Offset="0.4"/>
                                        <GradientStop Color="#261A1A2E" Offset="0.75"/>
                                        <GradientStop Color="#661A1A2E" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Grid Margin="20,0,16,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{loc:Str exclusives_vault_title}"
                                           FontFamily="/Fonts/#Fredoka" FontWeight="SemiBold"
                                           FontSize="27" Foreground="White"
                                           VerticalAlignment="Center">
                                    <TextBlock.Effect>
                                        <DropShadowEffect Color="#FF69B4" BlurRadius="18"
                                                          ShadowDepth="0" Opacity="0.85"/>
                                    </TextBlock.Effect>
                                </TextBlock>
                                <TextBlock Grid.Column="1" Text="{loc:Str exclusives_vault_sub}"
                                           Foreground="#C9C2DD" FontSize="12"
                                           VerticalAlignment="Center" Margin="18,2,12,0"
                                           TextTrimming="CharacterEllipsis"/>
                                <!-- Tier plates (previously unused art). The one matching the
                                     user's entitlement gets full opacity + a breathing glow;
                                     see RefreshExclusivesTab. -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <Image x:Name="TierPlate1" x:FieldModifier="internal"
                                           Source="/Resources/Patreon tier1.png"
                                           Height="30" Margin="0,0,8,0" Opacity="0.3"/>
                                    <Image x:Name="TierPlate2" x:FieldModifier="internal"
                                           Source="/Resources/Patreon tier2.png"
                                           Height="30" Opacity="0.3"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Spotlight: the newest exclusive, hero-sized -->
                    <Border x:Name="SpotlightCard" x:FieldModifier="internal"
                            Height="250" CornerRadius="14" Margin="0,0,0,22"
                            Background="#EE1A1A2E" BorderBrush="#66FF69B4" BorderThickness="1"
                            Cursor="Hand" MouseLeftButtonUp="Spotlight_MouseUp">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.35*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Art. The band is ~5:1, so the source is cropped, never
                                 stretched: Stretch stays UniformToFill and the source
                                 (wide BannerArtResource, else the card art) plus the
                                 zoom origin are set by ApplySpotlightArt. Rounded clip
                                 comes from RoundClipOnResize(SpotArtHost, 14).
                                 Ken Burns drift applied in code, honours motion prefs. -->
                            <Border x:Name="SpotArtHost" x:FieldModifier="internal"
                                    Grid.Column="0" Grid.ColumnSpan="2" ClipToBounds="True"
                                    CornerRadius="14">
                                <Image x:Name="SpotArtImage" x:FieldModifier="internal"
                                       Stretch="UniformToFill" RenderTransformOrigin="0.5,0.5">
                                    <Image.RenderTransform>
                                        <ScaleTransform x:Name="SpotArtScale" ScaleX="1" ScaleY="1"/>
                                    </Image.RenderTransform>
                                </Image>
                            </Border>
                            <!-- fade the art into the copy column -->
                            <Border Grid.Column="0" Grid.ColumnSpan="2">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#001D1B33" Offset="0.42"/>
                                        <GradientStop Color="#D91D1B33" Offset="0.68"/>
                                        <GradientStop Color="#FA1D1B33" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

                            <!-- copy -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                        Margin="26,0,30,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,9">
                                    <TextBlock Text="{loc:Str exclusives_just_shipped}"
                                               Foreground="#FFD27A" FontSize="11"
                                               FontWeight="Bold" VerticalAlignment="Center"/>
                                    <Border x:Name="SpotBadge" x:FieldModifier="internal"
                                            CornerRadius="10" Padding="8,2" Margin="10,0,0,0"
                                            VerticalAlignment="Center">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#FF69B4" Offset="0"/>
                                                <GradientStop Color="#B478FF" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <TextBlock x:Name="TxtSpotBadge" x:FieldModifier="internal"
                                                   Foreground="White" FontSize="10" FontWeight="Bold"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock x:Name="TxtSpotTitle" x:FieldModifier="internal"
                                           FontFamily="/Fonts/#Fredoka" FontWeight="SemiBold"
                                           FontSize="30" Foreground="White">
                                    <TextBlock.Effect>
                                        <DropShadowEffect Color="#FF69B4" BlurRadius="20"
                                                          ShadowDepth="0" Opacity="0.5"/>
                                    </TextBlock.Effect>
                                </TextBlock>
                                <TextBlock x:Name="TxtSpotTagline" x:FieldModifier="internal"
                                           Foreground="#B8B1CC" FontSize="14" TextWrapping="Wrap"
                                           Margin="0,8,0,0" LineHeight="21"/>
                                <Button x:Name="BtnSpotOpen" x:FieldModifier="internal"
                                        Style="{StaticResource ActionButton}"
                                        Content="{loc:Str exclusives_enter}"
                                        HorizontalAlignment="Left" Margin="0,16,0,0"
                                        Padding="24,8" Click="Spotlight_Click"/>
                            </StackPanel>

                            <!-- locked veil (decoration only; navigation stays live) -->
                            <Border x:Name="SpotVeil" x:FieldModifier="internal"
                                    Grid.Column="0" Grid.ColumnSpan="2" CornerRadius="14"
                                    Visibility="Collapsed" IsHitTestVisible="False">
                                <Border.Background>
                                    <RadialGradientBrush GradientOrigin="0.4,0.5" Center="0.4,0.5"
                                                         RadiusX="0.8" RadiusY="0.9">
                                        <GradientStop Color="#801E1632" Offset="0"/>
                                        <GradientStop Color="#D20C0A18" Offset="1"/>
                                    </RadialGradientBrush>
                                </Border.Background>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock x:Name="SpotVeilLock" x:FieldModifier="internal"
                                               Text="🔒" FontSize="44" HorizontalAlignment="Center"/>
                                    <Border CornerRadius="12" Padding="14,5" Margin="0,10,0,0">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#E6FF69B4" Offset="0"/>
                                                <GradientStop Color="#D9B478FF" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <TextBlock FontSize="11" FontWeight="Bold" Foreground="White"
                                                   Text="{loc:Str exclusives_chip_lab}"/>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Collection label -->
                    <Grid Margin="2,0,2,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{loc:Str exclusives_collection}"
                                   FontFamily="/Fonts/#Fredoka" FontWeight="Medium"
                                   FontSize="16" Foreground="White"/>
                        <Rectangle Grid.Column="1" Height="1" Margin="14,0"
                                   VerticalAlignment="Center">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#80FF69B4" Offset="0"/>
                                    <GradientStop Color="#00FF69B4" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <TextBlock Grid.Column="2" Text="{loc:Str exclusives_more_soon}"
                                   Foreground="#9A93B8" FontSize="11" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- The shelf. Cards are built from ExclusiveFeature.All in
                         MainWindow.Exclusives.cs - this panel stays empty in XAML. -->
                    <WrapPanel x:Name="ExclusivesShelf" x:FieldModifier="internal"
                               Orientation="Horizontal"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
