<UserControl x:Class="ConditioningControlPanel.Views.Controls.Studio.BrainDrainFeatureControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="clr-namespace:ConditioningControlPanel.Localization"
             xmlns:helpers="clr-namespace:ConditioningControlPanel.Helpers"
             xmlns:feat="clr-namespace:ConditioningControlPanel.Features"
             mc:Ignorable="d" d:DesignWidth="488">

    <!-- ================================================================
         STUDIO RACK · BRAIN DRAIN  (Phase 4 rescue of gap-report G2)

         Brain Drain had no reachable UI. Its only markup lived in
         Views/Tabs/ProgressionTabView.xaml (deleted in Phase 8), inside a
         permanently Collapsed ghost tab, under a comment that literally read
         "Hidden elements to prevent XAML binding errors" - the three
         controls carried NO Checked/ValueChanged attributes at all, so
         MainWindow.LevelFeatures.cs was dead code end to end (Phase 8
         deleted that file too). Meanwhile
         the settings stayed fully live and writable from DTRH, the Deeper
         editor, presets (Models/Preset.cs:413) and the autonomy voice
         commands, i.e. the feature could be turned ON for a user with no
         switch anywhere in the app to turn it back off. That is the gap.

         TWO HALVES, ONE SETTING - read this before changing the copy:
          - AUDIO (Services/LockCard/BrainDrainService.cs) is fully alive.
            BrainDrainIntensity is its per-minute trigger probability and
            BrainDrainHighRefresh picks the 500ms vs 5s tick. Everything on
            this panel drives that, and only that.
          - VISUAL (the screen blur, OverlayService.StartBrainDrainBlur) is
            WITHHELD behind OverlayService.BrainDrainWithheld while the
            effect is reworked, and early-returns for every caller.
         So the rework notice at the top is not decoration: it is the one
         thing that stops this panel advertising a dead blur. It is driven
         straight off that same flag - no second gate, no new mechanism -
         so flipping OverlayService.BrainDrainWithheld to false hides the
         notice and nothing else on this panel has to change.

         Root MUST stay a Panel (StackPanel): MainWindow.SessionFeatureLock
         .cs:365 inserts the session-lock banner via
         ((Panel)content.Content).Children.Insert(0, banner). The master
         toggle MUST stay named ChkEnable - the same file's belt-and-braces
         FindName("ChkEnable") at :358 is the app-wide convention.

         SessionLock.Owned markers are copied verbatim from the dead XAML:
         enable + intensity are prescribed dose, high-refresh is a pure
         perf knob and stays live mid-session (lock rule 4).

         The hero strip's art is a static pack-URI image, so it is exempt
         from the mod repaint map (MainWindow.xaml.cs:1612-1622).
         ================================================================ -->

    <StackPanel>

        <!-- HERO. Absorbs the old master-enable card: the checkbox moved into the pill
             verbatim (same name, same FieldModifier, same SessionLock marker) and its hint
             is the subtitle. -->
        <Border Height="72" CornerRadius="16" Margin="0,0,0,10"
                Background="{DynamicResource SurfaceBgBrush}"
                BorderBrush="{StaticResource SectionHueStudioBorderBrush}" BorderThickness="1">
            <Grid ClipToBounds="True">
                <Border Width="240" HorizontalAlignment="Right" CornerRadius="0,16,16,0">
                    <Border.Background>
                        <ImageBrush Stretch="UniformToFill" AlignmentX="Right" Opacity="0.9">
                            <ImageBrush.ImageSource>
                                <BitmapImage UriSource="pack://application:,,,/Resources/features/brain_drain.png"
                                             DecodePixelWidth="480"/>
                            </ImageBrush.ImageSource>
                        </ImageBrush>
                    </Border.Background>
                    <Border.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="Transparent" Offset="0"/>
                            <GradientStop Color="#E6000000" Offset="0.55"/>
                        </LinearGradientBrush>
                    </Border.OpacityMask>
                </Border>

                <StackPanel VerticalAlignment="Center" Margin="16,0,0,0">
                    <helpers:EmojiTextBlock Text="{loc:Str section_brain_drain}" FontSize="17" FontWeight="Bold"
                                            Foreground="{StaticResource TextLightBrush}"/>
                    <TextBlock Text="{loc:Str st4_braindrain_enable_hint}" FontSize="11.5"
                               Foreground="{StaticResource TextMutedBrush}"
                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                </StackPanel>

                <Border HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"
                        CornerRadius="9999" Padding="12,6"
                        Background="#8C131320" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{loc:Str btn_enable}" FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <CheckBox x:Name="ChkEnable" x:FieldModifier="internal"
                                  feat:SessionLock.Owned="True"
                                  Style="{StaticResource ToggleStyle}" VerticalAlignment="Center"
                                  Checked="ChkEnable_Changed" Unchecked="ChkEnable_Changed"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Rework notice. Visibility is set in code from
             OverlayService.BrainDrainWithheld; Collapsed here so the
             designer/harness never shows it by accident. -->
        <Border x:Name="WithheldNotice" x:FieldModifier="internal"
                Background="#2A2A4A" BorderBrush="#66FFA500" BorderThickness="1"
                CornerRadius="10" Padding="16,12" Margin="0,0,0,10"
                Visibility="Collapsed">
            <StackPanel>
                <helpers:EmojiTextBlock Text="{loc:Str section_rework}"
                                        Foreground="#FFA500" FontSize="13" FontWeight="Bold"/>
                <TextBlock Text="{loc:Str st4_braindrain_withheld_notice}"
                           Foreground="#FFA500" FontSize="11"
                           TextWrapping="Wrap" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <!-- ONE dense controls card: the dial, then the perf switch. Both hints moved to the
             row ToolTips. The intensity Slider keeps its EXPLICIT 1-100 range: a WPF Slider
             defaults to Maximum=10, which silently clamps this percent value in the settings
             round-trip (the same warning the now-deleted ProgressionTabView markup carried). -->
        <Border Style="{StaticResource SettingCardStyle}">
            <Grid>
                <Border Background="{StaticResource SectionHueStudioWashBrush}" CornerRadius="11"/>
                <Border Width="3" HorizontalAlignment="Left" Margin="0,10" CornerRadius="0,2,2,0"
                        Background="{StaticResource SectionHueStudioBrush}"/>
                <StackPanel Margin="16,8,16,8">

                    <Grid Height="36" ToolTip="{loc:Str st4_braindrain_intensity_hint}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto" MinWidth="56"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{loc:Str setting_intensity}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextLightBrush}" VerticalAlignment="Center"/>
                        <Slider Grid.Column="1" x:Name="SliderIntensity" x:FieldModifier="internal"
                                feat:SessionLock.Owned="True"
                                Minimum="1" Maximum="100" Value="50"
                                VerticalAlignment="Center" Margin="10,0"
                                ValueChanged="SliderIntensity_Changed"/>
                        <TextBlock Grid.Column="2" x:Name="TxtIntensity" x:FieldModifier="internal" Text="50%"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                   FontSize="13" FontWeight="Bold" Foreground="{DynamicResource PinkBrush}"/>
                    </Grid>

                    <Border Height="1" Margin="0,6" Background="{DynamicResource GlassBorderBrush}"/>

                    <!-- High refresh. Comfort/perf knob, NOT prescribed dose: deliberately
                         unmarked so it stays editable mid-session, exactly as in the dead XAML. -->
                    <Grid Height="34" ToolTip="{loc:Str st4_braindrain_high_refresh_hint}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{loc:Str st4_braindrain_high_refresh}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextLightBrush}" VerticalAlignment="Center"/>
                        <CheckBox Grid.Column="1" x:Name="ChkHighRefresh" x:FieldModifier="internal"
                                  Style="{StaticResource ToggleStyle}" VerticalAlignment="Center"
                                  Checked="ChkHighRefresh_Changed" Unchecked="ChkHighRefresh_Changed"/>
                    </Grid>

                </StackPanel>
            </Grid>
        </Border>

        <!-- Shown only when Resources/sounds/braindrain is empty. Without it the
             feature is a completely silent no-op with no way to tell why: the
             service logs a warning and returns, and the UI would look armed. -->
        <Border x:Name="NoAudioHint" x:FieldModifier="internal"
                Background="#2A2A4A" BorderBrush="#66FFA500" BorderThickness="1"
                CornerRadius="10" Padding="16,12" Visibility="Collapsed">
            <TextBlock Text="{loc:Str st4_braindrain_no_audio_hint}"
                       Foreground="#FFA500" FontSize="11" TextWrapping="Wrap"/>
        </Border>

    </StackPanel>
</UserControl>
