<UserControl x:Class="ConditioningControlPanel.Views.Controls.Studio.BrainDrainFeatureControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="clr-namespace:ConditioningControlPanel.Localization"
             xmlns:helpers="clr-namespace:ConditioningControlPanel.Helpers"
             xmlns:feat="clr-namespace:ConditioningControlPanel.Features"
             mc:Ignorable="d" d:DesignWidth="488">

    <!-- ================================================================
         STUDIO RACK · BRAIN DRAIN  (Phase 4 rescue of gap-report G2)

         Brain Drain had no reachable UI. Its only markup lived in
         Views/Tabs/ProgressionTabView.xaml (deleted in Phase 8), inside a
         permanently Collapsed ghost tab, under a comment that literally read
         "Hidden elements to prevent XAML binding errors" - the three
         controls carried NO Checked/ValueChanged attributes at all, so
         MainWindow.LevelFeatures.cs was dead code end to end (Phase 8
         deleted that file too). Meanwhile
         the settings stayed fully live and writable from DTRH, the Deeper
         editor, presets (Models/Preset.cs:413) and the autonomy voice
         commands, i.e. the feature could be turned ON for a user with no
         switch anywhere in the app to turn it back off. That is the gap.

         TWO HALVES, TWO DIALS - read this before changing the copy:
          - AUDIO (Services/LockCard/BrainDrainService.cs).
            BrainDrainIntensity is its per-minute trigger probability and
            BrainDrainHighRefresh picks the 500ms vs 5s tick.
          - VISUAL (the screen blur, OverlayService.StartBrainDrainBlur) is
            LIVE again post-rework: it renders on the shared compositor
            (Services/Compositor/BrainDrainLayer + capture pump). Its
            strength is BrainDrainBlurStrength (its OWN setting - the
            rework split it off the audio probability) and
            BrainDrainMeltEnabled adds the Perlin "melting glass" warp.
            Both apply live through OverlayService's settings hook; the
            melt flip bounces the overlay there (pump flag is per-run).
         The rework notice at the top is still driven straight off
         OverlayService.BrainDrainWithheld (now false, so it stays hidden);
         it is the kill-switch's honest half if the flag ever flips back.

         Root MUST stay a Panel (StackPanel): MainWindow.SessionFeatureLock
         .cs:365 inserts the session-lock banner via
         ((Panel)content.Content).Children.Insert(0, banner). The master
         toggle MUST stay named ChkEnable - the same file's belt-and-braces
         FindName("ChkEnable") at :358 is the app-wide convention.

         SessionLock.Owned markers are copied verbatim from the dead XAML:
         enable + intensity are prescribed dose, high-refresh is a pure
         perf knob and stays live mid-session (lock rule 4).

         The hero strip's art is a static pack-URI image, so it is exempt
         from the mod repaint map (MainWindow.xaml.cs:1612-1622).
         ================================================================ -->

    <StackPanel>

        <!-- HERO. Absorbs the old master-enable card: the checkbox moved into the pill
             verbatim (same name, same FieldModifier, same SessionLock marker) and its hint
             is the subtitle. -->
        <Border Height="72" CornerRadius="16" Margin="0,0,0,10"
                Background="{DynamicResource SurfaceBgBrush}"
                BorderBrush="{StaticResource SectionHueStudioBorderBrush}" BorderThickness="2">
            <Grid ClipToBounds="True">
                <Border Width="240" HorizontalAlignment="Right" CornerRadius="0,16,16,0">
                    <Border.Background>
                        <ImageBrush x:Name="HeroArtBrush" Stretch="UniformToFill" AlignmentX="Right" Opacity="0.9">
                            <ImageBrush.ImageSource>
                                <BitmapImage UriSource="pack://application:,,,/Resources/features/brain_drain.png"
                                             DecodePixelWidth="480"/>
                            </ImageBrush.ImageSource>
                        </ImageBrush>
                    </Border.Background>
                    <Border.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="Transparent" Offset="0"/>
                            <GradientStop Color="#E6000000" Offset="0.55"/>
                        </LinearGradientBrush>
                    </Border.OpacityMask>
                </Border>

                <StackPanel VerticalAlignment="Center" Margin="16,0,0,0">
                    <helpers:EmojiTextBlock Text="{loc:Str section_brain_drain}" FontSize="17" FontWeight="Bold"
                                            Foreground="{StaticResource TextLightBrush}"/>
                    <TextBlock Text="{loc:Str st4_braindrain_enable_hint}" FontSize="11.5"
                               Foreground="{StaticResource TextMutedBrush}"
                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                </StackPanel>

                <Border HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"
                        CornerRadius="9999" Padding="12,6"
                        Background="#8C131320" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{loc:Str btn_enable}" FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <CheckBox x:Name="ChkEnable" x:FieldModifier="internal"
                                  feat:SessionLock.Owned="True"
                                  Style="{StaticResource ToggleStyle}" VerticalAlignment="Center"
                                  Checked="ChkEnable_Changed" Unchecked="ChkEnable_Changed"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- VELVET KIT 2 · ROUND 3 · DENSITY. The settings column is capped (3*, MaxWidth 780) so a
             slider stops being a ~1200px runway in the wide Studio detail pane, and the width that
             buys back becomes ONE big art card instead of dead margin. Everything below column 0 is
             the previous page contents moved verbatim - same names, handlers, lock markers and loc
             keys. Below 700px (the 520px feature popup) the art column collapses to zero and the
             settings retake the full width: Features/AdaptiveSideArt.cs. -->
        <Grid feat:AdaptiveSideArt.CollapseBelow="700">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MaxWidth="780"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <!-- Rework notice. Visibility is set in code from
                     OverlayService.BrainDrainWithheld; Collapsed here so the
                     designer/harness never shows it by accident. -->
                <Border x:Name="WithheldNotice" x:FieldModifier="internal"
                        Background="#2A2A4A" BorderBrush="#66FFA500" BorderThickness="1"
                        CornerRadius="10" Padding="16,12" Margin="0,0,0,10"
                        Visibility="Collapsed">
                    <StackPanel>
                        <helpers:EmojiTextBlock Text="{loc:Str section_rework}"
                                                Foreground="#FFA500" FontSize="13" FontWeight="Bold"/>
                        <TextBlock Text="{loc:Str st4_braindrain_withheld_notice}"
                                   Foreground="#FFA500" FontSize="11"
                                   TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- ARMED. Shown while a random onset is counting down, so "nothing is
                     happening" reads as "it is waiting" instead of "it is broken". Driven from
                     code off BrainDrainService.OnsetStateChanged. -->
                <Border x:Name="OnsetWaitingNotice" x:FieldModifier="internal"
                        Background="#2A2A4A" BorderBrush="#66FF69B4" BorderThickness="1"
                        CornerRadius="10" Padding="16,10" Margin="0,0,0,10"
                        Visibility="Collapsed">
                    <TextBlock x:Name="TxtOnsetWaiting" x:FieldModifier="internal"
                               Foreground="{DynamicResource PinkBrush}" FontSize="11.5"
                               TextWrapping="Wrap"/>
                </Border>

                <!-- ONE dense controls card: the dial, then the perf switch. Both hints moved to the
                     row ToolTips. The intensity Slider keeps its EXPLICIT 1-100 range: a WPF Slider
                     defaults to Maximum=10, which silently clamps this percent value in the settings
                     round-trip (the same warning the now-deleted ProgressionTabView markup carried). -->
                <Border Style="{StaticResource SettingCardStyle}">
                    <Grid>
                        <Border Background="{StaticResource SectionHueStudioWashBrush}" CornerRadius="11"/>
                        <Border Width="3" HorizontalAlignment="Left" Margin="0,10" CornerRadius="0,2,2,0"
                                Background="{StaticResource SectionHueStudioBrush}"/>
                        <StackPanel Margin="16,8,16,8">

                            <!-- AUDIO trigger rate, NOT the blur (#1 support cost, two suggestion
                                 threads). This row used to be labelled with the generic
                                 setting_intensity, so everyone read it as the strength of the screen
                                 haze and dragged it expecting the picture to change. It is
                                 BrainDrainIntensity: how often an audio clip fires. The visual dial
                                 is the next row down. Its own key now, deliberately not the shared
                                 one - other features still mean plain "Intensity" by it. -->
                            <Grid Height="36" ToolTip="{loc:Str st4_braindrain_intensity_hint}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="120"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto" MinWidth="56"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{loc:Str st4_braindrain_audio_rate}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextLightBrush}" VerticalAlignment="Center"/>
                                <Slider Grid.Column="1" x:Name="SliderIntensity" x:FieldModifier="internal"
                                        feat:SessionLock.Owned="True"
                                        Minimum="1" Maximum="100" Value="50"
                                        VerticalAlignment="Center" Margin="10,0"
                                        ValueChanged="SliderIntensity_Changed"/>
                                <TextBlock Grid.Column="2" x:Name="TxtIntensity" x:FieldModifier="internal" Text="50%"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"
                                           FontSize="13" FontWeight="Bold" Foreground="{DynamicResource PinkBrush}"/>
                            </Grid>

                            <Border Height="1" Margin="0,6" Background="{DynamicResource GlassBorderBrush}"/>

                            <!-- Blur strength. The VISUAL half's dial (BrainDrainBlurStrength) - the
                                 dial above is the AUDIO trigger probability, this one is how hard the
                                 screen blur presses in. Explicit 1-100 range for the same
                                 Slider-defaults-to-Maximum=10 reason as above. Prescribed dose. -->
                            <Grid Height="36" ToolTip="{loc:Str st4_braindrain_blur_strength_hint}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="120"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto" MinWidth="56"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{loc:Str st4_braindrain_blur_strength}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextLightBrush}" VerticalAlignment="Center"/>
                                <Slider Grid.Column="1" x:Name="SliderBlurStrength" x:FieldModifier="internal"
                                        feat:SessionLock.Owned="True"
                                        Minimum="1" Maximum="100" Value="50"
                                        VerticalAlignment="Center" Margin="10,0"
                                        ValueChanged="SliderBlurStrength_Changed"/>
                                <TextBlock Grid.Column="2" x:Name="TxtBlurStrength" x:FieldModifier="internal" Text="50%"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"
                                           FontSize="13" FontWeight="Bold" Foreground="{DynamicResource PinkBrush}"/>
                            </Grid>

                            <Border Height="1" Margin="0,6" Background="{DynamicResource GlassBorderBrush}"/>

                            <!-- Melting mode. Same overlay, melt variant (BrainDrainMeltEnabled):
                                 blur + slow Perlin displacement warp. Prescribed dose. -->
                            <Grid Height="34" ToolTip="{loc:Str st4_braindrain_melt_hint}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{loc:Str st4_braindrain_melt}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextLightBrush}" VerticalAlignment="Center"/>
                                <CheckBox Grid.Column="1" x:Name="ChkMelt" x:FieldModifier="internal"
                                          feat:SessionLock.Owned="True"
                                          Style="{StaticResource ToggleStyle}" VerticalAlignment="Center"
                                          Checked="ChkMelt_Changed" Unchecked="ChkMelt_Changed"/>
                            </Grid>

                            <Border Height="1" Margin="0,6" Background="{DynamicResource GlassBorderBrush}"/>

                            <!-- RANDOM START (asked for in #general on 2026-08-31: "i wish it
                                 kicked on randomly not as soon as i press start"). 0 = off, the
                                 default and the behaviour everyone has had until now. Anything
                                 higher arms Brain Drain on Start instead of firing it: BOTH halves
                                 wait a random 1..N minutes, then it kicks in on its own.
                                 Prescribed dose - it decides when the run begins, so it locks with
                                 the dials above mid-session. Explicit 0-30 range for the same
                                 Slider-defaults-to-Maximum=10 reason as those dials. -->
                            <Grid Height="36" ToolTip="{loc:Str st4_braindrain_random_start_hint}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="120"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto" MinWidth="72"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{loc:Str st4_braindrain_random_start}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextLightBrush}" VerticalAlignment="Center"/>
                                <Slider Grid.Column="1" x:Name="SliderRandomStart" x:FieldModifier="internal"
                                        feat:SessionLock.Owned="True"
                                        Minimum="0" Maximum="30" Value="0"
                                        TickFrequency="1" IsSnapToTickEnabled="True"
                                        VerticalAlignment="Center" Margin="10,0"
                                        ValueChanged="SliderRandomStart_Changed"/>
                                <TextBlock Grid.Column="2" x:Name="TxtRandomStart" x:FieldModifier="internal"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"
                                           FontSize="13" FontWeight="Bold" Foreground="{DynamicResource PinkBrush}"/>
                            </Grid>

                            <!-- High refresh. Comfort/perf knob, NOT prescribed dose: deliberately
                                 unmarked so it stays editable mid-session, exactly as in the dead XAML. -->
                            <Grid Height="34" ToolTip="{loc:Str st4_braindrain_high_refresh_hint}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{loc:Str st4_braindrain_high_refresh}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextLightBrush}" VerticalAlignment="Center"/>
                                <CheckBox Grid.Column="1" x:Name="ChkHighRefresh" x:FieldModifier="internal"
                                          Style="{StaticResource ToggleStyle}" VerticalAlignment="Center"
                                          Checked="ChkHighRefresh_Changed" Unchecked="ChkHighRefresh_Changed"/>
                            </Grid>

                            <Border Height="1" Margin="0,6" Background="{DynamicResource GlassBorderBrush}"/>

                            <!-- Show in screenshots (AllowOverlayCapture). The brain-drain surface
                                 is the app's ONLY capture-excluded overlay, so screenshots and OBS
                                 came back with the effect simply missing and nobody could show it
                                 off. Privacy stays the default (unchecked); this is the opt-out.
                                 Comfort/privacy knob, NOT prescribed dose - deliberately unmarked
                                 so it stays editable mid-session, like High refresh above. -->
                            <Grid Height="34" ToolTip="{loc:Str st4_braindrain_allow_capture_hint}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{loc:Str st4_braindrain_allow_capture}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextLightBrush}" VerticalAlignment="Center"/>
                                <CheckBox Grid.Column="1" x:Name="ChkAllowCapture" x:FieldModifier="internal"
                                          Style="{StaticResource ToggleStyle}" VerticalAlignment="Center"
                                          Checked="ChkAllowCapture_Changed" Unchecked="ChkAllowCapture_Changed"/>
                            </Grid>

                        </StackPanel>
                    </Grid>
                </Border>

                <!-- CLIP LIBRARY. The audio half reads <assets>/braindrain - the SAME assets
                     folder as images/videos, created on first scan so it is there to be found.
                     It used to read Resources/sounds/braindrain under the install directory
                     instead, which nobody found (five-plus users in two nights, the community
                     moderator included) and which a reinstall or a portable copy wipes. That
                     legacy folder is still scanned so existing clips keep working; it is just no
                     longer where this card sends people. Plus the Refresh that makes a dropped-in
                     clip work without an app restart (BrainDrainService.ReloadAudioFiles existed
                     for that the whole time and nothing ever called it).
                     Same shape as the Spiral card's library header. -->
                <Border Style="{StaticResource SettingCardStyle}" Margin="0,10,0,0">
                    <Grid>
                        <Border Background="{StaticResource SectionHueStudioWashBrush}" CornerRadius="11"/>
                        <Border Width="3" HorizontalAlignment="Left" Margin="0,10" CornerRadius="0,2,2,0"
                                Background="{StaticResource SectionHueStudioBrush}"/>
                        <StackPanel Margin="16,10,16,12">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:Str st4_braindrain_clip_library}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextLightBrush}"/>
                                    <TextBlock x:Name="TxtClipCount" x:FieldModifier="internal"
                                               FontSize="11" Margin="0,2,0,0"
                                               Foreground="{DynamicResource PinkBrush}"/>
                                </StackPanel>
                                <Button Grid.Column="1" x:Name="BtnOpenAudioFolder"
                                        Content="{loc:Str btn_open_folder}"
                                        Style="{DynamicResource OutlineButton}"
                                        Padding="10,5" Margin="0,0,6,0" FontSize="11"
                                        ToolTip="{loc:Str st4_braindrain_open_folder_tt}"
                                        Click="BtnOpenAudioFolder_Click"/>
                                <Button Grid.Column="2" x:Name="BtnRefreshAudio"
                                        Content="{loc:Str btn_refresh_2}"
                                        Style="{DynamicResource OutlineButton}"
                                        Padding="10,5" FontSize="11"
                                        ToolTip="{loc:Str st4_braindrain_refresh_clips_tt}"
                                        Click="BtnRefreshAudio_Click"/>
                            </Grid>
                            <TextBlock Text="{loc:Str st4_braindrain_folder_hint}"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       FontSize="11" TextWrapping="Wrap"/>

                            <!-- WHAT belongs in the folder. "Where is it" was only half the support
                                 question - the other half was "and what do I even put in there?",
                                 which nothing in the app answered. Brain Drain picks ONE file per
                                 trigger and (post-#983) plays it to its end without displacing it,
                                 so whole tracks are the right content, not one-second stings. -->
                            <TextBlock Text="{loc:Str st4_braindrain_folder_contents}"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>

                            <!-- The literal resolved path, filled in from
                                 BrainDrainService.AudioFolderPath (never hardcoded here - the
                                 service is the single source of truth and the install root moves
                                 between per-user and machine-wide installs). It is what a user
                                 pastes into Discord when the Explorer button is not enough, and it
                                 is the answer to "where IS that folder" without a support round
                                 trip. -->
                            <TextBlock x:Name="TxtAudioFolderPath" x:FieldModifier="internal"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       FontFamily="Consolas, Courier New" FontSize="10.5"
                                       Opacity="0.75" TextWrapping="Wrap" Margin="0,6,0,0"/>

                            <!-- Shown ONLY when the old install-directory folder still holds clips.
                                 Those files keep playing (both folders are scanned and merged), but
                                 that folder does not survive a reinstall or a portable copy, so the
                                 note tells the user to move them across. A clean install never sees
                                 this line at all. Nothing is migrated automatically - moving a
                                 user's files without asking is not this card's call. -->
                            <TextBlock x:Name="TxtLegacyFolderNote" x:FieldModifier="internal"
                                       Text="{loc:Str st4_braindrain_legacy_folder_note}"
                                       Foreground="#FFA500"
                                       FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"
                                       Visibility="Collapsed"/>
                            <TextBlock x:Name="TxtLegacyFolderPath" x:FieldModifier="internal"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       FontFamily="Consolas, Courier New" FontSize="10.5"
                                       Opacity="0.75" TextWrapping="Wrap" Margin="0,3,0,0"
                                       Visibility="Collapsed"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Shown only when BOTH clip folders are empty. Without it the
                     feature is a completely silent no-op with no way to tell why: the
                     service logs a warning and returns, and the UI would look armed.
                     It carries its OWN copy of the Open Folder button (same handler, no second
                     code path): this banner is the exact moment the user is asking the question,
                     and the button up in the library header is above the fold on the 520px
                     feature popup. -->
                <Border x:Name="NoAudioHint" x:FieldModifier="internal"
                        Margin="0,10,0,0"
                        Background="#2A2A4A" BorderBrush="#66FFA500" BorderThickness="1"
                        CornerRadius="10" Padding="16,12" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{loc:Str st4_braindrain_no_audio_hint}"
                                   Foreground="#FFA500" FontSize="11" TextWrapping="Wrap"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Button Grid.Column="1" x:Name="BtnOpenAudioFolderEmpty"
                                Content="{loc:Str btn_open_folder}"
                                Style="{DynamicResource OutlineButton}"
                                Padding="10,5" FontSize="11" VerticalAlignment="Center"
                                ToolTip="{loc:Str st4_braindrain_open_folder_tt}"
                                Click="BtnOpenAudioFolder_Click"/>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- SIDE ART. The art is the Border's BACKGROUND, not a child Image: a Border clips its
                 Background to CornerRadius but does NOT clip child content, so a child Image would
                 square off the rounded corners (round-2 lesson). Same plate the hero uses. -->
            <Border Grid.Column="1" Margin="10,0,0,0" CornerRadius="14"
                    BorderThickness="2" BorderBrush="{StaticResource VelvetCardBorderBrush}"
                    VerticalAlignment="Stretch" MinHeight="200">
                <Border.Background>
                    <ImageBrush x:Name="SideArtBrush" Stretch="UniformToFill">
                        <ImageBrush.ImageSource>
                            <BitmapImage UriSource="pack://application:,,,/Resources/features/brain_drain.png"
                                         DecodePixelWidth="800"/>
                        </ImageBrush.ImageSource>
                    </ImageBrush>
                </Border.Background>
                <!-- Scrim so the plate sits under the page instead of fighting it. -->
                <Border CornerRadius="12">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                            <GradientStop Color="#66000000" Offset="0"/>
                            <GradientStop Color="#00000000" Offset="0.45"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
            </Border>
        </Grid>

    </StackPanel>
</UserControl>
