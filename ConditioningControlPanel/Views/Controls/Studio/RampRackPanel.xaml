<UserControl x:Class="ConditioningControlPanel.Views.Controls.Studio.RampRackPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="clr-namespace:ConditioningControlPanel.Localization"
             xmlns:helpers="clr-namespace:ConditioningControlPanel.Helpers"
             xmlns:feat="clr-namespace:ConditioningControlPanel.Features"
             mc:Ignorable="d" d:DesignWidth="488">

    <!-- ================================================================
         STUDIO RACK · INTENSITY RAMP  (Phase 4)

         Host, not a rebuild - same reasoning as SchedulerRackPanel.xaml,
         plus one extra reason that mattered: the dead ProgressionTab twin
         (deleted in Phase 8) was missing CmbRampCurve
         entirely. The curve is the single control on this feature that
         reshapes a RUNNING session (SessionEngine.cs:526 resolves
         `settings.RampCurve ?? App.Settings.Current.RampCurve` on every
         tick, and per-session RampCurve is usually unset), so "rescuing"
         the ProgressionTab copy would have shipped the one variant of this
         panel that cannot reach the running session.

         That is also why CmbRampCurve is the ONLY SessionLock.Owned
         control here while the other dials stay live mid-session: the
         global ramp deliberately stands down during a session
         (RampTimer_Tick gates each visual link on !sessionActive,
         MainWindow.StartStop.cs:485/493/501), so its sliders are already
         inert and locking them would buy nothing. The full argument is
         written out in Features/IntensityRampFeatureControl.xaml above the
         curve row; st4_ramp_session_note says the same thing to the user,
         because a dial that quietly does nothing mid-session is exactly the
         kind of lie the session-lock rules exist to prevent - which is why
         that note now rides with the curve INSIDE the hosted control, where
         the feature-popup path sees it too.

         VELVET KIT 2: the old intro card is this page's 72px hero strip.
         No hero ART (this feature has none) and no enable pill: the master
         switch stays inside the hosted control so the popup path keeps it.

         Root MUST stay a Panel and the direct UserControl content - the
         session-lock banner is inserted with
         ((Panel)content.Content).Children.Insert(0, banner)
         (MainWindow.SessionFeatureLock.cs:365). The rack's detail host
         owns the scroller and padding.
         ================================================================ -->

    <StackPanel x:Name="StudioRampPanel" x:FieldModifier="internal">

        <!-- HERO. Carries the rescued help button (HelpContentService ships an
             "IntensityRamp" entry at Services/HelpContentService.cs:354; its only button died
             with the ProgressionTab). -->
        <Border Height="72" CornerRadius="16" Margin="0,0,0,10"
                Background="{DynamicResource SurfaceBgBrush}"
                BorderBrush="{StaticResource SectionHueStudioBorderBrush}" BorderThickness="2">
            <Grid ClipToBounds="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="16,0,10,0">
                    <helpers:EmojiTextBlock Text="{loc:Str section_intensity_ramp}" FontSize="17" FontWeight="Bold"
                                            Foreground="{StaticResource TextLightBrush}"/>
                    <TextBlock Text="{loc:Str st4_ramp_hint}" FontSize="11.5"
                               Foreground="{StaticResource TextMutedBrush}"
                               TextWrapping="Wrap" Margin="0,2,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" x:Name="HelpBtnStudioRamp" x:FieldModifier="internal"
                        Style="{StaticResource HelpButtonStyle}" Tag="IntensityRamp"
                        VerticalAlignment="Center" Margin="0,0,14,0"/>
            </Grid>
        </Border>

        <!-- VELVET KIT 2 · ROUND 3 · DENSITY. The settings column is capped (3*, MaxWidth 780) so a
             slider stops being a ~1200px runway in the wide Studio detail pane, and the width that
             buys back becomes ONE big art card instead of dead margin. Everything below column 0 is
             the previous page contents moved verbatim - same names, handlers, lock markers and loc
             keys. Below 700px (the 520px feature popup) the art column collapses to zero and the
             settings retake the full width: Features/AdaptiveSideArt.cs. -->
        <Grid feat:AdaptiveSideArt.CollapseBelow="700">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MaxWidth="780"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <!-- The live control, verbatim: enable, duration, multiplier, curve,
                     end-at-complete, and the five ramp links. -->
                <feat:IntensityRampFeatureControl x:Name="RampHost" x:FieldModifier="internal"/>
            </StackPanel>

            <!-- SIDE CARD, no art: this feature has no plate in Resources/features and round 3 invents
                 no assets. The page's own glyph, huge and nearly transparent, on the section wash. -->
            <Border Grid.Column="1" Margin="10,0,0,0" CornerRadius="14"
                    BorderThickness="2" BorderBrush="{StaticResource VelvetCardBorderBrush}"
                    Background="{StaticResource SectionHueStudioWashBrush}"
                    VerticalAlignment="Stretch" MinHeight="200">
                <Image Width="120" Height="120" Opacity="0.18"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Source="{Binding Source='📈', Converter={StaticResource EmojiToImageSource}}"/>
            </Border>
        </Grid>

    </StackPanel>
</UserControl>
