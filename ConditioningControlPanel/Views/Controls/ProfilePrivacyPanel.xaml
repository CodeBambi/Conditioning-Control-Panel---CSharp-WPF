<UserControl x:Class="ConditioningControlPanel.Views.Controls.ProfilePrivacyPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="clr-namespace:ConditioningControlPanel.Localization"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="420">

    <!-- ================================================================
         PRIVACY & SHARING  (Profile redesign, Phase 1 "Reclaim")

         This panel owns every toggle that used to live in the Profile
         tab's right-hand column. It is a RELOCATION, not a behaviour
         change: the x:Names, the Checked/Unchecked handlers and the
         defaults are byte-for-byte what shipped on DiscordTabView.

         Lifetime trap: the instance is created once by DiscordTabView
         and handed to ProfilePrivacyDialog while the dialog is open, so
         MainWindow's ~25 `DiscordTab.Chk*` writes keep landing whether
         or not the dialog is on screen. Because it is therefore NOT in
         MainWindow's visual tree, its handlers cannot use
         Window.GetWindow(this) - see the code-behind's MainWindow lookup.

         De-blurple rule: #5865F2 survives ONLY on the Discord connection
         card at the top. Every group header is pink/purple.
         ================================================================ -->

    <StackPanel>

        <!-- ==== Discord connection (blurple lives here, and only here) ==== -->
        <Border Background="{DynamicResource DarkerBgBrush}" CornerRadius="10" Padding="15"
                Margin="0,0,0,16" BorderBrush="#5865F2" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TxtDiscordTabStatus" x:FieldModifier="internal"
                               Text="{loc:Str label_not_connected}" Foreground="White"
                               FontSize="14" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="TxtDiscordTabInfo" x:FieldModifier="internal"
                               Text="{loc:Str label_link_discord_for_community_features}"
                               Foreground="{DynamicResource TextMutedBrush}" FontSize="11"
                               Margin="0,2,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <Button x:Name="BtnDiscordTabLogin" x:FieldModifier="internal" Grid.Column="1"
                        Content="{loc:Str btn_login}" Background="#5865F2" Foreground="White"
                        BorderThickness="0" Padding="15,8" Margin="10,0,0,0" FontWeight="Bold"
                        FontSize="11" Cursor="Hand" Click="BtnDiscordTabLogin_Click"/>
            </Grid>
        </Border>

        <!-- ==== Presence ==== -->
        <TextBlock Text="{loc:Str profile_privacy_group_presence}"
                   Foreground="{DynamicResource PinkBrush}" FontSize="13" FontWeight="Bold"
                   Margin="0,0,0,10"/>

        <Border Background="{DynamicResource SurfaceBgBrush}" CornerRadius="6" Padding="12" Margin="0,0,0,8">
            <Grid>
                <StackPanel Margin="0,0,50,0">
                    <TextBlock Text="{loc:Str label_discord_rich_presence}" Foreground="White" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="{loc:Str label_show_your_activity_status}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" TextWrapping="Wrap"/>
                </StackPanel>
                <CheckBox x:Name="ChkDiscordTabRichPresence" x:FieldModifier="internal" Style="{StaticResource ToggleStyle}"
                          HorizontalAlignment="Right" VerticalAlignment="Center"
                          Checked="ChkDiscordRichPresence_Changed" Unchecked="ChkDiscordRichPresence_Changed"/>
            </Grid>
        </Border>

        <Border Background="{DynamicResource SurfaceBgBrush}" CornerRadius="6" Padding="12" Margin="0,0,0,8">
            <Grid>
                <StackPanel Margin="0,0,50,0">
                    <TextBlock Text="{loc:Str label_show_level_in_status}" Foreground="White" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="{loc:Str label_display_your_level}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" TextWrapping="Wrap"/>
                </StackPanel>
                <CheckBox x:Name="ChkDiscordTabShowLevel" x:FieldModifier="internal" Style="{StaticResource ToggleStyle}"
                          HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="True"
                          Checked="ChkShowLevelInPresence_Changed" Unchecked="ChkShowLevelInPresence_Changed"/>
            </Grid>
        </Border>

        <Border Background="{DynamicResource SurfaceBgBrush}" CornerRadius="6" Padding="12" Margin="0,0,0,8">
            <Grid>
                <StackPanel Margin="0,0,50,0">
                    <TextBlock Text="{loc:Str label_show_online_status}" Foreground="White" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="{loc:Str label_appear_offline_when_disabled}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" TextWrapping="Wrap"/>
                </StackPanel>
                <CheckBox x:Name="ChkDiscordTabShowOnline" x:FieldModifier="internal" Style="{StaticResource ToggleStyle}"
                          HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="True"
                          Checked="ChkShowOnlineStatus_Changed" Unchecked="ChkShowOnlineStatus_Changed"/>
            </Grid>
        </Border>

        <!-- ==== Community sharing ==== -->
        <TextBlock Text="{loc:Str label_community_sharing}"
                   Foreground="#B478FF" FontSize="13" FontWeight="Bold" Margin="0,14,0,10"/>

        <Border Background="{DynamicResource SurfaceBgBrush}" CornerRadius="6" Padding="12" Margin="0,0,0,8">
            <Grid>
                <StackPanel Margin="0,0,50,0">
                    <TextBlock Text="{loc:Str label_share_achievements}" Foreground="White" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="{loc:Str label_post_achievements_to_discord}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" TextWrapping="Wrap"/>
                </StackPanel>
                <CheckBox x:Name="ChkDiscordTabShareAchievements" x:FieldModifier="internal" Style="{StaticResource ToggleStyle}"
                          HorizontalAlignment="Right" VerticalAlignment="Center"
                          Checked="ChkShareAchievements_Changed" Unchecked="ChkShareAchievements_Changed"/>
            </Grid>
        </Border>

        <Border Background="{DynamicResource SurfaceBgBrush}" CornerRadius="6" Padding="12" Margin="0,0,0,8">
            <Grid>
                <StackPanel Margin="0,0,50,0">
                    <TextBlock Text="{loc:Str label_share_level_milestones}" Foreground="White" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="{loc:Str label_post_level_ups_to_discord}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" TextWrapping="Wrap"/>
                </StackPanel>
                <CheckBox x:Name="ChkDiscordTabShareLevelUps" x:FieldModifier="internal" Style="{StaticResource ToggleStyle}"
                          HorizontalAlignment="Right" VerticalAlignment="Center"
                          Checked="ChkShareLevelUps_Changed" Unchecked="ChkShareLevelUps_Changed"/>
            </Grid>
        </Border>

        <Border Background="{DynamicResource SurfaceBgBrush}" CornerRadius="6" Padding="12" Margin="0,0,0,8">
            <Grid>
                <StackPanel Margin="0,0,50,0">
                    <TextBlock Text="{loc:Str label_allow_dms_from_leaderboard}" Foreground="White" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="{loc:Str label_let_others_message_you}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" TextWrapping="Wrap"/>
                </StackPanel>
                <CheckBox x:Name="ChkDiscordTabAllowDm" x:FieldModifier="internal" Style="{StaticResource ToggleStyle}"
                          HorizontalAlignment="Right" VerticalAlignment="Center"
                          Checked="ChkAllowDiscordDm_Changed" Unchecked="ChkAllowDiscordDm_Changed"/>
            </Grid>
        </Border>

        <Border Background="{DynamicResource SurfaceBgBrush}" CornerRadius="6" Padding="12" Margin="0,0,0,8">
            <Grid>
                <StackPanel Margin="0,0,50,0">
                    <TextBlock Text="{loc:Str label_share_profile_picture}" Foreground="White" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="{loc:Str label_show_your_avatar_to_others}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" TextWrapping="Wrap"/>
                </StackPanel>
                <CheckBox x:Name="ChkDiscordTabSharePfp" x:FieldModifier="internal" Style="{StaticResource ToggleStyle}"
                          HorizontalAlignment="Right" VerticalAlignment="Center"
                          Checked="ChkShareProfilePicture_Changed" Unchecked="ChkShareProfilePicture_Changed"/>
            </Grid>
        </Border>

        <!-- ==== Goon Game sharing (opt-in, sharer-only; all three default OFF).
                 Separate audience from the community-sharing block above: these only
                 affect the person you are currently duelling. ==== -->
        <TextBlock Text="{loc:Str label_goon_game_sharing}"
                   Foreground="#FFD700" FontSize="13" FontWeight="Bold" Margin="0,14,0,10"/>

        <Border Background="{DynamicResource SurfaceBgBrush}" CornerRadius="6" Padding="12" Margin="0,0,0,8"
                ToolTip="{loc:Str tooltip_goon_share_avatar}">
            <Grid>
                <TextBlock Text="{loc:Str label_goon_share_avatar}" Foreground="White" FontSize="12" FontWeight="SemiBold"
                           VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,50,0"/>
                <CheckBox x:Name="ChkGoonShareAvatar" x:FieldModifier="internal" Style="{StaticResource ToggleStyle}"
                          HorizontalAlignment="Right" VerticalAlignment="Center"
                          Checked="ChkGoonShareAvatar_Changed" Unchecked="ChkGoonShareAvatar_Changed"/>
            </Grid>
        </Border>

        <Border Background="{DynamicResource SurfaceBgBrush}" CornerRadius="6" Padding="12" Margin="0,0,0,8"
                ToolTip="{loc:Str tooltip_goon_share_discord_dm}">
            <Grid>
                <TextBlock Text="{loc:Str label_goon_share_discord_dm}" Foreground="White" FontSize="12" FontWeight="SemiBold"
                           VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,50,0"/>
                <CheckBox x:Name="ChkGoonShareDiscordDm" x:FieldModifier="internal" Style="{StaticResource ToggleStyle}"
                          HorizontalAlignment="Right" VerticalAlignment="Center"
                          Checked="ChkGoonShareDiscordDm_Changed" Unchecked="ChkGoonShareDiscordDm_Changed"/>
            </Grid>
        </Border>

        <Border Background="{DynamicResource SurfaceBgBrush}" CornerRadius="6" Padding="12" Margin="0,0,0,8"
                ToolTip="{loc:Str tooltip_goon_rich_presence}">
            <Grid>
                <TextBlock Text="{loc:Str label_goon_rich_presence}" Foreground="White" FontSize="12" FontWeight="SemiBold"
                           VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,50,0"/>
                <CheckBox x:Name="ChkGoonRichPresence" x:FieldModifier="internal" Style="{StaticResource ToggleStyle}"
                          HorizontalAlignment="Right" VerticalAlignment="Center"
                          Checked="ChkGoonRichPresence_Changed" Unchecked="ChkGoonRichPresence_Changed"/>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
