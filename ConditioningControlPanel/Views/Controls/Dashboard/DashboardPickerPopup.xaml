<UserControl x:Class="ConditioningControlPanel.Views.Controls.Dashboard.DashboardPickerPopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             Focusable="True"
             PreviewKeyDown="OnPreviewKeyDown"
             mc:Ignorable="d"
             d:DesignWidth="640" d:DesignHeight="560">

    <!-- THE FLAT PICKER.

         NOT a Popup, and that is the one structural decision in this file. A Popup gets its own
         top-level HWND, which does not inherit the root Viewbox's scale: the picker would render
         at design pixels while the wall underneath it renders at whatever the window is, so the
         thing that claims to be "over the grid" would sit over it at exactly one window size.
         An overlay in the tab's own tree scales with everything else, takes Escape without a
         focus fight, and - the reason that matters beyond this phase - sits in the SAME parent
         and the same rect the Phase F rolodex has to occupy, so the swap is one method body.

         Everything inside the ScrollViewer is built in code (DashboardPickerPopup.xaml.cs): the
         catalogue is data, the four groups are its rings, and a hand-authored copy of 27 tiles
         would be a second registry to forget to update. -->

    <Border Background="#F2120A1E"
            BorderBrush="{DynamicResource PinkBrush}"
            BorderThickness="1"
            CornerRadius="12">
        <DockPanel Margin="12">

            <TextBlock x:Name="TxtHeader" DockPanel.Dock="Top"
                       Text="Pick a tile"
                       Foreground="White" FontSize="14" FontWeight="SemiBold"
                       Margin="2,0,0,8"/>

            <!-- Footer. Reset sits far from Done on purpose: one of them undoes nine choices. -->
            <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                <Button x:Name="BtnReset" DockPanel.Dock="Left"
                        Content="Reset to default"
                        Padding="10,4" FontSize="11" Cursor="Hand"
                        Background="Transparent"
                        Foreground="{DynamicResource TextMutedBrush}"
                        BorderBrush="{DynamicResource PanelAccentBrush}"
                        BorderThickness="1"
                        Click="OnResetClick"/>
                <Button x:Name="BtnDone" HorizontalAlignment="Right"
                        Content="Done"
                        Padding="16,4" FontSize="11" Cursor="Hand"
                        Style="{DynamicResource PinkButton}"
                        Click="OnDoneClick"/>
            </DockPanel>

            <!-- THE ASK. An inline strip, not a MessageBox: the question is about a tile the user
                 is looking at, and a modal would cover the two things being compared. Docked under
                 the shelf so it appears between the tiles and the footer without moving either. -->
            <Border x:Name="AskStrip" DockPanel.Dock="Bottom"
                    Visibility="Collapsed"
                    Margin="0,10,0,0" Padding="10,6"
                    CornerRadius="8"
                    Background="#D91A1A2E"
                    BorderBrush="{DynamicResource PinkBrush}"
                    BorderThickness="1">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="BtnAskSplit" Content="Split"
                                Padding="10,3" FontSize="11" Cursor="Hand" Margin="0,0,6,0"
                                Style="{DynamicResource PinkButton}"
                                Click="OnAskSplitClick"/>
                        <Button x:Name="BtnAskReplace" Content="Replace"
                                Padding="10,3" FontSize="11" Cursor="Hand" Margin="0,0,6,0"
                                Style="{DynamicResource PinkButton}"
                                Click="OnAskReplaceClick"/>
                        <Button x:Name="BtnAskCancel" Content="Cancel"
                                Padding="10,3" FontSize="11" Cursor="Hand"
                                Background="Transparent"
                                Foreground="{DynamicResource TextMutedBrush}"
                                BorderBrush="{DynamicResource PanelAccentBrush}"
                                BorderThickness="1"
                                Click="OnAskCancelClick"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtAsk" Text="That slot is taken."
                               Foreground="White" FontSize="11"
                               VerticalAlignment="Center" TextWrapping="Wrap"
                               Margin="0,0,10,0"/>
                </DockPanel>
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="Shelf"/>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
