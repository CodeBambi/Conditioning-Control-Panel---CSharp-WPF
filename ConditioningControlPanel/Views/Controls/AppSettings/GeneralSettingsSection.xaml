<UserControl x:Class="ConditioningControlPanel.Views.Controls.AppSettingsSections.GeneralSettingsSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="clr-namespace:ConditioningControlPanel.Localization"
             mc:Ignorable="d" d:DesignWidth="620">

    <!-- ================================================================
         SETTINGS ▸ GENERAL  (UX restructure, Phase 2)

         Language, startup, the window/tray contract, and the Deeper master
         switch. Three different origins, one page:

         · LANGUAGE is a SECOND surface by explicit owner decision (PLAN §7
           decision #8: "Keep in chrome AND list in Settings/General"). It is
           not a duplicate editor - CmbLanguageSetting and the chrome's
           CmbLanguagePill both call MainWindow.ApplyLanguageSelection and are
           re-selected from each other by SyncLanguageSelectors, so there is
           still exactly one code path that writes AppSettings.Language.

         · STARTUP (ChkWinStart / ChkStartHidden / ChkVidLaunch / ChkAutoRun
           and the startup-video picker) MOVED here from the permanently
           Collapsed LegacyDashboardHost (Views/Tabs/SettingsTabView.xaml
           :1298-1394). Those were the copies live code named - LoadSettings,
           SaveSettings, ChkWinStart_Click, SyncWinStartState and
           RequestToggleWindowsStartup all address them by x:Name - so the
           names travel with the controls and the MainWindow partials were
           re-pointed from SettingsTab.X to AppSettingsTab.X. The twins in
           Features/SystemFeatureControl.xaml became read-only mirrors in the
           same change (Devices-agent precedent for the panic key).

         · TRAY is a read-only explainer. There is no minimize-to-tray
           preference in AppSettings - closing ALWAYS minimises
           (MainWindow.WindowChrome.cs:324) - and Phase 2 documents behaviour
           rather than inventing settings.

         · ChkEnableDeeper MOVED from SettingsTabView.xaml:1437. It drives
           BtnDeeper's visibility, so it is a navigation switch as much as a
           feature switch, which is why it sits in General and not in Play.

         Quiet surface (PLAN §2.8): no storyboards, no ambient canvas.

         VELVET KIT / UI POLISH 2 (Lane B):
           · Density - toggle rows are ONE line (label + toggle, MinHeight 34,
             6px apart); the 10px description under each one became the row's
             ToolTip (same loc key, no new strings) and the hairlines are gone.
             The four startup toggles are a 2-column chip grid per the
             contract's "clusters of >=3 related toggles" rule.
           · Hue - every panel wears the section-card recipe: 3px left edge
             bar + wash overlay + hue BorderBrush + hue panel title.
             Language / tray / Deeper = General hue, Startup panel = Startup
             hue (contract §"Compact row spec", panel->hue map).
           · The Deeper card keeps its DeeperAccent TITLE on purpose: that
             brush is mod-mutable branding (HARD RULE 2), and repainting it
             with a static pink would drop mod theming from the Deeper switch.
             Its card SKIN follows the contract's General mapping.
         ================================================================ -->

    <UserControl.Resources>
        <!-- Cluster chip (contract §Compact row spec). Local to this file on purpose:
             Resources/Theme is Lane A territory this pass, so the shared-looking style
             lives where its only three consumers do. Hover warms to the STARTUP hue
             because the only chip cluster in this file is the startup one. -->
        <Style x:Key="SettingChip" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource SectionHueStartupBorderBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <StackPanel>

        <TextBlock Text="{loc:Str set2_section_general}" Style="{StaticResource SectionHeader}"/>

        <!-- ============================= language ============================= -->
        <Border Style="{StaticResource SectionPanel}" Padding="0" Margin="0,0,0,10"
                BorderBrush="{StaticResource SectionHueGeneralBorderBrush}">
            <Grid>
                <Border CornerRadius="11" Background="{StaticResource SectionHueGeneralWashBrush}"/>
                <Border Width="3" HorizontalAlignment="Left" Margin="0,10" CornerRadius="0,2,2,0"
                        Background="{StaticResource SectionHueGeneralBrush}"/>
                <StackPanel Margin="15,12,15,12">

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Image Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"
                               Source="{Binding Source='🌍', Converter={StaticResource EmojiToImageSource}}"/>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="{loc:Str set2_general_language_title}"
                                   Foreground="{StaticResource SectionHueGeneralBrush}"
                                   FontSize="13" VerticalAlignment="Center" Margin="0"/>
                    </StackPanel>

                    <Grid MinHeight="34" ToolTip="{loc:Str set2_general_language_hint}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource SettingLabel}" Text="{loc:Str label_language}"
                                   Margin="0,0,14,0" TextTrimming="CharacterEllipsis"/>
                        <ComboBox Grid.Column="1" x:Name="CmbLanguageSetting" x:FieldModifier="internal"
                                  Style="{StaticResource DarkComboBoxStyle}" FontSize="11"
                                  Width="190" MinHeight="28" VerticalAlignment="Center"
                                  ToolTip="{loc:Str set2_general_language_hint}"
                                  SelectionChanged="CmbLanguageSetting_SelectionChanged"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================== startup ============================= -->
        <Border Style="{StaticResource SectionPanel}" Padding="0" Margin="0,0,0,10"
                BorderBrush="{StaticResource SectionHueStartupBorderBrush}">
            <Grid>
                <Border CornerRadius="11" Background="{StaticResource SectionHueStartupWashBrush}"/>
                <Border Width="3" HorizontalAlignment="Left" Margin="0,10" CornerRadius="0,2,2,0"
                        Background="{StaticResource SectionHueStartupBrush}"/>
                <StackPanel Margin="15,12,15,12">

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Image Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"
                               Source="{Binding Source='🚀', Converter={StaticResource EmojiToImageSource}}"/>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="{loc:Str set2_general_startup_title}"
                                   Foreground="{StaticResource SectionHueStartupBrush}"
                                   FontSize="13" VerticalAlignment="Center" Margin="0"/>
                    </StackPanel>

                    <!-- Four related switches = one 2-column chip grid (contract). Every
                         description became its chip's ToolTip; not one loc key changed.

                         ChkWinStart keeps Click (NOT Checked/Unchecked) on purpose: the
                         handler registers an OS shortcut and may revert the box, and a Click
                         handler does not re-fire when it does.
                         MainWindow.RequestToggleWindowsStartup relies on that. -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource SettingChip}"
                                ToolTip="{loc:Str tooltip_launch_automatically_when_windows_starts}">
                            <Grid MinHeight="22">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{loc:Str setting_win_start}"
                                           Foreground="{DynamicResource TextLightBrush}"
                                           FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap"
                                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <CheckBox Grid.Column="1" x:Name="ChkWinStart" x:FieldModifier="internal"
                                          Style="{StaticResource ToggleStyle}" VerticalAlignment="Center"
                                          Click="ChkWinStart_Click"/>
                            </Grid>
                        </Border>

                        <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource SettingChip}"
                                ToolTip="{loc:Str tooltip_start_minimized_to_system_tray}">
                            <Grid MinHeight="22">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{loc:Str setting_start_hidden}"
                                           Foreground="{DynamicResource TextLightBrush}"
                                           FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap"
                                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <CheckBox Grid.Column="1" x:Name="ChkStartHidden" x:FieldModifier="internal"
                                          Style="{StaticResource ToggleStyle}" VerticalAlignment="Center"
                                          Click="ChkStartHidden_Click"/>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource SettingChip}"
                                ToolTip="{loc:Str tooltip_start_the_engine_automatically_on_launch}">
                            <Grid MinHeight="22">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{loc:Str setting_auto_run}"
                                           Foreground="{DynamicResource TextLightBrush}"
                                           FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap"
                                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <CheckBox Grid.Column="1" x:Name="ChkAutoRun" x:FieldModifier="internal"
                                          Style="{StaticResource ToggleStyle}" VerticalAlignment="Center"
                                          Checked="ChkAutoRun_Changed" Unchecked="ChkAutoRun_Changed"/>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource SettingChip}"
                                ToolTip="{loc:Str tooltip_play_a_mandatory_video_when_app_opens}">
                            <Grid MinHeight="22">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{loc:Str setting_vid_launch}"
                                           Foreground="{DynamicResource TextLightBrush}"
                                           FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap"
                                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <CheckBox Grid.Column="1" x:Name="ChkVidLaunch" x:FieldModifier="internal"
                                          Style="{StaticResource ToggleStyle}" VerticalAlignment="Center"
                                          Checked="ChkVidLaunch_Changed" Unchecked="ChkVidLaunch_Changed"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Startup video picker, one line. TxtStartupVideo is written by
                         MainWindow.Settings.cs (LoadSettings) and by both buttons' MainWindow
                         handlers, so the name matters. -->
                    <Grid MinHeight="34" Margin="0,2,0,0"
                          ToolTip="{loc:Str tooltip_select_a_specific_video_to_play_on_startup_wh}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource SettingLabel}"
                                   Text="{loc:Str label_startup_video}" Margin="0,0,10,0"/>
                        <TextBlock Grid.Column="1" x:Name="TxtStartupVideo" x:FieldModifier="internal"
                                   Text="{loc:Str label_random}" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource PinkBrush}" FontSize="11"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Button Grid.Column="2" x:Name="BtnSelectStartupVideo" Content="📁" Width="36"
                                Style="{StaticResource OutlineButton}" Padding="6,4" VerticalAlignment="Center"
                                Click="BtnSelectStartupVideo_Click"
                                ToolTip="{loc:Str tooltip_browse_for_startup_video}"/>
                        <Button Grid.Column="3" x:Name="BtnClearStartupVideo" Content="✕" Width="36"
                                Style="{StaticResource OutlineButton}" Padding="6,4" Margin="6,0,0,0"
                                VerticalAlignment="Center"
                                Click="BtnClearStartupVideo_Click"
                                ToolTip="{loc:Str tooltip_clear_selection_use_random}"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ========================== window & tray ========================== -->
        <!-- Read-only by design. ✕ minimises to the tray and always has; there is no
             AppSettings property behind it, and Phase 2 does not invent one. Saying so
             here is the fix for "the app won't close" - it is the app's most-reported
             non-bug, which is exactly why this description stays VISIBLE. -->
        <Border Style="{StaticResource SectionPanel}" Padding="0" Margin="0,0,0,10"
                BorderBrush="{StaticResource SectionHueGeneralBorderBrush}">
            <Grid>
                <Border CornerRadius="11" Background="{StaticResource SectionHueGeneralWashBrush}"/>
                <Border Width="3" HorizontalAlignment="Left" Margin="0,10" CornerRadius="0,2,2,0"
                        Background="{StaticResource SectionHueGeneralBrush}"/>
                <StackPanel Margin="15,12,15,12">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Image Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"
                               Source="{Binding Source='🪟', Converter={StaticResource EmojiToImageSource}}"/>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="{loc:Str set2_general_tray_title}"
                                   Foreground="{StaticResource SectionHueGeneralBrush}"
                                   FontSize="13" VerticalAlignment="Center" Margin="0"/>
                    </StackPanel>
                    <TextBlock Text="{loc:Str set2_general_tray_body}" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================== Deeper ============================= -->
        <Border x:Name="DeeperGeneralCard" CornerRadius="12" Padding="0" Margin="0,0,0,10"
                Background="{DynamicResource ElevatedSurfaceBrush}"
                BorderBrush="{StaticResource SectionHueGeneralBorderBrush}" BorderThickness="1">
            <Grid>
                <Border CornerRadius="11" Background="{StaticResource SectionHueGeneralWashBrush}"/>
                <Border Width="3" HorizontalAlignment="Left" Margin="0,10" CornerRadius="0,2,2,0"
                        Background="{StaticResource SectionHueGeneralBrush}"/>
                <StackPanel Margin="15,12,15,12">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Image Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"
                               Source="{Binding Source='🌊', Converter={StaticResource EmojiToImageSource}}"/>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="{loc:Str section_deeper}"
                                   Foreground="{DynamicResource DeeperAccentBrush}"
                                   FontSize="13" VerticalAlignment="Center" Margin="0"/>
                    </StackPanel>
                    <Grid MinHeight="34" ToolTip="{loc:Str tooltip_deeper_enable}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource SettingLabel}"
                                   Text="{loc:Str setting_deeper_enable}"
                                   Margin="0,0,14,0" TextTrimming="CharacterEllipsis"/>
                        <CheckBox Grid.Column="1" x:Name="ChkEnableDeeper" x:FieldModifier="internal"
                                  Style="{StaticResource ToggleStyle}" VerticalAlignment="Center" IsChecked="True"
                                  Checked="ChkEnableDeeper_Changed" Unchecked="ChkEnableDeeper_Changed"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

    </StackPanel>
</UserControl>
