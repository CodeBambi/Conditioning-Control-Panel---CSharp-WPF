<UserControl x:Class="ConditioningControlPanel.Views.Controls.AppSettingsSections.MonitorsSettingsSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="clr-namespace:ConditioningControlPanel.Localization"
             xmlns:feat="clr-namespace:ConditioningControlPanel.Features"
             mc:Ignorable="d" d:DesignWidth="760">

    <!-- ================================================================
         SETTINGS · MONITORS (nav rework 2026-10-06, REHOME lane)

         The one home for "which screen does the content land on" and the
         four video rows that used to sit in the Home System pill popup
         (Features/SystemFeatureControl, retired). Same settings keys, same
         writes: FillAllMonitorsWithVideo, VideoForceHardwareDecoding,
         VideoBlurredBackgroundEnabled, BrowserVideoEngineEnabled. The
         picker is the shared MonitorTargetPicker; every instance writes
         DualMonitorEnabled + GlobalTargetMonitor and repaints from
         AppSettings.PropertyChanged, so this copy and the one in General
         cannot drift. The Home System pill opens this section.
         ================================================================ -->

    <StackPanel>
        <TextBlock Text="{loc:Str settings_section_monitors}" Style="{StaticResource SectionHeader}"/>

        <Border Style="{StaticResource SectionPanel}" Padding="0" Margin="0,0,0,10"
                BorderBrush="{StaticResource SectionHueDevicesBorderBrush}">
            <Grid>
                <Border CornerRadius="11" Background="{StaticResource SectionHueDevicesWashBrush}"/>
                <Border Width="3" HorizontalAlignment="Left" Margin="0,10" CornerRadius="0,2,2,0"
                        Background="{StaticResource SectionHueDevicesBrush}"/>
                <StackPanel Margin="15,12,15,12">

                    <feat:MonitorTargetPicker x:Name="ContentMonitorPicker" x:FieldModifier="internal"/>

                    <!-- Depends on the picker, so it stays indented. -->
                    <Grid MinHeight="34" Margin="16,0,0,0" ToolTip="{loc:Str tooltip_fill_all_monitors_video}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource SettingLabel}" Text="{loc:Str setting_fill_all_monitors_video}"
                                   Margin="0,0,14,0" TextTrimming="CharacterEllipsis"/>
                        <CheckBox Grid.Column="1" x:Name="ChkFillAllMon" x:FieldModifier="internal"
                                  Style="{StaticResource ToggleStyle}" VerticalAlignment="Center"
                                  Checked="ChkFillAllMon_Changed" Unchecked="ChkFillAllMon_Changed"/>
                    </Grid>

                    <Grid MinHeight="34" ToolTip="{loc:Str tooltip_force_video_gpu_decode}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource SettingLabel}" Text="{loc:Str setting_force_video_gpu_decode}"
                                   Margin="0,0,14,0" TextTrimming="CharacterEllipsis"/>
                        <CheckBox Grid.Column="1" x:Name="ChkVideoGpuDecode" x:FieldModifier="internal"
                                  Style="{StaticResource ToggleStyle}" VerticalAlignment="Center"
                                  Checked="ChkVideoGpuDecode_Changed" Unchecked="ChkVideoGpuDecode_Changed"/>
                    </Grid>

                    <Grid MinHeight="34" ToolTip="{loc:Str tooltip_blurred_video_background}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource SettingLabel}" Text="{loc:Str setting_blurred_video_background}"
                                   Margin="0,0,14,0" TextTrimming="CharacterEllipsis"/>
                        <CheckBox Grid.Column="1" x:Name="ChkVideoBlurBg" x:FieldModifier="internal"
                                  Style="{StaticResource ToggleStyle}" VerticalAlignment="Center"
                                  Checked="ChkVideoBlurBg_Changed" Unchecked="ChkVideoBlurBg_Changed"/>
                    </Grid>

                    <Grid MinHeight="34" ToolTip="{loc:Str tooltip_browser_video_engine}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource SettingLabel}" Text="{loc:Str setting_browser_video_engine}"
                                   Margin="0,0,14,0" TextTrimming="CharacterEllipsis"/>
                        <CheckBox Grid.Column="1" x:Name="ChkBrowserVideoEngine" x:FieldModifier="internal"
                                  Style="{StaticResource ToggleStyle}" VerticalAlignment="Center"
                                  Checked="ChkBrowserVideoEngine_Changed" Unchecked="ChkBrowserVideoEngine_Changed"/>
                    </Grid>

                </StackPanel>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
