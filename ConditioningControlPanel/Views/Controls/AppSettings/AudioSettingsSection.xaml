<UserControl x:Class="ConditioningControlPanel.Views.Controls.AppSettingsSections.AudioSettingsSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:helpers="clr-namespace:ConditioningControlPanel.Helpers"
             xmlns:loc="clr-namespace:ConditioningControlPanel.Localization"
             mc:Ignorable="d" d:DesignWidth="620">

    <!-- ================================================================
         SETTINGS · AUDIO (Phase 2)

         The dashboard's AudioSection, re-hosted verbatim. Every x:Name,
         handler, tooltip and loc key is the one MainWindow.Settings.cs,
         .StartStop.cs, .UiUpdates.cs, .Patreon.cs and .Presets.cs already
         read and write - nothing was renamed, nothing was rebound.

         Two deliberate differences from the dashboard copy:
           1. The BtnAudioAdvanced disclosure arrow is GONE. Settings is the
              audio door now, so everything below Master is always visible
              (PLAN.md Phase 2, "relocate the live AudioSection out of its
              disclosure"). Nothing in C# ever referenced that ToggleButton.
           2. Rows breathe: the dashboard packed these into a half-column
              card at FontSize 9-10, this is a full-width settings page.
              Sizing only - no logic, no bindings changed.

         Global audio only. Per-feature volumes (whisper, bubbles, mindwipe,
         audio-sync) stay with their feature panels.

         Quiet surface: no ambient loops, no storyboards (PLAN.md §2.9).
         ================================================================ -->

    <Border x:Name="AudioSection" x:FieldModifier="internal"
            CornerRadius="12" Padding="16" Margin="0,0,0,12"
            Background="{DynamicResource ElevatedSurfaceBrush}"
            BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1">
        <StackPanel>

            <!-- Header -->
            <Grid Margin="0,0,0,10">
                <helpers:EmojiTextBlock Style="{StaticResource SectionHeader}"
                                        Text="{loc:Str section_audio}" FontSize="14" Margin="0"/>
                <Button x:Name="HelpBtnAudio" x:FieldModifier="internal"
                        Style="{StaticResource HelpButtonStyle}" Tag="Audio"
                        HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>

            <!-- Master volume -->
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="46"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource SettingLabel}" Text="{loc:Str setting_master}" FontSize="12"
                           VerticalAlignment="Center"
                           ToolTip="{loc:Str tooltip_master_volume_for_all_audio}"/>
                <Slider Grid.Column="1" x:Name="SliderMaster" x:FieldModifier="internal"
                        Minimum="0" Maximum="100" Value="50"
                        Margin="6,0" VerticalAlignment="Center"
                        ValueChanged="SliderMaster_Changed"
                        ToolTip="{loc:Str tooltip_overall_audio_volume_level}"/>
                <TextBlock x:Name="TxtMaster" x:FieldModifier="internal" Grid.Column="2"
                           Style="{StaticResource ValueLabel}" Text="50%" FontSize="12"
                           VerticalAlignment="Center"/>
            </Grid>

            <!-- Video volume -->
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="46"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource SettingLabel}" Text="{loc:Str setting_video}" FontSize="12"
                           VerticalAlignment="Center"
                           ToolTip="{loc:Str tooltip_volume_for_mandatory_videos}"/>
                <Slider Grid.Column="1" x:Name="SliderVideoVolume" x:FieldModifier="internal"
                        Minimum="0" Maximum="100" Value="50"
                        Margin="6,0" VerticalAlignment="Center"
                        ValueChanged="SliderVideoVolume_Changed"
                        ToolTip="{loc:Str tooltip_separate_volume_control_for_videos}"/>
                <TextBlock x:Name="TxtVideoVolume" x:FieldModifier="internal" Grid.Column="2"
                           Style="{StaticResource ValueLabel}" Text="50%" FontSize="12"
                           VerticalAlignment="Center"/>
            </Grid>

            <!-- Auto-duck master switch -->
            <Grid Margin="0,4,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{loc:Str label_duck}" Style="{StaticResource SettingLabel}" FontSize="12"
                           VerticalAlignment="Center"
                           ToolTip="{loc:Str tooltip_automatically_reduce_other_app_volumes_during}"/>
                <CheckBox Grid.Column="1" x:Name="ChkAudioDuck" x:FieldModifier="internal"
                          Style="{StaticResource ToggleStyle}"
                          IsChecked="True" VerticalAlignment="Center"
                          Checked="ChkAudioDuck_Changed" Unchecked="ChkAudioDuck_Changed"
                          ToolTip="{loc:Str tooltip_automatically_reduce_other_app_volumes_during}"/>
            </Grid>

            <!-- Duck amount -->
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="46"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource SettingLabel}" Text="{loc:Str label_duck}" FontSize="12"
                           VerticalAlignment="Center"
                           ToolTip="{loc:Str tooltip_how_much_to_reduce_other_audio}"/>
                <Slider Grid.Column="1" x:Name="SliderDuck" x:FieldModifier="internal"
                        Minimum="0" Maximum="100" Value="80"
                        Margin="6,0" VerticalAlignment="Center"
                        ValueChanged="SliderDuck_Changed"
                        ToolTip="{loc:Str tooltip_ducking_percentage_80_reduce_other_audio_to_2}"/>
                <TextBlock x:Name="TxtDuck" x:FieldModifier="internal" Grid.Column="2"
                           Style="{StaticResource ValueLabel}" Text="80%" FontSize="12"
                           VerticalAlignment="Center"/>
            </Grid>

            <!-- Don't-duck-the-browser exception -->
            <CheckBox x:Name="ChkExcludeBambiCloudDucking" x:FieldModifier="internal"
                      Margin="0,0,0,10"
                      Content="{loc:Str setting_don_t_duck_browser}"
                      IsChecked="True"
                      Checked="ChkExcludeBambiCloudDucking_Changed"
                      Unchecked="ChkExcludeBambiCloudDucking_Changed"
                      ToolTip="{loc:Str tooltip_when_enabled_audio_from_the_integrated_bambic}"
                      Foreground="{DynamicResource PinkBrush}" FontSize="11"/>

            <!-- Audio output device picker - route CCP audio to a chosen device
                 (e.g. private headset) so streamers can use the program without
                 their viewers hearing the audio on the system default endpoint. -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource SettingLabel}" Text="{loc:Str setting_output}" FontSize="12"
                           VerticalAlignment="Center"
                           ToolTip="{loc:Str tooltip_audio_output_device}"/>
                <ComboBox Grid.Column="1" x:Name="CmbAudioOutputDevice" x:FieldModifier="internal"
                          Margin="6,0" Foreground="Black" Background="White"
                          VerticalAlignment="Center"
                          ToolTip="{loc:Str tooltip_audio_output_device}"
                          SelectionChanged="CmbAudioOutputDevice_SelectionChanged"/>
                <Button Grid.Column="2" x:Name="BtnAudioOutputRefresh" x:FieldModifier="internal" Content="↻"
                        Click="BtnAudioOutputRefresh_Click"
                        ToolTip="{loc:Str set2_tooltip_audio_output_refresh}"
                        Padding="10,3" Background="#33FF69B4" Foreground="White" FontSize="12"
                        BorderBrush="{DynamicResource PinkBrush}" BorderThickness="1" Cursor="Hand"
                        VerticalAlignment="Center"/>
            </Grid>

            <!-- Actions: diagnostics + the layered-audio mixer (#659) -->
            <StackPanel Orientation="Horizontal">
                <Button x:Name="BtnTestAudio" x:FieldModifier="internal"
                        Content="{loc:Str set2_btn_test_audio}"
                        Click="BtnTestAudio_Click"
                        ToolTip="{loc:Str set2_tooltip_test_audio}"
                        Background="#33FF69B4" Foreground="White" FontSize="11" Padding="12,5"
                        BorderBrush="{DynamicResource PinkBrush}" BorderThickness="1" Cursor="Hand"
                        Margin="0,0,8,0"/>
                <Button x:Name="BtnAudioLayers" x:FieldModifier="internal"
                        Content="{loc:Str btn_audio_layers}"
                        Click="BtnAudioLayers_Click"
                        ToolTip="{loc:Str tooltip_audio_layers}"
                        Background="#33FF69B4" Foreground="White" FontSize="11" Padding="12,5"
                        BorderBrush="{DynamicResource PinkBrush}" BorderThickness="1" Cursor="Hand"/>
            </StackPanel>

        </StackPanel>
    </Border>
</UserControl>
