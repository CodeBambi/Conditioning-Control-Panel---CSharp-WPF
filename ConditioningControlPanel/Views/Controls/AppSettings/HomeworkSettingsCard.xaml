<UserControl x:Class="ConditioningControlPanel.Views.Controls.AppSettingsSections.HomeworkSettingsCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:ConditioningControlPanel.Localization"
             Visibility="Collapsed">

    <!-- SETTINGS - ACCOUNT - HOMEWORK. Collapsed unless the proxy says homework is on for this
         account (App.Homework). One row: status + Join or Leave. Join opens the short explainer
         in place (progressive disclosure), Leave is immediate. Code-behind owns every state. -->
    <Border CornerRadius="12" Margin="0,0,0,12" Background="{DynamicResource DarkerBgBrush}"
            BorderBrush="{StaticResource SectionHueAccountBorderBrush}" BorderThickness="1">
        <Grid>
            <Border CornerRadius="11" Background="{StaticResource SectionHueAccountWashBrush}"/>
            <Border Width="3" HorizontalAlignment="Left" Margin="0,10" CornerRadius="0,2,2,0"
                    Background="{StaticResource SectionHueAccountBrush}"/>
            <StackPanel Margin="15,12,15,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="{loc:Str homework_title}" Foreground="{StaticResource SectionHueAccountBrush}"
                                   FontSize="14" FontWeight="Bold"/>
                        <TextBlock x:Name="TxtStatus" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"
                                   TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button x:Name="BtnJoin" Grid.Column="1" Content="{loc:Str homework_btn_join}"
                            Style="{StaticResource OutlineButton}" Padding="14,6" VerticalAlignment="Center"
                            Click="BtnJoin_Click"/>
                    <Button x:Name="BtnLeave" Grid.Column="1" Content="{loc:Str homework_btn_leave}"
                            Style="{StaticResource OutlineButton}" Padding="14,6" VerticalAlignment="Center"
                            Visibility="Collapsed" Click="BtnLeave_Click"/>
                </Grid>

                <StackPanel x:Name="Explainer" Visibility="Collapsed" Margin="0,10,0,0">
                    <TextBlock Text="{loc:Str homework_explain_1}" Foreground="{DynamicResource TextLightBrush}"
                               FontSize="12" TextWrapping="Wrap" Margin="0,0,0,4"/>
                    <TextBlock Text="{loc:Str homework_explain_2}" Foreground="{DynamicResource TextLightBrush}"
                               FontSize="12" TextWrapping="Wrap" Margin="0,0,0,4"/>
                    <TextBlock Text="{loc:Str homework_explain_3}" Foreground="{DynamicResource TextLightBrush}"
                               FontSize="12" TextWrapping="Wrap" Margin="0,0,0,4"/>
                    <TextBlock Text="{loc:Str homework_explain_4}" Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4"/>
                    <TextBlock x:Name="TxtNeedsDiscord" Text="{loc:Str homework_explain_discord}" Foreground="#FF8F98FF"
                               FontSize="11" TextWrapping="Wrap" Margin="0,2,0,4" Visibility="Collapsed"/>
                    <TextBlock x:Name="TxtJoinFailed" Text="{loc:Str homework_join_failed}" Foreground="#FFFF7A85"
                               FontSize="11" TextWrapping="Wrap" Margin="0,2,0,4" Visibility="Collapsed"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Button x:Name="BtnConfirm" Content="{loc:Str homework_btn_join_confirm}"
                                Style="{StaticResource PinkButton}" Padding="15,7" Margin="0,0,10,0"
                                Click="BtnConfirm_Click"/>
                        <Button Content="{loc:Str homework_btn_not_now}" Style="{StaticResource OutlineButton}"
                                Padding="15,7" Click="BtnNotNow_Click"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
