<UserControl x:Class="ConditioningControlPanel.Views.Controls.AppSettingsSections.EmiDeskSettingsSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="clr-namespace:ConditioningControlPanel.Localization"
             mc:Ignorable="d" d:DesignWidth="760">

    <UserControl.Resources>
        <!-- One target in the ring picker: the card art, its name on a dark strip, and a pink
             frame plus a dot when it is pinned. Deliberately the same shape as a ring card at a
             third of the size, so "checked here" and "on her ring" read as the same object.

             The triggers are ordered hover-then-checked on purpose: the other way round, moving
             the pointer over a pinned tile would take its pink frame off. -->
        <Style x:Key="EmiRingTile" TargetType="ToggleButton">
            <Setter Property="Width" Value="92"/>
            <Setter Property="Height" Value="66"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Shell" CornerRadius="6" BorderThickness="2"
                                BorderBrush="#33FFFFFF" Background="#FF1A1A2E"
                                ClipToBounds="True">
                            <Grid>
                                <ContentPresenter/>
                                <Ellipse x:Name="Dot" Width="9" Height="9" Margin="0,4,4,0"
                                         HorizontalAlignment="Right" VerticalAlignment="Top"
                                         Fill="#FFFF69B4" Stroke="#FF0E0E1C" StrokeThickness="1.5"
                                         Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shell" Property="BorderBrush" Value="#8CFF69B4"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Shell" Property="BorderBrush" Value="#FFFF69B4"/>
                                <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.42"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- ================================================================
         SETTINGS - EMI DESK

         The summoned desktop widget (Services/EmiDesk, Windows/EmiDesk).
         Six rows, all of them switches the user flips; nothing the widget
         writes about itself lives here (that is emi-desk.json / EmiState).

         SELF-CONTAINED on purpose. Unlike the older sections this one has
         no passthrough partial and no LoadSettings/SaveSettings rows in
         MainWindow: it reads App.Settings.Current on Loaded and writes it
         back on every change, because every one of these settings is read
         at the moment it matters (the hotkey re-arms, the widget asks for
         spice when it picks a line) rather than at launch.

         THE HOTKEY ROW captures a CHORD, not a bare key, and does it in
         this control rather than through MainWindow's PauseKey state
         machine: that one is deliberately modifier-blind because the panic
         hook is, and a global summon key with no modifier would swallow
         that letter in every other app on the machine.
         ================================================================ -->

    <StackPanel>

        <TextBlock Text="{loc:Str set2_section_emidesk}" Style="{StaticResource SectionHeader}"/>

        <Border Style="{StaticResource SectionPanel}" Padding="0" Margin="0,0,0,12"
                BorderBrush="{StaticResource SectionHueEmiDeskBorderBrush}">
            <Grid>
                <Border CornerRadius="11" Background="{StaticResource SectionHueEmiDeskWashBrush}"/>
                <Border Width="3" HorizontalAlignment="Left" Margin="0,10" CornerRadius="0,2,2,0"
                        Background="{StaticResource SectionHueEmiDeskBrush}"/>
                <StackPanel Margin="15,12,15,12">

                    <!-- 1. master switch -->
                    <Grid MinHeight="34" ToolTip="{loc:Str tooltip_emi_desk_enabled}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource SettingLabel}"
                                   Foreground="{StaticResource SectionHueEmiDeskBrush}"
                                   Text="{loc:Str label_emi_desk_enabled}"
                                   Margin="0,0,14,0" TextTrimming="CharacterEllipsis"/>
                        <CheckBox Grid.Column="1" x:Name="ChkEnabled"
                                  Style="{StaticResource ToggleStyle}" IsChecked="True"
                                  VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Text="{loc:Str set2_emi_desk_enabled_hint}"
                               Foreground="{DynamicResource TextMutedBrush}" FontSize="11"
                               TextWrapping="Wrap" Margin="0,2,0,0"/>

                    <!-- 2. the summon chord -->
                    <Grid MinHeight="34" Margin="0,10,0,0" ToolTip="{loc:Str tooltip_emi_desk_hotkey}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource SettingLabel}"
                                   Foreground="{StaticResource SectionHueEmiDeskBrush}"
                                   Text="{loc:Str label_emi_desk_hotkey}"
                                   Margin="0,0,12,0" TextTrimming="CharacterEllipsis"/>
                        <Button Grid.Column="1" x:Name="BtnHotkey"
                                Content="Ctrl+Alt+E" Style="{StaticResource OutlineButton}"
                                Padding="12,6" VerticalAlignment="Center" MinWidth="130"
                                Click="BtnHotkey_Click"/>
                    </Grid>
                    <TextBlock x:Name="TxtHotkeyHint"
                               Text="{loc:Str set2_emi_desk_hotkey_hint}"
                               Foreground="{DynamicResource TextMutedBrush}" FontSize="11"
                               TextWrapping="Wrap" Margin="0,2,0,0"/>

                    <!-- 3. the mute offer -->
                    <Grid MinHeight="34" Margin="0,10,0,0" ToolTip="{loc:Str tooltip_emi_desk_mute}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource SettingLabel}"
                                   Foreground="{StaticResource SectionHueEmiDeskBrush}"
                                   Text="{loc:Str label_emi_desk_mute}"
                                   Margin="0,0,14,0" TextTrimming="CharacterEllipsis"/>
                        <CheckBox Grid.Column="1" x:Name="ChkMuteAvatar"
                                  Style="{StaticResource ToggleStyle}" IsChecked="True"
                                  VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Text="{loc:Str set2_emi_desk_mute_hint}"
                               Foreground="{DynamicResource TextMutedBrush}" FontSize="11"
                               TextWrapping="Wrap" Margin="0,2,0,0"/>

                    <!-- 4. spice -->
                    <Grid MinHeight="34" Margin="0,10,0,0" ToolTip="{loc:Str tooltip_emi_desk_spice}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource SettingLabel}"
                                   Foreground="{StaticResource SectionHueEmiDeskBrush}"
                                   Text="{loc:Str label_emi_desk_spice}"
                                   Margin="0,0,12,0" TextTrimming="CharacterEllipsis"/>
                        <ComboBox Grid.Column="1" x:Name="CmbSpice" Width="170"
                                  Style="{StaticResource DarkComboBoxStyle}" FontSize="11"
                                  VerticalAlignment="Center"
                                  SelectionChanged="CmbSpice_SelectionChanged"/>
                    </Grid>
                    <TextBlock Text="{loc:Str set2_emi_desk_spice_hint}"
                               Foreground="{DynamicResource TextMutedBrush}" FontSize="11"
                               TextWrapping="Wrap" Margin="0,2,0,0"/>

                    <!-- 5. offers -->
                    <Grid MinHeight="34" Margin="0,10,0,0" ToolTip="{loc:Str tooltip_emi_desk_offers}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource SettingLabel}"
                                   Foreground="{StaticResource SectionHueEmiDeskBrush}"
                                   Text="{loc:Str label_emi_desk_offers}"
                                   Margin="0,0,14,0" TextTrimming="CharacterEllipsis"/>
                        <CheckBox Grid.Column="1" x:Name="ChkOffers"
                                  Style="{StaticResource ToggleStyle}" IsChecked="True"
                                  VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Text="{loc:Str set2_emi_desk_offers_hint}"
                               Foreground="{DynamicResource TextMutedBrush}" FontSize="11"
                               TextWrapping="Wrap" Margin="0,2,0,0"/>

                    <!-- 6. the glass -->
                    <Grid MinHeight="34" Margin="0,10,0,0" ToolTip="{loc:Str tooltip_emi_desk_glass}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource SettingLabel}"
                                   Foreground="{StaticResource SectionHueEmiDeskBrush}"
                                   Text="{loc:Str label_emi_desk_glass}"
                                   Margin="0,0,14,0" TextTrimming="CharacterEllipsis"/>
                        <CheckBox Grid.Column="1" x:Name="ChkGlass"
                                  Style="{StaticResource ToggleStyle}" IsChecked="True"
                                  VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Text="{loc:Str set2_emi_desk_glass_hint}"
                               Foreground="{DynamicResource TextMutedBrush}" FontSize="11"
                               TextWrapping="Wrap" Margin="0,2,0,0"/>

                    <!-- 7. her ring.

                         The answer to "how do I customise the bubbles with my favourite feature"
                         (owner, 2026-08-29). It is not a second store: the checkboxes ARE
                         EmiState.Pins, the same list the ring's own right-click pin writes, so the
                         two are always looking at one truth. Checked = pinned = a guaranteed slot;
                         everything unchecked is hers to fill from what you actually use.

                         Built in code rather than bound: the catalogue is a static record list with
                         availability and lock DELEGATES on it, not an observable collection, and
                         both answers can change between two openings of the settings tab. -->
                    <Grid MinHeight="34" Margin="0,14,0,0" ToolTip="{loc:Str tooltip_emi_desk_ring}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource SettingLabel}"
                                   Foreground="{StaticResource SectionHueEmiDeskBrush}"
                                   Text="{loc:Str label_emi_desk_ring}"
                                   Margin="0,0,12,0" TextTrimming="CharacterEllipsis"/>
                        <Button Grid.Column="1" x:Name="BtnRingReset"
                                Content="{loc:Str emi_desk_ring_reset}"
                                Style="{StaticResource OutlineButton}"
                                Padding="12,6" VerticalAlignment="Center"
                                Click="BtnRingReset_Click"/>
                    </Grid>
                    <TextBlock x:Name="TxtRingHint"
                               Text="{loc:Str set2_emi_desk_ring_hint}"
                               Foreground="{DynamicResource TextMutedBrush}" FontSize="11"
                               TextWrapping="Wrap" Margin="0,2,0,6"/>
                    <WrapPanel x:Name="PnlRing" Orientation="Horizontal" Margin="0,0,0,2"/>

                    <TextBlock Text="{loc:Str set2_emi_desk_gestures_hint}"
                               Foreground="{DynamicResource TextMutedBrush}" FontSize="11"
                               TextWrapping="Wrap" Margin="0,8,0,0"/>

                </StackPanel>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
