<UserControl x:Class="ConditioningControlPanel.Views.Controls.AppSettingsSections.PerformanceSettingsSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="clr-namespace:ConditioningControlPanel.Localization"
             mc:Ignorable="d" d:DesignWidth="620">

    <!-- ================================================================
         SETTINGS ▸ PERFORMANCE  (UX restructure, Phase 2)

         These four controls existed only inside the permanently-Collapsed
         LegacyDashboardHost (Views/Tabs/SettingsTabView.xaml:1332-1384), so
         they were unreachable, not merely hidden. gap-report G12: "All four
         perf controls are currently unreachable and must be REBUILT, not
         moved." That is what this is — the dead copies stay where they are
         until Phase 8 deletes the whole block, and they keep round-tripping
         through LoadSettings/SaveSettings in the meantime (MainWindow.
         Settings.cs:90-94 / :445-450). This section is the LIVE editor.

         CmbMotionLevel is the motion kill-switch. Two contracts on it:
           1. Item order IS the MotionLevel enum ordinal (Full=0, Reduced=1,
              Off=2) — MainWindow.Settings.cs:92/:447-448 cast SelectedIndex
              straight to the enum. Never reorder these three items.
           2. Its SelectionChanged must reach MainWindow.CmbMotionLevel_
              SelectionChanged (MainWindow.UiUpdates.cs:2863) — that method is
              what stops every running ambient loop when motion drops to
              Reduced/Off. A rebuilt combo with no shim is a rebuilt dead
              switch, so the shims live in the code-behind, not here.

         Quiet surface (PLAN §5 / ground rule 8): no animation, no ambient
         canvas, no hover choreography beyond what the shared styles do.

         VELVET KIT / UI POLISH 2 (Lane B): the four toggles are a cluster of
         >=3, so they became a 2-column chip grid; their descriptions are the
         chips' ToolTips (same loc keys) and the four hairlines are gone. The
         card wears the Performance hue skin - 3px edge bar, wash, hue border,
         hue title.
         ================================================================ -->

    <UserControl.Resources>
        <!-- Cluster chip (contract §Compact row spec). Local to this file: Resources/Theme
             is Lane A territory this pass. -->
        <Style x:Key="SettingChip" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource SectionHuePerformanceBorderBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border x:Name="PerformanceSectionCard" CornerRadius="12" Padding="0" Margin="0,0,0,10"
            Background="{DynamicResource ElevatedSurfaceBrush}"
            BorderBrush="{StaticResource SectionHuePerformanceBorderBrush}" BorderThickness="1">
        <Grid>
            <Border CornerRadius="11" Background="{StaticResource SectionHuePerformanceWashBrush}"/>
            <Border Width="3" HorizontalAlignment="Left" Margin="0,10" CornerRadius="0,2,2,0"
                    Background="{StaticResource SectionHuePerformanceBrush}"/>
            <StackPanel Margin="15,12,15,12">

                <!-- header -->
                <StackPanel Orientation="Horizontal">
                    <Image Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"
                           Source="{Binding Source='⚡', Converter={StaticResource EmojiToImageSource}}"/>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="{loc:Str set2_section_performance}"
                               Foreground="{StaticResource SectionHuePerformanceBrush}"
                               FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="{loc:Str set2_section_performance_hint}" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,0,0,8"/>

                <!-- Four related switches = one 2-column chip grid (contract). Every
                     description became its chip's ToolTip; not one loc key changed. -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource SettingChip}"
                            ToolTip="{loc:Str set2_tooltip_performance_mode}">
                        <Grid MinHeight="22">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:Str set2_setting_performance_mode}"
                                       Foreground="{DynamicResource TextLightBrush}"
                                       FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <CheckBox Grid.Column="1" x:Name="ChkPerformanceMode" x:FieldModifier="internal"
                                      Style="{StaticResource ToggleStyle}" VerticalAlignment="Center"
                                      Checked="ChkPerformanceMode_Changed" Unchecked="ChkPerformanceMode_Changed"/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource SettingChip}"
                            ToolTip="{loc:Str set2_tooltip_auto_performance}">
                        <Grid MinHeight="22">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:Str set2_setting_auto_performance}"
                                       Foreground="{DynamicResource TextLightBrush}"
                                       FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <CheckBox Grid.Column="1" x:Name="ChkAutoPerformance" x:FieldModifier="internal"
                                      Style="{StaticResource ToggleStyle}" VerticalAlignment="Center" IsChecked="True"
                                      Checked="ChkAutoPerformance_Changed" Unchecked="ChkAutoPerformance_Changed"/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource SettingChip}"
                            ToolTip="{loc:Str set2_tooltip_unified_overlay}">
                        <Grid MinHeight="22">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:Str set2_setting_unified_overlay}"
                                       Foreground="{DynamicResource TextLightBrush}"
                                       FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <CheckBox Grid.Column="1" x:Name="ChkUnifiedOverlay" x:FieldModifier="internal"
                                      Style="{StaticResource ToggleStyle}" VerticalAlignment="Center" IsChecked="True"
                                      Checked="ChkUnifiedOverlay_Changed" Unchecked="ChkUnifiedOverlay_Changed"/>
                        </Grid>
                    </Border>

                    <!-- Force video GPU decode. Phase-3 rescue: this toggle only ever existed inside
                         the Collapsed LegacyDashboardHost, so it had been unreachable since
                         velvet-mosaic. -->
                    <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource SettingChip}"
                            ToolTip="{loc:Str set2_tooltip_video_hw_decode}">
                        <Grid MinHeight="22">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:Str set2_setting_video_hw_decode}"
                                       Foreground="{DynamicResource TextLightBrush}"
                                       FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <CheckBox Grid.Column="1" x:Name="ChkVideoHwDecode" x:FieldModifier="internal"
                                      Style="{StaticResource ToggleStyle}" VerticalAlignment="Center"
                                      Checked="ChkVideoHwDecode_Changed" Unchecked="ChkVideoHwDecode_Changed"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Motion (accessibility). The three items ARE the enum ordinals — never reorder. -->
                <Grid MinHeight="34" Margin="0,2,0,0" ToolTip="{loc:Str tooltip_motion_level}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource SettingLabel}"
                               Text="{loc:Str setting_motion_level}"
                               Margin="0,0,14,0" TextTrimming="CharacterEllipsis"/>
                    <ComboBox Grid.Column="1" x:Name="CmbMotionLevel" x:FieldModifier="internal"
                              Style="{StaticResource DarkComboBoxStyle}" FontSize="11"
                              Width="110" MinHeight="28" VerticalAlignment="Center"
                              SelectionChanged="CmbMotionLevel_SelectionChanged">
                        <ComboBoxItem Content="{loc:Str label_motion_full}"/>
                        <ComboBoxItem Content="{loc:Str label_motion_reduced}"/>
                        <ComboBoxItem Content="{loc:Str label_motion_off}"/>
                    </ComboBox>
                </Grid>

            </StackPanel>
        </Grid>
    </Border>
</UserControl>
