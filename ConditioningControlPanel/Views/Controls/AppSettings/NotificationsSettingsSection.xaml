<UserControl x:Class="ConditioningControlPanel.Views.Controls.AppSettingsSections.NotificationsSettingsSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="clr-namespace:ConditioningControlPanel.Localization"
             mc:Ignorable="d" d:DesignWidth="760">

    <!-- ================================================================
         SETTINGS · NOTIFICATIONS (Phase 2)

         One row, and that is the honest size of it: ChkIntakeNudge is the
         only notification/popup preference that exists in AppSettings.
         It MOVED here from Views/Tabs/SettingsTabView.xaml:1363-1367, where
         it sat inside the permanently-collapsed LegacyDashboardHost and had
         therefore been unreachable since that host was hidden - the toggle
         users kept asking for was already written, just invisible.

         Same x:Name, same loc keys, same "no Changed handler" contract:
         MainWindow.Marquee.cs:CheckIntakePassNudge reads the setting at
         launch, so nothing has to happen when it is flipped. It is loaded
         by MainWindow.Settings.cs:LoadSettings and written by SaveSettings,
         both re-pointed from SettingsTab to AppSettingsTab.

         VELVET KIT / UI POLISH 2 (Lane B): rows are label-left /
         toggle-right on one line, and the card wears the Notifications hue.
         The hints stay VISIBLE at 11px rather than collapsing into the
         tooltips: this card is two rows, so each hint is short enough to
         read as part of its own row.

         SECOND ROW (meadow, 2026-08-18): ChkSuppressPerkNotifications. The
         reporter had stopped TAKING skill-tree perks purely to avoid their
         popups and pings, so the announcement had to become optional
         without the perk following it out. Unlike ChkIntakeNudge above
         this one is live-edited: it has a Changed handler that writes
         App.Settings.Current and Saves, because the raise sites read the
         setting at the moment they fire, not at launch. See
         Models/AppSettings.SuppressPerkNotifications for exactly what it
         silences and what it deliberately leaves alone.
         ================================================================ -->

    <StackPanel>

        <TextBlock Text="{loc:Str set2_section_notifications}" Style="{StaticResource SectionHeader}"/>

        <Border Style="{StaticResource SectionPanel}" Padding="0" Margin="0,0,0,12"
                BorderBrush="{StaticResource SectionHueNotificationsBorderBrush}">
            <Grid>
                <Border CornerRadius="11" Background="{StaticResource SectionHueNotificationsWashBrush}"/>
                <Border Width="3" HorizontalAlignment="Left" Margin="0,10" CornerRadius="0,2,2,0"
                        Background="{StaticResource SectionHueNotificationsBrush}"/>
                <StackPanel Margin="15,12,15,12">
                    <Grid MinHeight="34" ToolTip="{loc:Str tooltip_intake_nudge_enabled}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource SettingLabel}"
                                   Foreground="{StaticResource SectionHueNotificationsBrush}"
                                   Text="{loc:Str label_intake_nudge_enabled}"
                                   Margin="0,0,14,0" TextTrimming="CharacterEllipsis"/>
                        <CheckBox Grid.Column="1" x:Name="ChkIntakeNudge" x:FieldModifier="internal"
                                  Style="{StaticResource ToggleStyle}" IsChecked="True"
                                  VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Text="{loc:Str set2_intake_nudge_hint}"
                               Foreground="{DynamicResource TextMutedBrush}" FontSize="11"
                               TextWrapping="Wrap" Margin="0,2,0,0"/>

                    <Grid MinHeight="34" Margin="0,10,0,0"
                          ToolTip="{loc:Str tooltip_suppress_perk_notifications}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource SettingLabel}"
                                   Foreground="{StaticResource SectionHueNotificationsBrush}"
                                   Text="{loc:Str label_suppress_perk_notifications}"
                                   Margin="0,0,14,0" TextTrimming="CharacterEllipsis"/>
                        <CheckBox Grid.Column="1" x:Name="ChkSuppressPerkNotifications" x:FieldModifier="internal"
                                  Style="{StaticResource ToggleStyle}" IsChecked="False"
                                  VerticalAlignment="Center"
                                  Checked="ChkSuppressPerkNotifications_Changed"
                                  Unchecked="ChkSuppressPerkNotifications_Changed"/>
                    </Grid>
                    <TextBlock Text="{loc:Str set2_suppress_perk_notifications_hint}"
                               Foreground="{DynamicResource TextMutedBrush}" FontSize="11"
                               TextWrapping="Wrap" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

    </StackPanel>
</UserControl>
