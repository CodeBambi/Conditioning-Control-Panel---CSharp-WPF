<UserControl x:Class="ConditioningControlPanel.Views.Controls.Companion.EngineRoomDrawer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ConditioningControlPanel.Views.Controls.Companion"
             mc:Ignorable="d"
             d:DesignWidth="1160" d:DesignHeight="380"
             d:DataContext="{d:DesignInstance Type=local:MockEngineRoomDrawerVm, IsDesignTimeCreatable=True}">

    <!-- ================================================================
         Z7 — THE ENGINE ROOM (provider plumbing, demoted and proud of it).
         Flat #16162B, thin gray border, no glow, no gradient. The contrast
         with the room above IS the design: everything up there is her,
         this is wiring.

         Nothing is dropped. The four provider radios, the cloud status
         line, Ollama model/host + Setup + Test, the BYO endpoint/key/model
         + sampler + test, the daily request limit, and the live actions
         feed all live in this one drawer.

         They are grouped by provider exactly as the legacy card grouped
         them (LocalConfigPanel / OpenAiCompatibleConfigPanel): the
         segment you picked is the panel you see, so the drawer is a page
         of wiring rather than a wall of it. Off shows its own one-liner
         so the drawer is never an empty box.

         The old full-card login veil is gone: logged-out is an inline row
         here, and Z2's teaser does the selling. The page never fully veils.

         The hero's AI pill deep-links here by setting IsExpanded=true and
         calling BringIntoView() at DispatcherPriority.Normal (Loaded is
         starved in this app).
         ================================================================ -->

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/ConditioningControlPanel;component/Views/Controls/Companion/Themes/CompanionTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- the little all-caps rule that names a provider panel -->
            <Style x:Key="CmpZ7GroupTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource CmpFieldLabelStyle}">
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="#FF8F88AD"/>
                <Setter Property="Margin" Value="2,0,0,8"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Expander x:Name="Drawer" Style="{StaticResource CmpEngineDrawerStyle}"
              IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
        <Expander.Header>
            <StackPanel Orientation="Horizontal">
                <Image Width="14" Height="14" Margin="0,0,10,0" VerticalAlignment="Center"
                       Source="{Binding Source='⚙', Converter={StaticResource CmpEmojiToImage}}"/>
                <TextBlock Text="{local:CmpStr companion_engine_header}"
                           Style="{StaticResource CmpDrawerHeaderTextStyle}"/>
            </StackPanel>
        </Expander.Header>

        <StackPanel>
            <TextBlock Text="{Binding DrawerNote}" Style="{StaticResource CmpDrawerNoteStyle}"/>

            <!-- ========== provider segment (the four legacy radios) ========== -->
            <Border Style="{StaticResource CmpEngineSegmentStripStyle}" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal">
                    <RadioButton GroupName="CmpProviderSeg" Content="{local:CmpStr companion_engine_provider_off}"
                                 Style="{StaticResource CmpEngineSegmentStyle}"
                                 IsChecked="{Binding Provider, Mode=TwoWay,
                                             Converter={StaticResource CmpEnumEquals}, ConverterParameter=Off}"/>
                    <RadioButton GroupName="CmpProviderSeg" Content="{local:CmpStr companion_engine_provider_cloud}"
                                 Style="{StaticResource CmpEngineSegmentStyle}"
                                 IsChecked="{Binding Provider, Mode=TwoWay,
                                             Converter={StaticResource CmpEnumEquals}, ConverterParameter=Cloud}"/>
                    <RadioButton GroupName="CmpProviderSeg" Content="{local:CmpStr companion_engine_provider_local}"
                                 Style="{StaticResource CmpEngineSegmentStyle}"
                                 IsChecked="{Binding Provider, Mode=TwoWay,
                                             Converter={StaticResource CmpEnumEquals}, ConverterParameter=LocalOllama}"/>
                    <RadioButton GroupName="CmpProviderSeg" Content="{local:CmpStr companion_engine_provider_custom}"
                                 Style="{StaticResource CmpEngineSegmentStyle}"
                                 IsChecked="{Binding Provider, Mode=TwoWay,
                                             Converter={StaticResource CmpEnumEquals}, ConverterParameter=Custom}"/>
                </StackPanel>
            </Border>

            <!-- ========== status line (always — it is the "is she thinking?" readout) ========== -->
            <TextBlock Text="{Binding StatusLine}" FontSize="11" Margin="2,0,0,12" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource CmpMutedBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsHealthy}" Value="True">
                                <Setter Property="Foreground" Value="#FF8FD9A8"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- ========== OFF ========== -->
            <TextBlock Text="{local:CmpStr companion_engine_off_note}" Style="{StaticResource CmpDrawerNoteStyle}"
                       Margin="2,0,0,4"
                       Visibility="{Binding Provider, Converter={StaticResource CmpEnumToVis}, ConverterParameter=Off}"/>

            <!-- ========== CLOUD ========== -->
            <StackPanel Visibility="{Binding Provider, Converter={StaticResource CmpEnumToVis}, ConverterParameter=Cloud}">
                <TextBlock Text="{local:CmpStr companion_engine_group_cloud}" Style="{StaticResource CmpZ7GroupTitleStyle}"/>

                <!-- inline logged-out row — this replaces the old page-wide lock veil -->
                <Border Style="{StaticResource CmpInsetPanelStyle}" Margin="0,0,0,12"
                        Visibility="{Binding IsLoggedIn, Converter={StaticResource CmpBoolToVisInverse}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding LoginPrompt}" VerticalAlignment="Center"
                                   Style="{StaticResource CmpDimTextStyle}"/>
                        <Button Grid.Column="1" Content="{Binding LoginButtonLabel}"
                                Style="{StaticResource CmpGrayButtonStyle}" Margin="10,0,0,0"
                                Command="{Binding LoginCommand}"/>
                    </Grid>
                </Border>

                <WrapPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <Button Content="{local:CmpStr companion_engine_btn_test}" Style="{StaticResource CmpGrayButtonStyle}"
                            Command="{Binding TestConnectionCommand}"/>
                    <Button Content="{Binding DailyLimitLabel}" Style="{StaticResource CmpGrayButtonStyle}"
                            Command="{Binding DailyLimitCommand}"/>
                </WrapPanel>
            </StackPanel>

            <!-- ========== LOCAL (OLLAMA) ========== -->
            <StackPanel Visibility="{Binding Provider, Converter={StaticResource CmpEnumToVis}, ConverterParameter=LocalOllama}">
                <TextBlock Text="{local:CmpStr companion_engine_group_local}" Style="{StaticResource CmpZ7GroupTitleStyle}"/>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{local:CmpStr companion_engine_field_ollama_model}" Style="{StaticResource CmpFieldLabelStyle}"/>
                        <TextBox Style="{StaticResource CmpFieldBoxStyle}" Text="{Binding OllamaModel, Mode=TwoWay}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{local:CmpStr companion_engine_field_ollama_host}" Style="{StaticResource CmpFieldLabelStyle}"/>
                        <TextBox Style="{StaticResource CmpFieldBoxStyle}" Text="{Binding OllamaHost, Mode=TwoWay}"/>
                    </StackPanel>
                </Grid>
                <WrapPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <Button Content="{local:CmpStr companion_engine_btn_setup_local}" Style="{StaticResource CmpGrayButtonStyle}"
                            Command="{Binding SetupLocalCommand}"/>
                    <Button Content="{local:CmpStr companion_engine_btn_test}" Style="{StaticResource CmpGrayButtonStyle}"
                            Command="{Binding TestConnectionCommand}"/>
                </WrapPanel>
            </StackPanel>

            <!-- ========== CUSTOM (BYO) ========== -->
            <StackPanel Visibility="{Binding Provider, Converter={StaticResource CmpEnumToVis}, ConverterParameter=Custom}">
                <TextBlock Text="{local:CmpStr companion_engine_group_custom}" Style="{StaticResource CmpZ7GroupTitleStyle}"/>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,10">
                        <TextBlock Text="{local:CmpStr companion_engine_field_custom_endpoint}" Style="{StaticResource CmpFieldLabelStyle}"/>
                        <TextBox Style="{StaticResource CmpFieldBoxStyle}" Text="{Binding CustomEndpoint, Mode=TwoWay}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,10">
                        <TextBlock Text="{local:CmpStr companion_engine_field_custom_model}" Style="{StaticResource CmpFieldLabelStyle}"/>
                        <TextBox Style="{StaticResource CmpFieldBoxStyle}" Text="{Binding CustomModel, Mode=TwoWay}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0">
                        <TextBlock Text="{local:CmpStr companion_engine_field_api_key}" Style="{StaticResource CmpFieldLabelStyle}"/>
                        <!-- A real PasswordBox replaces this in the wiring pass; a key must never be
                             round-tripped through a plain TextBox binding once it is a real secret. -->
                        <TextBox x:Name="CustomKeyBox" Style="{StaticResource CmpFieldBoxStyle}"
                                 Text="{Binding CustomApiKey, Mode=TwoWay}"/>
                        <TextBlock Text="{local:CmpStr companion_engine_api_key_note}"
                                   Style="{StaticResource CmpFaintTextStyle}" Margin="2,4,0,0"/>
                    </StackPanel>
                </Grid>
                <WrapPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <Button Content="{local:CmpStr companion_engine_btn_test}" Style="{StaticResource CmpGrayButtonStyle}"
                            Command="{Binding TestConnectionCommand}"/>
                    <Button Content="{local:CmpStr companion_engine_btn_sampler}" Style="{StaticResource CmpGrayButtonStyle}"
                            Command="{Binding SamplerSettingsCommand}"/>
                    <Button Content="{Binding DailyLimitLabel}" Style="{StaticResource CmpGrayButtonStyle}"
                            Command="{Binding DailyLimitCommand}"/>
                </WrapPanel>
            </StackPanel>

            <!-- ========== live actions feed (local effects channel) ========== -->
            <TextBlock Text="{Binding LiveActionsPlaceholder}" Style="{StaticResource CmpDrawerNoteStyle}"
                       Visibility="{Binding ShowLiveActions, Converter={StaticResource CmpBoolToVisInverse}}"/>

            <Border Style="{StaticResource CmpInsetPanelStyle}" Margin="0,12,0,0"
                    Visibility="{Binding ShowLiveActions, Converter={StaticResource CmpBoolToVis}}">
                <!-- named so the code-behind can attach CompanionWheelRelay: this list is capped
                     and scrolls internally, so its unusable wheel notches must reach PageScroll -->
                <ItemsControl x:Name="LiveActionsFeed" ItemsSource="{Binding LiveActions}"
                              Style="{StaticResource CmpVirtualizedItemsControlStyle}" MaxHeight="140">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Style="{StaticResource CmpWorkshopRowStyle}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>
    </Expander>
</UserControl>
