<UserControl x:Class="ConditioningControlPanel.Views.Controls.Companion.Runtime.WorkshopCommunityCell"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="clr-namespace:ConditioningControlPanel.Localization"
             mc:Ignorable="d" d:DesignWidth="312">

    <!-- ================================================================
         Z8 · COMMUNITY — browse / import / export / refresh plus the
         installed list, moved whole. Z4's expert door links to the same
         browse dialog; this cell owns the controls.
         ================================================================ -->

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/ConditioningControlPanel;component/Views/Controls/Companion/Runtime/WorkshopCellTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
            <Border Background="#FF6B6B" CornerRadius="3" Padding="5,1" VerticalAlignment="Center">
                <TextBlock Text="{loc:Str label_beta}" Foreground="White" FontSize="9" FontWeight="Bold"/>
            </Border>
            <Button x:Name="HelpBtnPrompts" x:FieldModifier="internal" Style="{DynamicResource HelpButtonStyle}"
                    VerticalAlignment="Center" Margin="7,0,0,0" Tag="CommunityPrompts"/>
        </StackPanel>

        <Grid Margin="0,0,0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="BtnBrowsePrompts" Grid.Column="0" Content="{loc:Str btn_browse}"
                    Style="{StaticResource CmpCellButtonStyle}" Margin="0,0,3,0" Click="BtnBrowsePrompts_Click"/>
            <Button x:Name="BtnImportPrompt" Grid.Column="1" Content="{loc:Str btn_import}"
                    Style="{StaticResource CmpCellButtonStyle}" Margin="3,0,3,0" Click="BtnImportPrompt_Click"/>
            <Button x:Name="BtnExportPrompt" Grid.Column="2" Content="{loc:Str btn_export}"
                    Style="{StaticResource CmpCellButtonStyle}" Margin="3,0,0,0" Click="BtnExportPrompt_Click"/>
        </Grid>

        <Grid Margin="0,0,0,5">
            <TextBlock Text="{loc:Str label_installed_prompts}" Style="{StaticResource CmpCellHintStyle}"
                       VerticalAlignment="Center"/>
            <Button x:Name="BtnRefreshPrompts" x:FieldModifier="internal" Content="{loc:Str btn_refresh}"
                    HorizontalAlignment="Right" Background="Transparent"
                    Foreground="{DynamicResource TextMutedBrush}" BorderThickness="0"
                    FontSize="10.5" Padding="6,1" Cursor="Hand" Click="BtnRefreshPrompts_Click"/>
        </Grid>

        <Border CornerRadius="7" Padding="7" MinHeight="60" MaxHeight="140"
                BorderBrush="#22808080" BorderThickness="1" Background="#FF14121F">
            <ScrollViewer x:Name="InstalledPromptsScroll" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="InstalledPromptsPanel" x:FieldModifier="internal">
                    <TextBlock x:Name="TxtNoInstalledPrompts" x:FieldModifier="internal"
                               Text="{loc:Str label_no_prompts_installed_yet}"
                               Foreground="#505050" FontSize="10.5" FontStyle="Italic"
                               HorizontalAlignment="Center" Margin="0,14,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </StackPanel>
</UserControl>
