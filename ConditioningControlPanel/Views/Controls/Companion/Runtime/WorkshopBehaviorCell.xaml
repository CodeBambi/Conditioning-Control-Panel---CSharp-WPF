<UserControl x:Class="ConditioningControlPanel.Views.Controls.Companion.Runtime.WorkshopBehaviorCell"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="clr-namespace:ConditioningControlPanel.Localization"
             mc:Ignorable="d" d:DesignWidth="312">

    <!-- ================================================================
         Z8 · BEHAVIOR — idle interval, bubble duration, the two shortcut
         editors, mute whispers and pause-in-browser.

         Design §6: the shortcut EDITORS are demoted here ("live chat
         shortcut shown as hint on Z1's chat chip"), the two sliders and
         the two switches are kept verbatim. Every x:Name is the one
         MainWindow.Patreon.cs and MainWindow.SessionIO.cs already write.
         ================================================================ -->

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/ConditioningControlPanel;component/Views/Controls/Companion/Runtime/WorkshopCellTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>
        <!-- idle interval -->
        <Grid>
            <TextBlock Text="{loc:Str label_idle_giggle_interval}" Style="{StaticResource CmpCellLabelStyle}"/>
            <TextBlock x:Name="TxtIdleIntervalCompanion" x:FieldModifier="internal" Text="{loc:Str label_120s}"
                       Style="{StaticResource CmpCellValueStyle}"/>
        </Grid>
        <Slider x:Name="SliderIdleIntervalCompanion" x:FieldModifier="internal" Style="{DynamicResource PinkSlider}"
                Minimum="20" Maximum="300" Value="120" Margin="0,4,0,2"
                ValueChanged="SliderIdleInterval_ValueChanged"/>
        <!-- Design §6: the caption the Proactivity trait will own once Train 3 lands. Muted and
             honest until then — it describes where the value comes from today. -->
        <TextBlock Text="{loc:Str label_how_often_companion_speaks_when_idle}" Style="{StaticResource CmpCellHintStyle}"
                   Margin="0,0,0,9"/>

        <!-- bubble duration -->
        <Grid>
            <TextBlock Text="{loc:Str label_bubble_duration}" Style="{StaticResource CmpCellLabelStyle}"/>
            <TextBlock x:Name="TxtBubbleDurationCompanion" x:FieldModifier="internal" Text="2s"
                       Style="{StaticResource CmpCellValueStyle}"/>
        </Grid>
        <Slider x:Name="SliderBubbleDurationCompanion" x:FieldModifier="internal" Style="{DynamicResource PinkSlider}"
                Minimum="1" Maximum="10" Value="2" Margin="0,4,0,9"
                IsSnapToTickEnabled="True" TickFrequency="1"
                ToolTip="{loc:Str tooltip_bubble_duration}"
                ValueChanged="SliderBubbleDuration_ValueChanged"/>

        <!-- the two shortcut editors (the hero shows the live value; changing it happens here) -->
        <Grid Margin="0,0,0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{loc:Str tooltip_change_chat_shortcut}" Style="{StaticResource CmpCellLabelStyle}"
                       TextTrimming="CharacterEllipsis" Margin="0,0,6,0"/>
            <Button x:Name="BtnChatShortcut" Grid.Column="1" Style="{StaticResource CmpCellButtonStyle}"
                    Click="BtnChatShortcut_Click" ToolTip="{loc:Str tooltip_change_chat_shortcut}">
                <TextBlock x:Name="TxtChatShortcutLabel" x:FieldModifier="internal" Text="Ctrl+T"
                           Foreground="{DynamicResource PinkBrush}" FontWeight="SemiBold" FontSize="11"/>
            </Button>
        </Grid>
        <Grid Margin="0,0,0,9">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{loc:Str tooltip_change_camera_shortcut}" Style="{StaticResource CmpCellLabelStyle}"
                       TextTrimming="CharacterEllipsis" Margin="0,0,6,0"/>
            <Button x:Name="BtnCameraShortcut" Grid.Column="1" Style="{StaticResource CmpCellButtonStyle}"
                    Click="BtnCameraShortcut_Click" ToolTip="{loc:Str tooltip_change_camera_shortcut}">
                <TextBlock x:Name="TxtCameraShortcutLabel" x:FieldModifier="internal" Text="Ctrl+Alt+K"
                           Foreground="{DynamicResource PinkBrush}" FontWeight="SemiBold" FontSize="11"/>
            </Button>
        </Grid>

        <!-- the two switches -->
        <Grid Margin="0,0,0,6">
            <StackPanel Margin="0,0,44,0">
                <TextBlock Text="{loc:Str label_mute_whispers}" Style="{StaticResource CmpCellLabelStyle}"/>
                <TextBlock Text="{loc:Str label_mute_subliminal_audio}" Style="{StaticResource CmpCellHintStyle}"/>
            </StackPanel>
            <CheckBox x:Name="ChkMuteWhispersCompanion" x:FieldModifier="internal" Style="{DynamicResource ToggleStyle}"
                      HorizontalAlignment="Right" VerticalAlignment="Center"
                      Checked="ChkMuteWhispers_Changed" Unchecked="ChkMuteWhispers_Changed"/>
        </Grid>
        <Grid>
            <StackPanel Margin="0,0,44,0">
                <TextBlock Text="{loc:Str label_pause_browser}" Style="{StaticResource CmpCellLabelStyle}"/>
                <TextBlock Text="{loc:Str label_pause_embedded_browser_audio}" Style="{StaticResource CmpCellHintStyle}"/>
            </StackPanel>
            <CheckBox x:Name="ChkPauseBrowserCompanion" x:FieldModifier="internal" Style="{DynamicResource ToggleStyle}"
                      HorizontalAlignment="Right" VerticalAlignment="Center"
                      Checked="ChkPauseBrowser_Changed" Unchecked="ChkPauseBrowser_Changed"/>
        </Grid>
    </StackPanel>
</UserControl>
