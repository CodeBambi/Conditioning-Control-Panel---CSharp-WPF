<UserControl x:Class="ConditioningControlPanel.Views.Controls.Companion.MemoryDiaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ConditioningControlPanel.Views.Controls.Companion"
             mc:Ignorable="d"
             d:DesignWidth="660" d:DesignHeight="520"
             d:DataContext="{d:DesignInstance Type=local:MockMemoryDiaryVm, IsDesignTimeCreatable=True}">

    <!-- ================================================================
         Z3 — WHAT SHE KNOWS ABOUT YOU (her diary).
         The trust surface, and deliberately NOT paywalled: everything
         here is local and deterministic, so a free user sees all of it.

         Layout: gold profile strip ▸ kind filter chips ▸ the fact wall
         ▸ footer (storage note + "Forget everything…").

         The wall is a VIRTUALISED single column, not the mockup's CSS
         grid: stock WPF has no virtualising wrap panel, and an unbounded
         fact list has to virtualise for the page to scroll smoothly. Each
         card is full width instead, which also reads better in German.

         Ordering and filtering are done by the viewmodel
         (FactOrdering.Project) — boundary ▸ pinned ▸ salience ▸ dormant.
         The view never sorts.

         Fact cards get their emphasis from BorderBrush, never from a
         per-card DropShadowEffect: bitmap effects on scrolling item
         containers are the expensive mistake here.
         ================================================================ -->

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/ConditioningControlPanel;component/Views/Controls/Companion/Themes/CompanionTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- gold read-only stat chip -->
            <DataTemplate x:Key="CmpProfileStatTemplate">
                <Border Style="{StaticResource CmpStatChipStyle}">
                    <TextBlock Text="{Binding Label}" Style="{StaticResource CmpStatChipTextStyle}"/>
                </Border>
            </DataTemplate>

            <!-- kind filter chip -->
            <DataTemplate x:Key="CmpFactFilterTemplate">
                <ToggleButton Content="{Binding Label}" Style="{StaticResource CmpToggleChipStyle}"
                              IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
            </DataTemplate>

            <!-- one fact card: kind tag, text (or inline edit box), meta, hover action row -->
            <DataTemplate x:Key="CmpFactCardTemplate">
                <Grid>
                    <Border x:Name="Card" Style="{StaticResource CmpFactCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <TextBlock x:Name="KindTag" Text="{Binding KindLabel}"
                                           Style="{StaticResource CmpFactKindTagStyle}"/>
                                <!-- the gold pin, on pinned cards only -->
                                <Image x:Name="Pin" Width="11" Height="11" HorizontalAlignment="Right"
                                       VerticalAlignment="Top" Visibility="Collapsed"
                                       Source="{Binding Source='📌', Converter={StaticResource CmpEmojiToImage}}"/>
                            </Grid>

                            <TextBlock x:Name="FactText" Grid.Row="1" Text="{Binding Text}"
                                       Style="{StaticResource CmpFactTextStyle}"/>
                            <TextBox x:Name="FactEdit" Grid.Row="1" Visibility="Collapsed"
                                     Style="{StaticResource CmpFieldBoxStyle}" Margin="0,4,0,0"
                                     Text="{Binding EditText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                            <Grid Grid.Row="2">
                                <TextBlock Text="{Binding MetaLabel}" Style="{StaticResource CmpFactMetaStyle}"
                                           Margin="0,6,84,0"/>
                                <!-- hover-reveal action row: pure trigger, no code-behind -->
                                <StackPanel x:Name="Actions" Orientation="Horizontal" Opacity="0"
                                            HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                    <Button Style="{StaticResource CmpFactActionStyle}" Command="{Binding PinCommand}"
                                            ToolTip="{local:CmpStr companion_memory_pin_tip}">
                                        <Image Width="11" Height="11"
                                               Source="{Binding Source='📌', Converter={StaticResource CmpEmojiToImage}}"/>
                                    </Button>
                                    <Button Style="{StaticResource CmpFactActionStyle}" Command="{Binding EditCommand}"
                                            ToolTip="{local:CmpStr companion_memory_edit_tip}">
                                        <TextBlock Text="✏" FontSize="11" Foreground="{StaticResource CmpDimBrush}"/>
                                    </Button>
                                    <Button Style="{StaticResource CmpFactActionStyle}" Command="{Binding ForgetCommand}"
                                            ToolTip="{local:CmpStr companion_memory_forget_tip}">
                                        <Image Width="11" Height="11"
                                               Source="{Binding Source='🗑', Converter={StaticResource CmpEmojiToImage}}"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                    <!-- dashed outline for the dormant promise card -->
                    <Rectangle x:Name="DormantOutline" Style="{StaticResource CmpDashedOutlineStyle}"
                               Margin="0,0,0,9" Visibility="Collapsed"/>
                </Grid>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsBoundary}" Value="True">
                        <Setter TargetName="Card" Property="Style" Value="{StaticResource CmpFactBoundaryCardStyle}"/>
                        <Setter TargetName="KindTag" Property="Style"
                                Value="{StaticResource CmpFactBoundaryKindTagStyle}"/>
                        <!-- a remembered boundary is consent hygiene: it can be edited or forgotten,
                             but it is never "pinned" like a joke, so that action is dropped. -->
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsPinned}" Value="True">
                        <Setter TargetName="Pin" Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsDormant}" Value="True">
                        <Setter TargetName="Card" Property="Style" Value="{StaticResource CmpDormantBlockStyle}"/>
                        <Setter TargetName="Card" Property="Margin" Value="0,0,0,9"/>
                        <Setter TargetName="FactText" Property="Style" Value="{StaticResource CmpDormantCopyStyle}"/>
                        <Setter TargetName="KindTag" Property="Foreground" Value="{StaticResource CmpPurpleBrush}"/>
                        <Setter TargetName="Actions" Property="Visibility" Value="Collapsed"/>
                        <Setter TargetName="DormantOutline" Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                        <Setter TargetName="FactText" Property="Visibility" Value="Collapsed"/>
                        <Setter TargetName="FactEdit" Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                    <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                        <Setter TargetName="Actions" Property="Opacity" Value="1"/>
                        <Setter TargetName="Card" Property="BorderBrush" Value="#66FF69B4"/>
                    </Trigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Style="{StaticResource CmpCardStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ========== header ========== -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Image Width="16" Height="16" Margin="0,0,9,0" VerticalAlignment="Center"
                           Source="{Binding Source='📖', Converter={StaticResource CmpEmojiToImage}}"/>
                    <TextBlock Text="{local:CmpStr companion_memory_title}" Style="{StaticResource CmpSectionTitleStyle}"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{local:CmpStr companion_memory_hint}"
                           Style="{StaticResource CmpSectionHintStyle}"/>
                <Border Grid.Column="2" Style="{StaticResource CmpTrainTagLiveStyle}">
                    <TextBlock Text="{local:CmpStr companion_tag_train1}" Style="{StaticResource CmpTrainTagLiveTextStyle}"/>
                </Border>
            </Grid>

            <!-- ========== profile strip (deterministic, free, always populated) ========== -->
            <Border Grid.Row="1" Margin="0,13,0,12" CornerRadius="{StaticResource CmpRadiusInner}"
                    Background="#B312101F" BorderBrush="#26FFD700" BorderThickness="1"
                    Padding="12,10,12,10">
                <ItemsControl ItemsSource="{Binding ProfileStats}"
                              ItemTemplate="{StaticResource CmpProfileStatTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.Template>
                        <ControlTemplate TargetType="ItemsControl">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding DataContext.ProfileStripLabel,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           FontSize="11" FontWeight="Bold" VerticalAlignment="Center"
                                           Foreground="{StaticResource CmpMutedBrush}" Margin="0,0,8,0"/>
                                <ItemsPresenter/>
                            </StackPanel>
                        </ControlTemplate>
                    </ItemsControl.Template>
                </ItemsControl>
            </Border>

            <!-- ========== kind filter chips ========== -->
            <ItemsControl Grid.Row="2" ItemsSource="{Binding Filters}"
                          ItemTemplate="{StaticResource CmpFactFilterTemplate}" Margin="0,0,0,10">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <!-- ========== the fact wall ========== -->
            <Grid Grid.Row="3" MinHeight="90">
                <ItemsControl ItemsSource="{Binding Facts}"
                              ItemTemplate="{StaticResource CmpFactCardTemplate}"
                              Style="{StaticResource CmpVirtualizedItemsControlStyle}"
                              MaxHeight="420"/>

                <!-- fresh user: the wall is not blank, it is a ghost card -->
                <Grid VerticalAlignment="Top"
                      Visibility="{Binding IsEmpty, Converter={StaticResource CmpBoolToVis}}">
                    <Border Style="{StaticResource CmpEmptyBlockStyle}">
                        <TextBlock Text="{Binding EmptyCopy}" Style="{StaticResource CmpEmptyCopyStyle}"/>
                    </Border>
                    <Rectangle Style="{StaticResource CmpEmptyOutlineStyle}"/>
                </Grid>
            </Grid>

            <!-- ========== footer ========== -->
            <Grid Grid.Row="4" Margin="0,13,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding StorageNote}" FontSize="11"
                           Foreground="{StaticResource CmpFaintBrush}" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="{Binding StorageLinkLabel}"
                        Style="{StaticResource CmpLinkButtonStyle}" Margin="6,0,0,0"
                        Command="{Binding OpenStorageFolderCommand}"/>
                <Button Grid.Column="2" Content="{Binding ForgetEverythingLabel}"
                        Style="{StaticResource CmpDangerButtonStyle}" HorizontalAlignment="Right"
                        Command="{Binding ForgetEverythingCommand}"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
