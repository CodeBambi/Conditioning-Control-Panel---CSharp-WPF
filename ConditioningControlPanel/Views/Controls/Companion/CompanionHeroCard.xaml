<UserControl x:Class="ConditioningControlPanel.Views.Controls.Companion.CompanionHeroCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ConditioningControlPanel.Views.Controls.Companion"
             mc:Ignorable="d"
             d:DesignWidth="1160" d:DesignHeight="290"
             d:DataContext="{d:DesignInstance Type=local:MockCompanionHeroCardVm, IsDesignTimeCreatable=True}">

    <!-- ================================================================
         Z1 — THE COMPANION CARD (hero).
         The Trainer Card recipe applied to her: banner + left-dark scrim,
         portrait ring, identity stack, status pills, XP, quick actions,
         gold level plate, and the constellation band along the bottom.

         Traps honoured here:
          · The banner is a Border + brush, NEVER an <Image>. An
            unconstrained Image in a StackPanel/ScrollViewer measures to
            its natural size and blew the profile hero to 1383px.
          · The XP fill is a star-width column — no ActualWidth maths.
          · MinHeight/MaxHeight fix the band so a long flavor line cannot
            push the hero into a different shape on every language.
          · This control owns the tab's ONE ambient loop (the portrait
            breathe). Nothing else here may use RepeatBehavior=Forever.

         Free / logged-out users see this card in full — barks are free,
         and the page must never look broken. Only Z2 locks.
         ================================================================ -->

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/ConditioningControlPanel;component/Views/Controls/Companion/Themes/CompanionTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border CornerRadius="{StaticResource CmpRadiusCard}" ClipToBounds="True"
            Background="{StaticResource CmpCardBrush}"
            BorderBrush="{StaticResource CmpCardBorderBrush}" BorderThickness="1"
            Effect="{StaticResource CmpHeroCardShadow}"
            MinHeight="210">
        <Grid>
            <!-- ========== banner + scrim ========== -->
            <Border Background="{StaticResource CmpHeroBannerBrush}" Opacity="0.9"/>
            <Border Background="{StaticResource CmpRoomGlowPinkBrush}"/>
            <Border Background="{StaticResource CmpHeroScrimBrush}"/>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ========== upper band: portrait | identity | rail ========== -->
                <Grid Grid.Row="0" Margin="22,20,22,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- ===== portrait: ring, hole, bust, presence dot ===== -->
                    <Grid Grid.Column="0" Width="138" Height="138" Margin="0,0,20,0"
                          VerticalAlignment="Top"
                          Opacity="{Binding IsCompanionEnabled, Converter={StaticResource CmpBoolToOpacity},
                                            ConverterParameter=1.0|0.45}">
                        <!-- the ring. Its ScaleTransform is the one Forever animation on this tab. -->
                        <Ellipse x:Name="PortraitRing" RenderTransformOrigin="0.5,0.5"
                                 Effect="{StaticResource CmpRingGlow}">
                            <Ellipse.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FFFF69B4" Offset="0"/>
                                    <GradientStop Color="#FFB478FF" Offset="0.35"/>
                                    <GradientStop Color="#FFFF8FCB" Offset="0.65"/>
                                    <GradientStop Color="#FF9370DB" Offset="1"/>
                                </LinearGradientBrush>
                            </Ellipse.Fill>
                            <Ellipse.RenderTransform>
                                <ScaleTransform x:Name="PortraitRingScale" ScaleX="1" ScaleY="1"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>

                        <!-- the hole: the portrait itself, or a gradient bust placeholder -->
                        <Ellipse Margin="3">
                            <Ellipse.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FF0E0A1C" Offset="0"/>
                                    <GradientStop Color="#FF1B0F2A" Offset="1"/>
                                </LinearGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <Ellipse Margin="3" Visibility="{Binding Portrait, Converter={StaticResource CmpHasContentToVis}}">
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="{Binding Portrait}" Stretch="UniformToFill"/>
                            </Ellipse.Fill>
                        </Ellipse>

                        <!-- presence dot = AI state. Pink when the provider is live, gray when off. -->
                        <Ellipse x:Name="PresenceDot" Width="20" Height="20"
                                 HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                 Margin="0,0,6,8" Stroke="{StaticResource CmpCardBrush}" StrokeThickness="3">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#FF4A4560"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAiLive}" Value="True">
                                            <Setter Property="Fill">
                                                <Setter.Value>
                                                    <RadialGradientBrush Center="0.35,0.35" GradientOrigin="0.35,0.35">
                                                        <GradientStop Color="#FFFFB3DB" Offset="0"/>
                                                        <GradientStop Color="#FFFF69B4" Offset="1"/>
                                                    </RadialGradientBrush>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect Color="#FFFF69B4" BlurRadius="12"
                                                                      ShadowDepth="0" Opacity="0.9"/>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                    </Grid>

                    <!-- ===== identity stack ===== -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="0,2,16,0">

                        <!-- name + mod chip + mood token -->
                        <WrapPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" FontFamily="/Fonts/#Fredoka" FontWeight="SemiBold"
                                       FontSize="31" Foreground="White" VerticalAlignment="Center"
                                       Margin="0,0,11,0" Effect="{StaticResource CmpNameGlow}"/>

                            <Border Style="{StaticResource CmpModChipStyle}" Margin="0,0,11,0">
                                <TextBlock Text="{Binding ModName}" Style="{StaticResource CmpModChipTextStyle}"/>
                            </Border>

                            <!-- daily mood token. Pre-Train 4 it is a sleeping moon at 40% with an
                                 in-character tooltip — present, dormant, never hidden. -->
                            <Border x:Name="MoodToken" CornerRadius="{StaticResource CmpRadiusPill}"
                                    Background="#FF2A1A3A" BorderBrush="#55FF69B4" BorderThickness="1"
                                    Padding="6,4,12,4" VerticalAlignment="Center"
                                    ToolTip="{Binding MoodCaption}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Opacity" Value="0.4"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMoodLive}" Value="True">
                                                <Setter Property="Opacity" Value="1"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="22" Height="22" CornerRadius="11" Margin="0,0,7,0">
                                        <Border.Background>
                                            <RadialGradientBrush Center="0.35,0.30" GradientOrigin="0.35,0.30">
                                                <GradientStop Color="#FFFFD27A" Offset="0"/>
                                                <GradientStop Color="#FFFF8C42" Offset="1"/>
                                            </RadialGradientBrush>
                                        </Border.Background>
                                        <Image Width="12" Height="12" Stretch="Uniform"
                                               Source="{Binding MoodGlyph, Converter={StaticResource CmpEmojiToImage}}"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding MoodWord}" FontSize="11.5" FontWeight="Bold"
                                                   Foreground="#FFFFD9A8"/>
                                        <TextBlock Text="{Binding MoodCaption}" FontSize="9.5"
                                                   Foreground="{StaticResource CmpFaintBrush}"
                                                   MaxWidth="160" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </WrapPanel>

                        <!-- one-line flavor, or the asleep copy when she is disabled -->
                        <TextBlock Text="{Binding Flavor}" Margin="0,7,0,0" FontSize="13"
                                   Foreground="{StaticResource CmpDimBrush}" TextWrapping="Wrap"
                                   MaxHeight="38" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding IsCompanionEnabled, Converter={StaticResource CmpBoolToVis}}"/>

                        <StackPanel Orientation="Horizontal" Margin="0,7,0,0"
                                    Visibility="{Binding IsCompanionEnabled, Converter={StaticResource CmpBoolToVisInverse}}">
                            <TextBlock Text="{Binding AsleepCopy}" Style="{StaticResource CmpFlavorTextStyle}"
                                       FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Button Content="{local:CmpStr companion_hero_wake}" Style="{StaticResource CmpCtaPillStyle}"
                                    Command="{Binding WakeCommand}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- status pills: both are deep-links now -->
                        <WrapPanel Orientation="Horizontal" Margin="0,11,0,0">
                            <Button Content="{Binding AiPillText}" Command="{Binding OpenEngineRoomCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource CmpAiPillStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAiLive}" Value="False">
                                                <Setter Property="Background" Value="#FF1B1B2C"/>
                                                <Setter Property="BorderBrush" Value="#40FFFFFF"/>
                                                <Setter Property="Foreground" Value="{StaticResource CmpMutedBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="{Binding AwarenessPillText}" Command="{Binding FocusAwarenessCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource CmpAwarenessPillStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAwarenessOpen}" Value="False">
                                                <Setter Property="Background" Value="#FF1B1B2C"/>
                                                <Setter Property="BorderBrush" Value="#40FFFFFF"/>
                                                <Setter Property="Foreground" Value="{StaticResource CmpMutedBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </WrapPanel>

                        <!-- companion XP -->
                        <Grid Margin="0,13,0,0" MaxWidth="430" HorizontalAlignment="Left" Width="430">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Style="{StaticResource CmpGaugeTrackStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{Binding XpFraction, Converter={StaticResource CmpFractionToStar}}"/>
                                        <ColumnDefinition Width="{Binding XpFraction, Converter={StaticResource CmpFractionToRemainderStar}}"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource CmpGaugeFillStyle}"/>
                                </Grid>
                            </Border>
                            <Grid Grid.Row="1">
                                <TextBlock Text="{Binding XpLabel}" Style="{StaticResource CmpGaugeLabelStyle}"
                                           HorizontalAlignment="Left"/>
                                <TextBlock Text="{Binding NextLevelLabel}" Style="{StaticResource CmpGaugeLabelStyle}"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                        </Grid>
                    </StackPanel>

                    <!-- ===== right rail: chat CTA, mini chips, level plate ===== -->
                    <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <Button Command="{Binding ChatCommand}" Style="{StaticResource CmpCtaButtonStyle}"
                                HorizontalAlignment="Right">
                            <StackPanel Orientation="Horizontal">
                                <Image Width="15" Height="15" Margin="0,0,8,0" VerticalAlignment="Center"
                                       Source="{Binding Source='💬', Converter={StaticResource CmpEmojiToImage}}"/>
                                <TextBlock Text="{local:CmpStr companion_hero_chat}" VerticalAlignment="Center" FontWeight="Bold"
                                           Foreground="White" FontSize="13"/>
                                <!-- live shortcut only; its editor lives in the Workshop -->
                                <Border Background="#30000000" CornerRadius="5" Padding="6,2,6,2" Margin="9,0,0,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ChatShortcutHint}" FontSize="10" FontWeight="SemiBold"
                                               Foreground="White" Opacity="0.8"/>
                                </Border>
                            </StackPanel>
                        </Button>

                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                            <Button Content="{local:CmpStr companion_hero_switch}" Style="{StaticResource CmpChipButtonStyle}"
                                    Command="{Binding SwitchCommand}"/>
                            <Button Content="{local:CmpStr companion_hero_detach}" Style="{StaticResource CmpChipButtonStyle}"
                                    Command="{Binding DetachCommand}"/>
                            <ToggleButton Style="{StaticResource CmpChipButtonStyle}"
                                          IsChecked="{Binding IsCompanionShown, Mode=TwoWay}"
                                          Command="{Binding ToggleShownCommand}" ToolTip="{local:CmpStr companion_hero_show_tip}">
                                <Image Width="13" Height="13"
                                       Source="{Binding Source='👁', Converter={StaticResource CmpEmojiToImage}}"/>
                            </ToggleButton>
                            <ToggleButton Style="{StaticResource CmpChipButtonStyle}" Margin="0"
                                          IsChecked="{Binding IsMuted, Mode=TwoWay}"
                                          Command="{Binding ToggleMuteCommand}" ToolTip="{local:CmpStr companion_hero_mute_tip}">
                                <Image Width="13" Height="13"
                                       Source="{Binding Source='🔊', Converter={StaticResource CmpEmojiToImage}}"/>
                            </ToggleButton>
                        </WrapPanel>

                        <Border Style="{StaticResource CmpGoldPlateStyle}" HorizontalAlignment="Right"
                                Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="{local:CmpStr companion_hero_level_plate}" Style="{StaticResource CmpGoldPlateKeyStyle}"/>
                                <TextBlock Text="{Binding Level}" Style="{StaticResource CmpGoldPlateValueStyle}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- ========== constellation band ========== -->
                <local:RelationshipConstellation Grid.Row="1" x:Name="ConstellationBand"
                                                 DataContext="{Binding Constellation}"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
