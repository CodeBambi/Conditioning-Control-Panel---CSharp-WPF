<UserControl x:Class="ConditioningControlPanel.Views.Controls.Companion.WorkshopAccordion"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ConditioningControlPanel.Views.Controls.Companion"
             xmlns:loc="clr-namespace:ConditioningControlPanel.Localization"
             mc:Ignorable="d"
             d:DesignWidth="1160" d:DesignHeight="400"
             d:DataContext="{d:DesignInstance Type=local:MockWorkshopAccordionVm, IsDesignTimeCreatable=True}">

    <!-- ================================================================
         Z8 — THE WORKSHOP (legacy + expert shelf).
         "nothing was deleted. it just stopped being the front door."

         Six pigeonholes in a wrapping grid: roster, behavior, triggers &
         phrases, her library, community, awareness fine-tuning. The
         interior is today's accordions almost verbatim — a container
         move, not a rebuild — so this scaffold renders generic cells and
         the wiring pass swaps each row for the real control while
         preserving every x:Name the MainWindow partials write to.

         A row with an ActivateCommand behaves like the mockup's <li>:
         hand cursor, label goes white on hover, click opens the real
         dialog. A row without one is inert and says so by not lighting
         up — no dead-looking disabled chrome either way.

         Cell titles are the deep-link anchors: the hero's Switch chip
         asks for ROSTER, Z5's "fine-tuning ↓" asks for the awareness
         cell, and ExpandAndReveal(title) scrolls it in.

         Cells wrap rather than sitting in a fixed 3-column grid so the
         drawer collapses to one column on a narrow window without a
         width trigger.
         ================================================================ -->

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/ConditioningControlPanel;component/Views/Controls/Companion/Themes/CompanionTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- a row is a chrome-free button so ActivateCommand is reachable by keyboard too -->
            <Style x:Key="CmpZ8RowButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="Transparent"><ContentPresenter/></Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <!-- no command = nothing to click; do not pretend otherwise -->
                    <DataTrigger Binding="{Binding ActivateCommand}" Value="{x:Null}">
                        <Setter Property="Cursor" Value="Arrow"/>
                        <Setter Property="Focusable" Value="False"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- the row label: white on hover, but only when the row actually does something -->
            <Style x:Key="CmpZ8RowLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource CmpWorkshopRowStyle}">
                <Setter Property="Margin" Value="0"/>
                <Style.Triggers>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}"
                                       Value="True"/>
                            <Condition Binding="{Binding IsCaption}" Value="False"/>
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Foreground" Value="{StaticResource CmpTextBrush}"/>
                    </MultiDataTrigger>
                    <DataTrigger Binding="{Binding IsCaption}" Value="True">
                        <Setter Property="Foreground" Value="{StaticResource CmpFaintBrush}"/>
                        <Setter Property="FontStyle" Value="Italic"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- one row: plain label/value, a mock slider, or a muted caption -->
            <DataTemplate x:Key="CmpWorkshopRowTemplate">
                <Button Style="{StaticResource CmpZ8RowButtonStyle}" Command="{Binding ActivateCommand}"
                        ToolTip="{Binding Label}">
                    <Grid Margin="0,2.5,0,2.5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="{Binding Label}"
                                   Style="{StaticResource CmpZ8RowLabelStyle}"/>

                        <!-- slider mock: a hairline track with a pink thumb at SliderFraction -->
                        <Grid x:Name="Track" Grid.Column="1" Height="12" Margin="8,0,8,0"
                              VerticalAlignment="Center" Visibility="Collapsed">
                            <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                                    Background="{StaticResource CmpTrackSoftBrush}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{Binding SliderFraction, Converter={StaticResource CmpFractionToStar}}"/>
                                    <ColumnDefinition Width="{Binding SliderFraction, Converter={StaticResource CmpFractionToRemainderStar}}"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse Grid.Column="1" Width="12" Height="12" HorizontalAlignment="Left"
                                         Margin="-6,0,0,0" Fill="{StaticResource CmpPinkBrush}"/>
                            </Grid>
                        </Grid>

                        <TextBlock Grid.Column="2" Text="{Binding Value}"
                                   Style="{StaticResource CmpWorkshopRowStyle}" Margin="8,0,0,0"
                                   Foreground="{StaticResource CmpDimBrush}"
                                   Visibility="{Binding Value, Converter={StaticResource CmpHasContentToVis}}"/>
                    </Grid>
                </Button>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsSlider}" Value="True">
                        <Setter TargetName="Track" Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <!-- one pigeonhole. The heading is a button that deep-links to this cell; the
                 CommandParameter is the KEY, never the title — the title is localizable and an
                 anchor that moves with the language is an anchor that misses. -->
            <DataTemplate x:Key="CmpWorkshopCellTemplate">
                <Border Style="{StaticResource CmpWorkshopCellStyle}" Width="340"
                        Tag="{Binding Key}">
                    <StackPanel>
                        <Button Style="{StaticResource CmpZ8RowButtonStyle}"
                                ToolTip="{loc:Str companion_workshop_focus_tip}"
                                Command="{Binding DataContext.FocusCellCommand,
                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding Key}">
                            <TextBlock Text="{Binding Title}" Style="{StaticResource CmpWorkshopCellTitleStyle}"/>
                        </Button>

                        <!-- Scaffold rows: the design-time shape. A wired-up cell carries the real
                             re-parented control instead and these collapse, so the two can never
                             render on top of each other. -->
                        <ItemsControl x:Name="ScaffoldRows" ItemsSource="{Binding Rows}"
                                      ItemTemplate="{StaticResource CmpWorkshopRowTemplate}"
                                      Visibility="Collapsed"/>

                        <!-- The container move (design §3 Z8): the legacy accordion's own controls,
                             re-parented, not rebuilt. -->
                        <ContentPresenter x:Name="CellContent" Content="{Binding Content}"/>
                    </StackPanel>
                </Border>
                <DataTemplate.Triggers>
                    <!-- Null-tested rather than converted to a Visibility: a DataTrigger compares
                         Value with Equals, and a literal "Visible" in markup is the STRING, which
                         never equals Visibility.Visible. {x:Null} is the same test the row template
                         above uses for a missing command. -->
                    <DataTrigger Binding="{Binding Content}" Value="{x:Null}">
                        <Setter TargetName="ScaffoldRows" Property="Visibility" Value="Visible"/>
                        <Setter TargetName="CellContent" Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Expander x:Name="Drawer" Style="{StaticResource CmpDrawerStyle}"
              IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
        <Expander.Header>
            <StackPanel Orientation="Horizontal">
                <Image Width="14" Height="14" Margin="0,0,10,0" VerticalAlignment="Center"
                       Source="{Binding Source='🔧', Converter={StaticResource CmpEmojiToImage}}"/>
                <TextBlock Text="{loc:Str companion_workshop_header}"
                           Style="{StaticResource CmpDrawerHeaderTextStyle}"/>
            </StackPanel>
        </Expander.Header>

        <StackPanel>
            <TextBlock Text="{Binding DrawerNote}" Style="{StaticResource CmpDrawerNoteStyle}"/>
            <ItemsControl x:Name="CellHost" ItemsSource="{Binding Cells}"
                          ItemTemplate="{StaticResource CmpWorkshopCellTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <!-- COMPAT SEAM (design §6 disposition table, last row; §7.10). MainWindow's partials
                 look this button up by name to hang the settings help popup on it. The Workshop
                 absorbed the settings shelf, so the Workshop carries it — hidden, exactly as
                 CompanionTabView keeps it. See the fuller seam note in CompanionHeroCard.xaml. -->
            <Button x:Name="HelpBtnCompanionSettings" x:FieldModifier="internal"
                    Tag="CompanionSettings" Visibility="Collapsed" IsHitTestVisible="False"/>
        </StackPanel>
    </Expander>
</UserControl>
