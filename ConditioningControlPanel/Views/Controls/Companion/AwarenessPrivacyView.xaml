<UserControl x:Class="ConditioningControlPanel.Views.Controls.Companion.AwarenessPrivacyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ConditioningControlPanel.Views.Controls.Companion"
             xmlns:loc="clr-namespace:ConditioningControlPanel.Localization"
             mc:Ignorable="d"
             d:DesignWidth="430" d:DesignHeight="360"
             d:DataContext="{d:DesignInstance Type=local:MockAwarenessPrivacyVm, IsDesignTimeCreatable=True}">

    <!-- ================================================================
         Z5 — WHAT SHE CAN SEE (awareness & privacy).
         Design goal: capability visible, never a surprise.

           · 3-stop intensity dial — three RadioButtons sharing one
             templated pill strip. IsChecked binds two-way to the same
             enum with a per-stop ConverterParameter, so the strip needs
             no code-behind at all.
           · The wire view is the trust element: a monospace chip showing
             EXACTLY the projected ContextFrame. Off/free shows it grayed
             saying "[ her eyes are closed ]" rather than vanishing.
           · Deny chips ship seeded (password managers, banking, email)
             and each one can be lifted again — the ✕ is hover-revealed
             and, until then, not hit-testable, because an invisible
             control that removes a privacy guard is a trap.
           · Incognito is a hard drop and says so in fixed copy.
           · Page titles default OFF — the inverted default made visible,
             and the label goes pink while they are hidden.

         Pre-Train 2: the third stop is present but not selectable (the
         first two bridge today's single toggle) and the dormant promise
         block replaces the live caption. Small TRAIN 2 microtag, never
         the word TODO.
         ================================================================ -->

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/ConditioningControlPanel;component/Views/Controls/Companion/Themes/CompanionTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- the hover-revealed ✕ on a deny chip -->
            <Style x:Key="CmpZ5ChipCloseStyle" TargetType="Button">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FontSize" Value="9"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="#FFFFB0BE"/>
                <Setter Property="Margin" Value="7,0,0,0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <!-- invisible AND inert until the chip is hovered -->
                <Setter Property="Opacity" Value="0"/>
                <Setter Property="IsHitTestVisible" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="Transparent" Padding="2,0,2,0">
                                <ContentPresenter VerticalAlignment="Center"
                                                  TextBlock.Foreground="{TemplateBinding Foreground}"
                                                  TextBlock.FontSize="{TemplateBinding FontSize}"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Foreground" Value="{StaticResource CmpTextBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <DataTemplate x:Key="CmpDenyChipTemplate">
                <Border x:Name="ChipBd" Style="{StaticResource CmpDenyChipStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Label}" Style="{StaticResource CmpDenyChipTextStyle}"
                                   VerticalAlignment="Center"/>
                        <Button x:Name="RemoveBtn" Content="✕" Style="{StaticResource CmpZ5ChipCloseStyle}"
                                Command="{Binding RemoveCommand}"
                                ToolTip="{loc:Str companion_awareness_deny_remove_tip}"/>
                    </StackPanel>
                </Border>
                <DataTemplate.Triggers>
                    <Trigger SourceName="ChipBd" Property="IsMouseOver" Value="True">
                        <Setter TargetName="RemoveBtn" Property="Opacity" Value="1"/>
                        <Setter TargetName="RemoveBtn" Property="IsHitTestVisible" Value="True"/>
                    </Trigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Style="{StaticResource CmpVioletCardStyle}">
        <StackPanel>

            <!-- ========== header ========== -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Image Width="16" Height="16" Margin="0,0,9,0" VerticalAlignment="Center"
                           Source="{Binding Source='👁', Converter={StaticResource CmpEmojiToImage}}"/>
                    <TextBlock Text="{loc:Str companion_awareness_title}" Style="{StaticResource CmpSectionTitleStyle}"/>
                </StackPanel>
                <Border Grid.Column="2" Style="{StaticResource CmpTrainTagStyle}">
                    <TextBlock Text="{loc:Str companion_tag_train2}" Style="{StaticResource CmpTrainTagTextStyle}"/>
                </Border>
            </Grid>

            <!-- ========== intensity dial ========== -->
            <Border Style="{StaticResource CmpSegmentStripStyle}" Margin="0,13,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <RadioButton Grid.Column="0" GroupName="CmpAwarenessDial" Content="{loc:Str companion_awareness_dial_off}"
                                 Style="{StaticResource CmpSegmentStyle}"
                                 IsChecked="{Binding Intensity, Mode=TwoWay,
                                             Converter={StaticResource CmpEnumEquals}, ConverterParameter=Off}"/>
                    <RadioButton Grid.Column="1" GroupName="CmpAwarenessDial" Content="{loc:Str companion_awareness_dial_broad}"
                                 Style="{StaticResource CmpSegmentStyle}"
                                 IsChecked="{Binding Intensity, Mode=TwoWay,
                                             Converter={StaticResource CmpEnumEquals}, ConverterParameter=BroadStrokes}"/>
                    <!-- pre-Train 2 the third stop is present but not selectable, and says why -->
                    <RadioButton Grid.Column="2" GroupName="CmpAwarenessDial" Content="{loc:Str companion_awareness_dial_everything}"
                                 IsEnabled="{Binding IsEverythingAvailable}"
                                 IsChecked="{Binding Intensity, Mode=TwoWay,
                                             Converter={StaticResource CmpEnumEquals}, ConverterParameter=Everything}">
                        <RadioButton.Style>
                            <Style TargetType="RadioButton" BasedOn="{StaticResource CmpSegmentStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEverythingAvailable}" Value="False">
                                        <Setter Property="ToolTip"
                                                Value="{loc:Str companion_awareness_everything_locked_tip}"/>
                                        <!-- a disabled control swallows ToolTip unless told otherwise -->
                                        <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </RadioButton.Style>
                    </RadioButton>
                </Grid>
            </Border>

            <!-- ========== the wire view ========== -->
            <Border Style="{StaticResource CmpWireStyle}"
                    Opacity="{Binding IsWireLive, Converter={StaticResource CmpBoolToOpacity},
                                      ConverterParameter=1.0|0.55}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{loc:Str companion_awareness_wire_prefix}" Style="{StaticResource CmpWireTextStyle}"/>
                    <TextBlock Text="{Binding WireLine}" Style="{StaticResource CmpWireTextStyle}"/>
                    <!-- blinking cursor: only alive while the frame is live -->
                    <Rectangle x:Name="WireCursor" Width="7" Height="14" Margin="9,0,0,0"
                               Fill="#FF8FE3B0" VerticalAlignment="Center"
                               Visibility="{Binding IsWireLive, Converter={StaticResource CmpBoolToVis}}"/>
                </StackPanel>
            </Border>

            <!-- the caption belongs to a live frame; when dormant the promise block speaks instead -->
            <TextBlock Text="{Binding WireCaption}" Style="{StaticResource CmpWireCaptionStyle}"
                       Visibility="{Binding IsDormant, Converter={StaticResource CmpBoolToVisInverse}}"/>

            <!-- ========== dormant promise (pre-Train 2) ========== -->
            <Grid Margin="0,6,0,12"
                  Visibility="{Binding IsDormant, Converter={StaticResource CmpBoolToVis}}">
                <Border x:Name="DormantHost" Style="{StaticResource CmpDormantBlockStyle}">
                    <Grid>
                        <TextBlock Text="{Binding DormantCopy}" Style="{StaticResource CmpDormantCopyStyle}"/>
                        <Border x:Name="DormantShimmer" Width="46" HorizontalAlignment="Left"
                                Background="{StaticResource CmpShimmerSoftBrush}"
                                IsHitTestVisible="False" Opacity="0">
                            <Border.RenderTransform>
                                <TransformGroup>
                                    <SkewTransform AngleX="-18"/>
                                    <TranslateTransform x:Name="DormantShimmerShift" X="-70"/>
                                </TransformGroup>
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                </Border>
                <Rectangle Style="{StaticResource CmpDashedOutlineStyle}"/>
            </Grid>

            <!-- ========== deny list ========== -->
            <ItemsControl ItemsSource="{Binding DenyList}" ItemTemplate="{StaticResource CmpDenyChipTemplate}"
                          Margin="0,0,0,4">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <!-- "+ add app…" — dashed, per the mockup's .d.add. A Border cannot dash, so the
                 outline is a Rectangle laid under a chrome-free button. -->
            <Grid HorizontalAlignment="Left" Margin="0,0,0,4">
                <Rectangle Style="{StaticResource CmpDashedOutlineStyle}" Stroke="#2EFFFFFF"
                           RadiusX="999" RadiusY="999"/>
                <Button Content="{Binding AddDenyLabel}" Command="{Binding AddDenyCommand}"
                        Cursor="Hand" Background="Transparent" BorderThickness="0"
                        FontSize="10.5" FontWeight="Bold" Padding="11,4,11,4"
                        Foreground="{StaticResource CmpMutedBrush}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="#08FFFFFF" local:CompanionCapsule.IsCapsule="True"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center"
                                                  TextBlock.Foreground="{TemplateBinding Foreground}"
                                                  TextBlock.FontSize="{TemplateBinding FontSize}"
                                                  TextBlock.FontWeight="Bold"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource CmpTextBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <TextBlock Text="{loc:Str companion_awareness_incognito}" Style="{StaticResource CmpFaintTextStyle}"
                       Margin="2,4,0,11"/>

            <!-- ========== page titles ========== -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Pre-Train 2 there is no setting behind this, so it reports the truth and
                         cannot be flipped. A switch that snaps back is worse than one that is
                         honestly unavailable — and this is the privacy card. -->
                    <ToggleButton Style="{StaticResource CmpToggleSwitchStyle}" Margin="0,0,9,0"
                                  ToolTip="{Binding PageTitlesLabel}"
                                  ToolTipService.ShowOnDisabled="True"
                                  IsEnabled="{Binding IsEverythingAvailable}"
                                  IsChecked="{Binding AllowPageTitles, Mode=TwoWay}"/>
                    <TextBlock Text="{Binding PageTitlesLabel}" FontSize="11.5" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <!-- hidden is the protective state, so it reads as the guard colour -->
                                <Setter Property="Foreground" Value="#FFFFB0BE"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AllowPageTitles}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource CmpDimBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
                <Button Grid.Column="1" Content="{loc:Str companion_awareness_allow_per_app}" Style="{StaticResource CmpLinkButtonStyle}"
                        Margin="10,0,0,0" Command="{Binding AllowPerAppCommand}"/>
                <Button Grid.Column="2" Content="{loc:Str companion_awareness_fine_tuning}" Style="{StaticResource CmpLinkButtonStyle}"
                        HorizontalAlignment="Right" Padding="0,2,0,2"
                        Command="{Binding FineTuningCommand}"/>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
