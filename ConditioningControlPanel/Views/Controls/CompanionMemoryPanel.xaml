<UserControl x:Class="ConditioningControlPanel.Views.Controls.CompanionMemoryPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="clr-namespace:ConditioningControlPanel.Localization"
             mc:Ignorable="d"
             d:DesignHeight="520" d:DesignWidth="760">

    <!-- ================================================================
         WHAT SHE KNOWS ABOUT YOU  (AI rework Train 1, doc 01 §2.4)

         The trust surface for the companion's memory: everything she has
         stored about you, inspectable, editable and deletable in one
         place. Non-negotiable for an adult app that keeps personal
         statements on disk, and it doubles as fan-service.

         Binding contract: the whole panel is bound to
         CompanionMemoryViewModel, which talks to IMemoryStore and nothing
         else. Train 1 ships an empty shell store, so the EMPTY STATE is
         the normal state on this branch - it must read as "she hasn't
         learned anything yet", never as a broken list.

         No converters are declared locally on purpose: BoolToVisibility /
         InverseBoolToVisibility live in the app-level Converters.xaml, so
         they resolve inside these DataTemplates (a converter parked in a
         local Grid.Resources does not - see CLAUDE.md).
         ================================================================ -->

    <StackPanel x:Name="LayoutRoot">

        <TextBlock Text="{loc:Str companion_memory_intro}"
                   Foreground="{DynamicResource TextDimBrush}" FontSize="13"
                   TextWrapping="Wrap" Margin="0,2,0,12"/>

        <!-- Brain switched off / failed to start: say so instead of showing a lying empty list. -->
        <Border Background="{DynamicResource SurfaceBgBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,10"
                Visibility="{Binding IsAvailable, Converter={StaticResource InverseBoolToVisibility}}">
            <TextBlock Text="{loc:Str companion_memory_unavailable}"
                       Foreground="{DynamicResource TextMutedBrush}" FontSize="13"
                       FontStyle="Italic" TextWrapping="Wrap"/>
        </Border>

        <!-- ==== READ-ONLY PROFILE BLOCK — "she can see" ==== -->
        <Border CornerRadius="10" Padding="12" Margin="0,0,0,12"
                Background="{DynamicResource SurfaceBgBrush}"
                BorderBrush="#9370DB" BorderThickness="1"
                Visibility="{Binding IsAvailable, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Image Width="15" Height="15" Margin="0,0,6,0" VerticalAlignment="Center"
                           Source="{Binding Source='👀', Converter={StaticResource EmojiToImageSource}}"/>
                    <TextBlock Text="{loc:Str companion_memory_profile_header}"
                               Foreground="#9370DB" FontSize="13" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Text="{loc:Str companion_memory_profile_empty}"
                           Foreground="{DynamicResource TextMutedBrush}" FontSize="12"
                           FontStyle="Italic" TextWrapping="Wrap"
                           Visibility="{Binding HasProfile, Converter={StaticResource InverseBoolToVisibility}}"/>

                <ItemsControl ItemsSource="{Binding ProfileSignals}"
                              Visibility="{Binding HasProfile, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Label}"
                                           Foreground="{DynamicResource TextDimBrush}" FontSize="12"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="1" Text="{Binding Value}"
                                           Foreground="White" FontSize="12" TextWrapping="Wrap"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- ==== FACT LIST ==== -->
        <Grid Margin="0,0,0,8"
              Visibility="{Binding IsAvailable, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{loc:Str companion_memory_facts_header}"
                           Foreground="White" FontSize="15" FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <Border Background="#2A1A3A" CornerRadius="4" Padding="6,2" Margin="10,0,0,0"
                        VerticalAlignment="Center" BorderBrush="{DynamicResource PinkBrush}" BorderThickness="1">
                    <TextBlock Text="{Binding FactCountText}" Foreground="{DynamicResource PinkBrush}" FontSize="11"/>
                </Border>
            </StackPanel>
            <Button x:Name="BtnForgetEverything" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Style="{StaticResource DangerButton}" Padding="10,5" FontSize="12" Cursor="Hand"
                    Click="BtnForgetEverything_Click"
                    ToolTip="{loc:Str companion_memory_forget_all_tooltip}">
                <StackPanel Orientation="Horizontal">
                    <Image Width="14" Height="14" Margin="0,0,6,0"
                           Source="{Binding Source='🧹', Converter={StaticResource EmojiToImageSource}}"/>
                    <TextBlock Text="{loc:Str btn_companion_memory_forget_all}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <Border CornerRadius="8" Padding="12" Margin="0,0,0,4"
                Background="{DynamicResource SurfaceBgBrush}" BorderBrush="#22808080" BorderThickness="1"
                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{loc:Str companion_memory_empty}"
                       Foreground="{DynamicResource TextMutedBrush}" FontSize="13"
                       FontStyle="Italic" TextWrapping="Wrap"/>
        </Border>

        <ItemsControl ItemsSource="{Binding Groups}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="{Binding Header}"
                                   Foreground="{DynamicResource PinkBrush}" FontSize="13" FontWeight="Bold"
                                   Margin="0,0,0,4"/>
                        <ItemsControl ItemsSource="{Binding Facts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource SurfaceBgBrush}" CornerRadius="6"
                                            Padding="10,8" Margin="0,0,0,4"
                                            BorderBrush="#22FF69B4" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Display state -->
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center"
                                                        Visibility="{Binding IsNotEditing, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="{Binding Text}" Foreground="White" FontSize="13"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock Text="{loc:Str companion_memory_source_user_edited}"
                                                           Foreground="{DynamicResource TextMutedBrush}" FontSize="10"
                                                           FontStyle="Italic" Margin="0,2,0,0"
                                                           Visibility="{Binding IsUserEdited, Converter={StaticResource BoolToVisibility}}"/>
                                            </StackPanel>

                                            <!-- Edit state -->
                                            <TextBox Grid.Column="0" VerticalAlignment="Center"
                                                     Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource FocusGlowTextBox}"
                                                     Background="{DynamicResource DarkerBgBrush}" Foreground="White"
                                                     BorderBrush="{DynamicResource PinkBrush}" BorderThickness="1"
                                                     Padding="6,4" FontSize="13" TextWrapping="Wrap"
                                                     AcceptsReturn="False"
                                                     KeyDown="EditBox_KeyDown"
                                                     Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}"/>

                                            <!-- Row actions: pin · edit · delete -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Visibility="{Binding IsNotEditing, Converter={StaticResource BoolToVisibility}}">
                                                <Button Click="BtnPinFact_Click" Cursor="Hand"
                                                        Background="Transparent" BorderThickness="0" Padding="6,2"
                                                        ToolTip="{Binding PinToolTip}">
                                                    <Image Width="15" Height="15"
                                                           Source="{Binding PinEmoji, Converter={StaticResource EmojiToImageSource}}"/>
                                                </Button>
                                                <Button Click="BtnEditFact_Click" Cursor="Hand"
                                                        Background="Transparent" BorderThickness="0" Padding="6,2"
                                                        ToolTip="{loc:Str companion_memory_edit_tooltip}">
                                                    <Image Width="15" Height="15"
                                                           Source="{Binding Source='✏️', Converter={StaticResource EmojiToImageSource}}"/>
                                                </Button>
                                                <Button Click="BtnDeleteFact_Click" Cursor="Hand"
                                                        Background="Transparent" BorderThickness="0" Padding="6,2"
                                                        ToolTip="{loc:Str companion_memory_delete_tooltip}">
                                                    <Image Width="15" Height="15"
                                                           Source="{Binding Source='🗑️', Converter={StaticResource EmojiToImageSource}}"/>
                                                </Button>
                                            </StackPanel>

                                            <!-- Edit actions: save · cancel -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}">
                                                <Button Content="{loc:Str companion_memory_save}" Click="BtnSaveFact_Click"
                                                        Background="{DynamicResource PinkBrush}" Foreground="White"
                                                        BorderThickness="0" Padding="10,4" FontSize="12" Cursor="Hand"
                                                        Margin="0,0,6,0"/>
                                                <Button Content="{loc:Str companion_memory_cancel}" Click="BtnCancelFact_Click"
                                                        Background="{DynamicResource SurfaceBgBrush}" Foreground="White"
                                                        BorderBrush="#505050" BorderThickness="1"
                                                        Padding="10,4" FontSize="12" Cursor="Hand"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

    </StackPanel>
</UserControl>
