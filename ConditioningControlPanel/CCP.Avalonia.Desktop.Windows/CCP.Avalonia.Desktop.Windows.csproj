<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>ConditioningControlPanel.Avalonia.Desktop.Windows</RootNamespace>
    <AssemblyName>CCP.Desktop.Windows</AssemblyName>
    <Version>6.3.1</Version>
    <ApplicationIcon>..\Resources\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- The Microsoft.WindowsAppSDK reference triggers WebView2's WinRT projection path,
         which only references Core.Projection and omits WinForms/WPF. Force the regular
         managed path so Microsoft.Web.WebView2.WinForms is available. -->
    <WebView2EnableCsWinRTProjection>false</WebView2EnableCsWinRTProjection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.0.5" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.23.1" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3179.45" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <!-- Vosk = local, closed-grammar offline STT for the "She's Listening" voice engine
         (WindowsSpeechService). Native libvosk ships in the package. -->
    <PackageReference Include="Vosk" Version="0.3.38" />
    <PackageReference Include="OpenCvSharp4" Version="4.9.0.20240103" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.9.0.20240103" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.20.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.0" />
    <!-- Dedicated offline wake-word engine for "Hey Bambi" (sherpa-onnx keyword spotting). The .runtime.win-x64 dep carries the native lib. Offline only — audio stays on device. -->
    <PackageReference Include="org.k2fsa.sherpa.onnx" Version="1.13.3" />
    <PackageReference Include="org.k2fsa.sherpa.onnx.runtime.win-x64" Version="1.13.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Share the dev-dropped Vosk acoustic model with the WPF head (gitignored, not in repo).
         Resolved at runtime by WindowsSpeechService.ModelRoot = <output>/Resources/Models/vosk.
         Empty until a model is dropped into ConditioningControlPanel/Resources/Models/vosk. -->
    <Content Include="..\Resources\Models\**\*" Link="Resources\Models\%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\Resources\tutorial_videos\_test_loop.mp4">
      <Link>_test_loop.mp4</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\Resources\sounds\chime1.mp3">
      <Link>chime1.mp3</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Chaos tunnel web assets (three.js tunnel page + vendor libs), served via the IBrowserHost virtual host. -->
    <Content Include="..\Resources\web\**\*" Link="Resources\web\%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <ProjectReference Include="..\CCP.Avalonia.Desktop\CCP.Avalonia.Desktop.csproj" />

    <!-- Smoke test harness is kept out of the production source tree and only
         linked into Debug builds so the smoke test switch still works for
         development/CI without shipping the harness in release builds. -->
    <Compile Include="..\tests\CCP.Avalonia.Desktop.Windows.Smoke\SmokeTestLogSink.cs" Link="SmokeTest\SmokeTestLogSink.cs" Condition="'$(Configuration)' == 'Debug'" />
    <Compile Include="..\tests\CCP.Avalonia.Desktop.Windows.Smoke\SmokeTestRunner.cs" Link="SmokeTest\SmokeTestRunner.cs" Condition="'$(Configuration)' == 'Debug'" />
    <Compile Include="..\tests\CCP.Avalonia.Desktop.Windows.Smoke\SpiralVerification.cs" Link="SmokeTest\SpiralVerification.cs" Condition="'$(Configuration)' == 'Debug'" />
    <Compile Include="..\tests\CCP.Avalonia.Desktop.Windows.Smoke\VideoVerification.cs" Link="SmokeTest\VideoVerification.cs" Condition="'$(Configuration)' == 'Debug'" />
    <Compile Include="..\tests\CCP.Avalonia.Desktop.Windows.Smoke\LayerVerification.cs" Link="SmokeTest\LayerVerification.cs" Condition="'$(Configuration)' == 'Debug'" />
    <Compile Include="..\tests\CCP.Avalonia.Desktop.Windows.Smoke\AvatarTubeVerification.cs" Link="SmokeTest\AvatarTubeVerification.cs" Condition="'$(Configuration)' == 'Debug'" />
    <Compile Include="..\tests\CCP.Avalonia.Desktop.Windows.Smoke\VisibleOverlayVerification.cs" Link="SmokeTest\VisibleOverlayVerification.cs" Condition="'$(Configuration)' == 'Debug'" />
  </ItemGroup>

  <!-- WebView2's managed targets always reference the WPF assembly for .NET 5+ projects.
       This head only uses the WinForms control, so drop the WPF reference to avoid
       WindowsBase version-conflict warnings and unnecessary copy-local. -->
  <Target Name="RemoveWebView2WpfReference" AfterTargets="ResolvePackageAssets">
    <ItemGroup>
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)" Condition="$([System.String]::new('%(Filename)').StartsWith('Microsoft.Web.WebView2.Wpf'))" />
      <Reference Remove="@(Reference)" Condition="$([System.String]::new('%(Filename)').StartsWith('Microsoft.Web.WebView2.Wpf'))" />
    </ItemGroup>
  </Target>

</Project>
