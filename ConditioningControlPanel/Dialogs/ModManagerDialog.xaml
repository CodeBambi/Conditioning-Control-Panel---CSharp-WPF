<Window x:Class="ConditioningControlPanel.ModManagerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ConditioningControlPanel.Localization"
        xmlns:cmp="clr-namespace:ConditioningControlPanel.Views.Controls.Companion"
        Title="{loc:Str dialog_customise}"
        Width="860" SizeToContent="Height" MinHeight="580"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <!-- CUSTOMISE. One mental model, left to right: pick a MOD (the skin: look, words, voice),
         and the mod carries a COMPANION (look + personality), edited in its own card (or previewed,
         read-only, for a mod not in use). Per-mod default presets are
         dropdowns: a mod's suggestion only pre-selects, the user's choice is what applies. -->
    <Window.Resources>
        <Style x:Key="CcpBtn" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{DynamicResource PanelAccentBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="10"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LinkBtn" TargetType="Button">
            <Setter Property="Foreground" Value="#B084DC"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="t" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                   Background="Transparent"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="t" Property="TextDecorations" Value="Underline"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource DarkerBgBrush}" CornerRadius="12" BorderBrush="{DynamicResource PinkBrush}" BorderThickness="2">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0" Background="{DynamicResource PanelBgBrush}" CornerRadius="12,12,0,0" Padding="22,14"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <TextBlock Text="{loc:Str dialog_customise}" Foreground="{DynamicResource PinkBrush}" FontSize="20" FontWeight="Bold"
                               VerticalAlignment="Center"/>
                    <Button x:Name="BtnClose" Content="X" Click="BtnClose_Click"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Background="Transparent" Foreground="{DynamicResource TextMutedBrush}" FontSize="16" FontWeight="Bold"
                            BorderThickness="0" Cursor="Hand" Padding="8,2"
                            Width="30" Height="30"/>
                </Grid>
            </Border>

            <!-- Main Content -->
            <Grid Grid.Row="1" Margin="18,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Mod list: a dot in each mod's accent, IN USE on the active one -->
                <Border Grid.Column="0" Background="{DynamicResource PanelBgBrush}" CornerRadius="12" Margin="0,0,16,0" Padding="6">
                    <ListBox x:Name="ModList" Background="Transparent" BorderThickness="0"
                             SelectionChanged="ModList_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             Foreground="White" FontSize="14">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="Padding" Value="10,9"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Background="Transparent" CornerRadius="9" BorderThickness="1"
                                                    BorderBrush="Transparent" Padding="{TemplateBinding Padding}" Margin="0,2">
                                                <ContentPresenter HorizontalAlignment="Stretch"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#2A2A4A"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#2E2944"/>
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PinkBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Border>

                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" MaxHeight="620">
                    <StackPanel x:Name="DetailsPanel" Visibility="Collapsed">

                        <!-- 1. Banner across the top, name and one line over it, the one primary action on its right -->
                        <Border x:Name="BannerPanel" Height="120" CornerRadius="12" ClipToBounds="True"
                                Background="{DynamicResource PanelAccentBrush}" Margin="0,0,0,14">
                            <Grid>
                                <Image x:Name="ImgModPreview" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <!-- scrim so the name reads over any art -->
                                <Rectangle>
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#30120F1C" Offset="0"/>
                                            <GradientStop Color="#E6120F1C" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                                <Grid Margin="18,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Bottom" Margin="0,0,12,0">
                                        <TextBlock x:Name="TxtModName" FontSize="28" FontWeight="Bold" Foreground="White"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="TxtModDescription" FontSize="13" Foreground="#D9D2EA" Margin="0,4,0,0"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="TxtModAuthor" FontSize="11" Foreground="#A9A1C0" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Button x:Name="BtnActivate" Grid.Column="1" Content="{loc:Str modmgr_use_this_mod}" Click="BtnActivate_Click"
                                            Style="{StaticResource CcpBtn}" Background="{DynamicResource PinkBrush}"
                                            FontSize="15" FontWeight="Bold" Padding="22,11" VerticalAlignment="Bottom"/>
                                    <Border x:Name="TxtActiveIndicator" Grid.Column="1" CornerRadius="16" Padding="14,7" Background="#CC1E3A2A"
                                            BorderBrush="#4CAF50" BorderThickness="1" VerticalAlignment="Bottom" Visibility="Collapsed">
                                        <TextBlock Text="{loc:Str modmgr_in_use}" Foreground="#7FF0CB" FontSize="12" FontWeight="Bold"/>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Content pack row: built-in mods whose media (voice lines, portraits,
                             DTRH barks) lives in a release-hosted pack that is not downloaded yet.
                             Hidden entirely on full/dev installs and for user mods. -->
                        <Border x:Name="PackPanel" Background="{DynamicResource PanelBgBrush}" CornerRadius="12"
                                Padding="14" Margin="0,0,0,14" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock x:Name="TxtPackState" Text="{loc:Str modmgr_pack_not_downloaded}"
                                           Foreground="#FFB347" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Text="{loc:Str modmgr_pack_hint}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"
                                           TextWrapping="Wrap" Margin="0,5,0,0"/>
                                <ProgressBar x:Name="PackProgress" Height="6" Minimum="0" Maximum="100" Value="0"
                                             Background="#252542" Foreground="{DynamicResource PinkBrush}"
                                             BorderThickness="0" Margin="0,10,0,0" Visibility="Collapsed"/>
                                <Button x:Name="BtnDownloadPack" Click="BtnDownloadPack_Click" Style="{StaticResource CcpBtn}"
                                        Background="{DynamicResource PinkBrush}" FontWeight="SemiBold"
                                        HorizontalAlignment="Left" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- 2. The companion this mod carries: live for the mod in use, a read-only preview otherwise -->
                        <cmp:CompanionPickerCard x:Name="CompanionCard" Margin="0,0,0,14"/>

                        <!-- 3. Per-mod defaults: what loads each time you switch to this mod. Shown for the
                             mod in use and for a previewed one, so it can be set before switching. -->
                        <Border Background="{DynamicResource PanelBgBrush}" CornerRadius="12" Padding="14,10"
                                BorderBrush="{DynamicResource PanelAccentBrush}" BorderThickness="1"
                                ToolTip="{loc:Str modmgr_defaults_tooltip}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{loc:Str modmgr_label_settings_preset}" FontSize="11"
                                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,3"/>
                                    <ComboBox x:Name="CmbDefaultSettings" Style="{DynamicResource DarkComboBoxStyle}"
                                              Foreground="{DynamicResource TextLightBrush}" MinHeight="30"
                                              SelectionChanged="CmbDefaultSettings_SelectionChanged"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{loc:Str modmgr_label_asset_preset}" FontSize="11"
                                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,3"/>
                                    <ComboBox x:Name="CmbDefaultAssets" Style="{DynamicResource DarkComboBoxStyle}"
                                              Foreground="{DynamicResource TextLightBrush}" MinHeight="30"
                                              SelectionChanged="CmbDefaultAssets_SelectionChanged"/>
                                </StackPanel>
                                <Button x:Name="BtnQuickLinkLayout" Grid.Column="4" Content="{loc:Str modmgr_dashboard_soon}"
                                        Style="{StaticResource CcpBtn}" IsEnabled="False" Padding="14,0" MinHeight="30"
                                        VerticalAlignment="Bottom"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Bottom Bar: get, make, and everything else behind the overflow -->
            <Border Grid.Row="2" Background="{DynamicResource PanelBgBrush}" CornerRadius="0,0,12,12" Padding="18,12">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button x:Name="BtnBrowseCatalogue" Content="{loc:Str btn_browse_mod_catalogue}" Click="BtnBrowseCatalogue_Click"
                                ToolTip="{loc:Str tooltip_browse_mod_catalogue}" Style="{StaticResource CcpBtn}"
                                Padding="16,9" FontSize="13" Margin="0,0,10,0"/>
                        <Button x:Name="BtnCreate" Content="{loc:Str btn_create_new_2}" Click="BtnCreate_Click"
                                Style="{StaticResource CcpBtn}" Background="Transparent" BorderBrush="{DynamicResource PinkBrush}" BorderThickness="1"
                                Foreground="{DynamicResource PinkBrush}" FontWeight="Bold" Padding="16,9" FontSize="13"/>
                    </StackPanel>
                    <Button x:Name="BtnMore" Content="..." Click="BtnMore_Click" ToolTip="{loc:Str modmgr_more}"
                            HorizontalAlignment="Right" Style="{StaticResource CcpBtn}" FontSize="14" Padding="14,6">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem x:Name="BtnInstall" Header="{loc:Str btn_install_from_file}" Click="BtnInstall_Click"/>
                                <MenuItem x:Name="BtnExport" Header="{loc:Str btn_export_current}" Click="BtnExport_Click"/>
                                <Separator x:Name="SepModActions"/>
                                <MenuItem x:Name="BtnShare" Header="{loc:Str btn_share_mod}" Click="BtnShare_Click"/>
                                <MenuItem x:Name="BtnUninstall" Header="{loc:Str btn_uninstall}" Click="BtnUninstall_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
