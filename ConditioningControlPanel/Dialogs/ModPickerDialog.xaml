<Window x:Class="ConditioningControlPanel.ModPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hover="clr-namespace:ConditioningControlPanel.Behaviors"
        xmlns:loc="clr-namespace:ConditioningControlPanel.Localization"
        Title="{loc:Str dialog_mod_picker}"
        Height="720" Width="840"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <!-- Card visuals are driven by plain INPC properties on ModPickerCard (including the
         Visibility ones) rather than value converters, so nothing here depends on a converter
         living in the right resource scope inside a DataTemplate. -->
    <Window.Resources>
        <Style x:Key="CardShell" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelBgBrush}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource DarkerBgBrush}" CornerRadius="12"
            BorderBrush="{DynamicResource PinkBrush}" BorderThickness="2">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0" Background="{DynamicResource PanelBgBrush}" CornerRadius="12,12,0,0" Padding="20,12"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <TextBlock Text="{loc:Str modpicker_title}" Foreground="{DynamicResource PinkBrush}"
                               FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Button x:Name="BtnCloseX" Content="X" Click="BtnSkip_Click"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Background="Transparent" Foreground="{DynamicResource TextMutedBrush}" FontSize="16" FontWeight="Bold"
                            BorderThickness="0" Cursor="Hand" Padding="8,2"
                            Width="30" Height="30"/>
                </Grid>
            </Border>

            <!-- Subtitle -->
            <TextBlock Grid.Row="1" Text="{loc:Str modpicker_subtitle}"
                       Foreground="#C0C0C0" FontSize="13" TextWrapping="Wrap"
                       Margin="20,14,20,10"/>

            <!-- Cards -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="20,0,20,0" Padding="0,0,8,0">
                <ItemsControl x:Name="CardsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardShell}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Art -->
                                    <!-- ClipToBounds added with the hover pop: without it the 1.06
                                         zoom paints the mod art straight over the accent border. -->
                                    <Border Grid.Column="0" Width="86" Height="86" CornerRadius="8"
                                            BorderBrush="{Binding AccentBrush}" BorderThickness="2"
                                            ClipToBounds="True"
                                            Background="#1A1A2E" Margin="0,0,14,0">
                                        <Image Source="{Binding ArtUri}" Stretch="UniformToFill"
                                               RenderOptions.BitmapScalingMode="HighQuality"
                                               hover:HoverPop.IsEnabled="True"/>
                                    </Border>

                                    <!-- Text block -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" Foreground="White"
                                                   FontSize="16" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding Description}" Foreground="#C0C0C0"
                                                   FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>

                                        <!-- Honesty notes -->
                                        <TextBlock Text="{Binding PremiumNote}" Visibility="{Binding PremiumNoteVisibility}"
                                                   Foreground="#FFB347" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                        <TextBlock Text="{Binding VoiceNote}" Visibility="{Binding VoiceNoteVisibility}"
                                                   Foreground="#FFB347" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"/>

                                        <!-- Progress -->
                                        <Grid Visibility="{Binding ProgressVisibility}" Margin="0,8,0,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <ProgressBar Grid.Row="0" Height="6" Minimum="0" Maximum="100"
                                                         Value="{Binding Percent, Mode=OneWay}"
                                                         Background="#252542" Foreground="{Binding AccentBrush}"
                                                         BorderThickness="0"/>
                                            <TextBlock Grid.Row="1" Text="{Binding StatusText}" Foreground="{DynamicResource TextMutedBrush}"
                                                       FontSize="11" Margin="0,4,0,0"/>
                                        </Grid>

                                        <!-- Status-only line (queued / done / failed, no bar) -->
                                        <TextBlock Text="{Binding StatusText}" Visibility="{Binding StatusOnlyVisibility}"
                                                   Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,8,0,0"/>
                                    </StackPanel>

                                    <!-- Size badge + selection -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"
                                                Margin="14,0,0,0">
                                        <Border Background="{DynamicResource PanelAccentBrush}" CornerRadius="10"
                                                Padding="10,4" HorizontalAlignment="Right"
                                                Visibility="{Binding SizeVisibility}">
                                            <TextBlock Text="{Binding SizeText}" Foreground="#E0E0E0"
                                                       FontSize="12" FontWeight="SemiBold"/>
                                        </Border>
                                        <TextBlock Text="{loc:Str modpicker_installed_badge}"
                                                   Visibility="{Binding InstalledVisibility}"
                                                   Foreground="#4CAF50" FontSize="12" FontWeight="SemiBold"
                                                   HorizontalAlignment="Right" Margin="0,6,0,0"/>
                                        <CheckBox Style="{StaticResource ItemCheckBox}"
                                                  Visibility="{Binding SelectVisibility}"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  IsEnabled="{Binding CanSelect}"
                                                  HorizontalAlignment="Right" Margin="0,10,2,0"
                                                  Cursor="Hand"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Hint line: background-continue normally, offline copy when the manifest is missing -->
            <TextBlock x:Name="TxtHint" Grid.Row="3" Text="{loc:Str modpicker_hint_background}"
                       Foreground="{DynamicResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap"
                       Margin="20,6,20,10"/>

            <!-- Buttons -->
            <Border Grid.Row="4" Background="{DynamicResource PanelBgBrush}" CornerRadius="0,0,12,12" Padding="20,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="BtnSkip" Grid.Column="0" Content="{loc:Str modpicker_btn_skip}"
                            Click="BtnSkip_Click" Style="{StaticResource OutlineButton}"
                            HorizontalAlignment="Left" FontSize="12" Padding="18,10"/>

                    <Button x:Name="BtnDownload" Grid.Column="1" Content="{loc:Str modpicker_btn_download}"
                            Click="BtnDownload_Click" Style="{StaticResource PinkButton}"
                            HorizontalAlignment="Right" Margin="14,0,0,0"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
