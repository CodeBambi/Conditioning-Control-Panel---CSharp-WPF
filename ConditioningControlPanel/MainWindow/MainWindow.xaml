                            poss:Possession.Role="TabHeader" poss:Possession.Name="the Settings door"
                            Background="#225CE0A5" BorderBrush="#5CE0A5"
                            Click="NavDoor_Click" ToolTip="{loc:Str nav_door_settings}">
                        <!-- Medallion: see DoorHome for what the four children are for. -->
