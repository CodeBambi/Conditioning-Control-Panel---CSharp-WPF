<!-- THE PREMIUM SPARK (polish 12, owner 2026-10-07). A die-cut cardstock sparkle in the header,
     between the welcome banner and the update pill, with PREMIUM cut out underneath. The card,
     its paper shadow, the grain, the sheen and the letters are built in code from one star path
     (PremiumSpark.xaml.cs); every state and timing is in PremiumSparkRules. No Effect anywhere:
     the paper shadow is a second cut of the same shape (Depth law). Click opens Premium. -->
<Button x:Class="ConditioningControlPanel.Controls.Header.PremiumSpark"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="54" Height="42" Cursor="Hand" Padding="0"
        Background="Transparent" BorderThickness="0"
        FocusVisualStyle="{x:Null}">
    <Button.Template>
        <ControlTemplate TargetType="Button">
            <Border Background="Transparent">
                <ContentPresenter/>
            </Border>
        </ControlTemplate>
    </Button.Template>
    <Grid x:Name="Root" ClipToBounds="False">
        <!-- Prime only: the cyan halo behind the card. A radial gradient ellipse, never a blur. -->
        <Ellipse x:Name="Halo" Width="52" Height="52" Margin="0,-11,0,0"
                 HorizontalAlignment="Center" VerticalAlignment="Top"
                 IsHitTestVisible="False" Opacity="0"/>
        <!-- The cutout: shadow, die-cut, face, grain, highlight, sheen, label. One transform
             group carries breath (scale), lean + wobble (rotate) and lift / press (translate). -->
        <Canvas x:Name="Cutout" Width="54" Height="42" RenderTransformOrigin="0.5,0.42">
            <Canvas.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="BreathScale"/>
                    <RotateTransform x:Name="TiltRotate"/>
                    <TranslateTransform x:Name="LiftShift"/>
                </TransformGroup>
            </Canvas.RenderTransform>
        </Canvas>
        <!-- The particle overlay: a fixed pool of small shapes the 30 fps clock fills from
             PremiumSparkField (glitter, orbits, glints, diamonds, flares, click bursts). It takes
             no layout space, is never clipped (motes spill past the card) and never hit-tests. -->
        <Canvas x:Name="FxLayer" IsHitTestVisible="False" ClipToBounds="False"/>
    </Grid>
</Button>
