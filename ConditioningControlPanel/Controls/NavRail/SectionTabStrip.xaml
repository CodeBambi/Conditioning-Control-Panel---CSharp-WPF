<UserControl x:Class="ConditioningControlPanel.Controls.NavRail.SectionTabStrip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <!-- Nav rework 2026-10-06: the section page header. Breadcrumb "Section > Page" (the
         section word returns to that section's last tab), the section's pills (filled = the tab
         on screen), a one-line "Moved" note, and the 2 px accent line in the section hue.
         Pills are built in code from NavSections; nothing here scrolls horizontally. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2" />
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- The page word has one fixed width per section (FixCrumbWidth) and the track keeps
                 its height when Settings hides it, so pills never move and every header row is
                 the same height. -->
            <StackPanel x:Name="CrumbPanel" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,18,0">
                <Button x:Name="CrumbSection" Cursor="Hand" Focusable="True" Padding="0"
                        Background="Transparent" BorderThickness="0" Click="CrumbSection_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="4,1"
                                    BorderThickness="2" BorderBrush="Transparent">
                                <ContentPresenter VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#14FFFFFF" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#CCFFFFFF" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <TextBlock x:Name="CrumbSectionText" FontSize="14" FontWeight="ExtraBold" />
                </Button>
                <TextBlock x:Name="CrumbSep" FontSize="14" Margin="4,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextMutedBrush}" />
                <TextBlock x:Name="CrumbPage" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextLightBrush}" />
            </StackPanel>

            <!-- Polish wave 3: the track is a real tab bar, so the pills read as THE page tabs at
                 one glance. Polish wave 7: a tray darker than the page wash (paint in PaintFor),
                 38 px pills + 2 x 4 padding + 2 x 1.5 border = 49. -->
            <!-- Polish wave 10 (depth): the tray is SUNKEN. A well floor under the wave 7 track
                 fill, then the inner top / left bands and the lit foot line, all hit-test off and
                 all clipped by the tray's own CornerRadius (the bands are absolute-mapped brushes
                 set in PaintDepthPages, so a 9 px band stays 9 px on a 49 px tray). -->
            <Grid x:Name="TrayHost" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center">
            <Border x:Name="TrayFloor" CornerRadius="21" IsHitTestVisible="False" />
            <Border x:Name="TrayWellTop" CornerRadius="21" IsHitTestVisible="False" />
            <Border x:Name="TrayWellLeft" CornerRadius="21" IsHitTestVisible="False" />
            <Border x:Name="TrayWellFoot" CornerRadius="21" IsHitTestVisible="False" BorderThickness="0,0,0,1" />
            <Border x:Name="PillTrack" HorizontalAlignment="Left" VerticalAlignment="Center"
                    CornerRadius="21" Background="#12FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1.5" Padding="4"
                    MinHeight="49">
                <Grid>
                    <Border x:Name="ActiveFill" CornerRadius="19" HorizontalAlignment="Left" Width="0"
                            IsHitTestVisible="False">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="ActiveFillShift" />
                        </Border.RenderTransform>
                    </Border>
                    <StackPanel x:Name="PillRow" Orientation="Horizontal" />
                </Grid>
            </Border>
            </Grid>

            <Border x:Name="MovedNote" Grid.Column="2" VerticalAlignment="Center" CornerRadius="12"
                    Padding="12,4" Background="#E61B1026" BorderThickness="1" Visibility="Collapsed"
                    Opacity="0" IsHitTestVisible="False">
                <TextBlock x:Name="MovedNoteText" FontSize="12.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextLightBrush}" />
            </Border>
        </Grid>
        <Border x:Name="AccentLine" Grid.Row="1" CornerRadius="1" Opacity="0.85" />
    </Grid>
</UserControl>
