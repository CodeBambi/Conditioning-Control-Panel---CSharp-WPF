<UserControl x:Class="ConditioningControlPanel.Controls.AfterglowOptionsBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:ConditioningControlPanel.Localization">
    <!-- Super Afterglow's own option box (owner, 2026-10-01): its own frequency, a burst of up to 4,
         word size and the two glow colours. Standalone on purpose: the panel adds it with ONE line,
         so the gold V2 box can host it later without a rewrite. Collapsed behind a small header;
         hidden for a locked player whose switch is off. Logic: Services/Super/AfterglowOptions. -->
    <Border x:Name="Frame" CornerRadius="12" Padding="14,6,14,6" Margin="0,0,0,10"
            Background="#B3140C26" BorderBrush="#4DFF4FA3" BorderThickness="1">
        <StackPanel>
            <Button x:Name="BtnHeader" Click="BtnHeader_Click" Cursor="Hand" HorizontalAlignment="Left"
                    AutomationProperties.AutomationId="AfterglowOptionsHeader">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="0,4">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="Chevron" Text="&#x203A;" FontSize="16" FontWeight="Bold" Width="12"
                               Foreground="{StaticResource PinkBrush}" VerticalAlignment="Center"
                               RenderTransformOrigin="0.5,0.5">
                        <TextBlock.RenderTransform>
                            <RotateTransform x:Name="ChevronTurn" Angle="0"/>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                    <TextBlock Text="{loc:Str super_afterglow_options}" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{StaticResource TextLightBrush}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                </StackPanel>
            </Button>

            <StackPanel x:Name="Body" Visibility="Collapsed" Margin="0,2,0,4">
                <CheckBox x:Name="ChkOnly" Content="{loc:Str super_afterglow_only}" Margin="0,2,0,6"
                          Foreground="{StaticResource TextLightBrush}" FontSize="13"
                          ToolTip="{loc:Str super_afterglow_only_tip}"
                          Checked="ChkOnly_Changed" Unchecked="ChkOnly_Changed"
                          AutomationProperties.AutomationId="AfterglowOnly"/>
                <Grid Height="34" Background="Transparent" ToolTip="{loc:Str super_afterglow_frequency_tip}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="110"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto" MinWidth="40"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:Str super_afterglow_frequency}" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource TextLightBrush}" VerticalAlignment="Center"/>
                    <Slider Grid.Column="1" x:Name="SliderFrequency" Minimum="1" Maximum="10" Value="5"
                            IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" Margin="14,0"
                            ValueChanged="SliderFrequency_Changed"/>
                    <TextBlock Grid.Column="2" x:Name="TxtFrequency" Text="5" HorizontalAlignment="Right"
                               VerticalAlignment="Center" Foreground="{StaticResource PinkBrush}" FontSize="13" FontWeight="Bold"/>
                </Grid>

                <Grid Height="34" Background="Transparent" ToolTip="{loc:Str super_afterglow_count_tip}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="110"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto" MinWidth="40"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:Str super_afterglow_count}" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource TextLightBrush}" VerticalAlignment="Center"/>
                    <Slider Grid.Column="1" x:Name="SliderCount" Minimum="1" Maximum="4" Value="1"
                            IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" Margin="14,0"
                            ValueChanged="SliderCount_Changed"/>
                    <TextBlock Grid.Column="2" x:Name="TxtCount" Text="1" HorizontalAlignment="Right"
                               VerticalAlignment="Center" Foreground="{StaticResource PinkBrush}" FontSize="13" FontWeight="Bold"/>
                </Grid>

                <Grid Height="34" Background="Transparent" ToolTip="{loc:Str super_afterglow_size_tip}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="110"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto" MinWidth="40"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:Str super_afterglow_size}" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource TextLightBrush}" VerticalAlignment="Center"/>
                    <Slider Grid.Column="1" x:Name="SliderSize" Minimum="1" Maximum="10" Value="5"
                            IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" Margin="14,0"
                            ValueChanged="SliderSize_Changed"/>
                    <TextBlock Grid.Column="2" x:Name="TxtSize" Text="5" HorizontalAlignment="Right"
                               VerticalAlignment="Center" Foreground="{StaticResource PinkBrush}" FontSize="13" FontWeight="Bold"/>
                </Grid>

                <Grid Height="34" Background="Transparent" ToolTip="{loc:Str super_afterglow_duration_tip}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="110"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto" MinWidth="40"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:Str super_afterglow_duration}" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource TextLightBrush}" VerticalAlignment="Center"/>
                    <Slider Grid.Column="1" x:Name="SliderDuration" Minimum="1" Maximum="10" Value="5"
                            IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" Margin="14,0"
                            ValueChanged="SliderDuration_Changed"/>
                    <TextBlock Grid.Column="2" x:Name="TxtDuration" Text="5" HorizontalAlignment="Right"
                               VerticalAlignment="Center" Foreground="{StaticResource PinkBrush}" FontSize="13" FontWeight="Bold"/>
                </Grid>

                <Grid Height="34" Background="Transparent" ToolTip="{loc:Str super_afterglow_opacity_tip}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="110"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto" MinWidth="40"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:Str super_afterglow_opacity}" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource TextLightBrush}" VerticalAlignment="Center"/>
                    <Slider Grid.Column="1" x:Name="SliderOpacity" Minimum="10" Maximum="100" Value="100"
                            IsSnapToTickEnabled="True" TickFrequency="5" VerticalAlignment="Center" Margin="14,0"
                            ValueChanged="SliderOpacity_Changed"/>
                    <TextBlock Grid.Column="2" x:Name="TxtOpacity" Text="100" HorizontalAlignment="Right"
                               VerticalAlignment="Center" Foreground="{StaticResource PinkBrush}" FontSize="13" FontWeight="Bold"/>
                </Grid>

                <Grid Height="34" Background="Transparent" ToolTip="{loc:Str super_afterglow_tilt_tip}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="110"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto" MinWidth="40"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:Str super_afterglow_tilt}" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource TextLightBrush}" VerticalAlignment="Center"/>
                    <Slider Grid.Column="1" x:Name="SliderTilt" Minimum="0" Maximum="10" Value="5"
                            IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" Margin="14,0"
                            ValueChanged="SliderTilt_Changed"/>
                    <TextBlock Grid.Column="2" x:Name="TxtTilt" Text="5" HorizontalAlignment="Right"
                               VerticalAlignment="Center" Foreground="{StaticResource PinkBrush}" FontSize="13" FontWeight="Bold"/>
                </Grid>

                <!-- Colours: two swatch buttons (the app's own colour dialog), a live preview of the
                     pair and Reset. -->
                <WrapPanel Margin="0,6,0,0" ToolTip="{loc:Str super_afterglow_colors_tip}">
                    <Button x:Name="BtnColorA" Style="{StaticResource SmallPinkButton}" Click="BtnColorA_Click"
                            Margin="0,0,6,4" AutomationProperties.AutomationId="AfterglowColorA">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="SwatchA" Width="14" Height="14" CornerRadius="4" Background="#FF5FB0"
                                    BorderBrush="#66FFFFFF" BorderThickness="1" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:Str super_afterglow_color_1}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnColorB" Style="{StaticResource SmallPinkButton}" Click="BtnColorB_Click"
                            Margin="0,0,10,4" AutomationProperties.AutomationId="AfterglowColorB">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="SwatchB" Width="14" Height="14" CornerRadius="4" Background="#5FFFD0"
                                    BorderBrush="#66FFFFFF" BorderThickness="1" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:Str super_afterglow_color_2}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Border x:Name="Preview" Width="64" Height="22" CornerRadius="6" Margin="0,0,10,4"
                            BorderBrush="#33FFFFFF" BorderThickness="1" VerticalAlignment="Center">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#FF5FB0" Offset="0.2"/>
                                <GradientStop Color="#5FFFD0" Offset="0.8"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Button x:Name="BtnResetColors" Content="{loc:Str btn_reset}" Style="{StaticResource SmallPinkButton}"
                            Click="BtnResetColors_Click" Margin="0,0,0,4" VerticalAlignment="Center"/>
                </WrapPanel>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
