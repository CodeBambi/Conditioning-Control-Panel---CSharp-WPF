<UserControl x:Class="ConditioningControlPanel.Controls.EmiDock"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:emi="clr-namespace:ConditioningControlPanel.Services.EmiDesk"
             Margin="0,2,0,4">

    <!--
        THE DOCK CHIP. EMI's way in and out when she is not already out, pinned under the nav rail's
        doors.

        Deliberately NOT a door medallion: no NavDoorMap row, no "you are here" ring, and above all
        no `Viewbox Grid.Column="0" Width="40" Height="40"` inside MainWindow.xaml, because
        NavRailFlyoutTests scrapes that file for exactly that markup and counts eight. Living in its
        own file keeps that count honest no matter what this control contains.

        The face and the ring are the button's CONTENT, not its template, so they are real fields on
        this class: the live face binding needs an element it can address without a
        FindName-through-the-template dance every time the rail rebuilds.

        Both TextBlocks ride the rail's own fade for free: CacheNavRailParts walks the whole
        NavSidebar visual tree and adds every TextBlock it finds to the global label fade, and both
        exist from this control's constructor. See MainWindow.NavRail.cs.
    -->
    <!--
        HEIGHT IS PINNED, and no text in the chip wraps. Nav polish wave 6 (owner, 2026-10-06): the
        word "EMI" sits UNDER her face like every door's label, so the chip is one centred column:
        the 40px ring on top, the 10.5px ExtraBold label beneath, and the muted pill (shown while EMI
        is out) under that. The height is the same 64px whether she is out or not, so the rail's
        pinned foot never grows when she comes out. History: the chip once had a 0px wide text
        column, and a TextBlock with TextWrapping="Wrap" measured at width 0 breaks after EVERY
        character (the muted pill stood ~260px tall and squeezed the doors above it). Every
        TextBlock here stays NoWrap with an ellipsis. EmiDockRailFitTests pins both halves.
    -->
    <Grid Height="64">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Button x:Name="BtnChip"
                Grid.Row="0"
                Width="40" Height="40"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="Transparent" BorderThickness="0" Padding="0"
                Cursor="Hand" Focusable="False">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <ContentPresenter/>
                    </Grid>
                </ControlTemplate>
            </Button.Template>
            <Grid>
                <!--
                    THE KNOCK'S RING. Stroke and glow are named, addressable objects rather than
                    literal attribute values because the knock storyboard animates them, and a brush
                    or an effect that WPF froze on the way in throws the instant an animation touches
                    it. The face is NEVER animated: EmiFace draws a live kaomoji and pulsing it would
                    read as a glitch, not a knock. See EmiDock.xaml.cs.
                -->
                <Ellipse x:Name="Ring"
                         Fill="#0E0E1C"
                         StrokeThickness="2">
                    <Ellipse.Stroke>
                        <SolidColorBrush x:Name="RingStroke" Color="#FF69B4"/>
                    </Ellipse.Stroke>
                    <Ellipse.Effect>
                        <DropShadowEffect x:Name="RingGlow"
                                          Color="#FF69B4"
                                          BlurRadius="0"
                                          ShadowDepth="0"
                                          Opacity="0"/>
                    </Ellipse.Effect>
                </Ellipse>
                <!-- Her live face, inset so the kaomoji never touches the ring. -->
                <emi:EmiFace x:Name="MiniFace" Margin="7,8,7,8"/>
            </Grid>
        </Button>

        <!-- The label, set like a door's (NavSectionLabel in MainWindow.xaml): 10.5px ExtraBold,
             centred under the face, in her pink. -->
        <TextBlock x:Name="TxtName"
                   Grid.Row="1"
                   Text="EMI"
                   Foreground="#FF69B4"
                   FontSize="10.5" FontWeight="ExtraBold"
                   HorizontalAlignment="Center" TextAlignment="Center"
                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                   MaxWidth="86" Margin="0,1,0,0"/>
        <!-- The muted pill. Press Start 2P is bundled as woff2 for the web layers and WPF
             cannot load woff2, so this asks for the installed family and falls through to a
             mono stack. It is 7px chrome either way, one line, centred under the label. -->
        <TextBlock x:Name="TxtMuted"
                   Grid.Row="2"
                   Text="avatar muted while EMI is out"
                   Visibility="Collapsed"
                   Foreground="#9A8FB5"
                   FontFamily="Press Start 2P, Consolas, Global Monospace"
                   FontSize="7"
                   HorizontalAlignment="Center" TextAlignment="Center"
                   TextWrapping="NoWrap"
                   TextTrimming="CharacterEllipsis"
                   MaxWidth="86"
                   Margin="0,1,0,0"/>
    </Grid>
</UserControl>
