<UserControl x:Class="ConditioningControlPanel.Controls.EmiDock"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:emi="clr-namespace:ConditioningControlPanel.Services.EmiDesk"
             Margin="0,2,0,4">

    <!--
        THE DOCK CHIP. EMI's way in and out when she is not already out, pinned under the nav rail's
        doors.

        Deliberately NOT a door medallion: no NavDoorMap row, no "you are here" ring, and above all
        no `Viewbox Grid.Column="0" Width="40" Height="40"` inside MainWindow.xaml, because
        NavRailFlyoutTests scrapes that file for exactly that markup and counts eight. Living in its
        own file keeps that count honest no matter what this control contains.

        The face and the ring are the button's CONTENT, not its template, so they are real fields on
        this class: the live face binding needs an element it can address without a
        FindName-through-the-template dance every time the rail rebuilds.

        Both TextBlocks ride the rail's own fade for free: CacheNavRailParts walks the whole
        NavSidebar visual tree and adds every TextBlock it finds to the global label fade, and both
        exist from this control's constructor. See MainWindow.NavRail.cs.
    -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="56"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Button x:Name="BtnChip"
                Grid.Column="0"
                Width="40" Height="40"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="Transparent" BorderThickness="0" Padding="0"
                Cursor="Hand" Focusable="False">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <ContentPresenter/>
                    </Grid>
                </ControlTemplate>
            </Button.Template>
            <Grid>
                <!--
                    THE KNOCK'S RING. Stroke and glow are named, addressable objects rather than
                    literal attribute values because the knock storyboard animates them, and a brush
                    or an effect that WPF froze on the way in throws the instant an animation touches
                    it. The face is NEVER animated: EmiFace draws a live kaomoji and pulsing it would
                    read as a glitch, not a knock. See EmiDock.xaml.cs.
                -->
                <Ellipse x:Name="Ring"
                         Fill="#0E0E1C"
                         StrokeThickness="2">
                    <Ellipse.Stroke>
                        <SolidColorBrush x:Name="RingStroke" Color="#FF69B4"/>
                    </Ellipse.Stroke>
                    <Ellipse.Effect>
                        <DropShadowEffect x:Name="RingGlow"
                                          Color="#FF69B4"
                                          BlurRadius="0"
                                          ShadowDepth="0"
                                          Opacity="0"/>
                    </Ellipse.Effect>
                </Ellipse>
                <!-- Her live face, inset so the kaomoji never touches the ring. -->
                <emi:EmiFace x:Name="MiniFace" Margin="7,8,7,8"/>
            </Grid>
        </Button>

        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
            <TextBlock x:Name="TxtName"
                       Text="EMI"
                       Foreground="#FF69B4"
                       FontSize="11" FontWeight="SemiBold"/>
            <!-- The muted pill. Press Start 2P is bundled as woff2 for the web layers and WPF
                 cannot load woff2, so this asks for the installed family and falls through to a
                 mono stack. It is 7px chrome either way. -->
            <TextBlock x:Name="TxtMuted"
                       Text="avatar muted while EMI is out"
                       Visibility="Collapsed"
                       Foreground="#9A8FB5"
                       FontFamily="Press Start 2P, Consolas, Global Monospace"
                       FontSize="7"
                       TextWrapping="Wrap"
                       Margin="0,3,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>
