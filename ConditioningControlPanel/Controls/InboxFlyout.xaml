<UserControl x:Class="ConditioningControlPanel.Controls.InboxFlyout"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        THE INBOX. Everything that used to interrupt, waiting to be asked for.

        Deliberately a list and not a stack of cards. A row is one glyph, one line, one line of
        context and two verbs; the surface itself is still the popup it always was, and opening a
        row runs exactly that. Nothing here explains a feature - the card behind the row does.

        Dark theme, every Foreground stated: the app's default ComboBox/Popup text is white, and
        white on this panel is the unreadable combination that keeps being rediscovered.
    -->

    <Border Background="#FF1B1B2B" BorderBrush="#FF3D3D60" BorderThickness="1"
            Width="340" MaxHeight="420">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="#FF232338" Padding="14,10">
                <TextBlock x:Name="TxtInboxTitle" Text="Inbox"
                           Foreground="#FFE8E8F5" FontSize="13" FontWeight="SemiBold"/>
            </Border>

            <!-- Empty state -->
            <TextBlock x:Name="TxtInboxEmpty" Grid.Row="1"
                       Text="Nothing waiting."
                       Foreground="#FF8A8AA8" FontSize="12"
                       Margin="14,18,14,18"
                       HorizontalAlignment="Left" VerticalAlignment="Top"
                       Visibility="Collapsed"/>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="ItemsInbox">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#FF2C2C44" BorderThickness="0,0,0,1" Padding="12,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding Glyph}"
                                               Foreground="#FFE8E8F5" FontSize="16"
                                               Margin="0,0,10,0" VerticalAlignment="Top"/>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Title}" Foreground="#FFE8E8F5"
                                                   FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Summary}" Foreground="#FF9A9ABA"
                                                   FontSize="11.5" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        <Button Content="{Binding OpenLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Tag="{Binding}" Click="InboxOpen_Click"
                                                HorizontalAlignment="Left" Margin="0,6,0,0"
                                                Cursor="Hand" FontSize="11.5" Foreground="#FFFF9ED8"
                                                Background="Transparent" BorderThickness="0"
                                                Padding="0">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <TextBlock Text="{TemplateBinding Content}"
                                                               Foreground="{TemplateBinding Foreground}"
                                                               FontSize="{TemplateBinding FontSize}"
                                                               TextDecorations="Underline"/>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </StackPanel>

                                    <Button Grid.Column="2" Content="✕"
                                            Tag="{Binding}" Click="InboxDismiss_Click"
                                            ToolTip="{Binding DismissLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            VerticalAlignment="Top" Cursor="Hand"
                                            Width="18" Height="18" Padding="0"
                                            Foreground="#FF7A7A98" Background="Transparent"
                                            BorderThickness="0" FontSize="11">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="Transparent">
                                                    <TextBlock Text="{TemplateBinding Content}"
                                                               Foreground="{TemplateBinding Foreground}"
                                                               FontSize="{TemplateBinding FontSize}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Foreground" Value="#FFE8E8F5"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
