<UserControl x:Class="ConditioningControlPanel.Controls.SparkleWallet"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:emi="clr-namespace:ConditioningControlPanel.Services.EmiDesk"
             Height="29" Width="138" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <!-- Nav polish wave 6 (owner): the pill reads 20% smaller than the 0.75-scaled 48x222 it
         was, and its "?" sits ON the pill. Sized natively (the header no longer scales it), so
         the text renders at its own size instead of being shrunk. The "?" is a sibling laid over
         the outline's right end, never a child of WalletButton: a Button inside a Button would
         bubble its Click into the wallet's own handler and open both popups. -->
    <Grid>
        <Button x:Name="WalletButton" Background="Transparent" BorderThickness="0" Padding="0"
                Cursor="Hand" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Outline" Background="#271A32" BorderBrush="#B982B5" BorderThickness="1"
                            CornerRadius="14" Padding="2,0,23,0">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Outline" Property="BorderBrush" Value="#FFD580"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Outline" Property="BorderBrush" Value="#FFD580"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Outline" Property="Background" Value="#3A2348"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="31"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Viewbox Width="30" Height="28" IsHitTestVisible="False">
                    <!-- The croupier EMI from the Back Room's prize counter (gold casing, visor, bow tie,
                         feather duster), as a pixel sprite split into two layers over a 954x995 canvas:
                         the body and the waving arm. EMI stays planted, only the arm layer turns, about
                         its shoulder (the RenderTransformOrigin). Her glass is blank in the sprite so the
                         EmiFace renderer draws the face, exactly as the desk and the Arcademy do. -->
                    <Grid Width="954" Height="995">
                        <Image Source="pack://application:,,,/Resources/emi/wallet_croupier_body.png"
                               Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <Image x:Name="WaveArm" Source="pack://application:,,,/Resources/emi/wallet_croupier_arm.png"
                               Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"
                               RenderTransformOrigin="0.848,0.676">
                            <Image.RenderTransform><RotateTransform x:Name="ArmTurn"/></Image.RenderTransform>
                        </Image>
                        <!-- The glass rect, measured off the sprite (302,279 425x385) and inset 18px. -->
                        <emi:EmiFace x:Name="MascotFace" HorizontalAlignment="Left" VerticalAlignment="Top"
                                     Margin="320,297,0,0" Width="389" Height="349"/>
                    </Grid>
                </Viewbox>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="2,0,0,0">
                    <TextBlock x:Name="WalletLabel" TextTrimming="CharacterEllipsis" Foreground="#D9BCD9" FontSize="8"
                               LineHeight="9" LineStackingStrategy="BlockLineHeight"/>
                    <StackPanel Orientation="Horizontal" RenderTransformOrigin="0.5,0.5">
                        <StackPanel.RenderTransform><ScaleTransform x:Name="BalancePulse"/></StackPanel.RenderTransform>
                        <Path Data="M0,8 L6,0 12,8 6,16 Z M0,8 L12,8 M6,0 L4,8 6,16 8,8 Z"
                              Width="8" Height="11" Stretch="Fill" Fill="#FFD580" Stroke="#FFF0C5" StrokeThickness="0.6"
                              VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBlock x:Name="BalanceText" Text="0" Foreground="#FFF0CA" FontSize="15" FontWeight="Bold"
                                   LineHeight="17" LineStackingStrategy="BlockLineHeight"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Button>
        <Canvas x:Name="SparkleLayer" IsHitTestVisible="False" ClipToBounds="False"/>
        <Border x:Name="GainBadge" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-8,24,0"
                Background="#34223F" BorderBrush="#FFD580" BorderThickness="1" CornerRadius="8" Padding="5,1"
                Visibility="Collapsed" IsHitTestVisible="False">
            <Border.RenderTransform><TranslateTransform x:Name="GainShift"/></Border.RenderTransform>
            <TextBlock x:Name="GainText" Foreground="#FFE8A9" FontSize="10" FontWeight="Bold"/>
        </Border>
        <Popup x:Name="InvitePopup" PlacementTarget="{Binding ElementName=WalletButton}" Placement="Bottom"
               VerticalOffset="7" AllowsTransparency="True" StaysOpen="False" PopupAnimation="None">
            <Border Width="310" KeyboardNavigation.TabNavigation="Cycle" Background="#24182E" BorderBrush="#C996C3" BorderThickness="1" CornerRadius="14" Padding="17">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="EMI" Foreground="#FF9BCD" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Button x:Name="CloseButton" Content="&#215;" HorizontalAlignment="Right" Width="26" Height="26"
                                Background="Transparent" BorderThickness="0" Foreground="#E9CCE9" FontSize="19" Cursor="Hand"/>
                    </Grid>
                    <TextBlock x:Name="InviteText" TextWrapping="Wrap" Foreground="#F7E5F3" FontSize="14" Margin="0,8,0,15"/>
                    <Button x:Name="VisitButton" Padding="12,8" Background="#E493C3" Foreground="#261329"
                            BorderThickness="0" FontWeight="SemiBold" Cursor="Hand"/>
                </StackPanel>
            </Border>
        </Popup>
        <!-- "What are sparkles for?" The same small help circle the settings sections use
             (HelpButtonStyle), hover for the one-liner, click for the card below. Since nav
             polish wave 6 it rides inside the pill's right end (the outline's right padding
             keeps the balance clear of it), 17 px, in the pill's own lilac. -->
        <Button x:Name="HelpButton" Style="{DynamicResource HelpButtonStyle}" Width="17" Height="17"
                HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0"
                Background="#33201F2E" BorderBrush="#B982B5" Foreground="#F2DDF0"/>
        <Popup x:Name="HelpPopup" PlacementTarget="{Binding ElementName=WalletButton}" Placement="Bottom"
               VerticalOffset="7" AllowsTransparency="True" StaysOpen="False" PopupAnimation="None">
            <Border Width="360" KeyboardNavigation.TabNavigation="Cycle" Background="#24182E" BorderBrush="#C996C3" BorderThickness="1" CornerRadius="14" Padding="17">
                <StackPanel>
                    <TextBlock x:Name="HelpTitle" Foreground="#FF9BCD" FontWeight="Bold" FontSize="15" TextWrapping="Wrap"/>
                    <TextBlock x:Name="HelpIntro" TextWrapping="Wrap" Foreground="#F7E5F3" FontSize="13" Margin="0,8,0,10"/>
                    <TextBlock x:Name="HelpHead1" Foreground="#FFD580" FontWeight="SemiBold" FontSize="13"/>
                    <TextBlock x:Name="HelpBody1" TextWrapping="Wrap" Foreground="#E9D5E6" FontSize="12.5" Margin="0,2,0,9"/>
                    <TextBlock x:Name="HelpHead2" Foreground="#FFD580" FontWeight="SemiBold" FontSize="13"/>
                    <TextBlock x:Name="HelpBody2" TextWrapping="Wrap" Foreground="#E9D5E6" FontSize="12.5" Margin="0,2,0,9"/>
                    <TextBlock x:Name="HelpHead3" Foreground="#FFD580" FontWeight="SemiBold" FontSize="13"/>
                    <TextBlock x:Name="HelpBody3" TextWrapping="Wrap" Foreground="#E9D5E6" FontSize="12.5" Margin="0,2,0,9"/>
                    <TextBlock x:Name="HelpHead4" Foreground="#FFD580" FontWeight="SemiBold" FontSize="13"/>
                    <TextBlock x:Name="HelpBody4" TextWrapping="Wrap" Foreground="#E9D5E6" FontSize="12.5" Margin="0,2,0,12"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="HelpLaterButton" Padding="12,8" Background="Transparent" Foreground="#E9CCE9"
                                BorderBrush="#C996C3" BorderThickness="1" Cursor="Hand" Margin="0,0,8,0"/>
                        <Button x:Name="HelpVisitButton" Padding="12,8" Background="#E493C3" Foreground="#261329"
                                BorderThickness="0" FontWeight="SemiBold" Cursor="Hand"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
