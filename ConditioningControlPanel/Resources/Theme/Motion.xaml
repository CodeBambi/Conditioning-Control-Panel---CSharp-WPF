<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Shared motion library. Two clocks only, per the FX plan: interaction motion is
         80-400ms, ambient motion is 8-60s. Nothing in between (a 2s loop is the uncanny valley).

         Storyboards here are for ControlTemplate/Style triggers, where the target is the
         templated element itself. NEVER give one a Storyboard.TargetName that crosses into a tab
         UserControl - that silently no-ops across the tab namescopes. Code-behind should call
         the Services/MotionFx helpers, which animate via element.BeginAnimation and no-op under
         MotionLevel.Reduced / Off. -->

    <!-- == durations (the two clocks) == -->
    <Duration x:Key="FxPressDuration">0:0:0.08</Duration>
    <Duration x:Key="FxHoverDuration">0:0:0.15</Duration>
    <Duration x:Key="FxTransitionDuration">0:0:0.20</Duration>
    <Duration x:Key="FxSheenDuration">0:0:1.5</Duration>
    <Duration x:Key="FxBreathDuration">0:0:3.4</Duration>

    <sys:Double x:Key="FxHoverLiftScale">1.02</sys:Double>
    <sys:Double x:Key="FxPressSquishScale">0.97</sys:Double>

    <QuadraticEase x:Key="FxEaseOut" EasingMode="EaseOut"/>
    <QuadraticEase x:Key="FxEaseInOut" EasingMode="EaseInOut"/>
    <SineEase x:Key="FxBreathEase" EasingMode="EaseInOut"/>

    <!-- == interaction: hover lift (scale 1.02, 150ms) == -->
    <!-- Requires the target to carry a ScaleTransform as its RenderTransform. -->
    <Storyboard x:Key="FxHoverLiftIn">
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                         To="1.02" Duration="0:0:0.15" EasingFunction="{StaticResource FxEaseOut}"/>
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                         To="1.02" Duration="0:0:0.15" EasingFunction="{StaticResource FxEaseOut}"/>
    </Storyboard>

    <Storyboard x:Key="FxHoverLiftOut">
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                         To="1.0" Duration="0:0:0.15" EasingFunction="{StaticResource FxEaseOut}"/>
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                         To="1.0" Duration="0:0:0.15" EasingFunction="{StaticResource FxEaseOut}"/>
    </Storyboard>

    <!-- == interaction: press squish (scale 0.97, 80ms) == -->
    <Storyboard x:Key="FxPressSquishDown">
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                         To="0.97" Duration="0:0:0.08" EasingFunction="{StaticResource FxEaseOut}"/>
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                         To="0.97" Duration="0:0:0.08" EasingFunction="{StaticResource FxEaseOut}"/>
    </Storyboard>

    <Storyboard x:Key="FxPressSquishUp">
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                         To="1.0" Duration="0:0:0.08" EasingFunction="{StaticResource FxEaseOut}"/>
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                         To="1.0" Duration="0:0:0.08" EasingFunction="{StaticResource FxEaseOut}"/>
    </Storyboard>

    <!-- == ambient: glow pulse (0.6 to 1.0, 3.4s) ==
         Frame rate capped at 24: an 8-60s ambient loop has nothing to gain from 60fps. -->
    <Storyboard x:Key="FxGlowPulse" RepeatBehavior="Forever" AutoReverse="True">
        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.6" To="1.0"
                         Duration="0:0:3.4" Timeline.DesiredFrameRate="24"
                         EasingFunction="{StaticResource FxBreathEase}"/>
    </Storyboard>

    <!-- == ambient: sheen sweep ==
         The band. Put one inside a clipped host and slide it with FxSheenSweep; the long flat
         tail IS the pause, so there is one clock and nothing to schedule. -->
    <Style x:Key="FxSheenBand" TargetType="Rectangle">
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Width" Value="120"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Opacity" Value="0.35"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <TransformGroup>
                    <SkewTransform AngleX="-18"/>
                    <TranslateTransform/>
                </TransformGroup>
            </Setter.Value>
        </Setter>
        <Setter Property="Fill">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="Transparent" Offset="0"/>
                    <GradientStop Color="{DynamicResource FxFlashTintColor}" Offset="0.5"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>

    <Storyboard x:Key="FxSheenSweep" RepeatBehavior="Forever">
        <DoubleAnimationUsingKeyFrames
            Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.X)"
            Duration="0:0:9" Timeline.DesiredFrameRate="30">
            <LinearDoubleKeyFrame Value="-160" KeyTime="0:0:0"/>
            <LinearDoubleKeyFrame Value="900" KeyTime="0:0:1.5"/>
            <DiscreteDoubleKeyFrame Value="-160" KeyTime="0:0:1.55"/>
            <LinearDoubleKeyFrame Value="-160" KeyTime="0:0:9"/>
        </DoubleAnimationUsingKeyFrames>
    </Storyboard>

</ResourceDictionary>
