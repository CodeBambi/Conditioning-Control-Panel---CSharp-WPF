<Window x:Class="ConditioningControlPanel.CompanionTutorialWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Companion Guide"
        Width="600" Height="700"
        WindowStartupLocation="CenterOwner"
        Background="#1A1A2E"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Window.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF69B4"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="SubTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9370DB"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,10,0,5"/>
        </Style>
        <Style x:Key="BodyText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="TipBox" TargetType="Border">
            <Setter Property="Background" Value="#252542"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,5,0,10"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#16162B" Padding="20,15">
            <StackPanel>
                <TextBlock Text="Companion Guide" Foreground="White" FontSize="22" FontWeight="Bold"/>
                <TextBlock Text="Everything you need to know about your AI companion"
                           Foreground="#808080" FontSize="12" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20">
            <StackPanel>

                <!-- Section 1: Companions -->
                <TextBlock Style="{StaticResource SectionTitle}" Text="Companions"/>
                <TextBlock Style="{StaticResource BodyText}">
                    Companions are AI personalities that accompany you during sessions. Each companion has unique traits and XP bonuses. You can unlock new companions as you level up.
                </TextBlock>

                <TextBlock Style="{StaticResource SubTitle}" Text="Available Companions"/>
                <Border Style="{StaticResource TipBox}">
                    <StackPanel>
                        <TextBlock Foreground="#FF69B4" FontWeight="SemiBold">Synthetic Blowdoll (Level 50)</TextBlock>
                        <TextBlock Style="{StaticResource BodyText}" Margin="0,3,0,8">Gains bonus XP based on pink filter intensity. Higher filter = more XP.</TextBlock>

                        <TextBlock Foreground="#9370DB" FontWeight="SemiBold">Perfect Fuckpuppet (Level 100)</TextBlock>
                        <TextBlock Style="{StaticResource BodyText}" Margin="0,3,0,8">Earns bonus XP from autonomy actions. Let the AI take control for extra rewards.</TextBlock>

                        <TextBlock Foreground="#50C878" FontWeight="SemiBold">Brainwashed Slavedoll (Level 125)</TextBlock>
                        <TextBlock Style="{StaticResource BodyText}" Margin="0,3,0,8">Has constant XP drain - you must stay active to maintain progress!</TextBlock>

                        <TextBlock Foreground="#FF6B6B" FontWeight="SemiBold">Platinum Puppet (Level 150)</TextBlock>
                        <TextBlock Style="{StaticResource BodyText}" Margin="0,3,0,0">Earns bonus XP in strict mode. Higher risk, higher reward.</TextBlock>
                    </StackPanel>
                </Border>

                <TextBlock Style="{StaticResource BodyText}">
                    Click on a companion card to select it as your active companion. Each companion levels up independently as you use them.
                </TextBlock>

                <!-- Section 2: AI Personalities -->
                <TextBlock Style="{StaticResource SectionTitle}" Text="AI Personalities" Margin="0,15,0,10"/>
                <TextBlock Style="{StaticResource BodyText}">
                    Community Prompts let you customize how your companion talks and behaves. You can browse prompts created by the community, import your own, or create custom personalities.
                </TextBlock>

                <TextBlock Style="{StaticResource SubTitle}" Text="How to Use"/>
                <Border Style="{StaticResource TipBox}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource BodyText}">
                            <Run Foreground="#9370DB" FontWeight="SemiBold">Browse:</Run>
                            <Run>Opens the community prompt gallery where you can download and install prompts.</Run>
                        </TextBlock>
                        <TextBlock Style="{StaticResource BodyText}">
                            <Run Foreground="#9370DB" FontWeight="SemiBold">Import:</Run>
                            <Run>Load a .json prompt file from your computer.</Run>
                        </TextBlock>
                        <TextBlock Style="{StaticResource BodyText}">
                            <Run Foreground="#9370DB" FontWeight="SemiBold">Export:</Run>
                            <Run>Save your custom prompt to share with others.</Run>
                        </TextBlock>
                        <TextBlock Style="{StaticResource BodyText}" Margin="0">
                            <Run Foreground="#9370DB" FontWeight="SemiBold">Customize AI:</Run>
                            <Run>Open the prompt editor to create or modify personalities.</Run>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <TextBlock Style="{StaticResource BodyText}">
                    You can assign different personalities to each companion using the mask button on their card.
                </TextBlock>

                <!-- Section 3: Settings -->
                <TextBlock Style="{StaticResource SectionTitle}" Text="Settings" Margin="0,15,0,10"/>

                <Border Style="{StaticResource TipBox}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource BodyText}">
                            <Run Foreground="#FF69B4" FontWeight="SemiBold">Show Companion:</Run>
                            <Run>Toggle the companion avatar visibility on/off.</Run>
                        </TextBlock>
                        <TextBlock Style="{StaticResource BodyText}">
                            <Run Foreground="#FF69B4" FontWeight="SemiBold">Window Mode:</Run>
                            <Run>Detach the companion to its own window, or anchor it to the main app.</Run>
                        </TextBlock>
                        <TextBlock Style="{StaticResource BodyText}" Margin="0">
                            <Run Foreground="#FF69B4" FontWeight="SemiBold">Idle Giggle Interval:</Run>
                            <Run>How often your companion speaks random phrases when you're not interacting.</Run>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Section 4: Quick Controls -->
                <TextBlock Style="{StaticResource SectionTitle}" Text="Quick Controls" Margin="0,15,0,10"/>

                <Border Style="{StaticResource TipBox}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource BodyText}">
                            <Run Foreground="#FF69B4" FontWeight="SemiBold">Mute Avatar:</Run>
                            <Run>Hides speech bubbles and companion sounds.</Run>
                        </TextBlock>
                        <TextBlock Style="{StaticResource BodyText}">
                            <Run Foreground="#FF69B4" FontWeight="SemiBold">Mute Whispers:</Run>
                            <Run>Disables subliminal audio whispers.</Run>
                        </TextBlock>
                        <TextBlock Style="{StaticResource BodyText}" Margin="0">
                            <Run Foreground="#FF69B4" FontWeight="SemiBold">Pause Browser:</Run>
                            <Run>Pauses the embedded browser (useful if it's playing audio).</Run>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Section 5: Trigger Mode -->
                <TextBlock Style="{StaticResource SectionTitle}" Text="Trigger Mode" Margin="0,15,0,10"/>
                <TextBlock Style="{StaticResource BodyText}">
                    When enabled, your companion will periodically speak conditioning phrases with audio. You can customize the interval and edit the phrases to your liking.
                </TextBlock>
                <Border Style="{StaticResource TipBox}">
                    <TextBlock Style="{StaticResource BodyText}" Margin="0">
                        Click "Edit Phrases" to customize what your companion says during trigger mode.
                    </TextBlock>
                </Border>

                <!-- Section 6: Avatar Interactions -->
                <TextBlock Style="{StaticResource SectionTitle}" Text="Avatar Interactions" Margin="0,15,0,10"/>
                <TextBlock Style="{StaticResource BodyText}">
                    Your companion avatar responds to different mouse actions:
                </TextBlock>
                <Border Style="{StaticResource TipBox}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource BodyText}">
                            <Run Foreground="#50C878" FontWeight="SemiBold">Click:</Run>
                            <Run>Shows companion progress and level info.</Run>
                        </TextBlock>
                        <TextBlock Style="{StaticResource BodyText}">
                            <Run Foreground="#50C878" FontWeight="SemiBold">Right-Click:</Run>
                            <Run>Opens the context menu with quick actions.</Run>
                        </TextBlock>
                        <TextBlock Style="{StaticResource BodyText}" Margin="0">
                            <Run Foreground="#50C878" FontWeight="SemiBold">Double-Click:</Run>
                            <Run>Opens the AI chat window for direct conversation (requires Patreon).</Run>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Premium Note -->
                <Border Background="#2A2A4A" CornerRadius="8" Padding="15" Margin="0,10,0,0"
                        BorderBrush="#9370DB" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Foreground="#9370DB" FontWeight="Bold" FontSize="13">Patreon Features</TextBlock>
                        <TextBlock Style="{StaticResource BodyText}" Margin="0,5,0,0">
                            AI chat and community prompt browsing require a Patreon subscription.
                            Support the project to unlock these features and help fund development!
                        </TextBlock>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Background="#16162B" Padding="20,15">
            <Button Content="Got it!"
                    HorizontalAlignment="Center"
                    Background="#FF69B4" Foreground="White"
                    BorderThickness="0" Padding="40,10"
                    FontSize="14" FontWeight="SemiBold"
                    Cursor="Hand"
                    Click="BtnClose_Click"/>
        </Border>
    </Grid>
</Window>
