<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ConditioningControlPanel.Avalonia.ViewModels.Tabs"
             xmlns:features="clr-namespace:ConditioningControlPanel.Avalonia.Features;assembly=CCP.Avalonia"
             xmlns:loc="clr-namespace:ConditioningControlPanel.Core.Localization;assembly=CCP.Core"
             x:Class="ConditioningControlPanel.Avalonia.Views.Tabs.EnhancementsTabView"
             x:DataType="vm:EnhancementsTabViewModel">

  <Design.DataContext>
    <vm:EnhancementsTabViewModel />
  </Design.DataContext>

  <Grid>
    <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="16">

      <!-- Slim header strip: title + stat pills, actions at right -->
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
        <StackPanel Grid.Column="0" Spacing="4">
          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <TextBlock Text="{Binding HeaderTitle}"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextLightBrush}"
                       VerticalAlignment="Center" />
            <Border Background="{DynamicResource ElevatedSurfaceBrush}"
                    BorderBrush="{DynamicResource GlassBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="8,3"
                    VerticalAlignment="Center">
              <TextBlock Text="{Binding SparklePointsText}"
                         Foreground="{DynamicResource TextLightBrush}"
                         FontSize="11"
                         FontWeight="SemiBold" />
            </Border>
            <Border Background="{DynamicResource ElevatedSurfaceBrush}"
                    BorderBrush="{DynamicResource GlassBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="8,3"
                    VerticalAlignment="Center">
              <TextBlock Text="{Binding XpMultiplierText, StringFormat='{}{0} XP'}"
                         Foreground="{DynamicResource PinkBrush}"
                         FontSize="11"
                         FontWeight="SemiBold" />
            </Border>
            <Border Background="{DynamicResource ElevatedSurfaceBrush}"
                    BorderBrush="{DynamicResource GlassBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="8,3"
                    VerticalAlignment="Center">
              <TextBlock Text="{Binding ConditioningTimeText}"
                         Foreground="{DynamicResource TextLightBrush}"
                         FontSize="11"
                         FontWeight="SemiBold" />
            </Border>
            <Border Background="{DynamicResource TransparentPinkBrush}"
                    BorderBrush="{DynamicResource PinkBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="8,3"
                    VerticalAlignment="Center"
                    IsVisible="{Binding PinkRushActive}">
              <TextBlock Text="{Binding [label_xp_rush], Source={x:Static loc:LocalizationManager.Instance}}"
                         Foreground="{DynamicResource TextLightBrush}"
                         FontSize="11"
                         FontWeight="Bold" />
            </Border>
          </StackPanel>
          <TextBlock Text="{Binding HeaderSubtitle}"
                     FontSize="11"
                     Opacity="0.65"
                     Foreground="{DynamicResource TextLightBrush}"
                     TextWrapping="Wrap" />
          <TextBlock Text="{Binding HeaderWarning}"
                     FontSize="11"
                     Opacity="0.85"
                     Foreground="{DynamicResource PinkBrush}"
                     TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
          <Button Content="{Binding [label_refresh], Source={x:Static loc:LocalizationManager.Instance}}"
                  Command="{Binding RefreshCommand}"
                  FontSize="11"
                  Padding="10,4" />
          <ToggleButton Content="{Binding StatsToggleText}"
                        IsChecked="{Binding StatsExpanded, Mode=TwoWay}"
                        FontSize="11"
                        Padding="10,4" />
        </StackPanel>
      </Grid>

      <!-- Active Bonuses: slim label + compact chips -->
      <StackPanel Grid.Row="1" Spacing="6" Margin="0,0,0,12">
        <TextBlock Text="{Binding [label_active_bonuses], Source={x:Static loc:LocalizationManager.Instance}}"
                   FontSize="12"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextMutedBrush}" />
        <ItemsControl ItemsSource="{Binding ActiveBonuses}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="vm:ActiveBonusViewModel">
              <Border Background="{DynamicResource ElevatedSurfaceBrush}"
                      BorderBrush="{DynamicResource GlassBorderBrush}"
                      BorderThickness="1"
                      CornerRadius="8"
                      Padding="8,3"
                      Margin="0,0,6,6">
                <TextBlock Text="{Binding DisplayText}"
                           Foreground="{DynamicResource TextLightBrush}"
                           FontSize="11" />
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- Ditzy Data Stats: collapsed behind the stats toggle -->
      <StackPanel Grid.Row="2" Spacing="6" Margin="0,0,0,12"
                  IsVisible="{Binding StatsExpanded}">
        <TextBlock Text="{Binding [label_ditzy_data_stats], Source={x:Static loc:LocalizationManager.Instance}}"
                   FontSize="12"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextMutedBrush}" />
        <ItemsControl ItemsSource="{Binding DitzyStats}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="vm:StatRowViewModel">
              <Border Background="{DynamicResource ElevatedSurfaceBrush}"
                      CornerRadius="8"
                      Padding="8,4"
                      Margin="0,0,6,6"
                      MinWidth="110">
                <StackPanel Spacing="2">
                  <TextBlock Text="{Binding Label}"
                             FontSize="10"
                             Opacity="0.65"
                             Foreground="{DynamicResource TextLightBrush}"
                             TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Value}"
                             Foreground="{DynamicResource PinkBrush}"
                             FontSize="12"
                             FontWeight="SemiBold" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- Skill Tree: the hero surface, takes all remaining vertical room -->
      <Border Grid.Row="3"
              Background="{DynamicResource SurfaceBgBrush}"
              BorderBrush="{DynamicResource GlassBorderBrush}"
              BorderThickness="1"
              CornerRadius="12"
              Padding="5">
        <ScrollViewer x:Name="SkillTreeScroller"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled">
          <!-- Scales the whole tree by window height (code-behind sets ScaleTransform) so cards and
               their images grow/shrink with the window, while width still scrolls horizontally like
               the WPF head. Content design box is 3200x640 (3 rows at y=0/220/440, 12+ columns). -->
          <LayoutTransformControl x:Name="SkillTreeScaler"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center">
          <Canvas Width="3200" Height="640" HorizontalAlignment="Left">
            <!-- Connection lines behind nodes -->
            <ItemsControl ItemsSource="{Binding Connections}"
                          Width="3200"
                          Height="640">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <Canvas />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:SkillConnectionViewModel">
                  <Line StartPoint="{Binding StartPoint}"
                        EndPoint="{Binding EndPoint}"
                        Stroke="{Binding Stroke}"
                        StrokeThickness="2"
                        StrokeDashArray="4,2" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Skill nodes -->
            <ItemsControl ItemsSource="{Binding Skills}"
                          Width="3200"
                          Height="640">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <Canvas />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <!-- Position each node's CONTAINER (ContentPresenter) on the Canvas. Canvas.Left/Top on
                   the DataTemplate root is a no-op in an Avalonia ItemsControl: each item is wrapped in
                   a ContentPresenter that is the actual Canvas child, so without this the nodes all
                   stack at 0,0 while the absolute-positioned connection Lines render to where the nodes
                   should be ("stacked with random lines"). Official v12 "Custom ItemsPanel" idiom;
                   scoped selector so it targets only the item containers, not the ContentPresenters
                   inside the card's Buttons. -->
              <ItemsControl.Styles>
                <Style Selector="ItemsControl > ContentPresenter" x:DataType="vm:SkillNodeViewModel">
                  <Setter Property="Canvas.Left" Value="{Binding PositionX}" />
                  <Setter Property="Canvas.Top" Value="{Binding PositionY}" />
                </Style>
              </ItemsControl.Styles>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:SkillNodeViewModel">
                  <features:SkillNodeCard Title="{Binding Name}"
                                          IconUri="{Binding IconUri}"
                                          IsUnlocked="{Binding IsUnlocked}"
                                          CanPurchase="{Binding CanPurchase}"
                                          IsLocked="{Binding IsLocked}"
                                          StatusText="{Binding StatusText}"
                                          Cost="{Binding Cost}"
                                          PrerequisiteName="{Binding PrerequisiteName}"
                                          PurchaseCommand="{Binding $parent[ItemsControl].((vm:EnhancementsTabViewModel)DataContext).PurchaseSkillCommand}"
                                          DetailsCommand="{Binding $parent[ItemsControl].((vm:EnhancementsTabViewModel)DataContext).OpenSkillDetailsCommand}"
                                          CommandParameter="{Binding}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Canvas>
          </LayoutTransformControl>
        </ScrollViewer>
      </Border>
    </Grid>

    <!-- Login Required Overlay -->
    <Border Background="{DynamicResource PanelBgTransparentBrush}"
            CornerRadius="12"
            IsVisible="{Binding IsLoginOverlayVisible}"
            Padding="24"
            Margin="16">
      <StackPanel HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  MaxWidth="350"
                  Spacing="10">
        <TextBlock Text="🔒"
                   FontSize="40"
                   HorizontalAlignment="Center" />
        <TextBlock Text="{Binding [label_login_required], Source={x:Static loc:LocalizationManager.Instance}}"
                   Foreground="{DynamicResource PinkBrush}"
                   FontSize="22"
                   FontWeight="Bold"
                   HorizontalAlignment="Center" />
        <TextBlock Text="{Binding [label_log_in_with_discord_or_patreon_to_access_enha], Source={x:Static loc:LocalizationManager.Instance}}"
                   Foreground="{DynamicResource TextMutedBrush}"
                   FontSize="14"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   TextWrapping="Wrap" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
