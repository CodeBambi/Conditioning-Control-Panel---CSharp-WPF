<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ConditioningControlPanel.Avalonia.ViewModels.Tabs"
             xmlns:features="clr-namespace:ConditioningControlPanel.Avalonia.Features;assembly=CCP.Avalonia"
             xmlns:controls="clr-namespace:ConditioningControlPanel.Avalonia.Controls;assembly=CCP.Avalonia"
             xmlns:loc="clr-namespace:ConditioningControlPanel.Avalonia.Localization;assembly=CCP.Avalonia"
             x:Class="ConditioningControlPanel.Avalonia.Views.Tabs.SettingsTabView"
             x:DataType="vm:SettingsTabViewModel">

  <Design.DataContext>
    <vm:SettingsTabViewModel />
  </Design.DataContext>

  <Grid>
    <!-- Responsive dashboard (user-requested 2026-07-10): fills the bounded tab area with NO
         scroll. The left 4x4 feature-card block scales uniformly via a Viewbox so cards/pics/
         labels/emblem shrink or grow with the window; the browser panel flexes via layout
         (native-safe resize, no render-transform on the WebView2 host). -->
    <Grid IsVisible="{Binding !IsHelpOverlayVisible}"
          Margin="16"
          RowDefinitions="*,Auto,Auto">

        <!-- Velvet mosaic dashboard: PREMIUM QUICK-TOGGLE RAIL on the far left, then 4x4 feature
             cards, then browser/audio/quick-links on the right. Port of the WPF SettingsTabView
             col-0 rail (v6.2.1 "Dashboard Quick Actions"). Takeover/Awareness toggle their service
             in place; the rest jump to their dedicated tab. Whole rail is locked behind the
             PremiumRailLock overlay when the user is not a logged-in patron. -->
        <Grid Grid.Row="0" ColumnDefinitions="84,*">

        <!-- PREMIUM QUICK-TOGGLE RAIL -->
        <Border Grid.Column="0" Margin="5,5,0,5"
                Background="{DynamicResource ElevatedSurfaceBrush}"
                BorderBrush="{DynamicResource GlassBorderBrush}"
                BorderThickness="1" CornerRadius="12">
          <Grid>
            <StackPanel x:Name="PremiumRailContent" Margin="4,6,4,6" Spacing="5">
              <TextBlock Text="PREMIUM" FontSize="9" FontWeight="Bold"
                         Foreground="{DynamicResource SecondaryBrush}"
                         HorizontalAlignment="Center" Margin="0,0,0,4" />

              <!-- Takeover: toggle AutonomyService (Start/Stop) -->
              <Button Theme="{StaticResource PremiumChipButton}" Click="ChipTakeover_Click"
                      ToolTip.Tip="Takeover — the companion triggers effects on her own">
                <StackPanel HorizontalAlignment="Center">
                  <Grid Width="24" Height="24" HorizontalAlignment="Center">
                    <TextBlock Text="🎭" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Ellipse x:Name="DotTakeover" Width="8" Height="8"
                             HorizontalAlignment="Right" VerticalAlignment="Bottom"
                             Fill="#555555" Stroke="#1A1A2E" StrokeThickness="1" />
                  </Grid>
                  <TextBlock Text="Takeover" FontSize="9" Foreground="White"
                             TextAlignment="Center" TextWrapping="Wrap" Margin="0,2,0,0" />
                </StackPanel>
              </Button>

              <!-- Awareness: toggle AwarenessService (Start/Stop) -->
              <Button Theme="{StaticResource PremiumChipButton}" Click="ChipAwareness_Click"
                      ToolTip.Tip="Awareness — reacts to what's on your screen">
                <StackPanel HorizontalAlignment="Center">
                  <Grid Width="24" Height="24" HorizontalAlignment="Center">
                    <TextBlock Text="👁" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Ellipse x:Name="DotAwareness" Width="8" Height="8"
                             HorizontalAlignment="Right" VerticalAlignment="Bottom"
                             Fill="#555555" Stroke="#1A1A2E" StrokeThickness="1" />
                  </Grid>
                  <TextBlock Text="Awareness" FontSize="9" Foreground="White"
                             TextAlignment="Center" TextWrapping="Wrap" Margin="0,2,0,0" />
                </StackPanel>
              </Button>

              <!-- Haptics: launcher to the Haptics tab (connect/consent flow lives there) -->
              <Button Theme="{StaticResource PremiumChipButton}" Click="ChipHaptics_Click"
                      ToolTip.Tip="Haptics — connect a toy">
                <StackPanel HorizontalAlignment="Center">
                  <Grid Width="24" Height="24" HorizontalAlignment="Center">
                    <TextBlock Text="💜" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Ellipse x:Name="DotHaptics" Width="8" Height="8"
                             HorizontalAlignment="Right" VerticalAlignment="Bottom"
                             Fill="#555555" Stroke="#1A1A2E" StrokeThickness="1" />
                  </Grid>
                  <TextBlock Text="Haptics" FontSize="9" Foreground="White"
                             TextAlignment="Center" TextWrapping="Wrap" Margin="0,2,0,0" />
                </StackPanel>
              </Button>

              <!-- Voice (She's Listening): launcher to the She's Listening tab (mic consent lives there) -->
              <Button Theme="{StaticResource PremiumChipButton}" Click="ChipVoice_Click"
                      ToolTip.Tip="She's Listening — turn on voice control (“Hey Bambi”) and the mic">
                <StackPanel HorizontalAlignment="Center">
                  <Grid Width="24" Height="24" HorizontalAlignment="Center">
                    <TextBlock Text="🎤" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Ellipse x:Name="DotVoice" Width="8" Height="8"
                             HorizontalAlignment="Right" VerticalAlignment="Bottom"
                             Fill="#555555" Stroke="#1A1A2E" StrokeThickness="1" />
                  </Grid>
                  <TextBlock Text="Voice" FontSize="9" Foreground="White"
                             TextAlignment="Center" TextWrapping="Wrap" Margin="0,2,0,0" />
                </StackPanel>
              </Button>

              <!-- Lockdown: launcher to the Lockdown tab (double-warning activate flow lives there) -->
              <Button Theme="{StaticResource PremiumChipButton}" Click="ChipLockdown_Click"
                      ToolTip.Tip="Lockdown — locks you in for the set time (panic key disabled)">
                <StackPanel HorizontalAlignment="Center">
                  <Grid Width="24" Height="24" HorizontalAlignment="Center">
                    <TextBlock Text="🔒" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Ellipse x:Name="DotLockdown" Width="8" Height="8"
                             HorizontalAlignment="Right" VerticalAlignment="Bottom"
                             Fill="#555555" Stroke="#1A1A2E" StrokeThickness="1" />
                  </Grid>
                  <TextBlock Text="Lockdown" FontSize="9" Foreground="White"
                             TextAlignment="Center" TextWrapping="Wrap" Margin="0,2,0,0" />
                </StackPanel>
              </Button>

              <!-- Blink Trainer: launcher to the Blink Trainer tab (webcam consent + start flow lives there) -->
              <Button Theme="{StaticResource PremiumChipButton}" Click="ChipBlink_Click"
                      ToolTip.Tip="Blink Trainer — webcam blink-gated visuals">
                <StackPanel HorizontalAlignment="Center">
                  <Grid Width="24" Height="24" HorizontalAlignment="Center">
                    <TextBlock Text="💫" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Ellipse x:Name="DotBlink" Width="8" Height="8"
                             HorizontalAlignment="Right" VerticalAlignment="Bottom"
                             Fill="#555555" Stroke="#1A1A2E" StrokeThickness="1" />
                  </Grid>
                  <TextBlock Text="Blink" FontSize="9" Foreground="White"
                             TextAlignment="Center" TextWrapping="Wrap" Margin="0,2,0,0" />
                </StackPanel>
              </Button>

              <!-- Remote: launcher to the Remote Control tab (login + waiver + start flow lives there) -->
              <Button Theme="{StaticResource PremiumChipButton}" Click="ChipRemote_Click"
                      ToolTip.Tip="Remote Control — let someone drive your session">
                <StackPanel HorizontalAlignment="Center">
                  <Grid Width="24" Height="24" HorizontalAlignment="Center">
                    <TextBlock Text="🎮" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Ellipse x:Name="DotRemote" Width="8" Height="8"
                             HorizontalAlignment="Right" VerticalAlignment="Bottom"
                             Fill="#555555" Stroke="#1A1A2E" StrokeThickness="1" />
                  </Grid>
                  <TextBlock Text="Remote" FontSize="9" Foreground="White"
                             TextAlignment="Center" TextWrapping="Wrap" Margin="0,2,0,0" />
                </StackPanel>
              </Button>
            </StackPanel>

            <!-- Patron lock overlay: shown when the user is not premium. Doubles as an ad for the
                 gated features; greys the chips through and (via IsEnabled on PremiumRailContent)
                 makes them non-clickable. -->
            <Border x:Name="PremiumRailLock" IsVisible="True"
                    Background="#CC0E0E1A" CornerRadius="12"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    IsHitTestVisible="False">
              <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="4">
                <TextBlock Text="🔒" FontSize="22" HorizontalAlignment="Center" />
                <TextBlock Text="Premium" FontSize="9" FontWeight="Bold" Foreground="#C9A0D0"
                           HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
              </StackPanel>
            </Border>
          </Grid>
        </Border>

        <!-- Velvet mosaic dashboard: 4x4 feature cards, then browser/audio/quick-links on the right.
             Column split is proportional (approved screenshot: left grid ~47% of the row) so the
             Viewbox-scaled feature block has no dead gutter. -->
        <Grid Grid.Column="1" ColumnDefinitions="47*,53*">

        <!-- Feature card grid, wrapped in a Viewbox so the whole 4x4 block + centre emblem scales
             uniformly to the available space (cards/pics get smaller or bigger with the window).
             The child carries an explicit 640x600 design size so Uniform stretch has a fixed
             aspect ratio; it centres in its cell. StretchDirection defaults to Both (up + down). -->
        <Viewbox Grid.Column="0" Stretch="Uniform" Margin="5"
                 HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid Width="640" Height="600"
              ColumnDefinitions="*,*,*,*"
              RowDefinitions="*,*,*,*">

          <!-- Row 1 -->
          <features:FeatureCard Grid.Row="0" Grid.Column="0"
                                Title="{loc:Str feature_title_flash_images}"
                                IconUri="pack://application:,,,/Resources/features/flash.png"
                                HelpSectionId="FlashImages"
                                IsActive="{Binding FlashEnabled}"
                                Click="CardFlash_Click" />
          <features:FeatureCard Grid.Row="0" Grid.Column="1"
                                Title="{loc:Str feature_title_visuals}"
                                Glyph="◎"
                                HelpSectionId="Visuals"
                                Click="CardVisuals_Click" />
          <features:FeatureCard Grid.Row="0" Grid.Column="2"
                                Title="{loc:Str feature_title_mandatory_video}"
                                IconUri="pack://application:,,,/Resources/features/mandatory_videos.png"
                                HelpSectionId="Video"
                                IsActive="{Binding VideoEnabled}"
                                CanTest="True"
                                Click="CardVideo_Click" />
          <features:FeatureCard Grid.Row="0" Grid.Column="3"
                                Title="{loc:Str feature_title_subliminals}"
                                IconUri="pack://application:,,,/Resources/features/subliminal.png"
                                HelpSectionId="Subliminals"
                                IsActive="{Binding SubliminalEnabled}"
                                Click="CardSubliminal_Click" />

          <!-- Row 2 -->
          <features:FeatureCard Grid.Row="1" Grid.Column="0"
                                Title="{loc:Str feature_title_spiral_overlay}"
                                IconUri="pack://application:,,,/Resources/features/spiral_overlay.png"
                                HelpSectionId="SpiralOverlay"
                                IsActive="{Binding SpiralEnabled}"
                                Click="CardSpiral_Click" />

          <!-- Center logo (2x2) -->
          <Border Grid.Row="1" Grid.RowSpan="2" Grid.Column="1" Grid.ColumnSpan="2"
                  Background="#01000000" Margin="6"
                  Cursor="Hand"
                  PointerPressed="ImgLogo_PointerPressed"
                  ToolTip.Tip="{loc:Str tooltip_click_me_rapidly}">
            <Border CornerRadius="12" ClipToBounds="True">
              <Image x:Name="ImgLogo"
                     Stretch="Uniform"
                     HorizontalAlignment="Stretch"
                     VerticalAlignment="Center"
                     RenderOptions.BitmapInterpolationMode="HighQuality" />
            </Border>
          </Border>

          <features:FeatureCard Grid.Row="1" Grid.Column="3"
                                Title="{loc:Str feature_title_lock_card}"
                                IconUri="pack://application:,,,/Resources/features/Phrase_Lock.png"
                                HelpSectionId="LockCard"
                                IsActive="{Binding LockCardEnabled}"
                                Click="CardLockCard_Click" />

          <!-- Row 3 -->
          <features:FeatureCard Grid.Row="2" Grid.Column="0"
                                Title="{loc:Str feature_title_pink_filter}"
                                IconUri="pack://application:,,,/Resources/features/Pink_filter.png"
                                HelpSectionId="PinkFilter"
                                IsActive="{Binding PinkFilterEnabled}"
                                Click="CardPinkFilter_Click" />
          <features:FeatureCard Grid.Row="2" Grid.Column="3"
                                Title="{loc:Str feature_title_mind_wipe}"
                                IconUri="pack://application:,,,/Resources/features/Mind_Wipers.png"
                                HelpSectionId="MindWipe"
                                IsActive="{Binding MindWipeEnabled}"
                                Click="CardMindWipe_Click" />

          <!-- Row 4 -->
          <features:FeatureCard Grid.Row="3" Grid.Column="0"
                                Title="{loc:Str feature_title_bubble_pop}"
                                IconUri="pack://application:,,,/Resources/features/Bubble_pop.png"
                                HelpSectionId="BubblePop"
                                IsActive="{Binding BubblesEnabled}"
                                Click="CardBubblePop_Click" />
          <features:FeatureCard Grid.Row="3" Grid.Column="1"
                                Title="{loc:Str feature_title_bouncing_text}"
                                IconUri="pack://application:,,,/Resources/features/bouncing_text.png"
                                HelpSectionId="BouncingText"
                                IsActive="{Binding BouncingTextEnabled}"
                                Click="CardBouncingText_Click" />
          <features:FeatureCard Grid.Row="3" Grid.Column="2"
                                Title="{loc:Str feature_title_system}"
                                Glyph="⚙"
                                HelpSectionId="System"
                                Click="CardSystem_Click" />
          <features:FeatureCard Grid.Row="3" Grid.Column="3"
                                Title="{loc:Str feature_title_bubble_count}"
                                IconUri="pack://application:,,,/Resources/features/Bubble_count.png"
                                HelpSectionId="BubbleCount"
                                IsActive="{Binding BubbleCountEnabled}"
                                Click="CardBubbleCount_Click" />
        </Grid>
        </Viewbox>

        <!-- Right half: browser (Row 0 = '*', flexes and takes the most space) + audio/quick-links
             (Row 1 = Auto, compact). Because the browser is the only star row, extra window height
             goes proportionally to it. The Media-folder picker moved to the System (gear) settings
             popup, which already hosts it (SystemFeatureControl 'Assets folder') — 2026-07-10. -->
        <Grid Grid.Column="1" Margin="5" RowDefinitions="*,Auto">

          <!-- Browser -->
          <Border Grid.Row="0" CornerRadius="12" Padding="9" Margin="0,0,0,5"
                  Background="{DynamicResource ElevatedSurfaceBrush}"
                  BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1">
            <Grid RowDefinitions="Auto,*">
              <Grid Grid.Row="0" Margin="0,0,0,4" ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock Text="{loc:Str label_browser}"
                             Foreground="{DynamicResource TextLightBrush}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" />
                  <Button Content="{loc:Str label_help_symbol}"
                          Command="{Binding ShowHelpSectionCommand}" CommandParameter="Browser"
                          Background="{DynamicResource TransparentPinkBrush}"
                          Foreground="{DynamicResource TextLightBrush}" BorderBrush="{DynamicResource PinkBrush}" BorderThickness="1"
                          CornerRadius="11" Padding="0" Width="22" Height="22" Margin="8,0,0,0"
                          HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                          FontSize="11" FontWeight="Bold"
                          ToolTip.Tip="{loc:Str btn_help}" />
                </StackPanel>

                <!-- Site toggle -->
                <Border Grid.Column="1" Background="{DynamicResource PanelAccentBrush}" CornerRadius="10" Padding="2" Margin="10,0,0,0" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal">
                    <RadioButton Content="{loc:Str btn_bambicloud}"
                                 GroupName="BrowserSite"
                                 IsChecked="{Binding IsBambiCloudSelected, Mode=TwoWay}"
                                 Command="{Binding OpenBrowserCommand}"
                                 CommandParameter="bambicloud"
                                 Foreground="{DynamicResource TextLightBrush}" FontSize="10" Padding="8,3" />
                    <RadioButton Content="{loc:Str btn_hypnotube}"
                                 GroupName="BrowserSite"
                                 IsChecked="{Binding !IsBambiCloudSelected, Mode=TwoWay}"
                                 Command="{Binding OpenBrowserCommand}"
                                 CommandParameter="hypnotube"
                                 Foreground="{DynamicResource TextLightBrush}" FontSize="10" Padding="8,3" />
                  </StackPanel>
                </Border>

                <Button Grid.Column="2" Content="{loc:Str btn_reload}" Padding="6,3" Margin="8,0,0,0"
                        Command="{Binding OpenBrowserCommand}"
                        CommandParameter="{Binding IsBambiCloudSelected, Converter={StaticResource BoolToBrowserSiteConverter}}"
                        ToolTip.Tip="{loc:Str tooltip_browser_reload}" />

                <!-- WPF parity: pink while idle/loading, green once connected, red on error/crash. -->
                <TextBlock Grid.Column="3" Text="{Binding BrowserStatusText}"
                           Foreground="{Binding BrowserStatusBrush}" FontSize="10"
                           VerticalAlignment="Center" Margin="0,0,8,0" />

                <!-- Deeper auto-bind badge -->
                <Border Grid.Column="3"
                        IsVisible="{Binding DeeperBrowserBadgeVisible}"
                        Background="{DynamicResource DeeperAccentTransparent20Brush}"
                        BorderBrush="{DynamicResource DeeperAccentBrush}" BorderThickness="1"
                        CornerRadius="3" Padding="6,1" Margin="0,0,8,0"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        ToolTip.Tip="{Binding DeeperBrowserBadgeToolTip}">
                  <TextBlock Text="{Binding DeeperBrowserBadgeText}"
                             Foreground="{DynamicResource DeeperAccentBrush}"
                             FontSize="9" FontWeight="SemiBold" />
                </Border>

                <Button Grid.Column="4" Content="{loc:Str btn_browser_webcam_tracking_off}"
                        Click="BrowserWebcamTracking_Click"
                        Padding="6,3" Margin="0,0,6,0" VerticalAlignment="Center"
                        ToolTip.Tip="{loc:Str tooltip_browser_webcam_tracking_off}" />

                <!-- B5: mute the embedded browser's audio (persists to AppSettings.BrowserVideoMuted) -->
                <Button Grid.Column="5" Content="{Binding BrowserMuteGlyph}" Padding="6,3" Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        Command="{Binding ToggleBrowserMuteCommand}"
                        ToolTip.Tip="Mute / unmute browser audio" />

                <Button Grid.Column="6" Content="{loc:Str btn_pop_out_plain}" Padding="6,3"
                        Command="{Binding PopOutBrowserCommand}"
                        ToolTip.Tip="{loc:Str tooltip_pop_out_browser_to_resizable_window}" />
              </Grid>

              <!-- Browser container: Grid.Row=1, no fixed height so it flexes to fill the panel
                   (lets the dashboard fit without scrolling; the native browser resizes safely
                   via layout rather than a render-transform). -->
              <Border Grid.Row="1" Background="{DynamicResource SurfaceBgBrush}" CornerRadius="6" ClipToBounds="True">
                <Grid RowDefinitions="Auto,Auto,*">
                  <Border Grid.Row="0" Background="{DynamicResource PanelBgBrush}" Padding="8,4">
                    <Grid ColumnDefinitions="Auto,*">
                      <CheckBox Grid.Column="0" Content="{loc:Str browser_enhance_label}"
                                IsChecked="{Binding BrowserEnhanceIfPossible, Mode=TwoWay}"
                                Foreground="{DynamicResource TextLightBrush}" FontSize="11" VerticalAlignment="Center"
                                ToolTip.Tip="{loc:Str browser_enhance_tooltip}" />
                      <TextBlock Grid.Column="1" Text="{Binding EnhanceMatchStatusText}"
                                 Foreground="{DynamicResource TextMutedBrush}" FontSize="10"
                                 VerticalAlignment="Center" Margin="12,0,0,0" />
                    </Grid>
                  </Border>

                  <!-- Haptic Audio Sync latency/intensity panel -->
                  <Border Grid.Row="1" Background="{DynamicResource PanelBgBrush}" Padding="6,3"
                          IsVisible="{Binding AudioSyncLatencyPanelVisible}">
                    <Grid ColumnDefinitions="*,8,*">
                      <Grid Grid.Column="0" ColumnDefinitions="Auto,*,Auto">
                        <TextBlock Text="{loc:Str label_delay}" Foreground="{DynamicResource TextDimBrush}" FontSize="9" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <Slider Grid.Column="1" Minimum="-600" Maximum="600"
                                Value="{Binding LegacyAudioSyncLatency, Mode=TwoWay}"
                                VerticalAlignment="Center"
                                ToolTip.Tip="{loc:Str tooltip_adjust_haptic_timing_positive_earlier_negativ}" />
                        <TextBlock Grid.Column="2" Text="{Binding LegacyAudioSyncLatencyText}"
                                   Foreground="{DynamicResource PinkBrush}" FontSize="9"
                                   VerticalAlignment="Center" HorizontalAlignment="Right" />
                      </Grid>
                      <Grid Grid.Column="2" ColumnDefinitions="Auto,*,Auto">
                        <TextBlock Text="{loc:Str label_power}" Foreground="{DynamicResource TextDimBrush}" FontSize="9" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <Slider Grid.Column="1" Minimum="0" Maximum="100"
                                Value="{Binding LegacyAudioSyncIntensity, Mode=TwoWay}"
                                VerticalAlignment="Center"
                                ToolTip.Tip="{loc:Str tooltip_live_intensity_control_reduce_if_vibration_is}" />
                        <TextBlock Grid.Column="2" Text="{Binding LegacyAudioSyncIntensityText}"
                                   Foreground="{DynamicResource PinkBrush}" FontSize="9"
                                   VerticalAlignment="Center" HorizontalAlignment="Right" />
                      </Grid>
                    </Grid>
                  </Border>

                  <!-- WPF parity (SettingsTabView.xaml:1164-1169): Grid container + click-to-load
                       placeholder. The WebView2 native host is added lazily by the navigation path
                       (create -> parent -> navigate); the placeholder stays until init succeeds and
                       comes back on process-crash / error (text + visibility are VM-driven). -->
                  <Grid Grid.Row="2" x:Name="BrowserContainer">
                    <TextBlock x:Name="BrowserLoadingText"
                               Text="{Binding BrowserLoadingText}"
                               IsVisible="{Binding BrowserLoadingVisible}"
                               Foreground="{DynamicResource TextMutedBrush}" FontSize="12"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextWrapping="Wrap" TextAlignment="Center" MaxWidth="520"
                               Cursor="Hand"
                               PointerPressed="BrowserLoadingText_PointerPressed" />
                  </Grid>
                </Grid>
              </Border>
            </Grid>
          </Border>

          <!-- Audio + Quick Links -->
          <Grid Grid.Row="1" ColumnDefinitions="*,5,*">
            <!-- Audio (compacted 2026-07-10: single header row carries title + duck toggle +
                 advanced chevron + help, Master slider sits right under it; advanced options stay
                 collapsed behind BtnAudioAdvanced per v6.2.9 #9) -->
            <Border Grid.Column="0" CornerRadius="12" Padding="10,6" Margin="0,5,0,6"
                    Background="{DynamicResource ElevatedSurfaceBrush}"
                    BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1">
              <StackPanel Spacing="2">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto">
                  <TextBlock Grid.Column="0" Text="{loc:Str label_audio}"
                             Foreground="{DynamicResource TextLightBrush}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" Text="{loc:Str label_duck}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" VerticalAlignment="Center" Margin="0,0,2,0" />
                  <ToggleSwitch Grid.Column="3" IsChecked="{Binding AudioDuckEnabled, Mode=TwoWay}"
                                OnContent="" OffContent="" VerticalAlignment="Center" />
                  <!-- v6.2.9 #9: collapse/expand the advanced audio options (WPF SettingsTabView.xaml:1193-1247). Master volume + duck-enable stay always visible. -->
                  <ToggleButton Grid.Column="4" x:Name="BtnAudioAdvanced" Background="Transparent" BorderThickness="0" Padding="4,1"
                                Cursor="Hand" VerticalAlignment="Center" Margin="2,0,6,0"
                                ToolTip.Tip="Show advanced audio options (video &amp; duck volume, output device, ducking)">
                    <Panel>
                      <TextBlock Text="▾" FontSize="13" Foreground="{DynamicResource PinkBrush}"
                                 IsVisible="{Binding !#BtnAudioAdvanced.IsChecked}" />
                      <TextBlock Text="▴" FontSize="13" Foreground="{DynamicResource PinkBrush}"
                                 IsVisible="{Binding #BtnAudioAdvanced.IsChecked}" />
                    </Panel>
                  </ToggleButton>
                  <Button Grid.Column="5" Content="{loc:Str label_help_symbol}"
                          Command="{Binding ShowHelpSectionCommand}" CommandParameter="Audio"
                          Background="{DynamicResource TransparentPinkBrush}"
                          Foreground="{DynamicResource TextLightBrush}" BorderBrush="{DynamicResource PinkBrush}" BorderThickness="1"
                          CornerRadius="10" Padding="0" Width="20" Height="20"
                          HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                          FontSize="10" FontWeight="Bold" VerticalAlignment="Center"
                          ToolTip.Tip="{loc:Str btn_help}" />
                </Grid>

                <controls:SliderHeader Label="{loc:Str setting_master}" ValueText="{Binding MasterVolumeText}" />
                <Slider Value="{Binding MasterVolume, Mode=TwoWay}" Minimum="0" Maximum="100" />

                <!-- Advanced audio options, collapsed by default; toggled by BtnAudioAdvanced (v6.2.9 #9) -->
                <StackPanel IsVisible="{Binding #BtnAudioAdvanced.IsChecked}" Spacing="2">
                  <controls:SliderHeader Label="{loc:Str setting_video}" ValueText="{Binding VideoVolumeText}" />
                  <Slider Value="{Binding VideoVolume, Mode=TwoWay}" Minimum="0" Maximum="100" />

                  <controls:SliderHeader Label="{loc:Str label_duck}" ValueText="{Binding DuckVolumeText}" />
                  <Slider Value="{Binding DuckVolume, Mode=TwoWay}" Minimum="0" Maximum="100" />

                  <!-- Audio output device picker -->
                  <Grid Margin="0,2,0,0" ColumnDefinitions="Auto,*,Auto">
                    <TextBlock Text="{loc:Str setting_output}"
                               Foreground="{DynamicResource TextMutedBrush}" FontSize="10"
                               VerticalAlignment="Center" Margin="0,0,4,0"
                               ToolTip.Tip="{loc:Str tooltip_audio_output_device}" />
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding AudioOutputDevices}"
                              SelectedItem="{Binding SelectedAudioOutputDevice, Mode=TwoWay}"
                              DisplayMemberBinding="{Binding Name}"
                              Margin="4,0,4,0"
                              ToolTip.Tip="{loc:Str tooltip_audio_output_device}" />
                    <Button Grid.Column="2" Content="↻"
                            Command="{Binding RefreshAudioOutputDevicesCommand}"
                            ToolTip.Tip="Re-scan playback devices."
                            Padding="8,2" Background="{DynamicResource TransparentPinkBrush}" Foreground="{DynamicResource TextLightBrush}" FontSize="10"
                            BorderBrush="{DynamicResource PinkBrush}" BorderThickness="1" />
                  </Grid>

                  <!-- Don't-duck-browser toggle + Audio Test -->
                  <Grid Margin="0,2,0,0" ColumnDefinitions="*,Auto">
                    <CheckBox Content="{loc:Str setting_don_t_duck_browser}"
                              IsChecked="{Binding ExcludeBrowserDucking, Mode=TwoWay}"
                              Foreground="{DynamicResource PinkBrush}" FontSize="9" />
                    <Button Grid.Column="1" Content="Test Audio"
                            Command="{Binding TestAudioCommand}"
                            ToolTip.Tip="Play a test sound and show audio diagnostics. Use this if audio isn't working."
                            Background="{DynamicResource TransparentPinkBrush}" Foreground="{DynamicResource TextLightBrush}" FontSize="9" Padding="8,3"
                            BorderBrush="{DynamicResource PinkBrush}" BorderThickness="1"
                            VerticalAlignment="Center" />
                  </Grid>
                </StackPanel><!-- end advanced audio options (v6.2.9 #9) -->
              </StackPanel>
            </Border>

            <!-- Quick Links (compacted 2026-07-10: tighter paddings, Join-Discord and the Rich
                 Presence toggle share one row so the card matches the slimmed Audio card height) -->
            <Border Grid.Column="2" CornerRadius="12" Padding="10,6" Margin="0,5,0,6"
                    Background="{DynamicResource ElevatedSurfaceBrush}"
                    BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1">
              <StackPanel Spacing="5">
                <Grid>
                  <TextBlock Text="{loc:Str label_quick_links}"
                             Foreground="{DynamicResource TextLightBrush}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" />
                  <Button Content="{loc:Str label_help_symbol}"
                          Command="{Binding ShowHelpSectionCommand}" CommandParameter="QuickLinks"
                          HorizontalAlignment="Right" VerticalAlignment="Center"
                          Background="{DynamicResource TransparentPinkBrush}"
                          Foreground="{DynamicResource TextLightBrush}" BorderBrush="{DynamicResource PinkBrush}" BorderThickness="1"
                          CornerRadius="10" Padding="0" Width="20" Height="20"
                          HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                          FontSize="10" FontWeight="Bold"
                          ToolTip.Tip="{loc:Str btn_help}" />
                </Grid>

                <Button Content="{loc:Str btn_login}"
                        Command="{Binding UnifiedLoginCommand}"
                        IsVisible="{Binding IsNotLoggedIn}"
                        Padding="8,6" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        ToolTip.Tip="{loc:Str tooltip_login_with_discord_or_patreon}" />

                <Border IsVisible="{Binding IsLoggedIn}"
                        Background="{DynamicResource PanelBgBrush}" CornerRadius="6" Padding="8,4">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="{loc:Str label_logged_in_as}"
                                 Foreground="{DynamicResource TextMutedBrush}" FontSize="9" />
                      <TextBlock Text="{Binding LoggedInDisplayName}"
                                 Foreground="{DynamicResource TextLightBrush}" FontWeight="Bold" FontSize="11"
                                 TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <!-- v6.2.9 #10: prominent, high-contrast Logout button (WPF SettingsTabView.xaml:1406) -->
                    <Button Grid.Column="1" Content="{loc:Str btn_logout}"
                            Command="{Binding LogoutCommand}"
                            Padding="12,4" Background="{DynamicResource PinkBrush}" Foreground="White"
                            BorderThickness="0" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                  </Grid>
                </Border>

                <!-- Join Discord + Rich Presence toggle share one compact row -->
                <Grid ColumnDefinitions="*,Auto">
                  <Button Content="{loc:Str label_join_discord}"
                          Command="{Binding OpenDiscordCommand}"
                          Padding="8,6"
                          Background="{DynamicResource DiscordBlueBrush}"
                          Foreground="{DynamicResource TextLightBrush}"
                          FontWeight="Bold" FontSize="11"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                          VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                    <ToggleSwitch IsChecked="{Binding DiscordRichPresenceEnabled, Mode=TwoWay}"
                                  OnContent="" OffContent="" />
                    <TextBlock Text="{loc:Str label_rp}" Foreground="{DynamicResource TextMutedBrush}" FontSize="9" VerticalAlignment="Center" Margin="2,0,0,0" />
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>
          </Grid>

          <!-- Media-folder picker relocated to the System (gear) settings popup 2026-07-10
               (SystemFeatureControl 'Assets folder' pick/open). The dashboard no longer duplicates
               it, giving the browser panel more room. -->
        </Grid>
        </Grid>
        </Grid>

      <!-- Helper button row: consistent themed OutlineButtons (rounded, pink outline, centered
           icon + label with proper spacing) instead of the bare default buttons that looked
           unstyled and cramped the emoji against the text. 2026-07-10. -->
      <Grid Grid.Row="1" Margin="5,12,5,0" ColumnDefinitions="*,10,*,10,*,10,*">
        <Button Grid.Column="0" Theme="{StaticResource OutlineButton}" Click="VelvetBtnWebcam_Click">
          <TextBlock TextTrimming="CharacterEllipsis"><Run Text="📷 " /><Run Text="{loc:Str btn_webcam}" /></TextBlock>
        </Button>
        <Button Grid.Column="2" Theme="{StaticResource OutlineButton}" Click="VelvetBtnAppInfo_Click">
          <TextBlock TextTrimming="CharacterEllipsis"><Run Text="ℹ️ " /><Run Text="{loc:Str btn_app_info}" /></TextBlock>
        </Button>
        <Button Grid.Column="4" Theme="{StaticResource OutlineButton}" Click="VelvetBtnSchedulerRamp_Click">
          <TextBlock TextTrimming="CharacterEllipsis"><Run Text="📅 " /><Run Text="{loc:Str btn_scheduler_intensity_ramp}" /></TextBlock>
        </Button>
        <Button Grid.Column="6" Theme="{StaticResource OutlineButton}" Click="VelvetBtnCatalogue_Click">
          <TextBlock TextTrimming="CharacterEllipsis"><Run Text="📁 " /><Run Text="{loc:Str btn_ccp_catalogue}" /></TextBlock>
        </Button>
      </Grid>

      <!-- Marquee banner -->
      <Border Grid.Row="2" Background="#1A0A1A" BorderBrush="{DynamicResource DarkPinkBrush}" BorderThickness="2"
              CornerRadius="8" Height="48" Margin="5,5,5,0" ClipToBounds="True"
              BoxShadow="0 0 15 0 #80FF1493">
        <Canvas x:Name="MarqueeCanvas">
          <StackPanel x:Name="MarqueeContent" Orientation="Horizontal" Canvas.Top="8">
            <TextBlock x:Name="MarqueeText1"
                       Text="{loc:Str label_marquee_v5_2_1}"
                       FontFamily="Impact" FontSize="28" FontWeight="Bold"
                       Foreground="{DynamicResource PinkBrush}" />
            <TextBlock x:Name="MarqueeText2"
                       Text="{loc:Str label_marquee_v5_2_1}"
                       FontFamily="Impact" FontSize="28" FontWeight="Bold"
                       Foreground="{DynamicResource PinkBrush}"
                       Margin="40,0,0,0" />
          </StackPanel>
        </Canvas>
      </Border>
    </Grid>

    <Border Background="{DynamicResource PanelBgBrush}"
            CornerRadius="10"
            Padding="24"
            IsVisible="{Binding IsHelpOverlayVisible}">
      <Grid RowDefinitions="Auto,*">
        <TextBlock Grid.Row="0"
                   Text="{Binding HelpOverlayTitle}"
                   FontSize="20"
                   FontWeight="Bold"
                   Foreground="{DynamicResource TextLightBrush}"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,12" />
        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="12" HorizontalAlignment="Stretch" MaxWidth="720">
            <TextBlock Text="{Binding HelpOverlayWhatItDoes}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextLightBrush}" />

            <StackPanel IsVisible="{Binding HelpOverlayHasTips}" Spacing="6">
              <TextBlock Text="Tips" FontWeight="Bold" Foreground="{DynamicResource PinkBrush}" />
              <ItemsControl ItemsSource="{Binding HelpOverlayTips}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="•" Foreground="{DynamicResource PinkBrush}" VerticalAlignment="Top" />
                      <TextBlock Text="{Binding}" Foreground="{DynamicResource TextLightBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <StackPanel IsVisible="{Binding HelpOverlayHasHowItWorks}" Spacing="6">
              <TextBlock Text="How it works" FontWeight="Bold" Foreground="{DynamicResource PinkBrush}" />
              <TextBlock Text="{Binding HelpOverlayHowItWorks}"
                         TextWrapping="Wrap"
                         Foreground="{DynamicResource TextLightBrush}" />
            </StackPanel>

            <Button Content="{loc:Str btn_close}"
                    Command="{Binding HideHelpOverlayCommand}"
                    HorizontalAlignment="Center"
                    Margin="0,12,0,0" />
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Border>
  </Grid>

</UserControl>
