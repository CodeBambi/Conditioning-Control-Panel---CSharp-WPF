<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ConditioningControlPanel.Avalonia.ViewModels.Tabs"
             x:Class="ConditioningControlPanel.Avalonia.Views.Tabs.CompanionTabView"
             x:DataType="vm:CompanionTabViewModel"
             xmlns:loc="clr-namespace:ConditioningControlPanel.Avalonia.Localization;assembly=CCP.Avalonia">

  <Design.DataContext>
    <vm:CompanionTabViewModel />
  </Design.DataContext>

  <ScrollViewer>
    <StackPanel Spacing="16" Margin="24">

      <!-- Banner -->
      <Border Height="140"
              CornerRadius="12"
              ClipToBounds="True">
        <Border.Background>
          <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Offset="0" Color="#2A0E2E" />
            <GradientStop Offset="1" Color="#7B3FA0" />
          </LinearGradientBrush>
        </Border.Background>
        <Grid>
          <Border Opacity="0.12"
                  Background="{DynamicResource TextLightBrush}"
                  Width="280"
                  Height="280"
                  CornerRadius="140"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Bottom"
                  Margin="0,0,-60,-100" />
          <StackPanel VerticalAlignment="Center" Margin="24,0">
            <Border BoxShadow="0 0 20 0 #9370DB80">
              <TextBlock Text="{loc:Str tab_companion_banner_title}"
                         FontSize="28"
                         FontWeight="Bold"
                         Foreground="{DynamicResource TextLightBrush}" />
            </Border>
            <TextBlock Text="{loc:Str tab_companion_banner_subtitle}"
                       FontSize="14"
                       Foreground="{DynamicResource TextMutedBrush}"
                       TextWrapping="Wrap"
                       MaxWidth="520"
                       HorizontalAlignment="Left" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- Active companion -->
      <Border Background="{DynamicResource SurfaceBgBrush}"
              BorderBrush="{DynamicResource PinkBrush}"
              BorderThickness="2"
              CornerRadius="12"
              Padding="18"
              BoxShadow="0 0 18 0 #2EFF69B4">
        <Grid ColumnDefinitions="Auto,*">
          <TextBlock Text="🤖"
                     FontSize="48"
                     VerticalAlignment="Center"
                     Margin="0,0,16,0" />
          <StackPanel Grid.Column="1" Spacing="6">
            <TextBlock Text="{Binding ActiveCompanionName}"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextLightBrush}" />
            <TextBlock Text="{Binding ActiveCompanionLevelText}"
                       Foreground="{DynamicResource PinkBrush}"
                       FontSize="14"
                       FontWeight="SemiBold" />
            <TextBlock Text="{Binding ActiveCompanionDescription}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextMutedBrush}" />
            <Border BoxShadow="0 0 24 0 #F2FF69B4">
              <TextBlock Text="{Binding ActiveCompanionXpText}"
                         Foreground="{DynamicResource PinkBrush}"
                         FontSize="14"
                         FontWeight="SemiBold" />
            </Border>
            <ProgressBar Value="{Binding ActiveCompanionProgress}"
                         Maximum="100"
                         Minimum="0"
                         Height="10" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- Settings -->
      <Border Background="{DynamicResource SurfaceBgBrush}"
              BorderBrush="{DynamicResource TransparentPinkBrush}"
              BorderThickness="1"
              CornerRadius="12"
              Padding="18">
        <StackPanel Spacing="12">
          <TextBlock Text="{loc:Str tab_companion_settings_text}"
                     FontSize="16"
                     FontWeight="Bold"
                     Foreground="{DynamicResource TextLightBrush}" />
          <ToggleButton Content="{loc:Str tab_companion_avatar_enabled_content}"
                        IsChecked="{Binding AvatarEnabled, Mode=TwoWay}" />
          <ToggleButton Content="{loc:Str tab_companion_trigger_mode_content}"
                        IsChecked="{Binding TriggerModeEnabled, Mode=TwoWay}" />
          <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Text="{loc:Str tab_companion_trigger_interval_s_text}"
                       VerticalAlignment="Center" />
            <NumericUpDown Value="{Binding TriggerIntervalSeconds}"
                           Minimum="1"
                           Width="120" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Text="{loc:Str tab_companion_idle_interval_s_text}"
                       VerticalAlignment="Center" />
            <NumericUpDown Value="{Binding IdleIntervalSeconds}"
                           Minimum="1"
                           Width="120" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Text="{loc:Str tab_companion_bubble_duration_s_text}"
                       VerticalAlignment="Center" />
            <NumericUpDown Value="{Binding BubbleDurationSeconds}"
                           Minimum="1"
                           Width="120" />
          </StackPanel>
          <Button Content="{loc:Str tab_companion_toggle_detach_content}"
                  Command="{Binding ToggleDetachCommand}"
                  HorizontalAlignment="Left" />
        </StackPanel>
      </Border>

      <!-- OpenAI-compatible API key (AI-5): masked entry writing ISecretStore secret "openai-api-key".
           Mirrors WPF MainWindow/MainWindow.Patreon.cs:1387-1394 (TxtOpenAiApiKey_PasswordChanged);
           the field is never pre-populated and is cleared immediately after Save/Clear so the secret
           is never retained in the UI or bindings. Themed via DynamicResource keys (5-theme reskin). -->
      <Border Background="{DynamicResource SurfaceBgBrush}"
              BorderBrush="{DynamicResource TransparentPinkBrush}"
              BorderThickness="1"
              CornerRadius="12"
              Padding="18">
        <StackPanel Spacing="12">
          <TextBlock Text="{loc:Str label_custom_ai_config}"
                     FontSize="16"
                     FontWeight="Bold"
                     Foreground="{DynamicResource TextLightBrush}" />
          <TextBlock Text="{loc:Str hint_openai_api_key}"
                     FontSize="12"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource TextMutedBrush}" />
          <StackPanel Spacing="4">
            <TextBlock Text="{loc:Str label_custom_api_key}"
                       FontSize="12"
                       Foreground="{DynamicResource TextLightBrush}" />
            <TextBox x:Name="TxtOpenAiKey"
                     PasswordChar="●"
                     Watermark="{loc:Str hint_openai_api_key_placeholder}"
                     Background="{DynamicResource PanelBgBrush}"
                     Foreground="{DynamicResource TextLightBrush}"
                     BorderBrush="{DynamicResource PinkBrush}"
                     BorderThickness="1"
                     Padding="8,6" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Button Content="{loc:Str btn_save}"
                    Click="SaveOpenAiKey_Click" />
            <Button Content="{loc:Str btn_clear}"
                    Click="ClearOpenAiKey_Click" />
            <!-- Non-secret status only: "key set" (accent) vs "no key set" (muted). The key itself
                 is NEVER shown back. Two TextBlocks toggled by HasOpenAiKey avoids needing a
                 bool->brush converter (DynamicResource cannot feed converter props in v12). -->
            <TextBlock Text="{loc:Str label_openai_key_set}"
                       VerticalAlignment="Center"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource PinkBrush}"
                       IsVisible="{Binding HasOpenAiKey}" />
            <TextBlock Text="{loc:Str label_openai_key_not_set}"
                       VerticalAlignment="Center"
                       FontSize="12"
                       Foreground="{DynamicResource TextMutedBrush}"
                       IsVisible="{Binding !HasOpenAiKey}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- AI-7 Live actions feed: scrolling list of the most recent AI-driven effect actions,
           bound to the singleton IAiLiveActionsFeed via the VM. Newest-last ordering matches WPF
           (App.AiLiveActions, bound in MainWindow.Patreon.cs:1774-1782). Themed via DynamicResource
           keys so it re-skins across all 5 mods (dashboard-design). Mirrors the ObservableCollection<string>
           + ListBox pattern used by the Remote Control command log. Each line describes the ACTION
           only — never the AI prompt (WPF FormatLiveAction parity, AiCommandService.cs:140-180). -->
      <Border Background="{DynamicResource SurfaceBgBrush}"
              BorderBrush="{DynamicResource TransparentPinkBrush}"
              BorderThickness="1"
              CornerRadius="12"
              Padding="18">
        <StackPanel Spacing="12">
          <TextBlock Text="{loc:Str label_live_actions}"
                     FontSize="16"
                     FontWeight="Bold"
                     Foreground="{DynamicResource TextLightBrush}" />
          <ListBox ItemsSource="{Binding LiveActions}"
                   Background="Transparent"
                   MaxHeight="180"
                   IsVisible="{Binding HasLiveActions}" />
          <TextBlock Text="{loc:Str label_live_actions_placeholder}"
                     Foreground="{DynamicResource TextMutedBrush}"
                     FontSize="13"
                     FontStyle="Italic"
                     TextWrapping="Wrap"
                     IsVisible="{Binding !HasLiveActions}" />
        </StackPanel>
      </Border>

      <!-- Active prompt -->
      <Border Background="{DynamicResource SurfaceBgBrush}"
              BorderBrush="{DynamicResource TransparentPinkBrush}"
              BorderThickness="1"
              CornerRadius="12"
              Padding="18">
        <StackPanel Spacing="12">
          <TextBlock Text="{loc:Str tab_companion_active_prompt_text}"
                     FontSize="16"
                     FontWeight="Bold"
                     Foreground="{DynamicResource TextLightBrush}" />
          <TextBlock Text="{Binding ActivePromptName}"
                     Foreground="{DynamicResource PinkBrush}"
                     FontWeight="SemiBold" />
          <TextBlock Text="{Binding CustomizePromptName}"
                     Foreground="{DynamicResource TextMutedBrush}"
                     FontSize="12" />
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Button Content="{loc:Str tab_companion_customize_prompt_content}"
                    Command="{Binding CustomizePromptCommand}" />
            <Button Content="{loc:Str tab_companion_deactivate_prompt_content}"
                    Command="{Binding DeactivatePromptCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Companion roster -->
      <Border Background="{DynamicResource SurfaceBgBrush}"
              BorderBrush="{DynamicResource TransparentPinkBrush}"
              BorderThickness="1"
              CornerRadius="12"
              Padding="18">
        <StackPanel Spacing="12">
          <TextBlock Text="{loc:Str tab_companion_companions_text}"
                     FontSize="16"
                     FontWeight="Bold"
                     Foreground="{DynamicResource TextLightBrush}" />
          <ItemsControl ItemsSource="{Binding Companions}"
                        x:Name="CompanionsList">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:CompanionCardViewModel">
                <Border Background="{DynamicResource PanelBgBrush}"
                        BorderBrush="{Binding ColorHex}"
                        BorderThickness="2"
                        CornerRadius="10"
                        Padding="12"
                        Margin="6"
                        Width="200">
                  <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="{Binding Name}"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource TextLightBrush}"
                                 TextWrapping="Wrap" />
                      <Border Background="{DynamicResource TransparentPinkBrush}"
                              CornerRadius="8"
                              Padding="6,2"
                              IsVisible="{Binding IsActive}">
                        <TextBlock Text="{loc:Str tab_companion_active_text}"
                                   Foreground="{DynamicResource PinkBrush}"
                                   FontSize="10"
                                   FontWeight="SemiBold" />
                      </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding LevelText}"
                               Foreground="{DynamicResource PinkBrush}" />
                    <TextBlock Text="{Binding AssignedPromptName}"
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="11"
                               TextWrapping="Wrap" />
                    <Button Content="{loc:Str tab_companion_switch_content}"
                            Command="{Binding $parent[ItemsControl].((vm:CompanionTabViewModel)DataContext).SwitchCompanionCommand}"
                            CommandParameter="{Binding Index}" />
                    <Button Content="{loc:Str tab_companion_assign_personality_content}"
                            Command="{Binding $parent[ItemsControl].((vm:CompanionTabViewModel)DataContext).AssignPersonalityCommand}"
                            CommandParameter="{Binding Index}" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- Installed prompts -->
      <Border Background="{DynamicResource SurfaceBgBrush}"
              BorderBrush="{DynamicResource TransparentPinkBrush}"
              BorderThickness="1"
              CornerRadius="12"
              Padding="18">
        <StackPanel Spacing="12">
          <TextBlock Text="{loc:Str tab_companion_installed_prompts_text}"
                     FontSize="16"
                     FontWeight="Bold"
                     Foreground="{DynamicResource TextLightBrush}" />
          <ItemsControl ItemsSource="{Binding InstalledPrompts}"
                        x:Name="PromptsList">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:CommunityPromptRowViewModel">
                <Border Background="{DynamicResource PanelBgBrush}"
                        BorderBrush="{DynamicResource DeeperAccentTransparent20Brush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12"
                        Margin="0,0,0,8">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="4">
                      <TextBlock Text="{Binding Name}"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource TextLightBrush}" />
                      <TextBlock Text="{Binding Author}"
                                 Foreground="{DynamicResource TextMutedBrush}" />
                      <Border Background="{DynamicResource TransparentPinkBrush}"
                              CornerRadius="8"
                              Padding="6,2"
                              HorizontalAlignment="Left"
                              IsVisible="{Binding IsActive}">
                        <TextBlock Text="{loc:Str tab_companion_active_text}"
                                   Foreground="{DynamicResource PinkBrush}"
                                   FontSize="11"
                                   FontWeight="SemiBold" />
                      </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                Orientation="Vertical"
                                Spacing="6"
                                Margin="12,0,0,0">
                      <Button Content="{loc:Str tab_companion_activate_content}"
                              Command="{Binding $parent[ItemsControl].((vm:CompanionTabViewModel)DataContext).ActivatePromptCommand}"
                              CommandParameter="{Binding Id}" />
                      <Button Content="{loc:Str tab_companion_remove_content}"
                              Theme="{StaticResource DangerButton}"
                              Command="{Binding $parent[ItemsControl].((vm:CompanionTabViewModel)DataContext).RemovePromptCommand}"
                              CommandParameter="{Binding Id}" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>

</UserControl>
