<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CcpClient.Desktop.Views.MainWindow"
        Width="1100" Height="760"
        Title="CCP Client"
        Background="#FF141018">
  <!--
    The navigation shell. Rail + page host + a diagnostic footer, modelled on the
    v6.8.1 Studio rack the owner pointed at (wpf-surface-reachability.md §8.3 @ 7527243e7) rather than on
    any WPF layout code. The demonstrator card that used to live here is retired: its own text
    said "the first real feature card supersedes it", and the Spiral Overlay module is that
    supersession. The startup-trace and capability proofs moved to the System
    page; they are never deleted.

    FIVE doors, and every one of them has a working destination (§9 D1, §10 D14, §11 D25): Studio
    reaches THE LOOM, Companion reaches the companion window, Play reaches DOWN THE RABBIT HOLE
    behind its Tier-2 gate, Graded Intake reaches the intake host, System reaches the live trace.
    WPF's other doors are absent rather than dead. Play sits after Companion because that is WPF's
    rail order (§8.1) and Graded Intake sits after Play because WPF keeps "gradedintake" inside the
    Play door's entry list (MainWindow.TabNavigation.cs:600-601); System is the port's own door
    (§9 D2) and stays last.

    AutomationProperties.Name on each door is "<route id> door" and that shape is load-bearing:
    the headed capture harness DERIVES the rail's door set from these UIA names and demands a
    layout probe per door (client/tools/verify/capture.ps1:136-151, after a hard-coded list went
    blind to a later door). Adding a door widens the harness by itself; renaming one to anything
    that is not "<id> door" makes it invisible to that check again.
  -->
  <Window.Styles>
    <!-- A-012/cheat sheet §Styling: selectors + pseudo-classes, never WPF triggers. -->

    <!-- Rail door. A RadioButton, so selection state is the control's own :checked
         pseudo-class and keyboard activation is the control's own (WPF's rack row is a
         RadioButton too — Views/Tabs/StudioTabView.xaml.cs:645-651). -->
    <Style Selector="RadioButton.door">
      <Setter Property="Background" Value="#FF1E1822" />
      <Setter Property="BorderBrush" Value="#FF3A2F3E" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="Foreground" Value="#FFE8E0EE" />
      <Setter Property="Padding" Value="12,0,12,0" />
      <Setter Property="Height" Value="44" />
      <!-- Stretch, so every door is the same width: the headed harness captures a door's top
           border band, and ragged widths would make the band's pixel fraction depend on how
           long that door's label happens to be. -->
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="4"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter Content="{TemplateBinding Content}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="RadioButton.door:pointerover">
      <Setter Property="BorderBrush" Value="#FF6B5B73" />
    </Style>
    <!-- The selected door. #FFE066FF is the tier-2/tier-3 harness anchor
         (client/tools/verify/self-test.ps1 seeds its regression by replacing it, and
         checks.json's rail-door-selected-border reads this band back off real pixels). -->
    <Style Selector="RadioButton.door:checked">
      <Setter Property="Background" Value="#FF2A2130" />
      <Setter Property="BorderBrush" Value="#FFE066FF" />
    </Style>

    <!-- Rack row: the same mechanism at module granularity. -->
    <Style Selector="RadioButton.rack-row">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0,0,0,0" />
      <Setter Property="Foreground" Value="#FFE8E0EE" />
      <Setter Property="Padding" Value="10,0,10,0" />
      <Setter Property="Height" Value="36" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="4"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter Content="{TemplateBinding Content}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="RadioButton.rack-row:pointerover">
      <Setter Property="Background" Value="#FF241E2A" />
    </Style>
    <Style Selector="RadioButton.rack-row:checked">
      <Setter Property="Background" Value="#FF2A2130" />
      <Setter Property="BorderBrush" Value="#FFE066FF" />
      <Setter Property="BorderThickness" Value="3,0,0,0" />
    </Style>

    <Style Selector="Border.rail">
      <Setter Property="Background" Value="#FF19141F" />
      <Setter Property="BorderBrush" Value="#FF2A2130" />
      <Setter Property="BorderThickness" Value="0,0,1,0" />
      <Setter Property="Padding" Value="12" />
      <Setter Property="Width" Value="200" />
    </Style>
    <Style Selector="Border.rack">
      <Setter Property="Background" Value="#FF19141F" />
      <Setter Property="BorderBrush" Value="#FF2A2130" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="8" />
    </Style>
    <Style Selector="Border.module">
      <Setter Property="Background" Value="#FF1B1622" />
      <Setter Property="BorderBrush" Value="#FF2A2130" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="16" />
    </Style>
    <Style Selector="Border.notice">
      <Setter Property="Background" Value="#FF241E2A" />
      <Setter Property="BorderBrush" Value="#FF3A2F3E" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="12" />
    </Style>
    <Style Selector="Border.footer">
      <Setter Property="Background" Value="#FF19141F" />
      <Setter Property="BorderBrush" Value="#FF2A2130" />
      <Setter Property="BorderThickness" Value="0,1,0,0" />
      <Setter Property="Padding" Value="12,6" />
    </Style>

    <Style Selector="Button.module-action">
      <Setter Property="Background" Value="#FF2A2130" />
      <Setter Property="Foreground" Value="#FFE8E0EE" />
      <Setter Property="BorderBrush" Value="#FFD05CE8" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="14,10" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>

    <!-- The Play page's DTRH hero card. CornerRadius 16 is WPF's PlayCard radius
         (Views/Tabs/PlayTabView.xaml:252 derives the band's 15 from "the card's 16 minus its
         1px border"), which is why the band below is 15. -->
    <Style Selector="Border.hero">
      <Setter Property="Background" Value="#FF1B1622" />
      <Setter Property="BorderBrush" Value="#FF3A2F3E" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Padding" Value="24" />
    </Style>
    <Style Selector="Border.tier-badge">
      <Setter Property="Background" Value="#FF241E2A" />
      <Setter Property="BorderBrush" Value="#FFB47BFF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="7,2" />
    </Style>
    <Style Selector="TextBlock.tier-badge-text">
      <Setter Property="Foreground" Value="#FFCFE9FF" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="TextBlock.hero-title">
      <Setter Property="Foreground" Value="#FFFFFFFF" />
      <Setter Property="FontSize" Value="25" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="Button.hero-primary">
      <Setter Property="Background" Value="#FFD05CE8" />
      <Setter Property="Foreground" Value="#FFFFFFFF" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Padding" Value="30,14" />
      <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
    <Style Selector="Button.hero-secondary">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#FFD05CE8" />
      <Setter Property="BorderBrush" Value="#FFD05CE8" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="14,6" />
      <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
    <!-- The refusal band's two colours are WPF's own: the ~66% scrim #A8120A1E and the tier-2
         rim #FFB47BFF (Views/Tabs/PlayTabView.xaml:245,248). IsHitTestVisible is set on the
         ELEMENT rather than here — see the comment in PlayPage.axaml. -->
    <Style Selector="Border.lock-band">
      <Setter Property="Background" Value="#A8120A1E" />
      <Setter Property="BorderBrush" Value="#FFB47BFF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="15" />
    </Style>
    <!-- The refusal message's own ground, and it must be OPAQUE (alpha FF). WPF's scrim carries
         a glyph plus one short line and sends the prose to a toast, which has its own surface
         (PlayTabView.xaml:270-273). The port has no toast, so the prose sits here — and on a
         66%-alpha scrim it composites through onto the card's title and blurb and cannot be
         read (headed capture, §10 D23). The plate is the fix; the scrim above keeps WPF's alpha
         so the card still reads around it. PlayPageHeadlessTests pins both alphas. -->
    <Style Selector="Border.lock-plate">
      <Setter Property="Background" Value="#FF1B1424" />
      <Setter Property="BorderBrush" Value="#FFB47BFF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="20,16" />
    </Style>
    <Style Selector="TextBlock.lock-title">
      <Setter Property="Foreground" Value="#FFB47BFF" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="TextBlock.lock-text">
      <Setter Property="Foreground" Value="#FFE8E0EE" />
      <Setter Property="FontSize" Value="12" />
      <!-- Three wrapped sentences need leading, or the descenders of one line sit on the
           ascenders of the next — the second half of what the headed capture caught. -->
      <Setter Property="LineHeight" Value="18" />
    </Style>

    <!-- The Graded Intake pass gate. WPF's intake scrim is #CC0A0A14 at CornerRadius 12
         (Views/Tabs/GradedIntakeTabView.xaml:192) — a different, more opaque scrim than the DTRH
         band's #A8120A1E, and deliberately kept at WPF's own value rather than unified with it.
         The message still gets its OWN OPAQUE PLATE: that is the §10 D23 lesson, found by a headed
         capture on the DTRH band, and it applies to any prose sitting on a translucent scrim. -->
    <Style Selector="Border.intake-gate">
      <Setter Property="Background" Value="#CC0A0A14" />
      <Setter Property="BorderBrush" Value="#FFD05CE8" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
    </Style>

    <!-- The FAILURE livery, and it exists to be told apart from the two refusal liveries
         above at a glance. WPF's failure surface is a modal MessageBox with MessageBoxImage.Warning
         (MainWindow/MainWindow.Lab.cs:164-165, :269-270, :336-337) — a different WINDOW, so WPF
         never has to make a failure look unlike a refusal. The port reuses the plate idiom, which
         means the differentiation has to be carried here.

         Amber, not the tier-2 violet #FFB47BFF or the intake's #FFD05CE8: that is
         MessageBoxImage.Warning's own severity signal, moved from a glyph to the rim and the
         headline. The scrim stays TRANSLUCENT for PlayTabView.xaml:247-248's reason — the card
         underneath still reads, so the user can see the thing that failed to open — and slightly
         more opaque than the DTRH band because the plate on it carries more text.

         A failure band that merely re-tinted the refusal band would still be one visual event; the
         two are also different ELEMENTS on both pages, with different names, so no later edit can
         render one through the other. -->
    <Style Selector="Border.fault-band">
      <Setter Property="Background" Value="#C8140A02" />
      <Setter Property="BorderBrush" Value="#FFF0A02E" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="15" />
    </Style>
    <!-- Opaque, exactly as lock-plate is and for the §10 D23 reason: prose on a translucent scrim
         composites through the card and cannot be read. Its ground is warm rather than violet so
         the plate reads as a different KIND of surface, not a recoloured one. -->
    <Style Selector="Border.fault-plate">
      <Setter Property="Background" Value="#FF241505" />
      <Setter Property="BorderBrush" Value="#FFF0A02E" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="20,16" />
    </Style>
    <Style Selector="TextBlock.fault-title">
      <Setter Property="Foreground" Value="#FFF0A02E" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <!-- Same LineHeight as lock-text, and the same BLANK-LINE PROHIBITION rides with it: a text
         containing an empty line wedges the layout pass on these plates in Avalonia 12.1.1
         (measured this packet, §13 D43 — it wedges the refusal plate identically, so this is a
         property of the plate and not of the fault surface). LaunchFaultText never emits one and
         LaunchFaultTextTests holds that line over a derived set, never a hand-written one. -->
    <Style Selector="TextBlock.fault-text">
      <Setter Property="Foreground" Value="#FFF3E9DC" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="LineHeight" Value="18" />
    </Style>

    <Style Selector="TextBlock.rail-brand">
      <Setter Property="Foreground" Value="#FFE8E0EE" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Margin" Value="4,0,0,10" />
    </Style>
    <Style Selector="TextBlock.page-title">
      <Setter Property="Foreground" Value="#FFE8E0EE" />
      <Setter Property="FontSize" Value="22" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="TextBlock.page-blurb">
      <Setter Property="Foreground" Value="#FFE8E0EE" />
      <Setter Property="Opacity" Value="0.6" />
      <Setter Property="FontSize" Value="12" />
      <!-- The Studio blurb sits in a fixed-width rack column; unwrapped it overruns into the
           module panel (seen in the headed capture, not in any headless frame). -->
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.rack-group">
      <Setter Property="Foreground" Value="#FFE8E0EE" />
      <Setter Property="Opacity" Value="0.5" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="Margin" Value="10,6,0,4" />
    </Style>
    <Style Selector="TextBlock.module-title">
      <Setter Property="Foreground" Value="#FFE8E0EE" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.diagnostic">
      <Setter Property="Foreground" Value="#FFE8E0EE" />
      <Setter Property="Opacity" Value="0.75" />
      <Setter Property="FontSize" Value="10" />
    </Style>

    <!-- ==========================================================================
         The session action bar, the rack row's live dot, and module dials.
         ========================================================================== -->

    <!-- WPF's persistent bottom action bar (§8.6). The port carries ONE control off it, the
         large gradient START, because START is the only verb on that bar with a ported
         meaning: favourite, the start-options chevron, Save and Exit all name subsystems the
         port does not have, and rendering them would be the greyed control that swallows the
         gesture (§9 D7's rule). §9 D10 recorded the whole bar as absent; this narrows it. -->
    <Style Selector="Border.actionbar">
      <Setter Property="Background" Value="#FF19141F" />
      <Setter Property="BorderBrush" Value="#FF2A2130" />
      <Setter Property="BorderThickness" Value="0,1,0,0" />
      <Setter Property="Padding" Value="20,12" />
    </Style>

    <!-- Idle: WPF's PinkBrush, the shell's existing #FFD05CE8 (MainWindow.StartStop.cs:779).
         WPF's caption is the literal "▶ START"/"■ STOP" pair built in code, NOT the localized
         btn_start/btn_stop keys (:761-762, :786-787) — the port keeps the literals and drops
         the glyphs, which is the §9 D8 emoji-stripping rule. -->
    <Style Selector="Button.session-start">
      <Setter Property="Background" Value="#FFD05CE8" />
      <Setter Property="Foreground" Value="#FFFFFFFF" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Padding" Value="42,12" />
    </Style>
    <!-- Running: WPF paints the SAME button red, Color.FromRgb(255,107,107) = #FFFF6B6B
         (MainWindow.StartStop.cs:756). One control in two states, never two controls and never
         a disabled one — a stop the user cannot press is the failure mode a panic button
         exists to prevent. -->
    <Style Selector="Button.session-start.running">
      <Setter Property="Background" Value="#FFFF6B6B" />
    </Style>
    <Style Selector="TextBlock.session-status">
      <Setter Property="Foreground" Value="#FFE8E0EE" />
      <Setter Property="Opacity" Value="0.7" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- The rack row's live state dot (§8.3: "The dot on each row is live"). THREE liveries,
         because the port's dot has three honest things to say (see EffectDotState): a hollow
         ring for off, a dim fill for armed-but-idle, a lit fill with a rim for really running.
         Off is a RING rather than a dark disc so "this module is switched off" is legible on
         the rack's own dark ground instead of vanishing into it. -->
    <Style Selector="Ellipse.dot">
      <Setter Property="Width" Value="8" />
      <Setter Property="Height" Value="8" />
      <Setter Property="Fill" Value="Transparent" />
      <Setter Property="Stroke" Value="#FF6B5B73" />
      <Setter Property="StrokeThickness" Value="1" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Ellipse.dot.armed">
      <Setter Property="Fill" Value="#FF6B5B73" />
      <Setter Property="Stroke" Value="#FF6B5B73" />
    </Style>
    <Style Selector="Ellipse.dot.live">
      <Setter Property="Fill" Value="#FFE066FF" />
      <Setter Property="Stroke" Value="#FFF3C4FF" />
    </Style>

    <Style Selector="TextBlock.dial-label">
      <Setter Property="Foreground" Value="#FFE8E0EE" />
      <Setter Property="Opacity" Value="0.8" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.dial-value">
      <Setter Property="Foreground" Value="#FFE8E0EE" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="MinWidth" Value="34" />
      <Setter Property="TextAlignment" Value="Right" />
    </Style>
    <Style Selector="CheckBox.dial-enable">
      <Setter Property="Foreground" Value="#FFE8E0EE" />
      <Setter Property="FontSize" Value="12" />
    </Style>
  </Window.Styles>

  <DockPanel>
    <!-- Diagnostic footer: the layout probe (now measuring the rail's doors, which is
         what the headed harness drives) and the current route. Content-free, UIA-readable on
         Windows, logged once on first layout so it is stderr-readable on Linux. -->
    <Border DockPanel.Dock="Bottom" Classes="footer">
      <StackPanel Spacing="2">
        <TextBlock x:Name="RouteProbeText" Classes="diagnostic" Text="route: pending" />
        <TextBlock x:Name="LayoutProbeText" Classes="diagnostic" Text="layout-probe: pending" />
      </StackPanel>
    </Border>

    <!-- The session action bar. Docked AFTER the diagnostic footer so it sits ABOVE
         it, which is where WPF's action bar is: at the foot of the app, on every page (§8.6).
         It is shell chrome and not a page concern, exactly as §8.6's own design consequence
         says, so a session started here survives every navigation.

         ONE button. WPF's BtnStart_Click reads _isRunning and branches
         (MainWindow/MainWindow.StartStop.cs:34,50,105); it is never disabled and never
         duplicated. -->
    <Border DockPanel.Dock="Bottom" Classes="actionbar">
      <Grid ColumnDefinitions="Auto,*">
        <Button Grid.Column="0"
                x:Name="SessionStartButton"
                Classes="session-start"
                AutomationProperties.AutomationId="SessionStartButton"
                AutomationProperties.Name="START"
                ToolTip.Tip="Start the session. Every armed module in the Studio rack runs while it is up."
                Content="START" />
        <TextBlock Grid.Column="1"
                   x:Name="SessionStatusText"
                   Classes="session-status"
                   Margin="16,0,0,0"
                   AutomationProperties.AutomationId="SessionStatusText"
                   Text="" />
      </Grid>
    </Border>

    <!-- The rail. Declared HERE, in markup, and cross-checked against ShellRoutes.Declared by
         NavigationShellHeadlessTests: markup and route table can drift, and the test catches
         it, which a rail generated from the table could never do. -->
    <Border DockPanel.Dock="Left" Classes="rail">
      <StackPanel Spacing="6">
        <TextBlock Classes="rail-brand" Text="CCP" />
        <RadioButton x:Name="DoorStudio" Classes="door" GroupName="rail"
                     AutomationProperties.AutomationId="DoorStudio"
                     AutomationProperties.Name="Studio door"
                     ToolTip.Tip="Every effect, one rack"
                     Content="Studio" />
        <RadioButton x:Name="DoorCompanion" Classes="door" GroupName="rail"
                     AutomationProperties.AutomationId="DoorCompanion"
                     AutomationProperties.Name="Companion door"
                     ToolTip.Tip="Chat, takeover, awareness and permissions"
                     Content="Companion" />
        <RadioButton x:Name="DoorPlay" Classes="door" GroupName="rail"
                     AutomationProperties.AutomationId="DoorPlay"
                     AutomationProperties.Name="Play door"
                     ToolTip.Tip="Games, modes, and the deep end"
                     Content="Play" />
        <RadioButton x:Name="DoorIntake" Classes="door" GroupName="rail"
                     AutomationProperties.AutomationId="DoorIntake"
                     AutomationProperties.Name="Intake door"
                     ToolTip.Tip="A banded descent that reads how you answer - and how long you take - and drafts a personalised session from it."
                     Content="Graded Intake" />
        <RadioButton x:Name="DoorSystem" Classes="door" GroupName="rail"
                     AutomationProperties.AutomationId="DoorSystem"
                     AutomationProperties.Name="System door"
                     ToolTip.Tip="Motion, startup trace and capability states"
                     Content="System" />
      </StackPanel>
    </Border>

    <ContentControl x:Name="PageHost" />
  </DockPanel>
</Window>
