<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CcpClient.Desktop.Views.MainWindow"
        Width="480" Height="320"
        Title="CCP Client">
  <StackPanel Margin="16">
    <TextBlock Text="CCP greenfield client — startup trace" FontWeight="Bold" />
    <TextBlock x:Name="TraceText" TextWrapping="Wrap" Margin="0,8,0,0" />
    <TextBlock x:Name="HeartbeatText" Margin="0,8,0,0" Text="Heartbeat: waiting" />
  </StackPanel>
</Window>
