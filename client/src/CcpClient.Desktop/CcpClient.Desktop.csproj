<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12.0</LangVersion>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- AVLN3001: App/MainWindow have no parameterless ctor by design — they are constructed
         through the composition root with injected dependencies (startup-shutdown-contract §7),
         never via the runtime XAML loader. -->
    <NoWarn>$(NoWarn);AVLN3001</NoWarn>
    <!-- dtrh-admission.md §1 integration consequence: Avalonia's Win32
         NativeControlHost crashes without supportedOS entries (empirical). -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <!-- dtrh-admission.md §1: pinned 12.0.1 (current latest, MIT, dep
         Avalonia@12.0.0 minimum — nearest-wins to the 12.1.1 baseline). -->
    <PackageReference Include="Avalonia.Controls.WebView" Version="12.0.1" />
    <PackageReference Include="Keincheck" Version="0.11.0" />
    <!-- audio-backend-spike.md §1 (live-feed re-confirmed 2026-07-22): SoundFlow
         1.4.1, MIT (nupkg LICENSE.md), net8.0 TFM (runs on net10.0), bundled miniaudio
         natives per-RID (win-x64/linux-x64) — flows into the natives-beside-exe rule. -->
    <PackageReference Include="Buttplug" Version="5.0.1" />
    <PackageReference Include="SoundFlow" Version="1.4.1" />
    <!-- video-handoff-spike.md §1 (live-feed re-confirmed 2026-07-22): LibVLCSharp
         3.10.0 (LGPL-2.1-or-later — sidecar note, pending-owner) + bundled libvlc
         win-x64 3.0.23.1. Linux uses the distro libvlc 3.0.23-1 (apt libvlc5/libvlccore9 —
         no official Linux libvlc nuget exists). -->
    <PackageReference Include="LibVLCSharp" Version="3.10.0" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.23.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- DTRH payload serving (asset class: copied — the first copied consumer).
         The DTRH payload stays READ-ONLY in the legacy tree (trust anchor: git tree
         40be29df, dtrh-admission.md §6); a LINKED glob copies the bytes unmodified to
         output payload/dtrh/ — the single source of truth is never duplicated in git.
         WPF archaeology: identical Content-copy-to-output shape (csproj:349-357). -->
    <Content Include="..\..\..\ConditioningControlPanel\Resources\web\dtrh\**\*">
      <Link>payload\dtrh\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <!-- Intake payload serving (the SAME copied-asset convention + trust-anchor
         discipline as the dtrh glob above; flagged scope expansion — record.md glue bundle).
         The intake tree serves overlay-first on the intake host's §4 server; the dtrh
         tree below it is the borrow fallback (vendor/three, chime mp3s). READ-ONLY. -->
    <Content Include="..\..\..\ConditioningControlPanel\Resources\web\intake\**\*">
      <Link>payload\intake\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <!-- Tunnel backdrop payload serving (the SAME copied-asset convention +
         trust-anchor discipline as the dtrh/intake globs; DOCUMENTED File-Scope amendment —
         record.md Step 2). TWO roots because the page's import map resolves ../vendor/three
         relative to /tunnel/ (tunnel/index.html:29-34; WPF maps the Resources/web root for
         the same reason, ChaosTunnelService.cs:43-46). READ-ONLY upstream trees. -->
    <Content Include="..\..\..\ConditioningControlPanel\Resources\web\tunnel\**\*">
      <Link>payload\tunnel\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <!-- Goon payload serving: the FIFTH instance of the DTRH linked-glob pattern
         above, and byte-identical in shape. 184 files stay READ-ONLY and OWNED by the legacy
         tree (goon-game-census.md 5.3 proposes exactly this glob and proposes copying
         nothing); 164 of them are what the page actually loads. The practice host serves
         them through Features/Goon/GoonParticipant.cs, and presence is probed by
         Features/Goon/GoonServingRoots.cs (typed Present/Missing/Incomplete). -->
    <Content Include="..\..\..\ConditioningControlPanel\Resources\web\goon\**\*">
      <Link>payload\goon\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <!-- Arcademy payload serving: the SIXTH linked read-only glob, identical in shape to the
         five above. 91 files / 2.8 MB stay OWNED by the legacy tree; zero bytes are forked.
         THE TREE DOES NOT STAND ALONE and that is why the serving root is the payload MIRROR
         rather than this folder: the shell borrows DTRH's spirals by RELATIVE url
         (arcademy/shell/shell.js:76 `../../dtrh/assets/bubbles/effects/spirals/`,
         games/the-deep-end/pressure.js:182 `../../../dtrh/…`), which only resolves when the
         whole Resources/web root is reachable — exactly what payload/ already is once this
         glob lands beside dtrh/intake/tunnel/goon/vendor. Served through
         Features/Arcademy/ArcademyParticipant.cs; presence probed by ArcademyServingRoots. -->
    <Content Include="..\..\..\ConditioningControlPanel\Resources\web\arcademy\**\*">
      <Link>payload\arcademy\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\..\..\ConditioningControlPanel\Resources\web\vendor\**\*">
      <Link>payload\vendor\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <!-- The four built-in scripted sessions: the SEVENTH linked read-only glob, identical in shape
         to the six above and the first one that is not a web payload. The .session.json files stay
         OWNED by the legacy tree (ConditioningControlPanel/assets/sessions/), zero bytes are
         forked, and they land beside the binary in sessions/ — where Session/ScriptedSession.cs
         resolves them, the same one-code-path shape WPF uses for its own
         (Services/Session/SessionFileService.cs:37-44, BaseDirectory/assets/sessions). -->
    <Content Include="..\..\..\ConditioningControlPanel\assets\sessions\*.session.json">
      <Link>sessions\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <!-- Product-owned overlay (served overlay-first; exactly ONE payload shadow:
         bridge.js = blob 13af3f4d + the §3.1 transport diff). -->
    <Content Include="Features\Dtrh\overlay\**\*">
      <Link>payload-overlay\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>
