<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:companion="using:CcpClient.Desktop.Features.Companion"
        x:Class="CcpClient.Desktop.Features.Companion.CompanionWindow"
        x:DataType="companion:CompanionViewModel"
        Title="Companion — CCP Client"
        Width="480" Height="860" MinWidth="380" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource DarkerBgBrush}">

  <!-- Hand-authored smallest AXAML (A-013 advisory runs on this file — advisory
       only). Evolved dashboard grammar: dark #FF121220 base, neon #FFFF8FAF accent,
       #FF3A3A5C borders, restrained glow (MainWindow.axaml/FeaturePopupWindow.axaml
       lineage) — designed, never WPF-cloned (owner decree 2026-08-04). Styling is
       selectors + conditional classes + pseudo-classes (v12; never WPF triggers).
       Escape: ONE path through the VM (confirm-open -> cancel (default No); else close). -->

  <Window.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{Binding EscapeCommand}" />
  </Window.KeyBindings>

  <Window.Styles>
    <Style Selector="Border.chat-bubble">
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="Margin" Value="0,3" />
      <Setter Property="MaxWidth" Value="330" />
      <Setter Property="Background" Value="{DynamicResource SeatBgBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource PanelAccentHoverBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.chat-bubble.user">
      <Setter Property="Background" Value="#FF241A2B" />
      <Setter Property="BorderBrush" Value="{DynamicResource TextDimBrush}" />
      <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
    <Style Selector="Border.chat-bubble.thinking">
      <Setter Property="Opacity" Value="0.6" />
    </Style>
    <!-- The badge: neon accent ring — visible ONLY on Generated bubbles (the class is
         bound to the type-derived IsAiBadged, the single badge authority). -->
    <Style Selector="Border.chat-bubble.badged">
      <Setter Property="BorderBrush" Value="{DynamicResource ShellAccentBrightBrush}" />
      <Setter Property="BoxShadow" Value="0 0 8 0 #66E066FF" />
    </Style>
    <!-- The refusal class (evolved POLICY-pill equivalent): amber treatment, never badged. -->
    <Style Selector="Border.chat-bubble.refusal">
      <Setter Property="BorderBrush" Value="#FFFFC107" />
      <Setter Property="Background" Value="#FF2A2118" />
    </Style>
    <Style Selector="Border.chat-bubble.subdued">
      <Setter Property="Opacity" Value="0.75" />
    </Style>
    <Style Selector="Border.badge-pill">
      <Setter Property="Background" Value="{DynamicResource ShellAccentBrightBrush}" />
      <Setter Property="Padding" Value="4,1" />
      <Setter Property="CornerRadius" Value="3" />
    </Style>
    <Style Selector="Border.badge-pill TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource DarkerBgBrush}" />
      <Setter Property="FontSize" Value="9" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="Button.companion">
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="Background" Value="{DynamicResource PanelAccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextLightBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource PanelAccentHoverBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="Button.companion:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource ShellAccentBrightBrush}" />
    </Style>
    <Style Selector="Button.companion:disabled">
      <Setter Property="Opacity" Value="0.5" />
    </Style>
    <Style Selector="TextBlock.status">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    </Style>
    <!-- THE DIAL SEAT. A Border around each segment, because a RadioButton's own Background does
         not fill a segment under the Fluent template - and because the seat's PADDING is what the
         headed `companion-privacy` pair reads: 3 DIP above the RadioButton's own UIA rect is flat
         seat fill, and the two fills are 44/20/51 apart so neither state's check can accept the
         other's capture. -->
    <Style Selector="Border.dial-seat">
      <Setter Property="Background" Value="{DynamicResource SeatBgBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource PanelAccentHoverBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Padding" Value="6,5" />
    </Style>
    <Style Selector="Border.dial-seat.selected">
      <Setter Property="Background" Value="#FF4A2C55" />
      <Setter Property="BorderBrush" Value="{DynamicResource ShellAccentBrightBrush}" />
    </Style>
    <Style Selector="TextBlock.status.available">
      <Setter Property="Foreground" Value="#FFB8F0B8" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,*,Auto,Auto">

    <!-- Header: title + status (status derives from the probed capability state ONLY). -->
    <Border Grid.Row="0" Background="#FF241A2B" BorderBrush="{DynamicResource PanelAccentHoverBrush}" BorderThickness="0,0,0,1" Padding="14,10">
      <Grid ColumnDefinitions="Auto,*">
        <TextBlock Text="Companion" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource ShellAccentBrightBrush}" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Classes="status"
                   Classes.available="{Binding StatusAvailable}"
                   Text="{Binding StatusText}"
                   HorizontalAlignment="Right" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <!-- Chat list (v12: ItemsControl + ItemTemplate inside a ScrollViewer; vertical only). -->
    <ScrollViewer x:Name="ChatScroller" Grid.Row="1"
                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  AllowAutoHide="False" Padding="14,10">
      <ItemsControl ItemsSource="{Binding Bubbles}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="companion:CompanionBubbleModel">
            <Border Classes="chat-bubble"
                    Classes.user="{Binding IsUser}"
                    Classes.thinking="{Binding IsThinking}"
                    Classes.badged="{Binding IsAiBadged}"
                    Classes.refusal="{Binding IsRefusal}"
                    Classes.subdued="{Binding IsSubdued}">
              <StackPanel>
                <!-- The AI badge pill: bound visibility to the SAME type-derived property
                     that drives the ring — one authority, two presentations. -->
                <Border IsVisible="{Binding IsAiBadged}" Classes="badge-pill" HorizontalAlignment="Left" Margin="0,0,0,3">
                  <TextBlock Text="{Binding ProvenanceClass, StringFormat='AI · {0}'}" />
                </Border>
                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Foreground="{DynamicResource TextLightBrush}" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <!-- Settings surface: awareness consent + memory consent + cooldown values + the
         memory-clear control. All states are session-scoped typed placeholders (owner-pending). -->
    <Border Grid.Row="2" BorderBrush="{DynamicResource PanelAccentHoverBrush}" BorderThickness="0,1,0,0" Padding="14,8">
      <StackPanel Spacing="6">
        <!-- WHAT LEAVES YOUR PC (audit row A3). Three stops over the two states the port has:
             the awareness consent, and the F4 per-app title allow-list. Never a stored level -
             it is DERIVED, exactly as upstream derives it
             (Views/Controls/Companion/Runtime/AwarenessPrivacyRuntimeVm.cs:332-336), so the strip
             and the filter cannot disagree. Copy is upstream's own
             (Localization/Languages/en.json:4432-4437, :4450). -->
        <TextBlock x:Name="PrivacyDialHead" Text="what leaves your PC"
                   FontSize="12" Foreground="{DynamicResource TextLightBrush}"
                   AutomationProperties.AutomationId="PrivacyDialHead"
                   AutomationProperties.Name="what leaves your PC" />
        <Border x:Name="PrivacyDialStrip"
                Background="{DynamicResource SeatBgBrush}" BorderBrush="{DynamicResource PanelAccentHoverBrush}" BorderThickness="1"
                CornerRadius="4" Padding="6">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Border Classes="dial-seat" Classes.selected="{Binding StopOffSelected}">
              <RadioButton x:Name="DialOff" GroupName="privacy-dial" Content="─ Off"
                           IsChecked="{Binding StopOffSelected}"
                           Foreground="{DynamicResource TextLightBrush}" FontSize="12"
                           AutomationProperties.AutomationId="DialOff"
                           AutomationProperties.Name="privacy dial off" />
            </Border>
            <Border Classes="dial-seat" Classes.selected="{Binding StopAppNamesSelected}">
              <RadioButton x:Name="DialBroad" GroupName="privacy-dial" Content="◔ App names only"
                           IsChecked="{Binding StopAppNamesSelected}"
                           Foreground="{DynamicResource TextLightBrush}" FontSize="12"
                           AutomationProperties.AutomationId="DialBroad"
                           AutomationProperties.Name="privacy dial app names only" />
            </Border>
            <Border x:Name="DialTitlesSeat" Classes="dial-seat" Classes.selected="{Binding StopPageTitlesSelected}">
              <RadioButton x:Name="DialTitles" GroupName="privacy-dial" Content="◉ + Page titles"
                           IsChecked="{Binding StopPageTitlesSelected}"
                           Foreground="{DynamicResource TextLightBrush}" FontSize="12"
                           AutomationProperties.AutomationId="DialTitles"
                           AutomationProperties.Name="privacy dial plus page titles" />
            </Border>
          </StackPanel>
        </Border>
        <TextBlock x:Name="PrivacyDialHint" Text="{Binding PrivacyHint}"
                   FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"
                   AutomationProperties.AutomationId="PrivacyDialHint" />

        <!-- THE PER-APP EDITOR (audit row A4). Opened by ASKING for the third stop; asking never
             widens anything on its own, and the dial goes on reading "App names only" until an app
             is actually named (AwarenessPrivacyRuntimeVm.cs:106-113 and :24-27). The list ships
             EMPTY, which is NARROWER than what this port did before: a granted consent used to let
             every app's title through. -->
        <Border x:Name="TitleAllowEditor"
                IsVisible="{Binding TitleEditorVisible}"
                BorderBrush="{DynamicResource PanelAccentHoverBrush}" BorderThickness="1" CornerRadius="4"
                Background="{DynamicResource SeatBgBrush}" Padding="8,6"
                AutomationProperties.AutomationId="TitleAllowEditor">
          <StackPanel Spacing="4">
            <TextBlock Text="Apps whose page titles she may carry. Empty means none, for anyone."
                       FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBox x:Name="TitleAllowInput"
                       Text="{Binding TitleAllowInput}"
                       PlaceholderText="app name"
                       Background="{DynamicResource DarkerBgBrush}" Foreground="{DynamicResource TextLightBrush}"
                       BorderBrush="{DynamicResource PanelAccentHoverBrush}" CornerRadius="4" Padding="6,4"
                       AutomationProperties.AutomationId="TitleAllowInput"
                       AutomationProperties.Name="app name to allow" />
              <Button Grid.Column="1" x:Name="TitleAllowAdd" Margin="6,0,0,0"
                      Classes="companion" Content="Name it"
                      Command="{Binding AddNamedAppCommand}"
                      AutomationProperties.AutomationId="TitleAllowAdd"
                      AutomationProperties.Name="name this app" />
            </Grid>
            <TextBlock x:Name="TitleAllowNotice"
                       IsVisible="{Binding TitleAllowNoticeVisible}"
                       Text="{Binding TitleAllowNotice}"
                       FontSize="10" Foreground="#FFFFC107" TextWrapping="Wrap"
                       AutomationProperties.AutomationId="TitleAllowNotice" />
            <ItemsControl x:Name="NamedAppList" ItemsSource="{Binding NamedApps}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <Border Background="{DynamicResource PanelAccentBrush}" BorderBrush="{DynamicResource TextDimBrush}" BorderThickness="1"
                          CornerRadius="3" Padding="6,2" Margin="0,2,4,0">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="{Binding}" FontSize="11" Foreground="{DynamicResource TextLightBrush}" VerticalAlignment="Center" />
                      <Button Content="×" Padding="4,0" FontSize="11"
                              Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextMutedBrush}"
                              Command="{Binding $parent[ItemsControl].((companion:CompanionViewModel)DataContext).RemoveNamedAppCommand}"
                              CommandParameter="{Binding}"
                              AutomationProperties.Name="stop carrying titles for this app" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <Grid ColumnDefinitions="Auto,Auto,*">
          <CheckBox x:Name="MemoryConsentToggle"
                    Content="Memory consent"
                    IsChecked="{Binding MemoryConsentGranted}"
                    Foreground="{DynamicResource TextLightBrush}" FontSize="12" VerticalAlignment="Center"
                    AutomationProperties.AutomationId="MemoryConsentToggle"
                    AutomationProperties.Name="memory consent toggle" />
          <Button Grid.Column="1" x:Name="TranscriptButton" Margin="14,0,0,0"
                  Classes="companion" Content="Everything you two have said"
                  Command="{Binding ShowTranscriptCommand}"
                  AutomationProperties.AutomationId="TranscriptButton"
                  AutomationProperties.Name="open transcript"
                  ToolTip.Tip="A read-only view of what is actually saved. Nothing else is shown, because nothing else is kept." />
          <TextBlock Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center"
                     IsVisible="{Binding ClearOutcomeVisible}"
                     Text="{Binding ClearOutcomeText}"
                     FontSize="11" Foreground="#FFB8B0C0" TextWrapping="Wrap"
                     AutomationProperties.AutomationId="ClearOutcomeText" />
        </Grid>

        <!-- THE THREE FORGET SCOPES (audit row C10). Upstream has three buttons because the three
             scopes delete different things: ForgetThread (CompanionBrain.cs:550-558) keeps
             everything she knows about you, ForgetConversation (:571-585) takes what was derived
             from the chat too, and Forget (:606-612) over MemoryStore.Wipe (:592-631) takes every
             copy. Each confirms with copy that names what SURVIVES, which is the only thing that
             makes them distinguishable to a user. -->
        <!-- A WrapPanel, not a row: three captions this long overflow a 480 DIP window on one
             line, and a button whose centre is off the window edge is a button the user cannot
             press (measured headless, CompanionPrivacyHeadlessTests). -->
        <WrapPanel Orientation="Horizontal">
          <Button x:Name="ForgetThreadButton" Margin="0,0,6,4"
                  Classes="companion" Content="Clear conversation"
                  Command="{Binding ForgetThreadCommand}"
                  AutomationProperties.AutomationId="ForgetThreadButton"
                  AutomationProperties.Name="clear conversation"
                  ToolTip.Tip="Drops the thread only. The saved document is kept." />
          <Button x:Name="ClearMemoryButton" Margin="0,0,6,4"
                  Classes="companion" Content="Reset memory"
                  Command="{Binding RequestClearCommand}"
                  AutomationProperties.AutomationId="ClearMemoryButton"
                  AutomationProperties.Name="memory clear button"
                  ToolTip.Tip="Deletes the saved companion memory. Asks first; can't be undone." />
          <Button x:Name="ForgetEverythingButton" Margin="0,0,6,4"
                  Classes="companion" Content="Forget everything"
                  Command="{Binding ForgetEverythingCommand}"
                  AutomationProperties.AutomationId="ForgetEverythingButton"
                  AutomationProperties.Name="forget everything"
                  ToolTip.Tip="The saved memory and every quarantined copy of it, so nothing can bring it back." />
        </WrapPanel>
        <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
          <TextBlock Text="Cooldowns (s):" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
          <NumericUpDown x:Name="ReactionCooldownBox" Grid.Column="1" Width="72"
                         Minimum="1" Maximum="600" Increment="1"
                         Value="{Binding ReactionSeconds}"
                         ToolTip.Tip="Reaction cooldown (placeholder baseline)"
                         AutomationProperties.Name="reaction cooldown seconds" />
          <NumericUpDown x:Name="GlobalCooldownBox" Grid.Column="2" Width="72" Margin="6,0,0,0"
                         Minimum="1" Maximum="600" Increment="1"
                         Value="{Binding GlobalSeconds}"
                         ToolTip.Tip="Global cooldown (placeholder baseline)"
                         AutomationProperties.Name="global cooldown seconds" />
          <NumericUpDown x:Name="PerKeywordCooldownBox" Grid.Column="3" Width="72" Margin="6,0,0,0"
                         Minimum="1" Maximum="600" Increment="1"
                         Value="{Binding PerKeywordSeconds}"
                         ToolTip.Tip="Per-keyword cooldown (placeholder baseline)"
                         AutomationProperties.Name="per-keyword cooldown seconds" />
          <NumericUpDown x:Name="LoopCooldownBox" Grid.Column="4" Width="72" Margin="6,0,0,0"
                         Minimum="1" Maximum="600" Increment="1"
                         Value="{Binding LoopProtectionSeconds}"
                         ToolTip.Tip="Loop-protection cooldown (placeholder baseline)"
                         AutomationProperties.Name="loop protection cooldown seconds" />
        </Grid>
        <!-- WHAT SHE'S ALLOWED TO DO. Upstream's one AI-permissions surface, ported by
             outcome: a master switch, and beneath it the ten per-effect switches that only
             appear while the master is on (Views/Controls/Companion/AiPermissionsGrid.xaml:160-200,
             shown/hidden at MainWindow/MainWindow.Patreon.cs:1477). It lives on the companion
             surface because that is where every other companion consent already lives — the
             awareness and memory toggles two rows up — and a consent surface split across two
             doors is one the user has to find twice.

             THE DEFAULT IS CLOSED: master off, zero ticks, and the ticks are session-scoped
             (AiEffectPermissions). Upstream ships bubbles/subliminal/bounce pre-ticked
             (Models/CompanionPromptSettings.cs:103-110); this port admits nothing until the
             user says so, which is the divergence AiExecutionGates.NoneAdmitted already
             recorded. -->
        <Grid ColumnDefinitions="Auto,Auto,*">
          <TextBlock Text="Effect control" FontSize="12" Foreground="{DynamicResource TextLightBrush}" VerticalAlignment="Center" />
          <CheckBox Grid.Column="1" x:Name="EffectsMasterToggle" Margin="10,0,0,0"
                    Content="Let her drive effects"
                    IsChecked="{Binding EffectsMasterEnabled}"
                    Foreground="{DynamicResource TextLightBrush}" FontSize="12" VerticalAlignment="Center"
                    AutomationProperties.AutomationId="EffectsMasterToggle"
                    AutomationProperties.Name="effect control master toggle"
                    ToolTip.Tip="Master switch. While this is off she can drive nothing, whatever the switches below say." />
        </Grid>
        <Border x:Name="EffectPermissionsPanel"
                IsVisible="{Binding EffectsMasterEnabled}"
                BorderBrush="#FFFFC107" BorderThickness="1" CornerRadius="4"
                Background="{DynamicResource SeatBgBrush}" Padding="8,6"
                AutomationProperties.AutomationId="EffectPermissionsPanel">
          <StackPanel Spacing="4">
            <TextBlock Text="Effect permissions" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFC107" />
            <ItemsControl ItemsSource="{Binding EffectPermissions}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="companion:CompanionPermissionRow">
                  <StackPanel Orientation="Horizontal" Width="210" Margin="0,1">
                    <CheckBox Content="{Binding Label}"
                              IsChecked="{Binding Allowed}"
                              Foreground="{DynamicResource TextLightBrush}" FontSize="12" VerticalAlignment="Center"
                              AutomationProperties.AutomationId="{Binding Id}"
                              AutomationProperties.Name="{Binding Label}" />
                    <!-- The named absence, in one word on screen and in full on hover. A ticked
                         switch over an absent backend records consent; it never claims a
                         capability (CompanionPermissionRow). -->
                    <TextBlock Text="· not in this build"
                               IsVisible="{Binding BackendNoteVisible}"
                               VerticalAlignment="Center" Margin="4,0,0,0"
                               FontSize="10" Foreground="{DynamicResource TextMutedBrush}"
                               ToolTip.Tip="{Binding BackendNote}" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
        <!-- The honesty line (pre-approach consult #6): state exactly what memory
             does — saved, clearable, consumed as context ONLY under the consent typed state.
             Never imply recall under the Denied placeholder default. -->
        <TextBlock Text="Memory is saved, can be cleared here, and is used as conversation context while memory consent is on. Consent, effect permissions and cooldowns are session-scoped placeholders pending owner decisions."
                   FontSize="10" Opacity="0.6" Foreground="{DynamicResource TextLightBrush}" TextWrapping="Wrap" />
        <!-- The second honesty line, and it is the one that keeps this whole panel from
             over-claiming: her replies do not reach the command executor in this build at all
             (AiOperationPipeline.cs:340-346 refuses envelope-shaped replies). These switches
             decide what WOULD be admitted; nothing dispatches yet. -->
        <TextBlock x:Name="EffectDispatchNotice"
                   Text="Nothing dispatches yet: her replies are not read as commands in this build, so these switches decide what would be admitted, not what is happening."
                   FontSize="10" Opacity="0.6" Foreground="{DynamicResource TextLightBrush}" TextWrapping="Wrap"
                   AutomationProperties.AutomationId="EffectDispatchNotice" />
      </StackPanel>
    </Border>

    <!-- Input row: Enter or Send; Stop while in-flight. -->
    <Border Grid.Row="3" BorderBrush="{DynamicResource PanelAccentHoverBrush}" BorderThickness="0,1,0,0" Padding="14,10">
      <Grid ColumnDefinitions="*,Auto,Auto">
        <TextBox x:Name="ChatInput"
                 Text="{Binding InputText}"
                 PlaceholderText="Message the companion…"
                 Background="{DynamicResource SeatBgBrush}" Foreground="{DynamicResource TextLightBrush}"
                 BorderBrush="{DynamicResource PanelAccentHoverBrush}" CornerRadius="4" Padding="8,6"
                 AutomationProperties.Name="companion chat input">
          <TextBox.KeyBindings>
            <KeyBinding Gesture="Enter" Command="{Binding SendCommand}" />
          </TextBox.KeyBindings>
        </TextBox>
        <Button Grid.Column="1" x:Name="SendButton" Margin="8,0,0,0"
                Classes="companion" Content="Send"
                Command="{Binding SendCommand}"
                AutomationProperties.Name="companion send button" />
        <Button Grid.Column="2" x:Name="StopButton" Margin="8,0,0,0"
                Classes="companion" Content="Stop"
                Command="{Binding StopCommand}"
                IsEnabled="{Binding InFlight}"
                AutomationProperties.Name="companion stop button"
                ToolTip.Tip="Stop the in-flight operation (panic-quiet)" />
      </Grid>
    </Border>

    <!-- In-window memory-clear confirm (modal within the window; WPF MessageBox shape,
         Patreon.cs:920-927: Yes/No, default NO, can't-be-undone body; Esc = No). -->
    <Border Grid.Row="0" Grid.RowSpan="4" x:Name="ConfirmOverlay"
            IsVisible="{Binding ConfirmVisible}"
            Background="#A0141018">
      <Border Width="340" Padding="18" CornerRadius="8"
              Background="{DynamicResource SeatBgBrush}" BorderBrush="{DynamicResource ShellAccentBrightBrush}" BorderThickness="1"
              HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="12">
          <TextBlock x:Name="ConfirmTitleText" Text="{Binding ConfirmTitle}"
                     FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource ShellAccentBrightBrush}"
                     AutomationProperties.AutomationId="ConfirmTitleText" />
          <TextBlock x:Name="ConfirmBodyText" Text="{Binding ConfirmBody}"
                     TextWrapping="Wrap" Foreground="{DynamicResource TextLightBrush}"
                     AutomationProperties.AutomationId="ConfirmBodyText" />
          <Grid ColumnDefinitions="*,Auto,Auto">
            <Button Grid.Column="1" x:Name="ConfirmYesButton" Margin="0,0,8,0"
                    Classes="companion" Content="Yes"
                    Command="{Binding ConfirmClearCommand}"
                    AutomationProperties.Name="memory clear confirm yes" />
            <Button Grid.Column="2" x:Name="ConfirmNoButton"
                    Classes="companion" Content="No"
                    Command="{Binding CancelClearCommand}"
                    AutomationProperties.Name="memory clear confirm no" />
          </Grid>
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</Window>
