<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CcpClient.Desktop.Features.Dtrh.DtrhLoomWindow"
        Title="The Loom"
        Width="1200" Height="800"
        Background="#0b0b16">
  <!--
    SP-049 THE LOOM studio shell (WPF LoomHostService parity — a plain titled window,
    "the user closes it with X, not a page exit protocol", LoomHostService.cs:78-83).
    1200x800: below 980px wide loom.html stacks the studio-split into one column — the
    two-pane grid + rack filmstrip need the width (pre-approach consult binding 5d).
    Same capability-driven surface selection as the game host (never an OS guess).
  -->
  <DockPanel>
    <TextBlock x:Name="Status" DockPanel.Dock="Bottom"
               Foreground="#ff9ad5" Background="#141422" Padding="6"
               FontFamily="Consolas" FontSize="12"
               Text="loom studio booting" />
    <Panel>
      <StackPanel x:Name="UnsupportedPanel" IsVisible="False" Margin="24" Spacing="8">
        <TextBlock Foreground="#ff9ad5" FontSize="18" FontWeight="Bold"
                   Text="The Loom: honest unsupported" />
        <TextBlock x:Name="UnsupportedDetail" Foreground="#c8c8dd" TextWrapping="Wrap" />
      </StackPanel>
      <!-- NativeWebView is created PROGRAMMATICALLY on the embedded path only (SP-011 L4 —
           in the tree it starts its adapter whenever the window shows). -->
      <Panel x:Name="WebHost" />
    </Panel>
  </DockPanel>
</Window>
