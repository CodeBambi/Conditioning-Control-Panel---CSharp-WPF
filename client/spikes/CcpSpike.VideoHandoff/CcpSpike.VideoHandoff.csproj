<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SP-018 quarantined video-handoff spike host. NOT referenced by client/CcpClient.sln.
    Inherits client/Directory.Build.props (single <Version> authority) — nothing else.
    Console host: acceptance is native-decoder-event-verified probe evidence, not a test project.
    Package admission per spine-tasks/SP-018-video-handoff-spike/record.md §1.5
    (solo Fable 5 consult, 2026-07-21): LibVLCSharp 3.10.0 + VideoLAN.LibVLC.Windows 3.0.23.1;
    Linux native = distro libvlc via apt (no official Linux nuget exists — verified).
    Browser layer (Step 3) reuses SP-011-admitted Avalonia.Controls.WebView 12.0.1.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12.0</LangVersion>
    <RootNamespace>CcpSpike.VideoHandoff</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- NativeControlHost (WebView) needs supportedOS in the Win32 manifest (SP-011 integration consequence). -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibVLCSharp" Version="3.10.0" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.23.1" />
    <PackageReference Include="Avalonia.Controls.WebView" Version="12.0.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="fixtures\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
