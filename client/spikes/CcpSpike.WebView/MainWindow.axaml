<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CcpSpike.WebView.MainWindow"
        Title="SP-011 WebView spike"
        Width="1280" Height="800"
        Background="#0b0b16">
  <DockPanel>
    <TextBlock x:Name="Status" DockPanel.Dock="Bottom"
               Foreground="#ff9ad5" Background="#141422" Padding="6"
               FontFamily="Consolas" FontSize="12"
               Text="spike booting" />
    <NativeWebView x:Name="Web" />
  </DockPanel>
</Window>
