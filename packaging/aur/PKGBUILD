# Consumes the CI-built linux-x64 tarball (packaging/linux/build-tarball.sh); docs/avalonia-linux-install.md.
# Not submitted to the AUR from this repo. A release pins sha256sums with `updpkgsums` against the uploaded asset.
# Local test: copy the tarball next to this file; makepkg uses it instead of downloading.
pkgname=conditioning-control-panel-bin
pkgver=6.11.3
pkgrel=1
pkgdesc="A visual conditioning application with gamification features"
arch=('x86_64')
url="https://github.com/CodeBambi/Conditioning-Control-Panel---CSharp-WPF"
license=('custom')
# Web views (GTK3 WebKit + WPE), LibVLC audio/video, libsecret tokens, X11/XInput2 overlays + panic key,
# parec mic (libpulse), ICU for .NET globalization. .NET itself is self-contained.
depends=('webkit2gtk-4.1' 'wpewebkit' 'wpebackend-fdo' 'libwpe' 'vlc' 'libsecret' 'libx11' 'libxi' 'libpulse' 'icu')
provides=('conditioning-control-panel')
conflicts=('conditioning-control-panel')
options=('!strip' '!debug')
_id=io.github.CodeBambi.ConditioningControlPanel
source=("ConditioningControlPanel-$pkgver-linux-x64.tar.gz::$url/releases/download/v$pkgver/ConditioningControlPanel-$pkgver-linux-x64.tar.gz")
sha256sums=('SKIP')

package() {
  install -d "$pkgdir/opt"
  cp -a ConditioningControlPanel "$pkgdir/opt/conditioning-control-panel"
  install -Dm755 /dev/stdin "$pkgdir/usr/bin/conditioning-control-panel" <<'EOF'
#!/bin/sh
exec /opt/conditioning-control-panel/CCP.Avalonia "$@"
EOF
  install -Dm644 "ConditioningControlPanel/$_id.desktop" "$pkgdir/usr/share/applications/$_id.desktop"
  install -Dm644 "ConditioningControlPanel/$_id.png" "$pkgdir/usr/share/icons/hicolor/128x128/apps/$_id.png"
}
