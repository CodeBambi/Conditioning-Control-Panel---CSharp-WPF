<!-- PORTED from ConditioningControlPanel/Windows/QuizWindow.xaml.
     Structure, x:Names, ordering, spacing and every loc key preserved so the two diff cleanly.
     Deviations, all forced:

       WindowStyle="None"                       -> SystemDecorations="None"
       AllowsTransparency="False"               -> dropped; that is Avalonia's default already
       ResizeMode="CanResize"                   -> CanResize="True"
       <Window.Resources> Storyboards           -> the GlowPulse one becomes a Border.pulse style
                                                   with <Style.Animations> (WebcamLoadingSplash
                                                   precedent), added from the Loaded handler
                                                   exactly where WPF called glowSb.Begin().
                                                   ScorePulse becomes an Animation built in
                                                   code-behind (UpdateScore). FadeInStoryboard is
                                                   DROPPED: nothing in the WPF code-behind ever
                                                   resolves that key - AnimateQuestionIn builds its
                                                   own DoubleAnimations - so it was already dead.
       <Button.Style> + ControlTemplate.Triggers
         (IsMouseOver)                          -> Button.titlebar / .titlebarclose classes plus
                                                   `:pointerover /template/ ContentPresenter`
                                                   setters. The Fluent template already draws a
                                                   TemplateBinding-fed background, so re-declaring
                                                   a ControlTemplate buys nothing (GoonTestWindow
                                                   precedent, and it avoids trap 4 + trap 6).
       RadialGradientBrush "0.5,0.5" / 0.8      -> "50%,50%" / "80%". Bare numbers are ABSOLUTE
                                                   PIXELS in Avalonia, so the unconverted brush
                                                   drew a half-pixel dot.
       DynamicResource on a GradientStop /
         DropShadowEffect Color                 -> StaticResource (SeasonRecapCard /
                                                   QuizReportWindow / QuizCategoryEditorWindow
                                                   precedent: neither is a styled property host
                                                   that tracks a dynamic resource).
       DropShadowEffect ShadowDepth="0"         -> dropped; Avalonia's effect has OffsetX/Y, both
                                                   default to 0.
       Visibility="Collapsed"                   -> IsVisible="False"
       IsHitTestVisible                         -> kept; Avalonia has the same property
       <Thickness>1</Thickness> element syntax  -> BorderThickness="1" attribute
       RenderTransformOrigin="0.5,0.5" +
         <ScaleTransform>/<TranslateTransform>  -> RenderTransformOrigin="50%,50%" and the
                                                   transform set from code where it is animated
       MouseLeftButtonDown / MouseEnter / Leave
       Click / KeyDown / Loaded in markup       -> PointerPressed / PointerEntered / PointerExited
                                                   / Click / KeyDown / Loaded, all wired in the
                                                   constructor, per the porting convention.
       {loc:Str} on the four TextBlocks that
         the code-behind also assigns          -> set from code instead (TxtLoadingDots,
                                                   TxtLoadingFlavor, TxtTrySessionIcon,
                                                   TxtTrySessionLabel). Avalonia keeps a binding
                                                   alive under a local value where WPF cleared it,
                                                   so the assignment would be undone on the next
                                                   language change. See CLAUDE.md.
       <Button.Resources><Style TargetType=
         "Border"> CornerRadius</Style>         -> CornerRadius on the Button itself; the WPF hack
                                                   existed because WPF's Button has no such
                                                   property, Avalonia's does.

     The root Grid gained x:Name="RootGrid" (the surrender overlay is parented onto it from code,
     where WPF cast Content to Grid). Buttons carry a TextBlock child rather than Content: Avalonia
     parses "_" in Content as an access key and every loc key here is snake_case. See CLAUDE.md.
     The two title-bar buttons keep Content, because ToggleMaximize reassigns it and neither glyph
     contains an underscore. -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ConditioningControlPanel.Avalonia.Localization"
        x:Class="ConditioningControlPanel.Avalonia.Views.Windows.QuizWindow"
        Title="{loc:Str dialog_quiz}"
        Width="900" Height="750"
        MinWidth="600" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        SystemDecorations="None"
        CanResize="True"
        Background="Black">

    <Window.Styles>
        <!-- Glow pulse (infinite) — the WPF GlowPulseStoryboard, verbatim: 0.03 -> 0.08 over 2s,
             autoreversed forever. The .pulse class is added in the Loaded handler, which is where
             WPF called glowSb.Begin(). -->
        <Style Selector="Border#GlowOverlay.pulse">
            <Style.Animations>
                <Animation Duration="0:0:2" IterationCount="INFINITE" PlaybackDirection="Alternate">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.03"/></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.08"/></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- The two inline <Button.Style> blocks in the WPF title bar. -->
        <Style Selector="Button.titlebar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.titlebar:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#30FFFFFF"/>
            <Setter Property="TextElement.Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.titlebarclose:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#E81123"/>
            <Setter Property="TextElement.Foreground" Value="White"/>
        </Style>
    </Window.Styles>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title bar (non-fullscreen only) -->
        <Border x:Name="TitleBar" Grid.Row="0" Background="{DynamicResource PanelBgBrush}" Height="36">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{loc:Str dialog_quiz}" Foreground="{DynamicResource PinkBrush}" FontSize="13" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="14,0,0,0"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="BtnMaximizeTitleBar" Classes="titlebar" Content="&#x2610;" Width="36" Height="36"
                        FontSize="14" Cursor="Hand"
                        ToolTip.Tip="{loc:Str tooltip_maximize_restore}"/>
                <Button x:Name="BtnCloseTitleBar" Classes="titlebar titlebarclose" Content="&#x2715;" Width="36" Height="36"
                        FontSize="14" Cursor="Hand"
                        ToolTip.Tip="{loc:Str tooltip_close_escape}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content area -->
        <Grid Grid.Row="1">

        <!-- Background layers (gradient animated from code-behind) -->
        <Border x:Name="BackgroundBorder">
            <Border.Background>
                <RadialGradientBrush Center="50%,50%" GradientOrigin="50%,40%" RadiusX="80%" RadiusY="80%">
                    <GradientStop Color="#1A0A2E" Offset="0"/>
                    <GradientStop Color="#0A0514" Offset="1"/>
                </RadialGradientBrush>
            </Border.Background>
        </Border>

        <!-- Glow overlay -->
        <Border x:Name="GlowOverlay" Opacity="0.05" IsHitTestVisible="False">
            <Border.Background>
                <RadialGradientBrush Center="50%,40%" RadiusX="50%" RadiusY="50%">
                    <GradientStop Color="{StaticResource PinkColor}" Offset="0"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </RadialGradientBrush>
            </Border.Background>
        </Border>

        <!-- Vignette -->
        <Border IsHitTestVisible="False">
            <Border.Background>
                <RadialGradientBrush Center="50%,50%" RadiusX="75%" RadiusY="75%">
                    <GradientStop Color="Transparent" Offset="0.5"/>
                    <GradientStop Color="#80000000" Offset="1"/>
                </RadialGradientBrush>
            </Border.Background>
        </Border>

        <!-- ============ CATEGORY SELECT PANEL ============ -->
        <Grid x:Name="CategorySelectPanel" IsVisible="True">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="500">
                <!-- Title -->
                <TextBlock Text="{loc:Str label_sissy_quiz}" FontSize="58" FontWeight="Bold" Foreground="White"
                           HorizontalAlignment="Center" Margin="0,0,0,8">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="{StaticResource PinkColor}" BlurRadius="30" Opacity="0.6"/>
                    </TextBlock.Effect>
                </TextBlock>
                <TextBlock Text="{loc:Str label_ai_generated_personality_quiz}" Foreground="#808090" FontSize="19"
                           HorizontalAlignment="Center" Margin="0,0,0,40"/>

                <TextBlock Text="{loc:Str label_choose_your_category}" Foreground="#B0B0C8" FontSize="22"
                           HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <!-- Dynamic category buttons (populated from code-behind) -->
                <ScrollViewer MaxHeight="400" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="CategoryButtonsPanel"/>
                </ScrollViewer>

                <!-- ESC hint -->
                <TextBlock Text="{loc:Str label_press_esc_to_close}" Foreground="{DynamicResource PanelAccentBrush}" FontSize="13"
                           HorizontalAlignment="Center" Margin="0,24,0,0"/>
            </StackPanel>
        </Grid>

        <!-- ============ LOADING PANEL ============ -->
        <Grid x:Name="LoadingPanel" IsVisible="False">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="TxtLoadingDots" FontSize="36" FontWeight="Bold"
                           Foreground="{DynamicResource PinkBrush}" HorizontalAlignment="Center">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="{StaticResource PinkColor}" BlurRadius="20" Opacity="0.4"/>
                    </TextBlock.Effect>
                </TextBlock>
                <TextBlock x:Name="TxtLoadingFlavor" Foreground="#606080" FontSize="19" HorizontalAlignment="Center" Margin="0,12,0,0"/>
            </StackPanel>
        </Grid>

        <!-- ============ QUESTION PANEL ============ -->
        <Grid x:Name="QuestionPanel" IsVisible="False">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top bar: progress dots + score -->
            <StackPanel Grid.Row="0" Margin="40,16,40,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Progress dots -->
                    <StackPanel x:Name="ProgressDotsPanel" Orientation="Horizontal" VerticalAlignment="Center"/>

                    <!-- Score -->
                    <TextBlock x:Name="ScoreText" Grid.Column="1" FontSize="28" FontWeight="Bold"
                               Foreground="{DynamicResource PinkBrush}" VerticalAlignment="Center"
                               RenderTransformOrigin="50%,50%">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="{StaticResource PinkColor}" BlurRadius="15" Opacity="0.4"/>
                        </TextBlock.Effect>
                    </TextBlock>
                </Grid>

                <!-- CCBill AI Addendum: AI-generated content disclaimer under the progress bar. -->
                <TextBlock Text="{loc:Str quiz_ai_disclaimer}"
                           FontSize="11"
                           FontStyle="Italic"
                           Foreground="#808090"
                           TextWrapping="Wrap"
                           Margin="0,6,0,0"
                           HorizontalAlignment="Left"/>
            </StackPanel>

            <!-- Scrollable question + answers -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        MaxWidth="600" Margin="40,8,40,24">

                <!-- Question text -->
                <Grid Margin="0,0,0,18">
                    <Grid x:Name="QuestionContentGrid" RenderTransformOrigin="50%,50%">
                        <TextBlock x:Name="TxtQuestion" FontSize="32" FontWeight="Bold"
                                   Foreground="White" TextWrapping="Wrap" TextAlignment="Center">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="#9966CC" BlurRadius="20" Opacity="0.3"/>
                            </TextBlock.Effect>
                        </TextBlock>
                    </Grid>
                </Grid>

                <!-- Answer buttons -->
                <StackPanel x:Name="AnswersPanel">
                    <Border x:Name="AnswerA" Cursor="Hand" CornerRadius="10" Margin="0,0,0,10" Padding="20,16"
                            Tag="0" Background="#15FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="A" FontWeight="Bold" FontSize="20" Foreground="{DynamicResource PinkBrush}"
                                       VerticalAlignment="Center" Margin="0,0,16,0"/>
                            <TextBlock x:Name="TxtAnswerA" Grid.Column="1" FontSize="18" Foreground="#D0D0E0"
                                       TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <Border x:Name="AnswerB" Cursor="Hand" CornerRadius="10" Margin="0,0,0,10" Padding="20,16"
                            Tag="1" Background="#15FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="B" FontWeight="Bold" FontSize="20" Foreground="{DynamicResource PinkBrush}"
                                       VerticalAlignment="Center" Margin="0,0,16,0"/>
                            <TextBlock x:Name="TxtAnswerB" Grid.Column="1" FontSize="18" Foreground="#D0D0E0"
                                       TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <Border x:Name="AnswerC" Cursor="Hand" CornerRadius="10" Margin="0,0,0,10" Padding="20,16"
                            Tag="2" Background="#15FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="C" FontWeight="Bold" FontSize="20" Foreground="{DynamicResource PinkBrush}"
                                       VerticalAlignment="Center" Margin="0,0,16,0"/>
                            <TextBlock x:Name="TxtAnswerC" Grid.Column="1" FontSize="18" Foreground="#D0D0E0"
                                       TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <Border x:Name="AnswerD" Cursor="Hand" CornerRadius="10" Margin="0,0,0,10" Padding="20,16"
                            Tag="3" Background="#15FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="D" FontWeight="Bold" FontSize="20" Foreground="{DynamicResource PinkBrush}"
                                       VerticalAlignment="Center" Margin="0,0,16,0"/>
                            <TextBlock x:Name="TxtAnswerD" Grid.Column="1" FontSize="18" Foreground="#D0D0E0"
                                       TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ============ RESULT PANEL ============ -->
        <Grid x:Name="ResultPanel" IsVisible="False">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            MaxWidth="600" Margin="40">
                    <!-- Score header -->
                    <TextBlock Text="{loc:Str label_your_result}" FontSize="24" FontWeight="Bold"
                               Foreground="#808090" HorizontalAlignment="Center" Margin="0,0,0,8"/>

                    <TextBlock x:Name="TxtFinalScore" FontSize="67" FontWeight="Bold"
                               Foreground="{DynamicResource PinkBrush}" HorizontalAlignment="Center" Margin="0,0,0,4">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="{StaticResource PinkColor}" BlurRadius="30" Opacity="0.5"/>
                        </TextBlock.Effect>
                    </TextBlock>

                    <TextBlock x:Name="TxtScoreLabel" FontSize="19" Foreground="#606080"
                               HorizontalAlignment="Center" Margin="0,0,0,30"/>

                    <!-- Profile card -->
                    <Border CornerRadius="14" Padding="24,20" Margin="0,0,0,30"
                            Background="#12FFFFFF" BorderThickness="1">
                        <Border.BorderBrush>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                <GradientStop Color="#40FF69B4" Offset="0"/>
                                <GradientStop Color="#409B59B6" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.BorderBrush>
                        <TextBlock x:Name="TxtProfileText" FontSize="22" Foreground="#C0C0D8"
                                   TextWrapping="Wrap" LineHeight="34" TextAlignment="Center"/>
                    </Border>

                    <!-- Quiz Session -->
                    <Border x:Name="BtnTrySession" Cursor="Hand" CornerRadius="10" Padding="20,16"
                            Margin="0,0,0,20" IsHitTestVisible="False" Opacity="0.5"
                            Background="#209B59B6" BorderBrush="#409B59B6" BorderThickness="1.5">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock x:Name="TxtTrySessionIcon" FontSize="22"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock x:Name="TxtTrySessionLabel" Foreground="#C0C0D8" FontSize="18" FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Score Trend -->
                    <TextBlock x:Name="TxtTrendHeader" Text="{loc:Str label_your_journey}" FontSize="14" FontWeight="Bold"
                               Foreground="#606080" HorizontalAlignment="Center" Margin="0,0,0,10"
                               IsVisible="False"/>
                    <StackPanel x:Name="TrendPanel" Margin="0,0,0,20"/>

                    <!-- Buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="BtnPlayAgain" Cursor="Hand" CornerRadius="10"
                                Background="{DynamicResource SecondaryBrush}" Foreground="White"
                                BorderThickness="0" Padding="28,14" Margin="0,0,12,0">
                            <TextBlock Text="{loc:Str btn_play_again}" FontWeight="Bold" FontSize="19"/>
                        </Button>
                        <Button x:Name="BtnCloseResult" Cursor="Hand" CornerRadius="10"
                                Background="#20FFFFFF" Foreground="#B0B0C8"
                                BorderThickness="1" BorderBrush="#40FFFFFF" Padding="28,14">
                            <TextBlock Text="{loc:Str btn_close}" FontWeight="Bold" FontSize="19"/>
                        </Button>
                    </StackPanel>

                    <!-- CCBill AI Addendum: AI-generated content disclaimer pinned at result screen bottom. -->
                    <TextBlock Text="{loc:Str quiz_ai_disclaimer}"
                               FontSize="11"
                               FontStyle="Italic"
                               Foreground="#808090"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="0,24,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ============ ERROR PANEL ============ -->
        <Grid x:Name="ErrorPanel" IsVisible="False">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="400">
                <TextBlock Text="{loc:Str label_oops}" FontSize="34" FontWeight="Bold" Foreground="#FF6B6B"
                           HorizontalAlignment="Center" Margin="0,0,0,12"/>
                <TextBlock x:Name="TxtError" FontSize="17" Foreground="#808090"
                           TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,24"/>
                <Button x:Name="BtnTryAgain" Cursor="Hand" CornerRadius="10"
                        Background="{DynamicResource SecondaryBrush}" Foreground="White"
                        BorderThickness="0" Padding="24,12" HorizontalAlignment="Center">
                    <TextBlock Text="{loc:Str btn_try_again}" FontWeight="Bold" FontSize="17"/>
                </Button>
                <TextBlock Text="{loc:Str label_press_esc_to_close}" Foreground="{DynamicResource PanelAccentBrush}" FontSize="13"
                           HorizontalAlignment="Center" Margin="0,16,0,0"/>
            </StackPanel>
        </Grid>

        </Grid>
    </Grid>
</Window>
