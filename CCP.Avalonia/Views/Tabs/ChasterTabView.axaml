<!-- PORTED (first read-only slice) from ConditioningControlPanel/Views/Tabs/ChasterTabView.xaml.
     ponytail: what is not here yet is listed in the code-behind header. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:ConditioningControlPanel.Avalonia.Localization"
             xmlns:fx="clr-namespace:ConditioningControlPanel.Avalonia.Controls"
             x:Class="ConditioningControlPanel.Avalonia.Views.Tabs.ChasterTabView">
    <UserControl.Resources>
        <ControlTheme x:Key="CirceCta" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentGradientBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Fredoka, Segoe UI"/>
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="56"/>
            <Setter Property="Padding" Value="28,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Bg" Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover /template/ Border#Bg"><Setter Property="Opacity" Value="0.92"/></Style>
            <Style Selector="^:disabled /template/ Border#Bg"><Setter Property="Opacity" Value="0.4"/></Style>
        </ControlTheme>
        <ControlTheme x:Key="CirceLink" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <ContentPresenter Content="{TemplateBinding Content}" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"/>
                </ControlTemplate>
            </Setter>
        </ControlTheme>
        <ControlTheme x:Key="CirceFact" TargetType="Border">
            <Setter Property="Background" Value="#14FFFFFF"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </ControlTheme>
        <!-- WPF ChasterTabView.xaml:134-188: a key, tinted by the tile's colour (WPF Fx Tint), a tick when on. -->
        <ControlTheme x:Key="CirceKey" TargetType="ToggleButton">
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextLightBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,12,12"/>
            <Setter Property="MinHeight" Value="76"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Panel>
                        <Border Name="Fill" Background="{TemplateBinding Background}" CornerRadius="16" Opacity="0"/>
                        <Border Name="Rim" Background="{DynamicResource SurfaceBgBrush}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="16" Opacity="0.55"/>
                        <Grid Margin="16,12" ColumnDefinitions="Auto,*">
                            <Path Name="Key" Width="42" Height="18" Stretch="Uniform" Opacity="0.7" Fill="{TemplateBinding BorderBrush}"
                                  VerticalAlignment="Center" Margin="0,0,12,0"
                                  Data="M 8,0 A 8,8 0 1 0 8,16 A 8,8 0 1 0 8,0 Z M 8,4.5 A 3.5,3.5 0 1 0 8,11.5 A 3.5,3.5 0 1 0 8,4.5 Z M 15,5.5 H 42 V 11 H 38.5 V 8.5 H 34.5 V 12.5 H 30.5 V 8.5 H 15 Z"/>
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center" Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"/>
                        </Grid>
                        <Border Name="Tick" Width="20" Height="20" CornerRadius="10" Opacity="0" Background="{TemplateBinding BorderBrush}"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0">
                            <TextBlock Text="&#x2713;" FontSize="11" FontWeight="Bold" Foreground="#FF14101E" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Panel>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover /template/ Border#Rim"><Setter Property="Opacity" Value="1"/></Style>
            <Style Selector="^:pointerover /template/ Path#Key"><Setter Property="Opacity" Value="1"/></Style>
            <Style Selector="^:checked /template/ Border#Rim">
                <Setter Property="Opacity" Value="1"/>
                <Setter Property="Background" Value="Transparent"/>
            </Style>
            <Style Selector="^:checked /template/ Border#Fill"><Setter Property="Opacity" Value="0.22"/></Style>
            <Style Selector="^:checked /template/ Path#Key"><Setter Property="Opacity" Value="1"/></Style>
            <Style Selector="^:checked /template/ Border#Tick"><Setter Property="Opacity" Value="1"/></Style>
        </ControlTheme>
        <!-- WPF ChasterTabView.xaml:34-72 -->
        <ControlTheme x:Key="CirceCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="20,16"/>
        </ControlTheme>
        <ControlTheme x:Key="CirceEyebrow" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </ControlTheme>
        <ControlTheme x:Key="CirceSub" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Opacity" Value="0.8"/>
            <Setter Property="Margin" Value="1,4,0,0"/>
        </ControlTheme>
        <ControlTheme x:Key="CirceFigure" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Fredoka, Segoe UI"/>
            <Setter Property="FontSize" Value="38"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextLightBrush}"/>
        </ControlTheme>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="26,22,26,20" MaxWidth="1080" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
            <!-- header: the name, and the account -->
            <Grid Grid.Row="0" Margin="4,0,4,14">
                <TextBlock Text="{loc:Str chaster_title}" FontFamily="Fredoka, Segoe UI" FontSize="28"
                           FontWeight="SemiBold" Foreground="{DynamicResource TextLightBrush}" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Border x:Name="AccountStrip" VerticalAlignment="Center" IsVisible="False" Margin="0,0,10,0"
                        Background="{DynamicResource SurfaceBgBrush}" BorderBrush="{DynamicResource GlassBorderBrush}"
                        BorderThickness="1.5" CornerRadius="19" Height="38" Padding="6,0,6,0"
                        ToolTip.Tip="{loc:Str chaster_account_strip_tip}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Whose account (WPF ChasterTabView.xaml:331): picture + username, letter + "Chaster" until they arrive. -->
                        <fx:ChasterAccountBadge x:Name="AccountBadge" AvatarSize="24" VerticalAlignment="Center"
                                                TextElement.FontFamily="Fredoka, Segoe UI" TextElement.FontSize="13" TextElement.FontWeight="Bold"
                                                TextElement.Foreground="{DynamicResource TextLightBrush}"/>
                        <TextBlock Text="{loc:Str chaster_account_linked}" FontSize="12" Margin="6,0,0,0" Foreground="#5FFFD0" VerticalAlignment="Center"/>
                        <Rectangle Width="1" Height="16" Fill="{DynamicResource GlassBorderBrush}" Margin="10,0" VerticalAlignment="Center"/>
                        <Button x:Name="BtnChasterSite" Theme="{StaticResource CirceLink}" VerticalAlignment="Center" Click="BtnChasterSite_Click">
                            <Border Height="26" CornerRadius="13" Padding="8,0,10,0" Background="#26FFFFFF" BorderBrush="#40FFFFFF" BorderThickness="1">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Canvas Width="10" Height="12" VerticalAlignment="Center" Margin="0,0,6,0">
                                        <Path Data="M2,5.5 L2,3.5 A3,3 0 0 1 8,3.5 L8,5.5" Stroke="#FF8FA3" StrokeThickness="1.4"/>
                                        <Rectangle Canvas.Top="5" Width="10" Height="7" RadiusX="1.5" RadiusY="1.5" Fill="#FF8FA3"/>
                                    </Canvas>
                                    <TextBlock x:Name="TxtAccountLock" FontSize="12" MaxWidth="170" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextLightBrush}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtAccountLeft" FontFamily="Consolas, Courier New" FontSize="12" FontWeight="Bold"
                                               Foreground="#FF8FA3" Margin="8,0,0,0" VerticalAlignment="Center" IsVisible="False"/>
                                    <TextBlock Text="&#x2197;" FontSize="12" Margin="7,0,0,0" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Button>
                        <Border BorderBrush="#99FF6B8A" BorderThickness="1" CornerRadius="13" Height="26" Margin="10,0,0,0" VerticalAlignment="Center">
                            <Button x:Name="BtnAccountUnlink" Theme="{StaticResource CirceLink}" Padding="10,2" VerticalAlignment="Center" Click="BtnUnlink_Click">
                                <TextBlock Text="{loc:Str chaster_unlink}" Foreground="#FF8FA3" FontWeight="SemiBold"/>
                            </Button>
                        </Border>
                    </StackPanel>
                </Border>
                <!-- Pause: nothing books, nothing is pushed, until it is pressed again. -->
                <Border x:Name="PausePill" VerticalAlignment="Center" IsVisible="False" Margin="0,0,10,0"
                        Background="{DynamicResource SurfaceBgBrush}" BorderBrush="{DynamicResource GlassBorderBrush}"
                        BorderThickness="1.5" CornerRadius="19" Height="38">
                    <Button x:Name="BtnPause" Theme="{StaticResource CirceLink}" Padding="14,0" VerticalAlignment="Stretch" Click="BtnPause_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Canvas Width="10" Height="12" VerticalAlignment="Center" Margin="0,0,7,0">
                                <Rectangle x:Name="PauseBarA" Width="3" Height="12" RadiusX="1" RadiusY="1" Fill="{DynamicResource TextLightBrush}"/>
                                <Rectangle x:Name="PauseBarB" Canvas.Left="7" Width="3" Height="12" RadiusX="1" RadiusY="1" Fill="{DynamicResource TextLightBrush}"/>
                                <Path x:Name="PlayArrow" Data="M0,0 L10,6 L0,12 Z" Fill="#E0B052" IsVisible="False"/>
                            </Canvas>
                            <TextBlock x:Name="TxtPause" FontFamily="Fredoka, Segoe UI" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Border>
                <!-- The master switch as a glass pill. Its rim takes the tab's red while it runs. -->
                <Border x:Name="SwitchPill" VerticalAlignment="Center" IsVisible="False"
                        Background="{DynamicResource SurfaceBgBrush}" BorderBrush="{DynamicResource GlassBorderBrush}"
                        BorderThickness="1.5" CornerRadius="19" Height="38" Padding="16,0,6,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{loc:Str chaster_tab_switch}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextLightBrush}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtSwitchState" FontFamily="Fredoka, Segoe UI" FontSize="13" FontWeight="Bold"
                                   Margin="8,0,10,0" VerticalAlignment="Center"/>
                        <CheckBox x:Name="ChkTab" Theme="{StaticResource ToggleStyle}" VerticalAlignment="Center"
                                  IsCheckedChanged="ChkTab_Changed"/>
                    </StackPanel>
                </Border>
                </StackPanel>
            </Grid>

            <!-- 1. THE LOCK -->
            <Border Grid.Row="1" Background="{DynamicResource SurfaceBgBrush}" BorderBrush="{DynamicResource PanelAccentBrush}"
                    BorderThickness="1" CornerRadius="18" MinHeight="368" Margin="0,0,0,10">
                <StackPanel Margin="26,14,26,14" VerticalAlignment="Center">
                    <TextBlock x:Name="HeroTitle" Text="{loc:Str chaster_hero_title}" FontFamily="Fredoka, Segoe UI" FontSize="88"
                               FontWeight="Bold" Foreground="#FF7AC0" HorizontalAlignment="Center" IsVisible="False"/>
                    <!-- under it: the calendar, one square a day, and the countdown beside it (WPF :505-560) -->
                    <Grid x:Name="HeroLower" ColumnDefinitions="Auto,*">
                    <Panel x:Name="CalendarRow" IsVisible="False" VerticalAlignment="Top" Margin="0,2,18,0">
                        <!-- a torn-off wall-calendar sheet, pinned a little crooked -->
                        <StackPanel x:Name="Sheet" Margin="0,0,0,6" RenderTransform="rotate(-1.5deg)">
                            <Path Fill="#FFF3EAD9" Stretch="Fill" Height="9" Margin="0,0,0,-1"
                                  Data="M 0,9 L 0,5 L 6,2 L 12,6 L 18,1 L 25,5 L 31,2 L 38,6 L 44,0 L 51,5 L 57,2 L 64,6 L 70,1 L 77,5 L 83,3 L 90,6 L 96,1 L 100,4 L 100,9 Z"/>
                            <Border Background="#FFF3EAD9" Padding="10,12,10,10">
                                <Border BorderBrush="#38241A2E" BorderThickness="1,1,0,0" HorizontalAlignment="Left">
                                    <UniformGrid x:Name="Calendar" Columns="8" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                </Border>
                            </Border>
                        </StackPanel>
                        <Ellipse Width="9" Height="9" Fill="#FF1A1230" Stroke="#66241A2E" StrokeThickness="1"
                                 HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,8,0,0"/>
                        <Ellipse Width="11" Height="11" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="2,3,0,0"
                                 Stroke="#FF8A1830" StrokeThickness="1" Fill="#FFC8244A"/>
                    </Panel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Top">
                    <StackPanel x:Name="HeroClockRow" Orientation="Horizontal" IsVisible="False">
                        <StackPanel x:Name="HeroClock" Orientation="Horizontal"/>
                        <TextBlock Text="{loc:Str chaster_lock_lead}" FontSize="13" VerticalAlignment="Bottom"
                                   Margin="12,0,0,12" Foreground="{DynamicResource TextMutedBrush}"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtHeroEnds" FontSize="13" Margin="0,2,0,0" IsVisible="False" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock x:Name="SetupHint" IsVisible="False" FontSize="16" FontWeight="SemiBold" Foreground="White"
                               TextWrapping="Wrap" MaxWidth="480" HorizontalAlignment="Left" Margin="0,8,0,12"/>
                    <WrapPanel x:Name="HeroPills" Margin="0,10,0,0"/>
                    <TextBlock x:Name="TxtMood" FontFamily="Fredoka, Segoe UI" FontSize="14" FontWeight="Bold" Margin="0,4,0,0" IsVisible="False"/>
                    <StackPanel x:Name="LockRow" Orientation="Horizontal" Margin="0,8,0,0" IsVisible="False">
                        <ComboBox x:Name="CmbLock" FontSize="16" MinWidth="260" SelectionChanged="CmbLock_SelectionChanged"/>
                        <Button x:Name="BtnUseLock" Theme="{StaticResource CirceCta}" Padding="20,0" Height="48" Background="#E0B052"
                                Click="BtnUseLock_Click">
                            <TextBlock x:Name="TxtUseLock" FontSize="16" FontWeight="Bold" Foreground="#21152E"/>
                        </Button>
                    </StackPanel>
                    </StackPanel>
                    </Grid>

                    <!-- NOT LINKED: the same hero, one ask. -->
                    <StackPanel x:Name="UnlinkedPanel" IsVisible="False">
                        <TextBlock Text="{loc:Str chaster_intro_1}" TextWrapping="Wrap" FontSize="14" MaxWidth="460" HorizontalAlignment="Left"
                                   LineHeight="21" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,18"/>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="BtnLink" Theme="{StaticResource CirceCta}" MinWidth="220" Click="BtnLink_Click"
                                    ToolTip.Tip="{loc:Str chaster_link_test_hint}">
                                <TextBlock Text="{loc:Str chaster_link}"/>
                            </Button>
                            <StackPanel x:Name="LinkingRow" Orientation="Horizontal" IsVisible="False" Margin="16,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{loc:Str chaster_linking}" VerticalAlignment="Center" FontSize="13"
                                           Foreground="{DynamicResource TextLightBrush}" Margin="0,0,10,0"/>
                                <Button Theme="{StaticResource CirceLink}" Click="BtnCancelLink_Click">
                                    <TextBlock Text="{loc:Str chaster_cancel}" Foreground="{DynamicResource TextLightBrush}" TextDecorations="Underline"/>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="{loc:Str chaster_link_browser_hint}" TextWrapping="Wrap" FontSize="11" MaxWidth="460"
                                   HorizontalAlignment="Left" Foreground="{DynamicResource TextMutedBrush}" Margin="2,10,0,0"/>
                        <TextBlock x:Name="TxtLinkNote" IsVisible="False" TextWrapping="Wrap" FontSize="12" Foreground="#FFC98A" Margin="2,8,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- The first switch-on, and only the first: four facts, one button. -->
            <Border x:Name="ConsentCard" Grid.Row="2" IsVisible="False" Background="{DynamicResource SurfaceBgBrush}"
                    BorderBrush="#FF6B8A" BorderThickness="1.5" CornerRadius="18" Padding="22,18" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{loc:Str chaster_consent_title}" FontFamily="Fredoka, Segoe UI" FontSize="18"
                               FontWeight="SemiBold" Foreground="{DynamicResource TextLightBrush}" Margin="0,0,0,12"/>
                    <UniformGrid Columns="4" Margin="0,0,-10,0">
                        <Border Theme="{StaticResource CirceFact}">
                            <StackPanel>
                                <TextBlock x:Name="TxtFactCap2" Text="3:00:00" FontFamily="Fredoka, Segoe UI" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextLightBrush}"/>
                                <TextBlock Text="{loc:Str chaster_fact_cap}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Theme="{StaticResource CirceFact}">
                            <StackPanel>
                                <TextBlock Text="&#x21BA;" FontFamily="Fredoka, Segoe UI" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextLightBrush}"/>
                                <TextBlock Text="{loc:Str chaster_fact_floor}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Theme="{StaticResource CirceFact}">
                            <StackPanel>
                                <TextBlock Text="PANIC" FontFamily="Fredoka, Segoe UI" FontSize="22" FontWeight="Bold" Foreground="#FF6B8A"/>
                                <TextBlock Text="{loc:Str chaster_fact_panic}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Theme="{StaticResource CirceFact}">
                            <StackPanel>
                                <TextBlock Text="LIVE" FontFamily="Fredoka, Segoe UI" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextLightBrush}"/>
                                <TextBlock Text="{loc:Str chaster_fact_push}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                    <Button x:Name="BtnConsentOk" Theme="{StaticResource CirceCta}" HorizontalAlignment="Left" Height="46"
                            Margin="0,14,0,0" Click="BtnConsentOk_Click">
                        <TextBlock Text="{loc:Str chaster_consent_ok}" FontSize="16"/>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Unlinked: three facts, no paragraphs. -->
            <UniformGrid x:Name="FactRow" Grid.Row="2" Columns="3" IsVisible="False" Margin="0,4,-10,0">
                <Border Theme="{StaticResource CirceFact}">
                    <StackPanel>
                        <TextBlock x:Name="TxtFactCap1" Text="3:00:00" FontFamily="Fredoka, Segoe UI" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextLightBrush}"/>
                        <TextBlock Text="{loc:Str chaster_fact_cap}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>
                <Border Theme="{StaticResource CirceFact}">
                    <StackPanel>
                        <TextBlock Text="&#x21BA;" FontFamily="Fredoka, Segoe UI" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextLightBrush}"/>
                        <TextBlock Text="{loc:Str chaster_fact_floor}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>
                <Border Theme="{StaticResource CirceFact}">
                    <StackPanel>
                        <TextBlock Text="PANIC" FontFamily="Fredoka, Segoe UI" FontSize="22" FontWeight="Bold" Foreground="#FF6B8A"/>
                        <TextBlock Text="{loc:Str chaster_fact_panic}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- 3. THREE NUMBERS and the receipt under them (WPF ChasterTabView.xaml:641-687, linked only). Code in ChasterTabView.Numbers.cs. -->
            <StackPanel x:Name="NumbersPanel" Grid.Row="3" Margin="0,14,0,0" IsVisible="False">
                <UniformGrid Columns="3" Margin="0,0,-12,14">
                    <Border x:Name="StatTab" Theme="{StaticResource CirceCard}" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock x:Name="TxtBalance" Text="0:00" Theme="{StaticResource CirceFigure}"/>
                            <TextBlock x:Name="TxtBalanceCaption" Theme="{StaticResource CirceEyebrow}" Margin="1,2,0,0"/>
                            <TextBlock Text="{loc:Str chaster_stat_tab_sub}" Theme="{StaticResource CirceSub}"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="StatToday" Theme="{StaticResource CirceCard}" Margin="0,0,12,0" ToolTip.Tip="{loc:Str chaster_settle_line}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="TxtToday" Text="0:00" Theme="{StaticResource CirceFigure}"/>
                                <TextBlock x:Name="TxtTodayCap" Text="/ 60:00" FontFamily="Fredoka, Segoe UI" FontSize="15"
                                           Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Bottom" Margin="8,0,0,8"/>
                            </StackPanel>
                            <TextBlock Text="{loc:Str chaster_stat_today}" Theme="{StaticResource CirceEyebrow}" Margin="1,2,0,0"/>
                            <TextBlock x:Name="TxtTodaySub" Theme="{StaticResource CirceSub}"/>
                            <Panel x:Name="CapTrack" Height="6" Margin="0,10,0,0">
                                <Border Background="#22FFFFFF" CornerRadius="3"/>
                                <Border x:Name="CapFill" Width="0" HorizontalAlignment="Left" CornerRadius="3" Background="#FF6B8A"/>
                            </Panel>
                        </StackPanel>
                    </Border>
                    <!-- Click: the bill on paper. -->
                    <Border x:Name="StatRun" Theme="{StaticResource CirceCard}" Margin="0,0,12,0" Cursor="Hand" Background="{DynamicResource SurfaceBgBrush}">
                        <Panel>
                            <StackPanel>
                                <TextBlock x:Name="TxtRun" Text="0:00" Theme="{StaticResource CirceFigure}"/>
                                <TextBlock Text="{loc:Str chaster_stat_run}" Theme="{StaticResource CirceEyebrow}" Margin="1,2,0,0"/>
                                <TextBlock Text="{loc:Str chaster_stat_run_sub}" Theme="{StaticResource CirceSub}"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtRunChevron" Text="&#x25BE;" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Top"
                                       Foreground="{DynamicResource TextMutedBrush}"/>
                        </Panel>
                    </Border>
                </UniformGrid>
                <Border x:Name="ReceiptHost" IsVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top" ClipToBounds="True">
                    <fx:ChasterReceiptView x:Name="Receipt" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                </Border>
            </StackPanel>

            <!-- THE HEADS-UP CLOCK and the pinned ladder scrap (WPF ChasterTabView.xaml:689-806, linked only).
                 Hover the clock (click to pin) and the raffle card unrolls under it. Code in ChasterTabView.Ladder.cs. -->
            <Grid x:Name="AddedRow" Grid.Row="4" ColumnDefinitions="*,Auto" Margin="0,14,0,14" IsVisible="False">
                <!-- the scrap: the calendar's paper, torn top, a red pin through a punched hole, tilted -->
                <Panel x:Name="LadderScrap" Grid.Column="1" Width="236" Margin="18,2,6,4" VerticalAlignment="Top"
                       RenderTransformOrigin="50%,0%" PointerEntered="LadderScrap_PointerEntered">
                    <StackPanel>
                        <StackPanel.Effect>
                            <DropShadowEffect Color="#000000" BlurRadius="14" OffsetX="0" OffsetY="4" Opacity="0.45"/>
                        </StackPanel.Effect>
                        <Path Fill="#FFF3EAD9" Stretch="Fill" Height="9" Margin="0,0,0,-1"
                              Data="M 0,9 L 0,4 L 7,1 L 13,5 L 20,2 L 26,6 L 33,1 L 39,4 L 46,0 L 52,5 L 59,2 L 66,6 L 72,2 L 79,5 L 85,1 L 92,5 L 100,3 L 100,9 Z"/>
                        <Border Background="#FFF3EAD9" Padding="12,14,12,10">
                            <StackPanel>
                                <TextBlock Text="{loc:Str chaster_ladder_title}" FontFamily="Fredoka, Segoe UI" FontSize="15" FontWeight="SemiBold" Foreground="#FF241A2E"/>
                                <Border BorderBrush="#CCC8244A" BorderThickness="1.5" CornerRadius="3" Padding="6,1,6,1" HorizontalAlignment="Left" Margin="1,4,0,8">
                                    <Border.RenderTransform><RotateTransform Angle="-4"/></Border.RenderTransform>
                                    <TextBlock Text="{loc:Str chaster_ladder_brag}" FontFamily="Consolas, Courier New" FontSize="10" FontWeight="Bold" Foreground="#CCC8244A"/>
                                </Border>
                                <StackPanel x:Name="LadderScrapRows"/>
                                <TextBlock x:Name="TxtLadderScrapState" FontSize="12" FontStyle="Italic" Foreground="#99241A2E" TextWrapping="Wrap" Margin="0,2,0,2" IsVisible="False"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <Ellipse Width="9" Height="9" Fill="#FF1A1230" Stroke="#66241A2E" StrokeThickness="1" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,8,0,0"/>
                    <Ellipse Width="11" Height="11" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="2,3,0,0" Stroke="#FF8A1830" StrokeThickness="1">
                        <Ellipse.Fill>
                            <RadialGradientBrush GradientOrigin="35%,30%">
                                <GradientStop Color="#FFFF8FA8" Offset="0"/>
                                <GradientStop Color="#FFC8244A" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                </Panel>
                <!-- WPF :747: column 0 stacks the clock card and, under it beside the scrap, 4. THE KEYS (2x2 presets).
                     The keys' code is ChasterTabView.Keys.cs. -->
                <StackPanel Grid.Column="0" VerticalAlignment="Top">
                <Border x:Name="AddedCard" VerticalAlignment="Top" Background="{DynamicResource SurfaceBgBrush}"
                        BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1" CornerRadius="18" Padding="20,16">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Border x:Name="AddedClock" Cursor="Hand" Background="#22FF6B8A" BorderBrush="#88FF6B8A" BorderThickness="1.5"
                                CornerRadius="14" Padding="14,6,12,6" VerticalAlignment="Center" ToolTip.Tip="{loc:Str chaster_added_hint}"
                                PointerEntered="AddedClock_PointerEntered" PointerExited="AddedClock_PointerExited" PointerReleased="AddedClock_PointerReleased">
                            <StackPanel Orientation="Horizontal">
                                <!-- a stopwatch: ring, crown, one hand the code turns -->
                                <Panel Width="26" Height="30" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <Rectangle Width="8" Height="4" RadiusX="1.5" RadiusY="1.5" Fill="#FFFF6B8A" VerticalAlignment="Top" HorizontalAlignment="Center"/>
                                    <Ellipse Width="24" Height="24" Stroke="#FFFF6B8A" StrokeThickness="2.5" VerticalAlignment="Bottom"/>
                                    <Rectangle Width="2.5" Height="9" RadiusX="1" RadiusY="1" Fill="#FFFFC0CB" VerticalAlignment="Bottom"
                                               HorizontalAlignment="Center" Margin="0,0,0,12" RenderTransformOrigin="50%,100%" x:Name="AddedClockHandBar"/>
                                </Panel>
                                <TextBlock x:Name="TxtAddedClock" Text="0:00:00" FontFamily="Consolas, Courier New" FontSize="30" FontWeight="Bold"
                                           Foreground="#FFFF6B8A" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtAddedChevron" Text="&#x25BE;" FontSize="14" Margin="10,0,0,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextMutedBrush}"/>
                            </StackPanel>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="16,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Str chaster_added_title}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock x:Name="TxtAddedMonth" FontFamily="Fredoka, Segoe UI" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextLightBrush}" Margin="0,2,0,0"/>
                            <TextBlock Text="{loc:Str chaster_added_note}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Opacity="0.8" Margin="1,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Grid Grid.Column="2" VerticalAlignment="Center" RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,Auto">
                            <TextBlock Text="{loc:Str chaster_raffle_post_days}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" HorizontalAlignment="Right"
                                       Foreground="{DynamicResource TextSecondaryBrush}" ToolTip.Tip="{loc:Str chaster_raffle_post_days_tip}"/>
                            <CheckBox x:Name="ChkRafflePost" Grid.Column="1" Theme="{StaticResource ToggleStyle}" VerticalAlignment="Center"
                                      ToolTip.Tip="{loc:Str chaster_raffle_post_days_tip}" IsCheckedChanged="ChkRafflePost_Changed"/>
                            <TextBlock Grid.Row="1" Text="{loc:Str chaster_ladder_show_name}" FontSize="12" VerticalAlignment="Center" Margin="0,8,8,0" HorizontalAlignment="Right"
                                       Foreground="{DynamicResource TextSecondaryBrush}" ToolTip.Tip="{loc:Str chaster_ladder_show_name_tip}"/>
                            <CheckBox x:Name="ChkLadderName" Grid.Row="1" Grid.Column="1" Theme="{StaticResource ToggleStyle}" VerticalAlignment="Center" Margin="0,8,0,0"
                                      ToolTip.Tip="{loc:Str chaster_ladder_show_name_tip}" IsCheckedChanged="ChkLadderName_Changed"/>
                        </Grid>
                    </Grid>
                </Border>
                <StackPanel x:Name="KeysSlot">
                    <TextBlock Text="{loc:Str chaster_keys_eyebrow}" Theme="{StaticResource CirceEyebrow}" Margin="4,14,0,2"/>
                    <TextBlock Text="{loc:Str chaster_keys_explain}" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="4,0,0,8"/>
                    <UniformGrid x:Name="PresetRow" Columns="2" Rows="2" Margin="0,0,-12,-12">
                        <ToggleButton x:Name="BtnPresetGentle" Theme="{StaticResource CirceKey}" Tag="gentle" Background="#5FFFD0" BorderBrush="#5FFFD0"
                                      ToolTip.Tip="{loc:Str chaster_preset_gentle_hint}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{loc:Str chaster_preset_gentle}" FontFamily="Fredoka, Segoe UI" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TxtStakesGentle" FontFamily="Fredoka, Segoe UI" FontSize="12" Opacity="0.7" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton x:Name="BtnPresetStrict" Theme="{StaticResource CirceKey}" Tag="strict" Background="#FF6B8A" BorderBrush="#FF6B8A"
                                      ToolTip.Tip="{loc:Str chaster_preset_strict_hint}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{loc:Str chaster_preset_strict}" FontFamily="Fredoka, Segoe UI" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TxtStakesStrict" FontFamily="Fredoka, Segoe UI" FontSize="12" Opacity="0.7" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton x:Name="BtnPresetCirce" Theme="{StaticResource CirceKey}" Tag="circe" Background="#E0B052" BorderBrush="#E0B052"
                                      ToolTip.Tip="{loc:Str chaster_preset_circe_hint}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{loc:Str chaster_preset_circe}" FontFamily="Fredoka, Segoe UI" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TxtStakesCirce" FontFamily="Fredoka, Segoe UI" FontSize="12" Opacity="0.7" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                        </ToggleButton>
                        <!-- The fourth key is the player's own mix: it lights whenever the boards match no preset, and pressing it changes nothing. -->
                        <ToggleButton x:Name="BtnPresetCustom" Theme="{StaticResource CirceKey}" Tag="custom" Background="#C9A6FF" BorderBrush="#C9A6FF"
                                      ToolTip.Tip="{loc:Str chaster_key_custom_hint}">
                            <TextBlock Text="{loc:Str chaster_preset_custom}" FontFamily="Fredoka, Segoe UI" FontSize="17" FontWeight="SemiBold"/>
                        </ToggleButton>
                    </UniformGrid>
                </StackPanel>
                </StackPanel>

                <!-- The player's own raffle card (WPF :1107-1150). Hover opens, click pins, outside click / deactivate closes. -->
                <Popup x:Name="LadderPopup" PlacementTarget="{Binding #AddedClock}" Placement="Bottom" VerticalOffset="8" IsLightDismissEnabled="False"
                       PointerEntered="LadderPopup_PointerEntered" PointerExited="LadderPopup_PointerExited">
                    <Border x:Name="LadderCard" Width="360" Background="#F7201636" BorderBrush="#88FF6B8A" BorderThickness="1.5"
                            CornerRadius="16" Padding="14,12,14,12" RenderTransformOrigin="50%,0%">
                        <StackPanel>
                            <Panel Margin="2,0,0,8">
                                <TextBlock Text="{loc:Str chaster_raffle_title}" FontFamily="Fredoka, Segoe UI" FontSize="17" FontWeight="SemiBold" Foreground="#FFF3EAF7"/>
                                <TextBlock x:Name="TxtRaffleDay" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="#FFC9B8D8"/>
                            </Panel>
                            <StackPanel x:Name="LadderRows">
                                <WrapPanel x:Name="RafflePips" Margin="0,0,0,10"/>
                                <Panel Margin="0,0,0,2">
                                    <TextBlock x:Name="TxtRaffleDays" FontSize="13" Foreground="#FFF3EAF7"/>
                                    <TextBlock x:Name="TxtRaffleTotal" HorizontalAlignment="Right" FontFamily="Consolas, Courier New" FontSize="13" FontWeight="Bold" Foreground="#FFFF6B8A"/>
                                </Panel>
                                <Border x:Name="RaffleStatusChip" CornerRadius="10" Padding="10,5,10,5" Margin="0,8,0,0" HorizontalAlignment="Left">
                                    <TextBlock x:Name="TxtRaffleStatus" FontFamily="Fredoka, Segoe UI" FontSize="14" FontWeight="SemiBold"/>
                                </Border>
                                <TextBlock x:Name="TxtRaffleTicketOn" FontSize="12" Foreground="#FFC9B8D8" Margin="2,4,0,0" IsVisible="False"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtLadderState" FontSize="12" Foreground="#FFC9B8D8" Margin="2,6,0,0" TextWrapping="Wrap" IsVisible="False"/>
                            <TextBlock Text="{loc:Str chaster_added_note}" FontSize="11" Foreground="#FFA898B8" Margin="2,10,0,0" TextWrapping="Wrap"/>
                            <Panel Margin="2,2,0,0">
                                <TextBlock Text="{loc:Str chaster_raffle_rule}" FontSize="11" Foreground="#FFA898B8" TextWrapping="Wrap" Margin="0,0,48,0"/>
                                <Button x:Name="LnkRaffleRules" Theme="{StaticResource CirceLink}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Click="LnkRaffleRules_Click">
                                    <TextBlock Text="{loc:Str chaster_raffle_rules}" FontSize="11" Foreground="#FFFF9BB0" TextDecorations="Underline"/>
                                </Button>
                            </Panel>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
