<!-- PORTED from WPF 7.1.5 ConditioningControlPanel/Views/Tabs/AvailableSubjectsTabView.xaml: THE LOBBY
     (2026-10-02). Was the Available Subjects directory; the tab key, rail entry and palette row
     stay "availablesubjects". Three lists by state SIDE BY SIDE: Open (Join) | Playing (no button
     until a game can be watched) | Friends. Each column scrolls on its own. Under ~900 px of
     content width the columns become a three-tab switcher (SetNarrow). Rows come from the Core
     LobbyService (MainShellWindow.RegisterSocialTabs.cs); the look is the launcher's: glass
     cards with a rim light, Fredoka figures, hover lift + sheen, press travel.

     Deviations, all forced by WPF/Avalonia differences:
       Style x:Key TargetType=Button   ->  ControlTheme with a Template (trap 4) and a presenter
                                           bound to Content (trap 6)
       ControlTemplate.Triggers        ->  ^:pointerover / ^:pressed nested selectors
       DataTemplate.Triggers           ->  Grid.lobbyCard:pointerover styles
       Content="{loc:Str}" on Button   ->  set from code (Loc + lock glyph), or a TextBlock child
       BoolToVisibility                ->  IsVisible="{Binding Friend}"
       ImageBrush ImageSource=Art      ->  the row's Art bitmap (ModArt, decoded at 96 px)
       FxGlowColor/FxParticleColor     ->  PinkColor / NeonPurpleColor (this head has no Fx colour
                                           resources, only brushes)
       MouseEnter/Leave HoverLift      ->  a :pointerover translate on the card -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:fx="clr-namespace:ConditioningControlPanel.Avalonia.Controls"
             xmlns:loc="clr-namespace:ConditioningControlPanel.Avalonia.Localization"
             xmlns:tabs="clr-namespace:ConditioningControlPanel.Avalonia.Views.Tabs"
             x:Class="ConditioningControlPanel.Avalonia.Views.Tabs.AvailableSubjectsTabView"
             mc:Ignorable="d"
             d:DesignHeight="640" d:DesignWidth="1100">

    <UserControl.Resources>
        <LinearGradientBrush x:Key="LobbyRim" StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Color="#55FFFFFF" Offset="0"/>
            <GradientStop Color="#14FFFFFF" Offset="0.5"/>
            <GradientStop Color="#0AFFFFFF" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="LobbyGlass" StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Color="#24FFFFFF" Offset="0"/>
            <GradientStop Color="#0CFFFFFF" Offset="1"/>
        </LinearGradientBrush>

        <ControlTheme x:Key="LobbyPill" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource LobbyGlass}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LobbyRim}"/>
            <Setter Property="FontFamily" Value="Fredoka, Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Margin" Value="0,0,10,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="root">
                        <Border CornerRadius="18" BorderThickness="1" Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border x:Name="sheen" CornerRadius="18" Opacity="0" IsHitTestVisible="False" Background="#1FFF5FA2"/>
                    </Grid>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover /template/ Border#sheen">
                <Setter Property="Opacity" Value="1"/>
            </Style>
            <Style Selector="^:pressed /template/ Grid#root">
                <Setter Property="RenderTransform" Value="translate(0px, 2px)"/>
            </Style>
        </ControlTheme>

        <ControlTheme x:Key="LobbyJoin" TargetType="Button">
            <Setter Property="Foreground" Value="#2A0618"/>
            <Setter Property="FontFamily" Value="Fredoka, Segoe UI"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="15,5,15,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <!-- the key's base: the face travels down onto it when pressed -->
                        <Border CornerRadius="13" Background="#B23A6B" Margin="0,3,0,0"/>
                        <Border x:Name="face" CornerRadius="13" Margin="0,0,0,3" BorderThickness="1"
                                BorderBrush="{DynamicResource DepthRaisedBevel}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                    <GradientStop Color="#FF8CC0" Offset="0"/>
                                    <GradientStop Color="#FF5FA2" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <!-- the raised sheen: lit from the top like every plank -->
                            <Border CornerRadius="12" Padding="{TemplateBinding Padding}"
                                    Background="{DynamicResource DepthRaisedSheen}">
                                <ContentPresenter Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover /template/ Border#face">
                <Setter Property="Opacity" Value="0.92"/>
            </Style>
            <Style Selector="^:pressed /template/ Border#face">
                <Setter Property="RenderTransform" Value="translate(0px, 3px)"/>
            </Style>
        </ControlTheme>

        <!-- The three columns are WELLS (the well floor under a sunken 1 px rim). The rows inside
             float on them (LobbyRowTemplate), so the list reads as cards in a tray. -->
        <ControlTheme x:Key="LobbyColumn" TargetType="Border">
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="12,12,6,8"/>
            <Setter Property="Background" Value="{DynamicResource DepthWellFloorBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DepthPressedBevel}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </ControlTheme>

        <DataTemplate x:Key="LobbyRowTemplate" x:DataType="tabs:LobbyRowView">
            <Grid Classes="lobbyCard" Margin="0,0,6,8" Tag="lobby-card" RenderTransformOrigin="50%,50%">
                <!-- the pop ring a new table sends out (MotionFx-gated) -->
                <Border Tag="lobby-ring" CornerRadius="16" BorderThickness="2" BorderBrush="#FF8CC0"
                        Opacity="0" IsHitTestVisible="False" RenderTransformOrigin="50%,50%"/>
                <!-- the float band under the card: Social hue at FloatAlpha, in the row's own
                     8 px bottom margin, so the list pitch does not change -->
                <Rectangle Tag="lobby-float" Fill="{Binding CardShadow}" Height="{Binding CardShadowPx}"
                           RadiusX="7" RadiusY="7" VerticalAlignment="Bottom" Margin="8,0,8,-6" IsHitTestVisible="False"/>
                <Border Classes="lobbyCardFace" CornerRadius="14" Padding="10,9,10,9"
                        Background="{StaticResource LobbyGlass}" BorderBrush="{Binding CardRim}" BorderThickness="1">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Border Width="40" Height="40" CornerRadius="11" Margin="0,0,10,0" VerticalAlignment="Center"
                                BorderBrush="#40FFFFFF" BorderThickness="1" ClipToBounds="True"
                                Background="{Binding ArtBrush}"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextLightBrush}"
                                           FontFamily="Fredoka, Segoe UI" FontSize="15" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" MaxWidth="190"/>
                                <Ellipse Width="7" Height="7" Margin="7,1,0,0" VerticalAlignment="Center"
                                         Fill="#5FFFD0" ToolTip.Tip="{loc:Str lobby_friend_tip}"
                                         IsVisible="{Binding Friend}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Line}" Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Button Grid.Column="2" Theme="{StaticResource LobbyJoin}" MinWidth="64" Margin="8,0,0,0"
                                VerticalAlignment="Center" Tag="lobby-row-button"
                                Opacity="{Binding ButtonOpacity}" IsVisible="{Binding HasButton}"
                                Click="BtnLobbyRow_Click">
                            <TextBlock Text="{Binding ButtonText}"/>
                        </Button>
                    </Grid>
                </Border>
                <!-- hover sheen over the glass -->
                <Border Classes="lobbySheen" CornerRadius="14" IsHitTestVisible="False" Opacity="0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                            <GradientStop Color="#00FFFFFF" Offset="0.2"/>
                            <GradientStop Color="#1EFFFFFF" Offset="0.5"/>
                            <GradientStop Color="#00FFFFFF" Offset="0.8"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="TextBlock.lobbyHead">
            <Setter Property="FontFamily" Value="Fredoka, Segoe UI"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextLightBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.lobbyCount">
            <Setter Property="FontFamily" Value="Fredoka, Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#2A0618"/>
        </Style>
        <Style Selector="TextBlock.lobbyEmpty">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Margin" Value="4,6,6,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <!-- WPF LobbyCard_MouseEnter -> MotionFx.HoverLift + the DataTemplate's IsMouseOver trigger -->
        <Style Selector="Grid.lobbyCard">
            <Setter Property="RenderTransform" Value="translate(0px, 0px)"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.14"/>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.22"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Grid.lobbyCard:pointerover">
            <Setter Property="RenderTransform" Value="translate(0px, -2px)"/>
        </Style>
        <Style Selector="Grid.lobbyCard:pointerover Border.lobbySheen">
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="Grid.lobbyCard:pointerover Border.lobbyCardFace">
            <Setter Property="BorderBrush" Value="#66FF8CC0"/>
        </Style>
    </UserControl.Styles>

    <Grid>
        <!-- Backdrop, the launcher's recipe at page scale: a deep radial ground and two light pools. -->
        <Border IsHitTestVisible="False">
            <Border.Background>
                <RadialGradientBrush GradientOrigin="28%,10%" Center="28%,10%" RadiusX="90%" RadiusY="90%">
                    <GradientStop Color="#552C1450" Offset="0"/>
                    <GradientStop Color="#00100A1E" Offset="1"/>
                </RadialGradientBrush>
            </Border.Background>
        </Border>
        <Border IsHitTestVisible="False" Opacity="0.30">
            <Border.Background>
                <RadialGradientBrush GradientOrigin="82%,15%" Center="82%,15%" RadiusX="50%" RadiusY="50%">
                    <GradientStop Color="{DynamicResource PinkColor}" Offset="0"/>
                    <GradientStop Color="#00000000" Offset="1"/>
                </RadialGradientBrush>
            </Border.Background>
        </Border>
        <Border IsHitTestVisible="False" Opacity="0.18">
            <Border.Background>
                <RadialGradientBrush GradientOrigin="12%,90%" Center="12%,90%" RadiusX="45%" RadiusY="45%">
                    <GradientStop Color="{DynamicResource NeonPurpleColor}" Offset="0"/>
                    <GradientStop Color="#00000000" Offset="1"/>
                </RadialGradientBrush>
            </Border.Background>
        </Border>
        <!-- The tab's one looping FX (MainShellWindow.SubjectsFx registers it; parks on tab switch). -->
        <fx:AmbientFxCanvas x:Name="SubjectsAmbientFx"/>

        <Grid Margin="32,26,32,22" RowDefinitions="Auto,Auto,Auto,*">

            <!-- Header: the title and the live count -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                <TextBlock Text="{loc:Str tab_available_subjects}" FontFamily="Fredoka, Segoe UI" FontSize="26"
                           FontWeight="SemiBold" Foreground="{DynamicResource TextLightBrush}"/>
                <TextBlock x:Name="TxtLobbyCount" Foreground="{DynamicResource PinkSoftBrush}" FontFamily="Fredoka, Segoe UI"
                           FontSize="16" Margin="14,0,0,5" VerticalAlignment="Bottom"/>
            </StackPanel>

            <!-- Host bar. Locked pills stay visible with a lock; a click goes to the gate. -->
            <StackPanel Grid.Row="1">
                <WrapPanel Orientation="Horizontal">
                    <Button x:Name="BtnHostChess" Theme="{StaticResource LobbyPill}" Click="BtnHostChess_Click"/>
                    <Button x:Name="BtnHostGoon" Theme="{StaticResource LobbyPill}" Click="BtnHostGoon_Click"/>
                    <Button x:Name="BtnBecomeASubject" Theme="{StaticResource LobbyPill}"
                            ToolTip.Tip="{loc:Str desc_optin_directory_consent}" Click="BtnBecomeASubject_Click"/>
                </WrapPanel>
                <TextBlock x:Name="TxtBecomeASubjectSubtitle" Text="{loc:Str desc_become_a_subject_locked}"
                           Foreground="{DynamicResource TextDimBrush}" FontSize="11" Margin="4,0,0,4" IsVisible="False"/>
                <Border x:Name="AvailableSubjectsErrorPanel" IsVisible="False" Margin="0,6,0,0" Padding="14,8"
                        CornerRadius="12" Background="#14FFFFFF" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1">
                    <TextBlock Text="{loc:Str lobby_error}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13"/>
                </Border>
            </StackPanel>

            <!-- Narrow window: one column at a time behind three tabs. -->
            <StackPanel x:Name="LobbyTabStrip" Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0" IsVisible="False">
                <Button x:Name="TabOpen" Theme="{StaticResource LobbyPill}" Tag="0" Click="LobbyTab_Click"/>
                <Button x:Name="TabPlaying" Theme="{StaticResource LobbyPill}" Tag="1" Click="LobbyTab_Click"/>
                <Button x:Name="TabFriends" Theme="{StaticResource LobbyPill}" Tag="2" Click="LobbyTab_Click"/>
            </StackPanel>

            <!-- The three columns -->
            <Grid x:Name="LobbyColumns" Grid.Row="3" Margin="0,10,0,0" ColumnDefinitions="*,*,*">

                <!-- (1) Open -->
                <Border x:Name="LobbyOpenColumn" Grid.Column="0" Theme="{StaticResource LobbyColumn}" Margin="0,0,8,0">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,0,0,10">
                            <TextBlock Classes="lobbyHead" Text="{loc:Str lobby_list_open}"/>
                            <Border CornerRadius="10" Background="#FF5FA2" Padding="8,1,8,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="LobbyOpenCount" Classes="lobbyCount" Text="0"/>
                            </Border>
                        </StackPanel>
                        <Border x:Name="AvailableSubjectsEmptyPanel" DockPanel.Dock="Top" IsVisible="False">
                            <!-- Empty state: one line, then the host doors right under it. -->
                            <StackPanel>
                                <TextBlock x:Name="TxtLobbyEmpty" Classes="lobbyEmpty"/>
                                <WrapPanel x:Name="LobbyEmptyHostRow" HorizontalAlignment="Center" Margin="0,8,0,4">
                                    <Button x:Name="BtnEmptyHostChess" Theme="{StaticResource LobbyPill}" Click="BtnHostChess_Click"/>
                                    <Button x:Name="BtnEmptyHostGoon" Theme="{StaticResource LobbyPill}" Click="BtnHostGoon_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="AvailableSubjectsList" ItemTemplate="{StaticResource LobbyRowTemplate}"/>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- (2) Playing -->
                <Border x:Name="LobbyPlayingSection" Grid.Column="1" Theme="{StaticResource LobbyColumn}" Margin="4,0,4,0">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,0,0,10">
                            <TextBlock Classes="lobbyHead" Text="{loc:Str lobby_list_playing}"/>
                            <Border CornerRadius="10" Background="#B99CFF" Padding="8,1,8,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="LobbyPlayingCount" Classes="lobbyCount" Text="0"/>
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="LobbyPlayingEmpty" DockPanel.Dock="Top" Classes="lobbyEmpty" Text="{loc:Str lobby_empty_playing}"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="LobbyPlayingList" ItemTemplate="{StaticResource LobbyRowTemplate}"/>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- (3) Friends -->
                <Border x:Name="LobbyFriendsSection" Grid.Column="2" Theme="{StaticResource LobbyColumn}" Margin="8,0,0,0">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,0,0,10">
                            <TextBlock Classes="lobbyHead" Text="{loc:Str lobby_list_friends}"/>
                            <Border CornerRadius="10" Background="#5FFFD0" Padding="8,1,8,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="LobbyFriendsCount" Classes="lobbyCount" Text="0"/>
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="LobbyFriendsEmpty" DockPanel.Dock="Top" Classes="lobbyEmpty" Text="{loc:Str lobby_empty_friends}"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="LobbyFriendsList" ItemTemplate="{StaticResource LobbyRowTemplate}"/>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
