<!-- PORTED from ConditioningControlPanel/Views/Tabs/LeashTabView.xaml (WPF ca2997d30, 2855cbc01).
     Social > Leash. WPF hosts LeashDrawerSection (offers, your own card, one card per account you
     hold) with the "?" explainer above it, inside the card column. The leash feature is not on this
     head (parity row feat-leash), so the page shows WPF's own empty state: one line and a button to
     Friends, where offers start. ponytail: SectionHost and the "?" explainer land with feat-leash. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:ConditioningControlPanel.Avalonia.Localization"
             x:Class="ConditioningControlPanel.Avalonia.Views.Tabs.LeashTabView">
    <Grid Margin="32,20,32,20">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="620">
                <StackPanel x:Name="EmptyPanel" HorizontalAlignment="Center" Margin="18,40,18,28">
                    <TextBlock Text="{loc:Str social_leash_empty}" Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="13" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,12"/>
                    <Button x:Name="EmptyButton" Tag="leash-page-open-friends" HorizontalAlignment="Center"
                            Background="#5FFFD0" Foreground="#062A1F" BorderBrush="#5FFFD0" BorderThickness="1"
                            CornerRadius="10" Padding="16,6" Cursor="Hand">
                        <TextBlock Text="{loc:Str social_leash_empty_open}" FontSize="13" FontFamily="Fredoka, Segoe UI"/>
                    </Button>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
