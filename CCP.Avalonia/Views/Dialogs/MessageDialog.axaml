<!-- The head's message box. There is no WPF original to port: the WPF head called
     MessageBox.Show, which does not exist off Windows, so a dozen ported handlers currently log
     a refusal the user never sees. This is what they show instead.

     Chrome copied from ColorEditorDialog: DarkerBgBrush window, PinkBrush 18-bold header,
     SecondaryButton + ActionButton footer.

     TxtTitle / TxtMessage carry no {loc:Str}: the constructor always assigns both, and in
     Avalonia a local value sits UNDER a binding and is undone on the next language change - the
     caller's message would be replaced by a design-time default.

     Buttons carry a TextBlock child rather than Content: Avalonia parses "_" in Content as an
     access key and every loc key here is snake_case (CLAUDE.md trap 1). -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ConditioningControlPanel.Avalonia.Localization"
        x:Class="ConditioningControlPanel.Avalonia.Views.Dialogs.MessageDialog"
        Width="460" SizeToContent="Height" MinHeight="180" MaxHeight="640"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource DarkerBgBrush}"
        CanResize="False">

    <Grid Margin="20" RowDefinitions="Auto,*,Auto">

        <TextBlock Grid.Row="0" x:Name="TxtTitle"
                   Foreground="{StaticResource PinkBrush}"
                   FontSize="18" FontWeight="Bold" TextWrapping="Wrap"
                   Margin="0,0,0,12"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <TextBlock x:Name="TxtMessage"
                       Foreground="{StaticResource TextLightBrush}"
                       FontSize="14" TextWrapping="Wrap" LineHeight="20"/>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,20,0,0" ColumnDefinitions="*,Auto,Auto">
            <Button x:Name="BtnCancel" Grid.Column="1" Theme="{StaticResource SecondaryButton}"
                    Margin="0,0,10,0">
                <TextBlock Text="{loc:Str btn_cancel}"/>
            </Button>
            <Button x:Name="BtnOk" Grid.Column="2" Theme="{StaticResource ActionButton}"
                    IsDefault="True">
                <TextBlock Text="{loc:Str btn_ok}"/>
            </Button>
        </Grid>
    </Grid>
</Window>
