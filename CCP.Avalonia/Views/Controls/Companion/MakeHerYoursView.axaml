<!-- PORTED from ConditioningControlPanel/Views/Controls/Companion/MakeHerYoursView.xaml.
     Structure, order, spacing, comments and every resource key are preserved so the two can be
     diffed. Documented deviations, all forced by real WPF/Avalonia differences:

       Style="{StaticResource X}"      ->  Theme="{StaticResource X}"   (keyed styles are ControlThemes)
       <Style x:Key TargetType>        ->  <ControlTheme x:Key TargetType>
       Style.Triggers/DataTrigger      ->  a class + nested <Style Selector="^.dormant">
                                           (Avalonia has no data triggers; Classes.dormant binds
                                           the same boolean and a ControlTheme's nested Style still
                                           outranks nothing local, which is what the WPF comment
                                           about "every visual is a Setter" was protecting)
       {loc:Str key}                   ->  {Binding LocX}               (LocExtension is a WPF
                                           MarkupExtension and stays in the head)
       Visibility + CmpBoolToVis       ->  IsVisible="{Binding X}"
       Visibility + CmpBoolToVisInverse->  IsVisible="{Binding !X}"     (Avalonia negates natively;
                                           both converters disappear)
       <Image .. CmpEmojiToImage>      ->  <TextBlock Text="🪞" FontSize="16"/>  (Avalonia renders
                                           colour emoji natively - see CLAUDE.md)
       <ContentPresenter/>             ->  <ContentPresenter Name="PART_ContentPresenter" .../>
       ToolTip="..."                   ->  ToolTip.Tip="..."
       gradient "0,1" / "0.38,0.30"    ->  "0%,100%" / "38%,30%"        (RelativePoint: bare numbers
                                           are ABSOLUTE PIXELS in Avalonia)
       x:Name on TranslateTransform    ->  dropped; the code-behind reaches it through the
                                           TransformGroup (x:Name is illegal on a Transform)
       FontFamily="/Fonts/#Fredoka,..." ->  FontFamily="Fredoka, Segoe UI"  (the font asset is a
                                           head resource and the .csproj is frozen; this falls back
                                           by NAME, so Fredoka renders only where it is installed)
       d:DataContext MockMakeHerYoursVm ->  dropped (the mock lives in the WPF head)

     CompanionTheme.xaml's pack:// merge becomes a ResourceInclude of the ported subset. It is
     merged HERE rather than in App.axaml because App.axaml is off-limits to this port - and
     because the WPF original merges per-control too. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ConditioningControlPanel.Avalonia.Views.Controls.Companion.MakeHerYoursView"
             x:DataType="local:MakeHerYoursViewModel"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ConditioningControlPanel.Avalonia.Views.Controls.Companion"
             mc:Ignorable="d"
             d:DesignWidth="430" d:DesignHeight="560">

    <!-- ================================================================
         Z4 — MAKE HER YOURS.
         The personality front door: interview spotlight ▸ trait glance ▸
         preset chips ▸ spice switch ▸ active readout ▸ expert door.

         Never gated. The interview is the conversion surface, so a free
         user gets every part of this card.

         Pre-Train 3 the spotlight is present but *sleeping*: the shimmer
         still sweeps once on load, the CTA is unfilled, the fill loses
         its heat, and the copy says interviews start next update. That is
         designed content, not a disabled control.

         After the interview the spotlight compresses to a chip row
         (design §3 Z4: "Interviewed <date> · re-interview me~ · adjust
         her") — the two verbs are real buttons, not decoration.

         The six prompt text-walls are exactly one click deeper than
         today, behind the quiet link row at the bottom.
         ================================================================ -->

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://CCP.Avalonia/Views/Controls/Companion/Themes/CompanionTheme.axaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- The spotlight card. Every visual is a Setter so the dormant state can actually
                 win: a local attribute on the Border would outrank the theme. -->
            <ControlTheme x:Key="CmpZ4InterviewCardStyle" TargetType="Border">
                <Setter Property="CornerRadius" Value="12"/>
                <Setter Property="ClipToBounds" Value="True"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="{StaticResource CmpCardBorderBrush}"/>
                <Setter Property="Background" Value="{StaticResource CmpInterviewBrush}"/>
                <Setter Property="Padding" Value="16,15,16,15"/>
                <!-- pre-Train 3: sleeping, not disabled -->
                <Style Selector="^.dormant">
                    <Setter Property="Opacity" Value="0.88"/>
                    <Setter Property="BorderBrush" Value="{StaticResource CmpVioletCardBorderBrush}"/>
                </Style>
            </ControlTheme>

            <!-- one read-only trait gauge: label | thin bar | value -->
            <DataTemplate x:Key="CmpTraitGaugeTemplate" x:DataType="local:TraitGauge">
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="86"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="32"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="11"
                               Foreground="{StaticResource CmpDimBrush}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Label}"/>
                    <Border Grid.Column="1" Theme="{StaticResource CmpGaugeTrackThinStyle}"
                            VerticalAlignment="Center" Margin="9,0,9,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{Binding Fraction, Converter={StaticResource CmpFractionToStar}}"/>
                                <ColumnDefinition Width="{Binding Fraction, Converter={StaticResource CmpFractionToRemainderStar}}"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Theme="{StaticResource CmpGaugeFillThinStyle}"/>
                        </Grid>
                    </Border>
                    <TextBlock Grid.Column="2" Text="{Binding Value}" FontSize="10.5" FontWeight="Bold"
                               Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="CmpTraitChipTemplate" x:DataType="x:String">
                <Border Theme="{StaticResource CmpTraitChipStyle}">
                    <TextBlock Text="{Binding}" Theme="{StaticResource CmpTraitChipTextStyle}"/>
                </Border>
            </DataTemplate>

            <DataTemplate x:Key="CmpPresetChipTemplate" x:DataType="local:PresetChip">
                <ToggleButton Content="{Binding Label}" Theme="{StaticResource CmpToggleChipStyle}"
                              ToolTip.Tip="{Binding Label}"
                              IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Theme="{StaticResource CmpVioletCardStyle}">
        <StackPanel>

            <!-- ========== header ========== -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="🪞" FontSize="16" Margin="0,0,9,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding LocPersonalityTitle}" Theme="{StaticResource CmpSectionTitleStyle}"/>
                </StackPanel>
                <Border Grid.Column="2" Theme="{StaticResource CmpTrainTagStyle}">
                    <TextBlock Text="{Binding LocTagTrain3}" Theme="{StaticResource CmpTrainTagTextStyle}"/>
                </Border>
            </Grid>

            <!-- ========== interview spotlight ========== -->
            <Grid Margin="0,13,0,14" IsVisible="{Binding !IsInterviewed}">
                <Border x:Name="InterviewCard" Theme="{StaticResource CmpZ4InterviewCardStyle}"
                        Classes.dormant="{Binding !IsInterviewAvailable}">
                    <Grid>
                        <!-- warm corner wash -->
                        <Border Background="{StaticResource CmpInterviewGlowBrush}"/>

                        <!-- "her portrait peeking from the edge" (design §3 Z4). A vector bust,
                             not an Image: the hero's banner trap applies to every art layer that
                             lives inside a StackPanel/ScrollViewer. Fixed size + bottom-right
                             alignment + the card's ClipToBounds is what makes it peek. -->
                        <Grid x:Name="PeekBust" Width="98" Height="106" Opacity="0.22"
                              HorizontalAlignment="Right" VerticalAlignment="Bottom"
                              Margin="0,0,-10,-22" IsHitTestVisible="False">
                            <Border Width="98" Height="54" VerticalAlignment="Bottom" CornerRadius="49,49,0,0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                        <GradientStop Color="{StaticResource CmpPurpleColor}" Offset="0"/>
                                        <GradientStop Color="#FF7A4FC9" Offset="0.6"/>
                                        <GradientStop Color="#FF4A2B85" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Ellipse Width="52" Height="56" VerticalAlignment="Top" HorizontalAlignment="Center"
                                     Margin="0,6,0,0">
                                <Ellipse.Fill>
                                    <RadialGradientBrush Center="38%,30%" GradientOrigin="38%,30%">
                                        <GradientStop Color="#FFFFC4E4" Offset="0"/>
                                        <GradientStop Color="{StaticResource CmpPinkLightColor}" Offset="0.45"/>
                                        <GradientStop Color="#FFC86BD9" Offset="1"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                        </Grid>

                        <!-- the one-shot shimmer band (code-behind drives its X, once) -->
                        <Border x:Name="InterviewShimmer" Width="56" HorizontalAlignment="Left"
                                Background="{StaticResource CmpShimmerBrush}" IsHitTestVisible="False"
                                Opacity="0">
                            <Border.RenderTransform>
                                <TransformGroup>
                                    <SkewTransform AngleX="-18"/>
                                    <TranslateTransform X="-80"/>
                                </TransformGroup>
                            </Border.RenderTransform>
                        </Border>

                        <StackPanel Margin="0,0,58,0">
                            <TextBlock Text="{Binding InterviewTitle}" FontFamily="Fredoka, Segoe UI"
                                       FontWeight="SemiBold" FontSize="16" Foreground="White"
                                       TextWrapping="Wrap" Effect="{StaticResource CmpSectionGlow}"/>

                            <!-- live copy -->
                            <TextBlock Text="{Binding InterviewBody}" Margin="0,5,0,0" FontSize="11.5"
                                       Foreground="#FFD9CFF0" TextWrapping="Wrap" LineHeight="17"
                                       IsVisible="{Binding IsInterviewAvailable}"/>
                            <Button Content="{Binding InterviewCtaLabel}" Theme="{StaticResource CmpCtaPillStyle}"
                                    HorizontalAlignment="Left" Margin="0,10,0,0"
                                    Command="{Binding StartInterviewCommand}"
                                    IsVisible="{Binding IsInterviewAvailable}"/>

                            <!-- dormant copy: sleeping, not disabled -->
                            <TextBlock Text="{Binding InterviewDormantCopy}" Margin="0,5,0,0"
                                       Theme="{StaticResource CmpDormantCopyStyle}"
                                       IsVisible="{Binding !IsInterviewAvailable}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- already interviewed: the spotlight compresses to a chip row -->
            <WrapPanel Orientation="Horizontal" Margin="0,13,0,12"
                       IsVisible="{Binding IsInterviewed}">
                <Border Theme="{StaticResource CmpTraitChipStyle}">
                    <TextBlock Text="{Binding InterviewedLine}" Theme="{StaticResource CmpTraitChipTextStyle}"/>
                </Border>
                <Button Content="{Binding LocReinterview}" VerticalAlignment="Center"
                        Theme="{StaticResource CmpLinkButtonStyle}" Command="{Binding StartInterviewCommand}"/>
                <Button Content="{Binding LocAdjust}" VerticalAlignment="Center"
                        Theme="{StaticResource CmpLinkButtonStyle}" Command="{Binding OpenTraitDashboardCommand}"/>
            </WrapPanel>

            <!-- ========== trait glance (read-only; the dashboard is one click down) ========== -->
            <Button Theme="{StaticResource CmpLinkButtonStyle}" Padding="0" HorizontalAlignment="Stretch"
                    Command="{Binding OpenTraitDashboardCommand}"
                    ToolTip.Tip="{Binding LocTraitsTip}"
                    IsVisible="{Binding AreTraitsAvailable}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Cursor="Hand">
                            <ContentPresenter Name="PART_ContentPresenter"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Traits}" ItemTemplate="{StaticResource CmpTraitGaugeTemplate}"/>
                    <ItemsControl ItemsSource="{Binding TraitChips}" ItemTemplate="{StaticResource CmpTraitChipTemplate}"
                                  Margin="0,4,0,10">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </Button>

            <!-- ========== preset chips (finally discoverable outside the right-click menu) ========== -->
            <ItemsControl ItemsSource="{Binding Presets}" ItemTemplate="{StaticResource CmpPresetChipTemplate}"
                          Margin="0,0,0,12">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <!-- ========== spice switch (Slut Mode, restyled) ========== -->
            <Border Theme="{StaticResource CmpInsetPanelStyle}" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="🔥" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SpiceTitle}" FontSize="12.5" Foreground="White"/>
                        <TextBlock Text="{Binding SpiceSubtitle}" FontSize="10" Margin="0,1,0,0"
                                   Foreground="{StaticResource CmpFaintBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ToggleButton Grid.Column="2" Theme="{StaticResource CmpToggleSwitchStyle}"
                                  VerticalAlignment="Center" ToolTip.Tip="{Binding SpiceSubtitle}"
                                  IsChecked="{Binding IsSpiceOn, Mode=TwoWay}"/>
                </Grid>
            </Border>

            <!-- ========== active personality readout ========== -->
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding ActivePersonalityLine}" FontSize="11"
                           Foreground="{StaticResource CmpMutedBrush}" TextWrapping="Wrap"/>
                <Button Grid.Column="1" Content="{Binding ResetLabel}" Theme="{StaticResource CmpLinkButtonStyle}"
                        Command="{Binding ResetPersonalityCommand}" Padding="8,2,0,2"
                        IsVisible="{Binding CanResetPersonality}"/>
            </Grid>

            <!-- ========== expert door ========== -->
            <Border BorderBrush="#12FFFFFF" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                <WrapPanel Orientation="Horizontal">
                    <Button Content="{Binding LocViewPrompt}" Theme="{StaticResource CmpLinkButtonStyle}"
                            Command="{Binding ViewCompiledPromptCommand}"/>
                    <Button Content="{Binding LocFork}" Theme="{StaticResource CmpLinkButtonStyle}"
                            Command="{Binding ForkPromptCommand}"/>
                    <Button Content="{Binding LocCommunity}" Theme="{StaticResource CmpLinkButtonStyle}"
                            Command="{Binding CommunityPromptsCommand}"/>
                </WrapPanel>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
