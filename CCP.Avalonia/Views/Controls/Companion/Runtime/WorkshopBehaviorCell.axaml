<!-- PORTED from ConditioningControlPanel/Views/Controls/Companion/Runtime/WorkshopBehaviorCell.xaml.
     Structure, order, spacing and every resource key are preserved so the two can be diffed.
     Deviations, all forced:

       Style="{StaticResource X}"   ->  Theme="{StaticResource X}"    (keyed styles are ControlThemes)
       {loc:Str key}                ->  {loc:Str key}                 (Localization/StrExtension.cs)
       ToolTip="{loc:Str …}"        ->  ToolTip.Tip="{loc:Str …}"
       Click/Checked/ValueChanged   ->  wired in the constructor
       x:FieldModifier="internal"   ->  dropped (the WPF MainWindow partials that write these by
                                        name are not on this head; FindControl reaches them)
       pack:// merged dictionary    ->  avares:// ResourceInclude -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="clr-namespace:ConditioningControlPanel.Avalonia.Localization"
             x:Class="ConditioningControlPanel.Avalonia.Views.Controls.Companion.Runtime.WorkshopBehaviorCell"
             mc:Ignorable="d" d:DesignWidth="312">

    <!-- ================================================================
         Z8 · BEHAVIOR — idle interval, bubble duration, the two shortcut
         editors, mute whispers and pause-in-browser.

         Design §6: the shortcut EDITORS are demoted here ("live chat
         shortcut shown as hint on Z1's chat chip"), the two sliders and
         the two switches are kept verbatim. Every x:Name is the one
         MainWindow.Patreon.cs and MainWindow.SessionIO.cs already write.
         ================================================================ -->

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://CCP.Avalonia/Views/Controls/Companion/Runtime/WorkshopCellTheme.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>
        <!-- idle interval -->
        <Grid>
            <TextBlock Text="{loc:Str label_idle_giggle_interval}" Theme="{StaticResource CmpCellLabelStyle}"/>
            <TextBlock x:Name="TxtIdleIntervalCompanion" Text="{loc:Str label_120s}"
                       Theme="{StaticResource CmpCellValueStyle}"/>
        </Grid>
        <Slider x:Name="SliderIdleIntervalCompanion" Theme="{DynamicResource PinkSlider}"
                Minimum="20" Maximum="300" Value="120" Margin="0,4,0,2"/>
        <!-- Design §6: the caption the Proactivity trait will own once Train 3 lands. Muted and
             honest until then — it describes where the value comes from today. -->
        <TextBlock Text="{loc:Str label_how_often_companion_speaks_when_idle}" Theme="{StaticResource CmpCellHintStyle}"
                   Margin="0,0,0,9"/>

        <!-- bubble duration -->
        <Grid>
            <TextBlock Text="{loc:Str label_bubble_duration}" Theme="{StaticResource CmpCellLabelStyle}"/>
            <TextBlock x:Name="TxtBubbleDurationCompanion" Text="2s"
                       Theme="{StaticResource CmpCellValueStyle}"/>
        </Grid>
        <Slider x:Name="SliderBubbleDurationCompanion" Theme="{DynamicResource PinkSlider}"
                Minimum="1" Maximum="10" Value="2" Margin="0,4,0,9"
                IsSnapToTickEnabled="True" TickFrequency="1"
                ToolTip.Tip="{loc:Str tooltip_bubble_duration}"/>

        <!-- the two shortcut editors (the hero shows the live value; changing it happens here) -->
        <Grid Margin="0,0,0,5" ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Text="{loc:Str tooltip_change_chat_shortcut}" Theme="{StaticResource CmpCellLabelStyle}"
                       TextTrimming="CharacterEllipsis" Margin="0,0,6,0"/>
            <Button x:Name="BtnChatShortcut" Grid.Column="1" Theme="{StaticResource CmpCellButtonStyle}"
                    ToolTip.Tip="{loc:Str tooltip_change_chat_shortcut}">
                <TextBlock x:Name="TxtChatShortcutLabel" Text="Ctrl+T"
                           Foreground="{DynamicResource PinkBrush}" FontWeight="SemiBold" FontSize="11"/>
            </Button>
        </Grid>
        <Grid Margin="0,0,0,9" ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Text="{loc:Str tooltip_change_camera_shortcut}" Theme="{StaticResource CmpCellLabelStyle}"
                       TextTrimming="CharacterEllipsis" Margin="0,0,6,0"/>
            <Button x:Name="BtnCameraShortcut" Grid.Column="1" Theme="{StaticResource CmpCellButtonStyle}"
                    ToolTip.Tip="{loc:Str tooltip_change_camera_shortcut}">
                <TextBlock x:Name="TxtCameraShortcutLabel" Text="Ctrl+Alt+K"
                           Foreground="{DynamicResource PinkBrush}" FontWeight="SemiBold" FontSize="11"/>
            </Button>
        </Grid>

        <!-- the two switches -->
        <Grid Margin="0,0,0,6">
            <StackPanel Margin="0,0,44,0">
                <TextBlock Text="{loc:Str label_mute_whispers}" Theme="{StaticResource CmpCellLabelStyle}"/>
                <TextBlock Text="{loc:Str label_mute_subliminal_audio}" Theme="{StaticResource CmpCellHintStyle}"/>
            </StackPanel>
            <CheckBox x:Name="ChkMuteWhispersCompanion" Theme="{DynamicResource ToggleStyle}"
                      HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>
        <Grid Margin="0,0,0,6">
            <StackPanel Margin="0,0,44,0">
                <TextBlock Text="{loc:Str label_pause_browser}" Theme="{StaticResource CmpCellLabelStyle}"/>
                <TextBlock Text="{loc:Str label_pause_embedded_browser_audio}" Theme="{StaticResource CmpCellHintStyle}"/>
            </StackPanel>
            <CheckBox x:Name="ChkPauseBrowserCompanion" Theme="{DynamicResource ToggleStyle}"
                      HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>

        <!-- #846: spoken VO only — bubbles, text and giggle cues stay on. Same checked=suppress
             polarity as its two neighbors. -->
        <Grid>
            <StackPanel Margin="0,0,44,0">
                <TextBlock Text="{loc:Str label_mute_voice_lines}" Theme="{StaticResource CmpCellLabelStyle}"/>
                <TextBlock Text="{loc:Str label_mute_voice_lines_hint}" Theme="{StaticResource CmpCellHintStyle}"/>
            </StackPanel>
            <CheckBox x:Name="ChkVoiceLinesCompanion" Theme="{DynamicResource ToggleStyle}"
                      HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>

        <!-- TUBE GLASS: MIDNIGHT (Prize Counter restock, 2026-08-26). Always VISIBLE and greyed
             out until the counter has sold it - a prize you cannot see is a prize nobody knows
             to want. Its row seeds and re-arms itself in the code-behind on every reveal rather
             than once at startup, because the thing that unlocks it is a purchase made in
             another window while this cell is sitting here. -->
        <Grid Margin="0,6,0,0">
            <StackPanel Margin="0,0,44,0">
                <TextBlock Text="{loc:Str tube_midnight_setting}" Theme="{StaticResource CmpCellLabelStyle}"/>
                <TextBlock Text="{loc:Str tube_midnight_setting_hint}" Theme="{StaticResource CmpCellHintStyle}"/>
            </StackPanel>
            <CheckBox x:Name="ChkTubeMidnightGlass" Theme="{DynamicResource ToggleStyle}"
                      HorizontalAlignment="Right" VerticalAlignment="Center"
                      ToolTip.Tip="{loc:Str tube_midnight_setting_hint}"/>
        </Grid>
    </StackPanel>
</UserControl>
