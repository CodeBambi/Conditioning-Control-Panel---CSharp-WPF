<!-- PORTED from ConditioningControlPanel/Views/Controls/Companion/Runtime/WorkshopAwarenessCell.xaml.
     Structure, order, spacing and every resource key are preserved so the two can be diffed.
     Deviations, all forced:

       Style="{StaticResource X}"   ->  Theme="{StaticResource X}"    (keyed styles are ControlThemes)
       <Style x:Key TargetType>     ->  <ControlTheme x:Key TargetType>; the RadioButton one carries
                                        BasedOn the type theme or it draws nothing (CLAUDE.md trap 4)
       {loc:Str key}                ->  {loc:Str key}                 (Localization/StrExtension.cs)
       Content="{loc:Str …}"        ->  a <TextBlock> child           (RadioButton and Button both
                                        read "_" in Content as an access key)
       Visibility="Collapsed"       ->  IsVisible="False"
       Checked/Click/ValueChanged   ->  wired in the constructor
       x:FieldModifier="internal"   ->  dropped (the WPF MainWindow partials that poke these by
                                        name are not on this head; FindControl reaches them)
       pack:// merged dictionary    ->  avares:// ResourceInclude -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="clr-namespace:ConditioningControlPanel.Avalonia.Localization"
             x:Class="ConditioningControlPanel.Avalonia.Views.Controls.Companion.Runtime.WorkshopAwarenessCell"
             mc:Ignorable="d" d:DesignWidth="312">

    <!-- ================================================================
         Z8 · AWARENESS FINE-TUNING — the intensity dial and the full
         privacy notice.

         Design §6: the awareness TOGGLE is superseded by Z5's dial; the
         fine-tuning lands here, which is where Z5's "fine-tuning ↓"
         deep-links to.

         Awareness v2 replaces the two cooldown sliders with ONE dial
         (doc 02 §8). The legacy sliders are still in the tree — the v2
         kill switch falls back to the pipeline that reads them — but the
         host only reveals them while UseAwarenessV2 is off.

         The dial is four stacked radios rather than a four-stop strip:
         this column is 312px, and four playful labels plus their rates
         do not survive being squeezed into pills.
         ================================================================ -->

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://CCP.Avalonia/Views/Controls/Companion/Runtime/WorkshopCellTheme.axaml"/>
            </ResourceDictionary.MergedDictionaries>

            <ControlTheme x:Key="CmpIntensityRadioStyle" TargetType="RadioButton"
                          BasedOn="{StaticResource {x:Type RadioButton}}">
                <Setter Property="Foreground" Value="#FFE8E2F5"/>
                <Setter Property="FontSize" Value="11.5"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Margin" Value="0,0,0,5"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </ControlTheme>
            <ControlTheme x:Key="CmpIntensityHintStyle" TargetType="TextBlock" BasedOn="{StaticResource CmpCellHintStyle}">
                <Setter Property="Margin" Value="19,-4,0,7"/>
            </ControlTheme>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
            <TextBlock Text="{loc:Str label_awareness_settings}" Theme="{StaticResource CmpCellHintStyle}"
                       VerticalAlignment="Center" Margin="0"/>
            <Button x:Name="HelpBtnAwareness" Theme="{DynamicResource HelpButtonStyle}"
                    VerticalAlignment="Center" Margin="6,0,0,0" Tag="WindowAwareness"/>
        </StackPanel>

        <!-- ========== the intensity dial (Awareness v2) ========== -->
        <Border x:Name="AwarenessIntensityPanel" Margin="0,0,0,9">
            <StackPanel>
                <TextBlock Text="{loc:Str companion_awareness_intensity_head}" Theme="{StaticResource CmpCellLabelStyle}"
                           Margin="0,0,0,6"/>

                <RadioButton x:Name="RadioIntensityOff" GroupName="CmpAwarenessIntensity" Tag="Off"
                             Theme="{StaticResource CmpIntensityRadioStyle}">
                    <TextBlock Text="{loc:Str companion_awareness_intensity_off}"/>
                </RadioButton>
                <TextBlock Text="{loc:Str companion_awareness_intensity_off_hint}" Theme="{StaticResource CmpIntensityHintStyle}"/>

                <RadioButton x:Name="RadioIntensitySubtle" GroupName="CmpAwarenessIntensity" Tag="Subtle"
                             Theme="{StaticResource CmpIntensityRadioStyle}">
                    <TextBlock Text="{loc:Str companion_awareness_intensity_subtle}"/>
                </RadioButton>
                <TextBlock Text="{loc:Str companion_awareness_intensity_subtle_hint}" Theme="{StaticResource CmpIntensityHintStyle}"/>

                <RadioButton x:Name="RadioIntensityChatty" GroupName="CmpAwarenessIntensity" Tag="Chatty"
                             Theme="{StaticResource CmpIntensityRadioStyle}">
                    <TextBlock Text="{loc:Str companion_awareness_intensity_chatty}"/>
                </RadioButton>
                <TextBlock Text="{loc:Str companion_awareness_intensity_chatty_hint}" Theme="{StaticResource CmpIntensityHintStyle}"/>

                <RadioButton x:Name="RadioIntensityUnhinged" GroupName="CmpAwarenessIntensity" Tag="Unhinged"
                             Theme="{StaticResource CmpIntensityRadioStyle}">
                    <TextBlock Text="{loc:Str companion_awareness_intensity_unhinged}"/>
                </RadioButton>
                <TextBlock Text="{loc:Str companion_awareness_intensity_unhinged_hint}" Theme="{StaticResource CmpIntensityHintStyle}"/>

                <!-- The dial is a real setting even while her eyes are closed; it just has nothing to
                     pace yet. Saying so beats disabling the control and beats pretending. -->
                <TextBlock x:Name="TxtIntensityEyesClosed" IsVisible="False"
                           Theme="{StaticResource CmpCellHintStyle}" TextWrapping="Wrap"
                           Text="{loc:Str companion_awareness_intensity_eyes_closed}"/>
            </StackPanel>
        </Border>

        <!-- ========== legacy cooldowns (only while UseAwarenessV2 is off) ========== -->
        <Border x:Name="AwarenessSettingsPanel" IsVisible="False" Margin="0,0,0,7">
            <StackPanel>
                <Grid>
                    <TextBlock Text="{loc:Str label_reaction_cooldown}" Theme="{StaticResource CmpCellLabelStyle}"/>
                    <TextBlock x:Name="TxtAwarenessCooldown" Text="{loc:Str label_90s}"
                               Theme="{StaticResource CmpCellValueStyle}"/>
                </Grid>
                <Slider x:Name="SliderAwarenessCooldown" Theme="{DynamicResource PinkSlider}"
                        Minimum="10" Maximum="300" Value="90" Margin="0,4,0,8"/>
                <Grid>
                    <TextBlock Text="{loc:Str label_reaction_cooldown_max}" Theme="{StaticResource CmpCellLabelStyle}"/>
                    <TextBlock x:Name="TxtAwarenessCooldownMax" Text="{loc:Str label_cooldown_off}"
                               Theme="{StaticResource CmpCellValueStyle}"/>
                </Grid>
                <Slider x:Name="SliderAwarenessCooldownMax" Theme="{DynamicResource PinkSlider}"
                        Minimum="0" Maximum="300" Value="0" Margin="0,4,0,3"/>
                <TextBlock Text="{loc:Str tooltip_reaction_cooldown_max}" Theme="{StaticResource CmpCellHintStyle}"/>
            </StackPanel>
        </Border>

        <Border Background="#FF2A1A1A" CornerRadius="6" Padding="7" BorderBrush="#FF6B6B" BorderThickness="1">
            <StackPanel>
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚠️" FontSize="11" VerticalAlignment="Center"/>
                        <TextBlock Text="{loc:Str label_privacy_notice}" Foreground="#FF6B6B" FontSize="11"
                                   FontWeight="Bold" VerticalAlignment="Center" Margin="3,0,0,0"/>
                    </StackPanel>
                    <Button x:Name="BtnPrivacySpoiler"
                            Background="Transparent" Foreground="{DynamicResource TextMutedBrush}" BorderThickness="0"
                            HorizontalAlignment="Right" FontSize="10.5" Cursor="Hand">
                        <TextBlock x:Name="TxtPrivacySpoiler" Text="{loc:Str btn_click_to_reveal}"/>
                    </Button>
                </Grid>
                <TextBlock x:Name="TxtPrivacyDetails" IsVisible="False"
                           TextWrapping="Wrap" Foreground="#CCCCCC" FontSize="10.5" Margin="0,6,0,0"
                           Text="{loc:Str label_this_feature_reads_the_name_of_the_active_win}"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
