<!-- PORTED from WPF 7.1.5 ConditioningControlPanel/Views/Controls/AppSettings/MonitorsSettingsSection.xaml
     (nav rework 2026-10-06, REHOME lane). Structure, order, x:Names and resource keys preserved.
     Deviations: Style -> Theme, ToolTip -> ToolTip.Tip, Checked/Unchecked -> IsCheckedChanged wired
     in code, x:FieldModifier dropped. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:loc="clr-namespace:ConditioningControlPanel.Avalonia.Localization"
             xmlns:feat="clr-namespace:ConditioningControlPanel.Avalonia.Views.Features"
             x:Class="ConditioningControlPanel.Avalonia.Views.Controls.AppSettings.MonitorsSettingsSection"
             mc:Ignorable="d" d:DesignWidth="760">

    <!-- ================================================================
         SETTINGS · MONITORS

         The one home for "which screen does the content land on" and the
         four video rows that used to sit in the Home System pill popup.
         Same settings keys, same writes: FillAllMonitorsWithVideo,
         VideoForceHardwareDecoding, VideoBlurredBackgroundEnabled,
         BrowserVideoEngineEnabled. The picker is the shared
         MonitorTargetPicker; it writes DualMonitorEnabled +
         GlobalTargetMonitor and repaints from AppSettings.PropertyChanged.
         ================================================================ -->

    <StackPanel>
        <TextBlock Text="{loc:Str settings_section_monitors}" Theme="{StaticResource SectionHeader}"/>

        <Border Theme="{StaticResource SectionPanel}" Padding="0" Margin="0,0,0,10"
                BorderBrush="{StaticResource SectionHueDevicesBorderBrush}">
            <Grid>
                <Border CornerRadius="11" Background="{StaticResource SectionHueDevicesWashBrush}"/>
                <Border Width="3" HorizontalAlignment="Left" Margin="0,10" CornerRadius="0,2,2,0"
                        Background="{StaticResource SectionHueDevicesBrush}"/>
                <StackPanel Margin="15,12,15,12">

                    <feat:MonitorTargetPicker x:Name="ContentMonitorPicker"/>

                    <!-- Depends on the picker, so it stays indented. -->
                    <Grid MinHeight="34" Margin="16,0,0,0" ColumnDefinitions="*,Auto"
                          ToolTip.Tip="{loc:Str tooltip_fill_all_monitors_video}">
                        <TextBlock Grid.Column="0" Theme="{StaticResource SettingLabel}" Text="{loc:Str setting_fill_all_monitors_video}"
                                   Margin="0,0,14,0" TextTrimming="CharacterEllipsis"/>
                        <CheckBox Grid.Column="1" x:Name="ChkFillAllMon"
                                  Theme="{StaticResource ToggleStyle}" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid MinHeight="34" ColumnDefinitions="*,Auto"
                          ToolTip.Tip="{loc:Str tooltip_force_video_gpu_decode}">
                        <TextBlock Grid.Column="0" Theme="{StaticResource SettingLabel}" Text="{loc:Str setting_force_video_gpu_decode}"
                                   Margin="0,0,14,0" TextTrimming="CharacterEllipsis"/>
                        <CheckBox Grid.Column="1" x:Name="ChkVideoGpuDecode"
                                  Theme="{StaticResource ToggleStyle}" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid MinHeight="34" ColumnDefinitions="*,Auto"
                          ToolTip.Tip="{loc:Str tooltip_blurred_video_background}">
                        <TextBlock Grid.Column="0" Theme="{StaticResource SettingLabel}" Text="{loc:Str setting_blurred_video_background}"
                                   Margin="0,0,14,0" TextTrimming="CharacterEllipsis"/>
                        <CheckBox Grid.Column="1" x:Name="ChkVideoBlurBg"
                                  Theme="{StaticResource ToggleStyle}" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid MinHeight="34" ColumnDefinitions="*,Auto"
                          ToolTip.Tip="{loc:Str tooltip_browser_video_engine}">
                        <TextBlock Grid.Column="0" Theme="{StaticResource SettingLabel}" Text="{loc:Str setting_browser_video_engine}"
                                   Margin="0,0,14,0" TextTrimming="CharacterEllipsis"/>
                        <CheckBox Grid.Column="1" x:Name="ChkBrowserVideoEngine"
                                  Theme="{StaticResource ToggleStyle}" VerticalAlignment="Center"/>
                    </Grid>

                </StackPanel>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
