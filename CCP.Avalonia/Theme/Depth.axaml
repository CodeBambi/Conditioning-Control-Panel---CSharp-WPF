<!-- GENERATED from CCP.Core/Depth/DepthPalette.cs (= WPF 7.1.5 Resources/Theme/Depth.xaml, every key
     and stop verbatim). Do not hand-edit a stop: change the Core table and regenerate; the
     DepthThemeTests pin this file to that table key by key.

     The depth law: one lamp, top-left. Three heights: Raised (you press it), Floating (you read
     it), Sunken (it holds things). No Effect anywhere: bevels are 1 px gradient borders, shadows
     are gradient rectangles / ellipses UNDER the element, wells are inner bands on the frame.
     ON IS PRESSED IN: a lit thing sits down in its socket (DepthPressedBevel), an off thing rises.
     Shadows here are the NEUTRAL ink; a painter that knows its section hue uses
     DepthRules.ShadowColor(hue) instead. Recipes (raised / sunken / floating / ledge) are in the
     WPF Depth.xaml header; Controls/Depth/DepthPaint.cs builds the same parts in code.

     WPF to Avalonia: StartPoint "0,0" becomes "0%,0%" (WPF brushes are relative by default,
     Avalonia points are absolute unless written as percentages). -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Color x:Key="DepthHighlight">#42FFFFFF</Color>
  <Color x:Key="DepthShade">#80000000</Color>
  <SolidColorBrush x:Key="DepthHighlightBrush" Color="#42FFFFFF"/>
  <SolidColorBrush x:Key="DepthShadeBrush" Color="#80000000"/>
  <LinearGradientBrush x:Key="DepthRaisedBevel" StartPoint="0%,0%" EndPoint="0%,100%">
    <GradientStop Offset="0.0" Color="#42FFFFFF"/>
    <GradientStop Offset="0.5" Color="#10FFFFFF"/>
    <GradientStop Offset="1.0" Color="#80000000"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="DepthRaisedSheen" StartPoint="0%,0%" EndPoint="0%,100%">
    <GradientStop Offset="0.00" Color="#17FFFFFF"/>
    <GradientStop Offset="0.55" Color="#00FFFFFF"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="DepthPlankSheen" StartPoint="0%,0%" EndPoint="0%,100%">
    <GradientStop Offset="0.00" Color="#47FFFFFF"/>
    <GradientStop Offset="0.50" Color="#00FFFFFF"/>
    <GradientStop Offset="1.00" Color="#2E000000"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="DepthPlankBevel" StartPoint="0%,0%" EndPoint="0%,100%">
    <GradientStop Offset="0.0" Color="#80FFFFFF"/>
    <GradientStop Offset="0.5" Color="#14FFFFFF"/>
    <GradientStop Offset="1.0" Color="#A6000000"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="DepthPressedBevel" StartPoint="0%,0%" EndPoint="0%,100%">
    <GradientStop Offset="0.0" Color="#99000000"/>
    <GradientStop Offset="0.5" Color="#26000000"/>
    <GradientStop Offset="1.0" Color="#12FFFFFF"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="DepthPressedShade" StartPoint="0%,0%" EndPoint="0%,100%">
    <GradientStop Offset="0.00" Color="#2E000000"/>
    <GradientStop Offset="0.60" Color="#00000000"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="DepthDropBand" StartPoint="0%,0%" EndPoint="0%,100%">
    <GradientStop Offset="0.0" Color="#9E06020F"/>
