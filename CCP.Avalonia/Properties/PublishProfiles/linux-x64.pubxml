<Project>
  <!-- The Linux tarball the Flatpak and AUR packages consume (docs/avalonia-decisions.md): self-contained,
       NOT single-file, so libvosk, libvlc lookups and Resources/ stay loose files.
       dotnet publish CCP.Avalonia/CCP.Avalonia.csproj -c Release -p:PublishProfile=linux-x64 (build on Linux). -->
  <PropertyGroup>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishDir>bin/publish/linux-x64/</PublishDir>
  </PropertyGroup>
</Project>
