<Project>
  <!-- The settings WPF ships (ConditioningControlPanel.csproj:20-45). Kept here, not in the csproj: the
       Avalonia test projects reference this head without a RID (NETSDK1151/1191).
       dotnet publish CCP.Avalonia/CCP.Avalonia.csproj -c Release -p:PublishProfile=win-x64
       Build on Windows: Vosk.targets picks libvosk by the BUILD machine's OS. -->
  <PropertyGroup>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishReadyToRun>true</PublishReadyToRun>
    <!-- No trimming: settings and mods go through Newtonsoft reflection. -->
    <PublishTrimmed>false</PublishTrimmed>
    <PublishDir>bin\publish\win-x64\</PublishDir>
  </PropertyGroup>
</Project>
