<Project>
  <!-- WinRT for the Awareness lane (Windows.Media.Ocr screen reads, Windows.Media.Control now-playing).
       The head stays net10.0: the Windows SDK projection is referenced as two plain assemblies (the same
       pack and version the WPF head's net8.0-windows10.0.19041.0 target pulls in), only on a Windows
       build, and every use sits in a file compiled under CCP_WINRT behind an OperatingSystem.IsWindows
       guard. A Linux build compiles none of it and ships neither dll.

       Imported by CCP.Avalonia AND by CCP.Avalonia.Tests: a plain Reference does not flow through a
       ProjectReference into the test host's deps.json, so without the second import any test that touches
       a WinRT type dies with FileNotFoundException although the dll sits beside it. -->
  <PropertyGroup Condition="$(RuntimeIdentifier.StartsWith('win')) Or ('$(RuntimeIdentifier)' == '' And $([MSBuild]::IsOSPlatform('Windows')))">
    <DefineConstants>$(DefineConstants);CCP_WINRT</DefineConstants>
    <CcpWinSdkRef>$(NuGetPackageRoot)microsoft.windows.sdk.net.ref\10.0.19041.57\lib\net8.0\</CcpWinSdkRef>
  </PropertyGroup>
  <ItemGroup Condition="$(RuntimeIdentifier.StartsWith('win')) Or ('$(RuntimeIdentifier)' == '' And $([MSBuild]::IsOSPlatform('Windows')))">
    <PackageDownload Include="Microsoft.Windows.SDK.NET.Ref" Version="[10.0.19041.57]" />
    <Reference Include="Microsoft.Windows.SDK.NET">
      <HintPath>$(CcpWinSdkRef)Microsoft.Windows.SDK.NET.dll</HintPath>
    </Reference>
    <Reference Include="WinRT.Runtime">
      <HintPath>$(CcpWinSdkRef)WinRT.Runtime.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
