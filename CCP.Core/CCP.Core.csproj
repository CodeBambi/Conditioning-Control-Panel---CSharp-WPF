<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Platform-agnostic engine library. Targets plain net8.0 ON PURPOSE: the target framework
    itself is the architecture test. A net8.0 assembly physically cannot reference
    System.Windows.*, so any WPF/WinForms/Win32 leak into Core becomes a compile error rather
    than a code-review question. Do not add -windows, UseWPF, UseWindowsForms, or a
    RuntimeIdentifier here.

    CA1416 is deliberately NOT suppressed (the app suppresses it). Core is precisely where a
    Windows-only API call should warn.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <!-- Match the app: it does not use implicit usings. -->
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- Must stay ConditioningControlPanel: it is the prefix of every generated resource
         logical name, so hardcoded strings like "ConditioningControlPanel.assets.knowledge.json"
         keep naming the same thing once a resource moves here.
         It does NOT make a moved resource *reachable*. Lookups go through
         Assembly.GetExecutingAssembly() (e.g. Services/AIService/Enrichment/KnowledgeService.cs),
         which returns whichever assembly the calling code was compiled into. Move such a caller
         here without also moving its <EmbeddedResource> and the stream comes back null at
         runtime, with no compile error. Move both, or neither. -->
    <RootNamespace>ConditioningControlPanel</RootNamespace>
    <AssemblyName>CCP.Core</AssemblyName>
    <!-- Match the app: assembly info lives in Properties/AssemblyInfo.cs. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Serilog" Version="3.1.1" />
  </ItemGroup>

</Project>
