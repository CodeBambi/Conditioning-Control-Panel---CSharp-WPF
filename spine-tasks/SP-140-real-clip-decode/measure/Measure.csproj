<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SP-140 deliverable 2: the D124 MEASUREMENT harness. EXPLICITLY NOT A TEST.

    It is not in client/CcpClient.sln, no gate builds it, no floor run sees it, and it depends
    on a directory that exists on exactly one machine. That is precisely why it is a tool and
    not a fact: a test that skipped when the owner's media directory was absent would be the
    vacuous-green shape this repository bans.

    Run:  dotnet run, pointed at this csproj, with the media directory as the one trailing
          argument. See record.md for the exact command line and the run it produced.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Measure</AssemblyName>
    <RootNamespace>Measure</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\client\src\CcpClient.Desktop\CcpClient.Desktop.csproj" />
  </ItemGroup>

</Project>
