      <group targetFramework="net10.0">
        <dependency id="Avalonia" version="12.0.0" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net10.0-android36.0">
        <dependency id="Avalonia" version="12.0.0" exclude="Build,Analyzers" />
        <dependency id="Avalonia.Android" version="12.0.0" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net10.0-browser1.0">
        <dependency id="Avalonia" version="12.0.0" exclude="Build,Analyzers" />
        <dependency id="Avalonia.Browser" version="12.0.0" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net8.0">
        <dependency id="Avalonia" version="12.0.0" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>